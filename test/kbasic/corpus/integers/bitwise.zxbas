' BAND, BOR, BXOR, BNOT on 8 and 16 bits (BNOT of a literal: integers/literal-typing.zxbas)
'@expect screen 0 "8 238 230 181"
'@expect screen 1 "4096 4080 61455"
DIM a, b AS UByte
a = $AC: b = $4A
PRINT a BAND b; " "; a BOR b; " "; a BXOR b; " "; BNOT b
DIM w AS UInteger = $F00F
PRINT w BAND $1FF0; " "; BNOT w; " "; w BOR $F
