' FOR with positive, negative and computed steps, and a loop that never runs
'@expect screen 0 "1 4 7 10 |10 7 4 1 |0 5 10 |"
DIM i AS Integer
DIM s AS Integer = 5
FOR i = 1 TO 10 STEP 3: PRINT i; " ";: NEXT i
PRINT "|";
FOR i = 10 TO 1 STEP -3: PRINT i; " ";: NEXT i
PRINT "|";
FOR i = 0 TO 10 STEP s: PRINT i; " ";: NEXT i
PRINT "|";
FOR i = 5 TO 1: PRINT "never";: NEXT i
