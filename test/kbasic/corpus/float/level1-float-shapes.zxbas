' Level-1 code shapes of Float values: globals, frame slots and array elements, arithmetic,
' comparisons as values and as branches, conversions both ways, Float arguments and results;
' the corpus runs it at every level
'@expect screen 0 "-0.75 -3.375 0.5 3.75 -1.5"
'@expect screen 1 "01111"
'@expect screen 2 "0 4.5 4.5"
'@expect screen 3 "15 -3 -9"
'@expect screen 4 "-0.375"
'@expect screen 5 "small3"
'@expect screen 6 "big30"
'@expect screen 7 "both"
DIM x AS Float
DIM y AS Float
DIM t(3) AS Float
DIM i AS UByte
DIM n AS Integer
x = 1.5 : y = -2.25
PRINT x + y; " "; x * y; " "; x / 3; " "; x - y; " "; -x
PRINT x < y; x > y; x = 1.5; y <= -2.25; x <> y
FOR i = 0 TO 3 : t(i) = i * x : NEXT i
PRINT t(0); " "; t(3); " "; t(1) + t(2)
n = x * 10 : PRINT n; " "; INT(y); " "; CAST(Integer, y * 4)
FUNCTION half(v AS Float) AS Float
  RETURN v / 2
END FUNCTION
SUB show(v AS Float, k AS UByte)
  DIM w AS Float
  w = v * k
  IF w > 10 THEN PRINT "big"; w ELSE PRINT "small"; w
END SUB
PRINT half(x) + half(y)
show(x, 2)
show(half(x) * 40, 1)
IF x > 1 AND y < 0 THEN PRINT "both"
