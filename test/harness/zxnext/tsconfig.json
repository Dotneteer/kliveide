{
  // Type-checks the harness, the visual cases' helpers and the scripted hardware tests:
  //   npx tsc -p test/harness/zxnext/tsconfig.json
  // (`exclude` is reset because test/tsconfig.json excludes *.d.ts, which hides ambient.d.ts.)
  "extends": "../../tsconfig.json",
  "compilerOptions": { "noEmit": true, "lib": ["ESNext", "DOM"] },
  "include": ["./**/*.ts", "../../visual/**/*.ts", "../../zxnext-hw/**/*.ts"],
  "exclude": ["node_modules"]
}
