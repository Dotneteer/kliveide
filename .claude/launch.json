{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "doc:dev"
      ],
      "port": 3000
    },
    {
      "name": "docs-serve",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "dev/scripts/serve-docs.cjs",
        "--port",
        "4000"
      ],
      "port": 4000
    },
    {
      "name": "plan-mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4100",
        "--directory",
        "dev/plans"
      ],
      "port": 4100
    }
  ]
}
