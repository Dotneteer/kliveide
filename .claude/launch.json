{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "doc:dev"
      ],
      "port": 3000
    },
    {
      "name": "docs-serve",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-docs.cjs",
        "--port",
        "4000"
      ],
      "port": 4000
    }
  ]
}