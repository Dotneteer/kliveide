      "lineAnnotations": {
        "3594": {
          "synopsis": "Place sprites 60-63 in the four corners of the 256x192 display area.\nThey use patterns $20-$23 and are made visible. Sprite coordinates\nhave (32,32) as the top-left pixel of the display area.\nDestroys A, BC, DE, L.",
          "comment": "Start at sprite 60"
        },
        "3599": {
          "comment": "Sprite 60: X=32, Y=208, pattern $20 (bottom-left)"
        },
        "3616": {
          "comment": "Attribute 2: D = bit 8 of X"
        },
        "3621": {
          "comment": "Attribute 3: visible + pattern, then next sprite"
        },
        "3627": {
          "comment": "Sprite 61: X=272, Y=208, pattern $21 (bottom-right)"
        },
        "3655": {
          "comment": "Sprite 62: X=32, Y=32, pattern $22 (top-left)"
        },
        "3683": {
          "comment": "Sprite 63: X=272, Y=32, pattern $23 (top-right)"
        },
        "4188": {
          "synopsis": "Copy BC bytes from HL to DE using the zxnDMA.\nPatches the source, length and destination into DmaProgram, then streams\nthe 16-byte program to port $6B. Faster than LDIR and used for the bulk\nscreen and asset copies."
        },
        "4209": {
          "synopsis": "zxnDMA program, 16 bytes, written to port $6B by DmaCopy.\nBytes 2-3 are the source, 4-5 the length and 11-12 the destination; DmaCopy\nwrites those six bytes before sending it. Data, not code."
        },
        "4258": {
          "synopsis": "Send BC bytes from HL to the sprite pattern port $5B using the zxnDMA.\nSimilar to DmaCopy, but port B is the fixed I/O port $5B rather than\nmemory, so there is no destination. Select the first pattern through\nport $303B before calling. DE is not used.",
          "comment": "Patch the source (program bytes 2-3)"
        },
        "4261": {
          "comment": "Patch the length (program bytes 4-5)"
        },
        "4265": {
          "comment": "Send the 16-byte program to the DMA port $6B"
        },
        "4275": {
          "synopsis": "zxnDMA program, 16 bytes, sent to port $6B by DmaToSprites.\n$83 disable; $7D WR0 + source (2-3) + length (4-5); $54 $02 port A =\nmemory, counting up; $68 $02 port B = I/O, fixed; $AD $5B $00 continuous\nmode, port B = $005B; $82 WR5; $CF load; $87 enable. Data, not code."
        },
        "4585": {
          "synopsis": "Print D characters from HL into the tilemap at row B, column C.\nTile index is the character code less $20, so the tile set starts at space."
        },
        "4586": {
          "comment": "ASCII -> tile index"
        },
        "4604": {
          "synopsis": "Write scanline numbers into the WAITs of the two copper tables.\nCopperLines ($9465) is the working table and CopperLinesReset ($98E5) is\nthe clean copy that is copied back over it. Each has 96 records of 12\nbytes: WAIT (line), MOVE $40,0, then MOVE $41,colour four times, which\nreloads ULA palette entries 0-3. Record i gets line 32+i. Destroys A, B,\nDE, HL.",
          "comment": "Line byte of the first working record"
        },
        "4607": {
          "comment": "Line byte of the first reset record"
        },
        "4610": {
          "comment": "96 records"
        },
        "4612": {
          "comment": "First line is 32 ($20), the top of the display area"
        },
        "4617": {
          "comment": "12 bytes per record"
        },
        "5221": {
          "synopsis": "Working copper table: 96 x 12-byte records (WAIT line; MOVE $40,0;\nMOVE $41,colour x4). The colour bytes are changed at runtime, and the\ntable is copied into the copper list at $9EAA in three blocks of $180 bytes."
        },
        "6373": {
          "synopsis": "Clean copy of CopperLines, with colours $00, $20, $40, $60.\nCopied back over CopperLines ($480 bytes) at $9229."
        },
        "9728": {
          "comment": "Use Layer 2 first palette"
        },
        "9732": {
          "comment": "Reset Layer 2 palette index"
        },
        "9736": {
          "comment": "Fill the Layer 2 palette"
        },
        "9739": {
          "comment": "Use Sprites first palette"
        },
        "9743": {
          "comment": "Reset Sprites palette index"
        },
        "9747": {
          "comment": "TAIL CALL: InitPaletteRamp's RET returns to InitPalettes' caller"
        },
        "9750": {
          "synopsis": "Fill the currently selected palette with an identity ramp.\nWrites entries 0..255, each set to its own index. The palette must already\nbe selected via nextreg $43. Destroys A."
        },
        "9764": {
          "synopsis": "Demo setup, entered from EntryPoint. Runs with interrupts off.\nInitialises palettes and layers, chooses the tune set, clears the clip\nwindows, copies the two ULA screens in, loads sprites and tiles, starts the\nmusic and installs the frame interrupt. Falls through to the main loop\nonce EI is reached."
        },
        "9765": {
          "comment": "Identity-ramp the Layer 2 and Sprite palettes"
        },
        "9768": {
          "comment": "$85: lores on, layer order L-S-U, sprites enabled"
        },
        "9773": {
          "comment": "Tune-set selector; 0 in this build"
        },
        "9780": {
          "synopsis": "Default tune set: both players get the tune at $8893."
        },
        "9783": {
          "comment": "Patches the LD HL operand at $5C6A"
        },
        "9789": {
          "comment": "Patches the LD HL operand at $5C83"
        },
        "9795": {
          "synopsis": "Alternative tune set, selected when ConfigFlag is non-zero."
        },
        "9807": {
          "synopsis": "Collapse the Layer 2, Sprite and ULA clip windows to a single pixel.\nEach register takes four successive writes — X1, X2, Y1, Y2 — and all four\nare zero here, so nothing from these layers is drawn while setup runs.\nThe write index is not reset first, but with four identical values the\nstarting position does not matter."
        },
        "9873": {
          "comment": "Four-colour LoRes palette"
        },
        "9876": {
          "comment": "Black border"
        },
        "9880": {
          "comment": "$E3 = transparent: empty Layer 2"
        },
        "9885": {
          "comment": "Hide sprites 0-64"
        },
        "9888": {
          "comment": "A = 2*26: page 16K bank 26 into $C000-$FFFF"
        },
        "9898": {
          "synopsis": "Copy the two ULA screen bitmaps from bank 26 into place.\n$1800 bytes each: the first to $4000 and the second to $6000, the two\ndisplay banks Timex mode alternates between."
        },
        "9922": {
          "comment": "A = 2*12: page 16K bank 12 into $C000-$FFFF"
        },
        "9932": {
          "comment": "$303B: select sprite 0 and pattern 0"
        },
        "9943": {
          "comment": "Length is BC, still $303B from the port write: 48 patterns + 59 bytes"
        },
        "9946": {
          "comment": "Scanline numbers for the copper tables"
        },
        "9949": {
          "comment": "Four corner sprites"
        },
        "9952": {
          "comment": "Start both tunes"
        },
        "9955": {
          "synopsis": "Print the two title lines into the tilemap."
        },
        "9961": {
          "comment": "16 characters; B = row, C = column"
        },
        "9977": {
          "comment": "Install the frame interrupt (still disabled)"
        },
        "9980": {
          "comment": "Interrupts on — the demo is now running"
        },
        "9981": {
          "comment": "$03: 28 MHz"
        },
        "10204": {
          "synopsis": "Set ULA palette entries 0-3 to a four-step red ramp.\nEntries: $00, $20, $40, $60 (RRRGGGBB). The LoRes picture only uses\npixel values 0-3, so these are its whole palette. The copper list\n(CopperLines) rewrites the same four entries on each scanline later.",
          "comment": "Edit the ULA first palette, ULANext off"
        },
        "10208": {
          "comment": "Start at palette entry 0"
        },
        "10212": {
          "comment": "Entries 0-3 = $00, $20, $40, $60; the index advances after each write"
        },
        "10229": {
          "synopsis": "Tune-set selector read by Start. 0 = default tunes."
        },
        "10230": {
          "synopsis": "Title line 1, exactly 16 characters: \"  SCROLLNUTTER  \"."
        },
        "10246": {
          "synopsis": "Title line 2, exactly 16 characters: \"   NEXT  DEMO   \"."
        },
        "10262": {
          "synopsis": "Unidentified data table, 15 bytes then zero padding.\nNot reached as code by the entry flow; purpose not yet established."
        }
      },
