        "4766": {
          "comment": "Next BarTable entry"
        },
        "4770": {
          "comment": "For all 10 bars"
        },
        "4772": {
          "synopsis": "Upload the rows into the live copper list, in three $180-byte blocks.\nThe 6 bytes skipped between blocks are the list's own WAIT/MOVE separators\nat rows 64 and 96 (WAIT; MOVE $16,$00; MOVE $15,$85).",
          "comment": "Rows 32-63"
