        }
      ],
      "lineAnnotations": {
        "9728": {
          "comment": "Use Layer 2 first palette"
        },
        "9732": {
          "comment": "Reset Layer 2 palette index"
        },
        "9739": {
          "comment": "Use Sprites first palette"
        },
        "9743": {
          "comment": "Reset Sprites palette index"
        },
        "9750": {
          "synopsis": "Fill the currently selected palette with an identity ramp.\nWrites entries 0..255, each set to its own index. The palette must already\nbe selected via nextreg $43. Destroys A."
        },
        "9747": {
          "comment": "TAIL CALL: InitPaletteRamp's RET returns to InitPalettes' caller"
        },
        "9736": {
          "comment": "Fill the Layer 2 palette"
        },
        "9764": {
          "synopsis": "Demo setup, entered from EntryPoint. Runs with interrupts off.\nInitialises palettes and layers, chooses the tune set, clears the clip\nwindows, copies the two ULA screens in, loads sprites and tiles, starts the\nmusic and installs the frame interrupt. Falls through to the main loop\nonce EI is reached."
        },
        "9765": {
          "comment": "Identity-ramp the Layer 2 and Sprite palettes"
        },
        "9768": {
          "comment": "$85: lores on, layer order L-S-U, sprites enabled"
        },
        "9773": {
          "comment": "Tune-set selector; 0 in this build"
        },
        "9780": {
          "synopsis": "Default tune set: both players get the tune at $8893."
        },
        "9783": {
          "comment": "Patches the LD HL operand at $5C6A"
        },
        "9789": {
          "comment": "Patches the LD HL operand at $5C83"
        },
        "9795": {
          "synopsis": "Alternative tune set, selected when ConfigFlag is non-zero."
        },
        "9807": {
          "synopsis": "Collapse the Layer 2, Sprite and ULA clip windows to a single pixel.\nEach register takes four successive writes \u2014 X1, X2, Y1, Y2 \u2014 and all four\nare zero here, so nothing from these layers is drawn while setup runs.\nThe write index is not reset first, but with four identical values the\nstarting position does not matter."
        },
        "9873": {
          "comment": "Further hardware setup"
        },
        "9876": {
          "comment": "Black border"
        },
        "9888": {
          "comment": "A = 2*26: page 16K bank 26 into $C000-$FFFF"
        },
        "9898": {
          "synopsis": "Copy the two ULA screen bitmaps from bank 26 into place.\n$1800 bytes each: the first to $4000 and the second to $6000, the two\ndisplay banks Timex mode alternates between."
        },
        "9922": {
          "comment": "A = 2*12: page 16K bank 12 into $C000-$FFFF"
        },
        "9932": {
          "comment": "$303B: select sprite 0 and pattern 0"
        },
        "9952": {
          "comment": "Start both tunes"
        },
        "9955": {
          "synopsis": "Print the two title lines into the tilemap."
        },
        "9961": {
          "comment": "16 characters; B = row, C = column"
        },
        "9977": {
          "comment": "Install the frame interrupt (still disabled)"
        },
        "9980": {
          "comment": "Interrupts on \u2014 the demo is now running"
        },
        "9981": {
          "comment": "$03: 28 MHz"
        },
        "4188": {
          "synopsis": "Copy BC bytes from HL to DE using the zxnDMA.\nPatches the source, length and destination into DmaProgram, then streams\nthe 16-byte program to port $6B. Faster than LDIR and used for the bulk\nscreen and asset copies."
        },
        "4209": {
          "synopsis": "zxnDMA program, 16 bytes, written to port $6B by DmaCopy.\nBytes 2-3 are the source, 4-5 the length and 11-12 the destination; DmaCopy\nwrites those six bytes before sending it. Data, not code."
        },
        "4585": {
          "synopsis": "Print D characters from HL into the tilemap at row B, column C.\nTile index is the character code less $20, so the tile set starts at space."
        },
        "4586": {
          "comment": "ASCII -> tile index"
        },
        "10229": {
          "synopsis": "Tune-set selector read by Start. 0 = default tunes."
        },
        "10230": {
          "synopsis": "Title line 1, exactly 16 characters: \"  SCROLLNUTTER  \"."
        },
        "10246": {
          "synopsis": "Title line 2, exactly 16 characters: \"   NEXT  DEMO   \"."
        },
        "10262": {
          "synopsis": "Unidentified data table, 15 bytes then zero padding.\nNot reached as code by the entry flow; purpose not yet established."
        }
      }
    },
    "5": {
      "offsetIndex": 1,
      "regions": [
        {
          "start": 14592,
          "end": 14848,
          "type": "bytes"
        }
      ],
      "lastView": "disassembly",
      "decimalView": false,
      "lineAnnotations": {
        "7249": {
          "comment": "Stack top, inside bank 5 at $4000-$7FFF"
        },
        "7248": {
          "synopsis": "NEX entry point (header PC).\nBank 5 is paged at $4000 and bank 2 at $8000 by the NEX loader, so both are\nalready reachable. Sets up the stack and hands over to Start in bank 2."
        },
        "7252": {
          "comment": "-> Start ($A624, bank 2) \u2014 never returns here"
        },
        "7255": {
          "synopsis": "Initialise the two AY music players.\nFor each of banks 27 and 28: page it in at $8000, make its AY chip active,\nthen call the player's init entry at $8003 with HL = tune address.\nRestores bank 2 at $8000 before returning. Tune addresses at $5C6B and\n$5C84 are patched by Start."
        },
        "7258": {
          "comment": "A = 2*27: page 16K bank 27 into $8000-$BFFF"
        },
        "7267": {
          "comment": "$FFFD = AY register select / chip select"
        },
        "7270": {
          "comment": "$01|$FC = $FD: both channels on, AY 2 active"
        },
        "7274": {
          "comment": "Tune address \u2014 operand PATCHED at $5C6B by Start"
        },
        "7277": {
          "comment": "Player init entry in the paged bank"
        },
        "7295": {
          "comment": "$02|$FC = $FE: both channels on, AY 1 active"
        },
        "7299": {
          "comment": "Tune address \u2014 operand PATCHED at $5C84 by Start"
        },
        "7305": {
          "comment": "A = 2*2: restore bank 2 at $8000 before returning"
        },
        "7316": {
          "synopsis": "Advance both AY tunes by one frame.\nSame bank/chip dance as MusicInit, but calls the player's play entry at\n$8005. Called from the interrupt handler, so it runs once per frame."
        },
        "7335": {
          "comment": "Player play entry in the paged bank"
        },
        "7371": {
          "synopsis": "Install IM2 with the vector table at $7900.\nAny data-bus value selects $7878, because the 257-byte table is filled with\n$78. Leaves interrupts disabled; Start re-enables them with EI."
        },
        "7379": {
          "synopsis": "Interrupt handler, entered once per frame via Im2Trampoline.\nSaves every register including the alternate set, advances the music and\nthe demo's per-frame work, then restores and returns with EI/RETI."
        },
        "7394": {
          "comment": "Advance both tunes"
        },
        "7397": {
          "comment": "Per-frame demo update"
        },
        "14456": {
          "synopsis": "IM2 trampoline. The vector table can only supply an address whose high and\nlow bytes are equal, so it lands here and jumps to the real handler."
        },
        "14592": {
          "synopsis": "IM2 vector table: 257 bytes of $78, so any data-bus value reads the word\n$7878. 257 rather than 256 so the high byte is valid at offset $FF."
        }
      }
    },
