      "lastView": "disassembly",
      "decimalView": false,
      "lineAnnotations": {
        "3594": {
          "synopsis": "Place sprites 60-63 in the four corners of the 256x192 display area.\nThey use patterns $20-$23 and are made visible. Sprite coordinates\nhave (32,32) as the top-left pixel of the display area.\nDestroys A, BC, DE, L.",
          "comment": "Start at sprite 60"
        },
        "3599": {
          "comment": "Sprite 60: X=32, Y=208, pattern $20 (bottom-left)"
        },
        "3616": {
          "comment": "Attribute 2: D = bit 8 of X"
        },
        "3621": {
          "comment": "Attribute 3: visible + pattern, then next sprite"
        },
        "3627": {
          "comment": "Sprite 61: X=272, Y=208, pattern $21 (bottom-right)"
        },
        "3655": {
          "comment": "Sprite 62: X=32, Y=32, pattern $22 (top-left)"
        },
        "3683": {
          "comment": "Sprite 63: X=272, Y=32, pattern $23 (top-right)"
        },
        "4188": {
          "synopsis": "Copy BC bytes from HL to DE using the zxnDMA.\nWrites HL, BC and DE into DmaSource, DmaLength and DmaDest inside\nDmaProgram, then sends the 16-byte program to port $6B. Faster than LDIR\nand used for the bulk screen and asset copies. Destroys BC, HL.",
          "comment": "HL -> DmaSource"
        },
        "4191": {
          "comment": "DE -> DmaDest"
        },
        "4195": {
          "comment": "BC -> DmaLength"
        },
        "4199": {
          "comment": "Send the whole of DmaProgram..."
        },
        "4202": {
          "comment": "...16 bytes..."
        },
        "4204": {
          "comment": "...to the zxnDMA port"
        },
        "4209": {
          "synopsis": "zxnDMA program for a memory-to-memory copy, 16 bytes, sent to port $6B.\nDmaCopy fills in DmaSource, DmaLength and DmaDest before each send.\nThe program disables the DMA, sets both ports to memory counting up,\nloads the addresses and length, then enables it; the copy runs\nimmediately in continuous mode. Data, not code.",
          "comment": "$83 WR6: disable DMA; $7D WR0: A->B transfer, source and length follow"
        },
        "4211": {
          "comment": "WR0 parameter: port A address"
        },
        "4213": {
          "comment": "WR0 parameter: block length"
        },
        "4215": {
          "comment": "$54 $01 WR1: port A memory, increment, timing; $50 $01 WR2: same for B"
        },
        "4219": {
          "comment": "$AD WR4: continuous mode, port B address follows"
        },
        "4220": {
          "comment": "WR4 parameter: port B address"
        },
        "4222": {
          "comment": "$82 WR5: stop at end of block; $CF WR6: load; $87 WR6: enable"
        },
        "4225": {
          "synopsis": "Send BC bytes from HL to the Next register data port $253B using the zxnDMA.\nThe caller selects the register first through port $243B. Writes HL and BC\ninto DmaRegSource and DmaRegLength inside DmaNextRegProg, then sends the\n16-byte program to port $6B. Used at $9E88 to load the copper list: register\n$60 (copper data), $540 bytes from $9E94. Destroys BC, HL.",
          "comment": "HL -> DmaRegSource"
        },
        "4228": {
          "comment": "BC -> DmaRegLength"
        },
        "4232": {
          "comment": "Send the whole of DmaNextRegProg..."
        },
        "4235": {
          "comment": "...16 bytes..."
        },
        "4237": {
          "comment": "...to the zxnDMA port"
        },
        "4242": {
          "synopsis": "zxnDMA program for a memory-to-I/O copy, 16 bytes, sent to port $6B.\nDmaToNextReg fills in DmaRegSource and DmaRegLength before each send.\nPort B is fixed at $253B, so every byte goes to the Next register chosen\nthrough $243B. Data, not code.",
          "comment": "$83 WR6: disable DMA; $7D WR0: A->B transfer, source and length follow"
        },
        "4244": {
          "comment": "WR0 parameter: port A address"
        },
        "4246": {
          "comment": "WR0 parameter: block length"
        },
        "4248": {
          "comment": "$54 $02 WR1: port A memory, increment, timing; $68 $02 WR2: port B I/O, fixed"
        },
        "4252": {
          "comment": "$AD WR4: continuous mode, port B address follows"
        },
        "4253": {
          "comment": "WR4 parameter: port B address $253B, Next register data"
        },
        "4255": {
          "comment": "$82 WR5: stop at end of block; $CF WR6: load; $87 WR6: enable"
        },
        "4258": {
          "synopsis": "Send BC bytes from HL to the sprite pattern port $5B using the zxnDMA.\nWrites HL and BC into DmaSprSource and DmaSprLength inside\nDmaSpriteProgram, then sends the 16-byte program to port $6B. Select the\nfirst pattern through port $303B before calling. DE is not used.\nDestroys BC, HL.",
          "comment": "HL -> DmaSprSource"
        },
        "4261": {
          "comment": "BC -> DmaSprLength"
        },
        "4265": {
          "comment": "Send the whole of DmaSpriteProgram..."
        },
        "4268": {
          "comment": "...16 bytes..."
        },
        "4270": {
          "comment": "...to the zxnDMA port"
        },
        "4275": {
          "synopsis": "zxnDMA program for a memory-to-I/O copy, 16 bytes, sent to port $6B.\nDmaToSprites fills in DmaSprSource and DmaSprLength before each send.\nPort B is fixed at $005B, so every byte goes to the sprite pattern\nport. Data, not code.",
          "comment": "$83 WR6: disable DMA; $7D WR0: A->B transfer, source and length follow"
        },
        "4277": {
          "comment": "WR0 parameter: port A address"
        },
        "4279": {
          "comment": "WR0 parameter: block length"
        },
        "4281": {
          "comment": "$54 $02 WR1: port A memory, increment, timing; $68 $02 WR2: port B I/O, fixed"
        },
        "4285": {
          "comment": "$AD WR4: continuous mode, port B address follows"
        },
        "4286": {
          "comment": "WR4 parameter: port B address $005B, sprite patterns"
        },
        "4288": {
          "comment": "$82 WR5: stop at end of block; $CF WR6: load; $87 WR6: enable"
        },
        "4585": {
          "synopsis": "Print D characters from HL into the tilemap at row B, column C.\nTile index is the character code less $20, so the tile set starts at space."
        },
        "4586": {
          "comment": "ASCII -> tile index"
        },
        "4604": {
          "synopsis": "Write scanline numbers into the WAITs of the two copper tables.\nCopperLines ($9465) is the working table and CopperLinesReset ($98E5) is\nthe clean copy that is copied back over it. Each has 96 records of 12\nbytes: WAIT (line), MOVE $40,0, then MOVE $41,colour four times, which\nreloads ULA palette entries 0-3. Record i gets line 32+i. Destroys A, B,\nDE, HL.",
          "comment": "Line byte (WAIT low byte) of the first working record"
        },
        "4607": {
          "comment": "Line byte of the first reset record"
        },
        "4610": {
          "comment": "96 records"
        },
        "4612": {
          "comment": "First line is 32 ($20): records cover ULA pixel rows 32-127"
        },
        "4617": {
          "comment": "12 bytes per record"
        },
        "5221": {
          "synopsis": "CopperLines: the working copper table, 96 records of 12 bytes (six copper\ninstructions each), one record per ULA pixel row 32-127:\n  WAIT  line 32+i, h=32  - fires at pixel column 256, in the right border\n  MOVE  $40,$00          - palette index := 0\n  MOVE  $41,colour  x4   - palette entries 0, 1, 2, 3 (index auto-increments)\nCopper instructions are two bytes, most significant first:\n  WAIT  %1hhhhhhv vvvvvvvv - hold until raster line v, pixel column >= h*8\n  MOVE  %0rrrrrrr vvvvvvvv - write v to Next register r\nThe line bytes are 0 in the file; InitCopperLines writes 32+i into them.\nUpdateCopperBars sets nextreg $43 = $00, so $41 writes the ULA first palette\nand entries 0-3 are INK 0-3: each record recolours inks 0-3 from the next row\ndown. Rebuilt every frame from CopperLinesReset, then painted with the bars.\nUploaded into the copper list in three $180-byte blocks; this first block,\nrows 32-63, goes to CopperListRows ($9EAA).",
          "comment": "WAIT line 32, pixel column 256 (right border)"
        },
        "6373": {
          "synopsis": "CopperLinesReset: the clean copy of CopperLines, in the same 12-byte format.\nEvery record sets palette entries 0-3 (INK 0-3) to $00, $20, $40, $60 -\nblack and red at 1/7, 2/7 and 3/7 intensity (colours are RRRGGGBB).\nInitCopperLines fills in its line numbers too. CopperBarsFrame copies it back\nover CopperLines ($480 bytes) every frame before the bars are painted.",
          "comment": "WAIT line 32, pixel column 256 (right border)"
        },
        "7816": {
          "comment": "Load the copper list: $540 bytes from $9E94 into register $60"
        },
        "9728": {
          "comment": "Use Layer 2 first palette"
        },
        "9732": {
          "comment": "Reset Layer 2 palette index"
        },
        "9736": {
          "comment": "Fill the Layer 2 palette"
        },
        "9739": {
          "comment": "Use Sprites first palette"
        },
        "9743": {
          "comment": "Reset Sprites palette index"
        },
        "9747": {
          "comment": "TAIL CALL: InitPaletteRamp's RET returns to InitPalettes' caller"
        },
        "9750": {
          "synopsis": "Fill the currently selected palette with an identity ramp.\nWrites entries 0..255, each set to its own index. The palette must already\nbe selected via nextreg $43. Destroys A."
        },
        "9764": {
          "synopsis": "Demo setup, entered from EntryPoint. Runs with interrupts off.\nInitialises palettes and layers, chooses the tune set, clears the clip\nwindows, copies the two ULA screens in, loads sprites and tiles, starts the\nmusic and installs the frame interrupt. Falls through to the main loop\nonce EI is reached."
        },
        "9765": {
          "comment": "Identity-ramp the Layer 2 and Sprite palettes"
        },
        "9768": {
          "comment": "$85: lores on, layer order L-S-U, sprites enabled"
        },
        "9773": {
          "comment": "Tune-set selector; 0 in this build"
        },
        "9780": {
          "synopsis": "Default tune set: both players get the tune at $8893."
        },
        "9783": {
          "comment": "Patches the LD HL operand at $5C6A"
        },
        "9789": {
          "comment": "Patches the LD HL operand at $5C83"
        },
        "9795": {
          "synopsis": "Alternative tune set, selected when ConfigFlag is non-zero."
        },
        "9807": {
          "synopsis": "Collapse the Layer 2, Sprite and ULA clip windows to a single pixel.\nEach register takes four successive writes — X1, X2, Y1, Y2 — and all four\nare zero here, so nothing from these layers is drawn while setup runs.\nThe write index is not reset first, but with four identical values the\nstarting position does not matter."
        },
        "9873": {
          "comment": "Four-colour LoRes palette"
        },
        "9876": {
          "comment": "Black border"
        },
        "9880": {
          "comment": "$E3 = transparent: empty Layer 2"
        },
        "9885": {
          "comment": "Hide sprites 0-64"
        },
        "9888": {
          "comment": "A = 2*26: page 16K bank 26 into $C000-$FFFF"
        },
        "9898": {
          "synopsis": "Copy the two ULA screen bitmaps from bank 26 into place.\n$1800 bytes each: the first to $4000 and the second to $6000, the two\ndisplay banks Timex mode alternates between."
        },
        "9922": {
          "comment": "A = 2*12: page 16K bank 12 into $C000-$FFFF"
        },
        "9932": {
          "comment": "$303B: select sprite 0 and pattern 0"
        },
        "9943": {
          "comment": "Length is BC, still $303B from the port write: 48 patterns + 59 bytes"
        },
        "9946": {
          "comment": "Scanline numbers for the copper tables"
        },
        "9949": {
          "comment": "Four corner sprites"
        },
        "9952": {
          "comment": "Start both tunes"
        },
        "9955": {
          "synopsis": "Print the two title lines into the tilemap."
        },
        "9961": {
          "comment": "16 characters; B = row, C = column"
        },
        "9977": {
          "comment": "Install the frame interrupt (still disabled)"
        },
        "9980": {
          "comment": "Interrupts on — the demo is now running"
        },
        "9981": {
          "comment": "$03: 28 MHz"
        },
        "10204": {
          "synopsis": "Set ULA palette entries 0-3 to a four-step red ramp.\nEntries: $00, $20, $40, $60 (RRRGGGBB). The LoRes picture only uses\npixel values 0-3, so these are its whole palette. The copper list\n(CopperLines) rewrites the same four entries on each scanline later.",
          "comment": "Edit the ULA first palette, ULANext off"
        },
        "10208": {
          "comment": "Start at palette entry 0"
        },
        "10212": {
          "comment": "Entries 0-3 = $00, $20, $40, $60; the index advances after each write"
        },
        "10229": {
          "synopsis": "Tune-set selector read by Start. 0 = default tunes."
        },
        "10230": {
          "synopsis": "Title line 1, exactly 16 characters: \"  SCROLLNUTTER  \"."
        },
        "10246": {
          "synopsis": "Title line 2, exactly 16 characters: \"   NEXT  DEMO   \"."
        },
        "10262": {
          "synopsis": "Unidentified data table, 15 bytes then zero padding.\nNot reached as code by the entry flow; purpose not yet established.\n$A81D-$A81E is CopperBarsWait, the frames before the copper bars start."
        },
        "5605": {
          "synopsis": "Second upload block: records 32-63, rows 64-95. Goes to $A030.",
          "comment": "WAIT line 64, pixel column 256 (right border)"
        },
        "5989": {
          "synopsis": "Third upload block: records 64-95, rows 96-127. Goes to $A1B6.",
          "comment": "WAIT line 96, pixel column 256 (right border)"
        },
        "4614": {
          "comment": "Same line number into both tables"
        },
        "4616": {
          "comment": "Next record, next line"
        },
        "4625": {
          "comment": "Until all 96 records carry their line"
        },
        "4628": {
          "synopsis": "Copper bar state, all updated by UpdateCopperBars.",
          "comment": "Bars drawn = value - 1 (starts at 1, grows to 10)"
        },
        "4629": {
          "comment": "Frames until another bar is added (reloaded with 24)"
        },
        "4630": {
          "comment": "Frames until the next colour scheme (reloaded with 500)"
        },
        "4632": {
          "comment": "Colour scheme in use: 0 or 1 (ColourSchemes)"
        },
        "4633": {
          "synopsis": "Per-frame copper bars, called from IsrMain (bank 5) every frame.\nAfter an initial countdown (CopperBarsWait), rebuilds CopperLines from its clean\ncopy, paints up to 10 bars into it, and uploads the rows into the live copper list.\nEach bar is 16 rows of a mirrored colour gradient whose top row follows\nBarSineTable. The gradient colours fade every 8 frames towards one of two\ncolour schemes, which alternate every 500 frames.\nDestroys AF, BC, DE, HL, IX (IsrMain saves them).",
          "comment": "ULA first palette, auto-increment on: the target of the copper's MOVE $41"
        },
        "4637": {
          "synopsis": "Wait out the start delay: return early while CopperBarsWait is non-zero.",
          "comment": "Frames left before the bars start"
        },
        "4640": {
          "comment": "HL = 0?"
        },
        "4642": {
          "comment": "Delay over: run the effect"
        },
        "4644": {
          "comment": "Count one frame down"
        },
        "4648": {
          "comment": "Nothing more to do this frame"
        },
        "4649": {
          "synopsis": "Start from clean rows: copy CopperLinesReset over CopperLines.",
          "comment": "Source: the clean copy"
        },
        "4652": {
          "comment": "Destination: the working table"
        },
        "4655": {
          "comment": "All 96 records x 12 bytes"
        },
        "4658": {
          "comment": "zxnDMA copy (preserves DE)"
        },
        "4661": {
          "synopsis": "Bring in one more bar every 24 frames, up to 10.",
          "comment": "Frames until the next bar"
        },
        "4665": {
          "comment": "Timer ran out: try to add a bar"
        },
        "4667": {
          "comment": "Otherwise count down"
        },
        "4671": {
          "comment": "and draw the bars"
        },
        "4673": {
          "comment": "Bar count (drawn bars + 1)"
        },
        "4676": {
          "comment": "11 = all 10 bars already in"
        },
        "4680": {
          "comment": "One more bar"
        },
        "4684": {
          "comment": "Next bar in 24 frames"
        },
        "4689": {
          "synopsis": "Paint the bars. IX walks BarTable (phase, gradient) from its first entry;\nB counts 10 down to 1, and entry B is drawn only while B < CopperBarCount.",
          "comment": "C = bar count"
        },
        "4693": {
          "comment": "First bar entry"
        },
        "4697": {
          "comment": "10 bars"
        },
        "4699": {
          "comment": "Keep the bar counter"
        },
        "4700": {
          "comment": "Sine table of top rows"
        },
        "4703": {
          "comment": "Advance this bar's phase (every bar moves, drawn or not)"
        },
        "4709": {
          "comment": "HL -> sine entry for the phase"
        },
        "4711": {
          "comment": "Is this bar in yet?"
        },
        "4713": {
          "comment": "B >= count: not drawn, next bar"
        },
        "4715": {
          "comment": "Top row of the bar, 0..80"
        },
        "4717": {
          "comment": "12 bytes per copper record"
        },
        "4719": {
          "comment": "DE = row * 12"
        },
        "4721": {
          "comment": "-> first colour byte of that row's record"
        },
        "4725": {
          "comment": "HL = colour byte to write"
        },
        "4726": {
          "comment": "Gradient number (1..5)"
        },
        "4729": {
          "comment": "x16: gradients are 16 entries each"
        },
        "4731": {
          "comment": "DE -> this bar's gradient in BarGradients"
        },
        "4736": {
          "comment": "16 rows per bar"
        },
        "4738": {
          "comment": "Gradient colour for this row"
        },
        "4740": {
          "comment": "0 = transparent: leave the row as it is"
        },
        "4742": {
          "comment": "Palette entry 0 (the MOVE $41 value byte)"
        },
        "4743": {
          "comment": "Skip to the next MOVE $41 value"
        },
        "4747": {
          "comment": "Entry 1"
        },
        "4752": {
          "comment": "Entry 2"
        },
        "4757": {
          "comment": "Entry 3"
