tsconfig.tsbuildinfo
tsconfig.web.tsbuildinfo

# Pagefind search index, generated by the docs postbuild step
_pagefind/

# Local venv used by dev/scripts/build-fonts.py
.fontenv/

# Local output of the checks and tools, never committed (dev/README.md):
#   .local/doc-shots/        doc-shots staging, reviewed before publishing into docs/
#   .local/rom-annotations/  `npm run rom:annotations -- coverage`, for the ROM annotation authors
#   .local/visual-tests/     test/harness/zxnext runs (frames, review prompts, verdicts)
#   .local/spectrum-kit/     pictures of the ZX Spectrum test kit's runs, for a by-eye check
#   .local/boriel-ide-check/ and .local/z88dk-ide-check/: throwaway homes and screenshots
#   .local/i18n-work/        i18n:todo batches and translators' answers (dev/ai/localization.md)
.local/

# Runs of the T80N differential (test/vhdl/f1/run-f1.cjs): case files, results, reports. Large and
# reproducible from the seed; the plan records each measured run's outcome
test/vhdl/f1/results/
# Runs of the whole-core replay (test/vhdl/f3/run-f3.cjs): programs, simulator inputs and outputs
test/vhdl/f3/results/

# Boriel BASIC setup kits: archives are downloaded (see dev/vendor/boriel-basic/README.md), never committed
dev/vendor/boriel-basic/kits/
dev/vendor/boriel-basic/stage/

# ZX Spectrum Next VHDL reference: fetched by `npm run next-fpga:fetch`, never committed; only the
# pins (sources.json) and Klive's comment patches (comments/) are tracked
dev/vendor/next-fpga/*/
!dev/vendor/next-fpga/comments/

# Website facts generated at build time (dev/scripts/build-doc-site-info.cjs)
docs/generated/
docs/content/en/reference/whats-new.mdx

# Hallmark: the pinned clone, its
# browser driver, run logs and reports stay local, never committed.
.hallmark/
.claude/skills/hallmark/
