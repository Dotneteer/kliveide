src/emu/machines/zxSpectrum48/wasm/test-dist
tsconfig.tsbuildinfo
tsconfig.web.tsbuildinfo

# Pagefind search index, generated by the docs postbuild step
_pagefind/

# Local venv used by scripts/build-fonts.py
.fontenv/

# Staging output of scripts/doc-shots/run.cjs, reviewed before publishing into docs/
.doc-shots/
# Output of `npm run rom:annotations -- coverage`, read by the ROM annotation authors
.rom-annotations/
# Output of test/harness/zxnext (PNG frames, review prompts, verdicts); see .plans/COPPER_VISUAL_TEST_HARNESS_PLAN.md
.visual-tests/
# Pictures of the ZX Spectrum test kit's runs (test/spectrum-kit/), for a by-eye check
.spectrum-kit/
# Runs of the T80N differential (test/vhdl/f1/run-f1.cjs): case files, results, reports. Large and
# reproducible from the seed; the plan records each measured run's outcome
test/vhdl/f1/results/
# Runs of the whole-core replay (test/vhdl/f3/run-f3.cjs): programs, simulator inputs and outputs
test/vhdl/f3/results/

# Boriel BASIC setup kits: archives are downloaded (see vendor/boriel-basic/README.md), never committed
vendor/boriel-basic/kits/
vendor/boriel-basic/stage/

# ZX Spectrum Next VHDL reference: fetched by `npm run next-fpga:fetch`, never committed; only the
# pins (sources.json) and Klive's comment patches (comments/) are tracked
vendor/next-fpga/*/
!vendor/next-fpga/comments/
# Output of scripts/boriel-ide-check.cjs (throwaway homes and screenshots)
.boriel-ide-check/
# Output of scripts/z88dk-ide-check.cjs (throwaway homes and screenshots)
.z88dk-ide-check/

# Localization work files: i18n:todo batches and translators' answers (LOCALIZATION_PLAN §6)
i18n-work/

# Website facts generated at build time (scripts/build-doc-site-info.cjs)
docs/generated/
docs/content/en/reference/whats-new.mdx

# Hallmark (.plans/HALLMARK_SITE_POLISH_PLAN.md, H2/H5): the pinned clone, its
# browser driver, run logs and reports stay local, never committed.
.hallmark/
.claude/skills/hallmark/
