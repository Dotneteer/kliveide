procedure putimage_2x8_normal;
begin
 for byte_1b:=0 to 8 do // 0..7
   begin
   kepernyo[0]:=forras[0];
   kepernyo[1]:=forras[1];
   kepernyo:=kepernyo+64; forras:=forras+2;
   end;
end;
procedure putimage_2x8_or;
begin
 for byte_1b:=0 to 8 do // 0..7
   begin
   kepernyo[0]:=kepernyo[0]|forras[0];
   kepernyo[1]:=kepernyo[1]|forras[1];
   kepernyo:=kepernyo+64; forras:=forras+2;
   end;
end;
procedure putimage_2x8_and;
begin
 for byte_1b:=0 to 8 do // 0..7
   begin
   kepernyo[0]:=kepernyo[0]&forras[0];
   kepernyo[1]:=kepernyo[1]&forras[1];
   kepernyo:=kepernyo+64; forras:=forras+2;
   end;
end;
