 if by4=9 then begin TVC_alapunit2::szoveg:="DEMÓ";e4b:=1;end;	
 if by4=10 then begin TVC_alapunit2::szoveg:="1";e4b:=1;end;	
 if by4=11 then begin TVC_alapunit2::szoveg:="KIEGÉSZÍTßO";e4b:=1;end;	
 if by4=12 then begin TVC_alapunit2::szoveg:="3";e4b:=1;end;	
 if by4=13 then begin TVC_alapunit2::szoveg:="EX";e4b:=1;end;	
 if by4=14 then begin TVC_alapunit2::szoveg:="EX 2";e4b:=1;end;	
 
end;
procedure egy_karakterrel_jobbra;
begin
 TVC_alapunit2::kepernyo:=TVC_alapunit2::kepernyo+2;
 TVC_alapunit2::szovegXb:=TVC_alapunit2::szovegXb+2;
 if (TVC_alapunit2::szovegXb>62) then // egy sorral lejjebb
           begin 
	       TVC_alapunit2::szovegXb:=0; 
	       TVC_alapunit2::szovegYb:=TVC_alapunit2::szovegYb+8;
		   TVC_alapunit2::kepernyo:=TVC_alapunit2::kepernyo+7*64;
           end;
end;
procedure random_nev_generalasa;
begin

 TVC_alapunit2::szamol_kepernyo_ertek(0,100);

 for i:=0 to 16 do
   begin 
   TVC_alapunit2::rajz_egyszinu_egysor(0);
   TVC_alapunit2::kepernyo:=TVC_alapunit2::kepernyo+64;
   end;

 TVC_alapunit2::szamol_kepernyo_ertek(0,100);
 TVC_alapunit2::szovegXb:=0;
 
 TVC_alapunit2::random_szamgeneralas;
 randomertek1:=(randomertek1+TVC_alapunit2::ran+rand1)&255;
 rand1:=rand1+1;
 
 szoveg1(randomertek1);
 TVC_alapunit2::SZOVEG_konvertal;
 TVC_alapunit2::SZOVEG_IR; 
 egy_karakterrel_jobbra;

 randomertek2:=(randomertek2+rand2)&255;
 rand2:=rand2+1;
 szoveg2(randomertek2);
 TVC_alapunit2::SZOVEG_konvertal;
 TVC_alapunit2::SZOVEG_IR; 
 egy_karakterrel_jobbra;
 
 randomertek3:=(randomertek3+TVC_alapunit2::ran+rand3)&255;
 rand3:=rand3+1;
 szoveg3(randomertek3);
 TVC_alapunit2::SZOVEG_konvertal;
 TVC_alapunit2::SZOVEG_IR; 
 egy_karakterrel_jobbra;
 

  i:=(randomertek1+randomertek2+randomertek3+randomertek2+rand4)&15;
  rand4:=rand4+1;
  szoveg4(i);
  if e4b>0 then
    begin
    TVC_alapunit2::SZOVEG_konvertal;
    TVC_alapunit2::SZOVEG_IR; 
    end;
  
/*
 TVC_alapunit2::szamol_kepernyo_ertek(10,200);
 TVC_alapunit2::szovegXb:=0;
 TVC_alapunit2::byte_to_string2(e1);
 TVC_alapunit2::SZOVEG_IR; 
 TVC_alapunit2::kepernyo:=TVC_alapunit2::kepernyo+2;
 TVC_alapunit2::byte_to_string2(e2);
 TVC_alapunit2::SZOVEG_IR; 
 TVC_alapunit2::kepernyo:=TVC_alapunit2::kepernyo+2;
 TVC_alapunit2::byte_to_string2(e3);
 TVC_alapunit2::SZOVEG_IR; 
 TVC_alapunit2::kepernyo:=TVC_alapunit2::kepernyo+2;
 TVC_alapunit2::byte_to_string2(e4);
 TVC_alapunit2::SZOVEG_IR; 
 */

end;


procedure egy_sor(yyy:byte); // s2
var
  is:byte;
begin
 TVC_alapunit2::szamol_kepernyo_ertek(20,120+yyy);	
 k:=TVC_alapunit2::kepernyo;
 for is:=0 to 16 do
    k[is]:=s2;
end;
