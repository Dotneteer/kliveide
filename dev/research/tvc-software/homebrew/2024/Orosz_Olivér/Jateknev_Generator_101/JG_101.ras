procedure random_kepernyo_generalasa;
begin
 // színek
 s1:=(randomertek1+rand4)&15; 
 s2:=(randomertek2+rand1)&15;
 s1:=szin[s1];
 s2:=szin[s2];
 TVC_alapunit2::init_4colors(0,s1,s2,85);

  // háttércsempe
  a:=randomertek1&15;
  if a>9 then a:=a-9;
  forras:=#GRADATA+a SHL 4; f:=forras;	

  for j:=0 to 8 do // 0..7
  begin
  TVC_alapunit2::szamol_kepernyo_ertek(20,120+j*8);
  k:=TVC_alapunit2::kepernyo;
  for i:=0 to 8 do // 0..7
   begin  kepernyo:=k; forras:=f;	
   putimage_2x8_normal;  k:=k+2;  end;
  end;
 

  // labirintus mintázata
  a:=10+randomertek1&31;
  forras:=#GRADATA+a SHL 4; f:=forras;	
  for j:=0 to 8 do // 0..7
  begin
  TVC_alapunit2::szamol_kepernyo_ertek(20,120+j*8);
  k:=TVC_alapunit2::kepernyo;
  for i:=0 to 8 do // 0..7
    begin  kepernyo:=k; 
    a:=10+randomertek1&31;
    forras:=#GRADATA+a SHL 4;
    putimage_2x8_and;  k:=k+2;  
    randomertek1:=randomertek1+1+i&1;
    end;
  end;

 // ALSÓ-FELSŐ CSÍKOK
 x:=randomertek1 & 3;
 s2:=0;
 if (randomertek1 & 2)=0 then s2:=15;
 if (randomertek1 & 4)=4 then s2:=240;
 if (randomertek1 & 8)=0 then s2:=255;
 if x=1 then 
     begin
	 i2:=(rand5+randomertek2)&7;
     if i2<2 then i2:=2;  
	 for i:=0 to i2 do
	   begin
	   egy_sor(0+i+i);	   
	   egy_sor(63-i-i);	   
	   end;
     end;
 if x=2 then 
     begin
	 i2:=(rand5+randomertek3)&15;
     if i2<1 then i2:=1;   
     if i2>8 then i2:=8; 
	 for i:=0 to i2 do
	   begin
	   egy_sor(0+i);	   
	   egy_sor(63-i);	   
	   end;
     end;



   x:=(randomertek1 SHR 3)&15; if x>13 then x:=13;
   y:=(randomertek2 SHR 2)&63; if y>54 then y:=54;
   TVC_alapunit2::szamol_kepernyo_ertek(20+x,120+y);
   kepernyo:=TVC_alapunit2::kepernyo;
   a:=(42+randomertek2&31)&63; 
   randomertek2:=randomertek2+1;
   forras:=#GRADATA+a SHL 4; 
   putimage_2x8_or;

   x:=(randomertek2 SHR 1)&15; if x>13 then x:=13;
   y:=randomertek3&63; if y>54 then y:=54;
   TVC_alapunit2::szamol_kepernyo_ertek(20+x,120+y);
   kepernyo:=TVC_alapunit2::kepernyo;
   a:=(42+randomertek2&31)&63; 
   randomertek2:=randomertek2+2;
   forras:=#GRADATA+a SHL 4; 
   putimage_2x8_or;
   
   x:=(randomertek2 SHR 4)&15; if x>13 then x:=13;
   y:=(randomertek1 SHR 2)&63; if y>54 then y:=54;
   TVC_alapunit2::szamol_kepernyo_ertek(20+x,120+y);
   kepernyo:=TVC_alapunit2::kepernyo;
   a:=42+randomertek2&15; 
   randomertek2:=randomertek2+1;
   forras:=#GRADATA+a SHL 4; 
   putimage_2x8_or;
   
   x:=(randomertek3 SHR 1)&15; if x>13 then x:=13;
   y:=randomertek1&63; if y>54 then y:=54;
   TVC_alapunit2::szamol_kepernyo_ertek(20+x,120+y);
   kepernyo:=TVC_alapunit2::kepernyo;
   a:=42+randomertek2&7; 
   forras:=#GRADATA+a SHL 4; 
   putimage_2x8_or;
 
 if rand5&1=1 then
   begin 
   x:=(randomertek3 SHR 2)&15; if x>13 then x:=13;
   y:=(randomertek1 SHR 2)&63; if y>54 then y:=54;
   TVC_alapunit2::szamol_kepernyo_ertek(20+x,120+y);
   kepernyo:=TVC_alapunit2::kepernyo;
   a:=(42+randomertek2&31)&63; 
   forras:=#GRADATA+a SHL 4; 
   putimage_2x8_or;
   end;
   
 if rand5&2=0 then
   begin 
   x:=(randomertek1 SHR 4)&15; if x>13 then x:=13;
   y:=(randomertek2 SHR 1)&63; if y>54 then y:=54;
   TVC_alapunit2::szamol_kepernyo_ertek(20+x,120+y);
   kepernyo:=TVC_alapunit2::kepernyo;
   a:=(42+randomertek2&31)&63; 
   randomertek2:=randomertek2+3;
   forras:=#GRADATA+a SHL 4; 
   putimage_2x8_or;
   end;
   
   randomertek2:=randomertek2+1;
   
   x:=(randomertek2 SHR 3)&15; if x>13 then x:=13;
   y:=(randomertek1 SHR 2)&63; if y>54 then y:=54;
   TVC_alapunit2::szamol_kepernyo_ertek(20+x,120+y);
   kepernyo:=TVC_alapunit2::kepernyo;
   a:=42; 
   forras:=#GRADATA+a SHL 4; 
   putimage_2x8_normal;

end;

procedure random_adat_generalasa;
begin
	

 TVC_alapunit2::random_szamgeneralas;
 s1:=TVC_alapunit2::ran;

 TVC_alapunit2::szamol_kepernyo_ertek(38,210);
 TVC_alapunit2::szovegXb:=0;
 i2:=11+(s1+rand1)&31;
 TVC_alapunit2::byte_to_string2(i2);
 TVC_alapunit2::SZOVEG_konvertal;
 TVC_alapunit2::SZOVEG_IR; 
 
 TVC_alapunit2::szamol_kepernyo_ertek(38,220);
 TVC_alapunit2::szovegXb:=0;
 i2:=22+((s1+rand2+rand3)SHL 1)&63;
 TVC_alapunit2::byte_to_string2(i2);
 TVC_alapunit2::SZOVEG_konvertal;
 TVC_alapunit2::SZOVEG_IR; 
	
 TVC_alapunit2::szamol_kepernyo_ertek(40,230);
 TVC_alapunit2::szovegXb:=0;
 i2:=1+((s1-rand2-rand1+rand5)SHR 2)&7;
 TVC_alapunit2::byte_to_string2(i2);
 TVC_alapunit2::SZOVEG_konvertal;
 TVC_alapunit2::SZOVEG_IR; 
	
end;

begin
 TVC_alapunit2::init_Graphics(1); // video mód beállítása
 TVC_alapunit2::set_Vmemory32768;
 TVC_alapunit2::init_4colors(0,68,21,85);
 TVC_alapunit2::megszakitas_init;

 TVC_alapunit2::kepernyotorles(0);
/*
 for i:=0 to 59 do
   begin
   TVC_alapunit2::szamol_kepernyo_ertek(0,i+i+i+i);
   TVC_alapunit2::rajz_egyszinu_egysor(%00001111);
   end;
*/

 TVC_alapunit2::szamol_kepernyo_ertek(0,10);
 TVC_alapunit2::szovegXb:=0;
 TVC_alapunit2::szoveg:="játéknév generátor 1.01";
 TVC_alapunit2::SZOVEG_konvertal;
 TVC_alapunit2::SZOVEG_IR; 
 TVC_alapunit2::szamol_kepernyo_ertek(0,20);
 TVC_alapunit2::szovegXb:=0;
 TVC_alapunit2::szoveg:="(2024 -OROSZ OLIVÉR)";
 TVC_alapunit2::SZOVEG_konvertal;
 TVC_alapunit2::SZOVEG_IR; 

 TVC_alapunit2::szamol_kepernyo_ertek(0,40);
 TVC_alapunit2::szovegXb:=0;
 TVC_alapunit2::szoveg:="random játéknév (space):";
 TVC_alapunit2::SZOVEG_konvertal;
 TVC_alapunit2::SZOVEG_IR; 


 TVC_alapunit2::szamol_kepernyo_ertek(4,210);
 TVC_alapunit2::szovegXb:=0;
 TVC_alapunit2::szoveg:="CAS fájl mérete: 00 kbyte";
 TVC_alapunit2::SZOVEG_konvertal;
 TVC_alapunit2::SZOVEG_IR; 
 
 TVC_alapunit2::szamol_kepernyo_ertek(4,220);
 TVC_alapunit2::szovegXb:=0;
 TVC_alapunit2::szoveg:="     értékelése: 00 százalék";
 TVC_alapunit2::SZOVEG_konvertal;
 TVC_alapunit2::SZOVEG_IR; 
 TVC_alapunit2::szamol_kepernyo_ertek(2,230);
 TVC_alapunit2::szovegXb:=0;
 TVC_alapunit2::szoveg:="helyezés versenyen: ";
 TVC_alapunit2::SZOVEG_konvertal;
 TVC_alapunit2::SZOVEG_IR; 
	


 randomertek1:=77;
 randomertek2:=33;
 randomertek3:=218;
 
 rand1:=7;
 rand2:=3;
 rand3:=1;
 rand4:=9;
 rand5:=172;

 random_nev_generalasa;

 random_kepernyo_generalasa;
 
 random_adat_generalasa;
 
 
 
 while (1=1) do // FŐ ciklus, cégtelen ciklus
     begin
	 
     TVC_alapunit2::VARAKOZIK_SPACE_LENYOMASRA_ESFELENGEDESRE;    
     random_nev_generalasa;
	 
     random_kepernyo_generalasa;
     
     random_adat_generalasa;
   
     end;
     
end.
