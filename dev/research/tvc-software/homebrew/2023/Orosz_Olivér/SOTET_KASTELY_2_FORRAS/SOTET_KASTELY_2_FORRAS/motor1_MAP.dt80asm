		; Az INCLUDE file nem tartalmazhat  END és INCBIN utasításokat, de eltekintve szabványos asm file
		; Ide írható a saját kód..

;*********************************************************************************************************				
	MAP_masolas_fejes	
			; INPUT:   A=pálya sorszáma       
                        ; HL: forrás  DE: cél  BC : darabszám   
			; 32 byte, tehát a felső 2 sor az minden pályán ugyanaz
				ld	HL,MAPS_fej
				ld	DE,MAP	
				ld	BC,32
				ldiR
				ld	HL,MAPS
_				ld	BC,208
	MAP_masolas_fejes_ciklus; A=pálya     A-szor hozzá adunk 208-at,  a végén
				; HL=MAPS+palya*208     -tehát a pontos pályára mutat			
				cp	0
				JP	Z,MAP_masolas_fejes_vege
				add	HL,BC
				DEC	A
				JP	MAP_masolas_fejes_ciklus
	MAP_masolas_fejes_vege  ; Kiszámoltuk a címet, másoljuk a 208 byte-ot ami a pálya
				ldiR
				ret				; [10]
;*********************************************************************************************************				
	MAP_masolas
			; INPUT:   A=pálya sorszáma       
                        ; HL: forrás  DE: cél  BC : darabszám
				ld	HL,MAPS
				ld	DE,MAP	
				ld	BC,240
	MAP_masolas_fejes_ciklusT; A=pálya     A-szor hozzá adunk 240-et,  a végén
				; HL=MAPS+palya*240     -tehát a pontos pályára mutat			
				cp	0
				JP	Z,MAP_masolas_fejes_vegeT
				add	HL,BC
				DEC	A
				JP	MAP_masolas_fejes_ciklusT
	MAP_masolas_fejes_vegeT  ; Kiszámoltuk a címet, másoljuk a 208 byte-ot ami a pálya
				ldiR
				ret				; [10]
;*********************************************************************************************************				
	MAP_randomko		
			; INPUT: -
			; 30-31,32-33,34 elem helyére random követ (1) és utat (0) teszünk
			; Beállítjuk elem1a és elem1b értékét
				ld	A,(2845)
				ld	B,2
				and	B
				cp	B
				jp	NZ,MAP_randomko_cim1
				ld	A,0
				ld	(elem1a),A
				inc	A
				ld	(elem1b),A
				jp	MAP_randomko_cim2
		MAP_randomko_cim1	
				ld	A,0
				ld	(elem1b),A
				inc	A
				ld	(elem1a),A
				;
		MAP_randomko_cim2	
				;
			; Beállítjuk elem2a és elem2b értékét
				ld	A,(2845)
				ld	B,4
				and	B
				cp	B
				jp	NZ,MAP_randomko_cim3
				ld	A,0
				ld	(elem2a),A
				inc	A
				ld	(elem2b),A
				jp	MAP_randomko_cim4
		MAP_randomko_cim3	
				ld	A,0
				ld	(elem2b),A
				inc	A
				ld	(elem2a),A
		MAP_randomko_cim4	
				;
			; Beállítjuk elem3 értékét
				ld	A,(2845)
				ld	B,1
				and	B
				ld	(elem3),A
				;
				; Ciklus, végig megyünk a MAP-on
				ld	HL,MAP
				ld	BC,239			; 239-szor fut le a CIKLUS 1
	MAP_randomko_ciklus1_R
				ld	A,(HL)			; A = következő elem a MAP-on
				ld	D,34
				cp	D
				jp	NZ,randomko_nem34_R
				ld	A,(elem3); 34 azaz random kő
				ld	(HL),A
				jp	MAP_randomko_ciklusvege
	randomko_nem34_R		
				ld	D,30
				cp	D
				jp	NZ,randomko_nem30_R
				ld	A,(elem1a); 30 azaz random kő 1a
				ld	(HL),A
				jp	MAP_randomko_ciklusvege
	randomko_nem30_R		
				ld	D,31
				cp	D
				jp	NZ,randomko_nem31_R
				ld	A,(elem1b); 31 azaz random kő 1b
				ld	(HL),A
				jp	MAP_randomko_ciklusvege
	randomko_nem31_R		
				ld	D,32
				cp	D
				jp	NZ,randomko_nem32_R
				ld	A,(elem2a); 32 azaz random kő 2a
				ld	(HL),A
				jp	MAP_randomko_ciklusvege
	randomko_nem32_R		
				ld	D,33
				cp	D
				jp	NZ,randomko_nem33_R
				ld	A,(elem2b); 33 azaz random kő 2b
				ld	(HL),A
				jp	MAP_randomko_ciklusvege
	randomko_nem33_R		
				;
				;
	MAP_randomko_ciklusvege
				inc	HL
				dec	C
				jp	NZ,MAP_randomko_ciklus1_R

				ret
	 elem1a			db	0
	 elem1b			db	0
	 elem2a			db	0
	 elem2b			db	0
	 elem3			db	0
;*********************************************************************************************************				
	MAP_randomko_randomminta
                        ; INPUT: -
			; Ahol kő van (1) oda 1..9 köveket szórunk szét
				ld	A,R
				ld	(randomszam),A
				;
				ld	HL,MAP
				ld	BC,239			; 239-szor fut le a CIKLUS 1
	MAP_randomko_ciklus1
				ld	A,(HL)			; A = következő elem a MAP-on
				ld	D,1
				cp	D
				jp	NZ,randomko_nem1
				; 1 azaz kő
				push	HL
				push	DE
				ld	HL,MAPR
				ld	D,0
				ld	A,(randomszam)
				ld	E,A
				ADD	HL,DE
				ld	A,(HL)

				pop 	DE
				pop	HL
				ld	(HL),A
	randomko_nem1		
				;
				ld	A,(randomszam)
				inc 	A
				ld	(randomszam),A

				inc	HL
				dec	C
				jp	NZ,MAP_randomko_ciklus1
				
				ret				; [10]
;*********************************************************************************************************				
				
