	; 16x15 elem 1 pálya 240 byte
	MAP	ds 256,$0
; 00=semmi    
; 01-09   FAL
; 10=start     11=exit
; 12=kard     13=ellenfél  !!!
; 14=kulcs    15=ajtó      !!!
; 16=kalapacs 17=torheto ko!!!      	
; 18=viz      19=tuz       !!!
; 20=eltolható kő        	
; 21=átjárható kő 
; 22=láthatatlan, fekete kő
; 23=kincs 		
; 24=köd 		
; 25=erős ell (varázsló) --- 3 kard 		
; 26=erős ajtó ------------- 3 kulcs 		
; 27=láthatatlan kő 		
; 28=láthatatlan kő látszik 		
; 29= 		
; 30=random kő 1/A   31=random kő 1/B 		
; 32=random kő 2/A   33=random kő 2/B 		
; 34=random kő
; 35= 		
;
	MAPS_fej ; 32 byte, 2 sor, "fejléc", ebben a játékban "üres"
	db	00,22,22,22,22,22,22,22,22,22,22,22,22,22,22,00  ;1
	db	19,22,22,22,22,22,22,22,22,22,22,22,22,22,22,19	 ;2

