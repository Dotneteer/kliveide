	SCROLL_VEGE
				ld	A,(foszerMX2)		; SpriteX pozíció                           
				ld	(foszerMX),A
				ld	A,(foszerMY2)		; SpriteY pozíció                           
				ld	(foszerMY),A
				; ide értünk az új pozícióba,
				; most kellene a 3x3 környező elemet kirajzolni
				call 	MAP_KIRAJZOL_3x3					;(foszerMY),(foszerMX)	
				;
				; Meg lekezelni, ha valamire ráléptünk
				ld	hl,MAP
				; BC= foszerMY2*16+foszerMX2
				ld	B,0
				ld	A,(foszerMY)
				sla	A  ; A=A*16
				sla	A
				sla	A
				sla	A
				ld	C,A
				ld	A,(foszerMX)
				add	A,C
				ld 	C,A
				; HL=HL+BC        HL=MAP+foszerMY2*16+foszerMX2  tehát az elem címe
				add	HL,BC
				; A=map[foszerMX2,foszerMY2]
				ld	A,(HL)

				ld	B,11  ; IF A=11 THEN... EXIT 
				cp	B
				jp	NZ,ELLENORZES_NEM_11_B	; A<>11
				;
				; A=11 azaz EXIT
				call ELJARAS_Pluszpalya
				call ELJARAS_megnyeres_kicsi		
				;
	ELLENORZES_NEM_11_B
				;
				;
				;
				;
				jp MAINLOOP
				;
				
;**********************************************************************************************	
	ELJARAS_megnyeres_kicsi	; azaz kijárat, EXIT 
				;
				; törlés ******************************************************
				ld	D,42
				ld	HL,VIDRAMSTART
				ld	BC,5120
				add	HL,BC
				;
	megnyeres_kicsi_c0
				ld	A,64
				ld	B,0
	megnyeres_kicsi_c1	
				ld	(HL),B
				inc	HL
				dec	A
				;cp	0
				jp	Z,megnyeres_kicsi_c2
				jp	megnyeres_kicsi_c1
	megnyeres_kicsi_c2	
				ld	BC,64
				add 	HL,BC
				dec	D
				jp	Z,megnyeres_kicsi_c3
				jp	megnyeres_kicsi_c0
	megnyeres_kicsi_c3	; **************************************************************
				;
				; tárgyakért plusz pont
				ld	A,100
				ld	(SPRX),A	
				ld	A,84
				ld	(SPRY),A	
				call	CALCSPRVRAMADDR	; SprX és SprY alapján videoram cím kiszámolása. 
				; 1-es tárgy
				ld 	A,(targy_1)  ; kepe
				call 	ELJARAS_TARGYLISTA_3_szamolrajzol	
				ld	A,(targy_1)
				cp	0
				jp	Z,megnyeres_kicsi_nulla1
				;
				ld	HL,$100A         ; X,Y karakter pozíció beállítása
				ld	(karakterpoz),HL 
				call	ELJARAS_Pluszpont_kiir_nullaz	
				;
				call hang_effekt_1;
				call ELJARAS_Pluszpont_EGY ; bármi van ott plusz 50 pont
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call hang_effekt_0;
				ld	A,(targy_1)
				cp	23
				jp	NZ,megnyeres_kicsi_nulla1
				call hang_effekt_1;
				call ELJARAS_Pluszpont_EGY ; kincs esetén 100 pont
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call hang_effekt_0;
				;
	megnyeres_kicsi_nulla1
				;
				halt
				ld	HL,(SPRVRAMADDR)	; [20] a sprite aktuális pozíciójának videoram címe
				ld	BC,1280
				add	HL,BC
				ld	(SPRVRAMADDR),HL
				; 2-es tárgy
				ld 	A,(targy_2)  ; kepe
				call 	ELJARAS_TARGYLISTA_3_szamolrajzol	
				ld	A,(targy_2)
				cp	0
				jp	Z,megnyeres_kicsi_nulla2
				;
				ld	HL,$100C         ; X,Y karakter pozíció beállítása
				ld	(karakterpoz),HL 
				call	ELJARAS_Pluszpont_kiir_nullaz
				;
				call hang_effekt_1;
				call ELJARAS_Pluszpont_EGY ; bármi van ott plusz 50 pont
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call hang_effekt_0;
				ld	A,(targy_2)
				cp	23
				jp	NZ,megnyeres_kicsi_nulla2
				call hang_effekt_1;
				call ELJARAS_Pluszpont_EGY ; kincs esetén 100 pont
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call hang_effekt_0;
				;
	megnyeres_kicsi_nulla2
				
				halt
				ld	HL,(SPRVRAMADDR)	; [20] a sprite aktuális pozíciójának videoram címe
				ld	BC,1280
				add	HL,BC
				ld	(SPRVRAMADDR),HL

				ld 	A,(targy_3)  ; kepe
				call 	ELJARAS_TARGYLISTA_3_szamolrajzol	
;*				; 3-as tárgy
				ld	A,(targy_3)
				cp	0
				jp	Z,megnyeres_kicsi_nulla3
				;
				ld	HL,$100E         ; X,Y karakter pozíció beállítása
				ld	(karakterpoz),HL 
				call	ELJARAS_Pluszpont_kiir_nullaz
				;
				call hang_effekt_1;
				call ELJARAS_Pluszpont_EGY ; bármi van ott plusz 50 pont
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call hang_effekt_0;
				ld	A,(targy_3)
				cp	23
				jp	NZ,megnyeres_kicsi_nulla3
				call hang_effekt_1;
				call ELJARAS_Pluszpont_EGY ; kincs esetén 100 pont
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call ELJARAS_Pluszpont_EGY
				call hang_effekt_0;
				;
	megnyeres_kicsi_nulla3
				
				halt
				; "space" kiírás
				ld	BC,$0810 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_2	;szöveg címe
				ld	BC,12		;szöveg hossza
				rst	$30		;írás
				db	$2
				; várakozás a SPACE lenyomására
	megnyeres_kicsi_varakozas_space		
				ld	A,(2904); 
				cp	32
				jp	NZ,megnyeres_kicsi_varakozas_space
				; lenyomtuk a SPACE-t, indul a következő pálya
				
				ld	A,(palya)
				ld	B,(palya_max)
				;inc	B
				cp	B
				jp	NZ,megnyeres_kicsi_vege
				; palya=palya_max+1     ---------végig van játszodva
				call	ELJARAS_megnyeres
	megnyeres_kicsi_vege
				call	START_palya1
;**********************************************************************************************	
	ELJARAS_megnyeres	
				
				call CLEARSCREEN
;                               szöveg kiirasa  "game over"
				ld	BC,$0B09 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_5	;szöveg címe
				ld	BC,9		;szöveg hossza
				rst	$30		;írás
				db 	$2
				;
				ld	BC,$040B ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_5B	;szöveg címe
				ld	BC,23	;szöveg hossza
				rst	$30		;írás
				db 	$2
				;
				ld	BC,$040C ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_5C	;szöveg címe
				ld	BC,23	;szöveg hossza
				rst	$30		;írás
				db 	$2
				;
				;
				ld	BC,$040E ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_5D	;szöveg címe
				ld	BC,23	;szöveg hossza
				rst	$30		;írás
				db 	$2
				;
				ld	BC,$040F ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_5E	;szöveg címe
				ld	BC,23	;szöveg hossza
				rst	$30		;írás
				db 	$2
				;
				;  "SCORE:"
				ld	BC,$0911 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_4	;szöveg címe
				ld	BC,6	;szöveg hossza
				rst	$30		;írás
				db 	$2
				;
				;ld	HL,szoveg_score
				;  "SCORE:"
				ld	BC,$0F11 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_score	;szöveg címe
				ld	BC,6	;szöveg hossza
				rst	$30		;írás
				db 	$2
				;
				;
	megnyeres_nagy_varakozas_space		; SPACE lenyomására várunk
				ld	A,(2904); 
				cp	32
				jp	NZ,megnyeres_nagy_varakozas_space
				;				
				; Vissza a főképernyőre
				call	START_Fokepernyo
;**********************************************************************************************	
	ELJARAS_Pluszpont_EGY
				call	ELJARAS_Pluszpont
				call	ELJARAS_Pluszpont_kiir
				call	ELJARAS_Pluszpont_kiirplusz
				halt
				ret
;**********************************************************************************************	
	ELJARAS_Pluszpont_kiir_nullaz	
				ld	HL,szoveg_score_plusz
				ld	A,48 ;"0"
				ld	(HL),A   ;"x00"
				INC	HL
				ld	(HL),A   ;"0x0"
				INC	HL
				ld	(HL),A   ;"00x"
				ret
;**********************************************************************************************	
	ELJARAS_Pluszpont_kiir	
			        ; Hozzá adok pontot	
				ld	HL,szoveg_score_plusz
				INC	HL
	Pluszpont_szam_kiir
				ld	A,(HL)  ;0000X0
				inc	A
				ld	B,58    ;Túlmentünk e a 9-en
				CP	B
				jp	NZ,Pluszpont_kiir_1	
				ld	A,48
				ld	(HL),A
				dec	HL
				jp	Pluszpont_szam_kiir
	Pluszpont_kiir_1		
				ld	(HL),A
				ret
;**********************************************************************************************	
	ELJARAS_Pluszpont_kiirplusz	
				; input:   karakterpoz, szoveg_score_plusz
				ld	BC,(karakterpoz); X,Y karakter pozíció
				rst	$30 ;címszámítás
				db	$3
				ld	DE,szoveg_score_plusz	;szöveg címe
				ld	BC,3		;szöveg hossza
				rst	$30		;írás
				db	$2
				ret
;**********************************************************************************************	
; ide egy eljárás, ami a teljes MAP-ot kirajzolja de "ködölve"
	MAP_KIRAJZOL_TELJES_KÖD	
				;ld	hl,MAP
				ld	HL,2048                 ; Átugorjuk az első két sort
				ld	BC,VIDRAMSTART		; 
				add	HL,BC			; 
				ld	(SPRVRAMADDR),HL	; 
				;ld	(MAPszam),hl
				ld	A,13			; 6-szor fut le a CIKLUS 1
        CIKLUS2_KÖD				
				ld	(SPRY),A		; beállítása
				ld	A,16			; 6-szor fut le a CIKLUS 1
	CIKLUS1_KÖD			
				ld	(SPRX),A


				;ld	hl,(MAPszam)      ; MAPszam = MAP aktuális elemére mutat
				;ld	A,(HL)            ; A = következő elem a MAP-on
				;inc 	hl                ; MAPszam = MAPszam + 1
				;ld	(MAPszam),hl      ; és mentés
				ld 	A,24
				; SPRADDR -a képelem címére mutat, ezt kell beállítani A alapján
				;LD BC,0
				ld	C,A  ;C=A
				ld	B,A  ;B=A
				; BC=BC*64
				sla	C	; C <-6	 eltolás 6 bittel felfelé (*64)	
				sla	C			;
				sla	C			;
				sla	C			;
				sla	C
				sla	C

				sra	B	; B -> 2  eltolás lefelé 2 bittel
				sra	B
			;
				ld	hl,SpriteBaseAddrV
				add 	hl,bc
				ld	(SPRADDR),hl
				

				call	DRAW_fekete

				ld	HL,(SPRVRAMADDR)	; [20] HL = a sprite vram címe a változóból
				ld	bc,4			; hozzá adunk 4 byte-ot (4x4=16 pixel)
				add	hl,bc
				ld	(SPRVRAMADDR),HL
				ld	A,(SPRX)
				dec	A
				jp	NZ,CIKLUS1_KÖD		;Ha A nagyobb mint 0 akkor GOTO CIKLUS 1
				
				ld	HL,(SPRVRAMADDR)	; [20] HL = a sprite vram címe a változóból
				ld	bc,64*15			; 
				add	hl,bc
				ld	(SPRVRAMADDR),HL

				ld	A,(SPRY)
				dec	A
				jp	NZ,CIKLUS2_KÖD		;Ha A nagyobb mint 0 akkor GOTO CIKLUS 1
				ret				
;**********************************************************************************************	
; ide egy eljárás, ami a teljes MAP-ot kirajzolja de "ködölve"
	MAP_KIRAJZOL_TELJES_KÖD_2	
				ld	hl,MAP
				ld	(MAPszam),hl

				ld	HL,0                 ; Átugorjuk az első két sort
				;ld	HL,2048                 ; Átugorjuk az első két sort

				ld	BC,VIDRAMSTART		; 
				add	HL,BC			; 
				ld	(SPRVRAMADDR),HL	; 
				ld	A,15			; 6-szor fut le a CIKLUS 1
        CIKLUS2_KÖD2				
				ld	(SPRY),A		; beállítása
				ld	A,16			; 6-szor fut le a CIKLUS 1
	CIKLUS1_KÖD2			
				ld	(SPRX),A


				ld	hl,(MAPszam)      ; MAPszam = MAP aktuális elemére mutat
				ld	A,(HL)            ; A = következő elem a MAP-on
				inc 	hl                ; MAPszam = MAPszam + 1
				ld	(MAPszam),hl      ; és mentés
				;ld 	A,24
				; SPRADDR -a képelem címére mutat, ezt kell beállítani A alapján
				;LD BC,0
				ld	C,A  ;C=A
				ld	B,A  ;B=A
				; BC=BC*64
				sla	C	; C <-6	 eltolás 6 bittel felfelé (*64)	
				sla	C			;
				sla	C			;
				sla	C			;
				sla	C
				sla	C

				sra	B	; B -> 2  eltolás lefelé 2 bittel
				sra	B
			;
				ld	hl,SpriteBaseAddrV
				add 	hl,bc
				ld	(SPRADDR),hl
				

				call	DRAW_fekete

				ld	HL,(SPRVRAMADDR)	; [20] HL = a sprite vram címe a változóból
				ld	bc,4			; hozzá adunk 4 byte-ot (4x4=16 pixel)
				add	hl,bc
				ld	(SPRVRAMADDR),HL
				ld	A,(SPRX)
				dec	A
				jp	NZ,CIKLUS1_KÖD2		;Ha A nagyobb mint 0 akkor GOTO CIKLUS 1
				
				ld	HL,(SPRVRAMADDR)	; [20] HL = a sprite vram címe a változóból
				ld	bc,64*15			; 
				add	hl,bc
				ld	(SPRVRAMADDR),HL

				ld	A,(SPRY)
				dec	A
				jp	NZ,CIKLUS2_KÖD2		;Ha A nagyobb mint 0 akkor GOTO CIKLUS 1
				ret				
;*******************************************************************************************
;                      ide egy eljárás, ami a teljes MAP-ot kirajzolja
;                      16x15 elem kirajzolása a MAP alapján
	MAP_KIRAJZOL_TELJES
				ld	hl,MAP
				ld	(MAPszam),hl
				ld	A,15			; 6-szor fut le a CIKLUS 1
        CIKLUS2				
				ld	(SPRY),A		; beállítása
				ld	A,16			; 6-szor fut le a CIKLUS 1
	CIKLUS1			
				ld	(SPRX),A


				ld	hl,(MAPszam)      ; MAPszam = MAP aktuális elemére mutat
				ld	A,(HL)            ; A = következő elem a MAP-on
				inc 	hl                ; MAPszam = MAPszam + 1
				ld	(MAPszam),hl      ; és mentés
				; SPRADDR -a képelem címére mutat, ezt kell beállítani A alapján
				;LD BC,0
				ld	C,A  ;C=A
				ld	B,A  ;B=A
				; BC=BC*64
				sla	C	; C <-6	 eltolás 6 bittel felfelé (*64)	
				sla	C			;
				sla	C			;
				sla	C			;
				sla	C
				sla	C

				sra	B	; B -> 2  eltolás lefelé 2 bittel
				sra	B
			;
				ld	hl,SpriteBaseAddrV
				add 	hl,bc
				ld	(SPRADDR),hl
				

				call	DRAW_fekete

				ld	HL,(SPRVRAMADDR)	; [20] HL = a sprite vram címe a változóból
				ld	bc,4			; hozzá adunk 4 byte-ot (4x4=16 pixel)
				add	hl,bc
				ld	(SPRVRAMADDR),HL
				ld	A,(SPRX)
				dec	A
				jp	NZ,CIKLUS1		;Ha A nagyobb mint 0 akkor GOTO CIKLUS 1
				
				ld	HL,(SPRVRAMADDR)	; [20] HL = a sprite vram címe a változóból
				ld	bc,64*15			; 
				add	hl,bc
				ld	(SPRVRAMADDR),HL

				ld	A,(SPRY)
				dec	A
				jp	NZ,CIKLUS2		;Ha A nagyobb mint 0 akkor GOTO CIKLUS 1
				ret				
;*********************************************************************************************************************	
;
;*********************************************************************************************************************	
	MAP_KIRAJZOL_TARGYLISTA_3	
				ld	A,(targyak_rajz)
				ld	B,1
				cp	B
				jp	NZ,MAP_KIRAJZOL_TARGYLISTA_3_vege
				;
				ld	A,100
				ld	(SPRX),A	
				ld	A,12
				ld	(SPRY),A	
				call	CALCSPRVRAMADDR	; SprX és SprY alapján videoram cím kiszámolása. 
				ld	A,(targy_1)		; kepe
				call	ELJARAS_TARGYLISTA_3_szamolrajzol
				;
				ld	HL,(SPRVRAMADDR)	; [20] a sprite aktuális pozíciójának videoram címe
				ld	BC,5
				add	HL,BC
				ld	(SPRVRAMADDR),HL
				ld	A,(targy_2)		; kepe
				call	ELJARAS_TARGYLISTA_3_szamolrajzol
				;
				ld	HL,(SPRVRAMADDR)	; [20] a sprite aktuális pozíciójának videoram címe
				ld	BC,5
				add	HL,BC
				ld	(SPRVRAMADDR),HL
				ld 	A,(targy_3)  ; kepe
				call	ELJARAS_TARGYLISTA_3_szamolrajzol
				;
				ld	A,0 
				ld	(targyak_rajz),A	; targyak_rajz=0 
        MAP_KIRAJZOL_TARGYLISTA_3_vege
				ret
;*********************************************************************************************************************	
	ELJARAS_TARGYLISTA_3_szamolrajzol	
				ld	C,A  ;C=A
				ld	B,A  ;C=A
				sla	C	; C <-6	 eltolás 6 bittel felfelé (*64)	
				sla	C			;
				sla	C			;
				sla	C			;
				sla	C
				sla	C
				sra	B	; B -> 2  eltolás lefelé 2 bittel
				sra	B
				ld	hl,SpriteBaseAddrV
				add 	hl,bc
				ld	(SPRADDR),hl
				call	DRAW_fekete
				ret
;*********************************************************************************************************************	
; ide egy eljárás, ami a teljes MAP-on ármegy és kirajzolja az animált elemeket
	MAP_KIRAJZOL_TELJES_CSAK_ANIMACIO
;*********************************************************************************************************************	
; ide az eljárás ami 3x3 szomszédos MAP elemet kirajzol
	MAP_KIRAJZOL_3x3					;(foszerMY),(foszerMX)	
				
			        ; beállítani az X,Y értékeit
				ld	A,(foszerMY) ; beállítani az X,Y értékeit
				dec	A
				ld	(fmy),A      ; Y=Y-1
				ld	A,(foszerMX)
				dec	A
				ld	(fmx),A	     ; X=X-1
				call	MAP_koordinata_ellenorzes; ellenorzes
				ld	A,(ok)
				ld	B,1
				cp	B
				jp	NZ,nem_rajzolunk_1
				call MAP_KIRAJZOL_EGY; rajzolunk
		nem_rajzolunk_1
				ld	A,(foszerMY) ; beállítani az X,Y értékeit
				dec	A
				ld	(fmy),A      ; Y=Y-1
				ld	A,(foszerMX)
				;dec	A
				ld	(fmx),A	     ; X=X
				call	MAP_koordinata_ellenorzes; ellenorzes
				ld	A,(ok)
				ld	B,1
				cp	B
				jp	NZ,nem_rajzolunk_2
				call MAP_KIRAJZOL_EGY; rajzolunk
		nem_rajzolunk_2
				ld	A,(foszerMY) ; beállítani az X,Y értékeit
				dec	A
				ld	(fmy),A      ; Y=Y-1
				ld	A,(foszerMX)
				inc	A
				ld	(fmx),A	     ; X=X+1
				call	MAP_koordinata_ellenorzes; ellenorzes
				ld	A,(ok)
				ld	B,1
				cp	B
				jp	NZ,nem_rajzolunk_3
				call MAP_KIRAJZOL_EGY; rajzolunk
		nem_rajzolunk_3
				ld	A,(foszerMY) ; beállítani az X,Y értékeit
				ld	(fmy),A      ; Y=Y
				ld	A,(foszerMX)
				dec	A
				ld	(fmx),A	     ; X=X-1
				call	MAP_koordinata_ellenorzes; ellenorzes
				ld	A,(ok)
				ld	B,1
				cp	B
				jp	NZ,nem_rajzolunk_4
				call MAP_KIRAJZOL_EGY; rajzolunk
		nem_rajzolunk_4
				ld	A,(foszerMY) ; beállítani az X,Y értékeit
				ld	(fmy),A      ; Y=Y
				ld	A,(foszerMX)
				inc	A
				ld	(fmx),A	     ; X=X+1
				call	MAP_koordinata_ellenorzes; ellenorzes
				ld	A,(ok)
				ld	B,1
				cp	B
				jp	NZ,nem_rajzolunk_5
				call MAP_KIRAJZOL_EGY; rajzolunk
		nem_rajzolunk_5
				ld	A,(foszerMY) ; beállítani az X,Y értékeit
				inc	A
				ld	(fmy),A      ; Y=Y+1
				ld	A,(foszerMX)
				dec	A
				ld	(fmx),A	     ; X=X-1
				call	MAP_koordinata_ellenorzes; ellenorzes
				ld	A,(ok)
				ld	B,1
				cp	B
				jp	NZ,nem_rajzolunk_6
				call MAP_KIRAJZOL_EGY; rajzolunk
		nem_rajzolunk_6
				ld	A,(foszerMY) ; beállítani az X,Y értékeit
				inc	A
				ld	(fmy),A      ; Y=Y+1
				ld	A,(foszerMX)
				;dec	A
				ld	(fmx),A	     ; X=X
				call	MAP_koordinata_ellenorzes; ellenorzes
				ld	A,(ok)
				ld	B,1
				cp	B
				jp	NZ,nem_rajzolunk_7
				call MAP_KIRAJZOL_EGY; rajzolunk
		nem_rajzolunk_7
				ld	A,(foszerMY) ; beállítani az X,Y értékeit
				inc	A
				ld	(fmy),A      ; Y=Y+1
				ld	A,(foszerMX)
				inc	A
				ld	(fmx),A	     ; X=X+1
				call	MAP_koordinata_ellenorzes; ellenorzes
				ld	A,(ok)
				ld	B,1
				cp	B
				jp	NZ,nem_rajzolunk_8
				call MAP_KIRAJZOL_EGY; rajzolunk
		nem_rajzolunk_8
				
				ret
;*********************************************************************************************************************	
	MAP_koordinata_ellenorzes
				; INPUT:  fmy (2..14), fmx (0..15)
				; OUTPUT: ok	
				ld	A,0
				ld	(ok),A
				;
				ld	A,(fmx)
				ld	B,240
				and	B
				inc	A
				dec	A
				jp	Z,koordinata_ellenorzes_1
				ret
	koordinata_ellenorzes_1	
				ld	A,(fmy)
				ld	B,240
				and	B
				inc	A
				dec	A
				jp	Z,koordinata_ellenorzes_2
				ret
	koordinata_ellenorzes_2	
				ld	A,(fmy)
				ld	B,1
				cp	B
				jp	NZ,koordinata_ellenorzes_3
				ret
	koordinata_ellenorzes_3
				;
				ld	A,1
				ld	(ok),A
				ret
;*********************************************************************************************************************	
; ide kéne egy eljárás, ami 1 MAP elemet kirajzol a helyére
	MAP_KIRAJZOL_EGY
				ld	hl,MAP  
				ld	B,0  ; BC= fmy*16+fmx
				ld	A,(fmy)
				sla	A  ; A=A*16
				sla	A
				sla	A
				sla	A
				ld	C,A
				ld	A,(fmx)
				add	A,C
				ld 	C,A
				add	HL,BC
				ld	A,(HL)	; betöltjük az elemet
				
				ld	C,A  ;C=A   ; BC=BC*64
				ld	B,A  ;B=A
				sla	C	; C <-6	 eltolás 6 bittel felfelé (*64)	
				sla	C			;
				sla	C			;
				sla	C			;
				sla	C
				sla	C
				sra	B	; B -> 2  eltolás lefelé 2 bittel
				sra	B
				ld	hl,SpriteBaseAddrV
				add 	hl,bc
				ld	(SPRADDR),hl
				
				ld	A,(fmy)		; [13] 
				ld	L,A			; [ 4] 
				ld	H,0			; [ 4] 
				add	HL,HL			; [11] 
				add	HL,HL			; [11] 
				add	HL,HL			; [11] 
				add	HL,HL			; [11] HL = fmy*16

				add	HL,HL			; [11] HL = SprY * 2
				add	HL,HL			; [11] HL = SprY * 4
				add	HL,HL			; [11] HL = SprY * 8
				add	HL,HL			; [11] HL = SprY * 16
				add	HL,HL			; [11] HL = SprY * 32
				add	HL,HL			; [11] HL = SprY * 64 (64 byte egy sor, így ennyivel kell megszorozni az SprY-t)                                                        
				ld	A,(fmx)		; [13] A = SprX
				sla	A
				sla	A
;				srl	A			; [ 8] A = SprX div 2 (Shift Right Logical - jobbra tolja 1-el a biteket, balról 0 lép be a felső bitbe)
;				srl	A			; [ 8] A = SprX div 4 -> 1 byte 4 pixel, így az X pozíció byte-okban = SprX div 4
				ld	C,A			; [ 4] C = SprX div 4
				ld	B,0			; [ 4] B = 0 -> BC = SprX div 4
				add	HL,BC			; [11] HL = (SprY * 64) + (SprX div 4)                              
				ld	BC,VIDRAMSTART		; [10] 
				add	HL,BC			; [11] HL = VidRamStart + (SprY * 64) + (SprX div 4) <- ez a Sprite videoram kezdőcíme SprX, SprY alapján
				ld	(SPRVRAMADDR),HL	; [16] SprVRAMAddr = HL (letároljuk SprVRamAddr változóba későbbi felhasználásra)
				

				;ld	hl,SpriteBaseAddrV
				;add 	hl,bc
				;ld	(SPRADDR),hl
				call	DRAW_fekete
				
				ret
;*********************************************************************************************************************	
                 ; sound play 
    SOUND_PLAY 
				ld	A,(sound_TIME)
				cp	0
				jp	Z,Sound_TIME_nulla	; ha nulla akkor átugorjuk
				halt
				ld	A,(sound_TIME)
				dec	A  ; kivonunk 1-et
				ld	(sound_TIME),A ; mentjük				
				cp	0
				jp	NZ,Sound_TIME_nulla
				; most lett nulla?
				ld	HL,4095
				call	SET_SOUND_PITCH
				call	PALETTA_4C
	Sound_TIME_nulla	
				ret
;*********************************************************************************************************************	
