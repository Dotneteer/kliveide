				call	DRAW_fekete
				HALT
				ld	HL,(SPRVRAMADDR)	; [20] a sprite aktuális pozíciójának videoram címe
				dec 	HL
				ld	(SPRVRAMADDR),HL
				call	DRAW_fekete
