;*********************************************************************************************************
	hang_effekt_0		; kikapcs
				ld	HL,4095
				call	SET_SOUND_PITCH
				ld	A,0
				ld	(sound_TIME),A ; mentjük				
				call	PALETTA_4C
				ret
;*********************************************************************************************************
	hang_effekt_1		; valami felvétele
				ld	HL,7600
				call	SET_SOUND_PITCH
				ld	A,5
				ld	(sound_TIME),A ; mentjük				
				;call	PALETTA_4B
				ret
;*********************************************************************************************************
	hang_effekt_2		; valami kinyitása, megoldása
				ld	HL,7200
				call	SET_SOUND_PITCH
				ld	A,5
				ld	(sound_TIME),A ; mentjük				
				;call	PALETTA_4B
				ret
;*********************************************************************************************************
	hang_effekt_1B		; kincs?
				ld	HL,7800
				call	SET_SOUND_PITCH
				ld	A,5
				ld	(sound_TIME),A ; mentjük				
				call	PALETTA_4B
				ret
;*********************************************************************************************************
	ELTOLHATO_KO		;20-as elemnek mennénk neki
				; mozgas_irany=irany, HL=map új eleme,
				ld	A,(mozgas_irany)
				cp	1
				jp	z,ELTOLHATO_KO_fel
				cp	2
				jp	z,ELTOLHATO_KO_le
				cp	3
				jp	z,ELTOLHATO_KO_jobbra
				cp	4
				jp	z,ELTOLHATO_KO_balra
				ret
	ELTOLHATO_KO_fel	;
				ld	BC,65520
				add	HL,BC	
				ld	A,(HL)
				cp	0	
				jp	NZ,ELTOLHATO_KO_fel_vege
				ld	A,20 ;debug
				ld	(HL),A ;debug
				ld	BC,16 ;debug
				add	HL,BC ;debug
				ld	A,0 ;debug
				ld	(HL),A ;debug
				ld	A,1      
				ld	(Mehet_e),A
	ELTOLHATO_KO_fel_vege
				ret
	ELTOLHATO_KO_le						;
				ld	BC,16
				add	HL,BC	
				ld	A,(HL)
				cp	0	
				jp	NZ,ELTOLHATO_KO_le_vege
				ld	A,20 ;debug
				ld	(HL),A ;debug
				ld	BC,65520 ;debug
				add	HL,BC ;debug
				ld	A,0 ;debug
				ld	(HL),A ;debug

				ld	A,1      
				ld	(Mehet_e),A

	ELTOLHATO_KO_le_vege
				ret
	ELTOLHATO_KO_jobbra	;
				;
				inc	HL
				ld	A,(HL)			; Ez az elem van az eltolható kő mögött
				cp	0			; nulla e
				jp	NZ,ELTOLHATO_KO_jobbra_vege
				ld	A,20 ;debug
				ld	(HL),A			;debug
				dec	HL
				ld	A,0 ;debug
				ld	(HL),A ;debug
				ld	A,1      
				ld	(Mehet_e),A
	ELTOLHATO_KO_jobbra_vege
				ret
	ELTOLHATO_KO_balra	;
				;
				dec	HL
				ld	A,(HL)			; Ez az elem van az eltolható kő mögött
				cp	0			; nulla e
				jp	NZ,ELTOLHATO_KO_balra_vege
				ld	A,20 ;debug
				ld	(HL),A			;debug
				inc	HL
				ld	A,0 ;debug
				ld	(HL),A ;debug
				
				ld	A,1      
				ld	(Mehet_e),A
	ELTOLHATO_KO_balra_vege
				ret
				;
				ret				

;*********************************************************************************************************
;                              Egyel növeljük a pályák számát
;*********************************************************************************************************
	ELJARAS_Pluszpalya	
				ld	HL,szoveg_level
				INC	HL
	Pluszlevel_szam
				ld	A,(HL)  ;0X
				inc	A
				ld	B,58    ;Túlmentünk e a 9-en
				CP	B
				jp	NZ,Pluszlevel_1	
				ld	A,48
				ld	(HL),A
				dec	HL
				jp	Pluszlevel_szam
	Pluszlevel_1		
				ld	(HL),A

				ld	A,(palya)
				INC	A 
				ld	(palya),A  ; palya=palya+1
				;
				ret
;*********************************************************************************************************
;                              10 pontot kap a játékos
;*********************************************************************************************************
	ELJARAS_Pluszpont	
			        ; Hozzá adok pontot	
				ld	HL,szoveg_score
				INC	HL
				INC	HL
				INC	HL
				inc	HL
	Pluszpont_szam
				ld	A,(HL)  ;0000X0
				inc	A
				ld	B,58    ;Túlmentünk e a 9-en
				CP	B
				jp	NZ,Pluszpont_1	
				ld	A,48
				ld	(HL),A
				dec	HL
				jp	Pluszpont_szam
	Pluszpont_1		
				ld	(HL),A
				;jp	Pluszpont_print

	Pluszpont_print			        
;                               ;       PRINT "000120"  ; kiírom az új pontszámot
				ld	BC,$0C01 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_score	;szöveg címe
				ld	BC,6		;szöveg hossza
				rst	$30		;írás
				db	$2
				ret
			
;*********************************************************************************************************
				;
				
      ELJARAS_RAJZFOSZER 				
				call 	ELJARAS_RAJZFOSZER_ALAP
				call	DRAW_fekete  ;főszereplő kirajzolása foszerMX, foszerMY karakterhelyre
				RET
				;

      ELJARAS_RAJZFOSZER_ALAP	
				ld	A,(foszerMX)		; SpriteX pozíció                           
				sla	A
				sla	A
				sla	A
				sla	A
				ld	(SPRX),A		; beállítása
				ld	A,(foszerMY)			; SpriteY pozíció
				sla	A
				sla	A
				sla	A
				sla	A
				ld	(SPRY),A		; beállítása
				call	CALCSPRVRAMADDR	; SprX és SprY alapján videoram cím kiszámolása. 
				;
				ld 	A,(foszer_kep)  ; kepe
				ld	C,A  ;C=A
				ld	B,A  ;C=A
				; BC=BC*64
				sla	C	; C <-6	 eltolás 6 bittel felfelé (*64)	
				sla	C			;
				sla	C			;
				sla	C			;
				sla	C
				sla	C

				sra	B	; B -> 2  eltolás lefelé 2 bittel
				sra	B
			;
				ld	hl,SpriteBaseAddrV
				add 	hl,bc
				ld	(SPRADDR),hl
				ret

      ELJARAS_RAJZFOSZER_SCOLL_FEL 				
				call 	ELJARAS_RAJZFOSZER_ALAP
				call	DRAW_fekete
				HALT
				ld	HL,(SPRVRAMADDR)	; [20] a sprite aktuális pozíciójának videoram címe
				DEC 	H
				ld	(SPRVRAMADDR),HL
				call	DRAW_fekete
				call	DRAW_fekete_TOROL2
				HALT
				ld	HL,(SPRVRAMADDR)	; [20] a sprite aktuális pozíciójának videoram címe
				DEC 	H				
				ld	(SPRVRAMADDR),HL
				call	DRAW_fekete
				call	DRAW_fekete_TOROL2
				HALT
				ld	HL,(SPRVRAMADDR)	; [20] a sprite aktuális pozíciójának videoram címe
				DEC 	H				
				ld	(SPRVRAMADDR),HL
				call	DRAW_fekete
				call	DRAW_fekete_TOROL2
				HALT
				ld	HL,(SPRVRAMADDR)	; [20] a sprite aktuális pozíciójának videoram címe
				DEC 	H				
				ld	(SPRVRAMADDR),HL
				call	DRAW_fekete
				call	DRAW_fekete_TOROL2
				JP	SCROLL_VEGE
      ELJARAS_RAJZFOSZER_SCOLL_LE 				
				call 	ELJARAS_RAJZFOSZER_ALAP
				call	DRAW_fekete
				;call	DRAW_fekete_TOROL1
				HALT
				ld	HL,(SPRVRAMADDR)	; [20] a sprite aktuális pozíciójának videoram címe
				ld	BC,256
				add	HL,BC
				ld	(SPRVRAMADDR),HL
				call	DRAW_fekete
