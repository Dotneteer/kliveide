				org	6639			; A program kezdőcíme
                         ;{BASIC Header
				db	$0F,$0A,$0,$DD		; "10 PRINT" - basic tokens
				db	' USR'			; " USR"
				db	$96			; "("
				db	'6655'			; "6655"
				db	$95,$FF			; ")" 
				db	$0
                         ;}
;      4444444444444444444444444444444444444444444444444444444444444444444				
;         
;                 4 szinü üzemmód
;
;      4444444444444444444444444444444444444444444444444444444444444444444
;
				
				jp	START			; <- ez lesz a 7000-es ($1B58) cím, amit meghív a BASIC
				
				
                         ;{változók, konstansok
	VIDEOMODE		equ	$0B13			; 6-os port tükre a memóriában (video mode)
	SAVEDVIDEOMODE		db	0			; ide mentjük el az induláskori video módot
	BORDER			equ	$0B4F			; BORDER rendszerváltozó
	JOYSTATE		equ	2905			; billentyűzet mátrix joystick byte
	VIDRAMSTART		equ	$8000			; videoram kezdőcíme, ha a 2. lapra van belapozva (32768 -> $8000)                 
				
	SPRX			db	0			; Sprite X pozíció pixelben 0..256                             
	SPRY			db	0			; Sprite Y pozíció pixelben 0..240

	foszerMX		db	0
	foszerMY		db	0
	MAPszam			dw	0
	foszerMX2		db	0
	foszerMY2		db	0
	foszer_kep		db	0
	Mehet_e			db	0 ; mozgásnál mehet e az adott irányba
	randomszam		db	0
	targyak_rajz		db	0 ; targyak_rajz=1 akkor újra kell rajzolni a tárgylistát
	fmx		db	0
	fmy		db	0
	ok		db	0
				
				
	sound_PITCH		db	0
	sound_TIME		db	0
	
	targy_1			db	0
	targy_2			db	0
	targy_3			db	0
	palya			db	0
	palya_max		equ	33 ; legmagasabb pálya sorszáma +1
	mozgas_irany		db	0
				
	szoveg_1		db	'SOTET KASTELY 2 '
	szoveg_1A		db	'   (2022)   '
	szoveg_2		db	'   SPACE... '
	szoveg_6		db	' OROSZ OLIVER  '
	szoveg_7		db	'  JATEK KOZBEN: R-RESET Q-EXIT  '
	szoveg_3		db	'LEVEL: '
	szoveg_level		db	'01'
	szoveg_4		db	'SCORE: '
	szoveg_5		db	'GAME OVER'
	szoveg_5B		db	'VEGIG JATSZOTTAD MIND A'
	szoveg_5C		db	'32 PALYAT, GRATULALOK! '
	szoveg_5D		db	'    KISZABADULTAL A    '
	szoveg_5E		db	'   SOTET KASTELYBOL.   '
	szoveg_score		db	'000000'
	szoveg_scoreB		db	'000000'  ; pálya elején elmentjük, reset-nél visszatöltjük
	szoveg_score_plusz	db	'000'			;pálya végén pontot kapunk a kivitt tárgyakért
	karakterpoz		dw	0

	SPRADDR			dw	0
	SPRMASKADDR		dw	0
	SPRW			db	0
	SPRH			db	0
	SPRVRAMADDR		dw	0			; Sprite aktuális videoram kezdőcím $8000 - $C000               
	NEWLINEBYTES		dw	0			; 64 - sprite.Width bytes -> ennyit kell a képernyőcímhez adni, hogy a sprite következő sorának elejére mutasson
	SAVESP			dw	0			; SP regiszter elmentésére
	EMPTY			ds	100,$0			; 100 db nulla 
				nop
                         ;}
				
                         ;{Init
	START			nop
				
				ld	hl,SpriteBaseAddrV	; A sprite atlasz fizikai kezdőcíme
				ld	(SPRADDR),hl
				;call 	InitVideo2  ; 2 színű mód		
				call 	InitVideo4  ; 4 színű mód		
				;call 	InitVideo16 ; 16 színű mód		
				call	VIDON			; videoram belapozás a 2. lapra
				;call 	SOUND_ON

				; 4 szín beállítása
				call	PALETTA_4
				call	SOUND_ON
;****************************************************************************************************************
;                               NYITÓKÉP				
;****************************************************************************************************************
		START_Fokepernyo
				ld	A,3
				ld	(2893),A  ; Tinta szín=3
				ld	A,0
				ld	(2894),A  ; Karakter háttérszín=0
				;törlés
				;call	CLEARSCREEN
				;
				; itt kéne a 0-ás pályát kirajzolni.
				ld	A,0  ; palya a MAP_masolas_fejes-hez kell
				call	MAP_masolas_fejes
				call	MAP_randomko
				call	MAP_randomko_randomminta
				;
				call	MAP_KIRAJZOL_TELJES_KÖD_2
				;
;                               szöveg kiirasa  "SOTET KASTELY 2"
				ld	BC,$0808 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_1	;szöveg címe
				ld	BC,15		;szöveg hossza
				rst	$30		;írás
				db 	$2
;                               szöveg kiirasa  " 2022 "
				ld	BC,$0A09 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_1A	;szöveg címe
				ld	BC,10		;szöveg hossza
				rst	$30		;írás
				db 	$2
;                               szöveg kiirasa  "  SPACE... "
				ld	BC,$0A10 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_2	;szöveg címe
				ld	BC,10		;szöveg hossza
				rst	$30		;írás
				db 	$2
;                               szöveg kiirasa  "  OROSZ OLIVER "
				ld	BC,$1317 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_6	;szöveg címe
				ld	BC,13		;szöveg hossza
				rst	$30		;írás
				db 	$2
;                               szöveg kiirasa  "  "
				ld	BC,$0218 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_7	;szöveg címe
				ld	BC,31		;szöveg hossza
				rst	$30		;írás
				db 	$2
;			Főképernyő
;			SPACE...
	varakozas_space
				ld	A,(2904); 
				cp	32
				jp	NZ,varakozas_space
;			MAP másolása  az első pályát bemásoljuk a MAP tömbbe
;*******************************************************************************************
				; Teljesen új játék készítése
;*******************************************************************************************
				ld A,0				
				ld (sound_TIME),A				
				;  PONT=000000
				ld	HL,szoveg_score
				ld	A,48 ;"0"
				ld	(HL),A   ;"x00000"
				INC	HL
				ld	(HL),A   ;"0x0000"
				INC	HL
				ld	(HL),A   ;"00x000"
				INC	HL
				ld	(HL),A   ;"000x00"
				INC	HL
				ld	(HL),A   ;"0000x0"
				INC	HL
				ld	(HL),A	 ;"00000x"
				;  palya=01
				ld	HL,szoveg_level
				ld	A,48  ;"0"
				ld	(HL),A   ;"x0"
				inc	HL
				ld	A,49  ;"1"
				ld	(HL),A	 ;"0x"
				;
				ld	A,1 ;******************************************** 
				ld	(palya),A		; palya=1 
				;
	START_palya1		
				ld	HL,VIDRAMSTART
				ld	(SPRVRAMADDR),HL

				ld	A,(palya)  ; palya a MAP_masolas_fejes-hez kell
				call	MAP_masolas_fejes
				call	MAP_randomko
				call	MAP_randomko_randomminta
				ld	A,0
				ld	(targy_1),A ; targy_1=0
				ld	(targy_2),A ; targy_2=0
				ld	(targy_3),A ; targy_3=0
				ld	A,1 
				ld	(targyak_rajz),A	; targyak_rajz=1 
				;
				; szoveg_scoreB=szoveg_score
				ld	HL,szoveg_score
				ld	DE,szoveg_scoreB
				ld	BC,5
				ldiR
;****************************************************************************************************************
;****************************************************************************************************************
;*******************************  végigmegyünk a 16x15-ös MAP-on és meghatározott elemet keresünk ***************				
;*******************************  most éppen a START helyet ahol a játékos kezd        **************************
				ld	hl,MAP
				ld	(MAPszam),hl
				ld	A,15			; 6-szor fut le a CIKLUS 1
        KERES_CIKLUS2				
				ld	(SPRY),A		; beállítása
				ld	A,16			; 6-szor fut le a CIKLUS 1
	KERES_CIKLUS1			
				ld	(SPRX),A
				ld	hl,(MAPszam)      ; MAPszam = MAP aktuális elemére mutat
				ld	A,(HL)            ; A = következő elem a MAP-on
				inc 	hl                ; MAPszam = MAPszam + 1
				ld	(MAPszam),hl		; és mentés
				;
				ld	B,10
				cp	B
				jp	NZ,KERES_NEM_10
				;  A=10 -----------------------START hely
				ld	A,(SPRX)
				dec	A
				ld	B,A
				ld	A,15
				SUB	B
				ld	(foszerMX),A
				ld	A,(SPRY)
				ld	B,A
				ld	A,15
				SUB	B
				ld	(foszerMY),A
				ld	hl,(MAPszam)		;
				dec	hl
				ld	A,0
				ld	(HL),A
				jp	KERES_VEGE  ; 10 volt :-)
	KERES_NEM_10		
				; Más elemet is kereshetünk
				;
				;
	KERES_VEGE		
				; Több elemet nem keresünk 
				ld	A,(SPRX)
				dec	A
				jp	NZ,KERES_CIKLUS1		;Ha A nagyobb mint 0 akkor GOTO CIKLUS 1
				
				ld	A,(SPRY)
				dec	A
				jp	NZ,KERES_CIKLUS2		;Ha A nagyobb mint 0 akkor GOTO CIKLUS 1

;****************************************************************************************************************
				; teljes térkép kirajzolása
;				call	MAP_KIRAJZOL_TELJES
				call	MAP_KIRAJZOL_TELJES_KÖD
				call	MAP_KIRAJZOL_3x3
;****************************************************************************************************************
;                               ;       PRINT "LEVEL"
				;
				ld	BC,$1401 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_3	;szöveg címe
				ld	BC,7		;szöveg hossza
				rst	$30		;írás
				db 	$2
;                               ;       PRINT "01"
				ld	BC,$1B01 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_level	;szöveg címe
				ld	BC,2		;szöveg hossza
				rst	$30		;írás
				db	$2
;                               ;       PRINT "score"
				ld	BC,$0501 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_4	;szöveg címe
				ld	BC,7		;szöveg hossza
				rst	$30		;írás
				db 	$2
;                               ;       PRINT "000120"
				ld	BC,$0C01 ; X,Y karakter pozíció
				rst	$30	 ;címszámítás
				db	$3
				ld	DE,szoveg_score	;szöveg címe
				ld	BC,6		;szöveg hossza
				rst	$30		;írás
				db 	$2
;****************************************************************************************************************
				;
;****************************************************************************************************************
;
				ld	A,(foszerMX)		; SpriteX pozíció                           
				ld	(foszerMX2),A
				ld	A,(foszerMY)		; SpriteY pozíció                           
				ld	(foszerMY2),A
				
	MAINLOOP_3			
				HALT
				HALT
				ld	A,0
				ld	(foszer_kep),A
				call ELJARAS_RAJZFOSZER
				ld	A,10
				ld	(foszer_kep),A
				ld	A,(foszerMX2)		; SpriteX pozíció                           
				ld	(foszerMX),A
				ld	A,(foszerMY2)		; SpriteY pozíció                           
				ld	(foszerMY),A
				call ELJARAS_RAJZFOSZER

				;
;**************************************************************************************************************
;**************************************************************************************************************
	; Főciklus, joystick lenyomására várunk
	MAINLOOP		;
	;{MAINLOOP
				call SOUND_PLAY

				; tárgylista 
				call MAP_KIRAJZOL_TARGYLISTA_3	
				;
				ld	A,(JOYSTATE); joystick állapot byte kiolvasása a billentyűzet mátrixból
				cp	2
				jp	Z,MOZGAS_fel
				cp	4
				jp	Z,MOZGAS_le
				cp	32
				jp	Z,MOZGAS_jobbra
				cp	64
				jp	Z,MOZGAS_balra
				;
				; Billentyű lenyomás....
				ld	A,(2899);
				cp	128
				jp	Z,Billentyu_R
				cp	64
				jp	Z,Billentyu_Q
				;ld	A,(2902);
				;cp	4  ; debug
				;jp	Z,Billentyu_L  ; debug
				;
				;HALT
				;
				;
				;
				jp	MAINLOOP
				;				
	;}
;**************************************************************************************************************
	Billentyu_R		; Pálya újraindítása
				ld	HL,szoveg_scoreB ; szoveg_score=szoveg_scoreB
				ld	DE,szoveg_score  ; Ne lehessen végtelen pontot gyűjteni
				ld	BC,5
				ldiR
				call	START_palya1
;**************************************************************************************************************
	Billentyu_Q		; Teljes játék újraindítása  -vissza a főképernyőre
				call	START_Fokepernyo
;**************************************************************************************************************
	Billentyu_L		; pályaugrás debug céllal
				call ELJARAS_Pluszpalya
				call ELJARAS_megnyeres_kicsi		
;**************************************************************************************************************
;**************************************************************************************************************
				
	MOZGAS_fel		; felfelé nyomjuk a joy-t
				nop
				ld	A,1
				ld	(mozgas_irany),A
				;
				ld	A,(foszerMX)		; SpriteX pozíció                           
				ld	(foszerMX2),A
				ld	A,(foszerMY)		; SpriteY pozíció                           
				dec 	A
				ld	(foszerMY2),A
				call	ELLENORZES1
				ld	A,(Mehet_e)
				ld	B,0
				cp	B
				jp 	NZ, ELJARAS_RAJZFOSZER_SCOLL_FEL
				jp MAINLOOP
	MOZGAS_le  		; lefelé nyomjuk a joy-t
				nop
				ld	A,2
				ld	(mozgas_irany),A
				;
				ld	A,(foszerMX)		; SpriteX pozíció                           
				ld	(foszerMX2),A
				ld	A,(foszerMY)		; SpriteY pozíció                           
				inc 	A
				ld	(foszerMY2),A
				CALL ELLENORZES1
				ld	A,(Mehet_e)
				ld	B,0
				cp	B
				jp 	NZ, ELJARAS_RAJZFOSZER_SCOLL_LE
				jp MAINLOOP
	MOZGAS_jobbra		; jobbra
				nop
				ld	A,3
				ld	(mozgas_irany),A
				;
				ld	A,(foszerMX)		; SpriteX pozíció                           
				inc 	A
				ld	(foszerMX2),A
				ld	A,(foszerMY)		; SpriteY pozíció                           
				ld	(foszerMY2),A
				CALL ELLENORZES1
				ld	A,(Mehet_e)
				ld	B,0
				cp	B
				jp 	NZ, ELJARAS_RAJZFOSZER_SCOLL_JOBBRA
				jp MAINLOOP
	MOZGAS_balra 		; balra
				nop
				ld	A,4
				ld	(mozgas_irany),A
				;
				ld	A,(foszerMX)		; SpriteX pozíció                           
				dec 	A
				ld	(foszerMX2),A
				ld	A,(foszerMY)		; SpriteY pozíció                           
				ld	(foszerMY2),A
				CALL ELLENORZES1
				ld	A,(Mehet_e)
				ld	B,0
				cp	B
				jp 	NZ, ELJARAS_RAJZFOSZER_SCOLL_BALRA
				jp MAINLOOP
				
;**************************************************************************************************************
;**************************************************************************************************************
				
	ELLENORZES1		; Ellenőrizzük, hogy az új helyre léphetünk vagy sem (foszerMX2,foszerMY2)
				nop
				ld	A,0      ; nem mehet
				ld	(Mehet_e),A
				;  koordináta vizsgálat jönne
				ld	A,(foszerMX2)
				ld	B,A
				ld	A,16
				cp	B
				jp 	Z, ELLENORZES_VEGE
				ld	A,255
				cp	B
				jp 	Z, ELLENORZES_VEGE

				ld	A,(foszerMY2)
				ld	B,A
				ld	A,15
				cp	B
				jp 	Z, ELLENORZES_VEGE
				ld	A,255
				cp	B
				jp 	Z, ELLENORZES_VEGE

				;  elem vizsgálat következik. HL-be rakjuk a MAP első elemének címét
				ld	hl,MAP
				; BC= foszerMY2*16+foszerMX2
				ld	B,0
				ld	A,(foszerMY2)
				sla	A  ; A=A*16
				sla	A
				sla	A
				sla	A
				ld	C,A
				ld	A,(foszerMX2)
				add	A,C
				ld 	C,A
				; HL=HL+BC        HL=MAP+foszerMY2*16+foszerMX2  tehát az elem címe
				add	HL,BC
				; A=map[foszerMX2,foszerMY2]
				ld	A,(HL)
				;
				;
				;ld	B,1  ; IF A=1 THEN... FAL
				cp	1
				jp	NZ,ELLENORZES_NEM_101
				ret	; fal, nem mehet arra, ellenőrzés vége
	ELLENORZES_NEM_101
				;ld	B,2  ; IF A=1 THEN... FAL
				cp	2
				jp	NZ,ELLENORZES_NEM_102
				ret	; fal, nem mehet arra, ellenőrzés vége
	ELLENORZES_NEM_102
				;ld	B,3  ; IF A=1 THEN... FAL
				cp	3
				jp	NZ,ELLENORZES_NEM_103
				ret	; fal, nem mehet arra, ellenőrzés vége
	ELLENORZES_NEM_103
				;ld	B,4  ; IF A=1 THEN... FAL
				cp	4
				jp	NZ,ELLENORZES_NEM_104
				ret	; fal, nem mehet arra, ellenőrzés vége
	ELLENORZES_NEM_104
				;ld	B,5  ; IF A=1 THEN... FAL
				cp	5
				jp	NZ,ELLENORZES_NEM_105
				ret	; fal, nem mehet arra, ellenőrzés vége
	ELLENORZES_NEM_105
				;ld	B,6  ; IF A=1 THEN... FAL
				cp	6
				jp	NZ,ELLENORZES_NEM_106
				ret	; fal, nem mehet arra, ellenőrzés vége
	ELLENORZES_NEM_106
				;ld	B,7  ; IF A=1 THEN... FAL
				cp	7
				jp	NZ,ELLENORZES_NEM_107
				ret	; fal, nem mehet arra, ellenőrzés vége
	ELLENORZES_NEM_107
				;ld	B,8  ; IF A=1 THEN... FAL
				cp	8
				jp	NZ,ELLENORZES_NEM_108
				ret	; fal, nem mehet arra, ellenőrzés vége
	ELLENORZES_NEM_108
				;ld	B,9  ; IF A=1 THEN... FAL
				cp	9
				jp	NZ,ELLENORZES_NEM_109
				ret	; fal, nem mehet arra, ellenőrzés vége
	ELLENORZES_NEM_109
				cp	27
				jp	NZ,ELLENORZES_NEM_27
				ld	A,28
				ld	(HL),A
				call 	MAP_KIRAJZOL_3x3					;(foszerMY),(foszerMX)	
				ret	; fal, nem mehet arra, ellenőrzés vége
	ELLENORZES_NEM_27
				cp	28
				jp	NZ,ELLENORZES_NEM_28
				ret	; fal, nem mehet arra, ellenőrzés vége
	ELLENORZES_NEM_28
				cp	22
				jp	NZ,ELLENORZES_NEM_122
				ret	; fal, nem mehet arra, ellenőrzés vége
	ELLENORZES_NEM_122
				;ld	B,20  ; IF A=1 THEN... eltolhato koo
				cp	20
				jp	NZ,ELLENORZES_NEM_120
				;
				call	ELTOLHATO_KO
				;
				ret	; Eltolható kő, még nincs lekezelve
	ELLENORZES_NEM_120
				;ld	B,11  ; IF A=2 THEN... EXIT 
				cp	11
				jp	NZ,ELLENORZES_NEM_2 ; A<>2
				; A=2
				call hang_effekt_0
				jp	ELLENORZES_VEGE_MEHET
				;ret	;EXIT 
	ELLENORZES_NEM_2
				;ld	B,12  ; IF A=12 THEN... KARD
				cp	12
				jp	NZ,ELLENORZES_NEM_3	; A<>12   -KARD
				ld	A,(targy_2)
				ld	(targy_3),A
				ld	A,(targy_1)
				ld	(targy_2),A
				ld	A,12
				ld	(targy_1),A
				ld	A,0
				ld	(HL),A
