        "7347": {"synopsis":"One byte of the 8.3 name."},
        "7353": {"comment":"Printable?"},
        "7357": {"synopsis":"Unprintable: '_'.","comment":"'_'"},
        "7359": {"synopsis":"The byte stored."},
        "7363": {"comment":"Entry + $16"},
        "7367": {"comment":"+12: time and date"},
        "7372": {"comment":"Skip the cluster"},
        "7374": {"comment":"+16: size"},
        "7378": {"comment":"B = options"},
