        "7003": {"synopsis":"Checks one path component at HL, up to '/', '\\' or $FF: characters $20-$7E, none of '\"' ':'\n'<' '>' '`' '|'.\nExit: Fc=1 valid, A = the end character, HL past it, IXL = $41 empty, $C1 a name, $81 a name\nwith '?' or '*'; Fc=0 an invalid character.","comment":"Empty so far"},
        "7006": {"comment":"First character"},
        "7008": {"comment":"Separator or end?"},
        "7011": {"comment":"Yes: empty"},
        "7012": {"comment":"A name"},
        "7015": {"comment":"Back on its first character"},
        "7016": {"synopsis":"One character."},
        "7018": {"comment":"Separator or end: done, Fc=1"},
        "7022": {"comment":"Control code?"},
        "7029": {"comment":"'\"' ':' '<' '>' '`' '|' are invalid"},
        "7047": {"comment":"'?'?"},
        "7051": {"comment":"'*'?"},
        "7055": {"synopsis":"A wildcard seen.","comment":"Name with wildcards"},
        "7060": {"synopsis":"Fc=1 and Z if A is '/', '\\' or $FF; else Fc=0.","comment":"'/'?"},
        "7064": {"comment":"'\\'?"},
        "7068": {"comment":"$FF?"},
        "7072": {"synopsis":"The search record back on its directory's first entry (vector $013C with A = 1, DEHL = 0).","comment":"Entry 0"},
        "7077": {"comment":"A = 1: move"},
        "7078": {"comment":"Vector $013C"},
        "7086": {"synopsis":"Search record $2E50 = the volume's root directory (vector $0127 with B = 3, DIR_RECORD_OP).","comment":"B = 3: root"},
        "7088": {"comment":"Vector $0127"},
        "7096": {"synopsis":"Walks path HL ($FF-ended) on drive A to its last component, without a path text.","comment":"No path text"},
        "7098": {"synopsis":"Walks path HL ($FF-ended) on drive A to its last component:\n1. The search record = the drive's current directory (vector $0127, B = 1); a leading '/' or\n   '\\' starts at the root.\n2. Each component before a separator is checked (PATH_PART_CHECK) and entered (DIR_ENTER).\n3. With B nonzero, the path text whose end BC points at follows: cut back to 'X:/' for a\n   root, a directory's name added or, for '..', taken off.\nExit: Fc=1, HL = the last component, DE = $2E50, A = $0F, the flags from IXL: S a last name\nis there, Z it has no wildcards; Fc=0 A = error ($14 rc_badname for a bad component).","comment":"Keep the text and the path"},
        "7100": {"comment":"B = 1: drive's current directory"},
        "7109": {"comment":"DE = path"},
        "7111": {"comment":"Failed?"},
