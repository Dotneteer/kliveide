        "7124": {"synopsis":"From the root.","comment":"Skip it"},
        "7127": {"comment":"Search record = root"},
        "7132": {"comment":"Path text kept?"},
        "7136": {"synopsis":"Back to the drive's ':'.","comment":"Back one"},
        "7138": {"comment":"The ':'?"},
        "7142": {"comment":"Text = 'X:/'"},
        "7150": {"synopsis":"One component.","comment":"Keep text and path"},
