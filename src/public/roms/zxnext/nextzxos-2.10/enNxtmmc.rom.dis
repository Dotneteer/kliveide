        "1076": {"comment":"Bank paged in"},
        "1078": {"comment":"A back"},
        "1079": {"comment":"Call the word"},
        "1082": {"comment":"Alternate set"},
        "1083": {"comment":"Result A kept"},
        "1084": {"comment":"Port $E3 back"},
        "1087": {"comment":"A back"},
