        "6968": {"comment":"No: NZ"},
        "6972": {"synopsis":"Compares pattern character A with name character C in either case; a name character outside\n$20-$7E equals only '_' (DIR_ENTRY_GET shows it so).\nExit: Z equal, NZ not; a letter comes back in lower case."},
        "6973": {"comment":"Name character printable?"},
