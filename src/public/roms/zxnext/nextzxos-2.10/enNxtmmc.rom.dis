        "7762": {"comment":"High nibble of the drive byte"},
        "7767": {"comment":"10 or more?"},
        "7771": {"comment":"Units digit"},
        "7776": {"comment":"Tens digit 1"},
        "7778": {"synopsis":"A digit before the letter.","comment":"'0' + A"},
