        "7460": {"comment":"Length = end - start"},
        "7465": {"comment":"+28: the length"},
        "7469": {"comment":"DE = the record's end"},
        "7470": {"comment":"Success"},
        "7472": {"synopsis":"Vector $013C, on the search record $2E50: Fc=1 tells its entry number in DEHL; Fc=0 with Z\nsteps one entry on; Fc=0 with NZ moves to entry DEHL from the start. Telling: in a root\ndirectory of fixed size the sector index x 16 + the entry; otherwise the clusters before the\ncurrent one counted along the chain in bytes, plus the sector, / 32, + the entry in the\nsector.\nExit: Fc=1 (DEHL); Fc=0 A = error.","comment":"IY = $2E50, IX its volume"},
        "7475": {"comment":"Fc=0: move"},
        "7477": {"comment":"High word 0"},
        "7480": {"comment":"HL = sector or cluster field"},
        "7486": {"comment":"4 shifts: 16 entries a sector"},
        "7488": {"comment":"Root of fixed size?"},
        "7494": {"comment":"Byte count 0 (high, low)"},
        "7496": {"comment":"BCDE = first cluster"},
        "7498": {"synopsis":"One cluster along the chain.","comment":"Keep the walk's cluster"},
        "7500": {"comment":"BCDE = current cluster"},
        "7504": {"comment":"Low words"},
        "7505": {"comment":"Same?"},
        "7510": {"comment":"Differ?"},
        "7512": {"comment":"High words same?"},
        "7514": {"comment":"Reached the current cluster"},
        "7516": {"synopsis":"Next cluster; a cluster's bytes counted.","comment":"BCDE = next in the chain"},
        "7519": {"comment":"HL = count, low word"},
        "7520": {"comment":"Failed?"},
        "7522": {"comment":"A = sectors per cluster"},
        "7525": {"comment":"x 2: 512 bytes each; 128 or more?"},
        "7528": {"comment":"Count + 512 x sectors"},
        "7532": {"synopsis":"Carry into the count's high word.","comment":"High word + 1"},
        "7535": {"synopsis":"Count kept; the next cluster.","comment":"Keep the count"},
        "7538": {"synopsis":"Current cluster reached: its sectors before the current one added.","comment":"HL = count, low"},
        "7539": {"comment":"DE = high"},
        "7540": {"comment":"Sector within the cluster"},
        "7543": {"comment":"x 512 bytes"},
        "7548": {"comment":"Carry"},
