        "6726": {"synopsis":"DIR_FIND_NEXT's filter on the entry at IX (attributes, then the 8.3 name); C's bits reject:\n7 files, 6 directories, 5 directories whose name starts '.', 4 hidden or system entries.\nExit: Z passes, NZ rejected.","comment":"A = attributes"},
