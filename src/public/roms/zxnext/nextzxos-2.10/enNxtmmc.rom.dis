        "7802": {"synopsis":"Stores the path text at HL ('X:' then the path) as drive A's record: the ':' becomes the\ndrive byte A and the letter its complement for the copy (254 bytes) to DivMMC RAM bank 9 at\n$2000 + 256 x drive; then the text is put back.","comment":"D = the drive byte"},
        "7803": {"synopsis":"To the ':'.","comment":"':'?"},
        "7809": {"comment":"Drive byte over it"},
        "7811": {"comment":"Keep the letter"},
        "7813": {"comment":"Its complement"},
