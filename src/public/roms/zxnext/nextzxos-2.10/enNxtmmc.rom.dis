        "7155": {"comment":"DE = its start"},
        "7157": {"comment":"End character: $FF gives 0"},
        "7158": {"comment":"Invalid character?"},
        "7160": {"comment":"Ends at a separator?"},
        "7162": {"comment":"The last: its length"},
        "7165": {"comment":"256 or more?"},
        "7169": {"comment":"HL = the last component"},
        "7170": {"synopsis":"Done: the flags from the last component's class.","comment":"DE = search record"},
        "7171": {"comment":"A as kept"},
        "7172": {"comment":"AF = A and the class IXL"},
        "7178": {"synopsis":"Error $14 (rc_badname).","comment":"rc_badname"},
        "7180": {"synopsis":"Failure exit.","comment":"Drop A and the record"},
        "7183": {"synopsis":"A component before a separator: a directory to enter."},
        "7184": {"comment":"Its length"},
        "7189": {"comment":"Empty?"},
        "7191": {"comment":"256 or more?"},
        "7194": {"comment":"HL = the separator"},
