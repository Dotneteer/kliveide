        "7673": {"comment":"Walk the path, keeping the text"},
        "7676": {"comment":"DE = the text"},
        "7677": {"comment":"Failed?"},
        "7679": {"comment":"A last name: enter it"},
        "7683": {"comment":"HL = the text"},
        "7685": {"synopsis":"Fetches drive A's path record (254 bytes from DivMMC RAM bank 9 at $2000 + 256 x drive) to\nDE + 2 and makes it text: 'X:' and the path, or 'X:/' when the record is not valid (byte 0\nthe complement of byte 1, whose low nibble is the drive) or the path does not start with a\nseparator. With bit 6 of the drive's table byte, byte 1's high nibble goes before the letter\nin decimal. A byte outside $21-$7F ends the text.\nExit: HL = the text, DE on its $FF, C = byte 1 (the drive byte).","comment":"Two bytes free before the record"},
        "7687": {"comment":"Drive number"},
        "7690": {"comment":"HL = $2000 + 256 x drive"},
        "7695": {"comment":"254 bytes"},
        "7698": {"comment":"From DivMMC RAM bank 9"},
        "7701": {"comment":"Copy to DE"},
        "7704": {"comment":"HL = the record"},
        "7705": {"comment":"D = drive number"},
        "7706": {"comment":"Byte 0 the complement of byte 1?"},
        "7712": {"comment":"Byte 1 for this drive?"},
        "7717": {"comment":"D = the drive byte"},
        "7718": {"comment":"Path starts with '/'?"},
        "7725": {"comment":"or '\\'?"},
        "7729": {"synopsis":"Record not usable: path '/'.","comment":"Drive byte"},
        "7731": {"comment":"'/'"},
        "7734": {"comment":"End mark"},
        "7736": {"comment":"Back on byte 1"},
        "7738": {"synopsis":"'X:' over bytes 0 and 1.","comment":"':'"},
        "7740": {"comment":"Drive letter"},
        "7747": {"comment":"Length allowed"},
