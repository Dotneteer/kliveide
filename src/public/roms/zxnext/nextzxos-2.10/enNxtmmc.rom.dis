        "3076": {"comment":"Divide by sectors per cluster"},
        "3079": {"synopsis":"One halving per factor of 2 in the sectors per cluster.","comment":"One shift per power of 2"},
        "3093": {"synopsis":"HL:DE = the cluster count: plus 1.","comment":"Plus 1: the highest cluster number"},
        "3099": {"synopsis":"The highest cluster number to IX+$22."},
