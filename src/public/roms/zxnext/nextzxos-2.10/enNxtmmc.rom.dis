        "6574": {"synopsis":"Checks the 128 bytes at HL for a +3DOS header: byte 127 the sum of bytes 0-126, bytes 0-10\nPLUS3DOS_SIG.\nExit: Z valid, DE = HL + 11; NZ not."},
        "6575": {"comment":"A = sum of 127 bytes"},
