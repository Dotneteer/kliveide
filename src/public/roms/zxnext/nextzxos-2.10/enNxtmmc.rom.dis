        "7380": {"comment":"Header bytes wanted?"},
        "7384": {"comment":"Size's high 3 bytes"},
        "7391": {"comment":"Any set: big enough"},
        "7393": {"comment":"Low byte 128 or more?"},
        "7397": {"synopsis":"The file's first sector read and checked for a header.","comment":"Entry + $14: first cluster, high"},
        "7404": {"comment":"Entry + $1A: low"},
        "7411": {"comment":"Sector 0 of the cluster"},
        "7415": {"comment":"Failed?"},
        "7417": {"comment":"A +3DOS header?"},
        "7422": {"comment":"HL = header + 15: BASIC bytes"},
        "7427": {"comment":"DE = +20"},
        "7429": {"comment":"8 bytes"},
        "7436": {"synopsis":"No header: $FF and 7 zeros.","comment":"DE = +20"},
        "7438": {"comment":"$FF: none"},
        "7442": {"comment":"7 zeros"},
        "7445": {"synopsis":"One zero."},
        "7449": {"synopsis":"The name text at +30, its length at +28.","comment":"DE = +20"},
        "7450": {"comment":"+30"},
