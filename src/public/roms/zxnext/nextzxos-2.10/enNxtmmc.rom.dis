        "7554": {"comment":"3 shifts: / 32 in all"},
        "7556": {"synopsis":"DEHL x 2.","comment":"DEHL x 2"},
        "7563": {"comment":"Plus the entry in the sector"},
        "7574": {"comment":"Success"},
        "7576": {"synopsis":"Failure: the count's high word dropped.","comment":"Drop the high word"},
        "7578": {"synopsis":"Move: Z one entry on; NZ to entry DEHL.","comment":"Z: one entry on"},
