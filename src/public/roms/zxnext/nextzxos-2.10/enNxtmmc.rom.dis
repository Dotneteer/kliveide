        "6602": {"synopsis":"Fc=1 when the search record's entry is not a dot entry (name starting '.'); Fc=0 A = $1E\n(rc_denied) when it is, or when the entry cannot be read.","comment":"HL = the entry"},
        "6606": {"comment":"Name starts with '.'?"},
        "6609": {"comment":"rc_denied"},
        "6614": {"synopsis":"Position 0 for the file at IY, its sector fetched: HL = that byte in the sector buffer\n(FILE_BYTE_ADDR).\nExit: Fc=1; Fc=0 A = error.","comment":"DEHL = 0"},
        "6622": {"comment":"HL = the byte in the buffer"},
