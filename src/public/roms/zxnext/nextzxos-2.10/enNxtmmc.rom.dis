        "6954": {"synopsis":"Next character.","comment":"Whole field?"},
        "6957": {"synopsis":"'*': the rest of the field skipped; Z.","comment":"Skip the rest"},
        "6961": {"synopsis":"Pattern ended: it stays on its $FF; the rest must be spaces.","comment":"Pattern back on its end"},
