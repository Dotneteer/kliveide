        "2725": {"comment":"The character back"},
        "2726": {"comment":"In at column B"},
        "2728": {"synopsis":"The row already continued: into the next row at its text's start.","comment":"Row C's flags: B added"},
        "2731": {"comment":"DE = row C"},
