        "3101": {"comment":"Back right past the space"},
        "3104": {"synopsis":"HL back."},
        "3105": {"synopsis":"The end of a deleting key: the line's rows redrawn (ROWS_REDRAW_LINE), $D741 bit 2 cleared\nand the window's rows 0 to ($D73C) redrawn (ROWS_DRAW), $D5B7 bit 3 set, the cursor stored\n(CURSOR_PUT).\nExit: the carry given on entry.","comment":"A = the column"},
        "3106": {"comment":"Kept with the carry"},
        "3108": {"comment":"The line's rows redrawn"},
        "3111": {"comment":"HL = $D741"},
        "3114": {"comment":"Drawing allowed again"},
        "3116": {"comment":"A = the window's last row"},
        "3119": {"comment":"The cursor kept"},
        "3120": {"comment":"From row 0"},
        "3122": {"comment":"To the last"},
        "3123": {"comment":"Z: no cursor move"},
