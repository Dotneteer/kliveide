        "7518": {"comment":"An ENTER?"},
        "7520": {"comment":"Yes: past it"},
        "7522": {"comment":"Anything else: no carry"},
        "7523": {"synopsis":"Done.","comment":"BC, DE and HL back"},
        "7527": {"synopsis":"Past it.","comment":"Past it"},
        "7528": {"comment":"The place kept"},
        "7534": {"comment":"Again"},
        "7536": {"synopsis":"PLAY's errors end here: the CPU speed back and interrupts on (PLAY_RESTORE), then error code\nC through NextZXOS ROM 1's ERROR_128_A. The entries below silence the AY chips first\n(PLAY_SILENCE) and set C; PLAY_NEXT's BREAK comes here too.\nEntry: C = the error code.","comment":"CPU speed back, interrupts on (PLAY_RESTORE)"},
        "7539": {"comment":"A = the error code"},
        "7540": {"comment":"NextZXOS ROM 1's ERROR_128_A"},
        "7543": {"synopsis":"Error code $29, report n (out of range).","comment":"The AY silenced"},
        "7546": {"comment":"Error code $29, report n"},
        "7550": {"synopsis":"Error code $27, report l (number too big).","comment":"The AY silenced"},
        "7553": {"comment":"Error code $27, report l"},
        "7557": {"synopsis":"Error code $26, report k (invalid note name).","comment":"The AY silenced"},
        "7560": {"comment":"Error code $26, report k"},
        "7564": {"synopsis":"Error code $1F, report d (too many brackets).","comment":"The AY silenced"},
        "7567": {"comment":"Error code $1F, report d"},
        "7571": {"synopsis":"Error code $28, report m (note out of range).","comment":"The AY silenced"},
        "7574": {"comment":"Error code $28, report m"},
        "7578": {"synopsis":"Error code $2A, report o (too many tied notes).","comment":"The AY silenced"},
        "7581": {"comment":"Error code $2A, report o"},
        "7585": {"synopsis":"Starts every string's note that has not ended: its name read (PLAY_NOTE_NAME); not a rest:\nsounded (PLAY_SOUND) and its volume set.","comment":"The list from its start; string 0's bit"},
        "7588": {"synopsis":"The next string.","comment":"Has this string ended?"},
        "7591": {"comment":"Yes: the next"},
        "7593": {"comment":"IX = its block, its AY chip selected"},
        "7596": {"comment":"A = its note"},
        "7599": {"comment":"A rest?"},
        "7601": {"comment":"Yes: nothing to sound"},
        "7603": {"comment":"Its tone set"},
        "7606": {"comment":"A = the AY channel"},
        "7609": {"comment":"Always below 3"},
        "7613": {"comment":"Register 8 + the channel"},
        "7616": {"comment":"= the volume"},
        "7622": {"synopsis":"The next string's bit.","comment":"The next string's bit; Z until past string 8"},
        "7625": {"comment":"More strings"},
