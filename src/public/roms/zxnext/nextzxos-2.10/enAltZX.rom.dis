        "2896": {"comment":"H, L = the cursor's column, row"},
        "2897": {"comment":"Z: the cursor's row done"},
        "2898": {"comment":"A = the character"},
        "2899": {"comment":"Not yet: the row above"},
        "2903": {"comment":"HL = the width"},
        "2906": {"comment":"HL = the flags byte"},
