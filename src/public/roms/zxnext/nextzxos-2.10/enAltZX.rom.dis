        "542": {"comment":"HL = the program's first line"},
        "545": {"comment":"E_PPC = that line"},
        "548": {"synopsis":"Again (ROWS_REBUILD_GO)."},
        "550": {"comment":"Again with it"},
        "553": {"synopsis":"Rows 0 to ($D73C) drawn (ROWS_DRAW, with Z).","comment":"The first and last rows back"},
        "555": {"comment":"Z: no cursor move"},
        "556": {"synopsis":"Draws editing rows B to C on the screen, each through $1169. With NZ on entry the cursor is\nthen moved on ($D5B5) places (ROWS_DRAW_MOVE).\nEntry: B, C = the first and last row; Z or NZ.","comment":"The Z flag kept"},
        "557": {"comment":"A = the last row"},
        "558": {"comment":"C = the first"},
        "559": {"comment":"DE = its place"},
        "562": {"comment":"HL = the row"},
        "563": {"synopsis":"One row drawn ($1169); the next, up to A.","comment":"The last row kept"},
        "564": {"comment":"Row C drawn"},
        "568": {"comment":"DE = the row size"},
        "572": {"comment":"HL = the next row"},
        "573": {"comment":"The next row number"},
        "574": {"comment":"Past the last?"},
        "577": {"comment":"The Z flag back"},
        "578": {"comment":"Z: done"},
        "579": {"comment":"The cursor's place"},
        "582": {"synopsis":"One place on (CURSOR_RIGHT), ($D5B5) times, then the cursor stored.","comment":"One place right"},
        "585": {"comment":"The count less one"},
        "594": {"comment":"Until it is 0"},
        "596": {"comment":"The cursor stored"},
        "599": {"synopsis":"Scrolls the editing rows up by one: row 0 goes to the rows above the window ($0E0F; when\nthere is no room there, nothing is done), then ROWS_UP_FROM from row 0 with the next row\nfrom below (ROW_FROM_BELOW).\nExit: carry when done.","comment":"Row 0"},
        "602": {"comment":"C = 0"},
        "603": {"comment":"DE = row 0"},
        "606": {"comment":"Row 0 above the window"},
        "610": {"comment":"No room: no carry"},
        "611": {"comment":"HL = the next row from below"},
        "614": {"synopsis":"Rows B+1 to ($D73C) moved up by one into rows B to ($D73C) - 1, the screen scrolled the same\nway ($101C), and the row at HL copied into the last row.\nEntry: B = the row, DE = its address, HL = the new row.\nExit: carry. Keeps BC."},
        "615": {"comment":"The new row kept"},
        "616": {"comment":"HL = the row after row B"},
        "620": {"comment":"A = the last row"},
        "623": {"comment":"C = the last row"},
        "624": {"comment":"Row B the last?"},
        "628": {"synopsis":"One row up."},
        "629": {"comment":"BC = the row size"},
        "633": {"comment":"One row up"},
        "636": {"comment":"A = the last row"},
        "637": {"comment":"The next row"},
        "638": {"comment":"Up to the last"},
        "642": {"synopsis":"The screen scrolled up ($101C); the new row into the last row.","comment":"HL = the new row"},
        "643": {"comment":"The screen scrolled up"},
        "646": {"comment":"BC = the row size"},
        "650": {"comment":"The new row into the last row"},
        "652": {"comment":"Done"},
        "655": {"synopsis":"Scrolls the editing rows down by one: the last row above the window comes back ($0DCC; when\nthere is none, nothing is done), then ROWS_DOWN_FROM from row 0.\nExit: carry when done.","comment":"Row 0"},
        "657": {"comment":"HL = the last row above the window"},
        "660": {"comment":"None: no carry"},
        "661": {"synopsis":"Row ($D73C) goes to the rows below the window (BELOW_PUSH; when there is no room there,\nnothing is done), rows B to ($D73C) - 1 move down by one, the screen scrolled the same way\n($1030), and the row at HL copied into row B.\nEntry: B = the row, HL = the new row.\nExit: carry when done. Keeps BC."},
        "662": {"comment":"The new row kept"},
        "663": {"comment":"A = the last row"},
        "666": {"comment":"C = the last row"},
        "667": {"comment":"DE = its place"},
        "670": {"comment":"The last row below the window"},
        "673": {"comment":"No room there?"},
        "675": {"comment":"DE = the row's place less one"},
