        "5622": {"comment":"The next character"},
        "5624": {"synopsis":"The buffer full: split at a space (TOK_SPLIT), or written as text (TOK_FLUSH) and the rest\nof the word passed ($D7F5 bit 4)."},
        "5627": {"comment":"Split: on with the character"},
        "5632": {"comment":"Bit 4: the rest of the word as text"},
        "5634": {"comment":"On with the character"},
        "5636": {"synopsis":"B written (TOK_OUT); a character other than a letter ends a passed word. At ENTER in mode 0,\nTOKENIZE ends with no carry.","comment":"A letter?"},
        "5638": {"comment":"No: the word passing ends"},
        "5645": {"comment":"The line's end: no carry"},
        "5646": {"comment":"The next character"},
        "5648": {"synopsis":"State 1: a letter, '#' or '$' goes into the buffer.","comment":"A letter, '#' or '$'?"},
        "5650": {"comment":"Yes: into the buffer"},
        "5652": {"synopsis":"The word ended: looked up (KEYWORD_LOOKUP); a keyword's token written (TOK_OUT), the buffer\nemptied, and the character taken again.","comment":"The character kept"},
        "5656": {"comment":"Not a keyword"},
        "5658": {"comment":"The token written"},
        "5661": {"comment":"The buffer emptied"},
        "5664": {"comment":"The character again"},
        "5667": {"synopsis":"Not a keyword: split at a space (TOK_SPLIT) and the rest looked up again; a space goes into\nthe buffer."},
        "5671": {"comment":"No space in the word"},
        "5673": {"comment":"Still in a word?"},
        "5676": {"comment":"Still a word?"},
        "5679": {"comment":"State 0: the character again"},
