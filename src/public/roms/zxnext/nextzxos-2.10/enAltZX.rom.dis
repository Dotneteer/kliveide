        "3196": {"comment":"None: done"},
        "3198": {"comment":"Deleted"},
        "3202": {"comment":"Again"},
        "3204": {"comment":"Not reached: $0BF1 jumps past it"},
        "3205": {"synopsis":"First row: the characters before the cursor, back to the text's start.","comment":"A = the column"},
        "3206": {"comment":"Column 0?"},
        "3209": {"comment":"The column before"},
