        "2036": {"comment":"Moved: again"},
        "2038": {"comment":"No: done"},
        "2040": {"synopsis":"First row: the start of its text.","comment":"From column 0"},
        "2042": {"comment":"To the start of its text"},
        "2045": {"comment":"Done"},
        "2047": {"synopsis":"Moves the cursor down (ROW_DOWN) to its line's last row (flags bit 3) and there to just\nafter\nthe text (TEXT_END_LEFT from the last column). ROW_DOWN's result is not tested: the loop\ngoes\non until a last row is reached.\nKeeps DE, HL."},
        "2049": {"synopsis":"The line's last row?","comment":"DE = row C"},
        "2052": {"comment":"HL = the width"},
