        "2826": {"synopsis":"H = column B, L = row C of the cursor.","comment":"H, L = the cursor's column, row"},
        "2827": {"synopsis":"One row: its start column (B on the cursor's row, the text's start on the others).","comment":"Kept"},
        "2828": {"comment":"DE = row C"},
        "2831": {"comment":"H, L = the cursor's column, row"},
        "2832": {"comment":"B = the character carried"},
