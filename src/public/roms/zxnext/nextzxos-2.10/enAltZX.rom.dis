        "7502": {"comment":"No"},
        "7508": {"comment":"No"},
        "7510": {"comment":"The end: carry"},
        "7511": {"comment":"Done"},
        "7513": {"synopsis":"A space or ENTER is passed.","comment":"A = the character"},
