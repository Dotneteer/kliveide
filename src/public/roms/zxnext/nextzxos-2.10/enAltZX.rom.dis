        "3042": {"comment":"The rows moved up over it"},
        "3045": {"synopsis":"Key $1B: deletes left of the cursor: the spaces before it, then the word before them,\nstopping at the line's start (AT_LINE_START); the space before the word is kept. Then\nDEL_KEY_END.","comment":"The cursor off; HL = $D748"},
        "3048": {"synopsis":"At the line's start? Otherwise left one, deleted; a space: again."},
        "3049": {"comment":"At the line's start?"},
        "3052": {"comment":"Then done"},
        "3054": {"comment":"One place left"},
        "3058": {"comment":"None: done"},
        "3060": {"comment":"A = the character there"},
        "3063": {"comment":"Kept"},
        "3065": {"comment":"Deleted"},
        "3069": {"comment":"The character back"},
        "3070": {"comment":"A space?"},
        "3072": {"comment":"Then on"},
        "3074": {"synopsis":"The word: left one; a space ends it, any other character is deleted."},
        "3075": {"comment":"At the line's start?"},
        "3078": {"comment":"Then done"},
