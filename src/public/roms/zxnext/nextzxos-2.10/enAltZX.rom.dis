        "413": {"synopsis":"The row copied into the editing rows (($D73F) bytes); DE = the next row's place."},
        "415": {"comment":"BC = the row size"},
        "419": {"comment":"The row into the window"},
        "423": {"comment":"DE = the next row's place, kept"},
        "424": {"comment":"The row numbers kept"},
