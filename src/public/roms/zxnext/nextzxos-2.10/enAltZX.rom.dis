        "2017": {"comment":"No carry"},
        "2018": {"comment":"DE and HL back"},
        "2020": {"synopsis":"Moves the cursor up (ROW_UP) to its line's first row (flags bit 0) and there to the start of\nthe text (TEXT_AT_OR_RIGHT from column 0).\nExit: carry when it got there. Keeps DE, HL."},
        "2022": {"synopsis":"The line's first row?","comment":"DE = row C"},
        "2025": {"comment":"HL = the width"},
        "2028": {"comment":"HL = the flags byte"},
        "2029": {"comment":"The line's first row?"},
