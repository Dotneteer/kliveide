        "2919": {"comment":"HL = $D5B7"},
        "2922": {"comment":"An empty line: not changed"},
        "2924": {"synopsis":"A = 0; BC back.","comment":"A = 0"},
        "2927": {"synopsis":"Redraws the cursor's line from row C to its last row (flags bit 3, the flags coming back\nfrom $1169), each later row's flags getting B added (NEXT_ROW_FLAGS); past the window's last\nrow the line's rows below the window are gone through ($11A9) up to its last row. Keeps BC."},
        "2928": {"comment":"DE = row C"},
        "2931": {"comment":"HL = the row"},
        "2932": {"synopsis":"One window row drawn; the line's last row?","comment":"Drawn; A = its flags"},
        "2935": {"comment":"The line's last row?"},
        "2939": {"comment":"The next row"},
        "2940": {"comment":"A = the window's last row"},
        "2943": {"comment":"Past it?"},
        "2946": {"comment":"The next row, B added to its flags"},
        "2949": {"comment":"Again"},
        "2951": {"synopsis":"Past the window: the rows below from $C73B.","comment":"HL = the rows below the window"},
        "2954": {"synopsis":"One row below ($11A9); the line's last row?","comment":"The next row, B added to its flags"},
        "2957": {"comment":"Gone through; A = its flags"},
        "2960": {"comment":"The line's last row?"},
        "2964": {"comment":"Again"},
        "2966": {"synopsis":"BC back."},
        "2968": {"synopsis":"DE = HL + ($D73F), the next row; then ROW_FLAGS_B on it.","comment":"DE = the row size"},
        "2972": {"comment":"HL = the next row"},
        "2973": {"comment":"DE = it"},
        "2974": {"comment":"HL = the width"},
        "2977": {"comment":"HL = the flags byte"},
        "2978": {"synopsis":"The flags byte at HL: bits 0-4 kept, B added.\nExit: HL and DE exchanged.","comment":"A = the flags"},
        "2979": {"comment":"Bits 0-4 kept"},
        "2981": {"comment":"B added"},
        "2982": {"comment":"Stored"},
        "2983": {"comment":"HL = the row, DE = the flags byte"},
        "2985": {"synopsis":"Removes window row C (at DE), which holds no text:\n1. When it is not its line's first row (flags bit 0), the row above (C - 1, or the last row\n   above the window for row 0, $D74E stepped by $13F9) gets bit 1 cleared and row C's flags\n   added.\n2. The rows below move up into its place (ROWS_UP_FROM with the next row from below).\nExit: carry when done.","comment":"HL = the width"},
        "2988": {"comment":"HL = the flags byte"},
        "2989": {"comment":"A = the flags"},
        "2990": {"comment":"The line's first row?"},
        "2994": {"comment":"The flags kept"},
        "2996": {"comment":"A = the row"},
        "2997": {"comment":"Row 0?"},
        "3010": {"comment":"A = the count of rows above"},
        "3013": {"comment":"C = the last of them"},
        "3015": {"comment":"DE = that row above the window"},
        "3021": {"synopsis":"Row C - 1.","comment":"The row above"},
        "3022": {"comment":"DE = it"},
        "3025": {"synopsis":"The row above: bit 1 cleared, row C's flags added."},
        "3026": {"comment":"The flags back"},
