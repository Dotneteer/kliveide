        "1070": {"comment":"The cursor shown"},
        "1073": {"synopsis":"Key $19: in mode 0 only, the cursor off, editing moved between the upper and the lower\nscreen ($13B8), the cursor shown. In other modes NC (refused).","comment":"A = the mode"},
        "1076": {"comment":"Not 0: refused"},
        "1078": {"comment":"The cursor off"},
        "1081": {"comment":"To the other screen"},
        "1084": {"comment":"The cursor shown"},
        "1087": {"synopsis":"Editing in the lower screen: $D5B7 bit 6 set, two editing rows (EDIT_IN_LOWER), $1103, the\ncursor's limits for the lower screen (CURSOR_SET_LOWER), lines 21-23 cleared (ROM 0's\nCLEAR_BOTTOM3).","comment":"HL = $D5B7"},
        "1090": {"comment":"Editing in the lower screen"},
        "1092": {"comment":"Two rows"},
        "1095": {"comment":"The lower window's block into $D7DD"},
        "1098": {"comment":"The cursor's limits for it"},
        "1101": {"comment":"Lines 21-23 cleared (CLEAR_BOTTOM3)"},
        "1105": {"synopsis":"Editing in the upper screen: $D5B7 bit 6 cleared, 21 editing rows (EDIT_IN_MAIN), $10FA, the\ncursor's limits for the main screen (CURSOR_SET_UPPER), the title bar (ROM 0's\nEDIT_TITLE_BAR).","comment":"HL = $D5B7"},
        "1108": {"comment":"Editing in the upper screen"},
        "1110": {"comment":"21 rows"},
        "1113": {"comment":"The upper window's block into $D7DD"},
        "1116": {"comment":"The cursor's limits for it"},
        "1119": {"comment":"The title bar (EDIT_TITLE_BAR)"},
        "1123": {"synopsis":"CURSOR_SET_UPPER's block for COPY_COUNTED: a count (6), then $D745-$D74A = 0, 0, 0, 4, $10,\n$14 (row, column and remembered column of the cursor, then three row limits)."},
        "1130": {"synopsis":"CURSOR_SET_LOWER's block: a count (6), then $D745-$D74A = 0, 0, 0, 0, 1, 1."},
        "1137": {"synopsis":"$D745-$D74A from CURS_LOWER_INIT.","comment":"HL = the block for the lower screen"},
        "1140": {"comment":"To CURSOR_SET_BLOCK"},
        "1142": {"synopsis":"$D745-$D74A from CURS_UPPER_INIT. Also called from $2218, before EDIT_LINE_ENTER.","comment":"HL = the block for the upper screen"},
        "1145": {"synopsis":"DE = $D745, then COPY_COUNTED.","comment":"DE = the cursor's row"},
        "1148": {"synopsis":"Copies the bytes at HL, a count first, to DE (also used from $0E4F, $105F and $1109).\nExit: HL and DE past them; BC = 0.","comment":"C = the count"},
        "1151": {"comment":"HL = the bytes"},
        "1152": {"comment":"Copied"},
        "1155": {"synopsis":"A character key (not in the key table): codes below $20 only update the cursor's kind\n($110C: ROM 0's CURSOR_KIND into IX+6), the cursor off and on again. Others are put in at\nthe cursor (LINE_INSERT_CHAR); $D5B7 bit 3 set (the line changed); the cursor one place on\n(CURSOR_RIGHT, with $D5B7 bit 7 cleared so that a full row continues on a new one) and\nstored (CURSOR_PUT); when it does not move, only shown.","comment":"The code kept"},
        "1156": {"comment":"The cursor off"},
        "1159": {"comment":"The code back"},
        "1160": {"comment":"A control code?"},
        "1164": {"comment":"Put in at the cursor"},
        "1167": {"comment":"HL = $D5B7"},
        "1170": {"comment":"Rows may be added"},
        "1172": {"comment":"The line changed"},
        "1174": {"comment":"A = the column"},
        "1176": {"comment":"One place on"},
        "1180": {"comment":"No rows added any more"},
        "1182": {"comment":"Not moved?"},
        "1184": {"comment":"A = the column"},
        "1185": {"comment":"The cursor stored there"},
        "1188": {"synopsis":"A control code: the cursor's kind updated ($110C).","comment":"The cursor's kind updated"},
        "1191": {"synopsis":"The cursor shown.","comment":"The cursor shown"},
        "1194": {"synopsis":"Key $18: the cursor off; KEY_DELETE_GO.","comment":"The cursor off"},
        "1197": {"synopsis":"$D5B7 bit 3 set, the character under the cursor taken out (LINE_DELETE_CHAR), the line's\nrows redrawn (ROWS_REDRAW_LINE), the cursor stored (CURSOR_PUT).","comment":"HL = $D5B7"},
        "1200": {"comment":"The line changed"},
        "1202": {"comment":"The character at the cursor taken out"},
        "1205": {"comment":"The line's rows redrawn"},
        "1208": {"synopsis":"Carry; the cursor stored at column B.","comment":"Carry"},
        "1209": {"comment":"A = the column"},
        "1210": {"comment":"The cursor stored"},
        "1213": {"synopsis":"Key $0C (DELETE): $D5B7 bit 0 cleared and the cursor off; at the start of the line's text\nnothing more (the cursor stored); in a line's first row with no text the automatic line\nnumbers are turned off (DEL_AUTO_OFF); otherwise one place back (CURSOR_LEFT; at the start\nof the rows, the cursor shown) and the character there deleted (KEY_DELETE_GO).","comment":"HL = $D5B7"},
        "1216": {"comment":"The rows not full any more"},
        "1218": {"comment":"The cursor off"},
        "1221": {"comment":"DE = its row"},
        "1224": {"comment":"HL = the width"},
        "1227": {"comment":"HL = the row's flags byte"},
        "1228": {"comment":"A line's first row?"},
        "1232": {"comment":"The cursor kept"},
        "1233": {"comment":"To the start of the line's text"},
        "1236": {"comment":"A = that column"},
        "1237": {"comment":"The cursor back"},
        "1238": {"comment":"No text: automatic numbers off"},
        "1240": {"comment":"Already at the start?"},
        "1243": {"synopsis":"One place left; no move: the cursor shown.","comment":"One place left"},
        "1246": {"comment":"Carry when it did not move"},
        "1247": {"comment":"Then the cursor shown"},
        "1250": {"comment":"Then deleted"},
        "1252": {"synopsis":"No text before the cursor in the line's first row: $D750 = 0 (no automatic line numbers),\nthen KEY_DELETE_END.","comment":"No automatic line numbers"},
        "1258": {"comment":"Carry, the cursor stored"},
        "1260": {"synopsis":"Key $0D (ENTER), and EDITOR_RESUME's last step: the cursor off. A row that is empty and is a\nwhole line by itself (flags bits 0 and 3) is left alone but for the cursor shown\n(KEY_ENTER_NONE). A changed line ($D5B7 bit 3) is entered (EDIT_LINE_ENTER); when that fails\nthe cursor is only shown. Then E_PPC = the cursor's line (CURSOR_LINE_EPPC, kept round the\nmove), the cursor to the line's end (TO_LINE_END), one place on, a blank row there\n(NEW_BLANK_ROW), column 0 (CURSOR_PUT). Both ways end with the next automatic line number\ntyped in (AUTO_LINE_NUM) and carry.","comment":"The cursor off"},
        "1263": {"comment":"The remembered column kept"},
        "1264": {"comment":"DE = its row"},
        "1267": {"comment":"The cursor kept"},
        "1268": {"comment":"From column 0"},
        "1270": {"comment":"Any text in the row?"},
        "1273": {"comment":"The cursor back"},
        "1276": {"comment":"HL = the width"},
        "1279": {"comment":"HL = the row's flags byte"},
        "1280": {"comment":"A = the flags"},
        "1281": {"comment":"Bits 0 and 3 both set?"},
        "1284": {"comment":"Then an empty one-row line"},
        "1286": {"synopsis":"Changed ($D5B7 bit 3)? Then the line entered.","comment":"A = $D5B7"},
        "1289": {"comment":"The line changed?"},
        "1293": {"comment":"Entered"},
        "1296": {"comment":"Not entered"},
        "1298": {"synopsis":"The line entered or not changed: E_PPC set from the cursor's line (CURSOR_LINE_EPPC) and\nkept; the cursor to the line's end (TO_LINE_END), one place on, a blank row there\n(NEW_BLANK_ROW); E_PPC back; column 0, the remembered column back, the cursor stored\n(CURSOR_PUT); then ENTER_AUTO_NUM.","comment":"E_PPC = the cursor's line"},
        "1301": {"comment":"E_PPC kept"},
        "1305": {"comment":"To the line's end"},
        "1308": {"comment":"One place on"},
        "1311": {"comment":"A blank row there"},
        "1314": {"comment":"E_PPC back"},
        "1318": {"comment":"Column 0"},
        "1320": {"comment":"The remembered column back"},
        "1321": {"comment":"The cursor stored"},
        "1324": {"synopsis":"The next automatic line number typed in (AUTO_LINE_NUM); carry.","comment":"The next automatic line number typed in"},
        "1327": {"comment":"Carry"},
        "1329": {"synopsis":"An empty one-row line: the cursor shown, then ENTER_AUTO_NUM.","comment":"The remembered column back"},
        "1330": {"comment":"The cursor shown"},
        "1333": {"comment":"Then the automatic number"},
        "1335": {"synopsis":"Not entered: the cursor shown.","comment":"The remembered column back"},
        "1336": {"comment":"The cursor shown"},
        "1338": {"synopsis":"Key $1A, mode 0 only: E_PPC = the program's first line (ROM 3's FIND_LINE from 0 and\nLINE_NO, in bank 0), the cursor's kind updated ($110C), the rows rebuilt (ROWS_REBUILD), the\ncursor shown. In other modes NC (refused).","comment":"Line 0"},
        "1341": {"synopsis":"DE = the line number looked for; mode 0 only.","comment":"A = the mode"},
        "1344": {"comment":"Not 0: refused"},
        "1346": {"comment":"The cursor off"},
        "1349": {"comment":"Bank 0 with the program"},
        "1350": {"comment":"HL = the line number"},
        "1351": {"comment":"Kept"},
        "1352": {"comment":"HL = the first line at or after it (FIND_LINE)"},
        "1355": {"comment":"A = the number's high byte"},
        "1356": {"comment":"Zero?"},
        "1359": {"comment":"Otherwise HL = the line before it"},
        "1360": {"synopsis":"DE = the line's number; E_PPC = it.","comment":"DE = its number (LINE_NO)"},
        "1363": {"comment":"Bank 7 again"},
        "1364": {"comment":"E_PPC = it"},
        "1368": {"comment":"The cursor's kind updated"},
        "1371": {"comment":"The rows rebuilt and drawn"},
        "1374": {"comment":"Carry"},
        "1375": {"comment":"The cursor shown"},
        "1377": {"synopsis":"Key $01: as KEY_PROG_START with 10000: E_PPC = the line before the first one numbered 10000\nor more (FIND_LINE's DE).","comment":"Line 10000"},
        "1380": {"comment":"On"},
        "1382": {"synopsis":"Key $04: the cursor off, back to the start of the previous word (WORD_LEFT); stored with the\ncolumn remembered (CURSOR_PUT), or only shown when it did not move.","comment":"The cursor off"},
        "1385": {"comment":"To the start of the previous word"},
        "1388": {"comment":"Not moved: only shown"},
        "1390": {"comment":"A = the column"},
        "1391": {"comment":"The cursor stored"},
        "1393": {"synopsis":"Key $05: the cursor off, on to the start of the next word (WORD_RIGHT); stored (CURSOR_PUT),\nor only shown.","comment":"The cursor off"},
        "1396": {"comment":"To the start of the next word"},
        "1399": {"comment":"Not moved: only shown"},
        "1401": {"comment":"A = the column"},
        "1402": {"comment":"The cursor stored"},
        "1404": {"synopsis":"Takes the cursor off the screen: its place (CURSOR_GET), then $10D9.\nExit: C = the row, B = the column, A = the remembered column, HL = $D748.","comment":"C, B, A = the cursor's place"},
        "1407": {"comment":"Taken off the screen"},
        "1410": {"synopsis":"Moves the cursor to row C, column B, remembered column A: the cursor's kind updated ($110C:\nROM 0's CURSOR_KIND into IX+6), CURSOR_STORE, then CURSOR_ON. HL = ($D752) is loaded first\nbut no longer stored in E_PPC (CURSOR_LINE_EPPC sets E_PPC in this version).","comment":"Loaded, no longer used"},
        "1413": {"comment":"The cursor's kind updated"},
        "1416": {"comment":"The place stored"},
        "1419": {"synopsis":"Shows the cursor at its place (CURSOR_GET, then $10CA).\nExit: as CURSOR_GET.","comment":"C, B, A = the cursor's place"},
        "1422": {"comment":"Shown on the screen"},
        "1425": {"synopsis":"C = the cursor's row ($D745), B = its column ($D746), A = the remembered column ($D747), the\none up and down moves keep to.\nExit: HL = $D748.","comment":"HL = the cursor's row"},
        "1428": {"comment":"C = the row"},
        "1430": {"comment":"B = the column"},
        "1432": {"comment":"A = the remembered column"},
        "1435": {"synopsis":"The other way: $D745 = C, $D746 = B, $D747 = A.\nExit: HL = $D747.","comment":"HL = the cursor's row"},
        "1438": {"comment":"The row"},
        "1440": {"comment":"The column"},
        "1442": {"comment":"The remembered column"},
        "1444": {"synopsis":"A = the character at column B of window row C (ROW_ADDRESS); 0 is no character.\nExit: DE = the row. Keeps BC, HL."},
        "1445": {"comment":"DE = row C"},
        "1448": {"comment":"HL = column B's address"},
        "1452": {"comment":"A = the character"},
        "1455": {"synopsis":"Key $1E: the cursor down ten rows. Each step is ROW_DOWN with the cursor stored and its\ncolumn placed as near the remembered one as the row's text allows (COL_PLACE_R); a row\nwithout text ends it a row back up (TEN_DOWN_BACK). Then CURSOR_PUT. A step that cannot move\nleaves the cursor only shown.","comment":"The cursor off"},
        "1458": {"comment":"E = the remembered column"},
        "1459": {"comment":"Ten rows"},
        "1461": {"synopsis":"One row down."},
        "1462": {"comment":"One row down"},
        "1466": {"comment":"Not moved: only shown"},
        "1468": {"comment":"A = the remembered column"},
        "1469": {"comment":"The cursor stored"},
        "1472": {"comment":"B = the remembered column"},
        "1473": {"comment":"Placed in the row's text"},
        "1476": {"comment":"No text?"},
        "1478": {"comment":"Ten rows yet?"},
        "1481": {"comment":"A = the remembered column"},
        "1482": {"comment":"The cursor stored"},
        "1484": {"synopsis":"A row without text: back up one row, the column placed (COL_PLACE_R); no carry."},
        "1485": {"comment":"One row back up"},
        "1489": {"comment":"B = the remembered column"},
        "1490": {"comment":"Placed in the row's text"},
        "1493": {"comment":"A = the remembered column"},
        "1494": {"comment":"No carry"},
        "1495": {"comment":"The cursor stored"},
        "1497": {"synopsis":"Key $1F: the cursor up ten rows, as ED_KEY_TEN_DOWN the other way (ROW_UP, COL_PLACE_L).","comment":"The cursor off"},
        "1500": {"comment":"E = the remembered column"},
        "1501": {"comment":"Ten rows"},
        "1503": {"synopsis":"One row up."},
        "1504": {"comment":"One row up"},
        "1508": {"comment":"Not moved: only shown"},
        "1510": {"comment":"A = the remembered column"},
        "1511": {"comment":"The cursor stored"},
        "1514": {"comment":"B = the remembered column"},
        "1515": {"comment":"Placed in the row's text"},
        "1518": {"comment":"No text?"},
        "1520": {"comment":"Ten rows yet?"},
        "1523": {"comment":"A = the remembered column"},
        "1524": {"comment":"The cursor stored"},
        "1526": {"synopsis":"A row without text: back down one row, to the start of its text (TEXT_AT_OR_RIGHT from\ncolumn 0)."},
        "1527": {"comment":"One row back down"},
        "1530": {"comment":"From column 0"},
        "1532": {"comment":"To the start of the text"},
        "1536": {"comment":"The cursor stored"},
        "1539": {"synopsis":"Key $00: the cursor to the end of its line's text (TO_LINE_END); that column becomes the\nremembered one (CURSOR_PUT); without a move, only shown.","comment":"The cursor off"},
        "1542": {"comment":"To the end of the line's text"},
        "1545": {"comment":"Not moved: only shown"},
        "1548": {"comment":"A = the column, now remembered"},
        "1549": {"comment":"The cursor stored"},
        "1552": {"synopsis":"Key $1D: the cursor to the start of its line's text (TO_LINE_START); that column becomes the\nremembered one.","comment":"The cursor off"},
        "1555": {"comment":"To the start of the line's text"},
        "1558": {"comment":"Not moved: only shown"},
        "1561": {"comment":"A = the column, now remembered"},
        "1562": {"comment":"The cursor stored"},
        "1565": {"synopsis":"Key $0B: the cursor up one row (ROW_UP), as near the remembered column as the row's text\nallows (COL_PLACE_L); on a row without text, back down a row to the start of its text\n(COL_PLACE_R from column 0). Then CURSOR_PUT; no move: only shown.","comment":"The cursor off"},
        "1568": {"comment":"E = the remembered column"},
        "1569": {"comment":"Kept"},
        "1570": {"comment":"One row up"},
        "1574": {"comment":"Not moved: only shown"},
        "1577": {"comment":"B = the remembered column"},
        "1578": {"comment":"Placed in the row's text"},
        "1581": {"comment":"A = the remembered column"},
        "1582": {"comment":"Text there: the cursor stored"},
        "1586": {"comment":"Back down a row"},
        "1589": {"comment":"From column 0"},
        "1591": {"comment":"Placed in the row's text"},
        "1595": {"comment":"The cursor stored"},
        "1598": {"synopsis":"Key $0A: the cursor down one row (ROW_DOWN), as near the remembered column as the row's text\nallows (COL_PLACE_L); on a row without text, back up a row, the column placed (COL_PLACE_R).\nThen CURSOR_PUT; no move: only shown.","comment":"The cursor off"},
        "1601": {"comment":"E = the remembered column"},
        "1602": {"comment":"Kept"},
        "1603": {"comment":"One row down"},
        "1607": {"comment":"Not moved: only shown"},
        "1610": {"comment":"B = the remembered column"},
        "1611": {"comment":"Placed in the row's text"},
        "1614": {"comment":"A = the remembered column"},
        "1615": {"comment":"Text there: the cursor stored"},
        "1619": {"comment":"Back up a row"},
        "1623": {"comment":"B = the remembered column"},
        "1624": {"comment":"Placed in the row's text"},
        "1627": {"comment":"A = the remembered column"},
        "1628": {"comment":"No carry"},
        "1629": {"comment":"The cursor stored"},
        "1632": {"synopsis":"Key $08: the cursor one place left (CURSOR_LEFT); the new column becomes the remembered one.\nExit: no move, only shown.","comment":"The cursor off"},
        "1635": {"comment":"One place left"},
        "1638": {"comment":"Moved: stored, the column remembered"},
        "1641": {"comment":"The cursor shown"},
        "1644": {"synopsis":"Key $09: the cursor one place right (CURSOR_RIGHT); the new column becomes the remembered\none. At the last column of a line's last row the move may add a row ($D5B7 bit 7 cleared);\nwhen it moved, the cursor goes back one place and the character there is deleted\n(KEY_DELETE_GO) before it is stored.","comment":"The cursor off"},
        "1647": {"comment":"At the last column?"},
        "1652": {"comment":"No: an ordinary move"},
        "1654": {"comment":"DE = row C"},
        "1657": {"comment":"HL = the width"},
        "1660": {"comment":"HL = the flags byte"},
        "1661": {"comment":"The line's last row?"},
        "1663": {"comment":"C, B, A = the cursor's place (flags kept)"},
        "1666": {"comment":"Not the last row: an ordinary move"},
        "1668": {"comment":"Rows may be added"},
        "1673": {"comment":"One place right: a new row"},
        "1676": {"comment":"No rows added any more"},
        "1678": {"comment":"Not moved: shown"},
        "1680": {"comment":"Back one place"},
        "1683": {"comment":"The character there deleted"},
        "1686": {"comment":"The cursor stored"},
        "1689": {"comment":"One place right","synopsis":"Not at the end of a line's last row: one place right; moved: stored, the column remembered."},
        "1692": {"comment":"Moved: stored, the column remembered"},
        "1695": {"comment":"The cursor shown","synopsis":"The cursor shown."},
        "1698": {"synopsis":"Places column B of row C in the row's text: TEXT_AT_OR_RIGHT, and TEXT_END_LEFT when that\nfails.\nExit: carry when the row has text. Keeps DE."},
        "1699": {"comment":"At or right of column B?"},
        "1702": {"comment":"Otherwise left of it"},
        "1707": {"synopsis":"As COL_PLACE_R, the other way round: TEXT_END_LEFT first, then TEXT_AT_OR_RIGHT.\nExit: carry when the row has text. Keeps DE."},
        "1708": {"comment":"Left of column B?"},
        "1711": {"comment":"Otherwise at or right of it"},
        "1716": {"synopsis":"Moves the cursor's row C up one:\n1. Leaving the first row of an edited line enters it first (LEAVE_FIRST_ROW); a report stops\n   the move.\n2. CURSOR_LINE_EPPC pushed: on the way out E_PPC follows the cursor's line.\n3. A row C with no text is removed (REMOVE_EMPTY_ROW).\n4. With C below the top limit ($D748), C - 1. Otherwise the rows scroll down\n   (ROWS_SCROLL_DOWN) and C stays; with nothing above, C - 1 unless C is 0.\nExit: carry when moved.","comment":"Leaving the line's first row: entered"},
        "1719": {"comment":"A report: no move"},
        "1720": {"comment":"CURSOR_LINE_EPPC as the way out"},
        "1724": {"comment":"The cursor kept"},
        "1725": {"comment":"DE = row C"},
        "1728": {"comment":"From column 0"},
        "1730": {"comment":"No text: the row removed"},
        "1736": {"comment":"The cursor back"},
        "1737": {"comment":"HL = the top limit"},
        "1740": {"comment":"A = it"},
        "1741": {"comment":"Row C below it?"},
        "1744": {"comment":"The cursor kept"},
        "1745": {"comment":"The rows scrolled down"},
        "1748": {"comment":"The cursor back"},
        "1749": {"comment":"Scrolled: done"},
        "1750": {"comment":"Row 0?"},
        "1752": {"comment":"Then no move"},
        "1753": {"synopsis":"C one row up; carry.","comment":"Up one"},
        "1754": {"comment":"Carry"},
        "1755": {"synopsis":"Done."},
        "1756": {"synopsis":"Moves the cursor's row C down one: a row C with no text is removed instead\n(REMOVE_EMPTY_ROW), the rows below moving up, then CURSOR_LINE_EPPC. Otherwise\nLEAVE_LAST_ROW, and CURSOR_LINE_EPPC pushed as the way out; with C above the bottom limit\n($D749), C + 1. Otherwise the rows scroll up (ROWS_SCROLL_UP) and C stays; when that cannot\nbe\ndone, C + 1 unless C is the window's last row ($D74A).\nExit: carry when moved.","comment":"The cursor kept"},
        "1757": {"comment":"DE = row C"},
        "1760": {"comment":"From column 0"},
        "1762": {"comment":"Any text?"},
        "1765": {"comment":"The cursor back"},
        "1766": {"comment":"Text: on"},
        "1768": {"comment":"No text: the row removed instead"},
        "1771": {"comment":"Then E_PPC from the cursor's line"},
        "1774": {"synopsis":"Leaving the last row of an edited line enters it first; then CURSOR_LINE_EPPC is pushed as\nthe way out, and C goes below $D749, or the rows are scrolled up.","comment":"Leaving the line's last row: entered"},
        "1777": {"comment":"A report: no move"},
        "1778": {"comment":"CURSOR_LINE_EPPC as the way out"},
        "1782": {"comment":"HL = the limits"},
        "1785": {"comment":"The bottom limit"},
        "1786": {"comment":"Row C above it?"},
        "1788": {"comment":"Then down one"},
        "1790": {"comment":"The cursor kept"},
        "1792": {"comment":"The rows scrolled up"},
        "1796": {"comment":"The cursor back"},
        "1797": {"comment":"Scrolled: done"},
        "1798": {"comment":"HL = the window's last row"},
        "1799": {"comment":"A = it"},
        "1800": {"comment":"Row C the last?"},
        "1801": {"comment":"Then no move"},
        "1802": {"synopsis":"C one row down; carry.","comment":"Down one"},
        "1803": {"comment":"Carry"},
        "1804": {"synopsis":"Done."},
        "1805": {"synopsis":"Moves the cursor (row C, column B) one place left within the text: to the column before\n(TEXT_END_LEFT), or up a row (ROW_UP) to the end of its text.\nEntry: A = the remembered column.\nExit: carry when it moved, A = the new column; otherwise no carry.","comment":"D = the remembered column"},
        "1806": {"comment":"One column left"},
        "1807": {"comment":"Was it 0?"},
        "1810": {"comment":"E = the new column"},
        "1811": {"comment":"Placed in the row's text"},
        "1814": {"comment":"A = it"},
        "1815": {"comment":"Done"},
        "1816": {"synopsis":"Nothing to the left on this row: up a row, to the end of its text."},
        "1817": {"comment":"Up a row"},
        "1821": {"comment":"A = the column"},
        "1822": {"comment":"Not moved"},
        "1823": {"comment":"A = the width"},
        "1826": {"comment":"B = the last column"},
        "1828": {"comment":"Back to the end of its text"},
        "1831": {"comment":"A = the column"},
        "1832": {"comment":"Done"},
        "1833": {"comment":"A = the remembered column"},
        "1834": {"comment":"Column 0"},
        "1837": {"synopsis":"Moves the cursor (row C, column B) one place right within the text (TEXT_AT_OR_RIGHT). Past\nthe row's end:\n1. While rows may be added ($D5B7 bit 7 clear) and the row does not continue (flags bit 1),\n   it is marked as continued (bit 1 set, bit 3 cleared) and gone through ($122F); the cursor\n   goes down (ROW_DOWN) and a blank row is inserted there (INSERT_ROW, flags bit 3 set) with\n   its first ($D7DC) columns cleared ($1092).\n2. Otherwise down a row (ROW_DOWN) to the start of its text.\nExit: carry when it moved, A = the column.","comment":"D = the remembered column"},
        "1838": {"comment":"One column right"},
        "1839": {"comment":"A = the width"},
        "1842": {"comment":"A = the last column"},
        "1843": {"comment":"Past it?"},
        "1846": {"comment":"E = the new column"},
        "1847": {"comment":"At or right of it in the text?"},
        "1850": {"comment":"A = it"},
        "1851": {"comment":"Done"},
        "1852": {"synopsis":"Past the row's end.","comment":"The last column"},
        "1855": {"comment":"HL = $D5B7"},
        "1858": {"comment":"May rows be added?"},
        "1860": {"comment":"No: down a row"},
        "1862": {"comment":"DE = row C"},
        "1865": {"comment":"HL = the width"},
        "1868": {"comment":"HL = the flags byte"},
        "1869": {"comment":"A = the flags"},
        "1870": {"comment":"Already continued?"},
        "1874": {"comment":"Continued now"},
        "1876": {"comment":"No longer the line's last row"},
        "1878": {"comment":"HL = the row"},
        "1879": {"comment":"Redrawn"},
        "1884": {"comment":"The flags kept"},
        "1885": {"comment":"One row down"},
        "1888": {"comment":"The flags back"},
        "1889": {"comment":"DE = the new row C"},
        "1892": {"comment":"Kept"},
        "1893": {"comment":"HL = the row size"},
        "1896": {"comment":"HL = the next row"},
        "1897": {"comment":"DE = it"},
        "1898": {"comment":"The flags less bits 0 and 1"},
        "1900": {"comment":"The line's last row"},
        "1902": {"comment":"A blank row inserted at row C"},
        "1905": {"comment":"DE = row C"},
        "1906": {"comment":"Its first ($D7DC) columns cleared"},
        "1909": {"comment":"A = the column"},
        "1910": {"comment":"Carry"},
        "1912": {"synopsis":"Down a row, to the start of its text; no carry (A = E, B = 0) when it has none."},
        "1915": {"comment":"One row down"},
        "1919": {"comment":"A = the column"},
        "1920": {"comment":"Not moved"},
