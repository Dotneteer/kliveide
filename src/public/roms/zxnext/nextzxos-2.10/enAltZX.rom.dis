        "463": {"comment":"No places left"},
        "469": {"comment":"The search ends"},
        "472": {"synopsis":"No text left on a row that continues: the cursor stored here for now; the search goes on in\nthe next row."},
        "474": {"comment":"The cursor here for now"},
        "477": {"synopsis":"One place on: the count less one, B + 1."},
        "479": {"comment":"One place less"},
        "480": {"comment":"One column on"},
        "481": {"comment":"The count stored"},
        "484": {"comment":"Again"},
        "486": {"synopsis":"No places left: B placed in the row's text (TEXT_FROM_COL, else TEXT_BACK_FROM); the search\nends ($D741 = 0).","comment":"Column B in the row's text?"},
        "489": {"comment":"Otherwise back to just after it"},
        "492": {"comment":"The search ended"},
        "497": {"synopsis":"The cursor stored at this row, column B, remembered column B (CURSOR_STORE).","comment":"A = the column"},
        "498": {"comment":"B = the row's number"},
        "500": {"comment":"C = the row"},
        "501": {"comment":"B = the column"},
        "502": {"comment":"The cursor stored, column remembered"},
        "505": {"synopsis":"The next row, up to ($D73C).","comment":"The row numbers back"},
