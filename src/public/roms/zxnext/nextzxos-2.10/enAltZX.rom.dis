        "2647": {"comment":"Column 0?"},
        "2649": {"comment":"Then no carry: no text"},
        "2650": {"comment":"One column left"},
        "2654": {"synopsis":"Just after the character; carry.","comment":"Just after the character"},
        "2655": {"comment":"Carry"},
        "2657": {"synopsis":"HL = the address of column B in the row at DE, A = the character there.","comment":"HL = column B's address"},
        "2661": {"comment":"A = the character there"},
        "2663": {"synopsis":"Inserts character A at the cursor (row C, column B), the rest of the line moving right\nacross its rows; nothing when the rows are full ($D5B7 bit 0). A character pushed off a row\ngoes into the next row of the line, or into a new row inserted after it (INSERT_ROW, the row\nmarked as continued); off the window's last row it goes into the rows below (BELOW_CARRY).\nEach changed row redrawn ($11EF, $1092).\nExit: carry when done. Keeps BC.","comment":"HL = $D5B7"},
        "2666": {"comment":"Carry cleared"},
        "2667": {"comment":"The rows full?"},
