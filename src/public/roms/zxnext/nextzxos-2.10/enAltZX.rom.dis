        "3343": {"comment":"Then again"},
        "3345": {"comment":"HL = the line"},
        "3346": {"comment":"Stored"},
        "3349": {"synopsis":"BC = the line; its rows made from $C73B ($0EEA).","comment":"BC = the line"},
        "3351": {"comment":"HL = the count's place"},
        "3352": {"comment":"The line made into rows"},
        "3355": {"comment":"The first given, the rest kept"},
        "3356": {"comment":"Stored"},
        "3358": {"synopsis":"Rows kept: shifted up one.","comment":"HL = $D5B7"},
        "3361": {"comment":"The rows not full any more"},
        "3363": {"comment":"DE = the row size"},
        "3367": {"comment":"The buffer's size"},
        "3370": {"comment":"Carry cleared"},
        "3371": {"comment":"Less one row"},
        "3373": {"comment":"BC = the bytes to move"},
        "3375": {"comment":"HL = the row size"},
        "3376": {"comment":"DE = the buffer"},
        "3379": {"comment":"HL = its row 1"},
        "3380": {"comment":"The rows moved up one"},
        "3382": {"comment":"One row less"},
        "3383": {"comment":"Carry"},
        "3384": {"synopsis":"The count stored; HL = $C73B.","comment":"DE = the count's place"},
        "3385": {"comment":"The count stored"},
        "3386": {"comment":"HL = the row given"},
        "3392": {"synopsis":"Puts the editor row at DE (($D73D) characters, a flags byte, the line number high byte\nfirst) in front of the rows kept below the window.\n1. A line's first row with flags bit 4 also sets $D74C to the line before its number ($194C,\n   $1482), when there is one.\n2. A line's first row (bit 0) is not kept: the buffer is emptied ($C738 = 0), carry.\n3. Otherwise, with room for one more ($0F74), the row goes in as row 1 (copied to row 0,\n   then all rows moved down one) and the count goes up; carry. No room: no carry.\nExit: A = the count. Keeps BC, DE."},
        "3394": {"comment":"HL = the width"},
        "3397": {"comment":"HL = the flags byte"},
        "3398": {"comment":"A = the flags"},
        "3399": {"comment":"Bits 0 and 4 both set?"},
