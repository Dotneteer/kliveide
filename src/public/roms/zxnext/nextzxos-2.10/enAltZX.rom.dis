        "712": {"comment":"Done"},
        "715": {"synopsis":"No room below: no carry."},
        "718": {"synopsis":"Puts character A in column B of the row at DE, moving columns B to the last ($D73D - 1) one\nto the right.\nExit: A = E = the character pushed off the end; Z when it was 0. Keeps DE."},
        "719": {"comment":"HL = column B's address"},
        "723": {"comment":"D = the character carried in"},
        "724": {"comment":"A = the column"},
        "725": {"synopsis":"One column: its character swapped with the one carried, up to the last column.","comment":"E = the character there"},
        "726": {"comment":"The carried one in its place"},
