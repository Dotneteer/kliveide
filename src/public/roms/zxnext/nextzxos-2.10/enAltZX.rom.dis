        "3228": {"synopsis":"Key $10: deletes at the cursor (LINE_DELETE_CHAR) until a 0 is at the cursor: the rest of\nthe line. Then DEL_KEY_END.","comment":"The cursor off; HL = $D748"},
        "3231": {"synopsis":"A character at the cursor?","comment":"A = the character at the cursor"},
