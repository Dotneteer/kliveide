        "5776": {"comment":"The last?"},
        "5781": {"comment":"The buffer emptied"},
        "5793": {"comment":"$FF: memory"},
        "5797": {"comment":"1: the banked buffer"},
        "5800": {"comment":"0: the editor's rows (ROWS_READ_CHAR, $08AE)"},
        "5803": {"synopsis":"B = the character; its class."},
        "5804": {"comment":"Class 1 for a start"},
        "5806": {"comment":"Below 'A'?"},
        "5810": {"comment":"Lower case for the test"},
        "5812": {"comment":"Not a letter: 1"},
        "5815": {"comment":"Not a letter: 1"},
        "5818": {"comment":"A letter"},
