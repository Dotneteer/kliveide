        "7476": {"comment":"An ENTER?"},
        "7478": {"comment":"Yes: back again"},
        "7480": {"comment":"The place kept"},
        "7486": {"comment":"DE and HL back"},
        "7489": {"synopsis":"The string's place moved past spaces and ENTERs.\nExit: carry at the string's end; A = the character. Keeps BC, DE, HL.","comment":"HL, DE and BC kept"},
        "7492": {"comment":"HL = the string's place"},
