        "426": {"comment":"The cursor on this row?"},
        "433": {"comment":"Column 0"},
        "435": {"synopsis":"The cursor ($D5B5) places on: while places are left and the row has text at or after column\nB (TEXT_FROM_COL).","comment":"HL = the places still to go"},
        "438": {"comment":"None?"},
        "442": {"comment":"Kept"},
        "443": {"comment":"Text at or after column B?"},
        "447": {"comment":"The carry kept"},
