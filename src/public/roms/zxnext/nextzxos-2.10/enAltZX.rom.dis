        "596": {"comment":"The cursor stored"},
        "599": {"synopsis":"Scrolls the editing rows up by one: row 0 goes to the rows above the window ($0E95; when\nthere is no room there, nothing is done), then ROWS_UP_FROM from row 0 with the next row\nfrom below (ROW_FROM_BELOW).\nExit: carry when done.","comment":"Row 0"},
        "602": {"comment":"C = 0"},
        "603": {"comment":"DE = row 0"},
        "606": {"comment":"Row 0 above the window"},
        "610": {"comment":"No room: no carry"},
        "611": {"comment":"HL = the next row from below"},
        "614": {"synopsis":"Rows B+1 to ($D73C) moved up by one into rows B to ($D73C) - 1, the screen scrolled the same\nway ($10A2), and the row at HL copied into the last row.\nEntry: B = the row, DE = its address, HL = the new row.\nExit: carry. Keeps BC."},
        "615": {"comment":"The new row kept"},
        "616": {"comment":"HL = the row after row B"},
        "620": {"comment":"A = the last row"},
