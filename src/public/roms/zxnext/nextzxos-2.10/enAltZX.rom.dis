        "2384": {"comment":"The state's routine"},
        "2387": {"comment":"E = the new state"},
        "2389": {"comment":"A character?"},
        "2392": {"comment":"No: the line's end, $0D"},
        "2394": {"comment":"Stored"},
        "2396": {"synopsis":"Codes below $20: 1-5 become $20-$24 ($22 becomes $52), 6-$1F become $41-$5A.","comment":"A control code?"},
        "2400": {"comment":"Moved up"},
        "2402": {"comment":"6 or more?"},
