        "556": {"synopsis":"Draws editing rows B to C on the screen, each through $11EF. With NZ on entry the cursor is\nthen moved on ($D5B5) places (ROWS_DRAW_MOVE).\nEntry: B, C = the first and last row; Z or NZ.","comment":"The Z flag kept"},
        "557": {"comment":"A = the last row"},
        "558": {"comment":"C = the first"},
        "559": {"comment":"DE = its place"},
        "562": {"comment":"HL = the row"},
        "563": {"synopsis":"One row drawn ($11EF); the next, up to A.","comment":"The last row kept"},
