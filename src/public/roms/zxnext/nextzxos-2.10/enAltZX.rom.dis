        "2924": {"synopsis":"A = 0; BC back.","comment":"A = 0"},
        "2927": {"synopsis":"Redraws the cursor's line from row C to its last row (flags bit 3, the flags coming back\nfrom $11EF), each later row's flags getting B added (NEXT_ROW_FLAGS); past the window's last\nrow the line's rows below the window are gone through ($122F) up to its last row. Keeps BC."},
        "2928": {"comment":"DE = row C"},
        "2931": {"comment":"HL = the row"},
        "2932": {"synopsis":"One window row drawn; the line's last row?","comment":"Drawn; A = its flags"},
        "2935": {"comment":"The line's last row?"},
        "2939": {"comment":"The next row"},
        "2940": {"comment":"A = the window's last row"},
        "2943": {"comment":"Past it?"},
        "2946": {"comment":"The next row, B added to its flags"},
        "2949": {"comment":"Again"},
        "2951": {"synopsis":"Past the window: the rows below from $C73B.","comment":"HL = the rows below the window"},
        "2954": {"synopsis":"One row below ($122F); the line's last row?","comment":"The next row, B added to its flags"},
        "2957": {"comment":"Gone through; A = its flags"},
        "2960": {"comment":"The line's last row?"},
        "2964": {"comment":"Again"},
        "2966": {"synopsis":"BC back."},
        "2968": {"synopsis":"DE = HL + ($D73F), the next row; then ROW_FLAGS_B on it.","comment":"DE = the row size"},
