        "646": {"comment":"BC = the row size"},
        "650": {"comment":"The new row into the last row"},
        "652": {"comment":"Done"},
        "655": {"synopsis":"Scrolls the editing rows down by one: the last row above the window comes back ($0E52; when\nthere is none, nothing is done), then ROWS_DOWN_FROM from row 0.\nExit: carry when done.","comment":"Row 0"},
        "657": {"comment":"HL = the last row above the window"},
