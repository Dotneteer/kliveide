        "3084": {"comment":"None: done"},
        "3086": {"comment":"A = the character there"},
        "3089": {"comment":"A space?"},
        "3094": {"comment":"Deleted"},
        "3098": {"comment":"On"},
        "3100": {"synopsis":"The space before the word: back right past it."},
        "3101": {"comment":"Back right past the space"},
        "3104": {"synopsis":"HL back."},
        "3105": {"synopsis":"The end of a deleting key: the line's rows redrawn (ROWS_REDRAW_LINE), $D741 bit 2 cleared\nand the window's rows 0 to ($D73C) redrawn (ROWS_DRAW), $D5B7 bit 3 set, the cursor stored\n(CURSOR_PUT).\nExit: the carry given on entry.","comment":"A = the column"},
        "3106": {"comment":"Kept with the carry"},
        "3108": {"comment":"The line's rows redrawn"},
        "3111": {"comment":"HL = $D741"},
        "3114": {"comment":"Drawing allowed again"},
        "3116": {"comment":"A = the window's last row"},
        "3119": {"comment":"The cursor kept"},
        "3120": {"comment":"From row 0"},
        "3122": {"comment":"To the last"},
        "3123": {"comment":"Z: no cursor move"},
        "3124": {"comment":"The window redrawn"},
        "3127": {"comment":"The cursor back"},
        "3128": {"comment":"HL = $D5B7"},
        "3131": {"comment":"The line changed"},
        "3134": {"comment":"A = the column"},
        "3135": {"comment":"The cursor stored"},
        "3138": {"comment":"A and the carry back"},
        "3140": {"synopsis":"Key $1C: deletes at the cursor (LINE_DELETE_CHAR) up to and including the next space, then\nthe spaces after it. Then DEL_KEY_END.","comment":"The cursor off; HL = $D748"},
        "3143": {"synopsis":"A character at the cursor? Deleted; on to the first space."},
        "3144": {"comment":"A = the character at the cursor"},
        "3148": {"comment":"None?"},
        "3149": {"comment":"Carry"},
