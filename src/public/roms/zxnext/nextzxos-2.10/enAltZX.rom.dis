        "7647": {"comment":"More?"},
        "7649": {"comment":"One unit less"},
        "7652": {"comment":"More units?"},
        "7655": {"synopsis":"The shortest current length among the strings that have not ended, into IY + 38.","comment":"DE = the shortest so far: $FFFF"},
        "7658": {"comment":"The list of length pointers; string 0's bit"},
        "7661": {"synopsis":"The next string.","comment":"Has this string ended?"},
        "7664": {"comment":"Yes: the next"},
        "7666": {"comment":"DE kept"},
        "7667": {"comment":"DE = the string's pointer to its length"},
        "7670": {"comment":"HL = it"},
        "7671": {"comment":"DE = the length"},
