        "3172": {"comment":"Deleted"},
        "3176": {"comment":"On"},
        "3178": {"synopsis":"Key $03: deletes everything before the cursor back to the start of its line: on the line's\nlater rows, back a place and delete, up to its first row; there the characters before the\ncursor, back to the text's start. Then DEL_KEY_END.","comment":"The cursor off; HL = $D748"},
        "3181": {"synopsis":"The line's first row?"},
        "3182": {"comment":"DE = row C"},
        "3185": {"comment":"HL = the width"},
        "3188": {"comment":"HL = the flags byte"},
        "3189": {"comment":"The line's first row?"},
