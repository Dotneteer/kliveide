        "6051": {"comment":"Unless the state byte is 4"},
        "6054": {"comment":"A = 4: state 4"},
        "6057": {"comment":"Not 4: a dot command"},
        "6059": {"synopsis":"Written (TOK_SPACING); carry."},
        "6065": {"synopsis":"REM: $D7F2 bit 4."},
        "6067": {"comment":"Written"},
        "6069": {"synopsis":"';': state 8."},
        "6089": {"comment":"A space?"},
        "6091": {"comment":"Not a space"},
        "6093": {"comment":"After a keyword: dropped"},
        "6095": {"comment":"Bit 0 cleared; dropped"},
        "6097": {"comment":"One held: this one written"},
        "6099": {"comment":"Bit 1: this one written"},
        "6101": {"comment":"Something written: held"},
        "6103": {"comment":"Bit 3: hold it"},
        "6105": {"comment":"At the line's start: bit 3 only"},
        "6106": {"comment":"The space dropped"},
        "6110": {"synopsis":"Bit 1: a space held."},
        "6111": {"comment":"Held"},
        "6117": {"synopsis":"E written (TOK_WRITE).","comment":"A = the character"},
        "6120": {"synopsis":"Bit 0 cleared."},
        "6121": {"comment":"Bit 0 cleared"},
        "6123": {"comment":"Stored"},
        "6125": {"synopsis":"Not a space: a digit?","comment":"A digit?"},
        "6131": {"comment":"Yes: the flags as they are"},
        "6133": {"synopsis":"Not a digit: bits 2 and 3 set."},
        "6135": {"comment":"Something written"},
        "6137": {"synopsis":"A keyword ($81 up)?","comment":"A keyword?"},
        "6139": {"comment":"Yes"},
        "6141": {"synopsis":"A held space written first, then the character; bits 0 and 1 cleared.","comment":"A space held?"},
        "6144": {"comment":"Written first"},
        "6150": {"comment":"None held now"},
        "6152": {"comment":"Bit 0 cleared"},
        "6155": {"comment":"Then the character"},
        "6161": {"comment":"Quotes, a dot command or a comment?"},
        "6163": {"comment":"Yes: as text"},
        "6165": {"comment":"After REM?"},
        "6170": {"comment":"Then the state a comment"},
        "6172": {"synopsis":"A held space dropped, bit 0 set; written."},
        "6174": {"comment":"A keyword the last"},
        "6189": {"comment":"Mode 0: written"},
        "6191": {"comment":"DE = the place"},
        "6192": {"comment":"X_PTR reached?"},
        "6197": {"comment":"No"},
        "6218": {"synopsis":"Mode 1: past the byte, with bank 0; past a hidden number's six bytes.","comment":"Bank 0"},
        "6219": {"comment":"Past the byte"},
        "6221": {"comment":"A hidden number?"},
        "6225": {"comment":"Its marker and five bytes"},
        "6231": {"synopsis":"Mode 0: room for one byte at HL, then A stored there.","comment":"Bank 0"},
        "6232": {"comment":"The character kept"},
        "6233": {"comment":"ROM 3's MAKE_ROOM_ONE"},
        "6236": {"comment":"A = it"},
        "6237": {"comment":"Stored in the new byte"},
        "6238": {"comment":"The next place"},
        "6239": {"synopsis":"Bank 7; $D7EA = the next place.","comment":"Bank 7"},
        "6268": {"comment":"Not found: no carry"},
        "6269": {"comment":"$F4 up: another spelling"},
        "6271": {"comment":"$D0-$F3: a token"},
        "6273": {"comment":"BC = its number from $F4"},
        "6276": {"comment":"Its last character"},
        "6278": {"comment":"Its token from ALIAS_TOKENS"},
        "6281": {"comment":"HL = its token"},
        "6282": {"comment":"Ending in '$'?"},
        "6284": {"comment":"A = the token"},
        "6285": {"comment":"No '$'"},
        "6287": {"comment":"The token written; then '$'"},
        "6290": {"comment":"Then '$'"},
        "6292": {"synopsis":"Carry: found."},
        "6294": {"synopsis":"$D0-$F3: tokens $81-$A4.","comment":"A = the token"},
        "6298": {"synopsis":"Tokenises BC characters at DE (read with bank 0, TOK_GET_MEM) into a line at E_LINE\n(TOKENIZE_GO with A = $FF, mode 0).\nExit: BC = ($D7EA), the place written, less STKBOT - 1 as it was on entry; bank 0. No\nreference to it was found in this page or in NextZXOS (page 1 has its own $17CF).","comment":"STKBOT - 1 kept"},
        "6301": {"comment":"STKBOT - 1"},
        "6303": {"comment":"HL = the text"},
        "6304": {"comment":"Bank 7"},
        "6322": {"comment":"Bank 0"},
        "6323": {"comment":"DE = STKBOT - 1"},
        "6325": {"comment":"BC = the end less it"},
        "6330": {"synopsis":"IDE_TOKENISER with B = 0: the work space cleared (ROM 3's CLEAR_WS), an ENTER put at E_LINE\n(ROM 3's MAKE_ROOM_ONE), the text in the banked buffer tokenised before it (TOKENIZE_RUN,\nmode 0), then NextZXOS ROM 1's code at $0A05 (inside LINE_ENTER) run with HL = $09FB and the\nDivMMC memory's byte at $32FF set to 0 round it (DMMC_BYTE_SWAP). With no report (ERR_NR bit\n7 set) and at most $04FB characters: HL = E_LINE, BC = the line's length (TOKAPI_LENGTH),\nNZ. Otherwise the text is walked again to X_PTR, the report's place (mode 1): Z, DE = the\ncount returned less 1.\nExit: carry; bank 0.","comment":"The buffer's address kept"},
        "6331": {"comment":"ROM 3's CLEAR_WS"},
        "6334": {"comment":"The workspace's HL kept, below it"},
        "6336": {"comment":"An ENTER at E_LINE"},
        "6339": {"comment":"ROM 3's MAKE_ROOM_ONE"},
        "6342": {"comment":"ENTER"},
        "6345": {"comment":"Mode 0: written"},
        "6350": {"comment":"HL = the buffer's address"},
        "6351": {"comment":"Bank 7"},
        "6355": {"comment":"The DivMMC byte $32FF = 0, B = it"},
        "6364": {"comment":"ROM 1's $0A05"},
        "6376": {"comment":"Bank 0"},
        "6377": {"comment":"DE = the workspace's HL kept"},
        "6378": {"comment":"ERR_NR bit 7: no report?"},
        "6382": {"comment":"No report"},
        "6384": {"comment":"DE kept"},
        "6385": {"comment":"Mode 1: to the report's place"},
        "6387": {"comment":"TOKENIZE_RUN in mode 1"},
        "6390": {"comment":"DE back"},
        "6391": {"synopsis":"Z: DE = the characters before the error; the work space cleared.","comment":"The count less 1"},
        "6396": {"comment":"DE = the count less 1"},
        "6397": {"comment":"Z"},
        "6400": {"synopsis":"No report: more than $04FB characters is an error too.","comment":"The limit"},
        "6404": {"comment":"More characters than that?"},
        "6406": {"comment":"Yes: an error"},
        "6408": {"synopsis":"ROM 3's CLEAR_WS; BC = its HL now less DE (its HL at the start, kept on the stack), the\nline's length; HL = E_LINE; carry."},
        "6411": {"comment":"BC = the length"},
        "6416": {"comment":"HL = E_LINE"},
        "6421": {"synopsis":"TOKENIZE with A = 1 (the banked buffer, its work space cleared by CLEAR_WS) and mode D, bank\n7 round it; bank 0 on exit.","comment":"The banked buffer"},
        "6423": {"comment":"Bank 7"},
        "6427": {"comment":"Bank 0"},
        "6429": {"synopsis":"Swaps A with the DivMMC memory's byte at $32FF: DMMC_SWAP_CODE copied to $D7B0 and run there\n(DivMMC memory paged in by port $E3 = $80 while it reads and writes).\nExit: B = the old byte, A = 0. From NextZXOS ROM 1's ERROR_128_OWN ($0DBA) too.\nChanges: BC, DE, HL."},
        "6435": {"comment":"Run there on the RET"},
        "6441": {"comment":"The byte's address in that memory"},
        "6444": {"comment":"C = the new byte"},
        "6445": {"comment":"A = $80 for port $E3"},
        "6447": {"comment":"DMMC_SWAP_CODE at $D7B0"},
        "6448": {"synopsis":"Run at $D7B0 (DMMC_BYTE_SWAP): port $E3 = A ($80, the DivMMC memory paged in), B = (HL),\n(HL) = C, port $E3 = 0.","comment":"The DivMMC memory paged in"},
        "6450": {"comment":"B = the old byte"},
        "6451": {"comment":"The new one written"},
        "6452": {"comment":"Paged out"},
        "6462": {"comment":"In MMU 1"},
        "6467": {"comment":"The ROM back"},
        "6491": {"comment":"101 bytes"},
        "6497": {"synopsis":"Run at $D772: puts the text of the A-th string of the table at DE (each ended by bit 7) in\nthe buffer at $D767 for EXPAND_NEXT ($D765 = $D767): a space first when the word starts with\na letter and $D761 bit 0 is clear, then the string, then a space ($A0, the last) unless it\nends with '<', '=' or '>' (bit 7 then on its last character). $D761 = 0.\nExit: HL past the buffer's text.","comment":"B = the strings to pass over"},
        "6498": {"comment":"None?"},
        "6499": {"synopsis":"Any more to pass over?"},
        "6501": {"synopsis":"Up to the end of this string (bit 7)."},
        "6502": {"comment":"Up to the one with bit 7"},
        "6507": {"comment":"One fewer"},
        "6523": {"comment":"No space first"},
        "6525": {"comment":"A letter first?"},
        "6530": {"comment":"A space first"},
        "6534": {"synopsis":"One character, up to the one with bit 7.","comment":"A character"},
        "6536": {"comment":"Copied"},
        "6539": {"comment":"The last?"},
        "6543": {"comment":"The last character"},
        "6546": {"comment":"'<', '=' or '>'?"},
        "6552": {"comment":"Yes: no space after"},
        "6553": {"synopsis":"Its last character without bit 7, then $A0.","comment":"Its bit 7 off"},
        "6556": {"comment":"Then a space with bit 7"},
        "6562": {"synopsis":"The word's next character, a letter as a capital.","comment":"The word's character"},
        "6565": {"comment":"Lower case?"},
        "6570": {"comment":"As a capital"},
        "6572": {"synopsis":"The same as the string's?","comment":"The same as the string's?"},
        "6573": {"comment":"No"},
        "6575": {"comment":"Both moved on"},
        "6577": {"comment":"The word's last?"},
        "6581": {"comment":"Matched: carry"},
        "6584": {"synopsis":"No match: the next string's code; past $FF, none found.","comment":"The next code"},
        "6585": {"comment":"Past $FF: none"},
        "6587": {"synopsis":"Past the end of this string.","comment":"To the end of this string"},
        "6593": {"comment":"Compared again"},
        "6595": {"synopsis":"None found: no carry.","comment":"No carry"},
        "6596": {"synopsis":"A = B.","comment":"A = the code"},
        "6598": {"synopsis":"NextBASIC's own keywords, each ended by bit 7: tokens $81-$A4, TIME, PRIVATE, IF, ENDIF,\nEXIT, REF, PEEK$, REG, DPOKE, DPEEK, MOD, <<, >>, UNTIL, ERROR, ON, DEFPROC, ENDPROC, PROC,\nLOCAL, DRIVER, WHILE, REPEAT, ELSE, REMOUNT, BANK, TILE, LAYER, PALETTE, SPRITE, PWD, CD,\nMKDIR, RMDIR, SPECTRUM, PLAY; then 12 other spellings for ALIAS_TOKENS: LS, DIR, GOTO,\nGOSUB, DEFFN, OPEN#, CLOSE#, RAND, CONT, ERROR$, TIME$, USR$. Read by EXPAND_NEXT (through\nKEYWORD_TEXT, code - $81) and KEYWORD_LOOKUP (WORD_FIND, B = $D0 for the first)."},
        "6817": {"synopsis":"The tokens of NEXT_KEYWORDS' last 12 words, read by KEYWORD_LOOKUP: LS and DIR $CF (CAT),\nGOTO $EC, GOSUB $ED, DEFFN $CE, OPEN# $D3, CLOSE# $D4, RAND $F9, CONT $E8, ERROR$ $8F, TIME$\n$81 and USR$ $C0 (the last three followed by '$')."},
        "6829": {"synopsis":"Prints program lines through RST $28, from the line at HL in bank ($5B65) on (NextZXOS ROM\n1's LIST_FIND, $3612): for each, BREAK tested (NextZXOS ROM 1's BREAK_STOP), the line copied\nto $5CB6 (ROM 1's BANK_LINE_COPY), its number and text expanded (LINE_START_NUM,\nEXPAND_NEXT) and printed, a 0 as a space. Ends at a line number from $2800 up (the program's\nend).\nExit: bank 7.","comment":"The line's address kept"},
        "6830": {"comment":"Bank 7"},
        "6831": {"comment":"The expansion reset"},
        "6834": {"synopsis":"One line: BREAK, then a copy of it at $5CB6.","comment":"Bank 0"},
        "6835": {"comment":"ROM 1's BREAK_STOP"},
        "6838": {"comment":"The program's bank"},
        "6841": {"comment":"HL = the line"},
        "6843": {"comment":"ROM 1's BANK_LINE_COPY: HL = $5CB6"},
        "6846": {"comment":"Past the program's end?"},
        "6847": {"comment":"A number from $2800 up?"},
        "6849": {"comment":"DE = the line's address"},
        "6850": {"comment":"Yes: done"},
        "6851": {"comment":"Kept"},
        "6852": {"comment":"DE = its number"},
        "6856": {"comment":"BC = its length"},
        "6859": {"comment":"The next line's address kept"},
        "6860": {"comment":"Past its header and text"},
        "6865": {"comment":"The next line kept"},
        "6866": {"comment":"Bank 7"},
        "6867": {"comment":"HL = the copy + 1"},
        "6869": {"comment":"Its number as text first"},
        "6872": {"synopsis":"The next character; none left: the next line."},
        "6875": {"comment":"None left: the next line"},
        "6877": {"comment":"Bank 0 while printing"},
        "6878": {"comment":"0?"},
        "6881": {"comment":"A space"},
        "6883": {"synopsis":"Printed (RST $28); bank 7; the next."},
        "6884": {"comment":"Bank 7"},
        "6885": {"comment":"The next"},
        "6887": {"synopsis":"Counts the characters the line at HL expands to (its number and text; LINE_START_NUM, then\nEXPAND_NEXT until none is left). From NextZXOS ROM 1's ALT_1A1C_STUB ($03FA).\nExit: HL = the count; bank 0.","comment":"The line's address kept"},
        "6888": {"comment":"Bank 7"},
        "6892": {"comment":"Bank 0"},
        "6894": {"comment":"DE = its number"},
        "6897": {"comment":"Bank 7"},
        "6901": {"comment":"The count, one short"},
        "6904": {"synopsis":"One character counted."},
        "6909": {"comment":"One more"},
        "6910": {"comment":"While characters come"},
        "6912": {"comment":"Bank 0"}
      }
