        "5656": {"comment":"Not a keyword"},
        "5658": {"comment":"The token written"},
        "5661": {"comment":"The buffer emptied"},
        "5664": {"comment":"The character again"},
        "5667": {"synopsis":"Not a keyword: split at a space (TOK_SPLIT) and the rest looked up again; a space goes into\nthe buffer."},
        "5671": {"comment":"No space in the word"},
        "5676": {"comment":"Still a word?"},
        "5679": {"comment":"State 0: the character again"},
        "5681": {"synopsis":"A space?","comment":"A space?"},
        "5683": {"comment":"Anything else"},
        "5685": {"comment":"The space into the buffer"},
