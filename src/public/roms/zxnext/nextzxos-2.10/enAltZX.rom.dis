        "2631": {"comment":"Carry when not"},
        "2632": {"comment":"Then on"},
        "2635": {"synopsis":"Carry when column B of the row at DE holds a character; otherwise B moves left over 0s to\njust after the last character (carry), or to 0 with no carry when the row is empty.\nExit: HL = the column's address.","comment":"HL = column B's address"},
        "2639": {"comment":"A = the character"},
        "2640": {"comment":"A character?"},
        "2641": {"comment":"Carry"},
