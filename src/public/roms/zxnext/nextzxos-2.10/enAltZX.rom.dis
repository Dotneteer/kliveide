        "765": {"synopsis":"Column B's character in A; Z when it was 0.","comment":"A = column B's character"},
        "766": {"comment":"Zero?"},
        "767": {"comment":"HL = the flags byte"},
        "774": {"comment":"Then FLAGS bit 5 set"},
        "778": {"synopsis":"Same mode as before?","comment":"HL = the mode now"},
