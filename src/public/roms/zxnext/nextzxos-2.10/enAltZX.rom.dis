        "6978": {"synopsis":"H: all the strings ended at once ($5CAE = $FFFF).","comment":"$5CAE = $FFFF: every string ended"},
        "6985": {"synopsis":"L: the string's chip heard on the left only: bits 6-5 of its chip-select byte = 10, kept and\nsent to port $FFFD.","comment":"A = the chip-select byte, HL at it, BC = $FFFD"},
