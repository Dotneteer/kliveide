        "2310": {"synopsis":"Finds the first row of the line that row C belongs to: up from row C to a row with flags\nbit 0 set (FIND_FIRST_ROW); above row 0, the first row of the stack above the window, at\n$CE76.\nEntry: C = the row.\nExit: A = the reader's state for it (2 a window row, 1 the stack above), C = the row (0 for\nthe\nstack's), DE = the row, HL = its flags byte; NZ when found in the window.","comment":"State 2: the window's rows"},
        "2312": {"synopsis":"The line's first row?","comment":"DE = row C"},
        "2315": {"comment":"HL = the width"},
        "2318": {"comment":"HL = the flags byte"},
