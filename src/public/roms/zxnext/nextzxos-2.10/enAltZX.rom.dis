        "2416": {"comment":"The column stored"},
        "2418": {"comment":"The character kept"},
        "2419": {"comment":"A = the state byte"},
        "2420": {"comment":"Bits 4-7 kept"},
        "2422": {"comment":"The new state in bits 0-3"},
        "2423": {"comment":"Stored"},
        "2424": {"comment":"The character back"},
        "2426": {"synopsis":"ROWS_READ_CHAR's table for TABLE_DISPATCH: for each state its number and routine: 2\nROWS_SCREEN_CHAR, 4 ROWS_BELOW_CHAR, 1 ROWS_ABOVE_CHAR; $FF ends it."},
        "2436": {"synopsis":"State 1: the next character from row C of the rows kept above the window ($0EE4). Past their\nlast row ($CE73), state 2 from row 0.\nExit: A = the character, L = the state.","comment":"DE = row C above the window"},
