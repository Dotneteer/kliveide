        "1929": {"comment":"Column 0"},
        "1932": {"synopsis":"TEXT_FROM_COL on window row C: carry when column B is in or just after the row's text, or\ntext follows it (B moved there). Keeps DE, HL."},
        "1934": {"comment":"DE = row C"},
        "1937": {"comment":"At or right of column B in the text?"},
        "1940": {"comment":"DE and HL back"},
        "1943": {"synopsis":"TEXT_BACK_FROM on window row C: carry when column B holds a character, or B moved back to\njust after the last one. Keeps DE, HL."},
        "1945": {"comment":"DE = row C"},
        "1948": {"comment":"Back to just after the text"},
        "1951": {"comment":"DE and HL back"},
        "1954": {"synopsis":"Moves the cursor to the start of the word before it: left (CURSOR_LEFT) past any spaces,\nthen on left to the space before the word, and back right one.\nExit: carry when it moved. Keeps DE, HL."},
        "1956": {"synopsis":"Left past spaces.","comment":"One place left"},
        "1959": {"comment":"None: done"},
        "1961": {"comment":"A = the character there"},
        "1964": {"comment":"A space?"},
        "1966": {"comment":"Then on left"},
        "1968": {"synopsis":"Left to the space before the word.","comment":"One place left"},
        "1971": {"comment":"None: done"},
        "1973": {"comment":"A = the character there"},
        "1976": {"comment":"A space?"},
        "1978": {"comment":"No: on left"},
        "1980": {"comment":"Back right past the space"},
        "1983": {"synopsis":"No more text: no carry.","comment":"DE and HL back"},
        "1985": {"synopsis":"Moves the cursor to the start of the next word: right (CURSOR_RIGHT) to the next space, then\npast the spaces to the word.\nExit: carry when it moved. Keeps DE, HL."},
        "1987": {"synopsis":"Right to a space.","comment":"One place right"},
        "1990": {"comment":"None: done"},
        "1992": {"comment":"A = the character there"},
        "1995": {"comment":"A space?"},
        "1997": {"comment":"No: on right"},
        "1999": {"synopsis":"Right past spaces.","comment":"One place right"},
