        "679": {"comment":"HL = the last row's end"},
        "680": {"comment":"DE = the last row's end"},
        "682": {"comment":"Row B the last?"},
        "686": {"synopsis":"One row down (copied from its end)."},
        "687": {"comment":"BC = the row size"},
