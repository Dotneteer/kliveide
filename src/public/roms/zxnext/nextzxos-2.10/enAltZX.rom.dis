        "695": {"comment":"The row above"},
        "696": {"comment":"Down to row B"},
        "699": {"synopsis":"DE = row B's place; the screen scrolled down ($10B6); the new row into row B.","comment":"HL = the end of row B's place"},
        "700": {"comment":"DE = row B"},
