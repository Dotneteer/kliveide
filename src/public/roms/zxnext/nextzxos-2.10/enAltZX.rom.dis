        "7374": {"comment":"HL = its entry"},
        "7375": {"comment":"DE = the period"},
        "7378": {"synopsis":"Into the channel's two tone registers.","comment":"HL = the period"},
        "7379": {"comment":"A = the AY channel"},
        "7382": {"comment":"X 2: its tone registers"},
        "7383": {"comment":"Register 2n = the low byte"},
        "7388": {"comment":"Register 2n + 1 = the high byte"},
        "7393": {"comment":"With the envelope?"},
        "7397": {"comment":"No: done"},
        "7398": {"comment":"HL = the chip's shape byte"},
        "7401": {"comment":"E = the shape"},
        "7402": {"comment":"Register 13: the shape"},
        "7408": {"synopsis":"AY register D = E on the selected chip (ports $FFFD and $BFFD). Keeps BC.","comment":"BC kept"},
        "7409": {"comment":"Register D selected"},
        "7414": {"comment":"Written with E"},
        "7419": {"comment":"BC back"},
        "7421": {"synopsis":"AY register D = E on all three chips: AY 3 ($FD), AY 2 ($FE), then AY 1 ($FF), each selected\nthrough port $FFFD (AY 1 is left selected).\nChanges: AF, BC.","comment":"The TurboSound control port"},
        "7424": {"comment":"AY 3 first"},
        "7426": {"synopsis":"One chip.","comment":"The chip selected"},
        "7428": {"comment":"Its register D = E"},
        "7431": {"comment":"The next chip, $FE then $FF"},
        "7432": {"comment":"Until past $FF"},
        "7435": {"synopsis":"Silences every AY chip (mixer $FF, volumes A-C 0, through AY_WRITE_ALL); IY back to $5C3A.\nNo MIDI is sent.","comment":"Register 7: every channel off"},
        "7439": {"comment":"On all three chips"},
        "7442": {"comment":"Registers 8-10: volume 0"},
        "7457": {"comment":"IY back to $5C3A"},
        "7462": {"synopsis":"The string's place moved back to the previous character that is not a space or ENTER. Keeps\nDE, HL.","comment":"HL and DE kept"},
        "7464": {"comment":"HL = the string's place"},
        "7470": {"synopsis":"Back one.","comment":"Back one"},
        "7471": {"comment":"A = the character"},
        "7472": {"comment":"A space?"},
