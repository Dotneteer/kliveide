        "3299": {"comment":"Nothing typed?"},
        "3301": {"comment":"Low byte into the slot at $3Fxx"},
        "3302": {"comment":"H = $3F"},
        "3305": {"comment":"Next byte of the slot"},
        "3306": {"comment":"A word?"},
        "3310": {"comment":"Its high byte too"},
        "3311": {"synopsis":"The item shown again.","comment":"The item shown again"},
        "3312": {"comment":"BC back"},
        "3313": {"comment":"REG_SHOW"},
        "3316": {"comment":"No carry"},
        "3317": {"comment":"Return to KEY_LOOP"},
        "3318": {"synopsis":"Moves HL to the next line of REG_LAYOUT.\nEntry: HL = a line's header.\nExit: Z, HL kept: it was the last (bit 6 clear); NZ: HL = the next line.\nChanges: AF, BC.","comment":"Another line follows (bit 6)?"},
        "3320": {"comment":"No: Z, HL kept"},
        "3321": {"comment":"Count + 1 words follow the header"},
        "3322": {"comment":"Its count"},
        "3324": {"comment":"+ 1: the header word"},
        "3326": {"comment":"BC = the count + 1"},
        "3328": {"comment":"HL = the next line"},
        "3329": {"comment":"2 bytes each"},
        "3331": {"synopsis":"Shows item C of the line at HL on the Status screen (REG_AT for its place, kind and slot):\n1. A word (kind bit 5): its value in 4 hex digits, 4 places on past '-->', then the 16 bytes\n   of memory at that address (through $0047 and MAP_PROG_BYTE).\n2. A byte: 2 hex digits, and with kind bit 4 a space and its 8 bits. Keeps HL.","comment":"AT the item; D = its kind, E = its slot"},
        "3334": {"comment":"Line pointer kept"},
        "3335": {"comment":"HL = the slot, $3F00 + E"},
        "3338": {"comment":"A word?"},
        "3340": {"comment":"No: a byte"},
        "3342": {"comment":"The word in 4 hex digits; HL = it"},
        "3345": {"comment":"4 places on, past '-->'"},
        "3347": {"synopsis":"Code 9 four times.","comment":"Code 9: one place on"},
        "3350": {"comment":"4 times"},
        "3352": {"comment":"16 bytes of memory at the word"},
        "3354": {"synopsis":"One byte of memory.","comment":"A space"},
        "3358": {"comment":"Address kept"},
        "3359": {"comment":"Page and offset of HL"},
        "3362": {"comment":"Paged in"},
