        "3198": {"comment":"KEY_LOOP"},
        "3201": {"synopsis":"Status screen, keys '5' and 8: the cursor one item left.\nEntry: HL = the line, C = the item.\nExit: C; carry (refused) at item 0.","comment":"First item already?"},
        "3203": {"comment":"Carry: refused"},
        "3204": {"comment":"Yes: refused"},
        "3205": {"comment":"One item left"},
        "3207": {"comment":"No carry"},
        "3208": {"synopsis":"Status screen, keys '8' and 9: the cursor one item right.\nExit: carry (refused) at the line's last item.","comment":"Last item already?"},
        "3209": {"comment":"Its item count"},
        "3211": {"comment":"The last item's number"},
        "3214": {"comment":"Yes: refused"},
        "3215": {"comment":"One item right"},
        "3217": {"comment":"No carry"},
        "3218": {"synopsis":"Status screen, keys '6' and $0A: the cursor to the next line (REG_NEXT_LINE); carry\n(refused) on the last line. Then REG_LINE_ITEM.","comment":"Next line, if any"},
        "3219": {"comment":"REG_NEXT_LINE"},
        "3223": {"comment":"None: refused"},
        "3224": {"comment":"Yes: refused"},
        "3225": {"synopsis":"The item on the new line: item 0 stays item 0, any other becomes the line's last. No carry.","comment":"No carry"},
        "3226": {"comment":"Item 0 stays item 0"},
        "3229": {"comment":"Others: the new line's last item"},
        "3230": {"comment":"Its item count - 1"},
        "3235": {"comment":"No carry"},
        "3236": {"synopsis":"Status screen, keys '7' and $0B: the cursor to the line above, found by walking REG_LAYOUT\nfrom its start; carry (refused) on the first line, the one whose header has bit 7 clear.\nThen REG_LINE_ITEM.","comment":"First line (its header's bit 7 clear)?"},
        "3239": {"comment":"Yes: refused"},
