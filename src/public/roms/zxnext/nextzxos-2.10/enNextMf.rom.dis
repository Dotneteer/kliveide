        "3125": {"comment":"PRINT_HEX_ROW"},
        "3128": {"comment":"Line 2, 28 more"},
        "3131": {"comment":"AT 2,2"},
        "3137": {"comment":"Line 4, the last 25"},
        "3140": {"comment":"AT 4,2"},
        "3146": {"comment":"'-->' after each word register"},
        "3149": {"synopsis":"One '-->'.","comment":"Line from the list (bit 7 marks the last)"},
        "3150": {"comment":"Bit 7 cleared"},
        "3152": {"comment":"Column 10"},
