        "2404": {"comment":"2 hex digits"},
        "2411": {"comment":"ENTER with none?"},
        "2413": {"comment":"Into the pattern"},
        "2417": {"synopsis":"$3E98 = the pattern's length (8 less those not typed).","comment":"The pattern's length"},
        "2425": {"synopsis":"Searches the program's memory from HL (C the page, $FF address mode) for the pattern at\n$3E99, $3E98 bytes long, moving on with ADDR_NEXT. Found: the page drawn at it (MB_SHOW), no\ncarry. Wrapped round to 0, or no pattern: carry.","comment":"The pattern's length"},
        "2428": {"comment":"None: carry"},
        "2432": {"synopsis":"Does the pattern start at HL?"},
        "2434": {"comment":"The pattern"},
        "2437": {"synopsis":"One byte of it."},
        "2440": {"comment":"Address mode?"},
        "2443": {"comment":"Then A = the page of HL"},
        "2446": {"comment":"Map the byte"},
        "2450": {"comment":"Pattern byte matches?"},
        "2456": {"comment":"Next pattern byte"},
        "2457": {"comment":"Next memory byte"},
        "2462": {"comment":"All matched: show it here"},
        "2469": {"synopsis":"No match here: the next start, unless wrapped round."},
        "2471": {"comment":"Next start"},
        "2474": {"comment":"Not wrapped round?"},
        "2476": {"comment":"Redraw; carry: not found"},
        "2481": {"synopsis":"Key N: the search again from the byte after the cursor; carry when there is no pattern.","comment":"Pattern's length"},
        "2484": {"comment":"None: carry"},
        "2487": {"comment":"From the next byte"},
        "2492": {"synopsis":"Key C: copies a block of the program's memory. Asks for the first offset (bank mode) or\naddress, the last and the destination (4 hex digits each), then \"Sure?\"; Y copies\n(MB_COPY_BYTE), from the top down when the destination is not below the start, so overlaps\nwork. Carry (a click) for any other answer, a last below the first, a destination block past\n64K, or in bank mode anything past $1FFF."},
        "2494": {"comment":"\"1st offset:\""},
        "2497": {"comment":"Address mode?"},
        "2500": {"comment":"Then \"1st address:\""},
        "2503": {"synopsis":"The first; then the last, the destination and the confirmation.","comment":"DE = the first"},
        "2507": {"comment":"\" last:\""},
        "2514": {"comment":"\" dest:\""},
        "2521": {"comment":"\" Sure?\""},
        "2530": {"comment":"Upper case"},
        "2532": {"comment":"Y?"},
        "2535": {"comment":"IX = dest, HL = last, DE = first"},
        "2539": {"comment":"No: carry"},
        "2541": {"comment":"The page or $FF"},
        "2544": {"comment":"BC = last - first"},
        "2551": {"comment":"Last below first: carry"},
        "2553": {"comment":"IX = the destination's last byte"},
        "2559": {"comment":"HL = it"},
        "2560": {"comment":"At $2000 or more?"},
        "2565": {"comment":"Past 64K: carry"},
        "2567": {"comment":"Below $2000: checked further"},
        "2569": {"comment":"Bank mode: carry"},
        "2573": {"synopsis":"Bank mode: the last and the destination must be below $2000.","comment":"Address mode?"},
        "2578": {"comment":"Last at $2000 or more?"},
        "2584": {"comment":"Destination at $2000 or more?"},
        "2592": {"synopsis":"Which way to copy: forwards when the destination is below the first byte, else from the top\ndown.","comment":"HL = the destination"},
        "2595": {"comment":"Below the first?"},
        "2601": {"comment":"The destination's last byte"},
        "2605": {"comment":"DE = it"},
        "2606": {"comment":"BC = the length"},
        "2607": {"comment":"The page in A'"},
        "2608": {"synopsis":"One byte, top down.","comment":"Copy one byte"},
        "2611": {"comment":"Down one"},
        "2613": {"comment":"More?"},
        "2617": {"synopsis":"Forwards: from the first byte to the destination.","comment":"HL = the first"},
        "2618": {"comment":"DE = the destination"},
        "2621": {"comment":"BC = the length"},
        "2622": {"comment":"The page in A'"},
        "2623": {"synopsis":"One byte, forwards.","comment":"Copy one byte"},
        "2626": {"comment":"Up one"},
        "2628": {"comment":"More?"},
        "2630": {"synopsis":"Position back, the prompt line cleared ($0B2C), the page drawn again; flags as left (carry:\na click).","comment":"Position and mode back"},
        "2632": {"comment":"Flags kept"},
        "2633": {"comment":"Prompt line cleared"},
        "2636": {"comment":"Draw the page"},
        "2641": {"synopsis":"Copies one byte of the program's memory from HL to DE, both in page A' ($FF: address mode,\npages from ADDR_PAGE), through the page cache.\nEntry: HL, DE, BC = the count, A' = the page.\nExit: BC less one, Z when it is 0; HL, DE, A' kept.","comment":"A = the page"},
        "2646": {"comment":"Address mode?"},
        "2648": {"comment":"Then the page of HL"},
        "2651": {"comment":"Map the source byte"},
        "2654": {"comment":"C = the byte"},
        "2655": {"comment":"HL = the destination"},
        "2660": {"comment":"Address mode?"},
        "2662": {"comment":"Then the page of DE"},
        "2665": {"comment":"Map the destination"},
        "2669": {"comment":"Write the byte"},
        "2670": {"comment":"Cache marked written"},
        "2673": {"comment":"Registers back"},
        "2677": {"comment":"The page back in A'"},
        "2678": {"comment":"One fewer; done?"},
        "2682": {"synopsis":"Writes E to the program's memory at HL in page C ($FF: address mode) through the page cache,\nwhich is marked written.\nExit: HL points into the cache (L kept)."},
        "2683": {"comment":"Address mode?"},
        "2686": {"comment":"Then A = the page of HL"},
        "2689": {"comment":"Map the byte"},
        "2693": {"comment":"Write it"},
        "2694": {"comment":"Cache marked written"},
        "2697": {"synopsis":"Moves the print position to byte L's character: row 3 + L / 16, column $39 + L mod 16.\nChanges: AF.","comment":"AT"},
        "2700": {"comment":"Row 3 + L / 16"},
        "2710": {"comment":"Column $39 + L mod 16"},
        "2717": {"synopsis":"Prints the browser's header at row 0: \"Bank\" with page C and \"Offset\" with HL in bank mode,\nor \"Address\" with HL (MB_HEADER_ADDR).\nExit: BC, HL kept.","comment":"At row 0, column 0"},
        "2723": {"comment":"Address mode?"},
        "2727": {"comment":"\"Bank\""},
        "2733": {"comment":"The page in hex"},
        "2737": {"comment":"\"Offset\""},
        "2743": {"comment":"HL in hex"},
        "2746": {"synopsis":"Address mode: \"Address\" with HL, then 9 spaces over what bank mode left.","comment":"\"Address\""},
        "2752": {"comment":"HL in hex"},
        "2756": {"comment":"9 spaces"},
        "2761": {"synopsis":"Reads a key for the text editor: TXT_EDIT_MARK printed before and after the key; ENTER: Z.\nOtherwise the key is printed as a character (PRINT_CHR_A).\nExit: A = the key; Z for ENTER. BC, HL kept."},
        "2763": {"comment":"The edit mark"},
        "2769": {"comment":"Wait for a key (WAIT_KEY_CLICK)"},
        "2772": {"comment":"Kept in B"},
        "2773": {"comment":"The edit mark again"},
        "2782": {"comment":"ENTER?"},
        "2786": {"comment":"Print the key"},
        "2791": {"synopsis":"Prints the byte at HL as a character, '.' for codes below $20 or from $80.","comment":"The byte"},
        "2792": {"synopsis":"Prints A as a character, '.' for codes below $20 or from $80.","comment":"A control code?"},
        "2796": {"comment":"Printable?"},
        "2800": {"synopsis":"Not printable: '.'.","comment":"'.' instead"},
        "2802": {"synopsis":"The print."},
        "2804": {"synopsis":"Moves the print position to byte L's hex digits (row 3 + L / 16, column 7 + 3 x (L mod 16))\nand prints the string at DE there: the browser's cursor routine (the first word of its key\ntable at $14A1), with TXT_POINTER to show the cursor and TXT_SPACE to clear it. Also used to\nput the edit cursor there.","comment":"String kept"},
        "2805": {"comment":"Row 3 + L / 16"},
        "2815": {"comment":"Column 7 + 3 x (L mod 16)"},
        "2816": {"comment":"E = 3 x the low nibble + 7: the byte's column"},
        "2819": {"comment":"A x 3"},
        "2821": {"comment":"+ 7"},
        "2824": {"comment":"AT D,E"},
        "2827": {"comment":"The text at DE printed there"},
        "2828": {"comment":"And return from there"},
        "2831": {"synopsis":"Asks for a 2-digit hex number: PROMPT_HEX with B = 2.\nEntry: DE = the prompt text.\nExit: A = E = the value (the digits typed so far when ENTER came early).\nChanges: AF, B, DE.","comment":"2 digits"},
        "2833": {"comment":"Prompt, then the input"},
        "2836": {"comment":"A = the value"},
        "2837": {"comment":"DE = the value too"},
        "2838": {"synopsis":"Asks for a 4-digit hex number: PROMPT_HEX with B = 4.\nEntry: DE = the prompt text.\nExit: DE = the value.","comment":"4 digits"},
        "2840": {"synopsis":"Asks for a B-digit hex number on line 0 from column 32:\n1. The prompt area cleared (CLEAR_PROMPT), then 'Enter ' and the caller's prompt.\n2. The digits read by INPUT_HEX with C = B, so an early ENTER is not padded.\n3. The prompt area cleared again.\nEntry: DE = the prompt, B = the digits.\nExit: DE = the value.\nChanges: AF, DE.","comment":"Prompt area cleared, AT 0,32"},
        "2841": {"comment":"CLEAR_PROMPT"},
        "2844": {"comment":"'Enter '"},
        "2847": {"comment":"Printed"},
        "2850": {"comment":"Then the caller's prompt"},
        "2851": {"comment":"Printed after 'Enter '"},
        "2854": {"comment":"BC kept"},
        "2855": {"comment":"C = B: no zero padding on an early ENTER"},
        "2856": {"comment":"Read the digits"},
        "2859": {"comment":"Then the prompt area cleared again"},
        "2860": {"synopsis":"Clears the prompt area, 52 spaces from line 0 column 32, and leaves the print position at\n0,32. Keeps BC, DE.","comment":"Print position first"},
        "2864": {"comment":"52 spaces: columns 32-83 of line 0"},
        "2866": {"comment":"Printed"},
        "2869": {"comment":"Back to AT 0,32"},
        "2870": {"synopsis":"Print position AT 0,32 (line 0, column 32). Keeps DE."},
        "2871": {"comment":"Line 0, column 32"},
        "2874": {"comment":"AT D,E"},
        "2877": {"comment":"DE back"},
        "2879": {"synopsis":"Prints 9 spaces (PRINT_SPACES with B = 9).","comment":"9 spaces"},
        "2881": {"synopsis":"Prints B spaces through RST $30. Keeps DE.\nExit: B = 0."},
        "2882": {"synopsis":"One space.","comment":"A space"},
        "2885": {"comment":"B times"},
        "2887": {"comment":"DE back"},
        "2889": {"synopsis":"AT 0,32, then TEXT_HEX4.","comment":"AT 0,32"},
        "2892": {"synopsis":"Prints the text at DE, then INPUT_HEX4.","comment":"The text at DE"},
        "2895": {"synopsis":"Reads a 4-digit hex number by INPUT_HEX with B = 4 and C = $84: ENTER may end it early, the\nmissing digits taken as zeros. Exit as INPUT_HEX; BC kept."},
        "2896": {"comment":"4 digits; ENTER may end early, padded with zeros"},
        "2899": {"comment":"Read them"},
        "2902": {"comment":"BC back"},
        "2904": {"synopsis":"Reads a hex number of up to B digits at the print position, with a cursor block:\n1. The cursor block drawn (the text at $1D2C: OVER and inverse on, a space, both off, one\n   place back) and a key read (ROM 0's WAIT_KEY_CLICK).\n2. '0'-'9', 'A'-'F' or 'a'-'f': the key printed as typed and its value shifted into DE from\n   the right; the next digit, until B are typed.\n3. Any other key but ENTER: a click and another key.\n4. ENTER: the block removed; with nothing typed, or with C bit 7 clear, a return with Z;\n   with C bit 7 set, a '0' printed and DE x 16 for each missing digit.\nEntry: B = the digits, C = their count, + $80 to allow an early ENTER.\nExit: DE = the value; Z: nothing typed (or ENTER early without padding); NZ, carry: all\ndigits typed; NZ, NC: ended early and padded.\nChanges: AF, BC, DE.","comment":"DE = 0: the value so far"},
        "2907": {"synopsis":"One digit: the cursor block drawn.","comment":"HL kept"},
        "2908": {"comment":"B and C kept"},
        "2910": {"comment":"Cursor block drawn (XOR, then one place back)"},
        "2913": {"comment":"Toggled on"},
        "2916": {"comment":"DE = the value so far"},
        "2917": {"synopsis":"Waits for a key."},
        "2918": {"comment":"Wait for a key"},
        "2921": {"comment":"B = the key"},
        "2923": {"comment":"ENTER?"},
        "2925": {"comment":"No: a digit?"},
        "2927": {"comment":"Cursor block removed"},
        "2931": {"comment":"Toggled off"},
        "2935": {"comment":"B = the digits still to come, C = the count asked for"},
        "2936": {"comment":"Nothing typed yet?"},
        "2940": {"comment":"Yes: return with Z"},
        "2942": {"comment":"Zero padding allowed (C bit 7)?"},
        "2944": {"comment":"No: return with Z, DE as typed so far"},
        "2946": {"comment":"Each missing digit: value x 16 and a '0' printed"},
        "2947": {"synopsis":"One missing digit: DE x 16 and a '0'."},
        "2951": {"comment":"'0' in the missing digit's place"},
        "2954": {"comment":"Each missing digit"},
        "2956": {"comment":"DE = the padded value"},
        "2957": {"comment":"NZ, NC: ended early"},
        "2958": {"comment":"A nonzero"},
        "2959": {"synopsis":"HL back; return.","comment":"HL back"},
        "2961": {"synopsis":"A key other than ENTER: a hex digit?","comment":"Above '9'?"},
        "2963": {"comment":"Yes: a letter?"},
        "2965": {"comment":"A digit '0'-'9'?"},
        "2967": {"comment":"Yes: its value is A"},
        "2969": {"synopsis":"A refused key: a click (ROM 0's $3E18), then another key.","comment":"Any other key refused: a click"},
        "2970": {"comment":"A click"},
        "2974": {"comment":"Wait again, the cursor still shown"},
        "2976": {"synopsis":"Above '9': a letter 'A'-'F' (either case)?","comment":"Capitals; above 'F'?"},
        "2980": {"comment":"Yes: refused"},
        "2982": {"comment":"Below 'A'?"},
        "2984": {"comment":"Yes: refused"},
        "2986": {"comment":"'A'-'F': 10-15"},
