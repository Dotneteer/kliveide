        "2334": {"comment":"Next byte"},
        "2335": {"comment":"Header for the new position"},
        "2338": {"comment":"At its character"},
        "2346": {"synopsis":"Key F: asks \"H/T?\"; H takes up to 8 bytes in hex, T up to 8 characters, ENTER ending either,\ninto $3E99 with their count at $3E98; then MB_SEARCH from the cursor. Another key: carry."},
        "2348": {"comment":"Prompt line cleared"},
        "2351": {"comment":"\"H/T?\""},
        "2360": {"comment":"Upper case"},
        "2363": {"comment":"Prompt line cleared"},
        "2367": {"comment":"Up to 8 bytes"},
        "2369": {"comment":"Into $3E99"},
        "2372": {"comment":"H?"},
        "2376": {"comment":"T?"},
        "2380": {"comment":"Neither: carry"},
        "2384": {"synopsis":"T: up to 8 characters.","comment":"Echo the T"},
        "2388": {"synopsis":"One character; ENTER ends.","comment":"A key; ENTER?"},
        "2393": {"comment":"Into the pattern"},
