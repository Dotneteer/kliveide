        "3900": {"synopsis":"Breakpoint screen, key 'D': the slot disabled (bit 7 of its flags byte cleared). No carry.","comment":"BP_RECORD: HL = 3 past the slot's start"},
        "3903": {"comment":"HL = the slot's flags byte"},
        "3905": {"comment":"Disabled"},
        "3907": {"comment":"No carry"},
        "3909": {"synopsis":"Breakpoint screen, keys '6' and $0A: the cursor one slot down (B - 1); carry (refused) at\nslot 19 (B = 1).","comment":"One slot down, unless at slot 19 (B = 1)"},
        "3910": {"comment":"One slot down"},
