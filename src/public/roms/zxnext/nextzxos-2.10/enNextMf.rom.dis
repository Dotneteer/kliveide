        "3263": {"synopsis":"Status screen, key 'M': leaves the key loop for the memory browser - at the value of the\nitem when it is a word register ($07ED), otherwise at address 0 ($07EA).","comment":"D = the item's kind, E = its slot"},
        "3266": {"comment":"The key loop's return and table dropped"},
