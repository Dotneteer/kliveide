        "3157": {"comment":"'-->'"},
        "3160": {"comment":"Printed"},
        "3163": {"comment":"Last line?"},
        "3165": {"comment":"Next line byte"},
        "3168": {"comment":"Every item of the layout table shown"},
        "3171": {"synopsis":"One line of REG_LAYOUT: its items from 0.","comment":"C = item 0"},
        "3173": {"comment":"B = the line's item count"},
        "3174": {"comment":"Low 6 bits"},
        "3177": {"synopsis":"One item.","comment":"Show item C"},
        "3178": {"comment":"REG_SHOW"},
        "3182": {"comment":"Next item"},
