        "3000": {"comment":"HL = the value"},
        "3001": {"synopsis":"One bit into DE.","comment":"Top bit of A"},
        "3002": {"comment":"Into HL from the right"},
        "3004": {"comment":"4 bits"},
        "3006": {"comment":"DE = the value"},
        "3007": {"comment":"B = the digits still to come"},
