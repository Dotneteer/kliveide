        "3873": {"comment":"Not the same character?"},
        "3876": {"comment":"The same: on"},
        "3878": {"synopsis":"The wanted name ended: found if the line's ended too.","comment":"Did the line's name end too?"},
        "3881": {"comment":"A = D: minus the statements passed"},
        "3882": {"comment":"D' = the statement's number"},
        "3887": {"comment":"HL at the name's start"},
        "3888": {"comment":"IX = the line's text"},
        "3890": {"comment":"BC = the line's length"},
        "3891": {"comment":"Carry: found"},
        "3892": {"synopsis":"Bank 0 back for a program in a bank; carry as found.","comment":"A program in a bank?"},
        "3896": {"comment":"Then bank 0 back (as RST $30 does)"},
        "3900": {"synopsis":"Not this one: the next statement of the line.","comment":"The place dropped"},
        "3902": {"comment":"C = 0: outside quotes"},
        "3904": {"comment":"To the next statement start"},
