        "15403": {"synopsis":"Report 4 (the code at $1F15).","comment":"Report 4"},
        "15406": {"synopsis":"duplicate ($31), and the copy for PUSH_NUMBER, get-mem and stk-const: 5 bytes from HL to DE\nafter the room check of ROOM_FOR_5_FAST.\nExit: HL, DE past them, BC = 0.","comment":"HL kept"},
        "15407": {"comment":"HL = STKEND"},
