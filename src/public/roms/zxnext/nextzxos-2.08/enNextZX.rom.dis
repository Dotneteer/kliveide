        "8479": {"comment":"Yes: past it"},
        "8482": {"comment":"Back to the TO list"},
        "8485": {"comment":"The value's kind"},
        "8488": {"comment":"The variable's"},
        "8489": {"comment":"The same?"},
        "8492": {"comment":"No: report Q"},
        "8495": {"comment":"An integer variable?"},
        "8499": {"comment":"Yes"},
        "8501": {"synopsis":"Assigned ($3DCF); if that moved the machine stack, $5B8C moves with it.","comment":"Assigned"},
        "8504": {"comment":"The stack before"},
