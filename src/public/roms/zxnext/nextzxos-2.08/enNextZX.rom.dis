        "4789": {"comment":"'~' done with"},
        "4791": {"comment":"All gone?"},
        "4793": {"comment":"No: the next"},
        "4795": {"comment":"Empty: the result"},
        "4797": {"synopsis":"Room for the result (RST $30), its start and length kept for STK_STO_STR; the string copied\nfrom its end down, the flags in A'.","comment":"The flags kept"},
        "4798": {"comment":"The room"},
