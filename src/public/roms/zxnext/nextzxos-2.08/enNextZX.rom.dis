        "8618": {"comment":"A string"},
        "8620": {"comment":"Running?"},
        "8622": {"comment":"Then stacked"},
        "8628": {"synopsis":"A number result: BC stacked when running.","comment":"Running?"},
        "8630": {"comment":"Then stacked"},
        "8634": {"synopsis":"Not found: B bit 7 set; then LV_END.","comment":"Not found"},
        "8638": {"synopsis":"Checking: B = C, and C = its top 3 bits with bit 7 set; no search.","comment":"B = C"},
        "8639": {"comment":"Its top 3 bits"},
        "8642": {"comment":"Bit 7: checking"},
        "8644": {"comment":"C = it"},
        "8645": {"synopsis":"Checking or not found: HL = the name's start in the line (the alternate HL); B bit 5 set\nunless '(' follows. Then LV_EXIT.","comment":"The character after the name"},
        "8646": {"comment":"The other set"},
