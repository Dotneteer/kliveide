        "4017": {"synopsis":"The wanted name ended: found if the indexed one ended too; the line from the entry's second\nword.","comment":"Did the indexed name end too?"},
        "4020": {"comment":"DE = past the name"},
        "4021": {"comment":"BC = the program's start"},
