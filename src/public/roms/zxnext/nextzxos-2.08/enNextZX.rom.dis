        "8678": {"synopsis":"A = the window's colour.","comment":"A = the colour"},
        "8681": {"synopsis":"C bytes at DE + $8000, the second file's, set to A.","comment":"B = the width"},
        "8682": {"comment":"DE in the second file"},
