        "4912": {"comment":"The next"},
        "4914": {"synopsis":"The character is dropped: the result starts one byte later and is one shorter (the kept\nstart and length on the stack changed), DE one on so the next character takes this place.","comment":"The character dropped"},
        "4915": {"comment":"The main set"},
