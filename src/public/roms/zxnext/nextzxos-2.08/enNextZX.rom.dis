        "4735": {"comment":"Into the alternate set"},
        "4736": {"comment":"No: on"},
        "4738": {"synopsis":"Stops with error code 9 (report A): a string of 256 or more, or f$ empty."},
        "4740": {"synopsis":"The string itself (STK_FETCH): DE = its start, BC = its length; H = the flags.","comment":"The string"},
        "4743": {"synopsis":"H = the flags off the stack; on at STRMOD_LTRIM.","comment":"H = the flags"},
        "4744": {"synopsis":"An empty string ends as it is (STRING_RESULT); with '<' (bit 7) codes below $21 are dropped\nfrom its start.","comment":"Empty?"},
        "4746": {"comment":"Then the result"},
        "4749": {"comment":"'<'?"},
        "4751": {"comment":"No: on"},
        "4753": {"comment":"The first character"},
        "4754": {"comment":"Below $21?"},
        "4756": {"comment":"No: on"},
        "4758": {"comment":"Dropped"},
        "4760": {"comment":"Again"},
        "4762": {"synopsis":"With '>' (bit 6) codes below $21 are dropped from the end; with '~' (bit 5) as well, the\nlast character's bit 7 is ignored for the test.","comment":"The start kept"},
        "4763": {"comment":"'>'?"},
        "4765": {"comment":"No: on"},
        "4767": {"comment":"L = $FF: the mask"},
        "4769": {"comment":"'~'?"},
        "4771": {"comment":"No: as it is"},
        "4773": {"comment":"L = $7F: bit 7 ignored"},
        "4775": {"synopsis":"DE = the last character.","comment":"DE = the end"},
        "4778": {"comment":"The last character"},
        "4779": {"synopsis":"One character from the end: below $21 (with the mask) it is dropped, and from then on '~' no\nlonger applies (bit 5 cleared, mask $FF).","comment":"The character"},
        "4780": {"comment":"Masked"},
        "4781": {"comment":"$21 or more?"},
        "4783": {"comment":"Then on"},
        "4785": {"comment":"Dropped"},
