        "4897": {"comment":"The main set"},
        "4898": {"comment":"A = the flags"},
        "4899": {"synopsis":"With '^' (bit 2): bit 7 set on the last character only (the flag cleared after it).","comment":"'^'?"},
        "4901": {"comment":"No: on"},
        "4903": {"comment":"Only once"},
        "4905": {"comment":"The character"},
