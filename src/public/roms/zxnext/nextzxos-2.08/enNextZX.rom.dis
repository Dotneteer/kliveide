        "8516": {"comment":"A = the part's end"},
        "8517": {"comment":"BC = the step"},
        "8519": {"comment":"HL = the next row"},
        "8521": {"comment":"B = the part's end"},
        "8523": {"comment":"All 8?"},
        "8526": {"comment":"Past this part of the screen?"},
        "8528": {"comment":"Then the next part"},
        "8531": {"comment":"The next cell row"},
