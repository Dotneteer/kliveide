        "15065": {"comment":"$FE: report N"},
        "15068": {"comment":"A back"},
        "15070": {"comment":"HL kept"},
        "15071": {"comment":"HL = the line's bank address"},
        "15072": {"comment":"Found again?"},
        "15075": {"comment":"No: report N"},
        "15077": {"comment":"HL back"},
