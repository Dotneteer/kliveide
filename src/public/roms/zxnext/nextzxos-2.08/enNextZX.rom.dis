        "8750": {"comment":"A = the moved value"},
        "8751": {"comment":"HL = P_FLAG"},
        "8754": {"comment":"Its bit set from it"},
        "8756": {"synopsis":"INK (B = 7: bits 0-2) or PAPER (B = $38: the value moved to bits 3-5).","comment":"A = the value"},
        "8757": {"comment":"INK: bits 0-2"},
        "8759": {"comment":"INK: on"},
        "8761": {"comment":"PAPER: the value moved to bits 3-5"},
        "8764": {"comment":"Bits 3-5"},
        "8766": {"synopsis":"10 or more: report K.","comment":"C = the moved value"},
        "8767": {"comment":"A = the value"},
        "8768": {"comment":"10 or more?"},
        "8770": {"comment":"No: on"},
        "8772": {"synopsis":"Stops with error code $13 (report K, \"Invalid colour\")."},
        "8774": {"synopsis":"HL = ATTR_T. 0-7: the colour itself; 8: the old ATTR_T bits (the mask below makes them the\nscreen's); 9: a contrast start value.","comment":"HL = ATTR_T"},
        "8777": {"comment":"0-7?"},
        "8779": {"comment":"Then the colour itself"},
        "8781": {"comment":"A = ATTR_T"},
        "8782": {"comment":"8: its old bits"},
        "8784": {"comment":"9: this colour's bits set"},
        "8785": {"comment":"Inverted"},
        "8786": {"comment":"The other colour dark (its bit 2 clear)?"},
        "8788": {"comment":"Light: 0, black"},
        "8790": {"comment":"Dark: white"},
        "8791": {"synopsis":"C = the bits to store.","comment":"C = the bits"},
        "8792": {"synopsis":"ATTR_T's bits B from C; MASK_T's bits B set for 8 and 9, cleared for 0-7; P_FLAG's INK 9 or\nPAPER 9 bit (4 or 6) set for 9 only.","comment":"A = the bits"},
        "8793": {"comment":"ATTR_T's bits; HL = MASK_T"},
        "8796": {"comment":"7"},
        "8798": {"comment":"Below the value?"},
        "8799": {"comment":"A = $FF for 8 and 9, else 0"},
        "8800": {"comment":"MASK_T's bits; HL = P_FLAG"},
        "8803": {"comment":"INK $07 or PAPER $38 rotated"},
