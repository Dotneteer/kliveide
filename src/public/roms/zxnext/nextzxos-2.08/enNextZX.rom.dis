        "14739": {"synopsis":"SPRITE AT (a,b): the two numbers (TWO_COORDS); running, SPRITE_AT_RUN; then past ')' and\nSET_NUMERIC.","comment":"\"(a,b)\"; NZ when running"},
        "14742": {"comment":"Running: SPRITE_AT_RUN"},
        "14745": {"comment":"Past ')'"},
        "14746": {"comment":"A number"},
        "14749": {"synopsis":"E, D = the two bytes (TAKE_TWO_BYTES), L = $AC, then SPRITE_CALL.","comment":"B, C = the two bytes"},
