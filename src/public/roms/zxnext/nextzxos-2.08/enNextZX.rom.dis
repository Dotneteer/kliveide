        "10896": {"comment":"')'?"},
        "10898": {"comment":"Otherwise report C"},
        "10900": {"synopsis":"The slice: start + first - 1, length = last - first + 1; none when last < first; out of\nrange (A bit 7) is report 3 only when not empty.","comment":"A = the mark"},
        "10901": {"comment":"HL = the start, the last kept"},
        "10902": {"comment":"Plus the first"},
        "10903": {"comment":"Less 1: the slice's start"},
        "10904": {"comment":"Kept; HL = the last"},
