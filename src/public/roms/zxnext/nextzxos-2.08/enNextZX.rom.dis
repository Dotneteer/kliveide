        "8321": {"comment":"Then report O"},
        "8324": {"comment":"That stream made current"},
        "8327": {"comment":"Carry clear: a stream"},
        "8329": {"synopsis":"Calls $2860 in the DivMMC memory with HL = $3140 (DIVMMC_CALL), then the routine at $0D1B\noutside this ROM with A = the E it returned, $64 (100) when that was $FF (through $32CD).\nNothing in this ROM jumps here.","comment":"HL = $3140"},
        "8332": {"comment":"$2860 in the DivMMC memory"},
        "8337": {"comment":"A = E"},
        "8338": {"comment":"$FF?"},
        "8339": {"comment":"No"},
        "8341": {"comment":"Then 100"},
        "8343": {"synopsis":"A = E; the routine at $0D1B called.","comment":"A = E"},
        "8344": {"comment":"$0D1B called"},
        "8352": {"comment":"BC = S_POSN"},
        "8356": {"comment":"A = DF_SZ"},
