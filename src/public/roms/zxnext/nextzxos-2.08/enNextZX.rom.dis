        "15306": {"comment":"The offset kept"},
        "15307": {"comment":"The 5 bytes to $5CAA"},
        "15315": {"comment":"HL = the offset"},
        "15316": {"comment":"A = the bank"},
        "15318": {"comment":"Paged at $C000"},
        "15321": {"comment":"DE = the place"},
        "15322": {"comment":"From $5CAA"},
        "15328": {"comment":"Put back"},
        "15330": {"comment":"Bank 0 back"},
        "15331": {"comment":"The cache's base"},
        "15334": {"comment":"DE = it, HL = the place"},
        "15336": {"comment":"The distance"},
        "15338": {"comment":"Within 255?"},
        "15342": {"comment":"DE = the distance"},
        "15343": {"comment":"+ $5DB1: in the cache"},
        "15347": {"comment":"From $5CAA"},
        "15353": {"comment":"Put back"},
        "15357": {"synopsis":"Drops the GO SUB stack's entries up to and including the 11-byte one whose type byte is at\nHL: SP and $5C0B = HL + 10, the error address and the statement loop's return back above,\nERR_SP at the error address. Called from $1DFF, $1F1F, $1FDE, $2087, $2096, $25DB.","comment":"IX = the return address"},
        "15359": {"comment":"BC = the statement loop's return"},
        "15360": {"comment":"DE = the error address"},
        "15361": {"comment":"HL past the entry"},
        "15365": {"synopsis":"SP and $5C0B = HL; the two words back.","comment":"SP = it"},
        "15366": {"comment":"$5C0B = it"},
        "15370": {"comment":"The error address"},
