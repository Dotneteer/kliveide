        "8538": {"comment":"MMU 6-7: pages 11 and 16"},
        "8541": {"synopsis":"Installs the clearing routines (WCH_OPS_CLEAR) at $5B91.","comment":"The clearing routines"},
        "8544": {"synopsis":"Copies the three jumps (9 bytes) at HL to $5B91, $5B94 and $5B97, the routines WCH_AREA_OP\nruns.\nChanges: BC, DE, HL.","comment":"Their place in RAM"},
        "8547": {"comment":"9 bytes: three jumps"},
        "8550": {"comment":"Copied"},
        "8553": {"synopsis":"The clearing routines, three jumps copied to $5B91 by WCH_SET_OPS: attribute rows\n(WCH_ATTR_FILL), pixel rows (WCH_LINE_CLEAR), rows of one byte a pixel (WCH_BYTES_FILL).","comment":"Attributes: the window's colour"},
        "8556": {"comment":"Pixels: cleared"},
        "8559": {"comment":"One byte a pixel: the paper"},
        "8562": {"synopsis":"The recolouring routines: attribute rows (WCH_ATTR_FILL), hi-colour's colour bytes\n(WCH_LINE_COLOUR), and for one byte a pixel nothing (WCH_OPS_INVERT's RET).","comment":"Attributes: the window's colour"},
        "8565": {"comment":"Pixels: hi-colour's colour bytes"},
        "8568": {"synopsis":"The inverting routines: attributes left alone (a RET and two filler bytes), pixel rows\n(WCH_LINE_INVERT), rows of one byte a pixel (WCH_BYTES_INVERT).","comment":"Attributes: left alone"},
        "8571": {"comment":"Pixels: inverted"},
        "8574": {"comment":"One byte a pixel: inverted"},
        "8577": {"synopsis":"The scrolling routines: attribute rows (WCH_ATTR_UP), pixel rows (WCH_LINE_UP), rows of one\nbyte a pixel (WCH_BYTES_UP).","comment":"Attributes: from the row below"},
        "8580": {"comment":"Pixels: from the row below"},
        "8583": {"comment":"One byte a pixel: from 8 rows below"},
        "8586": {"synopsis":"The routines that save the window to the store at ($5B9B) or restore it ($5C92 bit 7;\nWCH_STORE_COPY): attribute rows (WCH_ATTR_STORE), pixel rows (WCH_LINE_STORE), rows of one\nbyte a pixel (WCH_BYTES_STORE). Used by $1991, and from page 1 at $31FA.","comment":"Attributes: with the store"},
        "8589": {"comment":"Pixels: with the store"},
        "8592": {"comment":"One byte a pixel: with the store"},
        "8595": {"synopsis":"Attribute row: C bytes from the row below (HL + $20) to HL.\nExit: HL = the next row.\nKeeps BC, DE.","comment":"DE kept"},
        "8596": {"comment":"DE = this row"},
        "8597": {"comment":"HL = the row below"},
        "8601": {"comment":"Which is the next"},
        "8602": {"comment":"Count kept"},
        "8603": {"comment":"Copied up"},
        "8609": {"synopsis":"Attribute row: C bytes at HL set to the window's colour (+$1F).\nExit: HL = the next row.","comment":"A = the colour"},
        "8612": {"comment":"B = the width"},
