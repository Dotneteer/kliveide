        "10587": {"comment":"At the byte after the $7F"},
        "10588": {"comment":"Compared in full"},
        "10590": {"synopsis":"The same first byte: a long number name is compared in full (LV_LONG); a one-letter one\nneeds the line's name to end there (NAME_ENDS).","comment":"The name's form"},
        "10592": {"comment":"A long number name?"},
        "10594": {"comment":"Yes: on"},
