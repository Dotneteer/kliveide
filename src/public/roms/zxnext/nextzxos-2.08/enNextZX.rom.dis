        "15934": {"synopsis":"An optional ', number': without the ',' HL = 0 (NZ); otherwise past it, the number (through\n$0634); running, HL = it (TAKE_WORD). Checking returns with Z.","comment":"The next character"},
        "15937": {"comment":"0 when none"},
