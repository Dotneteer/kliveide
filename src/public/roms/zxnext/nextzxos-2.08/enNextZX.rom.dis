        "8807": {"comment":"B = that bit"},
        "8808": {"comment":"8"},
        "8810": {"comment":"Below the value?"},
        "8811": {"comment":"A = $FF for 9 only, else 0"},
        "8812": {"synopsis":"Copies the bits B of A into (HL), the others kept; HL one on. Exit: A = B.\nChanges: AF, HL.","comment":"The bits of B from A"},
        "8813": {"comment":"The others from (HL)"},
        "8815": {"comment":"Stored"},
        "8816": {"comment":"HL on"},
        "8817": {"comment":"A = B"},
        "8819": {"synopsis":"FLASH (B = $80) or BRIGHT (B = $40): the value's bit 0 moved to that bit.","comment":"FLASH: $FF; BRIGHT: 0"},
        "8820": {"comment":"A = the value"},
        "8821": {"comment":"Bit 0 to bit 7"},
        "8822": {"comment":"Bit 7"},
        "8824": {"comment":"FLASH: on"},
        "8826": {"comment":"BRIGHT: bit 0 to bit 6"},
        "8827": {"comment":"Bit 6"},
        "8829": {"synopsis":"Only 0, 1 or 8, else report K.","comment":"C = the moved value"},
        "8830": {"comment":"A = the value"},
        "8831": {"comment":"8?"},
        "8833": {"comment":"Yes: allowed"},
        "8835": {"comment":"2 or more?"},
        "8837": {"comment":"Then report K"},
        "8839": {"synopsis":"ATTR_T's bit from the value; MASK_T's bit set for 8 (keep the screen's), cleared for 0 and\n1.","comment":"A = the moved value"},
        "8840": {"comment":"HL = ATTR_T"},
        "8843": {"comment":"ATTR_T's bit; HL = MASK_T"},
        "8846": {"comment":"A = the moved value"},
