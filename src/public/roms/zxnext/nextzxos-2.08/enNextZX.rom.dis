        "14871": {"comment":"B and C = it"},
        "14873": {"comment":"'~'?"},
        "14875": {"comment":"No: a length"},
        "14877": {"comment":"The character after '~'"},
        "14878": {"comment":"C = it"},
        "14879": {"comment":"')'?"},
        "14881": {"comment":"Then '~' alone"},
        "14883": {"synopsis":"The length or the terminator: a number, then ')'.","comment":"Kept"},
        "14884": {"comment":"A number"},
        "14887": {"comment":"BC back"},
        "14888": {"comment":"')'?"},
        "14890": {"comment":"Otherwise report C"},
        "14892": {"synopsis":"Past ')'; checking, done.","comment":"D = the bank again"},
        "14893": {"comment":"Past ')'"},
        "14894": {"comment":"Checking syntax?"},
        "14897": {"comment":"Then done"},
        "14898": {"comment":"The bank kept"},
        "14899": {"comment":"The form kept"},
        "14900": {"comment":"A = C"},
