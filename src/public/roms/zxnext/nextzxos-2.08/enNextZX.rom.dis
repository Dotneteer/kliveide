        "4330": {"comment":"Did the line have a $98?"},
        "4334": {"comment":"No: the next line"},
        "4338": {"synopsis":"Each $FA at a statement start becomes $83.","comment":"D = 0, E = $FA: any statement starting with $FA"},
        "4341": {"comment":"Another one?"},
