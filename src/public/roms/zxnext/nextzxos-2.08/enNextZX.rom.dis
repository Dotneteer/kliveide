        "15707": {"comment":"Carry"},
        "15709": {"synopsis":"An integer array: past '(' and ')'; D bit 2 or D bit 1 (E = $FF) allow it; a $82-byte entry\nof type $C2 (GOSUB_ALLOC) filled by the DivMMC memory's $28D8.\nExit: carry; Z, NC when not allowed.","comment":"Past '('"},
        "15710": {"comment":"Past ')'"},
        "15711": {"comment":"D bit 2?"},
        "15715": {"comment":"D bit 1?"},
