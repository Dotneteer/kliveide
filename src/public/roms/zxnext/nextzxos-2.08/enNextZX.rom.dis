        "3835": {"comment":"Past the line number"},
        "3837": {"comment":"BC = the line's length"},
        "3841": {"comment":"The length and the text's start kept"},
        "3844": {"comment":"D = 0: any statement"},
        "3846": {"comment":"E = the kind's character, B its terminator"},
