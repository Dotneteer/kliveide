        "11113": {"comment":"HL = the slot's"},
        "11114": {"comment":"Less the new one's"},
        "11116": {"comment":"Longer: $0067"},
        "11119": {"synopsis":"The new value no longer than the slot: the difference kept, the value copied over the slot's\nstart (LDIR).","comment":"HL = DEST, the difference kept"},
        "11120": {"comment":"DE = DEST, HL = the new value"},
