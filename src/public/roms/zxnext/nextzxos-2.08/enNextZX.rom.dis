        "10714": {"comment":"Yes: past it, slices"},
        "10717": {"comment":"TO?"},
        "10719": {"comment":"No: report C"},
        "10721": {"synopsis":"TO: CH_ADD back one, to slice (SV_SLICE2).","comment":"HL = CH_ADD"},
        "10722": {"comment":"One byte back"},
        "10723": {"comment":"CH_ADD = it"},
        "10726": {"comment":"Sliced"},
        "10729": {"synopsis":"Checking: B = 0 (A), then SV_PTR.","comment":"B = 0"},
        "10730": {"synopsis":"HL = 0: the element offset so far.","comment":"HL = the offset, 0 so far"},
        "10733": {"synopsis":"One subscript: past '(' or ','. Checking a string: ')' or TO at once is a slice.","comment":"The offset kept"},
        "10734": {"comment":"Past '(' or ','"},
        "10735": {"comment":"The offset back"},
        "10736": {"comment":"A = the name's form"},
