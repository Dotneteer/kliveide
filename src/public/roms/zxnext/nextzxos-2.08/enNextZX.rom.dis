        "14947": {"comment":"On"},
        "14948": {"comment":"Counted"},
        "14949": {"comment":"Masked"},
        "14950": {"comment":"The end byte?"},
        "14951": {"comment":"No: on"},
        "14953": {"comment":"H was $FF (~t)?"},
        "14954": {"comment":"Then t not counted"},
        "14956": {"comment":"The bit-7 byte counted"},
        "14957": {"synopsis":"DE back to the start.","comment":"DE = the start"},
        "14958": {"comment":"Done: DE, BC"},
        "14959": {"synopsis":"A length n: no bank, done (DE, BC); a bank, PEEK_STR_COPY with H = 0, L = $FF, so no byte\nends it.","comment":"A = the bank"},
        "14960": {"comment":"No bank?"},
        "14961": {"comment":"Then done: DE, BC"},
        "14962": {"comment":"H = 0, L = $FF: never an end byte"},
        "14965": {"synopsis":"Copies from the bank into the workspace: the page for bank A (the other ROM's $3308), the\nworkspace taken up to $6000 first when STKBOT is below it (WORK_ROOM), then each byte read\n(the routine at $08FC) and put in one more byte of room (RST $30), until BC runs out or the\nend byte; the terminator of ~t is not counted.","comment":"HL = the address, DE = the end test"},
        "14966": {"comment":"A = the bank"},
        "14967": {"comment":"Kept"},
        "14968": {"comment":"Kept"},
        "14969": {"comment":"BC = $3308"},
        "14972": {"comment":"The bank's page, in the other ROM"},
        "14975": {"comment":"The page into A'"},
        "14976": {"comment":"DE back"},
        "14977": {"comment":"BC back"},
        "14978": {"comment":"The other set"},
        "14979": {"comment":"DE = STKBOT"},
        "14983": {"comment":"HL = $6000"},
        "14987": {"comment":"Less STKBOT"},
        "14989": {"comment":"BC = the difference"},
        "14991": {"comment":"STKBOT below $6000: room up to it"},
        "14994": {"comment":"HL = STKBOT: the copy's start"},
        "14997": {"comment":"Kept"},
        "14998": {"comment":"BC = 0 copied"},
        "15001": {"comment":"Back"},
        "15002": {"synopsis":"One byte, while BC is not 0.","comment":"BC run out?"},
        "15004": {"comment":"Then done"},
        "15006": {"comment":"One less"},
        "15007": {"comment":"A = the byte in the bank ($08FC)"},
        "15010": {"comment":"The next"},
        "15011": {"comment":"The other set"},
        "15012": {"comment":"The count kept"},
        "15013": {"comment":"One byte"},
        "15016": {"comment":"Room for it; DE = its place"},
        "15017": {"comment":"The count back"},
        "15018": {"comment":"The byte stored"},
        "15019": {"comment":"One more copied"},
        "15020": {"comment":"Back"},
        "15021": {"comment":"Masked"},
        "15022": {"comment":"The end byte?"},
        "15023": {"comment":"No: on"},
