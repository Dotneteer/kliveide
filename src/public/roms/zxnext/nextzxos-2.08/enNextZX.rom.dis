        "5778": {"synopsis":"A device in the name: $5B5E = its letter; a name of only \"x:\" sets the default: a drive\nbecomes ROM 2's default too (DOS_SET_DRIVE), then SE_KEEP_DEFAULT.","comment":"$5B5E = the device in the name"},
        "5781": {"comment":"A = the character at CH_ADD"},
