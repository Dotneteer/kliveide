        "8549": {"comment":"Zero?"},
        "8551": {"comment":"Then 0"},
        "8553": {"synopsis":"s$ back; one character on (forward) or back.","comment":"The main set"},
        "8554": {"comment":"s$ back"},
        "8556": {"comment":"Backward?"},
        "8558": {"comment":"Forward"},
        "8559": {"comment":"One on"},
        "8561": {"comment":"Again"},
        "8563": {"synopsis":"One character back.","comment":"The direction kept"},
        "8564": {"comment":"One back"},
        "8566": {"comment":"Again"},
        "8568": {"synopsis":"A match: the saved pointers dropped; the position is the result.","comment":"t$ dropped"},
        "8570": {"synopsis":"s$ dropped; BC = DE, the position.","comment":"s$ dropped"},
        "8572": {"comment":"BC = the position"},
        "8574": {"synopsis":"Stacks BC ($2D2F), then a number (SET_NUMERIC). Also from $08F9 and $0FF0.","comment":"Stacked"},
        "8577": {"synopsis":"A number: SET_NUMERIC."},
        "8580": {"synopsis":"The routine at IX for the '$' form with one argument (USR_DOL_BRACKET): no carry, a string\nresult; then USR_IX_COMMON. Also from $3898.","comment":"DE kept"},
        "8581": {"comment":"No carry: a string"},
        "8582": {"comment":"On"},
        "8584": {"synopsis":"The routine at IX for USR(n) (USR_BRACKET): carry, a number result.","comment":"DE kept"},
        "8585": {"comment":"Carry: a number"},
        "8586": {"synopsis":"DE back, D less 1 (USR_ONE_ARG adds it back).","comment":"DE back"},
        "8587": {"comment":"D less 1"},
        "8588": {"synopsis":"One argument (from $34B6 too): the alternate HL = the address (TAKE_WORD), DE kept, D + 1; A\n= 0 arguments more. Then USR_RUN.","comment":"The flags kept"},
        "8589": {"comment":"DE kept"},
        "8590": {"comment":"BC = the address"},
