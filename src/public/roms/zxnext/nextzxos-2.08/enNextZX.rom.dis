        "10881": {"synopsis":"Past TO: the last index, or the length at ')'.","comment":"The length kept"},
        "10882": {"comment":"Past TO"},
        "10883": {"comment":"The length back"},
        "10884": {"comment":"')'?"},
        "10886": {"comment":"Then the last is the length"},
        "10888": {"comment":"The mark back"},
        "10889": {"comment":"BC = the last, checked against the length"},
        "10892": {"comment":"The mark kept"},
