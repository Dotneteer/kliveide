        "5726": {"comment":"Not '#': the +3DOS error in A ($08EF)"},
        "5730": {"comment":"ROM 2's $0E14, after the command (not in the API list)"},
        "5738": {"synopsis":"A ':' second: the first character may name the device (T, or a drive letter A-P).","comment":"The name's second character"},
