        "10517": {"comment":"No: the next"},
        "10520": {"comment":"The byte after the $7F"},
        "10521": {"comment":"One less to skip"},
        "10522": {"comment":"Its letter"},
        "10523": {"comment":"Bit 7 removed"},
        "10525": {"comment":"The same as C?"},
        "10526": {"comment":"No: the next"},
        "10528": {"comment":"Yes: compared in full"},
        "10530": {"synopsis":"A long name in the list compared with the line's (NAME_MATCH): no match is the next entry.","comment":"The entry kept"},
        "10531": {"comment":"The count kept"},
        "10532": {"comment":"The names compared"},
        "10535": {"comment":"DE back"},
        "10536": {"comment":"The same?"},
        "10538": {"comment":"No: HL back"},
        "10539": {"comment":"The next entry"},
        "10541": {"synopsis":"Matched: type 0 is found (LV_FOUND_LONG); type 1 is LV_LOC_ALIAS with HL at the entry's\nname.","comment":"Type 0: found"},
        "10543": {"comment":"HL = the entry's name"},
        "10544": {"comment":"Type 1"},
        "10547": {"synopsis":"A byte that is not an entry: below $3E it is skipped with 10 more ($22-$3D also\nLV_LOC_FLAG); $40 ends the list (LV_RUN); otherwise it, with bit 6 cleared, is the count to\nskip.","comment":"DE = 10"},
        "10550": {"comment":"Below $22?"},
        "10552": {"comment":"Then 11 bytes on"},
        "10554": {"comment":"Below $3E?"},
