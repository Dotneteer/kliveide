        "15294": {"comment":"Yes: DE + BC"},
        "15297": {"comment":"Stored back"},
        "15300": {"comment":"HL to its high byte again"},
        "15301": {"synopsis":"The next, up to STKEND ($5C65).","comment":"The next pointer"},
