        "7033": {"comment":"DivMMC $0166, HL = $2300, DE = 0"},
        "7039": {"comment":"In DivMMC bank 0"},
        "7043": {"comment":"Units 0 and 1 from drive C:"},
        "7046": {"comment":"Exit L = the next free letter"},
        "7049": {"comment":"A = the entry A"},
        "7050": {"comment":"Next free letter kept"},
        "7051": {"comment":"Entry A kept"},
        "7052": {"comment":"0? Load the system files first"},
