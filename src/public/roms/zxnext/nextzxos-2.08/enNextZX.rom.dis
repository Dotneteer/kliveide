        "15324": {"comment":"HL = the old STKEND"},
        "15325": {"comment":"DE = it, HL = the given HL"},
        "15326": {"comment":"Done"},
        "15327": {"synopsis":"A letter becomes the UDG code $8F + its number (A or a gives $90).\nExit: carry for a letter (ALPHA); no carry, A unchanged, otherwise.","comment":"A letter?"},
        "15330": {"comment":"No: done, no carry"},
        "15331": {"comment":"Its number, 1-26"},
        "15333": {"comment":"$8F + it: $90 for A; carry"},
        "15336": {"synopsis":"RST $00's continuation (BC = $243B, the NextReg select port): NextReg 2 (Reset) read through\nport $253B and written back with only bit 7 kept and bit 0 set, which asks for a soft reset\n(the Next developer guide, nextreg.txt). Nothing follows but $FF filler.","comment":"NextReg 2 (Reset)"},
        "15338": {"comment":"Selected (port $243B)"},
        "15340": {"comment":"BC = $253B, the data port"},
        "15341": {"comment":"Read"},
        "15343": {"comment":"Bit 7 kept"},
        "15345": {"comment":"Bit 0: a soft reset"},
        "15347": {"comment":"Written: the machine resets"},
        "15362": {"synopsis":"Calculator constants for stk-const, five unpacked numbers of 5 bytes (CALC_STK_CONST copies\none): 0, 1, 1/2, pi/2 ($81 49 0F DA A2), 10 (stk-zero, stk-one, stk-half, stk-pi-half, stk-\nten)."},
        "15387": {"synopsis":"Checks there is room for 5 bytes more: STKEND + $55 must stay below SP; report 4 otherwise.\nKeeps HL.\nChanges: F, BC (= $55). From STK_STORE and UNPACK_LITERAL.","comment":"HL kept"},
        "15388": {"comment":"HL = STKEND"},
        "15391": {"comment":"+ $55: 5 bytes and $50 spare"},
        "15394": {"comment":"Past 64K?"},
        "15395": {"comment":"Then report 4"},
        "15397": {"comment":"Below SP?"},
