        "15473": {"comment":"The next"},
        "15474": {"comment":"All five"},
        "15476": {"comment":"Done"},
        "15477": {"synopsis":"SCAN_OP_TABLE's $32: x XOR -1 (-1 stacked as 65535 with its sign byte made $FF, then\nBIT_XOR).","comment":"BC = 65535"},
        "15480": {"comment":"Stacked"},
        "15483": {"comment":"DE = it, the second operand"},
