        "8453": {"comment":"Empty?"},
        "8455": {"comment":"Then A = 0"},
        "8457": {"comment":"Its first character"},
        "8458": {"synopsis":"A kept; BC = n (FP_TO_BC), D = A; A' and F' = the character and n's sign (Z: forward).","comment":"Kept"},
        "8459": {"comment":"BC = n"},
        "8462": {"comment":"D = the character"},
