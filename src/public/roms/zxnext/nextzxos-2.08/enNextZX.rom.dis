        "10747": {"comment":"TO?"},
        "10749": {"comment":"Yes: a slice"},
        "10751": {"synopsis":"Running: offset = offset x this dimension + (subscript - 1) (GET_DIM, SUBSCRIPT, HL_MULT);\nthe next dimension (DJNZ).","comment":"The count and form kept"},
        "10752": {"comment":"The offset kept"},
