        "3965": {"comment":"HL at the letter's list head"},
        "3967": {"comment":"HL = the letter's list"},
        "3971": {"synopsis":"An entry: its statement number (0 ends the list), the name's offset and the line's offset.","comment":"A = the entry's first byte (0 ends the list)"},
        "3973": {"comment":"The list's end?"},
        "3974": {"comment":"Then a plain search of the unindexed lines"},
        "3977": {"comment":"D' = the entry's first byte"},
        "3980": {"comment":"DE = the entry's offset from the program's start"},
        "3984": {"comment":"The list place and the start kept"},
        "3986": {"comment":"HL = the name looked for, past its first letter"},
        "3990": {"comment":"DE = it, HL = the start"},
        "3991": {"comment":"HL = the indexed name's place"},
