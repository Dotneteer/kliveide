        "8504": {"comment":"HL = s$'s character n"},
        "8505": {"comment":"D = c$'s character"},
        "8506": {"comment":"(the other AF)"},
        "8508": {"synopsis":"t$ against s$ from HL: BC characters of s$ left; none is the result 0.","comment":"Characters left?"},
        "8510": {"comment":"No: 0"},
        "8512": {"comment":"s$ kept"},
        "8514": {"comment":"The other set"},
        "8515": {"comment":"t$ kept"},
