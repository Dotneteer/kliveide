        "8474": {"comment":"The variable"},
        "8477": {"comment":"HL' = t$"},
        "8478": {"comment":"Empty?"},
        "8480": {"comment":"Then 0"},
        "8482": {"comment":"The main set"},
        "8483": {"comment":"n kept"},
