        "7087": {"comment":"Nine characters"},
        "7089": {"comment":"Catalogue it"},
        "7092": {"comment":"Failed? No images"},
        "7094": {"comment":"B = the entries; none?"},
        "7095": {"comment":"None: no images"},
        "7097": {"comment":"Count kept"},
