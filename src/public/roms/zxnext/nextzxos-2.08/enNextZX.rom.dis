        "10566": {"synopsis":"One variable: its first byte without bit 7 against C; $80 ends the area (LV_END_AREA). A $7F\n(a long string name) is compared by the byte after it, then in full (LV_LONG_CMP).","comment":"A = the variable's first byte"},
        "10567": {"comment":"Bit 7 removed"},
        "10569": {"comment":"$80: the end of the area?"},
        "10571": {"comment":"The same letter and form?"},
        "10572": {"comment":"The same?"},
