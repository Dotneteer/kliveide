      ],
      "lineAnnotations": {
        "0": {"synopsis":"RST $00, reset: interrupts off, then the Next's register set-up (INIT_NEXTREGS).","comment":"Interrupts off for the start-up"},
        "1": {"comment":"On to the Next's register set-up"},
        "8": {"synopsis":"RST $08: jumps to $15E0, which swaps SP with the one kept at $5B6A and pages RAM bank 7 in\nat $C000 (NextReg $8E = $78). RST $30 undoes it.","comment":"Bank 7 and the other stack"},
        "11": {"synopsis":"The text \"*.*\", ended by $FF (then a $00): read from $2CEB, $3334 and $38C6."},
        "16": {"synopsis":"RST $10: prints the character in A through the current channel, by ROM 3's PRINT_A (RST $28\nwith the word $0010), and returns in this ROM.","comment":"ROM 3's PRINT_A prints A through the current channel"},
        "19": {"comment":"Back from ROM 3 with ROM 0 selected again"},
        "20": {"comment":"Also the start-up; nothing in this page jumps here"},
        "24": {"synopsis":"RST $18: calls the address in the word after the RST in ROM 1 (the routine at $3E80).","comment":"The word after the RST is an address in ROM 1"},
        "27": {"synopsis":"The text \"<DIR>\", its last character with bit 7 set: read from $37E4."},
        "32": {"synopsis":"RST $20: calls the address in the word after the RST in ROM 2 (the routine at $3E00).","comment":"The word after the RST is an address in ROM 2"},
        "40": {"synopsis":"RST $28: calls the address in the word after the RST in ROM 3 and comes back to this ROM\nafter the word. BC is parked at $5B54 while the word is read; the second half is\nROM3_CALL_GO.","comment":"BC parked while the address is read"},
        "44": {"comment":"HL = the address of the word after the RST"},
        "45": {"comment":"On in the second half"},
        "48": {"synopsis":"RST $30: jumps to $15C9, which pages RAM bank 0 back in at $C000 (NextReg $8E = $08) and\nswaps SP back with the one kept at $5B6A. Undoes RST $08.","comment":"Bank 0 and the machine stack again"},
        "51": {"synopsis":"A channel M's output, the word at +$05 of the channel M template in ROM 2 ($1287 there): A\nstored at the channel's next byte (MEM_NEXT_BYTE; end of file when it is full).","comment":"HL = where the channel's next byte goes"},
        "54": {"comment":"The byte stored"},
        "56": {"synopsis":"The maskable interrupt (IM 1): AF and HL kept, H = 0, A = $80, then on at INT_DIVMMC past\nthe text between.","comment":"AF and HL kept for the return at $0060"},
        "58": {"comment":"H = 0, passed on to the DivMMC's code"},
        "60": {"comment":"$80: the DivMMC's memory paged in at $0000"},
        "62": {"comment":"Past the text between"},
        "65": {"synopsis":"The text \"<RUN>\", its last character with bit 7 set: read from $37E9."},
        "70": {"synopsis":"Port $E3 (DivMMC control) = A: with $80 the DivMMC's memory replaces this ROM at\n$0000-$3FFF, so the instructions after this OUT are fetched from it, not from the bytes\nhere. INT_RETURN at $0060 is where the interrupt comes back.","comment":"The fetch after this one comes from the DivMMC's memory"},
        "96": {"synopsis":"The end of the interrupt: HL and AF back, interrupts on, return.","comment":"Back from the DivMMC: HL and AF as they were"},
        "98": {"comment":"Interrupts on again"},
        "102": {"synopsis":"The non-maskable interrupt: RETN, nothing else.","comment":"NMI: nothing done"},
        "104": {"synopsis":"Calls the address in the word after the CALL in the alternate ROM (NextReg $8C = $80 puts it\nin this ROM's place). BC is parked at $5B54 while the word is read; the way back is $007B,\nrun in the alternate ROM.\nEntry: the word after the CALL.\nChanges: as the routine called.","comment":"BC parked while the address is read"},
        "108": {"comment":"HL = the address of the word after the CALL"},
        "109": {"comment":"BC = the address in the alternate ROM"},
        "111": {"comment":"B = the address's high byte"},
        "113": {"comment":"The return address past the word, HL back"},
        "114": {"synopsis":"CALL_ALT_ROM's second half, also jumped to from $092E with BC the address: the way back\n($007B) and the address stacked, BC from $5B54, then ALT_ROM_ON.","comment":"The way back goes through $007B"},
        "118": {"comment":"The address to go to"},
        "119": {"comment":"BC back as it was"},
        "123": {"synopsis":"NextReg $8C = $80: the alternate ROM in place of this one; the RET goes to the address on\nthe stack, now in the alternate ROM.","comment":"The alternate ROM on: RET goes to the address"},
        "128": {"synopsis":"RST $28's second half, HL the address of the word after the RST: BC = the word, the return\naddress moved past it; then ROM3_CALL_BC.","comment":"BC = the address in ROM 3"},
        "130": {"comment":"B = the address's high byte"},
        "132": {"comment":"The return address past the word, HL back"},
        "133": {"synopsis":"Calls the address in BC in ROM 3, the caller's BC back from $5B54: the way back ($5B4D,\nwhich selects ROM 0) and the address stacked, then $5B48 selects ROM 3 and returns into the\naddress. Also from CHAN_IO_ROM3 ($0419, $0420).","comment":"The way back: $5B4D selects ROM 0"},
        "137": {"comment":"The address to go to"},
        "138": {"comment":"BC back as it was"},
        "142": {"comment":"ROM 3 selected, RET goes to the address"},
        "145": {"synopsis":"Copied to $5B00 at start-up with the routines after it ($0091-$00E2 to $5B00-$5B51, by\nCOPY_RAM_CODE) and run from there: flips bit 4 of the paging byte at $5B5C (port $7FFD) and\nbit 2 of the one at $5B67 (port $1FFD), with interrupts off for the writes.\nChanges: nothing (AF and BC kept).","comment":"AF and BC kept"},
        "147": {"comment":"Port $7FFD and its copy at $5B5C"},
        "153": {"comment":"Bit 4, the low bit of the ROM number, flipped"},
        "159": {"comment":"The paging byte written out"},
        "161": {"synopsis":"At $5B10: SWAP_ROM's second half, entered on its own by SWAP_HIGH_GO with AF and BC already\nstacked: only bit 2 of $5B67 (port $1FFD), the ROM number's high bit, flipped.","comment":"Port $1FFD and its copy at $5B67"},
        "167": {"comment":"Bit 2, the high bit of the ROM number, flipped"},
        "172": {"comment":"Written out"},
        "175": {"comment":"BC and AF back"},
        "178": {"synopsis":"At $5B21: the ROMs swapped back (SWAP_ROM), then a jump to the address in $5B5A, HL kept.","comment":"The ROMs swapped back"},
        "181": {"comment":"HL kept while the address at $5B5A is fetched"},
        "185": {"comment":"The address in $5B5A on the stack, HL back"},
        "186": {"comment":"Jumps there"},
        "187": {"synopsis":"At $5B2A: flips only the ROM number's high bit (SWAP_ROM_HIGH at $5B10), then goes on at\n$5B34 (GO_5B5A).","comment":"The way on: $5B34, which jumps to the address at $5B5A"},
        "192": {"comment":"AF and BC stacked as SWAP_ROM_HIGH expects"},
        "194": {"comment":"Only the ROM's high bit flipped"},
        "197": {"synopsis":"At $5B34: jumps to the address in $5B5A, keeping every register.","comment":"HL kept while the address at $5B5A is fetched"},
        "201": {"comment":"The address in $5B5A on the stack, HL back"},
        "202": {"comment":"Jumps there"},
        "203": {"synopsis":"At $5B3A: ROM 1's $0AB0 stacked, then on into SEL_ROM1, whose RET goes there.","comment":"ROM 1's $0AB0 as the place RET goes to"},
        "207": {"synopsis":"At $5B3E: NextReg $8E = $01, ROM 1 selected (bit 3 clear: the RAM bank at $C000 left as it\nis), and a return into ROM 1.","comment":"ROM 1 selected; RAM bank left as it is"},
        "211": {"comment":"Returns into the ROM now selected"},
        "212": {"synopsis":"At $5B43: NextReg $8E = $02, ROM 2 selected, and a return into it.","comment":"ROM 2 selected"},
        "217": {"synopsis":"At $5B48: NextReg $8E = $03, ROM 3 selected, and a return into it.","comment":"ROM 3 selected"},
        "222": {"synopsis":"At $5B4D: NextReg $8E = $00, ROM 0 (this ROM) selected, and a return into it. Also the\nroutine word of every channel whose code is in this ROM (CHAN_IO_FROM3).","comment":"ROM 0 selected"},
        "227": {"synopsis":"Copies the $52 bytes at $0091-$00E2 (SWAP_ROM to SEL_ROM0) to $5B00-$5B51.\nExit: DE = $5B52, BC = 0.","comment":"The routines at $0091-$00E2"},
        "230": {"comment":"Copied to $5B00-$5B51"},
        "233": {"comment":"$52 bytes"},
        "239": {"synopsis":"The start-up (from START):\n1. CPU speed 28 MHz, +2A/+3 display timing, stackless NMI, every internal port decode on,\n   the expansion bus off, the +3's memory mapping mode; NextReg $06 keeps only bits 6 and 2.\n2. Attributes all 0.\n3. RAM_MARK and RAM_TEST: the RAM banks marked, counted and tested; $5B69 = the last bank's\n   number.\n4. SP = $5BFF, ROM 2's $1EDF, ROM 0 with RAM bank 0, IM 1, the ROM-switching routines to\n   $5B00, P_RAMT = $FFFF, the UDGs from ROM 3's A-U pictures at $FF58 (UDG, RAMTOP = $FF57).\n5. On at RESTART_SETUP with B = 0.","comment":"CPU speed 3 (28 MHz)"},
        "243": {"comment":"Display timing of the +2A/+3 (bit 7: change allowed)"},
        "247": {"comment":"NextReg $C0 = $08: stackless NMI response"},
        "251": {"comment":"Every internal port decoding on"},
        "265": {"comment":"Expansion bus off"},
        "275": {"comment":"Memory mapping mode 0: the +3's paging"},
        "278": {"comment":"NextReg $06 (Peripheral 2) selected"},
        "285": {"comment":"BC = $253B, the NextReg data port"},
        "286": {"comment":"Its value read"},
        "288": {"comment":"Only bits 6 and 2 kept"},
        "290": {"comment":"Written back"},
        "292": {"comment":"The attributes, $5800-$5AFF, all made 0"},
        "295": {"comment":"DE one on: the LDIR spreads the first byte"},
        "298": {"comment":"$5800 = 0 (L = 0)"},
        "299": {"comment":"$2FF bytes more"},
        "304": {"synopsis":"Marks the 112 16K RAM banks, 0 up: each one's two 8K pages into MMU 6 and MMU 7\n($C000-$FFFF); the bank's last byte ($FFFF) kept at $4000 + bank (0 kept for banks 0-11),\nthen $FFFF = $BB. Banks 0-11 are also cleared to 0 below the marker ($C000-$FFFE), bank 8\nonly from $E000. A missing bank shows as a missing marker in RAM_TEST.","comment":"B = 112 banks, C = the bank number from 0"},
        "307": {"comment":"HL = where each bank's last byte is kept, from $4000"},
        "310": {"synopsis":"One bank: bank C.","comment":"A = the bank number"},
        "312": {"comment":"The bank's two 8K pages into MMU 6 and MMU 7"},
        "316": {"comment":"A = 2 x bank + 1, the second page"},
        "320": {"comment":"A = the bank number again"},
        "322": {"comment":"HL' = $FFFF, the bank's last byte"},
        "325": {"comment":"A' = the bank number"},
        "326": {"comment":"Its last byte"},
        "328": {"comment":"Kept at $4000 + bank"},
        "329": {"comment":"Bank 0-11?"},
        "334": {"comment":"Then 0 is kept instead"},
        "336": {"synopsis":"The next kept byte's place; the marker written.","comment":"The next bank's place"},
        "337": {"comment":"A = the bank number"},
        "339": {"comment":"The marker $BB in the bank's last byte"},
        "341": {"comment":"HL' = $FFFE, DE' = $FFFD"},
        "345": {"comment":"BC' = the rest of the bank, $3FFE bytes"},
        "348": {"comment":"Bank 12 or above: left as it is"},
        "352": {"comment":"Bank 8?"},
        "356": {"comment":"Bank 8: only $E000 up"},
        "358": {"synopsis":"The bank's $FFFE made 0 and copied down over the rest.","comment":"Zero filled downwards from $FFFE"},
        "362": {"synopsis":"The next bank.","comment":"C = the next bank number"},
        "364": {"comment":"All 112 banks"},
        "366": {"comment":"On to the test"},
        "368": {"synopsis":"A RAM bit failed RAM_TEST's write and read back (Z: it would not set; NZ: it would not\nclear). A = 8 - E, the bit's number in bank 0 (later banks run E from 0, so the number is\nonly right for bank 0). Z: the border shows the number for good. NZ: it flashes between the\nnumber and the number with its colour bits flipped, for ever.","comment":"A = the bank number, the test's flags kept in F'"},
        "369": {"comment":"L = 8 - E, the failing bit for bank 0"},
        "373": {"comment":"The test's flags back"},
        "374": {"comment":"A = the bit number"},
        "375": {"comment":"Bit could not be set: one colour; otherwise a flash"},
        "377": {"comment":"The border shows the bit number"},
        "379": {"synopsis":"Stopped here.","comment":"Stopped for good"},
        "381": {"synopsis":"H = the flipped colour, L = the number.","comment":"H = the bit number with its colour bits flipped"},
        "384": {"synopsis":"One flash: 32 writes of H, 256 of L.","comment":"B = 32"},
        "386": {"synopsis":"The flipped colour.","comment":"32 border writes of the flipped colour"},
        "391": {"synopsis":"The bit number's colour.","comment":"256 border writes of the bit number"},
        "396": {"comment":"Again, for ever"},
        "398": {"synopsis":"Counts and tests the RAM banks after RAM_MARK, 0 up: a bank whose last byte is not the\nmarker $BB ends the count; otherwise that byte gets its kept value back (RAM_MARK's), and\nthe byte at $DCBA is tested: each of its bits written alone and read back set, then every\nother bit written and the bit read back clear (RAM_FAIL when not), and its value put back.\nBank 0 tests each bit once, later banks 256 times (E is not reset).\nExit: $5B69 = the number of the last bank found (the count less 1, $6F for all 112).","comment":"A = bank 0"},
        "399": {"comment":"BC = the kept last bytes, from $4000"},
        "402": {"synopsis":"One bank: bank A.","comment":"D = 1, the bit; E = 8, the count"},
        "405": {"comment":"The bank's two 8K pages into MMU 6 and MMU 7"},
        "409": {"comment":"A = 2 x bank + 1, the second page"},
        "413": {"comment":"A = the bank number"},
        "415": {"comment":"A' = the bank number"},
        "416": {"comment":"The bank's last byte"},
        "419": {"comment":"Still the marker $BB?"},
        "422": {"comment":"No: no RAM there, the count ends"},
        "424": {"comment":"The byte kept for this bank"},
        "425": {"comment":"BC = the next bank's"},
        "426": {"comment":"Put back in the bank's last byte"},
        "427": {"comment":"$DCBA: the byte tested in each bank"},
        "430": {"comment":"Its value kept in XL"},
        "433": {"synopsis":"One bit: the bit D.","comment":"The bit alone written"},
        "435": {"comment":"Did it set?"},
        "437": {"comment":"No: RAM fault"},
        "439": {"comment":"Every bit but this one written"},
        "441": {"comment":"Did it clear?"},
        "443": {"comment":"No: RAM fault"},
        "445": {"comment":"The next bit"},
        "447": {"comment":"E not reset: banks after 0 run 256 times"},
        "450": {"comment":"The tested byte's value back"},
        "453": {"comment":"A = the next bank number"},
        "455": {"comment":"All 112 banks?"},
        "459": {"comment":"Then A = 112"},
        "460": {"synopsis":"The count done: A = the bank number reached (112 after all of them).","comment":"A = the bank number reached"},
        "461": {"comment":"$5B69 = the last bank's number (the count less 1)"},
        "465": {"comment":"The stack below $5C00"},
        "468": {"comment":"ROM 2's $1EDF"},
        "471": {"comment":"ROM 0 and RAM bank 0 at $C000"},
        "475": {"comment":"Interrupt mode 1"},
        "477": {"comment":"The ROM-switching routines into $5B00"},
        "480": {"comment":"P_RAMT = $FFFF"},
        "486": {"comment":"ROM 3's character set pictures A to U ($3E08-$3EAF)"},
        "489": {"comment":"$A8 bytes, 21 characters"},
        "492": {"comment":"HL = their last byte, DE = $FFFF"},
        "493": {"comment":"Copied down by ROM 3's LDDR (MAKE_ROOM's tail)"},
        "496": {"comment":"HL = $FF57, below them"},
        "497": {"comment":"UDG = $FF58"},
        "501": {"comment":"RAMTOP = $FF57"},
        "505": {"comment":"B = 0: a cold start"},
        "507": {"synopsis":"The rest of the start-up, B = 0 from INIT_NEXTREGS (a cold start) or B = 1 from page 1's\n$3440 (through its CALL $3E80):\n1. IY = $5C3A; the last bank's number and UDG kept in C' and HL'.\n2. The DivMMC's automap entry points ($0008, $0038, $3Dxx, the tape traps, the NMI button),\n   the +3 FDC port traps, then NextRegs $05, $08, $06 and $0A changed bit by bit (joysticks,\n   no contention, DACs, TurboSound, hotkeys, the AYs reset, DivMMC automap).\n3. The ROM-switching routines to $5B00 again and $5B52-$5CB1 cleared; SP and the other stack\n   ($5B6A) = $5BFF; ROM 1's $3471.\n4. The 48K system variables: CHARS, FLAGS, ERR_NR, CHANS from ROM 3's CHANNEL_DATA, DATADD,\n   PROG, VARS, E_LINE, WORKSP, the colours ($38), a white border, REPDEL/REPPER, KSTATE,\n   STRMS from ROM 3's STREAM_DATA, DF_SZ = 2; NextZXOS's $5B5D, $5B61, $5B63, $5B69,\n   $5B77-$5B7A, $5B88-$5B89.\n5. Interrupts on, the screen cleared (ROM 3's CLS_CMD), then bank 7 and its stack (RST $08),\n   the bank-7 variables at $D5B8, $D633, $D6DA, $D73D, $D750 set, ROM 1's $1511 and $2BCA\n   (with A = B), and on to the start-up menu's loop at $11BE.","comment":"IY on ERR_NR, as the 48K ROM keeps it"},
        "511": {"comment":"The number of the last RAM bank"},
        "514": {"comment":"C = it, kept in C' over the clearing"},
        "515": {"comment":"HL = UDG, kept in HL'"},
        "519": {"comment":"DivMMC automap on $0008 and $0038"},
        "523": {"comment":"No validity or timing restriction for those"},
        "531": {"comment":"Automap on $3Dxx, the tape traps and the NMI button"},
        "535": {"comment":"The +3 FDC port traps on"},
        "539": {"comment":"NextReg $05 (Peripheral 1) selected and read"},
        "544": {"comment":"50/60 Hz and scandoubler kept"},
        "546": {"comment":"Both joysticks' modes set"},
        "548": {"comment":"Written back"},
        "550": {"comment":"NextReg $08 (Peripheral 3) selected and read"},
        "555": {"comment":"No contention, DACs, port $FF read and TurboSound on"},
        "557": {"comment":"Written back"},
        "559": {"comment":"NextReg $06 (Peripheral 2) selected and read"},
        "564": {"comment":"Bits 6 and 2 kept"},
        "566": {"comment":"Hotkeys and Multiface NMI on, every AY held in reset"},
        "568": {"comment":"Written back"},
        "570": {"comment":"Audio chip mode 0 (YM): the AYs out of reset"},
        "574": {"comment":"NextReg $0A (Peripheral 5) selected and read"},
        "579": {"comment":"DivMMC automap on"},
        "581": {"comment":"Written back"},
        "583": {"comment":"The ROM-switching routines into $5B00 again"},
        "586": {"comment":"HL = $5B52, the byte after them"},
        "588": {"comment":"Made 0 (C = 0 after the LDIR)"},
        "589": {"comment":"DE = $5B53"},
        "590": {"comment":"$5B52-$5CB1 cleared: up to RAMTOP's word"},
        "595": {"comment":"The stack below $5C00"},
        "598": {"comment":"The other stack starts there too"},
        "602": {"comment":"ROM 1's $3471: the machine stack below RAMTOP"},
        "605": {"comment":"$5B5D = $CF"},
        "610": {"comment":"RASP = $40, PIP = 0"},
        "616": {"comment":"C = the last bank's number, HL = UDG"},
        "617": {"comment":"$5B69 = the last bank's number again"},
        "621": {"comment":"UDG back"},
        "624": {"comment":"B: 0 for a cold start, 1 from page 1"},
        "625": {"comment":"Calls $2329"},
        "628": {"comment":"ROM 1's $14B9"},
        "631": {"comment":"CHARS = $3C00: ROM 3's character set at $3D00"},
        "637": {"comment":"FLAGS bit 4 set"},
        "641": {"comment":"ERR_NR = $FF: no error"},
        "646": {"comment":"$5B77, $5B78, $5B88 and $5B89 = $FF"},
        "649": {"comment":"And $5B78"},
        "652": {"comment":"$5B88 and $5B89"},
        "658": {"comment":"$5B79 and $5B7A = $54"},
        "666": {"comment":"CHANS = $5CB6"},
        "672": {"comment":"ROM 3's CHANNEL_DATA, $15 bytes"},
        "678": {"comment":"DE = CHANS, HL = the source"},
        "679": {"comment":"Copied by ROM 3's LDIR (MOVE_FP's tail)"},
        "682": {"comment":"HL = the byte after the copy"},
        "683": {"comment":"DATADD = the channel data's end marker"},
        "687": {"comment":"PROG = the byte after it"},
        "691": {"comment":"VARS = PROG too"},
        "694": {"comment":"$80: no variables"},
        "696": {"comment":"E_LINE = the byte after"},
        "700": {"comment":"An empty edit line: $0D, then $80"},
        "705": {"comment":"WORKSP, STKBOT and STKEND after it"},
        "709": {"comment":"STKBOT"},
        "712": {"comment":"STKEND"},
        "715": {"comment":"$38: black on white"},
        "717": {"comment":"ATTR_P and ATTR_T"},
        "723": {"comment":"$5B61 and $5B63"},
        "729": {"comment":"BORDCR"},
        "732": {"comment":"White border"},
        "736": {"comment":"REPDEL = $23, REPPER = $05"},
        "742": {"comment":"KSTATE at $5C00 and $5C04 = $FF: no key"},
        "748": {"comment":"ROM 3's STREAM_DATA, $0E bytes"},
        "751": {"comment":"To STRMS"},
        "757": {"comment":"Copied by ROM 3's LDIR"},
        "760": {"comment":"DF_SZ = 2"},
        "764": {"comment":"Interrupts on"},
        "765": {"comment":"ROM 3's CLS_CMD clears the screen"},
        "768": {"comment":"AF = the word pushed at $0270"},
        "769": {"comment":"Bank 7 and the other stack"},
        "770": {"comment":"The word on the new stack"},
        "771": {"comment":"The stripe pattern to $D750"},
        "774": {"comment":"ROM 1's $1511"},
        "777": {"comment":"Six bytes for $D5B8-$D5BD"},
        "783": {"comment":"6 bytes"},
        "788": {"comment":"HL = $D5BE"},
        "789": {"comment":"Carry set for $0F3C"},
        "793": {"comment":"$D73D = $20, the row width of $094C's buffer"},
        "799": {"comment":"$D73F = $23, a row's length with its 3 extra bytes"},
        "805": {"comment":"$5C81 = 3"},
        "810": {"comment":"ROM 2's $1E43"},
        "813": {"comment":"$10A5 to $D633, by $0FD5"},
        "822": {"comment":"Copied by $0FD5"},
        "825": {"comment":"$10C5 to $D6DA, by $0FD5"},
        "834": {"comment":"Copied by $0FD5"},
        "837": {"comment":"Calls $1003"},
        "840": {"comment":"Calls $0F82"},
        "843": {"comment":"A: 0 for a cold start, 1 from page 1"},
        "844": {"comment":"ROM 1's $2BCA"},
        "847": {"comment":"TV_FLAG bit 5 set"},
        "851": {"comment":"DF_SZ = 2"},
        "855": {"comment":"On to the start-up menu's loop"},
        "858": {"synopsis":"Six bytes copied to $D5B8-$D5BD by RESTART_SETUP ($0309): $00, $00, $00, $03, $00, $3C."},
        "864": {"synopsis":"Copies the 16 bytes at $0DF7 (bit patterns $01, $03 ... $FF, $FE ... $00) to $D750.\nChanges: BC, DE, HL.","comment":"The 16 bytes at $0DF7"},
        "867": {"comment":"To $D750 in bank 7"},
        "873": {"comment":"Copied"},
        "876": {"synopsis":"The output or input of a channel whose routine word is $5B4D (SEL_ROM0), as ROM 3's\nCALL_AT_HL calls it: $5B4D selects this ROM and returns to $15FE here, which loads HL =\nCURCHL and jumps on to this routine. A = the character to write; DE (from ROM 3) is the\naddress of the routine word + 1, so 1 for output and 3 for input.\n1. Channels 'S' and 'K': the window whose record is at $F200 + 256 x the low 4 bits of\n   $5C7F, by $2767.\n2. Channel 'D': the driver's channel call (DRIVER_CHAN_OP), output or input.\n3. Other channels: the output routine (the word at +5) or the input routine (+7) run with IX\n   = CURCHL; an input with neither carry nor Z is end of file (error $07).\nExit: back to ROM 3's $15FE (CHAN_BACK_ROM3).","comment":"HL = the channel's letter"},
        "880": {"comment":"B = the character"},
        "881": {"comment":"A = the letter"},
        "882": {"comment":"'S'?"},
        "884": {"comment":"No"},
        "886": {"synopsis":"A window channel ('S' or 'K').","comment":"IX kept"},
        "888": {"comment":"The low 4 bits of $5C7F"},
        "893": {"comment":"IX = $F200 + 256 x them: the window's record"},
        "900": {"comment":"A = the character"},
        "901": {"comment":"Through the window by $2767"},
        "904": {"comment":"IX back"},
        "906": {"synopsis":"ROM 3's $15FE stacked, the end of its CALL_AT_HL.","comment":"The way back to ROM 3's $15FE"},
        "910": {"synopsis":"ROM 3 selected ($5B48), which returns to the address stacked.","comment":"ROM 3 selected, RET to the way back"},
        "913": {"synopsis":"Not 'S'.","comment":"'K'?"},
        "915": {"comment":"Yes: a window too"},
        "917": {"comment":"DE = CURCHL, HL = DE from ROM 3: the word read + 1"},
        "921": {"comment":"C = 1 for the output word, 3 for the input word"},
        "925": {"comment":"HL = CURCHL"},
        "926": {"comment":"HL = the channel's word at +5"},
        "930": {"comment":"'D'?"},
        "932": {"comment":"Yes: a driver's channel"},
        "934": {"comment":"The input word?"},
        "935": {"comment":"Yes"},
        "937": {"comment":"HL = the output routine, the word at +5"},
        "939": {"comment":"HL = the routine's address"},
        "941": {"comment":"The way back to ROM 3's $15FE"},
        "945": {"comment":"A = the character"},
        "946": {"comment":"IX = CURCHL for the routine"},
        "952": {"comment":"The routine run"},
        "955": {"comment":"IX back"},
        "957": {"comment":"Back to ROM 3"},
        "959": {"synopsis":"Jumps to HL: a CALL here calls the routine at HL.","comment":"The routine at HL"},
        "960": {"synopsis":"Channel 'D': its driver's output or input call.","comment":"A = 0 (output) or 2 (input)"},
        "962": {"comment":"The driver's call made"},
        "965": {"comment":"Back to ROM 3"},
        "967": {"synopsis":"The input routine, the word at +7.","comment":"HL = the input routine, the word at +7"},
        "971": {"comment":"HL = the routine's address"},
        "973": {"comment":"The way back to ROM 3's $15FE"},
        "977": {"comment":"IX = CURCHL for the routine"},
        "983": {"comment":"The routine run"},
        "986": {"comment":"IX back"},
        "988": {"comment":"Carry: a character; back to ROM 3"},
        "990": {"comment":"Z: none yet; back to ROM 3"},
        "992": {"synopsis":"Error $07 (report 8, end of file) through $27B0.","comment":"Error $07: end of file"},
        "997": {"synopsis":"The I/O of the current channel for ROM 2's stream calls: its IDE_STREAM_OUT ($005F, through\n$155B) with DE = 0, IDE_STREAM_IN ($005C, through $1565) with DE = 2 and IDE_STREAM_PTR\n($0062, through $156A) with DE = 4, all with the caller's registers in the other set (C the\nbyte to write, B the pointer operation).\n1. A channel of ROM 3's kind (output word not $5B4D): CHAN_IO_ROM3.\n2. One of this ROM's channels: 'S' and 'K' through the window routines (CHAN_IO_WINDOW), 'D'\n   through the driver (CHAN_IO_DRIVER), the others through the word at +5 + DE\n   (CHAN_IO_WORD).\nExit: carry, success; an input returns its byte in A.","comment":"HL = IX = CURCHL"},
        "1003": {"comment":"Is its output word $5B4D (a routine in this ROM)?"},
        "1008": {"comment":"High byte $5B?"},
        "1013": {"comment":"No: a channel of ROM 3's kind"},
        "1015": {"comment":"The channel's letter: 'S'?"},
        "1022": {"comment":"'K'?"},
        "1026": {"comment":"'D'?"},
        "1030": {"comment":"Another of this ROM's channels"},
        "1032": {"synopsis":"A channel of ROM 3's kind: its output (DE = 0) or input routine (DE = 2) run in ROM 3\nthrough ROM3_CALL_BC; a pointer operation is not possible (CHAN_BAD_IO).","comment":"A pointer operation (DE = 4)?"},
        "1035": {"comment":"Not possible for this kind"},
        "1038": {"comment":"BC = the routine, the word at +DE"},
        "1040": {"comment":"BC = the routine's address"},
        "1042": {"comment":"Input (DE = 2)?"},
        "1046": {"comment":"A = the caller's C, the byte to write"},
        "1049": {"comment":"The output routine run in ROM 3"},
        "1052": {"synopsis":"Input: the routine run in ROM 3, TV_FLAG bit 3 cleared first.","comment":"TV_FLAG bit 3 cleared"},
        "1056": {"comment":"The input routine run in ROM 3"},
        "1059": {"synopsis":"Input done: carry, a character; NZ, end of file (CHAN_EOF); Z, none yet: ROM 1's $2B50 (the\nBREAK key) and the input tried again from CHAN_IO_ROM2.","comment":"Carry: a character, done"},
        "1060": {"comment":"NZ: end of file"},
        "1062": {"comment":"ROM 1's $2B50: the BREAK key tested"},
        "1065": {"comment":"DE = 2: the input once more"},
        "1070": {"synopsis":"Channels 'S' and 'K': IX = the window's record at $F200 + 256 x the low 4 bits of $5C7F;\ninput by $11E0, a pointer operation by $2B9A, output by $275B.","comment":"The low 4 bits of $5C7F"},
        "1075": {"comment":"IX = $F200 + 256 x them: the window's record"},
        "1082": {"comment":"Input (DE = 2)?"},
        "1085": {"comment":"Then the window's input at $11E0"},
        "1088": {"comment":"Pointer operation (DE = 4)?"},
        "1090": {"comment":"The caller's registers"},
        "1091": {"comment":"Then $2B9A"},
        "1094": {"comment":"A = the byte to write"},
        "1095": {"comment":"Through the window by $275B"},
        "1098": {"synopsis":"Another channel of this ROM: DE = the word at +$05 + DE, the routine (output, input or\npointer); input returns to CHAN_IO_AGAIN, the others run with A = the caller's C and the\ncaller's registers.","comment":"A = 0, 2 or 4"},
        "1099": {"comment":"HL = the word at +5 + DE: the routine"},
        "1103": {"comment":"DE = the routine"},
        "1106": {"comment":"On the stack, to be jumped to"},
        "1107": {"comment":"Input?"},
        "1111": {"comment":"The caller's registers"},
        "1112": {"comment":"A = the caller's C"},
        "1113": {"comment":"Jumps to the routine"},
        "1114": {"synopsis":"Input: the routine run with CHAN_IO_AGAIN as its return.","comment":"Input returns to CHAN_IO_AGAIN"},
        "1118": {"comment":"Jumps to the routine"},
        "1119": {"synopsis":"Channel 'D': HL = its driver id and handle at +5, BC = the caller's BC. A pointer operation\n(DE = 4) becomes 4 + 2 x B (get, set, size); setting it takes IX = the caller's HL and DE =\nthe caller's DE. Then DRIVER_CHAN_OP and CHAN_IO_AGAIN.","comment":"HL = the channel's driver id at +5"},
        "1123": {"comment":"BC = the caller's BC"},
        "1127": {"comment":"A pointer operation?"},
        "1132": {"comment":"A = 4 + 2 x B: 4 get, 6 set, 8 the size"},
        "1134": {"comment":"Set?"},
        "1138": {"comment":"IX = the caller's HL, DE = the caller's DE"},
        "1145": {"comment":"Never taken: Z from the CP $06"},
        "1147": {"synopsis":"B = the caller's C, then the driver's call.","comment":"B = the byte to write"},
        "1148": {"comment":"The driver's call made"},
        "1151": {"comment":"Ends as an input does"},
        "1153": {"synopsis":"One of a driver's channel calls, through ROM 2's IDE_DRIVER ($01CF): C = the driver id (at\nHL), D = the channel handle (at HL + 1), E = B, B = $FB + A/2: A = 0 output ($FB), 2 input\n($FC), 4 get the pointer ($FD), 6 set it ($FE), 8 the size ($FF).\nExit: carry, done; A = $FF from the driver, Z and no carry; A = $FE, end of file (CHAN_EOF);\notherwise error $12 (CHAN_BAD_IO).","comment":"C = the driver's id, H = the channel's handle"},
        "1156": {"comment":"D = the handle, E = the byte from B"},
        "1158": {"comment":"B = $FB + A/2: the driver's channel call"},
        "1163": {"comment":"ROM 2's IDE_DRIVER ($01CF)"},
        "1166": {"comment":"Carry: done"},
        "1167": {"comment":"A = $FF: done, no carry (Z)"},
        "1169": {"comment":"A = $FE: end of file"},
        "1173": {"synopsis":"Error $12 (report J) through $27B0: an operation the channel cannot do.","comment":"Error $12: not possible on this channel"},
        "1178": {"synopsis":"A channel M's input, the word at +$07 of the channel M template in ROM 2: A = the next byte\nof the memory (MEM_NEXT_BYTE), with carry; end of file past the end.","comment":"HL = where the next byte is"},
        "1181": {"comment":"A = it"},
        "1183": {"synopsis":"A channel M's third routine, the word at +$09 of its template: B = 0: DEHL = the position\n(the word at CURCHL + $0F); B = 1 sets the position (DE must be 0, HL below the length); B =\n2 or more: DEHL = the length, the word at +$0D. A position outside is end of file.","comment":"B = 0?"},
        "1186": {"comment":"B = 0: the position, the word at +$0F"},
        "1191": {"synopsis":"B not 0: B = 1 sets the position; B = 2 or more: MEM_PTR_LENGTH.","comment":"B = 1? Otherwise the length"},
        "1193": {"comment":"B = 1: DE must be 0"},
        "1198": {"comment":"HL, the new position, kept"},
        "1199": {"comment":"The word at +$0D: the length"},
        "1206": {"comment":"DE = the length"},
        "1209": {"comment":"DE = the length less 1"},
        "1212": {"comment":"BC = the new position"},
        "1213": {"comment":"Past the length?"},
        "1217": {"comment":"Then end of file"},
        "1220": {"comment":"The position stored at +$0F"},
        "1224": {"synopsis":"DEHL = the length, the word at +$0D.","comment":"The word at +$0D: the length"},
        "1227": {"synopsis":"HL = the word at CURCHL + DE, DE = 0.","comment":"HL = CURCHL + DE"},
        "1231": {"comment":"HL = the word there"},
        "1235": {"comment":"DE = 0: the high word"},
        "1239": {"synopsis":"The address of channel M's next byte: the channel (CURCHL) holds the length at +$0D, the\nposition at +$0F and the start address at +$11. Past the end: end of file (CHAN_EOF).\nExit: HL = the start + the position, the position one on, carry.\nChanges: BC, DE, HL.","comment":"HL = CURCHL + $0D"},
        "1246": {"comment":"BC = the length"},
        "1250": {"comment":"DE = the position"},
        "1254": {"comment":"Past the end?"},
        "1255": {"comment":"The position less the length"},
        "1260": {"comment":"Then end of file"},
        "1263": {"comment":"The position one on"},
        "1264": {"comment":"Stored at +$0F"},
        "1267": {"comment":"HL = the channel's +$11"},
        "1269": {"comment":"BC = the start address there"},
        "1272": {"comment":"HL = the start + the old position"},
        "1275": {"comment":"Carry: a byte there"},
        "1277": {"synopsis":"For a channel F: B = its file number (+$0D), then RAM bank 7 and the other stack (RST $08),\nand back to the caller on that stack.\nChanges: B, HL.","comment":"HL = CURCHL + $0D"},
        "1284": {"comment":"B = the file number there"},
        "1285": {"comment":"HL = the return address"},
        "1286": {"comment":"Bank 7 and the other stack"},
        "1287": {"comment":"Back to the caller"},
        "1288": {"synopsis":"A channel F's position operation (the third word of its template in ROM 2, $124C there), by\nB, through +3DOS (RST $20): 0 the file's position (DOS_GET_POSITION), 1 set from E:HL\n(DOS_SET_POSITION), 2 or more the end of the file (DOS_GET_EOF).\nExit: DE:HL the position or length; as FCH_DONE.","comment":"The other register set"},
        "1289": {"comment":"B = the file number"},
        "1293": {"comment":"The caller's registers"},
        "1294": {"comment":"A = the operation: 0 get, 1 set, 2 the length"},
        "1295": {"comment":"BC = the file number in B"},
        "1296": {"comment":"0?"},
        "1299": {"comment":"1?"},
        "1302": {"comment":"+3DOS DOS_GET_EOF"},
        "1307": {"synopsis":"0: the file's position (DOS_GET_POSITION).","comment":"+3DOS DOS_GET_POSITION"},
        "1310": {"synopsis":"D = 0: the 24-bit E:HL as DE:HL.","comment":"D = 0: DE:HL the position"},
        "1312": {"comment":"To the end"},
        "1314": {"synopsis":"1: the file's position set from E:HL (DOS_SET_POSITION).","comment":"+3DOS DOS_SET_POSITION"},
        "1319": {"synopsis":"A channel F's input (the second word of its template): a byte read from the file (+3DOS\nDOS_BYTE_READ), into A.","comment":"B = the file number"},
        "1322": {"comment":"+3DOS DOS_BYTE_READ"},
        "1325": {"comment":"A = the byte read"},
        "1328": {"synopsis":"A channel F's output (the first word of its template): the byte in A written to the file\n(+3DOS DOS_BYTE_WRITE).","comment":"C = the byte to write"},
        "1329": {"comment":"B = the file number"},
        "1332": {"comment":"+3DOS DOS_BYTE_WRITE"},
        "1335": {"synopsis":"The end of a channel F routine: bank 0 and the stack back (RST $30); +3DOS's carry, success,\nreturns; no carry is error $12 (report J) through $27B0.","comment":"Bank 0 and the machine stack"},
        "1336": {"comment":"Carry: success"},
        "1337": {"comment":"Otherwise error $12"},
        "1342": {"synopsis":"Removes BC bytes at HL (a channel being closed) from CHANS, for ROM 2 (from its $1540, the\ncaller's HL and BC in the other set): ROM 3's RECLAIM, with $5B5A kept over it, then every\nSTRMS word above the place made BC smaller.\nExit: HL as given.","comment":"HL and BC from the caller"},
        "1343": {"synopsis":"CHANS_RECLAIM entered with HL and BC in this set: from $19DE."},
        "1345": {"comment":"$5B5A kept on the stack, HL back"},
        "1350": {"comment":"ROM 3's RECLAIM removes the BC bytes at HL"},
        "1353": {"comment":"$5B5A back"},
        "1357": {"comment":"BC = the count, HL = the place"},
        "1359": {"comment":"HL = the place's offset from CHANS"},
        "1366": {"comment":"On the stack"},
        "1367": {"comment":"19 stream words"},
        "1369": {"comment":"STRMS"},
        "1372": {"synopsis":"One stream word: made BC smaller when it is above the offset.","comment":"DE = a stream's word"},
        "1375": {"comment":"HL = the offset of the bytes removed"},
        "1376": {"comment":"Is the stream's word above it?"},
        "1380": {"comment":"No: left as it is"},
        "1382": {"comment":"The word less BC"},
        "1387": {"synopsis":"The word stored back; the next stream.","comment":"HL = the stream word's address"},
        "1388": {"comment":"Stored back"},
        "1392": {"comment":"The next stream"},
        "1393": {"comment":"All 19?"},
        "1396": {"comment":"The offset dropped"},
        "1398": {"synopsis":"Makes room for BC bytes at HL in CHANS (a channel being opened), for ROM 2 (from its $1497,\nthe caller's HL and BC in the other set): report 4 (ROM 3's NO_ROOM) when PROG + BC would\nreach $C000; ROM 3's MAKE_ROOM with $5B5A kept over it; DATADD made at least PROG - 1; then\nevery STRMS word above the place made BC larger.\nExit: HL as given.","comment":"HL and BC from the caller"},
        "1399": {"synopsis":"CHANS_MAKE_ROOM entered with HL and BC in this set: from $19F7."},
        "1401": {"comment":"HL kept for a moment"},
        "1402": {"comment":"PROG + BC"},
        "1406": {"comment":"Would it reach $C000?"},
        "1409": {"comment":"Then report 4"},
        "1411": {"comment":"$5B5A kept on the stack, HL back"},
        "1415": {"comment":"ROM 3's MAKE_ROOM: BC bytes before HL"},
        "1418": {"comment":"$5B5A back"},
        "1422": {"comment":"Is DATADD below PROG less 1?"},
        "1431": {"comment":"DATADD less PROG less 1"},
        "1433": {"comment":"No"},
        "1435": {"comment":"Yes: DATADD = PROG less 1"},
        "1439": {"synopsis":"The streams: their offsets from CHANS compared with the place's.","comment":"BC = the count, HL = the place"},
        "1441": {"comment":"HL = the place's offset from CHANS"},
        "1448": {"comment":"On the stack"},
        "1449": {"comment":"19 stream words"},
        "1451": {"comment":"STRMS"},
        "1454": {"synopsis":"One stream word: made BC larger when it is above the offset.","comment":"DE = a stream's word"},
        "1457": {"comment":"HL = the offset of the new room"},
        "1458": {"comment":"Is the stream's word above it?"},
        "1462": {"comment":"No: left as it is"},
        "1464": {"comment":"The word plus BC"},
        "1468": {"synopsis":"The word stored back; the next stream.","comment":"HL = the stream word's address"},
        "1469": {"comment":"Stored back"},
        "1473": {"comment":"The next stream"},
        "1474": {"comment":"All 19?"},
        "1477": {"comment":"The offset dropped"},
        "1479": {"synopsis":"No room below $C000: ROM 3's NO_ROOM (report 4).","comment":"ROM 3's NO_ROOM: report 4"},
        "1482": {"synopsis":"The start-up menu's keys, for $15A1 (from MENU_KEY_LOOP): a key code and a routine's\naddress, three bytes each, ended by $FF. $0B and '7' MENU_UP; $0A and '6' MENU_DOWN; $07\n(EDIT) and space MENU_EXIT; $0D (ENTER) and '0' MENU_ENTER; $0E MENU_RECOLOUR; $08 and '5'\n$3DC6; $09 and '8' $3DBA."},
        "1522": {"synopsis":"The menu's up key: the highlight one item up, from the first to the last.\nExit: carry (the key used).","comment":"Carry: one up"},
        "1525": {"synopsis":"The menu's down key: the highlight one item down, from the last to the first.\nExit: carry.","comment":"No carry: one down"},
        "1526": {"synopsis":"Carry: up; no carry: down. The item at $F700 unhighlighted, moved, stored and highlighted\n(MENU_HIGHLIGHT).","comment":"The selected item"},
        "1529": {"comment":"Its highlight taken off"},
        "1532": {"comment":"Up: the item above"},
        "1535": {"comment":"Down: the item below"},
        "1538": {"comment":"Selected"},
        "1541": {"comment":"Its highlight"},
        "1544": {"comment":"Carry: the key was used"},
        "1546": {"synopsis":"A = the item above A; the last item ($F71F) above the first.","comment":"The item above"},
        "1547": {"comment":"Still an item?"},
        "1548": {"comment":"No: the last one"},
        "1552": {"synopsis":"A = the item below A; the first below the last.","comment":"The item below"},
        "1553": {"comment":"L = the last item's number"},
        "1556": {"comment":"L = the number of items"},
        "1557": {"comment":"Still an item?"},
        "1559": {"comment":"No: the first one"},
        "1561": {"synopsis":"Key $0E: every item's line (16 attribute bytes each from line 7, column 8) recoloured by\nSWAP_COLOURS with D = 4, E = 2: each of four colours swapped with the one two away.\nExit: carry.","comment":"Item 0's attributes: line 7, column 8"},
        "1564": {"comment":"B = the number of items"},
        "1569": {"synopsis":"One item's line.","comment":"B kept"},
        "1570": {"comment":"Four colours, each swapped with the one two away"},
        "1573": {"comment":"The line's 16 attribute bytes changed"},
        "1576": {"comment":"HL = the next line's column 8"},
        "1580": {"comment":"B back"},
        "1581": {"comment":"Every item"},
        "1583": {"comment":"Carry: the key was used"},
        "1585": {"synopsis":"EDIT or space: the menu left with carry (MENU_LEAVE).","comment":"Carry: the menu left"},
        "1588": {"synopsis":"ENTER, '0' or a hotkey (from $07AD): A = the selected item ($F700), no carry; MENU_LEAVE.","comment":"A = the selected item, no carry"},
        "1592": {"synopsis":"Leaves MENU_SHOW: $15A1's return and MENU_KEY_LOOP's are dropped, $5B68 bit 1 cleared and\nthe screen under the menu put back (MENU_REST_SCR).\nExit: A and the carry as given, to MENU_SHOW's caller.","comment":"$15A1's return and the key loop's dropped"},
        "1594": {"comment":"$5B68 bit 1 cleared"},
        "1599": {"comment":"A and the carry kept"},
        "1600": {"comment":"The screen under the menu put back"},
        "1603": {"comment":"A and the carry back"},
        "1605": {"synopsis":"Runs start-up menu A (from $11C7 with 0, then 1): the menu file \"<$7F>enMenus.cfg\" ($0DEA)\nloaded into $F720 by $3BC5, unless SYMBOL SHIFT is held, and the built-in menu text\n(MENU_TEXT, $3C3 bytes) copied after it; menu A found (FIND_MENU); then shown again and\nagain (MENU_SHOW) and the chosen item's action run (MENU_ACTION), with a beep for a refused\none.\nExit: no carry, menu A not found; carry, the menu left; Z, an action finished it.","comment":"A = the menu number kept"},
        "1606": {"comment":"The buffer at $F720, up to $0800 bytes"},
        "1612": {"comment":"DE = the file name \"<$7F>enMenus.cfg\""},
        "1615": {"comment":"SYMBOL SHIFT held?"},
        "1621": {"comment":"No: the file loaded by $3BC5"},
        "1624": {"comment":"DE = $F720, or the end of what was loaded"},
        "1625": {"comment":"The built-in menus after it"},
        "1631": {"comment":"Copied"},
        "1633": {"comment":"A = the menu number"},
        "1634": {"comment":"Found?"},
        "1637": {"comment":"No: back"},
        "1638": {"synopsis":"The current menu shown, an item chosen and its action run.","comment":"Shown and an item chosen"},
        "1641": {"comment":"Carry: the menu left"},
        "1642": {"comment":"The item's action done"},
        "1645": {"comment":"No carry: refused"},
        "1647": {"comment":"Z: finished"},
        "1648": {"synopsis":"No carry: a beep ($3E18); the menu again.","comment":"A beep for a refused key or action"},
        "1651": {"comment":"The menu again"},
        "1653": {"synopsis":"Finds menu A in the menu text at $F720: a line \"=n\" with n = A.\nExit: carry, found: $D744 = A, $D742 = HL = its title line (the line after); no carry, not\nthere.","comment":"The menu text in the buffer"},
        "1656": {"comment":"C = the menu number wanted"},
        "1657": {"synopsis":"One line: does it start '=' and the number wanted?","comment":"A line beginning '='?"},
        "1660": {"comment":"No: the next line"},
        "1662": {"comment":"The number after '='"},
        "1666": {"comment":"None: the next line"},
        "1668": {"comment":"The menu wanted?"},
        "1670": {"comment":"No: the next line"},
        "1672": {"comment":"The line after: the menu's title"},
        "1675": {"comment":"The end of the text: not found"},
        "1676": {"comment":"$D744 = the menu number"},
        "1680": {"comment":"$D742 = the title's address"},
        "1683": {"comment":"Carry: found"},
        "1685": {"synopsis":"The next line, unless the text ends.","comment":"To the next line"},
        "1688": {"comment":"The end of the text: not found"},
        "1691": {"synopsis":"Shows the current menu (title at $D742) and waits for a choice:\n1. Item 0 selected; the screen under the menu saved (MENU_SAVE_SCR); stream 2; the title at\n   line 5, column 8, in the colours at $D6E0, then the title line's rest ($0E2F, $3D6D).\n2. Up to 10 items, from line 7, in the colours at $D6E3: each printed by MENU_ITEM_TEXT, its\n   hotkey kept at $F701 + n and its action's address at $F70B + 2n; $F71F = the last item's\n   number.\n3. Below them the memory size in K (16 x the banks), printed a pixel higher; a frame round\n   the items when the inks at $D6E2 and $D6E3 are the same.\n4. The keys (MENU_KEY_LOOP).\nExit: through MENU_LEAVE: A = the item, no carry; or carry, the menu left.","comment":"Item 0 selected"},
        "1695": {"comment":"ROM 1's $14A9 with A = 0"},
        "1699": {"comment":"The screen under the menu saved"},
        "1702": {"comment":"Stream 2, the upper screen (ROM 3's STREAM_SELECT)"},
        "1707": {"comment":"TV_FLAG bit 0 cleared"},
        "1712": {"comment":"ATTR_T = the title's colours at $D6E0"},
        "1719": {"comment":"MASK_T = 0"},
        "1722": {"comment":"P_FLAG = 0"},
        "1724": {"comment":"AT line 5, column 8"},
        "1729": {"comment":"The title"},
        "1732": {"comment":"Printed, padded to 8 characters"},
        "1735": {"comment":"A space"},
        "1738": {"comment":"The text's place kept"},
        "1739": {"comment":"The title line's rest: $0E2F, $3D6D, $0E2F"},
        "1748": {"comment":"A space"},
        "1751": {"comment":"HL = the title's line"},
        "1752": {"comment":"ATTR_T = the items' colours at $D6E3"},
        "1758": {"synopsis":"The items, from HL; A = item 0.","comment":"A = item 0"},
        "1759": {"comment":"BC = the hotkeys' list, $F701"},
        "1762": {"comment":"DE = the items' text addresses, $F70B"},
        "1765": {"synopsis":"One item: its line printed and its hotkey and address kept.","comment":"A, the item number, kept"},
        "1766": {"comment":"To the next line: the end of the text?"},
        "1771": {"comment":"The next menu's '='?"},
        "1775": {"comment":"A = the item number"},
        "1777": {"comment":"BC and DE kept"},
        "1779": {"comment":"AT its line, column 8"},
        "1782": {"comment":"The item printed; C = its hotkey"},
        "1785": {"comment":"A = the hotkey"},
        "1788": {"comment":"HL = where the item's action text starts"},
        "1789": {"comment":"Kept in the text addresses' list"},
        "1793": {"comment":"HL = the item's text again"},
        "1794": {"comment":"The hotkey in the list"},
        "1796": {"comment":"The next item"},
        "1798": {"comment":"10 items at most"},
        "1802": {"comment":"Kept for the POP after"},
        "1803": {"synopsis":"The items done: A = their count.","comment":"A = the item count"},
        "1804": {"comment":"The last item's number"},
        "1805": {"comment":"In $F71F"},
        "1808": {"comment":"The text \"<CR> <CR>\""},
        "1811": {"comment":"No items: a single blank item"},
        "1814": {"comment":"The line after the last item"},
        "1818": {"comment":"9 spaces there"},
        "1823": {"comment":"The last RAM bank's number"},
        "1826": {"comment":"Bank 0 only: no size shown"},
        "1829": {"comment":"A = the number of 16K banks"},
        "1830": {"comment":"CHARS kept"},
        "1834": {"comment":"CHARS one on: the characters a pixel higher"},
        "1838": {"comment":"HL = 16 x the banks: the memory size in K"},
        "1841": {"comment":"x 16: 16K a bank"},
        "1845": {"comment":"E = ' ', for leading zeros"},
        "1847": {"comment":"ROM 1's $3714 prints HL in decimal"},
        "1850": {"comment":"'K'"},
        "1853": {"comment":"A space"},
        "1856": {"comment":"CHARS back"},
        "1860": {"synopsis":"The frame, when the two inks match: left, bottom and right edges plotted (PLOT_LINE).","comment":"The colours at $D6E2 and $D6E3"},
        "1863": {"comment":"Inks the same?"},
        "1867": {"comment":"No: no frame"},
        "1869": {"comment":"From x 64, y 119"},
        "1872": {"comment":"B = 8 x (the item count + 1) - 1"},
        "1875": {"comment":"The count + 1"},
        "1877": {"comment":"x 8 pixel rows"},
        "1880": {"comment":"Less 1"},
        "1882": {"comment":"B kept"},
        "1883": {"comment":"Down: the left edge"},
        "1889": {"comment":"127 pixels"},
        "1891": {"comment":"Right: the bottom edge"},
        "1897": {"comment":"B back"},
        "1898": {"comment":"One more"},
        "1899": {"comment":"Up: the right edge"},
        "1905": {"synopsis":"No key yet; $5B68 bit 1 set; the selected item highlighted.","comment":"FLAGS bit 5 cleared: no key yet"},
        "1909": {"comment":"$5B68 bit 1 set"},
        "1914": {"comment":"The selected item highlighted"},
        "1920": {"synopsis":"Reads keys: one in MENU_KEYS runs its routine; a letter that is an item's hotkey selects it\nand works as ENTER; anything else beeps.","comment":"MODE = 0"},
        "1924": {"comment":"A = a key, by $1255"},
        "1927": {"comment":"The table of keys"},
        "1930": {"comment":"A key in the table: its routine"},
        "1933": {"comment":"Carry: used, the next key"},
        "1935": {"comment":"A letter made lower case"},
        "1938": {"comment":"B = the last item's number"},
        "1942": {"comment":"B = the item count"},
        "1943": {"comment":"C = the item number"},
        "1945": {"comment":"The hotkeys' list"},
        "1948": {"synopsis":"One item's hotkey compared.","comment":"This item's hotkey?"},
        "1951": {"comment":"The next one"},
        "1955": {"comment":"None: no carry"},
        "1958": {"synopsis":"Item C selected, then MENU_ENTER (through $15C1).","comment":"A = the item"},
        "1959": {"comment":"Selected"},
        "1962": {"comment":"As though ENTER was pressed"},
        "1968": {"synopsis":"No carry: a beep ($3E18).","comment":"No carry: a beep"},
        "1971": {"comment":"The next key"},
        "1973": {"synopsis":"Prints AT line A + 7, column 8.\nExit: B = the line, C = 8.","comment":"B = line A + 7"},
        "1976": {"comment":"C = column 8"},
        "1978": {"comment":"AT"},
        "1980": {"comment":"The line"},
        "1983": {"comment":"The column"},
        "1986": {"synopsis":"Prints a space and the text at HL up to a control code, 8 characters at most, padded with\nspaces to 8.\nExit: HL = past what was printed.","comment":"8 characters at most"},
        "1988": {"comment":"A space first"},
        "1991": {"synopsis":"One character.","comment":"A control code ends the text"},
        "1996": {"comment":"The character printed"},
        "1998": {"comment":"The next one"},
        "2000": {"comment":"8 printed"},
        "2001": {"synopsis":"Prints B spaces, A kept.","comment":"A kept"},
        "2002": {"synopsis":"One space.","comment":"A space"},
        "2005": {"comment":"B of them"},
        "2007": {"comment":"A back"},
        "2009": {"synopsis":"Prints a space and an item's text at HL up to ':' or a control code, 15 characters at most\n(the rest skipped), padded with spaces. A '_' marks the character before it as the item's\nhotkey: shown in the colour at $D6E5.\nExit: HL at the ':' or control code; C = the hotkey in lower case, 0 for none.","comment":"B = 15 characters, C = 0: no hotkey yet"},
        "2012": {"comment":"E = 0: no character yet"},
        "2013": {"comment":"A space first"},
        "2016": {"synopsis":"One character.","comment":"The next character"},
        "2017": {"comment":"':' ends the item's text"},
        "2021": {"comment":"So does a control code"},
        "2025": {"comment":"Past it"},
        "2026": {"comment":"'_' marks the character before as the hotkey"},
        "2030": {"comment":"E = the last character printed"},
        "2031": {"comment":"Printed"},
        "2032": {"comment":"15 at most"},
        "2034": {"synopsis":"The rest of a text longer than 15 characters skipped.","comment":"The rest of the text skipped"},
        "2035": {"comment":"Up to the ':'"},
        "2038": {"comment":"Or a control code"},
        "2041": {"comment":"Past it"},
        "2044": {"synopsis":"A '_': the character before it is the hotkey, unless one was found already.","comment":"A hotkey already?"},
        "2046": {"comment":"Then the '_' ignored"},
        "2048": {"comment":"The character before"},
        "2049": {"comment":"In lower case"},
        "2052": {"comment":"C = the hotkey"},
        "2053": {"comment":"HL kept"},
        "2054": {"comment":"HL = the hotkey's place on the screen"},
        "2058": {"comment":"Its attribute"},
        "2061": {"comment":"In the hotkey colour at $D6E5"},
        "2065": {"comment":"HL back"},
        "2066": {"comment":"The next character"},
        "2068": {"synopsis":"A capital letter in A made lower case; anything else left as it is.\nChanges: AF.","comment":"Below 'A'?"},
        "2071": {"comment":"Above 'Z'?"},
        "2074": {"comment":"Lower case"},
        "2077": {"synopsis":"Prints the text at HL up to a $FF (RST $10). Also called by ROM 2 ($1ED8).\nExit: HL past the $FF.","comment":"The next character"},
        "2079": {"comment":"$FF ends the text"},
        "2082": {"comment":"Printed"},
        "2085": {"synopsis":"H = the attribute address's high byte for the display address HL, which must be a\ncharacter's first pixel row.\nChanges: AF, H.","comment":"H = $58 + its third: the character row's attribute"},
        "2086": {"comment":"The display third's bits to bits 0-1"},
        "2089": {"comment":"Into the attribute area at $5800"},
        "2093": {"synopsis":"Past a character of the line.","comment":"Past a character"},
        "2094": {"synopsis":"Moves HL from inside a line of menu text to the next line's first character (past the\ncontrol code and any $0D and $0A after it).\nExit: Z, the text's $FF; otherwise NZ, A = the character.","comment":"A control code ends the line"},
        "2099": {"synopsis":"Past a line end.","comment":"Past it"},
        "2100": {"synopsis":"Skips $0D and $0A at HL.\nExit: Z, a $FF (the text's end); otherwise NZ, A = the character.","comment":"$FF: the end of the text (Z)"},
        "2104": {"comment":"$0D skipped"},
        "2108": {"comment":"$0A skipped"},
        "2110": {"comment":"Otherwise NZ: a line's first character"},
        "2113": {"synopsis":"Plots B pixels from x = L, y = H, stepping H and L by D and E each time (ROM 3's PLOT_SUB\npast its COORDS store).\nExit: HL past the last.","comment":"BC, DE and HL kept"},
        "2116": {"comment":"C = x, B = y"},
        "2118": {"comment":"ROM 3's PLOT_SUB past its COORDS store plots it"},
        "2121": {"comment":"BC, DE and HL back"},
        "2124": {"comment":"The next pixel's x and y"},
        "2125": {"comment":"B pixels"},
        "2128": {"synopsis":"Saves what the menu covers to bank 7 from $ED11: TV_FLAG, the $15 system variables from\nCOORDS on, and lines 5-18, columns 8-23 (pixels and attributes). The copy direction rides in\nthe carry, kept in F' by COPY_BYTES_CF.","comment":"Carry: the screen saved"},
        "2131": {"synopsis":"Puts back what MENU_SAVE_SCR saved.","comment":"No carry: the screen put back"},
        "2132": {"synopsis":"Carry: saves; no carry: puts back.","comment":"TV_FLAG"},
        "2135": {"comment":"Its copy at $ED11"},
        "2138": {"comment":"1 byte"},
        "2141": {"comment":"Copied either way; the way kept in F'"},
        "2144": {"comment":"COORDS on: $15 bytes of system variables"},
        "2150": {"comment":"Copied the same way"},
        "2153": {"comment":"14 lines; C = 24 - line 5"},
        "2156": {"synopsis":"One character line, C counting from 24 - line 5 down.","comment":"C and DE kept"},
        "2158": {"comment":"B = 24 - the line"},
        "2159": {"comment":"ROM 3's LINE_SCREEN_ADDR: HL = the line's address"},
        "2162": {"comment":"Column 8"},
        "2166": {"comment":"DE = the copy's place"},
        "2167": {"comment":"16 characters of it copied"},
        "2170": {"comment":"C back"},
        "2171": {"comment":"The next line"},
        "2172": {"comment":"All 14"},
        "2175": {"synopsis":"Copies 16 character cells at HL (8 pixel rows, then their attributes) to or from DE, the way\nin F' (COPY_BYTES_F2).\nExit: DE past them.","comment":"8 pixel rows, 16 bytes each"},
        "2178": {"comment":"HL kept"},
        "2179": {"synopsis":"One pixel row of 16 bytes.","comment":"B kept"},
        "2180": {"comment":"BC = 16"},
        "2182": {"comment":"One pixel row copied"},
        "2186": {"comment":"HL and B back"},
        "2188": {"comment":"The next pixel row"},
        "2189": {"comment":"All 8"},
        "2191": {"comment":"HL = the line's first pixel row"},
        "2192": {"comment":"HL = its attributes; 16 copied below"},
        "2195": {"synopsis":"COPY_BYTES_CF with the way taken from F'.","comment":"The direction from F'"},
        "2196": {"synopsis":"Copies BC bytes: carry, from HL to DE; no carry, from DE to HL; the carry is then kept in F'\n(EX AF,AF').\nExit: HL and DE as they were plus BC.","comment":"Carry: from HL to DE"},
        "2198": {"comment":"No carry: from DE to HL"},
        "2199": {"synopsis":"The copy.","comment":"Copied"},
        "2201": {"comment":"The pointers back"},
        "2204": {"synopsis":"The pointers back in their places; the way into F'.","comment":"The direction kept in F'"},
        "2206": {"synopsis":"Item A's line (16 attribute bytes at line 7 + A, column 8) recoloured by SWAP_COLOURS with D\n= 6, E = 1: each of six colours swapped with its neighbour, so the highlight goes on or off.\nChanges: BC, DE, HL.","comment":"A kept"},
        "2207": {"comment":"DE = 32 x the item"},
        "2212": {"comment":"DE = its attributes: line 7 + item, column 8"},
        "2216": {"comment":"In HL"},
        "2217": {"comment":"Six colours, each swapped with its neighbour"},
        "2220": {"comment":"The line's 16 attribute bytes changed"},
        "2223": {"comment":"A back"},
        "2225": {"synopsis":"Changes the 16 attribute bytes at HL: a byte equal to one of D colours in the table ending\nat $D6E7 is replaced by the table's entry at that entry's address XOR E.\nExit: HL past them.","comment":"C = 16 bytes"},
        "2227": {"synopsis":"One attribute byte.","comment":"An attribute"},
        "2228": {"comment":"HL kept"},
        "2229": {"comment":"The colour table, searched down from $D6E7"},
        "2232": {"comment":"D entries"},
        "2233": {"synopsis":"One table entry compared.","comment":"This colour?"},
        "2236": {"comment":"The next one down"},
        "2239": {"comment":"Not there: left as it is"},
        "2240": {"synopsis":"The next byte.","comment":"The next byte"},
        "2241": {"comment":"All 16?"},
        "2245": {"synopsis":"Found: the partner entry's colour stored.","comment":"The table entry E away from it"},
        "2248": {"comment":"A = its colour"},
        "2250": {"comment":"Stored in place"},
        "2251": {"comment":"The next byte"},
        "2253": {"synopsis":"The menu items' functions, 'i' 0 to 12 (MENU_ACTION): a word each, bit 7 set for an address\nin the alternate ROM (the bit cleared, through ALT_ROM_GO), clear for one in this ROM. 0-2\nthe alternate ROM's $7C82; 3 $132C, 4 $1375, 5 $131B there; 6 $11D4 here; 7 $1380, 8 $1390\nthere; 9 $11B8 and 10 $2BE0 here; 11 $13A0, 12 $13AA there."},
        "2279": {"synopsis":"Runs item A's action, the text after its ':' (at $F70B + 2A): 'i' and a number, a function\nof MENU_FUNCS; 'g' and a name, the guide on that topic; 'b' and a command, run as BASIC; 'm'\nand a number, that menu made current (FIND_MENU).\nExit: no carry, refused (no action or a bad letter or number); carry, the menu shown again;\nZ with carry, finished.","comment":"A = 2 x the item"},
        "2280": {"comment":"The items' text addresses"},
        "2285": {"comment":"DE = the item's"},
        "2288": {"comment":"HL = it"},
        "2289": {"comment":"An item's action starts with ':'"},
        "2293": {"synopsis":"No carry, NZ: refused.","comment":"Otherwise no carry, NZ: refused"},
        "2296": {"comment":"E = the action's letter"},
        "2297": {"comment":"Past it"},
        "2298": {"comment":"A ':' after it skipped"},
        "2302": {"synopsis":"The action's letter, in lower case.","comment":"A = the letter in lower case"},
        "2305": {"comment":"'i': a function of this ROM"},
        "2309": {"comment":"'g': a guide"},
        "2313": {"comment":"'b': a BASIC command"},
        "2317": {"comment":"'m': a menu; other letters refused"},
        "2321": {"comment":"E = the menu number"},
        "2324": {"comment":"None: refused"},
        "2325": {"comment":"A = it"},
        "2326": {"comment":"Found and made the current menu"},
        "2329": {"synopsis":"'i': the function in MENU_FUNCS, numbers 0-12.","comment":"E = the function number"},
        "2332": {"comment":"None: refused"},
        "2333": {"comment":"A = it"},
        "2334": {"comment":"13 functions, 0-12"},
        "2337": {"comment":"The function's word in the table"},
        "2343": {"comment":"BC = it"},
        "2346": {"comment":"Bit 7 set?"},
        "2348": {"comment":"BC = the address"},
        "2350": {"comment":"Set: run in the alternate ROM"},
        "2353": {"comment":"Clear: run in this ROM"},
        "2355": {"synopsis":"'g': the guide's name copied to $DA31 with its end, then the command at $0DB1\n(layer2,0:layer0:sprite print0:.guide \"|\") run, the '|' standing for the name.","comment":"HL kept: the guide's name"},
        "2356": {"comment":"Copied to $DA31"},
        "2359": {"synopsis":"One character of the name.","comment":"A = the character"},
        "2360": {"comment":"Copied"},
        "2362": {"comment":"Up to a control code or $FF, which is copied too"},
        "2367": {"comment":"The command line that shows the guide"},
        "2370": {"comment":"Run"},
        "2372": {"synopsis":"'b': no texts for '|' ($FF at $E090 and $DA31); the command after the 'b' run.","comment":"$FF: no text for a '|'"},
        "2377": {"comment":"In both places"},
        "2380": {"synopsis":"Runs the command text at HL as BASIC: $D5B8 = 0 when it was 4; the text copied to the rows\nat $C000 of bank 7 (32 characters each, then a flag byte and two more: flag 3 the first row,\n2 the others, and the last one's with bit 1 cleared and bit 3 set), its characters expanded\n(EXPAND_TEXT); FLAGS2 bit 0 set; then the alternate ROM's $0454 and $07D8.\nExit: no carry, if it returns.","comment":"$D5B8 = 4?"},
        "2386": {"comment":"No"},
        "2388": {"comment":"Yes: made 0"},
        "2391": {"synopsis":"The rows built.","comment":"XL = 3: the first row's flag"},
        "2394": {"comment":"The rows built at $C000 in bank 7"},
        "2397": {"comment":"C = the row width, 32"},
        "2401": {"comment":"The command copied, characters expanded"},
        "2404": {"comment":"The last row's rest filled with 0"},
        "2405": {"synopsis":"The last row's rest made 0.","comment":"A 0 more"},
        "2408": {"comment":"To the row's end"},
        "2410": {"comment":"The row's flag byte"},
        "2412": {"comment":"Bit 1 cleared"},
        "2414": {"comment":"Bit 3 set: the last row"},
        "2417": {"comment":"FLAGS2 bit 0 set"},
        "2421": {"comment":"The alternate ROM's $0454"},
        "2426": {"comment":"C = 0"},
        "2428": {"comment":"The alternate ROM's $07D8"},
        "2433": {"comment":"No carry"},
        "2435": {"synopsis":"Copies the text at HL to DE up to a control code or $FF, in rows of C characters (each full\nrow followed by the flag byte in XL, which then becomes 2, and two bytes skipped; C back to\nthe width at $D73D). Characters expanded: '|' the text at $E090, or after a quote the\nguide's name at $DA31; '`' \"en\"; $7F \"c:/nextzxos/\". Also used by $3BC5 for the menu file's\nname.\nExit: HL at the end, carry.","comment":"The next character"},
        "2436": {"comment":"A control code or $FF ends the text"},
        "2440": {"comment":"A back"},
        "2441": {"comment":"HL kept"},
        "2442": {"comment":"B = 1: one character"},
        "2444": {"comment":"'|'?"},
        "2446": {"comment":"No"},
        "2448": {"comment":"The character before it"},
        "2450": {"comment":"A quote?"},
        "2452": {"comment":"HL = the text kept at $E090"},
        "2455": {"comment":"No quote before the bar: that text"},
        "2457": {"comment":"After a quote: the guide's name at $DA31"},
        "2462": {"synopsis":"Not '|': '`', $7F or the character itself.","comment":"'`'?"},
        "2464": {"comment":"Then \"en\""},
        "2469": {"comment":"$7F?"},
        "2471": {"comment":"Then \"c:/nextzxos/\""},
        "2474": {"comment":"Neither: the character itself"},
        "2476": {"synopsis":"One character of an expansion, up to its control code or $FF.","comment":"A character of the string"},
        "2478": {"comment":"Its end?"},
        "2483": {"comment":"A back"},
        "2484": {"comment":"B one more, so the string goes on"},
        "2485": {"synopsis":"A character stored; the row closed when full.","comment":"Stored in the row"},
        "2487": {"comment":"The row full?"},
        "2490": {"comment":"The row's flag byte"},
        "2493": {"comment":"Past it"},
        "2494": {"comment":"XL = 2 for the rows after"},
        "2497": {"comment":"Past the row's 2 other bytes"},
        "2499": {"comment":"C = the row width again"},
        "2503": {"synopsis":"The rest of the expansion.","comment":"The rest of the string"},
        "2505": {"synopsis":"The text's next character.","comment":"HL back"},
        "2506": {"comment":"The next character"},
        "2509": {"synopsis":"Reads a decimal number at HL, 0-255, into E: one digit at least, then digits up to $FF, $0D\nor $0A.\nExit: carry, E = the number, HL at the line end; no carry, another character or a number\nabove 255.\nChanges: AF, D, E, HL.","comment":"E = 0"},
        "2511": {"comment":"A digit must come first"},
        "2514": {"synopsis":"The next character: a line end ends the number.","comment":"The next character"},
        "2515": {"comment":"$FF, $0D or $0A: the number ends"},
        "2518": {"comment":"Carry: a number"},
        "2520": {"synopsis":"A digit: E = E x 10 + it.","comment":"Below '0': no carry"},
        "2524": {"comment":"Above '9': no carry"},
        "2528": {"comment":"Past it"},
        "2529": {"comment":"DE = E x 10"},
        "2531": {"comment":"Plus the digit"},
        "2533": {"comment":"Still below 256?"},
        "2535": {"comment":"Yes: the next digit"},
        "2537": {"comment":"No: no carry"},
        "2538": {"synopsis":"The built-in start-up menus, $3C3 bytes to $0DAC, copied to $F720 or after the menu file by\nRUN_MENU; read by FIND_MENU, MENU_SHOW and MENU_ACTION. Lines end $0A ($0D first). A line\n\"=n\" starts menu n, the next line is its title, and each line after is an item: its text\n('_' after the hotkey), ':', an action letter and its argument ('i' function, 'm' menu, 'g'\nguide, 'b' BASIC command; '<$7F>' stands for \"c:/nextzxos/\"). The text ends with $FF. Menus\n0-6: the main menus, the options of three editors, the cartridges and the tools."},
        "2539": {"synopsis":"Menu 0: \"NextZXOS\"."},
        "2639": {"synopsis":"Menu 1: \"NextZXOS\"."},
        "2893": {"synopsis":"Menu 2: \"Options\"."},
        "3044": {"synopsis":"Menu 3: \"Options\"."},
        "3111": {"synopsis":"Menu 4: \"Options\"."},
        "3196": {"synopsis":"Menu 5: \"NextZXOS\"."},
        "3368": {"synopsis":"Menu 6: \"Tools\"."},
        "3501": {"synopsis":"The menu text used when the menu read at $06E5 has no entries (the JP M at $0713): $0D, a\nspace, $0D, ended by $FF."},
        "3505": {"synopsis":"A command line, ended by $0D, that $093F hands to the expander at $0983:\n\"layer2,0:layer0:sprite print0:.guide \"|\"\". Its \"|\" after a quote becomes the text at $DA31\n(the name copied there at $0933 from a menu line)."},
        "3546": {"synopsis":"The language code \"en\", ended by $FF: what the expander at $0983 puts for a \"`\" ($60) in a\nname."},
        "3549": {"synopsis":"The system folder \"c:/nextzxos/\", ended by $FF: what the expander at $0983 puts for a $7F in\na name."},
        "3562": {"synopsis":"The menu file's name, ended by $00: $7F, \"enMenus.cfg\" (so \"c:/nextzxos/enMenus.cfg\" once\nexpanded). Passed in DE at $064C to $3BC5, which loads it unless SYMBOL SHIFT is held."},
        "3575": {"synopsis":"Two character pictures, 8 bytes each: a triangle filling the lower right of the cell ($01\n$03 ... $FF) and one filling the upper left ($FE $FC ... $00). Copied to $D750 at $0360\n(DRAW_STRIPES prints them from there as UDGs $90/$91); also the first two of the seven UDGs\nUDG_ROM_GLYPHS points UDG at."},
        "3591": {"synopsis":"Five more character pictures, 8 bytes each, UDGs $92-$96 while UDG_ROM_GLYPHS has pointed\nUDG at STRIPE_GLYPHS: the three bottom pixel rows filled; every other row filled (rows 1, 3,\n5, 7); a bar three pixels wide down the middle (bits 5-3); the three top rows filled; a\nhollow box six pixels wide. Nothing in this page names these bytes directly."},
        "3631": {"synopsis":"Draws the coloured stripes of a menu title at the print position: UDG pointed at the copy of\nSTRIPE_GLYPHS at $D750 (UDG_RAM_GLYPHS), five pictures printed, $91 and $90 in turn, each in\nthe colours of the next byte from $D6DB (as ATTR_T), then a space in the sixth byte's\ncolours; UDG put back. From $06CB and $06D1.","comment":"UDG = the RAM pictures at $D750, HL = the old UDG"},
        "3634": {"comment":"Kept to put back"},
        "3635": {"comment":"B = 5 stripes, C = $90 (toggled to $91 first)"},
        "3638": {"comment":"DE = the stripes' colours"},
        "3641": {"synopsis":"One stripe.","comment":"The next colour as ATTR_T"},
        "3646": {"comment":"C = $90 / $91 in turn"},
        "3650": {"comment":"Printed (ROM 3's PRINT_A)"},
        "3651": {"comment":"Five times"},
        "3653": {"comment":"The sixth colour"},
        "3657": {"comment":"A space after the stripes"},
        "3660": {"comment":"DE = the old UDG"},
        "3661": {"comment":"UDG put back"},
        "3664": {"synopsis":"UDG = STRIPE_GLYPHS, the seven pictures in this page (from $3F4E).\nExit: HL = the old UDG.","comment":"DE = the ROM's pictures"},
        "3669": {"synopsis":"UDG = $D750, the RAM copy of STRIPE_GLYPHS.\nExit: HL = the old UDG.","comment":"DE = the RAM copy"},
        "3672": {"synopsis":"UDG = DE.\nExit: HL = the old UDG.","comment":"HL = the old UDG"},
        "3675": {"comment":"UDG = DE"},
        "3680": {"synopsis":"Two return addresses dropped, a frame waited for and the key flag cleared; then on the\nalternate stack with bank 7 (RST $08), stream 2 current (ROM 3's STREAM_SELECT) and the\nkeyboard reset (KEY_MODE_RESET). A key is waited for (WAIT_KEY) when the state byte ($D5B8)\nis below 4 or ERR_NR holds a report; colour set 1 goes on (COLSET1_APPLY). Then by ($D5B8):\n$FE to $2C1F, $FF to the menu (MENU_RESTART_CLS); otherwise the alternate ROM's $02E5, the\ndisplay swapped back (DISPLAY_RESTORE) and ROM 1's $14B9 with A = 0. No reference to it was\nfound in this page.","comment":"Two return addresses dropped"},
        "3682": {"comment":"A frame"},
        "3684": {"comment":"FLAGS bit 5: no key waiting"},
        "3688": {"comment":"Alternate stack, bank 7 at $C000"},
        "3689": {"comment":"Stream 2 current: ROM 3's STREAM_SELECT"},
        "3694": {"comment":"MODE, REPPER and FLAGS reset"},
        "3697": {"comment":"A = the state byte"},
        "3700": {"comment":"$FE? (Z kept on the stack)"},
        "3703": {"comment":"Below 4: a key waited for"},
        "3707": {"comment":"Otherwise only after a report (ERR_NR not $FF)"},
        "3712": {"synopsis":"The colours and the way on by ($D5B8).","comment":"WAIT_KEY when carry"},
        "3715": {"comment":"Colour set 1 on"},
        "3718": {"comment":"The state byte's test back"},
        "3719": {"comment":"$FE: on at $2C1F"},
        "3722": {"comment":"$FF: the menu again, screen cleared"},
        "3725": {"comment":"The alternate ROM's $02E5"},
        "3730": {"comment":"The display settings back"},
        "3733": {"comment":"A = 0 for ROM 1's $14B9"},
        "3738": {"synopsis":"Applies the column count at $D73D (32, 64 or 85): ROM 1's $14A9 with A = 0 for 32, 9\notherwise. For 64 or 85 the window channel at $FB00 gets COLUMNS_CODES and the character\nwidth (8 for 64 columns, 6 for 85) through $2727 and $275B. No call to it was found in this\npage.","comment":"The column count"},
        "3741": {"comment":"32 columns: A = 0"},
        "3745": {"comment":"64 or 85: A = 9"},
        "3747": {"synopsis":"A = 0 or 9 to ROM 1; Z when 32 columns.","comment":"Kept, with Z for 32"},
        "3748": {"comment":"ROM 1's $14A9 with A"},
        "3752": {"comment":"Done for 32 columns"},
        "3753": {"comment":"IX = the window channel at $FB00"},
        "3759": {"comment":"The codes $1A, $17, $1E"},
        "3765": {"comment":"64 columns?"},
        "3770": {"comment":"Width 8 for 64"},
        "3774": {"comment":"Width 6 for 85"},
        "3776": {"synopsis":"The width printed as code $1E's parameter.","comment":"Printed as code $1E's parameter"},
        "3782": {"synopsis":"The window codes COLUMNS_APPLY prints through $2727 (bit 7 ends the run): $1A, $17 and $1E;\nthe character width that code $1E takes comes after it from $275B."},
        "3785": {"synopsis":"In the standard screen mode (low 4 bits of $5C7F zero): DF_SZ = 2 and ROM 3's CLS_LOWER. In\nanother mode only TV_FLAG bit 5 cleared. From $08B0, $30A9, $321F, $3E41 and $3E5E.","comment":"The low 4 bits of $5C7F: the screen mode"},
        "3790": {"comment":"Standard mode?"},
        "3792": {"comment":"Otherwise TV_FLAG bit 5 cleared only"},
        "3797": {"synopsis":"Standard mode: the lower screen cleared.","comment":"DF_SZ = 2"},
        "3801": {"comment":"ROM 3's CLS_LOWER"},
        "3805": {"synopsis":"Unless the state byte ($D5B8) is 4: colour set 1's saved state put back (COLSET1_RESTORE,\nnot when it is 8), then DISPLAY_SWAP. From $0E92 and $2C03.","comment":"The state byte"},
        "3808": {"comment":"4: nothing to put back"},
        "3811": {"comment":"Not 8: colour set 1's saved state back"},
        "3816": {"synopsis":"Swaps the display settings with the copies from $D5B9 on, after a frame: port $FF (Timex) =\n0; the mode from $D5B9 set through ROM 1's $14A9 and the old $5C7F stored there; port $123B\nand its copy $5B7B with $D5BA; the CPU speed (NextReg $07) with $D5BB; CHARS with\n$D5BC-$D5BD; the four clip windows with the 16 bytes from $D5BE (CLIP_SWAP). Unless ($D5B8)\nis 8, the first 48 bytes of the fonts at $F700 and $FB00 swap with the 48 after them\n(SWAP_48), with MMU 6 changed round it ($2708 / $2797). From $1009.","comment":"The Layer 2 port copy, kept"},
        "3820": {"comment":"$5C7F, kept"},
        "3824": {"comment":"A frame first"},
        "3825": {"comment":"Timex port $FF = 0, the standard screen"},
        "3828": {"comment":"HL = the saved settings"},
        "3831": {"comment":"The saved mode"},
        "3833": {"comment":"Set through ROM 1's $14A9"},
        "3837": {"comment":"The old $5C7F stored instead"},
        "3839": {"comment":"The saved Layer 2 port value"},
        "3841": {"comment":"BC = the Layer 2 port"},
        "3844": {"comment":"Made current and written"},
        "3849": {"comment":"The old value stored instead"},
        "3851": {"comment":"The CPU speed (NextReg $07 AND 3)"},
        "3855": {"comment":"The saved speed written, the old one stored"},
        "3859": {"comment":"The saved CHARS"},
        "3864": {"comment":"Swapped with CHARS"},
        "3874": {"comment":"The clip windows swapped with the 16 bytes"},
        "3877": {"comment":"The state byte 8?"},
        "3882": {"comment":"Yes: done"},
        "3883": {"comment":"MMU 6 changed for the fonts"},
        "3886": {"comment":"The font at $F700: first 48 bytes swapped"},
        "3891": {"comment":"The font at $FB00 likewise"},
        "3896": {"comment":"MMU 6 back"},
        "3899": {"synopsis":"Swaps the four clip windows (NextRegs $18-$1B, Layer 2, sprites, ULA, tilemap; four bytes\neach, index reset by NextReg $1C = $0F) with the 16 bytes at HL. Entered at CLIP_XFER with\ncarry set the registers are only read into HL's bytes.\nExit: HL past the 16 bytes.","comment":"Carry clear: a swap"},
        "3900": {"synopsis":"CLIP_SWAP's body; with carry (from $0316, $10ED) a save: each register written back with its\nown value.","comment":"D = 4 registers, E = $18 the first"},
        "3903": {"comment":"Every clip window's index back to its first value"},
        "3907": {"synopsis":"One register, E = $18-$1B: its four values."},
        "3908": {"comment":"Four values each"},
        "3910": {"synopsis":"One value (the register steps on to the next on each write)."},
        "3911": {"comment":"One value transferred"},
        "3914": {"comment":"The same register again"},
        "3918": {"comment":"The next register"},
        "3924": {"synopsis":"Copies 48 bytes from HL to HL XOR $30, in the same 256-byte page (from $2390 and $2396).","comment":"D = H"},
        "3925": {"comment":"E = L XOR $30"},
        "3930": {"comment":"BC = 48"},
        "3935": {"synopsis":"Swaps the 48 bytes at H*256 with the 48 at H*256 + $30.","comment":"HL = H*256"},
        "3937": {"comment":"DE = H*256 + $30, B = 48"},
        "3941": {"synopsis":"One byte pair.","comment":"The bytes swapped"},
        "3951": {"synopsis":"NEXTREG_XFER with carry clear: NextReg E and the byte at HL swapped. Nothing in this page\ncalls it.","comment":"No carry: a swap"},
        "3952": {"synopsis":"NextReg E written with the byte at HL (no carry) or with its own value (carry), its old\nvalue stored at HL.\nExit: HL and E one on; BC = $253B.\nChanges: A, D.","comment":"A = the byte at HL"},
        "3953": {"comment":"NextReg E selected"},
        "3958": {"comment":"D = its value"},
        "3961": {"comment":"A save (carry)? Its own value written back"},
        "3964": {"synopsis":"The value written; the old one stored.","comment":"Written"},
        "3966": {"comment":"The old value at HL"},
        "3968": {"comment":"The next register"},
        "3970": {"synopsis":"MODE = 0, REPPER = 2 and FLAGS bits 2-3 set. From $0348 and $0E6E.","comment":"MODE = 0"},
        "3974": {"comment":"REPPER = 2"},
        "3978": {"comment":"FLAGS bits 2 and 3 set"},
        "3986": {"synopsis":"Reads the first 32 entries of the ULA's first palette (NextReg $43 = 0) to HL on: two bytes\neach, NextReg $41 (8-bit colour) and NextReg $44 (the 9th bit).\nExit: HL past the 64 bytes; BC = $243B.","comment":"The ULA's first palette, D = 32 entries"},
        "3989": {"comment":"BC = the NextReg select port"},
        "3995": {"comment":"From entry 0"},
        "3997": {"synopsis":"One entry.","comment":"NextReg $40 = the entry"},
        "4001": {"comment":"NextReg $41: its 8-bit colour"},
        "4009": {"comment":"Stored"},
        "4011": {"comment":"NextReg $44: its 9th bit"},
        "4019": {"comment":"Stored"},
        "4021": {"comment":"The next entry"},
        "4026": {"synopsis":"Writes 32 entries of the ULA's first palette from HL on (two bytes each to NextReg $44).\nExit: HL past the 64 bytes.","comment":"32 entries of the ULA's first palette from 0"},
        "4034": {"synopsis":"One entry.","comment":"NextReg $40 = the entry"},
        "4038": {"comment":"The first byte to NextReg $44"},
        "4043": {"comment":"The second byte"},
        "4048": {"comment":"The next entry"},
        "4053": {"synopsis":"Builds a colour set at DE (the 32 bytes from HL, then the current palette, PALETTE_READ) and\nstores its $60 bytes at BC through COLSET_PUT. From $0336 (set 0 at $3700) and $0342 (set 1\nat $3760).\nExit: carry set.","comment":"BC kept: where the set goes"},
        "4054": {"comment":"The first 32 bytes copied to DE"},
        "4060": {"comment":"The palette after them"},
        "4064": {"comment":"HL = the set built"},
        "4065": {"comment":"DE = where it goes"},
        "4068": {"synopsis":"Colour set operation A (from $3347): 1 set 0 ($3700) copied to HL; 2 HL's $60 bytes stored\nas set 0; 3 set 0 applied (COLSET0_APPLY); 4 its saved state put back (COLSET0_RESTORE); 5\nset 1 ($3760) copied to HL; 6 or more HL stored as set 1.\nExit: carry set.","comment":"Set 0"},
        "4071": {"comment":"1: set 0 copied to HL"},
        "4074": {"comment":"2: HL stored as set 0"},
        "4077": {"comment":"3: set 0 applied"},
        "4080": {"comment":"4: set 0's saved state back"},
        "4084": {"comment":"Set 1"},
        "4087": {"comment":"5: set 1 copied to HL; 6 or more stored"},
        "4090": {"synopsis":"HL and DE swapped: the set at DE copied to the buffer at HL.","comment":"Copied from DE to HL"},
        "4091": {"synopsis":"$60 bytes from HL to DE through ROM 2's $0068.\nExit: carry set.","comment":"$60 bytes"},
        "4094": {"comment":"ROM 2's $0068: HL to DE"},
        "4097": {"comment":"Carry: done"},
        "4099": {"synopsis":"Unless the state byte ($D5B8) is 4: DISPLAY_SWAP, then colour set 1 ($3760) applied with the\nstate saved at $D694. From $0345, $0E83, $11B5 and $2C09.","comment":"The state byte 4?"},
        "4105": {"comment":"The display settings swapped"},
        "4108": {"comment":"HL = where the old state goes"},
        "4111": {"comment":"DE = set 1"},
        "4116": {"synopsis":"Colour set 0 ($3700) applied, the state saved at $D5ED.","comment":"HL = where the old state goes"},
        "4119": {"comment":"DE = set 0"},
        "4122": {"synopsis":"Saves the display's colour state at HL: NextRegs $43, $15 and $14, ATTR_P, ($5B62), BORDCR,\nthen the palette (PALETTE_READ); fetches the set at DE (COLSET_GET) behind it and applies\nit: palette from its byte 32 on, its byte 0 as ATTR_P, BORDCR and the border, ($5B62) = byte\n0 inverted AND $38; NextReg $14 = NextReg $4A, NextReg $15 = 0.\nExit: carry set.","comment":"Kept for the fetch"},
        "4123": {"comment":"NextReg $43, the palette control"},
        "4128": {"comment":"Saved"},
        "4130": {"comment":"NextReg $15, the layer order"},
        "4137": {"comment":"NextReg $14, the global transparency"},
        "4144": {"comment":"ATTR_P"},
        "4149": {"comment":"($5B62)"},
        "4154": {"comment":"BORDCR"},
        "4159": {"comment":"The palette, 64 bytes"},
        "4162": {"comment":"DE = the set"},
        "4163": {"comment":"The set fetched behind the saved state"},
        "4168": {"comment":"Its palette, 32 bytes on, written"},
        "4176": {"comment":"HL = the set's first byte"},
        "4177": {"comment":"ATTR_P and BORDCR = it"},
        "4185": {"comment":"Its paper bits make the border"},
        "4191": {"comment":"($5B62) = its ink bits inverted"},
        "4197": {"comment":"NextReg $14 = NextReg $4A"},
        "4205": {"comment":"NextReg $15 = 0"},
        "4209": {"comment":"Carry: done"},
        "4211": {"synopsis":"Puts back the state COLSET1_APPLY saved at $D694.","comment":"Set 1's saved state"},
        "4216": {"synopsis":"Puts back the state COLSET0_APPLY saved at $D5ED (from $0FF1 and $320A).","comment":"Set 0's saved state"},
        "4219": {"synopsis":"From the 70 bytes at HL: NextReg $15, NextReg $14, ATTR_P, ($5B62), BORDCR and the border,\nthe palette (PALETTE_WRITE), then NextReg $43.\nExit: carry set.","comment":"The palette control, kept for last"},
        "4221": {"comment":"NextReg $15"},
        "4226": {"comment":"NextReg $14"},
        "4231": {"comment":"ATTR_P"},
        "4236": {"comment":"($5B62)"},
        "4241": {"comment":"BORDCR"},
        "4246": {"comment":"And the border from it"},
        "4251": {"comment":"The palette written"},
        "4255": {"comment":"NextReg $43 back"},
        "4259": {"comment":"Carry: done"},
        "4261": {"synopsis":"The first 32 bytes of colour set 0 as COLSET_INIT first stores it at $3700 (with the ULA\npalette read after it): byte 0, $38, is what COLSET_APPLY makes ATTR_P and BORDCR. Copied\nthrough $D633 at $032D."},
        "4293": {"synopsis":"The first 32 bytes of colour set 1, stored the same way at $3760 through $D6DA (at $0339):\nbyte 0, $38, becomes ATTR_P and BORDCR when the set is applied."},
        "4325": {"synopsis":"The screen saver WAIT_KEY starts when no key came for its minutes: MMU 1 = page $10, the\nclip windows saved there at $23B7 (CLIP_XFER); border black; NextReg $15 bit 1 cleared and\nport $FF ORed with $38 (both kept). A window 24 pixels square (empty when $5C81 bit 7 is\nset) then moves about the screen, one step a frame from FRAMES, bouncing at the edges,\nclipping every layer, until a key (FLAGS bit 5). Then the full clips, NextReg $15, port $FF,\nthe border and the clip windows back, MMU 1 = $FF, and on to WAIT_KEY again.","comment":"MMU 1 = page $10"},
        "4329": {"comment":"The clip windows saved at $23B7 there"},
        "4336": {"comment":"Border black"},
        "4339": {"comment":"NextReg $15 read into H"},
        "4349": {"comment":"Timex port $FF into L"},
        "4352": {"comment":"Both kept"},
        "4353": {"comment":"Port $FF with bits 3-5 set"},
        "4357": {"comment":"NextReg $15 bit 1 cleared"},
        "4361": {"comment":"FRAMES, a different start each time"},
        "4364": {"comment":"Both bytes below $80"},
        "4368": {"comment":"D = 1-4, the step across"},
        "4373": {"comment":"E = 1-4, the step down"},
        "4378": {"synopsis":"One frame: the window moved by D across and E down.","comment":"Across: past the right edge?"},
        "4384": {"comment":"Yes: the step turned round"},
        "4389": {"synopsis":"H = the new left edge; the X clip set.","comment":"H = the left edge"},
        "4390": {"comment":"The X clips: tilemap halved, plus $10"},
        "4395": {"comment":"Down: past the bottom?"},
        "4401": {"comment":"Yes: the step turned round"},
        "4406": {"synopsis":"L = the new top edge; the Y clip set.","comment":"L = the top edge"},
        "4407": {"comment":"The Y clips: tilemap plus $20"},
        "4412": {"comment":"A frame"},
        "4413": {"comment":"A key?"},
        "4419": {"comment":"X 0-255 for every window again"},
        "4426": {"comment":"Y 0-191"},
        "4433": {"comment":"NextReg $15 and port $FF back"},
        "4441": {"comment":"The border from BORDCR"},
        "4449": {"comment":"The key used up"},
        "4453": {"comment":"The clip windows back from $23B7"},
        "4459": {"comment":"MMU 1 back to the ROM"},
        "4463": {"comment":"And on waiting for a key"},
        "4466": {"synopsis":"B = 24, or $FF when $5C81 bit 7 is set (no window), then CLIP_AXIS.","comment":"A window 24 pixels across"},
        "4468": {"comment":"$5C81 bit 7: no window"},
        "4476": {"synopsis":"Writes one axis to all four clip windows: A to A + B to Layer 2, sprites and ULA ($18-$1A);\nthe tilemap ($1B) gets them halved when C bit 7 is set and moved on by (C AND $3F) x 2 when\nC bit 6 is set. Keeps BC, DE, HL.","comment":"Kept"},
        "4479": {"comment":"E = the start"},
        "4480": {"comment":"D = the end"},
        "4482": {"comment":"L = $18 the first register, H = 3 of them"},
        "4485": {"synopsis":"One of the three windows.","comment":"The register selected"},
        "4491": {"comment":"Its start and end"},
        "4495": {"comment":"The next register"},
        "4499": {"comment":"Now NextReg $1B, the tilemap's"},
        "4503": {"comment":"HL = the old BC"},
        "4504": {"comment":"C bit 7: halve; L = its bits 5-0 x 2"},
        "4507": {"comment":"The start"},
        "4510": {"comment":"Halved"},
        "4512": {"synopsis":"The start, offset when C bit 6 was set.","comment":"C bit 6: the offset added"},
        "4519": {"synopsis":"The tilemap's start written.","comment":"Written"},
        "4522": {"comment":"The end, likewise"},
        "4527": {"synopsis":"The end, offset likewise, written."},
        "4528": {"comment":"Written"},
        "4533": {"synopsis":"Colour set 1 on (COLSET1_APPLY), then MENU_RESTART_CLS. No reference to it was found in this\npage.","comment":"Colour set 1 on"},
        "4536": {"synopsis":"Clears the whole screen (CLEAR_LINES, lines 0-23), then MENU_RESTART. The menu's action 9\n(the table at $08CD); also from $0E8A and $2C1C.","comment":"All 24 lines"},
        "4539": {"comment":"Cleared"},
        "4542": {"synopsis":"State byte $D5B8 = $FF, the machine stack reset to $5BFF; then the menus at $0645 for ever:\nmenu 0 while ($D744) is not zero, menu 1 after one that leaves it zero. From $0357.","comment":"The state byte = $FF"},
        "4547": {"comment":"A fresh machine stack"},
        "4550": {"synopsis":"Menu 0.","comment":"Menu 0"},
        "4551": {"synopsis":"Menu A shown and run.","comment":"Shown and run"},
        "4554": {"comment":"Stay on menu 0?"},
        "4560": {"comment":"Otherwise menu 1"},
        "4564": {"synopsis":"The menu's action 6 (the table at $08CD): only with the state byte ($D5B8) zero, the return\naddress dropped and the alternate ROM's $1332 called.","comment":"Only in state 0"},
        "4569": {"comment":"The return address dropped"},
        "4570": {"comment":"The alternate ROM's $1332"},
        "4576": {"synopsis":"Waits for a key, a frame at a time, and returns it. With $5C81 AND $7F = n not zero, about n\nx 2750 frames (n minutes, near enough) without a key start the SCREEN_SAVER. When $5B68 bit\n1 is set ROM 1's $3791 runs first. CAPS LOCK ($06) toggles FLAGS2 bit 3, codes $0E and $0F\ntoggle MODE between 0 and 1 or 2, and any other key clears MODE bit 0. Unless FLAGS2 bit 7\nor MODE bit 1 is set, the code is translated through KEY_TRANSLATE.\nExit: A = the code, carry set.","comment":"The saver's minutes, $5C81 bits 0-6"},
        "4581": {"synopsis":"A = minutes left; BC = the frame count for one.","comment":"Kept"},
        "4582": {"comment":"$5B68 bit 1?"},
        "4589": {"comment":"Yes: ROM 1's $3791"},
        "4592": {"synopsis":"BC = $0BB8: about 2750 frames counted down.","comment":"About 2750 frames: near a minute"},
        "4595": {"comment":"A = the minutes left"},
        "4596": {"synopsis":"One frame counted down, unless the saver is off.","comment":"None set: no saver"},
        "4599": {"comment":"Frames counted down"},
        "4604": {"comment":"Minutes over: the screen saver"},
        "4608": {"comment":"Another minute"},
        "4610": {"synopsis":"A frame; a new key?","comment":"A frame"},
        "4611": {"comment":"A new key? (FLAGS bit 5)"},
        "4618": {"comment":"Taken"},
        "4620": {"comment":"A = the key"},
        "4623": {"comment":"HL = MODE"},
        "4626": {"comment":"$0E?"},
        "4630": {"comment":"Any other key: MODE bit 0 cleared"},
        "4632": {"comment":"$10 and up: no mode handling"},
        "4636": {"synopsis":"Codes below $10 (and $0E): CAPS LOCK and the mode keys.","comment":"Kept"},
        "4637": {"comment":"CAPS LOCK?"},
        "4641": {"comment":"Yes: FLAGS2 bit 3 toggled"},
        "4650": {"synopsis":"Not CAPS LOCK: $0E and $0F toggle MODE.","comment":"Below $0E: nothing to do"},
        "4654": {"comment":"$0E gives 1, $0F gives 2"},
        "4656": {"comment":"The same mode as now?"},
        "4657": {"comment":"The new mode"},
        "4660": {"comment":"The same: back to 0"},
        "4662": {"synopsis":"TV_FLAG bit 3 set: the mode has changed.","comment":"TV_FLAG bit 3: mode changed"},
        "4666": {"synopsis":"The code back.","comment":"The key"},
        "4667": {"synopsis":"Translated through KEY_TRANSLATE unless FLAGS2 bit 7 or MODE bit 1 is set.","comment":"FLAGS2 bit 7: the key as it is"},
        "4673": {"comment":"MODE bit 1: as it is"},
        "4678": {"comment":"The translation pairs"},
        "4681": {"comment":"8 of them"},
        "4683": {"synopsis":"One pair.","comment":"The pair's first byte?"},
        "4687": {"comment":"Yes: its second byte"},
        "4688": {"synopsis":"The next pair."},
        "4689": {"comment":"The next pair"},
        "4691": {"comment":"Carry: a key"},
        "4693": {"synopsis":"WAIT_KEY, then a click ($3E20 with A = PIP, HL = $00C8).\nExit: A = the code, carry set.","comment":"A key"},
        "4696": {"comment":"Kept"},
        "4697": {"comment":"A = PIP"},
        "4700": {"comment":"HL = $00C8"},
        "4703": {"comment":"The click"},
        "4708": {"synopsis":"WAIT_KEY's 8 key translations, a pair each (code read, code given): $C6 to \"[\", $C5 to \"]\",\n$C7 to $7F (the copyright sign), $E2 to \"~\", $C3 to \"|\", $CD to \"\\\", $CC to \"{\" and $CB to\n\"}\" - the keyword codes the symbol-shifted keys give, turned into the characters they carry."},
        "4724": {"synopsis":"CLEAR_LINES for lines 21-23 (from $3F53).","comment":"Lines 21 to 23"},
        "4727": {"synopsis":"Clears screen lines B to C: their pixel bytes to 0 (in a Timex mode, $5C7F bit 3, the second\ndisplay file's too, with MMU 3 = page $0B) and their attributes to ATTR_P.\nExit: carry set.","comment":"C = the lines to clear"},
        "4731": {"comment":"B = 24 - the first line"},
        "4735": {"synopsis":"One line: HL = its display address (ROM 3's LINE_SCREEN_ADDR).","comment":"Kept"},
        "4736": {"comment":"HL = the line's display address (ROM 3)"},
        "4739": {"comment":"8 pixel rows"},
        "4741": {"comment":"A Timex mode? ($5C7F bit 3)"},
        "4747": {"comment":"A' = page $0B for MMU 3"},
        "4751": {"comment":"MMU 3 swapped in"},
        "4754": {"synopsis":"One pixel row in both display files."},
        "4755": {"comment":"32 bytes of the first display file"},
        "4758": {"synopsis":"One byte of the first."},
        "4763": {"comment":"And of the second, $2000 on"},
        "4768": {"synopsis":"One byte of the second, $2000 on."},
        "4772": {"comment":"The next pixel row"},
        "4777": {"comment":"MMU 3 back"},
        "4782": {"synopsis":"One of the line's 8 pixel rows.","comment":"32 bytes of the row cleared"},
        "4786": {"synopsis":"One byte."},
        "4791": {"comment":"The next pixel row"},
        "4795": {"synopsis":"The line's 32 attributes (ROM 3's LINE_ATTR_ADDR) set to ATTR_P.","comment":"32 attributes"},
        "4798": {"comment":"DE = the line's attributes (ROM 3)"},
        "4803": {"comment":"Set to ATTR_P"},
        "4806": {"synopsis":"One attribute."},
        "4810": {"comment":"The next line"},
        "4815": {"comment":"Carry: done"},
        "4817": {"synopsis":"Swaps NextReg $53 (MMU 3) with A'. Keeps AF, BC."},
        "4819": {"comment":"The value of MMU 3"},
        "4824": {"comment":"Swapped with A'"},
        "4825": {"comment":"And written"},
        "4830": {"synopsis":"A = the value of NextReg A, read through ports $243B and $253B.\nExit: BC = $253B.","comment":"The register selected"},
        "4835": {"comment":"Read"},
        "4839": {"synopsis":"The file browser's two key-help lines, ended by $FF (passed in DE at $2C12): \"Guide Links\nENTER=select EDIT=up EXTEND=more BREAK\", $0D, then \"Drive Copy Move Rename Erase Mkdir\nUnmount Remount\". Each key letter sits between $14 $01 and $14 $00 (INVERSE 1, INVERSE 0);\n$19 and three bytes (probably a position) come before most words."},
        "5074": {"synopsis":"\"Change to destination and press P to paste\", ended by $FF (from $3303)."},
        "5117": {"synopsis":"A browser status line, ended by $FF (from $3516): \"Order:\", \"+-\", \"Info:\", \"Name\", \"Area\",\n\"miX o\", each after $19 and three bytes."},
        "5178": {"synopsis":"$19 and three bytes, then \"searcH\", ended by $FF (from $3533)."},
        "5189": {"synopsis":"Codes ended by $FF (from $33D4): AT 22,0, a space, $17 $00 $00, a space, $17 $00 $00, AT\n22,0."},
        "5204": {"synopsis":"\"..\", ended by $FF (from $2BF8 and $3255)."},
        "5207": {"synopsis":"\"New name: \", ended by $FF (from $3917)."},
        "5218": {"synopsis":"\"Paste as: \", ended by $FF (from $3A96)."},
        "5229": {"synopsis":"\"copying...\", ended by $FF (from $3AC6)."},
        "5240": {"synopsis":"\"erasing...\", ended by $FF (from $3976)."},
        "5251": {"synopsis":"A file name ended by $00: $7F, \"browser.cfg\" (the system folder, see SYS_FOLDER_TEXT). From\n$3B99."},
        "5264": {"synopsis":"A file name ended by $00: $7F, \"enBrowsext.cfg\". From $2EAD."},
        "5280": {"synopsis":"Codes and text that run on into \"Filter:\" (from $3277): $1E $05, AT 21,37 (as bytes), \"S\n{\", $19 and three bytes, \".\", AT 21,15."},
        "5297": {"synopsis":"\"Filter:\", ended by $FF (from $3986, and the end of BRW_FILTER_TXT)."},
        "5305": {"synopsis":"\"User area (0..15): \", ended by $FF (from $399C)."},
        "5325": {"synopsis":"$1E $05, AT 22,0, ended by $FF (from $33D9)."},
        "5331": {"synopsis":"Five words, each ended by $FF: \"name\" ($14D3), \"none\" ($14D8), \"date\" ($14DD), \"size\"\n($14E2), \"attr\" ($14E7); SORT_PTRS_A and SORT_PTRS_B point at them."},
        "5356": {"synopsis":"Four pointers into SORT_WORDS (name, none, date, size), then at +8 the position codes $19\n$08 $20 $00 ended by $FF. $33E3 prints the codes, then the word picked by A AND 3 (from\n$353D)."},
        "5364": {"synopsis":"SORT_PTRS_A's position codes: $19 $08 $20 $00, ended by $FF."},
        "5369": {"synopsis":"Four pointers into SORT_WORDS (none, size, date, attr), then the position codes $19 $08 $EB\n$00 ended by $FF. Used like SORT_PTRS_A (from $3543, with A = ($D5EA))."},
        "5377": {"synopsis":"SORT_PTRS_B's position codes: $19 $08 $EB $00, ended by $FF."},
        "5382": {"synopsis":"$19 $00 $01 $00, ended by $FF (from $3488)."},
        "5387": {"synopsis":"\"Search:\", $0D, ended by $FF (from $3596)."},
        "5396": {"synopsis":"\"EXTEND=files/dirs\", ended by $FF (from $359C)."},
        "5414": {"synopsis":"AT 2,0, INVERSE 1, \" Processing... \", INVERSE 0, a space, ended by $FF (from $2CDC)."},
        "5438": {"synopsis":"\"Press any key\", ended by $FF (from $3A1E)."},
        "5452": {"synopsis":"A command line: \"CLS:LOAD\"RUN.BAS\"\", $0D (from $30CE). RUN_GDE_TXT follows."},
        "5470": {"synopsis":"\"run\", which runs on into GDE_EXT_TXT: \"run.gde\" (from $303D)."},
        "5473": {"synopsis":"\".gde\", ended by $FF (from $3067)."},
        "5478": {"synopsis":"\"c:/docs/guides/browser.gde\", ended by $FF (from $3076 and the PUSH at $3092)."},
        "5505": {"synopsis":"\"c:\", ended by $FF (BC = $1581 at $31EA)."},
        "5508": {"synopsis":"\"c:/links\", ended by $FF (from $3248)."},
        "5517": {"synopsis":"\"NextLink\", 8 bytes with no end mark: $3135 compares 8 bytes against it."},
        "5525": {"synopsis":"Four file extensions of 3 letters, no end marks: \"RUN\" (from $31C7), \"LNK\" ($1598, from\n$2DA0), \"BAS\" ($159B) and \"SCR\" ($159E). $31CA steps DE on before each compare, and $2E1B /\n$2E2C load HL with $159A / $159D, one byte before \"BAS\" / \"SCR\"."},
        "5528": {"synopsis":"\"LNK\" (from $2DA0)."},
        "5531": {"synopsis":"\"BAS\" (reached as $159A + 1)."},
        "5534": {"synopsis":"\"SCR\" (reached as $159D + 1)."},
        "5537": {"synopsis":"Looks A up in the table at HL - entries of a byte and a routine address, ended by $FF - and\ncalls the routine found, with BC and DE kept and HL past the entry; it returns to the caller\nthrough RET_Z_SET. Not found: carry clear and NZ, BC and DE kept, HL = $15C4. From $078A,\n$2899 and $2C82.","comment":"The return goes through RET_Z_SET"},
        "5543": {"synopsis":"One entry: B = its byte, DE = its address.","comment":"The entry's byte"},
        "5544": {"comment":"$FF: the end"},
        "5548": {"comment":"DE = the routine's address"},
        "5553": {"comment":"Is it A?"},
        "5556": {"comment":"The next entry"},
        "5558": {"synopsis":"The $FF end: carry clear, NZ, the pushed return dropped.","comment":"Not found: carry clear"},
        "5559": {"comment":"NZ"},
        "5562": {"comment":"RET_Z_SET dropped"},
        "5564": {"synopsis":"Found: the routine's address goes on the stack, DE back.","comment":"Found: BC back"},
        "5565": {"comment":"The routine's address replaces DE on the stack"},
        "5568": {"comment":"Into the routine"},
        "5569": {"synopsis":"Calls the routine at HL, then returns with Z set and H = 0 (from $07AD).","comment":"The routine at HL"},
        "5572": {"synopsis":"H = 0 and Z set: where TABLE_DISPATCH's routines return.","comment":"H = 0 and Z set"},
        "5576": {"synopsis":"Jumps to HL: a CALL here calls the routine at HL."},
        "5577": {"synopsis":"RST $30: RAM bank 0 at $C000 with this ROM (NextReg $8E = $08), then BANK_SP_SWAP.\nChanges: AF' only.","comment":"Bank 0 at $C000, this ROM"},
        "5581": {"synopsis":"SP swapped with the stack pointer kept at $5B6A, the return address moved to the new stack\n(from $19E1 and $19FA, without the paging).\nChanges: AF' only.","comment":"AF kept in AF'"},
        "5582": {"comment":"AF = the return address"},
        "5583": {"comment":"HL kept"},
        "5586": {"comment":"SP and the stack at $5B6A swapped"},
        "5594": {"comment":"HL back"},
        "5597": {"comment":"The return address onto the new stack"},
        "5598": {"comment":"AF back"},
        "5600": {"synopsis":"RST $08: SP swapped with $5B6A, the return address moved to the new stack, then RAM bank 7\nat $C000 with this ROM (NextReg $8E = $78).\nChanges: AF' only.","comment":"AF kept in AF'"},
        "5601": {"comment":"AF = the return address"},
        "5602": {"comment":"HL kept"},
        "5605": {"comment":"SP and the stack at $5B6A swapped"},
        "5613": {"comment":"HL back"},
        "5616": {"comment":"The return address onto the new stack"},
        "5617": {"comment":"AF back"},
        "5618": {"comment":"Bank 7 at $C000, this ROM"},
        "5630": {"synopsis":"ROM 3 calls a channel's routine from $15FB, so its return address is $15FE; a routine that\ncomes back with this page selected lands here. HL = CURCHL, then the channel letter is\nhandled at $036C. $038A, $03AD and $03CD push $15FE and select ROM 3, so that ROM 3's own\ncode at $15FE finishes the call.","comment":"HL = the current channel"},
        "5633": {"comment":"Its letter handled"},
        "5636": {"synopsis":"The window channel's control-code routines, 36 words, indexed by the code at $1D5E: $00-$0F\nrun at once with A = the code; $10-$1F are kept at +$26 and run with A = the byte after them\n(their parameter); indexes $20-$23 are set at +$26 by $1AF1. In this range: code 0\nWCH_CODE_0, 1 WCH_CODE_1, 2 WCH_CODE_2, 3 WCH_CODE_3, $1E WCH_ALIGN_WIDTH, $1F\nWCH_KEEP_CODES."},
        "5708": {"synopsis":"The control codes while the line buffer is on (WB_OUT, through WB_CODE): 32 words indexed by\nthe code. 0 is WCH_BUF_OFF, $0D WB_FLUSH, $1E WB_ALIGN_NEXT; $10-$15, $18, $1A, $1B and $1D\ngo to WB_KEEP_CODE; 2-5, 7, $0A, $0B, $0E and $0F share the routines of WCH_CODES; $1A44 (a\nRET) drops 1, 6, 8, 9, $0C, $16, $17, $19, $1C and $1F."},
        "5772": {"synopsis":"Code $1E with the buffer on: +$25 bits 6 and 7 set, so that the next byte is taken as code\n$1E's parameter (WB_PARAM).","comment":"The next byte is a parameter"},
        "5776": {"comment":"And it is code $1E's"},
        "5781": {"synopsis":"HL = IX + $30, the window's line buffer.","comment":"HL = IX"},
        "5784": {"comment":"Plus $30"},
        "5789": {"synopsis":"The line buffer (HL, WCH_BUF_ADDR) and its size BC: 255 bytes when control codes are kept\n(+$19 bit 7), otherwise the characters a line + 1.","comment":"HL = the buffer"},
        "5792": {"comment":"255 bytes when control codes are kept"},
        "5795": {"comment":"+$19 bit 7?"},
        "5800": {"comment":"Otherwise a line's characters"},
        "5803": {"comment":"Plus one"},
        "5806": {"synopsis":"A = 32 when IX is below $0100 (no window); otherwise WCH_LINE_CHARS. From $298A and $299A.","comment":"32 when there is no window"},
        "5808": {"comment":"IX below $0100?"},
        "5813": {"synopsis":"A = the characters a line (+$1C), halved when +$25 bit 4 is set.","comment":"The characters a line"},
        "5816": {"comment":"Double width?"},
        "5821": {"comment":"Halved"},
        "5824": {"synopsis":"Prints A through the window's own output at $1D47, keeping every register.","comment":"Every register kept"},
        "5828": {"comment":"E = the character"},
        "5829": {"comment":"The window's output"},
        "5837": {"synopsis":"Code $1E's parameter while the buffer is on: +$25 bit 7 cleared, then WCH_ALIGN_WIDTH.","comment":"Code $1E's parameter taken"},
        "5841": {"synopsis":"Code $1E's parameter A. With +$19 bit 4 set it is the character width (3-8): WCH_SET_WIDTH.\nOtherwise WCH_ALIGN.","comment":"The font mode?"},
        "5847": {"synopsis":"Width A: its font ($22D4) to +$0D-$0E, the width to +$0F, a mask of A high bits to +$10, and\nthe characters a line, +$1C = (+$11 x 8, x 2 when +$1D bit 4 is set) / A; then a new line\n($2043).","comment":"HL = the font for width A"},
        "5850": {"comment":"+$0F = the width"},
        "5853": {"comment":"C = B = the width"},
        "5855": {"comment":"A mask of B high bits"},
        "5856": {"synopsis":"One bit of the mask."},
        "5860": {"comment":"+$10 = the mask"},
        "5863": {"comment":"+$0D-$0E = the font"},
        "5869": {"comment":"HL = the cells across"},
        "5873": {"comment":"Times 8: pixels"},
        "5876": {"comment":"A counts the characters"},
        "5877": {"comment":"Double width?"},
        "5883": {"comment":"Twice the pixels"},
        "5884": {"synopsis":"One character more on a line.","comment":"One character's width off"},
        "5889": {"comment":"A = the characters that fit"},
        "5890": {"comment":"+$1C = the characters a line"},
        "5893": {"comment":"And a new line"},
        "5896": {"synopsis":"The alignment, A AND 3, into +$19 bits 0-1: 0 as it comes, 1 centred, 2 justified\n(WB_PUT_LINE); 3 is ignored.","comment":"The alignment"},
        "5898": {"comment":"3: ignored"},
        "5901": {"comment":"B = the new alignment"},
        "5902": {"comment":"Into +$19 bits 0-1"},
        "5912": {"synopsis":"A control code with the buffer on: its routine from WCH_BUF_CODES.","comment":"The buffer's control-code table"},
        "5915": {"comment":"Its routine for code A"},
        "5918": {"synopsis":"A parameter: +$25 bit 6 cleared; code $1E's (bit 7 set) is used at once (WB_PARAM_1E), any\nother stored after its code.","comment":"The parameter flag cleared"},
        "5922": {"comment":"Code $1E's?"},
        "5926": {"comment":"Yes: used at once"},
        "5928": {"comment":"Otherwise stored"},
        "5930": {"synopsis":"Codes $10-$15, $18, $1A, $1B, $1D with the buffer on: kept in it, and the parameter after\nthem too (+$25 bit 6), when +$19 bit 7 says so; otherwise dropped.","comment":"Codes kept? (+$19 bit 7)"},
        "5934": {"comment":"No: dropped"},
        "5935": {"comment":"Yes: its parameter is next"},
        "5939": {"comment":"The code stored"},
        "5941": {"synopsis":"The window channel's output while the line buffer is on (+$19 bit 5, from $1D44): characters\ngather in the buffer and leave it a line at a time, broken at a space or after punctuation.\nEntry: E = the character.","comment":"A = the character"},
        "5942": {"comment":"A parameter expected?"},
        "5948": {"comment":"A control code?"},
        "5952": {"synopsis":"Text: a space is dropped while the buffer has nothing printable; otherwise it marks a break.","comment":"Not a space?"},
        "5954": {"comment":"The printable count"},
        "5957": {"comment":"None yet: a leading space dropped"},
        "5959": {"comment":"The break: its printable count"},
        "5962": {"comment":"And the offset of the byte before it"},
        "5969": {"comment":"The space counted"},
        "5974": {"synopsis":"Not a space: counted, and a break after punctuation (WB_PUNCT_BREAK).","comment":"Counted"},
        "5977": {"comment":"A break after punctuation?"},
        "5980": {"synopsis":"Stores E in the buffer (+$29 bytes in it); then a line out when the buffer is full or holds\nmore than a line.","comment":"HL = the buffer"},
        "5983": {"comment":"Plus the bytes in it"},
        "5988": {"comment":"The byte stored"},
        "5989": {"comment":"One more"},
        "5993": {"comment":"A parameter to come?"},
        "5998": {"comment":"Full ($FE bytes)?"},
        "6002": {"comment":"The characters a line"},
        "6005": {"comment":"Still fit?"},
        "6009": {"synopsis":"Prints one line from the buffer: all of it when its printable characters (+$2A) fit, else up\nto the last break (+$2B, +$2C), else as much as fits (WB_HARD_BREAK).","comment":"The characters a line"},
        "6012": {"comment":"All of the buffer fits?"},
        "6017": {"comment":"The break's printable count"},
        "6020": {"comment":"1 counts even at offset 0"},
        "6022": {"comment":"The break's offset"},
        "6027": {"comment":"At offset 0: no usable break"},
        "6030": {"synopsis":"Up to the break: C = its offset + 1 bytes, B = +$2C printable characters.","comment":"C = the bytes up to the break"},
        "6032": {"comment":"B = its printable characters"},
        "6037": {"synopsis":"No break that fits: a line's worth of characters printed, with any control codes and their\nparameters.","comment":"HL = the buffer"},
        "6040": {"comment":"B = the characters a line"},
        "6044": {"comment":"C counts the bytes"},
        "6046": {"synopsis":"One byte.","comment":"The next byte"},
        "6049": {"comment":"A control code?"},
        "6053": {"comment":"It and its parameter printed"},
        "6062": {"comment":"Not counted as characters"},
        "6064": {"synopsis":"A printable character, counted.","comment":"Printed"},
        "6067": {"comment":"Until a line's worth"},
        "6069": {"comment":"Then the bytes taken out"},
        "6071": {"synopsis":"All of the buffer: C = its bytes, B = its printable characters.","comment":"C = all the bytes"},
        "6074": {"comment":"B = all the printable ones"},
        "6077": {"synopsis":"Prints C bytes from the buffer as a line of B printable characters, aligned by +$19 bits\n0-1: 0 as they are, 1 centred (half the room first as spaces), 2 justified (the room shared\nout among the spaces). Then WB_DROP.","comment":"No bytes?"},
        "6080": {"comment":"HL = the buffer"},
        "6083": {"comment":"The alignment"},
        "6086": {"comment":"0: as they are"},
        "6090": {"comment":"E = the room, characters a line less B"},
        "6095": {"comment":"Justified?"},
        "6102": {"comment":"Centred: half the room"},
        "6105": {"synopsis":"One space of the half room.","comment":"As spaces"},
        "6118": {"synopsis":"Justified: D = the spaces among the C bytes.","comment":"Justified: the spaces counted"},
        "6120": {"comment":"D = the spaces"},
        "6122": {"synopsis":"One byte.","comment":"The next byte"},
        "6124": {"comment":"A space?"},
        "6129": {"synopsis":"A control code's parameter skipped.","comment":"A control code?"},
        "6131": {"comment":"Its parameter skipped"},
        "6133": {"synopsis":"The next.","comment":"Until the C bytes are done"},
        "6138": {"synopsis":"The C bytes printed.","comment":"BC = the bytes, kept"},
        "6141": {"synopsis":"One byte; a control code with its parameter; after a space when justified, its share of the\nroom (E) as more spaces.","comment":"The next byte printed"},
        "6145": {"comment":"A control code?"},
        "6149": {"comment":"Its parameter printed too"},
        "6157": {"synopsis":"A space when justified: its share.","comment":"Not a space: on"},
        "6159": {"comment":"Justified?"},
        "6166": {"comment":"B = the room per space left"},
        "6169": {"synopsis":"B = E divided by D."},
        "6175": {"synopsis":"The share printed; one space fewer left.","comment":"One space fewer to come"},
        "6176": {"comment":"No share?"},
        "6180": {"comment":"The room less the share"},
        "6183": {"synopsis":"One extra space.","comment":"Extra spaces"},
        "6190": {"synopsis":"The next byte.","comment":"The next byte"},
        "6194": {"comment":"BC = the bytes printed"},
        "6195": {"synopsis":"A new line ($2043); the buffer emptied and the bytes after the C printed fed back through\nWB_OUT_TEXT and WB_STORE, leading spaces dropped.","comment":"A new line"},
        "6200": {"comment":"HL = past the bytes printed"},
        "6204": {"comment":"B = the bytes left"},
        "6209": {"comment":"Kept, with Z when none"},
        "6210": {"comment":"The buffer empty"},
        "6214": {"comment":"Nothing left"},
        "6215": {"synopsis":"One leading space skipped.","comment":"A leading space?"},
        "6220": {"comment":"Skipped"},
        "6224": {"synopsis":"One byte fed back.","comment":"The next byte"},
        "6228": {"comment":"A control code?"},
        "6232": {"comment":"Text fed back"},
        "6235": {"synopsis":"The next."},
        "6237": {"comment":"The next"},
        "6241": {"synopsis":"A control code and its parameter stored as they are.","comment":"The code stored"},
        "6246": {"comment":"Its parameter"},
        "6251": {"comment":"Stored too"},
        "6257": {"synopsis":"Code 0 (WCH_CODES) with the buffer off: with +$19 bit 4 set, the character width one wider\n(up to 8, WCH_SET_WIDTH); otherwise nothing.","comment":"The font mode?"},
        "6261": {"comment":"No: nothing"},
        "6262": {"comment":"The width one wider"},
        "6266": {"comment":"9 or more?"},
        "6269": {"synopsis":"The new width set.","comment":"The width set"},
        "6272": {"synopsis":"Code 1: with +$19 bit 4 set, the character width one narrower (down to 3); otherwise\nWCH_BUF_ON.","comment":"The font mode?"},
        "6278": {"comment":"The width one narrower"},
        "6282": {"comment":"3 or more?"},
        "6287": {"synopsis":"Turns the line buffer on: a new line first unless at column 0 (+$24), room made for the\nbuffer in the channel at +$30 (WCH_BUF_SIZE, WCH_MAKE_ROOM), +$19 bit 5 set, +$25 bits 6-7\ncleared, then WB_EMPTY.","comment":"At column 0?"},
        "6291": {"comment":"No: a new line first"},
        "6294": {"comment":"HL, BC = the buffer and its size"},
        "6297": {"comment":"Room made for it in the channel"},
        "6300": {"comment":"The buffer on"},
        "6304": {"comment":"No parameter pending"},
        "6312": {"synopsis":"The buffer empty: +$29, +$2A, +$2B and +$2C = 0.","comment":"The buffer's counts to 0"},
        "6326": {"synopsis":"Code $0D with the buffer on: all of the buffer printed, line by line, none justified (+$19\nbit 1 cleared round each). An empty buffer gives the code $0A routine ($1AA2) and, without\ncarry from it, the code 7 one ($2071).","comment":"The bytes in the buffer"},
        "6329": {"comment":"Kept"},
        "6330": {"synopsis":"One line.","comment":"The alignment kept"},
        "6334": {"comment":"Not justified"},
        "6338": {"comment":"One line"},
        "6341": {"comment":"The alignment back"},
        "6345": {"comment":"Anything left?"},
        "6351": {"comment":"The bytes there were"},
        "6353": {"comment":"Some: done"},
        "6354": {"comment":"Empty: the code $0A routine"},
        "6357": {"comment":"Carry: done"},
        "6358": {"comment":"Else the code 7 routine"},
        "6361": {"synopsis":"After punctuation (IS_PUNCT) that still fits on the line: a break there (+$2C = the\nprintable count, +$2B = its offset).","comment":"Punctuation?"},
        "6365": {"comment":"D = the printable characters"},
        "6368": {"comment":"The characters a line"},
        "6371": {"comment":"Past the line: no break"},
        "6373": {"comment":"The break's printable count"},
        "6376": {"comment":"And its offset"},
        "6383": {"synopsis":"Z when A is one of , . ! ? ; :","comment":"A comma?"},
        "6386": {"comment":"A full stop?"},
        "6389": {"comment":"An exclamation mark?"},
        "6392": {"comment":"A question mark?"},
        "6395": {"comment":"A semicolon?"},
        "6398": {"comment":"A colon?"},
        "6401": {"synopsis":"Code $1F's parameter A: with +$19 bit 4 set the character set at CHARS is copied into the\nfont for width A (FONT_COPY). Otherwise +$19 bit 7 = A's bit 0: with it set the line buffer\nkeeps the control codes $10-$15, $18, $1A, $1B and $1D.","comment":"The font mode?"},
        "6407": {"comment":"Codes not kept"},
        "6411": {"comment":"Bit 0 of the parameter?"},
        "6413": {"comment":"Kept"},
        "6418": {"synopsis":"FONT_COPY for width 8 (from WCH_CODE_2).","comment":"Width 8"},
        "6420": {"synopsis":"Copies the 96 characters from CHARS + 256 (768 bytes) to the font for width A ($22D4) + 256:\nwith an LDIR when they are in RAM below $BD00; through ROM 3's LDIR at $33C3, with MMU 4-5\nmoved ($27BA), when they are in ROM; a byte at a time with the caller's MMU 6-7 ($27B3) from\n$BD00 up. The ROM route ends with MMU67_NORMAL.","comment":"HL = the font for width A"},
        "6423": {"comment":"DE = the font"},
        "6424": {"comment":"HL = CHARS"},
        "6427": {"comment":"Both from code 32 (+256)"},
        "6429": {"comment":"768 bytes, 96 characters"},
        "6432": {"comment":"At $BD00 or above?"},
        "6437": {"comment":"In ROM ($0000-$3FFF)?"},
        "6441": {"comment":"In RAM: copied at once"},
        "6444": {"synopsis":"In ROM: copied by ROM 3, with the font seen at $A000-$BFFF.","comment":"Kept"},
        "6447": {"comment":"MMU 4-5 = pages $0B, $10"},
        "6454": {"comment":"HL = CHARS + 256, the old MMU kept"},
        "6455": {"comment":"The font seen at $A000 (MMU 5)"},
        "6457": {"comment":"ROM 3's LDIR"},
        "6460": {"synopsis":"MMU 4-5 back from the stack.","comment":"MMU 4-5 back"},
        "6466": {"synopsis":"NextRegs $56 and $57 (MMU 6, 7) = pages $0B and $10, the old values in L and H ($27BA). From\n$19E4, $20C5, $215A, $2B37 and $3B2A.","comment":"MMU 6-7 = pages $0B, $10"},
        "6471": {"synopsis":"One byte, read with the caller's MMU 6-7 paged in.","comment":"Kept"},
        "6474": {"comment":"The caller's MMU 6-7"},
        "6477": {"comment":"A byte of the characters"},
        "6482": {"comment":"D = $56"},
        "6483": {"comment":"MMU 6-7 back"},
        "6490": {"comment":"Into the font"},
        "6492": {"comment":"All 768?"},
        "6498": {"synopsis":"Code 3 with +$19 bit 4 set: $239B with MMU 4-5 moved ($27BA), then FONT_MMU_BACK.","comment":"MMU 4-5 = pages $0B, $10"},
        "6503": {"comment":"The old values kept"},
        "6504": {"comment":"$239B"},
        "6509": {"synopsis":"Code 2: with +$19 bit 4 set, FONT_COPY_8. Otherwise the window's contents saved: room made\nat the channel's end for them (once, +$25 bit 3), then WCH_WIN_COPY with $5C92 = $80.","comment":"The font mode?"},
        "6515": {"comment":"Contents saved already?"},
        "6521": {"comment":"BC = the room needed"},
        "6524": {"comment":"HL = the channel's end"},
        "6534": {"comment":"The room made"},
        "6537": {"comment":"Contents saved"},
        "6541": {"synopsis":"The room made: $5C92 = $80 and the window copied.","comment":"$5C92 = $80"},
        "6545": {"synopsis":"The room's start, IX + the channel's length (+$0B) - its size ($1A0B), into $5B9B and $F358;\nthen $20C9 with HL = $218A and DE = that start.","comment":"DE = the routine for $20C9"},
        "6548": {"comment":"HL = the channel's end"},
        "6559": {"comment":"BC = the room's size"},
        "6563": {"comment":"HL = the room's start"},
        "6566": {"comment":"Kept at $5B9B"},
        "6569": {"comment":"And at $F358"},
        "6572": {"comment":"DE = the room, HL = $218A"},
        "6573": {"comment":"Every line of the window"},
        "6576": {"synopsis":"Code 3: with +$19 bit 4 set, WCH_CODE_3_FONT. Otherwise, when the contents were saved (+$25\nbit 3), they are copied back ($5C92 = 0, WCH_WIN_COPY) and the room given back\n(WCH_RECLAIM).","comment":"The font mode?"},
        "6582": {"comment":"Contents saved?"},
        "6586": {"comment":"No: nothing"},
        "6587": {"comment":"$5C92 = 0"},
        "6591": {"comment":"Copied back"},
        "6594": {"comment":"BC = the room's size"},
        "6597": {"comment":"HL = its start"},
        "6600": {"comment":"No contents saved now"},
        "6604": {"synopsis":"Takes BC bytes at HL out of the channel: its length (+$0B-$0C) less BC, then $053F on the\nalternate stack with bank 0 (RST $30), and MMU67_NORMAL.","comment":"Kept"},
        "6605": {"comment":"The channel's length"},
        "6611": {"comment":"Less BC"},
        "6620": {"comment":"HL = where the room is"},
        "6621": {"comment":"Alternate stack, bank 0"},
        "6622": {"comment":"The room taken out of CHANS"},
        "6625": {"comment":"The stacks swapped back"},
        "6628": {"synopsis":"MMU 6-7 back to normal.","comment":"MMU 6-7 back to normal"},
        "6631": {"synopsis":"Makes BC bytes of room at HL in the channel: its length (+$0B-$0C) plus BC, then $0577 on\nthe alternate stack with bank 0 (RST $30), and MMU67_NORMAL.","comment":"Kept"},
        "6632": {"comment":"The channel's length"},
        "6638": {"comment":"Plus BC"},
        "6645": {"comment":"HL = where the room goes"},
        "6646": {"comment":"Alternate stack, bank 0"},
        "6647": {"comment":"Room made in CHANS"},
        "6650": {"comment":"The stacks swapped back"},
        "6655": {"synopsis":"Code 0 with the buffer on: the buffer printed (WB_FLUSH), its room given back (WCH_BUF_SIZE,\nWCH_RECLAIM) and +$19 bit 5 cleared.","comment":"The buffer printed"},
        "6658": {"comment":"HL, BC = the buffer and its size"},
        "6661": {"comment":"The buffer off"},
        "6665": {"comment":"Its room given back"},
        "6667": {"synopsis":"BC = the bytes a copy of the window takes: its cells (+$11 x +$12) times 9 on the standard\nULA screen (8 pixel bytes and an attribute), times 16 in hi-res and hi-colour (two screen\nfiles), times 64 with one byte a pixel (LoRes, Layer 2). The mode is the screen's, from\n$5C7F (WCH_MODE). Called from $1979, $199F and $19C2.\nChanges: AF, HL.","comment":"HL = 0, for the product"},
        "6670": {"comment":"BC = the width in cells"},
        "6674": {"comment":"A = the height in cells"},
        "6677": {"synopsis":"HL = width x height.","comment":"One more row of cells"},
        "6681": {"comment":"BC = the cells"},
        "6683": {"comment":"HL = the cells x 8"},
        "6686": {"comment":"One byte a pixel (LoRes, Layer 2)?"},
        "6691": {"comment":"Standard ULA screen?"},
        "6693": {"comment":"Hi-res, hi-colour: BC = the cells x 8"},
        "6695": {"synopsis":"HL + BC: the cells x 9 (standard) or x 16 (hi-res, hi-colour).","comment":"HL = the cells x 9, or x 16"},
        "6696": {"synopsis":"BC = HL.","comment":"BC = the bytes"},
        "6699": {"synopsis":"One byte a pixel: the cells x 64.","comment":"The cells x 64"},
        "6704": {"synopsis":"Code 4: the cursor to the window's top left: the pixel row +$22 = the window's top (+$17),\nthe cell column +$21 = its left (+$13), the pixel offset +$23 and the line's count +$24 = 0.\nAlso from WCH_FILL and WCH_CLS.\nChanges: A.","comment":"A = the window's top pixel row"},
        "6707": {"synopsis":"The cursor to the start of pixel row A: +$22 = A, the column the window's left, the counts\n0."},
        "6710": {"comment":"The cell column: the window's left"},
        "6716": {"comment":"No pixel offset into the cell"},
        "6720": {"comment":"No characters on the line yet"},
        "6725": {"synopsis":"Code 5: the cursor to the start of the line just below the window (pixel row +$18); the next\ncharacter drawn scrolls the window first (WCH_PLOT_CELL).","comment":"A = the pixel row below the window"},
        "6730": {"synopsis":"Code 8: one character back, unless at the line's start: the count +$24 down by one and the\npixel offset +$23 back by the character width (+$0F), into the cell before (+$21 down by\none) when it goes below 0.","comment":"Characters on the line"},
        "6733": {"comment":"At the line's start?"},
        "6735": {"synopsis":"One character back without the test at the line's start (from WCH_DRAW_CELL at $1E8B, for a\ntall character's second half).","comment":"One fewer"},
        "6738": {"comment":"The pixel offset less the character width"},
        "6747": {"comment":"Still in the cell?"},
        "6748": {"comment":"Into the cell before: plus the cell width"},
        "6754": {"comment":"The cell column one back"},
        "6758": {"synopsis":"Code 9: one character on, unless that is past the line's last (+$1C characters a line): +$24\nup by one, the pixel offset +$23 on by the character width, into the next cell (+$21 up by\none) when it reaches the cell width (+$1D).","comment":"The count of the next place"},
        "6762": {"comment":"Past the characters a line?"},
        "6766": {"comment":"Stored"},
        "6769": {"comment":"The pixel offset plus the character width"},
        "6778": {"comment":"Still in the cell?"},
        "6782": {"comment":"Into the next cell"},
        "6788": {"comment":"The cell column one on"},
        "6792": {"synopsis":"A = the cursor's pixel row (+$22) plus 8, or plus 6 with 6-pixel lines (+$25 bit 0).\nChanges: F.","comment":"A = the pixel row"},
        "6795": {"comment":"Plus a line of 8"},
        "6797": {"comment":"6-pixel lines?"},
        "6802": {"comment":"Then 6"},
        "6805": {"synopsis":"A = the cursor's pixel row (+$22) less 8, or less 6 with 6-pixel lines (+$25 bit 0).\nExit: carry when the row is below 8, whatever the line height.\nChanges: F.","comment":"A = the pixel row"},
        "6808": {"comment":"Less a line of 8; carry below 8"},
        "6810": {"comment":"6-pixel lines?"},
        "6815": {"comment":"Then less 6, the carry kept"},
        "6818": {"synopsis":"Code $0A: the cursor a line down (8 or 6 pixel rows), unless the new line would start below\nthe top of the window's bottom character row (+$16; up to 2 rows lower with 6-pixel lines).\nAlso from $18D2, which scrolls when it did not move.\nExit: carry when it moved.","comment":"A = the bottom character row"},
        "6821": {"comment":"Times 8: its top pixel row"},
        "6824": {"comment":"B = that + 1, the limit for a line's top"},
        "6826": {"comment":"A = the pixel row a line down"},
        "6831": {"comment":"6-pixel lines?"},
        "6837": {"comment":"Then 6 down, and the limit 2 higher"},
        "6841": {"synopsis":"Does the line fit?","comment":"Above the limit?"},
        "6843": {"comment":"The cursor moved down"},
        "6847": {"synopsis":"Code $0B: the cursor a line up, unless that goes above the window's top (+$17) or the row is\nbelow 8.","comment":"A = a line up; carry below 8"},
        "6851": {"comment":"Above the window's top?"},
        "6855": {"comment":"The cursor moved up"},
        "6859": {"synopsis":"Code $19's first parameter: the pixel row from the window's top, kept in +$2D; the next\nparameter goes to code $22 (WCH_AT_PIXEL_LO). The three parameters put the cursor at a pixel\nrow and a 16-bit pixel column.","comment":"The next parameter's code: $22"},
        "6863": {"synopsis":"Code $19's second parameter (code $22): the pixel column's low byte, kept in +$2B; the next\ngoes to code $23 (WCH_AT_PIXEL_HI).","comment":"The next parameter's code: $23"},
        "6865": {"comment":"The column's low byte"},
        "6870": {"synopsis":"Code $17 (TAB): its first parameter, the column's low byte, kept in +$2D; the next, the high\nbyte, goes to code $21 (WCH_TAB_COLUMN).","comment":"The next parameter's code: $21"},
        "6874": {"synopsis":"Code $16 (AT): its first parameter, the line, made a pixel row from the window's top (x 8,\nor x 6 with 6-pixel lines; $FF, out of range, for 32 up) and kept in +$2D; the column goes\nto code $20 (WCH_AT_COLUMN).","comment":"The next parameter's code: $20"},
        "6876": {"comment":"D = $FF: out of range"},
        "6878": {"comment":"Line 32 or more?"},
        "6881": {"comment":"C = the line x 2"},
        "6883": {"comment":"A = x 4"},
        "6884": {"comment":"6-pixel lines?"},
        "6890": {"comment":"No: C = x 4, for x 8"},
        "6891": {"synopsis":"A = the line x 6 or x 8.","comment":"A = x 6 or x 8"},
        "6893": {"synopsis":"A = D: the pixel row, or $FF.","comment":"A = the pixel row (or $FF)"},
        "6894": {"synopsis":"+$2D = A, then WCH_PARAM_NEXT.","comment":"Kept for the next parameter"},
        "6897": {"synopsis":"+$26 = E: the code ($20-$23) whose routine takes the next byte output (WCH_OUT_CHAR, through\nthe table at $1604).","comment":"The code the next byte goes to"},
        "6901": {"synopsis":"Code $19's third parameter (code $23), the pixel column's high byte: HL = the pixel column\n(with +$2B), then WCH_AT_XY.","comment":"H = the column's high byte"},
        "6902": {"comment":"L = its low byte (the second parameter)"},
        "6905": {"synopsis":"Puts the cursor at pixel column HL from the window's left on pixel row +$2D from its top.\nAlso from $2BBC.\n1. +$24 = the characters before the column: (HL + the character width - 1) / the width\n   (+$0F); error code 4 (report 5) from 256 up.\n2. The cell column +$21 and the pixel offset +$23 from HL: cells of 8 pixels, or of 16 in\n   hi-res (+$1D bit 4), where the column's bit 3 picks the cell's second byte.\n3. WCH_AT_SET checks and stores them.\nEntry: HL = the pixel column; +$2D = the pixel row.","comment":"The column kept"},
        "6906": {"comment":"DE = the character width"},
        "6911": {"comment":"HL = column + width - 1"},
        "6913": {"comment":"AC = the dividend"},
        "6915": {"comment":"HL = 0, the remainder"},
        "6917": {"comment":"16 bits"},
        "6919": {"synopsis":"One bit of AC / DE, the remainder in HL.","comment":"The next bit into the remainder"},
        "6924": {"comment":"Does DE go?"},
        "6926": {"comment":"Yes: the bit stays 0 (inverted)"},
        "6928": {"comment":"No: added back"},
        "6929": {"synopsis":"The next bit.","comment":"The next bit"},
        "6931": {"comment":"The last bit in; the bits are inverted"},
        "6934": {"comment":"A = the quotient's high byte"},
        "6936": {"comment":"256 characters or more: report 5"},
        "6938": {"comment":"A = its low byte"},
        "6940": {"comment":"DE = the pixel column"},
        "6941": {"comment":"The character count kept"},
        "6942": {"comment":"Cells of 16 pixels (hi-res)?"},
        "6946": {"comment":"H = 0: the cell's first byte"},
        "6950": {"comment":"In the cell's second byte?"},
        "6954": {"comment":"Then the offset starts at 8"},
        "6956": {"synopsis":"Hi-res: E = the column's 16-pixel cell in bits 3-7, its pixel within the byte in bits 0-2.","comment":"Bits 0-2: the pixel within the byte"},
        "6960": {"comment":"The column halved: its cell in bits 3-7"},
        "6964": {"comment":"Joined with the pixel within the byte"},
        "6968": {"synopsis":"E: the cell in bits 3-7, the pixel in bits 0-2; H = the offset's start (8 for a cell's\nsecond byte).","comment":"H = the pixel offset into the cell"},
        "6973": {"comment":"L = the cell column: E / 8"},
        "6979": {"comment":"Plus the window's left column"},
        "6983": {"comment":"D = the character count"},
        "6984": {"comment":"Checked and stored"},
        "6986": {"synopsis":"Code $16's second parameter (code $20), the column: the cell column and pixel offset of that\nmany characters from the window's left; then the cursor put there (WCH_AT_SET) on pixel row\n+$2D from the window's top. Also from WCH_DELETE.\nEntry: A = the column; +$2D = the pixel row.\nChanges: AF, BC, DE, HL.","comment":"D = the column"},
        "6987": {"comment":"B = the column + 1"},
        "6989": {"comment":"L = the window's left column"},
        "6992": {"comment":"A = the pixel offset"},
        "6993": {"comment":"E = the cell width"},
        "6996": {"synopsis":"One character width per column.","comment":"All the columns counted?"},
        "6999": {"comment":"Another character's width"},
        "7002": {"comment":"Still in the cell?"},
        "7005": {"comment":"Into the next cell"},
        "7009": {"synopsis":"H = the pixel offset into the cell.","comment":"H = the pixel offset"},
        "7010": {"synopsis":"The cursor stored: the count D (below the characters a line, +$1C), the cell column L, the\npixel offset H, and the pixel row +$2D + the window's top (+$17), which must lie above the\nwindow's bottom (+$18). Otherwise error code 4 (report 5).","comment":"Column below the characters a line?"},
        "7016": {"comment":"The count on the line"},
        "7019": {"comment":"The cell column"},
        "7022": {"comment":"The pixel offset"},
        "7025": {"comment":"A = the row in pixels from the top"},
        "7028": {"comment":"Plus the window's top pixel row"},
        "7031": {"comment":"Past 255: report 5"},
        "7033": {"comment":"Above the window's bottom?"},
        "7038": {"synopsis":"Stops with error code 4 (report 5) through $27AF: a position outside the window. Also from\n$2BB6.","comment":"Error code 4"},
        "7040": {"comment":"Stops with it"},
        "7043": {"synopsis":"The cursor's pixel row stored.","comment":"The cursor's pixel row"},
        "7047": {"synopsis":"Code $0C: rubs out the character before the cursor: one place back (to the last place of the\nline above at a line's start; nothing on the window's first line), a space printed there\n(WCH_SPACE) and the cursor put back on it (WCH_AT_COLUMN twice).","comment":"A = the cursor's pixel row"},
        "7050": {"comment":"B = the window's top"},
        "7053": {"comment":"The row from the top"},
        "7054": {"comment":"Kept for WCH_AT_SET"},
        "7057": {"comment":"A = the count on the line"},
        "7060": {"comment":"At the line's start?"},
        "7063": {"comment":"A = the row a line up"},
        "7066": {"comment":"From the top; above the window?"},
        "7068": {"comment":"The line above"},
        "7071": {"comment":"Its last place + 1: the characters a line"},
        "7074": {"synopsis":"The place before (A - 1): the cursor there, a space, the cursor there again.","comment":"A = the place before"},
        "7076": {"comment":"The cursor there"},
        "7079": {"comment":"A space over the character"},
        "7082": {"comment":"And the cursor back there"},
        "7085": {"synopsis":"Prints a space (WCH_DRAW_CHAR) at single width: +$25 bit 4 cleared meanwhile, then put back.\nKeeps AF.","comment":"A kept"},
        "7086": {"comment":"The style flags kept"},
        "7090": {"comment":"Single width"},
        "7094": {"comment":"A space"},
        "7099": {"comment":"Style flags back"},
        "7103": {"comment":"A back"},
        "7105": {"synopsis":"Code $17's second parameter (code $21): with the first, HL = the column; then WCH_TAB_MOD.","comment":"L = the column's low byte"},
        "7108": {"comment":"H = its high byte"},
        "7109": {"synopsis":"Spaces from the cursor up to column HL modulo the characters a line (+$1C); on the next line\nwhen that column is behind the cursor (or at it). Also from WCH_COMMA.","comment":"BC = the characters a line"},
        "7114": {"comment":"Carry clear"},
        "7115": {"synopsis":"Less a line's characters, as long as it goes.","comment":"Less a line"},
        "7119": {"comment":"The last one too many added back"},
        "7120": {"comment":"A = the column within the line"},
        "7121": {"comment":"B = the count on the line"},
        "7124": {"comment":"The spaces up to it"},
        "7125": {"comment":"Ahead of the cursor?"},
        "7127": {"comment":"No: to it on the next line"},
        "7128": {"synopsis":"A spaces (WCH_SPACE).","comment":"None left?"},
        "7130": {"comment":"One space"},
        "7133": {"comment":"One fewer"},
        "7136": {"synopsis":"Code 6 (comma): to the middle of the line (WCH_TAB_MOD) when the cursor is not past it,\notherwise to the start of the next line.","comment":"A = the characters a line"},
        "7139": {"comment":"Halved: the middle"},
        "7141": {"comment":"Cursor not past it?"},
        "7144": {"comment":"L = the middle"},
        "7145": {"comment":"H = 0"},
        "7147": {"comment":"Yes: to the middle"},
        "7149": {"comment":"No: column 0, on the next line"},
        "7152": {"synopsis":"Code $10 (INK): the window's ink from the parameter, by the screen's mode (WCH_MODE_PARAM):\n1. One byte a pixel: the colour itself into +$1F (WCH_INK_BYTE).\n2. Hi-res: WCH_INK_HIRES.\n3. Otherwise attribute bits 0-2 (ink 0-7), or with an ink mask at $5B64 (not 0) any value\n   within the mask's bits.\nThe colour goes into $5C6C the same way and, with $5C7F bit 5 set, into the mode's own byte\n($5B5F-$5B63). Error code $13 (report K) for an ink out of range.","comment":"E = the ink; the screen's mode"},
        "7155": {"comment":"One byte a pixel?"},
        "7157": {"comment":"Hi-res?"},
        "7160": {"comment":"An ink mask?"},
        "7164": {"comment":"Yes: within its bits"},
        "7166": {"comment":"Ink 0-7?"},
        "7169": {"comment":"No: report K"},
        "7171": {"comment":"Attribute bits 0-2 replaced"},
        "7175": {"synopsis":"With an ink mask: the ink must lie within its bits.","comment":"D = the bits outside the mask"},
        "7177": {"comment":"Ink outside the mask?"},
        "7178": {"comment":"Yes: report K"},
        "7180": {"synopsis":"The window's attribute +$1F: the bits of D kept, E put in; then the same in $5C6C and the\nstandard ($5B61) or hi-colour ($5B63) mode's copy (WCH_SET_SYSCOL).","comment":"The window's attribute"},
        "7188": {"comment":"A = $61, the standard mode's copy"},
        "7190": {"comment":"Hi-colour?"},
        "7196": {"comment":"Then $63"},
        "7200": {"synopsis":"One byte a pixel: the ink colour replaces +$1F, $5C6C and $5B5F (LoRes) or $5B60 (Layer 2).","comment":"The window's ink colour"},
        "7203": {"comment":"All of it replaced"},
        "7205": {"comment":"A = $5F (LoRes) or $60 (Layer 2)"},
        "7207": {"synopsis":"$5C6C changed as the attribute was (bits of D kept, E put in); with $5C7F bit 5 set the byte\nat $5B00 + A too.","comment":"The colour in $5C6C"},
        "7210": {"synopsis":"The same for the byte at HL, and with $5C7F bit 5 set for $5B00 + A.","comment":"B = the low byte of the mode's copy"},
        "7211": {"comment":"The bits of D kept, E put in"},
        "7215": {"comment":"To the mode's copy too?"},
        "7220": {"comment":"HL = $5B00 + B"},
        "7223": {"comment":"Changed in the same way"},
        "7228": {"synopsis":"Hi-res paper: the ink set to its complement (7 - paper), since port $FF sets the pair\ntogether.","comment":"Ink = 7 - paper"},
        "7232": {"synopsis":"Hi-res ink 0-7: sent to port $FF in bits 3-5 with mode 6 (hi-res), and into $5C6C and $5B62;\nreport K above 7.","comment":"Ink 0-7?"},
        "7235": {"comment":"No: report K"},
        "7237": {"comment":"In bits 3-5"},
        "7241": {"comment":"D = 0: the whole byte replaced"},
        "7243": {"comment":"With hi-res mode (6)"},
        "7245": {"comment":"Port $FF: the Timex display mode"},
        "7247": {"comment":"The copy at $5B62"},
        "7251": {"synopsis":"Code $11 (PAPER): the window's paper from the parameter, by the screen's mode\n(WCH_MODE_PARAM):\n1. One byte a pixel: the colour itself into +$20 (WCH_PAPER_BYTE).\n2. Hi-res: WCH_PAPER_HIRES.\n3. Otherwise attribute bits 3-5 (paper 0-7), or with an ink mask at $5B64 the bits above the\n   mask (WCH_PAPER_MASK).\nError code $13 (report K) for a paper out of range.","comment":"E = the paper; the screen's mode"},
        "7254": {"comment":"One byte a pixel?"},
        "7256": {"comment":"Hi-res?"},
        "7259": {"comment":"An ink mask?"},
        "7265": {"comment":"Paper 0-7?"},
        "7268": {"comment":"No: report K"},
        "7270": {"comment":"In bits 3-5"},
        "7274": {"comment":"Attribute bits 3-5 replaced"},
        "7278": {"synopsis":"With an ink mask: A = the bits outside the mask; none, and only paper 0 is allowed (nothing\nchanged).","comment":"A = the bits outside the mask"},
        "7279": {"comment":"Any?"},
        "7282": {"comment":"None: is the paper 0?"},
        "7284": {"comment":"Yes: nothing to do"},
        "7285": {"synopsis":"Stops with error code $13 (report K) through $27AF: a colour or a 0/1 parameter out of\nrange.","comment":"Error code $13"},
        "7287": {"comment":"Stops with it"},
        "7290": {"synopsis":"The paper moved up to the lowest bit outside the mask; report K when it overflows.","comment":"That bit reached?"},
        "7293": {"comment":"No: the paper one bit up"},
        "7295": {"comment":"Still in the byte?"},
        "7297": {"comment":"No: report K"},
        "7299": {"synopsis":"D = the mask: the ink bits kept, the paper put in above them.","comment":"D = the mask: the ink kept"},
        "7305": {"synopsis":"One byte a pixel: the paper colour into +$20, $5C6D and, with $5C7F bit 5 set, $5B88 (LoRes)\nor $5B89 (Layer 2).","comment":"D = 0: replaced"},
        "7307": {"comment":"The window's paper colour"},
        "7310": {"comment":"The system's copy"},
        "7313": {"comment":"LoRes?"},
        "7314": {"comment":"Its copy at $5B88"},
        "7318": {"comment":"Layer 2: at $5B89"},
        "7321": {"synopsis":"Code $12 (FLASH): attribute bit 7 from the parameter (0 or 1, otherwise report K); ignored\nwith one byte a pixel, in hi-res and with an ink mask at $5B64.","comment":"E = the parameter; the mode"},
        "7324": {"comment":"One byte a pixel: ignored"},
        "7325": {"comment":"Hi-res: ignored"},
        "7327": {"comment":"An ink mask: ignored"},
        "7332": {"comment":"0 or 1?"},
        "7335": {"comment":"No: report K"},
        "7337": {"comment":"Into bit 7"},
        "7339": {"comment":"Bit 7 replaced"},
        "7341": {"synopsis":"On to WCH_SET_COLOUR."},
        "7344": {"synopsis":"Code $13 (BRIGHT): attribute bit 6 from the parameter (0 or 1, otherwise report K); ignored\nwith one byte a pixel, in hi-res and with an ink mask at $5B64.","comment":"E = the parameter; the mode"},
        "7347": {"comment":"One byte a pixel: ignored"},
        "7348": {"comment":"Hi-res: ignored"},
        "7350": {"comment":"An ink mask: ignored"},
        "7355": {"comment":"0 or 1?"},
        "7358": {"comment":"No: report K"},
        "7360": {"comment":"Into bit 6"},
        "7363": {"comment":"Bit 6 replaced"},
        "7367": {"synopsis":"Code $18: the parameter becomes the window's whole attribute (WCH_SET_COLOUR with D = 0);\nignored with one byte a pixel and in hi-res.","comment":"E = the attribute; the mode"},
        "7370": {"comment":"One byte a pixel: ignored"},
        "7371": {"comment":"Hi-res: ignored"},
        "7373": {"comment":"D = 0: all of it replaced"},
        "7377": {"synopsis":"A = $00 for a parameter of 0, $FF for 1; error code $13 (report K) otherwise.\nChanges: F.","comment":"0 or 1?"},
        "7379": {"comment":"No: report K"},
        "7381": {"comment":"Carry = the bit"},
        "7384": {"comment":"A = $00 or $FF"},
        "7386": {"synopsis":"Code $14 (INVERSE): +$27 = $00 or $FF (the glyph is inverted when drawn); P_FLAG ($5C91) bit\n2 set the same way, and bit 3 too with $5C7F bit 5 set.","comment":"A = $00 or $FF"},
        "7389": {"comment":"The window's INVERSE"},
        "7392": {"comment":"P_FLAG bits 2 and 3 of it"},
        "7394": {"comment":"D = those bits replaced"},
        "7396": {"synopsis":"P_FLAG changed: both bits of A when $5C7F bit 5 is set, otherwise only the lower one.","comment":"Both bits?"},
        "7402": {"comment":"No: only the lower one"},
        "7404": {"comment":"And the upper one kept"},
        "7408": {"synopsis":"P_FLAG: the bits of D kept, E put in.","comment":"E = the new bits"},
        "7409": {"comment":"Into P_FLAG"},
        "7418": {"synopsis":"Code $15 (OVER): +$28 = $00 or $FF (the glyph is combined with the screen when drawn);\nP_FLAG bit 0 set the same way, and bit 1 too with $5C7F bit 5 set.","comment":"A = $00 or $FF"},
        "7421": {"comment":"The window's OVER"},
        "7424": {"comment":"P_FLAG bits 0 and 1 of it"},
        "7426": {"comment":"D = those bits replaced"},
        "7430": {"synopsis":"Code $1B: the cursor home, then the parameter's character printed over the whole window, a\nline's worth (+$1C) for each character row (+$12).","comment":"E = the character"},
        "7431": {"comment":"The cursor home"},
        "7434": {"comment":"C = the rows"},
        "7439": {"synopsis":"One row.","comment":"B = the characters a line"},
        "7442": {"synopsis":"One character."},
        "7444": {"comment":"Printed"},
        "7449": {"comment":"The line's next"},
        "7451": {"comment":"The next row"},
        "7455": {"synopsis":"Code $1C: double width (+$25 bit 4) from the parameter's bit 0.","comment":"Single width"},
        "7459": {"comment":"Bit 0 set?"},
        "7461": {"comment":"Double width"},
        "7466": {"synopsis":"Code $1D: double height (+$25 bit 5) from the parameter's bit 0, 6-pixel lines (+$25 bit 0)\nfrom its bit 1.","comment":"Single height"},
        "7470": {"comment":"Bit 0 set?"},
        "7473": {"comment":"Double height"},
        "7477": {"synopsis":"Bit 1 of the parameter: 6-pixel lines.","comment":"8-pixel lines"},
        "7481": {"comment":"Bit 1 set?"},
        "7483": {"comment":"6-pixel lines"},
        "7488": {"synopsis":"A byte E to the window channel at IX: to the line buffer at $1735 when it is on (+$19 bit\n5), otherwise WCH_OUT_CHAR. Called from $2751 and $2762.","comment":"The line buffer on?"},
        "7492": {"comment":"Yes: the byte goes there"},
        "7495": {"synopsis":"A byte E to the window at IX, unbuffered (also from $16C5 and $276B):\n1. A code awaiting its parameter (+$26 not 0): +$26 cleared and that code's routine run with\n   A = E (WCH_PARAM).\n2. 32 up: a character, drawn (WCH_DRAW_CHAR).\n3. $10-$1F: kept in +$26 to await its parameter.\n4. 0-$0F: its routine run at once from the table at $1604.","comment":"A code awaiting its parameter?"},
        "7501": {"comment":"A = the byte"},
        "7502": {"comment":"A character?"},
        "7506": {"comment":"A code 0-$0F?"},
        "7510": {"comment":"$10-$1F: it awaits a parameter"},
        "7514": {"synopsis":"The parameter: no longer awaited; A = the code that awaited it.","comment":"No longer awaited"},
        "7518": {"synopsis":"Runs code A's routine from the table at $1604 ($24 words: codes 0-$1F and the further\nparameters $20-$23).","comment":"The codes' table"},
        "7521": {"synopsis":"Runs entry A of the table of words at HL, with A = E. Also from $171B with the table at\n$164C.","comment":"HL = the entry (A x 2)"},
        "7525": {"comment":"HL = the routine"},
        "7529": {"comment":"A = the byte"},
        "7530": {"comment":"Run it"},
        "7531": {"synopsis":"Draws character A at the cursor of the window at IX and moves the cursor on:\n1. Codes $20-$7F from the character set at +$0D-$0E (WCH_CHAR_FONT), $80-$8F block graphics\n   built at $F350 (WCH_BLOCK_HALF), $90 up user-defined graphics or tokens (WCH_CHAR_UDG).\n2. WCH_GLYPH_READY draws it: a new line first when it does not fit; double width (+$25 bit\n   4) and double height (bit 5) as two or four cells.\nAlso from WCH_SPACE, WCH_FILL and as the token printer's output.","comment":"HL = the code x 8"},
        "7537": {"comment":"Codes $20-$7F?"},
        "7541": {"comment":"Block graphics, $80-$8F?"},
        "7545": {"comment":"E = the code"},
        "7546": {"comment":"Built at $F350"},
        "7550": {"comment":"A = the character width"},
        "7553": {"comment":"C = half of it"},
        "7556": {"comment":"B = the rest"},
        "7558": {"comment":"Both as counts less one"},
        "7560": {"comment":"Rows 0-3: bits 0 and 1"},
        "7565": {"comment":"Rows 4-7: bits 2 and 3"},
        "7568": {"comment":"HL = the glyph"},
        "7571": {"synopsis":"Codes $90 up: a token when $2B3E says so (carry), printed by $2B5B one character at a time\nthrough WCH_DRAW_CHAR (BC); otherwise a user-defined graphic: HL = UDG + (code - $90) x 8,\nread through WCH_FAR_GLYPH.","comment":"Token or graphic?"},
        "7574": {"comment":"Each token character printed here"},
        "7577": {"comment":"A token: printed"},
        "7580": {"comment":"Not a space"},
        "7584": {"comment":"Plus UDG"},
        "7589": {"comment":"Less $90 x 8"},
        "7595": {"comment":"The glyph, wherever it lies"},
        "7597": {"synopsis":"Codes $20-$7F: +$25 bit 1 set for a space, cleared otherwise; HL = the character set\n(+$0D-$0E, code 0's place) + the code x 8; read through WCH_FAR_GLYPH when the set is in the\ncaller's memory (+$19 bit 2).","comment":"Not a space"},
        "7601": {"comment":"A space?"},
        "7605": {"comment":"Marked as one"},
        "7609": {"synopsis":"HL = the glyph in the window's character set.","comment":"BC = the set (code 0's place)"},
        "7615": {"comment":"HL = the glyph"},
        "7616": {"comment":"In the caller's memory?"},
        "7622": {"synopsis":"A glyph at HL in the caller's memory. From $BF00 up it lies in the caller's top 16K, which\nthe window code has replaced: the caller's MMU 6-7 pages (saved at $5B8A) go into MMU 4-5\nwhile its 8 bytes are copied to $F350, and HL = $F350. Below that it is read where it is.","comment":"In the top 16K?"},
        "7625": {"comment":"No: read as it is"},
        "7627": {"comment":"HL = its place in $8000-$BFFF"},
        "7630": {"comment":"Kept"},
        "7631": {"comment":"MMU 4-5: the caller's top pages"},
        "7636": {"comment":"HL = the glyph; the old pages kept"},
        "7637": {"comment":"Copied to $F350"},
        "7645": {"comment":"The old pages"},
        "7646": {"comment":"Back in MMU 4-5"},
        "7651": {"comment":"HL = the copy"},
        "7654": {"synopsis":"HL = the glyph. A new line first (WCH_NEWLINE) when the character does not fit on this one\n(two places at double width); then drawn as one cell (WCH_PLOT_CELL), or widened (+$25 bit\n4, into $F330-$F33F) and/or made tall (bit 5, WCH_DRAW_CELL).","comment":"A = the count on the line"},
        "7657": {"comment":"Double width?"},
        "7663": {"comment":"Then it takes two places"},
        "7664": {"synopsis":"Room on the line?","comment":"Room on the line?"},
        "7667": {"comment":"No: a new line first"},
        "7670": {"comment":"Double width or height?"},
        "7675": {"comment":"Neither: one cell"},
        "7678": {"comment":"Double width?"},
        "7680": {"comment":"No: double height only"},
        "7682": {"comment":"DE = the glyph"},
        "7683": {"comment":"HL = the wide glyph's halves"},
        "7686": {"comment":"8 rows"},
        "7688": {"synopsis":"Double width: one row of the glyph with each pixel doubled, the left half's pixels into the\nbyte at HL ($F330 on, the first cell) and the right half's 8 bytes on ($F338 on, the second\ncell). Each byte starts as a marker bit, shifted up until it comes out so that the pixels\nsit at its left. An odd width at WCH_WIDE_ODD.","comment":"Rows kept"},
        "7689": {"comment":"B = the width"},
        "7692": {"comment":"Halved: an odd width?"},
        "7696": {"comment":"Half kept"},
        "7697": {"comment":"The marker bit"},
        "7699": {"comment":"A = the glyph's row"},
        "7700": {"synopsis":"One pixel of the left half, shifted twice into the first cell's row.","comment":"The next pixel into carry"},
        "7701": {"comment":"Kept"},
        "7702": {"comment":"Into the row twice"},
        "7707": {"comment":"The next pixel"},
        "7709": {"comment":"Marker out already?"},
        "7711": {"synopsis":"Shifts the row up until the marker comes out.","comment":"Shifted up until the marker comes out"},
        "7715": {"synopsis":"HL = the second cell's row, 8 bytes on, started with its marker.","comment":"HL = the second cell's row"},
        "7719": {"comment":"Its marker"},
        "7723": {"synopsis":"An odd width: the left half, then the middle pixel into both cells.","comment":"Half kept"},
        "7724": {"comment":"The marker bit"},
        "7726": {"comment":"A = the glyph's row"},
        "7727": {"synopsis":"One pixel of the left half, shifted twice into the first cell's row.","comment":"The next pixel into carry"},
        "7729": {"comment":"Into the row twice"},
        "7734": {"comment":"The next pixel"},
        "7736": {"comment":"The middle pixel into carry"},
        "7737": {"comment":"Kept"},
        "7738": {"synopsis":"Shifts the row up until the marker comes out; the middle pixel goes in first.","comment":"Shifted up until the marker comes out"},
        "7742": {"comment":"HL = the second cell's row"},
        "7746": {"comment":"Its marker"},
        "7748": {"comment":"The middle pixel goes in first"},
        "7751": {"synopsis":"The right half: B = half the width again.","comment":"B = half the width"},
        "7752": {"synopsis":"One pixel of the right half, shifted twice into the second cell's row.","comment":"The next pixel into carry"},
        "7754": {"comment":"Into the row twice"},
        "7759": {"comment":"The next pixel"},
        "7761": {"comment":"Marker out already?"},
        "7763": {"synopsis":"Shifts the row up until the marker comes out.","comment":"Shifted up until it comes out"},
        "7767": {"synopsis":"The next row: back to the first cell, one row on, and the glyph's next row.","comment":"Back to the first cell, a row on"},
        "7773": {"comment":"The glyph's next row"},
        "7775": {"comment":"The next row"},
        "7777": {"comment":"The left half drawn"},
        "7783": {"comment":"Then the right half"},
        "7786": {"synopsis":"Draws the glyph at HL as one cell (WCH_PLOT_CELL), or with double height (+$25 bit 5) as\ntwo, one above the other: each row doubled into $F340-$F34F, the top half drawn, the cursor\nback (WCH_BACK_GO), the bottom half drawn a line down, and the cursor back up the line.","comment":"Double height?"},
        "7790": {"comment":"No: one cell"},
        "7792": {"comment":"DE = the glyph"},
        "7793": {"comment":"Rows doubled here"},
        "7796": {"comment":"8 rows"},
        "7798": {"synopsis":"One row of the glyph, stored twice.","comment":"The glyph's row"},
        "7800": {"comment":"Stored twice"},
        "7804": {"comment":"The next row"},
        "7806": {"comment":"HL = the top half"},
        "7809": {"comment":"6-pixel lines?"},
        "7815": {"comment":"Then from its second row"},
        "7816": {"synopsis":"The top half drawn, the cursor back on its place.","comment":"The top half drawn"},
        "7819": {"comment":"The cursor back on it"},
        "7822": {"comment":"HL = the bottom half"},
        "7825": {"comment":"A = a line down"},
        "7830": {"comment":"6-pixel lines?"},
        "7836": {"comment":"Then 6 down"},
        "7838": {"comment":"And the half a row earlier"},
        "7839": {"synopsis":"The bottom half drawn a line down, then the cursor back on the first line.","comment":"The cursor a line down"},
        "7842": {"comment":"The bottom half drawn"},
        "7845": {"comment":"A = back up a line"},
        "7848": {"comment":"The cursor on the first line"},
        "7852": {"synopsis":"Draws the glyph at HL (8 rows) as a character at the cursor, then moves the cursor on\n(WCH_ADVANCE):\n1. A line that would end below the window's bottom (+$18) is moved up 8 pixel rows and the\n   window scrolled (WCH_SCROLL).\n2. One byte a pixel: WCH_PLOT_BYTES.\n3. The colour: the attribute +$1F into the cell (the next one too when the character\n   straddles two, and the row below when it straddles two character rows); in hi-colour the\n   colour goes into the second file's bytes with each pixel row instead.\n4. The rows: inverted with INVERSE (+$27), cut to the character width (mask +$10), moved\n   right by the pixel offset (+$23) with the Z80N barrel shifts and put into one byte or\n   two, the screen's bits outside the character kept (all of them with OVER, +$28, which\n   XORs). In hi-res the two bytes of a 16-pixel cell lie in the two screen files.\nWith 6-pixel lines (+$25 bit 0) 6 rows, from the glyph's second.","comment":"The glyph kept"},
        "7853": {"comment":"B = the bottom + 1"},
        "7857": {"comment":"A = where the line ends"},
        "7860": {"comment":"Within the window?"},
        "7863": {"comment":"No: up 8 pixel rows"},
        "7871": {"comment":"And the window scrolled"},
        "7874": {"synopsis":"One byte a pixel?","comment":"One byte a pixel?"},
        "7877": {"comment":"Yes: drawn there"},
        "7880": {"comment":"A = the cell column"},
        "7883": {"comment":"D = the pixel row"},
        "7886": {"comment":"HL = the attribute, DE = the pixel byte"},
        "7889": {"comment":"Hi-res or hi-colour?"},
        "7893": {"comment":"B = the attribute"},
        "7896": {"comment":"Yes: a colour byte instead"},
        "7898": {"comment":"Z kept in F': the standard screen"},
        "7899": {"comment":"The cell's attribute"},
        "7900": {"comment":"A = where the character ends"},
        "7906": {"comment":"Into the next cell?"},
        "7910": {"comment":"Its attribute too"},
        "7913": {"synopsis":"A pixel row not on a character row's top: the attribute row below gets it too (with 6-pixel\nlines only from the row's third pixel row on).","comment":"A = the row within the cell"},
        "7916": {"comment":"On the cell's top row?"},
        "7918": {"comment":"Yes: one cell row"},
        "7920": {"comment":"6-pixel lines?"},
        "7926": {"comment":"Rows 1-2: still one cell row"},
        "7930": {"synopsis":"The attribute row below, and its next cell when the character straddles two.","comment":"The attribute row below"},
        "7934": {"comment":"Its attribute"},
        "7935": {"comment":"Into the next cell?"},
        "7945": {"comment":"Its attribute too"},
        "7949": {"synopsis":"Hi-res or hi-colour: A' = the colour (NZ kept in F'); in hi-res the second byte of a\n16-pixel cell (offset 8 up) is in the second file: DE + $8000 (page 11 in MMU 6).","comment":"A' = the colour; NZ kept in F'"},
        "7951": {"comment":"A 16-pixel cell's second byte?"},
        "7957": {"comment":"Then in the second file"},
        "7959": {"synopsis":"The pixel rows: HL = the screen byte, HL' = the glyph; B' = the rows, E' = INVERSE, C' = the\nwidth's mask, D = the screen bits to keep, B = the offset within the byte.","comment":"HL = the screen byte"},
        "7960": {"comment":"HL' = the glyph; the caller's kept"},
        "7962": {"comment":"BC' and DE' kept"},
        "7964": {"comment":"8 rows"},
        "7966": {"comment":"6-pixel lines?"},
        "7972": {"comment":"Then 6, from the glyph's second"},
        "7975": {"synopsis":"The masks and the offset.","comment":"E' = the INVERSE byte"},
        "7978": {"comment":"D' = IXL, kept"},
        "7980": {"comment":"C' = the width's mask"},
        "7985": {"comment":"The bits beside the character"},
        "7986": {"comment":"All of them with OVER"},
        "7989": {"comment":"D = the screen bits to keep"},
        "7990": {"comment":"B = the pixel offset"},
        "7993": {"comment":"Within its byte (16-pixel cells)"},
        "7995": {"comment":"Hi-colour?"},
        "8000": {"comment":"Always two bytes"},
        "8002": {"comment":"A = where the character ends"},
        "8006": {"comment":"Within one byte?"},
        "8008": {"comment":"Yes: one byte"},
        "8011": {"synopsis":"Two bytes a row: C and IXL = their keep masks.","comment":"E = $FF to shift in"},
        "8013": {"comment":"DE = the keep mask moved right B"},
        "8015": {"comment":"C = the first byte's"},
        "8016": {"comment":"IXL = the second's"},
        "8019": {"synopsis":"One row into two bytes: D and E = the row's pixels moved right B.","comment":"A = the glyph's row"},
        "8021": {"comment":"Inverted with INVERSE"},
        "8022": {"comment":"Cut to the width"},
        "8024": {"comment":"D = the pixels"},
        "8025": {"comment":"E = 0"},
        "8027": {"comment":"DE = the pixels moved right B"},
        "8029": {"comment":"The standard screen (F')?"},
        "8032": {"comment":"A' = the colour again"},
        "8033": {"comment":"Hi-colour?"},
        "8039": {"comment":"Hi-res: the first byte"},
        "8040": {"comment":"Its kept bits"},
        "8042": {"comment":"And the pixels"},
        "8044": {"comment":"In the second file?"},
        "8046": {"comment":"The second byte: in the other file"},
        "8048": {"comment":"It was in the first: same place"},
        "8050": {"comment":"It was in the second: next byte"},
        "8053": {"synopsis":"Hi-res: the second byte.","comment":"The second byte"},
        "8058": {"comment":"HL back"},
        "8059": {"comment":"The next row"},
        "8061": {"synopsis":"Hi-colour: both pixel bytes, then their colour bytes in the second file.","comment":"Hi-colour: the first byte"},
        "8065": {"comment":"The second byte"},
        "8071": {"comment":"Back to the first"},
        "8072": {"comment":"Its colour byte, in the second file"},
        "8074": {"comment":"A = the colour"},
        "8075": {"comment":"Stored"},
        "8077": {"comment":"Two bytes covered?"},
        "8081": {"comment":"The second colour byte"},
        "8086": {"synopsis":"HL back in the first file.","comment":"HL back in the first file"},
        "8088": {"comment":"The next row"},
        "8090": {"synopsis":"Standard screen: the row into two adjacent bytes.","comment":"A' = the colour again"},
        "8091": {"comment":"The first byte"},
        "8095": {"comment":"The second byte"},
        "8101": {"comment":"Back to the first"},
        "8102": {"synopsis":"The next pixel row.","comment":"A pixel row down"},
        "8105": {"comment":"The next row"},
        "8107": {"comment":"IXL back"},
        "8109": {"comment":"DE', BC', HL' back"},
        "8113": {"comment":"The cursor moved on"},
        "8115": {"synopsis":"One byte a row: C = the keep mask moved right B.","comment":"D = the keep mask moved right B"},
        "8117": {"comment":"C = it"},
        "8119": {"synopsis":"One row into one byte.","comment":"A = the glyph's row"},
        "8121": {"comment":"Inverted with INVERSE"},
        "8122": {"comment":"Cut to the width"},
        "8124": {"comment":"D = the pixels"},
        "8125": {"comment":"Moved right B"},
        "8127": {"comment":"The kept bits and the pixels"},
        "8131": {"comment":"A pixel row down"},
        "8134": {"comment":"The next row"},
        "8136": {"comment":"DE', BC', HL' back"},
        "8137": {"synopsis":"BC' and HL' back; on to WCH_ADVANCE."},
        "8140": {"synopsis":"Moves the cursor on a character: the count +$24 one more, the pixel offset +$23 on by the\nwidth (+$0F), into the next cell (+$21) when it reaches the cell width (+$1D).","comment":"One more on the line"},
        "8143": {"comment":"The offset plus the width"},
        "8149": {"comment":"Into the next cell?"},
        "8154": {"comment":"Yes: less the cell width"},
        "8157": {"comment":"The cell column one on"},
        "8160": {"synopsis":"The new pixel offset stored.","comment":"The pixel offset"},
        "8164": {"synopsis":"Draws the glyph (on the stack) at the cursor on a screen of one byte a pixel:\n1. HL = the cursor's byte, MMU 6-7 paged (WCH_BYTES_ADDR); C = the step from a row's last\n   byte to the next row's first.\n2. D = the ink (+$1F), E = the paper (+$20), swapped with INVERSE (+$27 bit 0).\n3. Each glyph row's pixels as ink or paper bytes, or with OVER (+$28 bit 0) only the ink\n   ones; the next part of the screen paged in when a row passes this one's end\n   (WCH_BYTES_ON).\n4. WCH_PLOT_END, WCH_ADVANCE.\nWith 6-pixel lines 6 rows, from the glyph's second.","comment":"A = the cell column"},
        "8167": {"comment":"x 8: its pixel column"},
        "8170": {"comment":"Plus the offset"},
        "8173": {"comment":"L = the pixel column"},
        "8174": {"comment":"H = the pixel row"},
        "8177": {"comment":"HL = its byte; B = the part's end"},
        "8180": {"comment":"C = the line less the width"},
        "8186": {"comment":"D = the ink"},
        "8189": {"comment":"E = the paper"},
        "8192": {"comment":"INVERSE?"},
        "8198": {"comment":"Ink and paper swapped"},
        "8201": {"synopsis":"HL' = the glyph, and the rows.","comment":"Alternate set"},
        "8202": {"comment":"HL' = the glyph"},
        "8203": {"comment":"BC' kept"},
        "8204": {"comment":"8 rows"},
        "8206": {"comment":"6-pixel lines?"},
        "8212": {"comment":"Then 6, from the glyph's second"},
        "8215": {"synopsis":"One row of the glyph.","comment":"A = the glyph's row"},
        "8217": {"comment":"Main set"},
        "8218": {"comment":"The step kept"},
        "8219": {"comment":"B = the width"},
        "8222": {"comment":"OVER?"},
        "8228": {"synopsis":"One pixel: ink or paper.","comment":"The next pixel"},
        "8229": {"comment":"Ink"},
        "8230": {"comment":"Set?"},
        "8232": {"comment":"No: paper"},
        "8233": {"synopsis":"The next byte.","comment":"The next byte"},
        "8234": {"comment":"Across the width"},
        "8236": {"synopsis":"HL = the next row's first byte.","comment":"C = the step"},
        "8238": {"comment":"HL = the next row's first byte"},
        "8240": {"comment":"Past this part of the screen?"},
        "8242": {"comment":"Then the next part"},
        "8245": {"comment":"Alternate set"},
        "8246": {"comment":"The next row"},
        "8248": {"comment":"Done: the cursor on"},
        "8250": {"synopsis":"OVER: one pixel, only an ink one written.","comment":"The next pixel"},
        "8251": {"comment":"Set?"},
        "8253": {"comment":"Ink; paper left as it is"},
        "8254": {"synopsis":"The next byte.","comment":"The next byte"},
        "8255": {"comment":"Across the width"},
        "8257": {"comment":"The row done"},
        "8259": {"synopsis":"Code $0D: a new line: the cursor to the window's left (+$21 = +$13, the offset and count 0)\nand down a line (WCH_LINEFEED), two lines with double height (+$25 bit 5). Also when a\ncharacter does not fit on the line. Keeps HL.","comment":"A = 0"},
        "8260": {"comment":"No pixel offset"},
        "8263": {"comment":"Nothing on the line"},
        "8266": {"comment":"The window's left column"},
        "8272": {"comment":"Double height?"},
        "8276": {"comment":"Then two lines down"},
        "8279": {"synopsis":"The cursor a line down (8 or 6 pixel rows, WCH_NEXT_LINE_Y). A line that would start below\nthe window's bottom (+$18) is moved up 8 rows and the window scrolled (WCH_SCROLL_UP); one\nstarting on it stays there until a character is drawn. Keeps HL.","comment":"HL kept"},
        "8280": {"comment":"A = a line down"},
        "8283": {"comment":"The cursor there"},
        "8286": {"comment":"Does it start below the bottom?"},
        "8292": {"comment":"Then up and a scroll"},
        "8297": {"synopsis":"The cursor up 8 pixel rows, then WCH_SCROLL.","comment":"Up 8 pixel rows"},
        "8305": {"synopsis":"Code 7, and wherever the window must scroll: scrolls the window up one character row.\n1. With +$1A not 0, every +$1A scrolls (counted in +$1B) a pause first: the bottom right\n   cell inverted (WCH_CORNER_OP with WCH_OPS_INVERT), a key waited for ($11E0), the cell put\n   back.\n2. Each cell row copied up a row (WCH_OPS_SCROLL), the last row cleared to the window's\n   colour (WCH_CLEAR_LAST).","comment":"Rows between pauses"},
        "8308": {"comment":"None: no pause"},
        "8311": {"comment":"Count down"},
        "8314": {"comment":"Not yet"},
        "8316": {"comment":"Counted again from +$1A"},
        "8319": {"comment":"The inverting routines"},
        "8325": {"comment":"Bottom right cell inverted"},
        "8328": {"comment":"A key waited for"},
        "8331": {"comment":"The cell back"},
        "8334": {"synopsis":"The rows moved up and the last one cleared.","comment":"The routines that copy a row up"},
        "8340": {"comment":"E = 1: the last row left out"},
        "8342": {"comment":"The rows moved up"},
        "8345": {"comment":"The last row cleared"},
        "8349": {"synopsis":"The window's last cell row (+$16) cleared, with the routines of WCH_OPS_CLEAR.","comment":"The clearing routines"},
        "8352": {"comment":"C = the width"},
        "8355": {"comment":"One row"},
        "8358": {"comment":"H = the last row"},
        "8363": {"synopsis":"Code $1A: the rows to scroll between pauses into +$1A (0 for no pauses), and the count +$1B\nstarted from it.","comment":"Rows between pauses"},
        "8366": {"comment":"The count"},
        "8370": {"synopsis":"Code $0F: the window's colour put back over it, the pixels left alone: its attributes\n(+$1F), and in hi-colour its colour bytes (WCH_OPS_COLOUR); nothing with one byte a pixel.","comment":"The recolouring routines"},
        "8375": {"synopsis":"Code $0E: the cursor home and the window cleared (WCH_OPS_CLEAR): attributes to +$1F and\npixels to 0 (in hi-colour the colour bytes to +$1F), or with one byte a pixel every byte to\nthe paper (+$20). +$1B = 1, so that the first scroll after it pauses.","comment":"The cursor home"},
        "8378": {"comment":"The next scroll pauses"},
        "8383": {"comment":"The clearing routines"},
        "8388": {"synopsis":"From page 1 ($31FD, with IX = $5C92 and HL = WCH_OPS_STORE): MMU 6-7 back to pages 11 and 16\n($1942), then WCH_AREA_OP.","comment":"Routines kept"},
        "8389": {"comment":"MMU 6-7: pages 11 and 16"},
        "8393": {"synopsis":"Runs the three routines at HL over the whole window, after copying them to $5B91, $5B94 and\n$5B97 (WCH_SET_OPS). WCH_AREA_ROWS: for each cell row, its attribute row ($5B91; not with\n$5C7F bit 3, hi-res and hi-colour), then for each its 8 pixel rows ($5B94, DE = the row, HL\n= the one below); with one byte a pixel WCH_BYTES_OP instead, with $5B97.\nEntry (WCH_AREA_ROWS): E = the rows to leave out at the bottom (1 when scrolling).","comment":"The routines installed"},
        "8396": {"comment":"E = 0: all the rows"},
        "8398": {"synopsis":"The window less its last E rows.","comment":"C = the width"},
        "8401": {"comment":"A = the height"},
        "8404": {"comment":"Less E"},
        "8405": {"comment":"B = the rows"},
        "8406": {"comment":"None?"},
        "8407": {"comment":"Width and rows kept"},
        "8408": {"comment":"H = the top row"},
        "8411": {"synopsis":"L = the window's left column.","comment":"L = the left column"},
        "8414": {"synopsis":"H = the cell row x 8, L = the cell column x 8: the corner's pixel row and column.","comment":"x 8: the corner's pixel row and column"},
        "8417": {"comment":"One byte a pixel?"},
        "8420": {"comment":"Yes"},
        "8422": {"comment":"D = the row, E = the column"},
        "8423": {"comment":"HL = the attribute, DE = the pixel byte"},
        "8426": {"comment":"BC = width and rows"},
        "8428": {"synopsis":"One attribute row.","comment":"Row count kept"},
        "8429": {"comment":"BC = the width"},
        "8431": {"comment":"Attributes (not hi-res, hi-colour)?"},
        "8435": {"comment":"One attribute row"},
        "8439": {"comment":"The next"},
        "8441": {"comment":"Width and rows"},
        "8442": {"synopsis":"One cell row of pixels.","comment":"Kept"},
        "8443": {"comment":"BC = the width"},
        "8445": {"comment":"HL = the cell row's last pixel row"},
        "8450": {"comment":"Down a row: the next cell row"},
        "8452": {"comment":"Kept"},
        "8453": {"comment":"8 pixel rows"},
        "8455": {"synopsis":"One pixel row.","comment":"Count kept"},
        "8456": {"comment":"The row kept"},
        "8457": {"comment":"One pixel row"},
        "8462": {"comment":"Both a pixel row down"},
        "8464": {"comment":"All 8?"},
        "8467": {"comment":"DE = the next cell row"},
        "8469": {"comment":"The next cell row"},
        "8472": {"synopsis":"The routines installed run over one cell: the window's bottom right (row +$16, column +$15).","comment":"One cell: B = 1 row, C = 1"},
        "8476": {"comment":"H = the bottom row"},
        "8479": {"comment":"L = the right column"},
        "8484": {"synopsis":"WCH_AREA_OP on a screen of one byte a pixel:\n1. IX kept at $5B8C and the paper (+$20) at $5B9A, since MMU 7 now holds the screen.\n2. The window's corner paged in at $C000-$FFFF (WCH_BYTES_MAP16), HL = its byte.\n3. $5B97 run for each pixel row with IX = its bytes (the width x 8; IXL 0 means 256); the\n   next part of the screen paged in after each 8 rows when it is reached (WCH_BYTES_ON2).\n4. IX back, MMU 6-7 back to pages 11 and 16 ($1942).","comment":"IX kept"},
        "8488": {"comment":"The paper, for the clearing routine"},
        "8494": {"comment":"HL = the corner's byte; MMU 6 and 7"},
        "8497": {"comment":"E = the width, D = the rows"},
        "8498": {"comment":"A = the width x 4"},
        "8501": {"comment":"IX = it"},
        "8506": {"comment":"IX = the width x 8: the row's bytes"},
        "8508": {"synopsis":"One cell row: 8 pixel rows.","comment":"8 pixel rows"},
        "8510": {"synopsis":"One pixel row.","comment":"Counts kept"},
        "8511": {"comment":"The row kept"},
