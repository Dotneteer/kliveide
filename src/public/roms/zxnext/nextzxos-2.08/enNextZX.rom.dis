        "8686": {"comment":"Across the width"},
        "8689": {"synopsis":"Pixel row when recolouring: in hi-colour (+$1E bits 2 and 3 set) the C colour bytes at DE +\n$8000 set to +$1F; otherwise nothing.","comment":"The mode's bits 2-3"},
        "8694": {"comment":"Hi-colour?"},
        "8697": {"comment":"Yes: its colour bytes"},
        "8699": {"synopsis":"Pixel row: C bytes between DE and the store (WCH_STORE_COPY), the second file's too with\n$5C7F bit 3 (hi-res, hi-colour).\nKeeps HL.","comment":"Kept"},
        "8701": {"comment":"Copied"},
        "8705": {"comment":"DE in the second file"},
        "8707": {"comment":"Two screen files?"},
        "8711": {"comment":"Those too"},
        "8716": {"synopsis":"Pixel row: C bytes at DE inverted; in hi-res (+$1E bits 3-2 = 10) those at DE + $8000, the\nsecond file's, instead.","comment":"The mode's bits 2-3"},
        "8721": {"comment":"Hi-res?"},
        "8725": {"comment":"Then the second file"},
        "8727": {"synopsis":"B = the width.","comment":"B = the width"},
        "8728": {"synopsis":"One byte inverted.","comment":"One byte inverted"},
        "8732": {"comment":"Across the width"},
        "8735": {"synopsis":"Rows of one byte a pixel: IX bytes from 8 rows below to the row at HL. With LoRes (C bit 7\nclear), the row below may lie in the lower half, at $C000 up.\nEntry: C = the row's length - 1 ($7F LoRes, $FF Layer 2), B = the end of this part of the\nscreen.","comment":"DE = the row"},
        "8736": {"comment":"HL = (C + 1) x 8: 8 rows on"},
