        "668": {"synopsis":"Open actions 1 and 2: D = 0 or 1, bit 1 set.","comment":"D = 0 or 1"},
        "670": {"comment":"Bit 1: opened, not made"},
        "672": {"comment":"On"},
        "674": {"synopsis":"The create action: 1 or 2 only.","comment":"Create action 3 or more?"},
        "677": {"comment":"Yes: rc_badparam"},
        "679": {"comment":"Create action 0?"},
        "680": {"comment":"rc_nofile"},
        "682": {"comment":"Yes: fail"},
        "684": {"comment":"D = 0 or 1"},
        "685": {"comment":"D kept","synopsis":"OPEN_FILE's step 5: OPEN_VEC for the drive, then the file's table byte set."},
        "686": {"comment":"A = the drive"},
        "688": {"comment":"OPEN_VEC for it"},
