        "5592": {"comment":"Copied"},
        "5594": {"comment":"Its new end"},
        "5599": {"synopsis":"BC bytes done: the counts and the pointer.","comment":"Wanted - done"},
        "5608": {"comment":"Z kept: all wanted done?"},
