        "1255": {"comment":"On"},
        "1257": {"synopsis":"BC and DE = the 32-bit field at IY + C (RST $28's work): BC its low word, DE its high word.\nHL kept.","comment":"Base IY"},
        "1259": {"comment":"HL = the base, HL kept","synopsis":"Reads the 32-bit field at HL + C into BC (low word) and DE (high word), HL kept."},
        "1260": {"comment":"Plus the offset"},
