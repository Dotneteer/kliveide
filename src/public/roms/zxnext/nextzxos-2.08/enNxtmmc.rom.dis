        "698": {"comment":"Z: made, not opened"},
        "701": {"synopsis":"DOS_CLOSE's work: CLOSE_VEC for file A; on success the file's table byte ($2320 + A) = $FF\n(free).\nExit: carry set on success; carry clear, A = the code.","comment":"File number kept"},
