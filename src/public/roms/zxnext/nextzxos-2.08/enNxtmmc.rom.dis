        "1353": {"comment":"Automap off, carry kept"},
        "1356": {"comment":"Never taken"},
        "1358": {"comment":"Caller's SP back"},
        "1362": {"comment":"CONMEM, bank 2","synopsis":"RST08_DISPATCH's step 4: port $E3 = $82, interrupts on if they were on."},
