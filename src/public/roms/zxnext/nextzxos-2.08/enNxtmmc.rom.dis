        "7002": {"comment":"Separator or end: done, Fc=1"},
        "7006": {"comment":"Control code?"},
        "7010": {"comment":"$7F or above?"},
        "7013": {"comment":"'\"' ':' '<' '>' '`' '|' are invalid"},
        "7031": {"comment":"'?'?"},
        "7035": {"comment":"'*'?"},
