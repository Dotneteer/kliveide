        "5497": {"comment":"HL = its low word"},
        "5499": {"comment":"BCDE = the pointer"},
        "5501": {"comment":"Size - pointer"},
        "5510": {"comment":"The count"},
        "5513": {"comment":"More than 65535 left?"},
        "5515": {"comment":"Count - what is left"},
        "5519": {"comment":"Count the smaller"},
        "5522": {"synopsis":"One sector's part, or one whole sector.","comment":"The bytes for this call"},
        "5525": {"comment":"Sector and byte"},
