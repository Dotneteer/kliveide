        "778": {"comment":"Success"},
        "780": {"synopsis":"From CALL_2006_BANK_W when bit 7 of the bank byte is set: the CALL's return address dropped,\nfailure with rc_nodrive ($16).","comment":"Return address dropped"},
        "782": {"comment":"rc_nodrive"},
        "784": {"synopsis":"DOS_CATALOG's work: $26E7 in DivMMC RAM bank 12 (CALL_IN_BANK).","comment":"Bank 12, $26E7"},
