        "519": {"comment":"The drive table"},
        "522": {"comment":"A = the drive's byte"},
        "525": {"comment":"HL back"},
        "527": {"synopsis":"DRIVE_CALL_1BA8, then: a failure is passed on; success with S set is passed on; otherwise\nrc_badname ($14).","comment":"Call $1BA8 for the drive"},
