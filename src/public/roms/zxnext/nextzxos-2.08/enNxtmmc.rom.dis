        "592": {"comment":"Open action 3 or more?"},
        "595": {"comment":"rc_badname"},
        "597": {"comment":"Yes: fail"},
        "599": {"comment":"Create action 0?"},
        "601": {"comment":"No: fail"},
        "603": {"synopsis":"$1C7B in the drive's bank, registers kept.","comment":"Registers kept"},
