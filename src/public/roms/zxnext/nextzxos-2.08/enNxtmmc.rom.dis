        "7638": {"comment":"B = 2: search record made current"},
        "7648": {"synopsis":"Resolves path HL on drive A from its current path text (DRV_PATH_LOAD to the buffer DE + 2),\nkeeping that text up to date (PATH_WALK_TEXT); a last name is entered as a directory too.\nExit: Fc=1, HL = the new path text; Fc=0 A = error.","comment":"Keep the path and the drive"},
        "7650": {"comment":"Current path text at DE + 2"},
