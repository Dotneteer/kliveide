        "507": {"comment":"HL kept"},
        "508": {"comment":"HL = the entry's word"},
        "514": {"comment":"HL back, the word to go to"},
        "515": {"comment":"Go"},
        "516": {"synopsis":"A = the drive table's byte ($2310) for drive A (its low 4 bits). HL kept. Called from\nDRIVE_CALL_1BA8 and $1DAA.","comment":"HL kept"},
