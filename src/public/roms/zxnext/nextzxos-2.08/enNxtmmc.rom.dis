        "6774": {"comment":"IX = size, low word"},
        "6782": {"comment":"HL = size, high word"},
        "6787": {"synopsis":"Matches the pattern at DE against a name: with NZ the name text at HL ($FF-ended) first,\nthen the 11-byte 8.3 name at BC. In the pattern, '?' is any one character, '*' the rest up\nto the name's last '.' (or all of it); letters match in either case; a name byte outside\n$20-$7E matches only '_'.\nExit: Z match, NZ none.","comment":"Keep 8.3 name and pattern"},
        "6789": {"comment":"Name text not wanted?"},
        "6791": {"synopsis":"One pattern character against the name text.","comment":"A = pattern character"},
        "6793": {"comment":"Pattern ended?"},
        "6797": {"comment":"'*'?"},
        "6801": {"comment":"'?'?"},
        "6803": {"comment":"C = name character"},
        "6807": {"comment":"'?': name ended?"},
        "6808": {"comment":"No: matched"},
        "6810": {"comment":"Yes: try the 8.3 name"},
        "6812": {"synopsis":"Other characters: the same in either case?","comment":"Same, either case?"},
        "6816": {"comment":"Yes: next"},
        "6818": {"comment":"No: try the 8.3 name"},
        "6820": {"synopsis":"Pattern ended: the name must end too.","comment":"Name ended?"},
        "6822": {"comment":"No: try the 8.3 name"},
        "6824": {"synopsis":"The name text matches: Z.","comment":"Registers back, Z"},
        "6827": {"synopsis":"'*': the name skipped to its first '.'.","comment":"A = name character"},
        "6829": {"comment":"Name ended?"},
