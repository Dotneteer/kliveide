      ],
      "lineAnnotations": {
        "0": {"synopsis":"RST $00, reset: interrupts off, then RESET_GO, which pages the DivMMC memory out and goes on\nat $0001 of the Spectrum ROM.","comment":"Interrupts off"},
        "1": {"comment":"On to the page-out"},
        "4": {"synopsis":"Four bytes nothing in this ROM runs or reads: 'D', 'V', $08, $02."},
        "8": {"synopsis":"RST $08: an API call; the byte after the RST is the call's code. On to RST08_DISPATCH.","comment":"To the dispatcher"},
        "11": {"synopsis":"Not reached from this ROM: HL = the word on the stack (after an RST $08, the address of its\ncode byte), AF kept, then on at $3364 in DivMMC RAM.","comment":"HL = the code byte's address"},
        "12": {"comment":"AF kept"},
        "13": {"comment":"On in DivMMC RAM"},
        "16": {"synopsis":"RST $10: RST $18 with the word $0010, the code at $3C4D in DivMMC RAM being given $0010\n(RST18_CALL).","comment":"Call with the word $0010"},
        "19": {"comment":"Done"},
        "20": {"synopsis":"Failure with code $3A (rc_notimp in the API document's list): A = $3A, carry clear. The\nunused entries of CALL_TABLE ($0112, $0115, $012A) jump here, and DRIVE_USER_AREA's word is\nthis address.","comment":"Code $3A"},
        "22": {"comment":"Carry clear: failed"},
        "24": {"synopsis":"RST $18: on to RST18_CALL, which takes the word after the RST (high byte first).","comment":"Two NOPs, then on"},
        "26": {"comment":"To RST18_CALL"},
        "29": {"synopsis":"Not reached from this ROM: A = (HL).","comment":"A = (HL)"},
        "32": {"synopsis":"RST $20: the return address is dropped, GO_3CFD_BANK0 is called ($3CFD in DivMMC RAM, port\n$E3 = $80), and RST20_EXIT then goes to the address that leaves in HL.","comment":"Return address dropped"},
        "34": {"comment":"$3CFD in bank 0"},
        "37": {"comment":"On to HL"},
        "40": {"synopsis":"RST $28 + a byte: BC and DE = the 32-bit field at IY + the byte (BC its low word, DE its\nhigh word). HL kept.","comment":"HL = the byte's address"},
        "41": {"comment":"C = the offset"},
        "42": {"comment":"Return address past it"},
        "44": {"comment":"On to the read"},
        "48": {"synopsis":"RST $30 + a word: the vector of a CALL_TABLE entry. Calls the routine for the drive, unit or\nfile number in A, in the DivMMC RAM bank one of three 16-byte tables gives for it, or the\nword itself when that bank is 0 (RST30_DISPATCH).\nEntry: A = the drive, unit or file number; the other registers for the routine.\nExit: AF, BC, DE, HL as the routine leaves them; port $E3 as on entry. The alternate\nregisters kept.","comment":"Alternate set"},
        "49": {"comment":"HL' = entry + 1, HL' kept"},
        "50": {"comment":"DE' kept"},
        "51": {"comment":"D' = the number"},
        "52": {"comment":"Entry + 1 kept"},
        "53": {"comment":"On to RST30_DISPATCH"},
        "56": {"synopsis":"The IM 1 interrupt: on to INT_HANDLER.","comment":"To INT_HANDLER"},
        "59": {"synopsis":"Not reached from this ROM: INT_CALL_2009; then the word on the stack goes back into HL,\n$0050 takes its place as the return address, and the RET at $1FF9 (the fetch there ends the\nautomap) goes there.","comment":"The interrupt routine"},
        "62": {"comment":"Return to $0050"},
        "65": {"comment":"HL back from the stack"},
        "66": {"comment":"Return, automap off"},
        "69": {"synopsis":"Calls $2009 in DivMMC RAM bank 1 on a stack of its own:\n1. Port $E3 = bank 1, bits 7-6 (CONMEM, MAPRAM) as read.\n2. SP kept at $25B8 and set to $26ED; the routine at $2009 called.\n3. SP and port $E3 back.\nCalled from INT_ALT and INT_HANDLER. NextZXOS ROM 0's interrupt comes in at $0048 instead,\nafter its own OUT ($E3),$80 with H = 0: port $E3 is then 0 at the end, and ROM 0's $0060\nfollows the OUT at $005E.\nExit: A = port $E3 as read on entry.\nChanges: F, H.","comment":"A = port $E3 as it was"},
        "71": {"comment":"H = it, kept"},
        "72": {"comment":"Bits 7-6 kept"},
        "74": {"comment":"Bank 1"},
        "76": {"comment":"Paged in"},
        "78": {"comment":"SP kept"},
        "82": {"comment":"A stack of its own"},
        "85": {"comment":"Old port value kept"},
        "86": {"comment":"The routine at $2009, bank 1"},
        "89": {"comment":"A = the old port value"},
        "90": {"comment":"SP back"},
        "94": {"comment":"Port $E3 back"},
        "96": {"comment":"Done"},
        "97": {"synopsis":"JP (IX): a CALL here calls the routine at IX. Not called from this ROM.","comment":"To IX"},
        "102": {"synopsis":"The NMI: AF pushed and popped, RETN at once.","comment":"Nothing to do"},
        "104": {"comment":"Back"},
        "106": {"synopsis":"RST $00's way on: $0001 pushed, then PAGE_OUT_RET ($1E90) pages the DivMMC memory out and\nreturns there, to the Spectrum ROM after its DI.","comment":"Return to $0001"},
        "110": {"comment":"Page out, return"},
        "113": {"synopsis":"RST $20's end: the address in HL pushed, $32FF = 0, and the RET at $1FF9 goes to it (the\nfetch there ends the automap).","comment":"Address to go to"},
        "114": {"comment":"$32FF = 0"},
        "118": {"comment":"Return, automap off"},
        "121": {"synopsis":"Reads NextReg A: port $243B = A, then A = port $253B. Not called from this ROM.\nExit: A = the register's value, BC = $253B.","comment":"Register select port"},
        "124": {"comment":"Select A"},
        "126": {"comment":"BC = $253B"},
        "127": {"comment":"A = its value"},
        "130": {"synopsis":"MMU 6 and 7 ($C000-$FFFF) = 16K bank 7 (8K pages 14 and 15). Called from $15FE and $160C. AF\nkept.","comment":"AF kept"},
        "131": {"comment":"Bank 7"},
        "135": {"synopsis":"MMU 6 and 7 ($C000-$FFFF) = 16K bank C (8K pages 2 x C and 2 x C + 1). Called from $1566 and\n$1622. AF kept.","comment":"AF kept"},
        "136": {"comment":"Bank C"},
        "137": {"synopsis":"MMU 6 = 8K page 2 x A, MMU 7 = the next page; AF back from the stack.","comment":"8K page"},
        "138": {"comment":"At $C000"},
        "141": {"comment":"Next page"},
        "142": {"comment":"At $E000"},
        "145": {"comment":"AF back"},
        "147": {"synopsis":"Copies the $FF-ended text at HL to DE in DivMMC RAM bank 2 (port $E3 = 2 for each byte\nwritten, then back), at most 255 bytes; the copy always ends with $FF. Not called from this\nROM.\nExit: HL past the last byte read, DE past the $FF.","comment":"At most 255 bytes"},
        "149": {"synopsis":"The next byte.","comment":"C = the next byte"},
        "151": {"comment":"Source kept","synopsis":"Stores byte C in bank 2 (STR_TO_BANK2's step); $FF ends the copy."},
        "152": {"comment":"L = port $E3 as it was"},
        "155": {"comment":"Bank 2"},
        "159": {"comment":"The byte $FF?"},
        "161": {"comment":"Yes: $FF goes"},
        "163": {"comment":"No: the byte"},
        "164": {"comment":"Stored in bank 2","synopsis":"The byte written with bank 2 paged in, port $E3 then put back."},
        "166": {"comment":"Port $E3 back"},
        "169": {"comment":"Source back"},
        "170": {"comment":"$FF stored: done"},
        "171": {"comment":"Next byte"},
        "173": {"comment":"255 copied: end with $FF"},
        "177": {"synopsis":"Copies the $00-ended text at HL in DivMMC RAM bank 2 (port $E3 = 2 for each byte read, then\nback) to DE, at most 255 bytes, ending the copy with $FF instead of the $00. Not called from\nthis ROM.\nExit: HL = the copy's start; DE at its $FF.","comment":"At most 255"},
        "180": {"comment":"Destination kept"},
        "181": {"synopsis":"The next byte.","comment":"C = port $E3 as it was"},
        "184": {"comment":"Bank 2"},
        "188": {"comment":"A = the old port value"},
        "189": {"comment":"C = the byte"},
        "191": {"comment":"Port $E3 back"},
        "193": {"comment":"The $00 at the end?"},
        "195": {"comment":"Yes"},
        "197": {"comment":"No: copied"},
        "199": {"comment":"Next"},
        "201": {"comment":"$FF ends the copy","synopsis":"The copy ended with $FF; HL = its start (STR_FROM_BANK2's end)."},
        "204": {"comment":"HL = the copy"},
        "206": {"synopsis":"Port $E3 = $80 (CONMEM, bank 0), then on to $3CFD in DivMMC RAM. Called from RST20_ENTRY,\nRST18_CALL, RST08_DISPATCH and AUTOMAP_0562.","comment":"CONMEM, bank 0"},
        "210": {"comment":"On in DivMMC RAM"},
        "229": {"synopsis":"The IM 1 interrupt (from INT_ENTRY): AF and HL kept, INT_CALL_2009 called. When port $E3 had\nCONMEM set, the return is made from $1FFC (POP HL, POP AF, EI, RET; CONMEM keeps this ROM\nin, and the fetch at $1FFC clears the automap the entry at $0038 set); with CONMEM clear it\nis made from here, the automap left as it is.","comment":"AF, HL kept"},
        "231": {"comment":"A = port $E3 as it was"},
        "234": {"comment":"CONMEM was set?"},
        "235": {"comment":"Yes: return from $1FFC"},
        "238": {"comment":"No: HL, AF back"},
        "240": {"comment":"Interrupts on"},
        "242": {"synopsis":"BC = 0, then $204F in DivMMC RAM bank 1 is called (CALL_IN_BANK). Called from $18E1.","comment":"BC = 0"},
        "245": {"comment":"Bank 1, $204F"},
        "251": {"comment":"Done"},
        "252": {"synopsis":"The text \"FAT\", its last letter with bit 7 set, and a $00. CARD_CAPACITY ($0EDF) loads IX\nwith $00FC."},
        "256": {"synopsis":"CALL_TABLE: 31 entries of three bytes, $0100-$018A, the DivMMC side's entry points (NextZXOS\nROM 2 reaches them through its RST $08; its synopses give the API names). An RST $30 entry\ncalls its word through RST30_DISPATCH, for the number in A, in the bank a 16-byte table\ngives for that number:\n1. $0100-$0115: the unit table at $2300 (A = the unit, 0-15).\n2. $0118-$013C: the drive table at $2310 (A's low 4 bits = the drive A-P).\n3. $013F-$0163: the file table at $2320 (A = the file number, 0-15).\nA bank other than 0 calls $2000 + the entry's offset in that bank instead of the word. A JP\nentry goes straight to its routine; $0112, $0115 and $012A go to FAIL_NOTIMP.\nEntry $0100: DEVICES_INIT for unit A (from UNITS_INIT).","comment":"Unit's bank: DEVICES_INIT"},
        "259": {"synopsis":"IDE_DRIVE: $0EDA for unit A.","comment":"Unit's bank: $0EDA"},
        "262": {"synopsis":"IDE_CAPACITY: $0EDF (CARD_CAPACITY) for unit A.","comment":"Unit's bank: CARD_CAPACITY"},
        "265": {"synopsis":"IDE_PARTITION_FIND: $0D50 for unit A.","comment":"Unit's bank: $0D50"},
        "268": {"synopsis":"IDE_PARTITON_READ (so spelt in the document): $0D01 for unit A.","comment":"Unit's bank: $0D01"},
        "271": {"synopsis":"$0DA5 for unit A (MAP_DRIVE, for IDE_DOS_MAP).","comment":"Unit's bank: $0DA5"},
        "274": {"comment":"Unused: rc_notimp"},
        "277": {"comment":"Unused: rc_notimp"},
        "280": {"synopsis":"DOS_FREE_SPACE: FREE_SPACE_KB for drive A.","comment":"Drive's bank: FREE_SPACE_KB"},
        "283": {"synopsis":"DOS_FLUSH: $0E8F for drive A.","comment":"Drive's bank: $0E8F"},
        "286": {"synopsis":"IDE_DOS_MAPPING: $0E58 for drive A.","comment":"Drive's bank: $0E58"},
        "289": {"synopsis":"$0E0E for drive A (UNMAP_DRIVE, for IDE_DOS_UNMAP).","comment":"Drive's bank: $0E0E"},
        "292": {"synopsis":"Drive A's user area (NAME_PREP; NextZXOS ROM 2's DOS_SET_USER): the word is FAIL_NOTIMP, so\ndrives without a bank of their own give rc_notimp.","comment":"Drive's bank, else rc_notimp"},
        "295": {"synopsis":"$12A0 for drive A (DEFAULT_DRIVE, with B = 1).","comment":"Drive's bank: $12A0"},
        "298": {"comment":"Unused: rc_notimp"},
        "301": {"synopsis":"$3DF1 (DivMMC RAM) for drive A.","comment":"Drive's bank: $3DF1"},
        "304": {"synopsis":"$3E1F (DivMMC RAM) for drive A (OPEN_FILE, open actions 3 and 4).","comment":"Drive's bank: $3E1F"},
        "307": {"synopsis":"$3E81 (DivMMC RAM) for drive A.","comment":"Drive's bank: $3E81"},
        "310": {"synopsis":"$175C for drive A (OPEN_FILE's last step).","comment":"Drive's bank: $175C"},
        "313": {"comment":"Straight to $1C91"},
        "316": {"comment":"Straight to $1D20"},
        "319": {"synopsis":"DOS_REF_HEAD: $16A3 for file A.","comment":"File's bank: $16A3"},
        "322": {"synopsis":"DOS_READ: $1559 for file A.","comment":"File's bank: $1559"},
        "325": {"synopsis":"DOS_WRITE: $1615 for file A.","comment":"File's bank: $1615"},
        "328": {"synopsis":"DOS_BYTE_READ: $1517 for file A.","comment":"File's bank: $1517"},
        "331": {"synopsis":"DOS_BYTE_WRITE: $153D for file A.","comment":"File's bank: $153D"},
        "334": {"synopsis":"DOS_GET_POSITION: $1669 for file A.","comment":"File's bank: $1669"},
        "337": {"synopsis":"DOS_SET_POSITION: $1672 for file A.","comment":"File's bank: $1672"},
        "340": {"synopsis":"DOS_GET_EOF: $1681 for file A.","comment":"File's bank: $1681"},
        "343": {"synopsis":"DOS_SET_ACCESS: $170A for file A.","comment":"File's bank: $170A"},
        "346": {"synopsis":"$16B4 for file A (CLOSE_FILE, for DOS_CLOSE).","comment":"File's bank: $16B4"},
        "349": {"synopsis":"$16FF for file A (ABANDON_FILE, for DOS_ABANDON).","comment":"File's bank: $16FF"},
        "352": {"synopsis":"$16BC for file A.","comment":"File's bank: $16BC"},
        "355": {"synopsis":"$13F5 for file A.","comment":"File's bank: $13F5"},
        "358": {"synopsis":"To UNITS_INIT (NextZXOS ROM 2's IDE_MOUNT calls it twice, with HL = $2300 and $2302).","comment":"To UNITS_INIT"},
        "361": {"synopsis":"IDE_DOS_MAP: to MAP_DRIVE.","comment":"To MAP_DRIVE"},
        "364": {"synopsis":"IDE_DOS_UNMAP: to UNMAP_DRIVE.","comment":"To UNMAP_DRIVE"},
        "367": {"synopsis":"To DEFAULT_DRIVE (NextZXOS ROM 2's way to get or set the default drive).","comment":"To DEFAULT_DRIVE"},
        "370": {"synopsis":"DOS_OPEN: to OPEN_FILE.","comment":"To OPEN_FILE"},
        "373": {"synopsis":"DOS_CLOSE: to CLOSE_FILE.","comment":"To CLOSE_FILE"},
        "376": {"synopsis":"DOS_ABANDON: to ABANDON_FILE.","comment":"To ABANDON_FILE"},
        "379": {"synopsis":"DOS_CATALOG: to CATALOG_B12.","comment":"To CATALOG_B12"},
        "382": {"synopsis":"IDE_GET_LFN: to GET_LFN_B12.","comment":"To GET_LFN_B12"},
        "385": {"synopsis":"IDE_PATH: to $1DA8.","comment":"To $1DA8"},
        "388": {"synopsis":"DOS_DELETE: to DELETE_B12.","comment":"To DELETE_B12"},
        "391": {"synopsis":"DOS_RENAME: to RENAME_B12.","comment":"To RENAME_B12"},
        "394": {"synopsis":"DOS_SET_ATTRIBUTES: to SET_ATTR_B12.","comment":"To SET_ATTR_B12"},
        "397": {"synopsis":"RST $30's dispatch:\n1. E' = port $E3 as it was. L (the entry's address + 1) picks the table: below $18 the unit\n   table at $2300, below $3F the drive table at $2310 (A's low 4 bits), else the file table\n   at $2320.\n2. For $2300 and $2320 a number of 16 or more fails: rc_nodrive ($16) for units, rc_number\n   ($1D) for files.\n3. The table byte is kept at $2006. Bit 7 set fails the same way (rc_nodrive for drives\n   too); bit 6 clear passes only A's low 4 bits on.\n4. Bits 3-0 = 0: the entry's word is called (RST30_CALL). Otherwise port $E3 = that bank,\n   CONMEM as it was, and $2000 + the entry's offset is called.\n5. Port $E3 back from E', DE' and HL' back.\nExit: as the routine leaves it; on failure carry clear, A = the code.","comment":"Port $E3 kept in E"},
        "400": {"comment":"L = the entry's place"},
        "401": {"comment":"Table at $2320"},
        "404": {"comment":"Entry $013F or later?"},
        "406": {"comment":"Yes: the file table"},
        "408": {"comment":"$2300"},
        "410": {"comment":"Entry before $0118?"},
        "412": {"comment":"Yes: the unit table"},
        "414": {"comment":"No: the drive table"},
        "416": {"comment":"Drive: A's low 4 bits"},
        "419": {"comment":"Take the table byte"},
        "421": {"synopsis":"Units and files: 0-15 only.","comment":"A = the number"},
        "422": {"comment":"16 or more?"},
        "424": {"comment":"No: take the table byte"},
        "426": {"comment":"Yes: entry address dropped"},
        "427": {"synopsis":"Failure: rc_number ($1D) for the file table, rc_nodrive ($16) for the others.","comment":"Which table?"},
        "430": {"comment":"rc_number"},
        "432": {"comment":"File table: fail"},
        "434": {"comment":"rc_nodrive"},
        "436": {"comment":"Carry clear"},
        "437": {"comment":"Fail"},
        "439": {"synopsis":"The number's table byte.","comment":"HL at it"},
        "441": {"comment":"A = the table byte"},
        "442": {"comment":"HL = the entry + 1"},
        "443": {"comment":"Kept at $2006"},
        "446": {"comment":"Bit 6: the whole number?"},
        "448": {"comment":"Yes"},
        "450": {"comment":"No: only its low 4 bits"},
        "456": {"comment":"The bank, and bit 7","synopsis":"The table byte's bank bits: bit 7 fails, a bank calls RST30_IN_BANK, 0 the entry's word."},
        "458": {"comment":"Bit 7: nothing there, fail"},
        "461": {"comment":"A bank: call it there"},
        "463": {"comment":"HL = the entry's word"},
        "467": {"synopsis":"Calls HL with A = the number and the main registers as given (RST30_JUMP), then port $E3\nback from E', DE' and HL' back.","comment":"Call the routine"},
