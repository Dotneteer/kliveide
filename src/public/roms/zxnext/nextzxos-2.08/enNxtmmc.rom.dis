        "7903": {"synopsis":"The device's first sector added.","comment":"First sector, low word"},
        "7909": {"comment":"DE = low word"},
        "7911": {"comment":"First sector, high word"},
        "7917": {"comment":"HL = high word"},
        "7919": {"comment":"Card addressed in blocks?"},
        "7925": {"comment":"No: x 256"},
        "7930": {"comment":"x 2"},
        "7935": {"synopsis":"Z or NZ: which card.","comment":"Card 1?"},
        "7939": {"comment":"Success"},
        "7941": {"synopsis":"SD_COMMAND with argument 0.","comment":"Argument 0"},
        "7947": {"synopsis":"Sends SPI command A with argument HLDE (high byte first) and $FF as CRC to card 0 (Z, port\n$E7 = $FE) or card 1 (NZ, $FD), then waits for the response (SD_WAIT_BYTE).\nExit: Fc=1 response 0; Fc=0 A = the response ($FF none).","comment":"CRC byte $FF"},
        "7949": {"comment":"C = command"},
        "7950": {"comment":"Select card 0"},
        "7954": {"comment":"or card 1"},
        "7956": {"synopsis":"Card selected: the command's 6 bytes.","comment":"Chip select"},
        "7958": {"comment":"Clock one byte first"},
        "7960": {"comment":"Command"},
        "7965": {"comment":"Argument, high byte first"},
        "7977": {"comment":"CRC"},
        "7980": {"comment":"A = response"},
        "7983": {"comment":"0: accepted?"},
        "7985": {"comment":"Success"},
        "7987": {"synopsis":"Reads port $EB until a byte other than $FF, 50 x 256 times at most.\nExit: A = the byte ($FF on time-out).","comment":"50 x 256 tries"},
        "7990": {"synopsis":"One try."},
        "7992": {"comment":"Still $FF?"},
        "8001": {"synopsis":"Waits for the data token $FE, up to 10 times SD_WAIT_BYTE.\nExit: Z the token; NZ not (Fc=1 for a byte below $FE).","comment":"10 tries"},
        "8003": {"synopsis":"One try."},
        "8006": {"comment":"Data token?"},
        "8010": {"comment":"Below $FE: an error token"},
        "8012": {"comment":"Try again?"},
        "8015": {"synopsis":"The result."},
        "8016": {"synopsis":"Reads one 512-byte block from address HLDE of card Z (0) / NZ (1) to IX: command $51 (CMD17,\none block), the data token, the data through two INIRs, the 2 CRC bytes passed over; then\nSD_DESELECT.\nExit: Fc=1, HL = IX + 512; Fc=0 A = 0.","comment":"CMD17: read one block"},
        "8021": {"synopsis":"Failure: A = 0.","comment":"Error 0 (rc_ready)"},
        "8023": {"comment":"Command refused?"},
        "8025": {"comment":"Data token?"},
        "8030": {"comment":"No: Fc=0"},
        "8033": {"synopsis":"The data.","comment":"HL = buffer"},
        "8036": {"comment":"B = 0: 256 bytes a time"},
        "8039": {"comment":"512 bytes"},
        "8043": {"comment":"CRC bytes passed over"},
        "8049": {"comment":"Success"},
        "8050": {"synopsis":"Ends a card operation, AF kept: a byte clocked, the card deselected (port $E7 = $FF),\nanother byte clocked.","comment":"Keep the result"},
        "8051": {"comment":"Clock a byte"},
        "8053": {"comment":"Deselect"},
        "8058": {"comment":"Clock a byte"},
        "8062": {"synopsis":"Sends command $4C (CMD12, stop transmission) with argument 0 to card Z (0) / NZ (1), then\nSD_DESELECT.","comment":"CMD12: stop transmission"},
        "8069": {"synopsis":"Writes the 512 bytes at IX to address HLDE of card Z (0) / NZ (1): command $58 (CMD24, one\nblock), token $FE, the data through two OTIRs, $FF twice for the CRC; the data response must\nbe 5 (accepted); the busy time waited out; then command $4D (CMD13) reads the status, whose\nsecond byte must be 0.\nExit: Fc=1; Fc=0 A = 0 (rc_ready: command or response failed), 1 (rc_wp: status bit 0, 1 or\n5), 3 (rc_crc: other status bits). Ends through SD_DESELECT.","comment":"Keep the card choice"},
        "8070": {"comment":"CMD24: write one block"},
        "8075": {"comment":"Refused?"},
        "8077": {"comment":"Data token"},
        "8081": {"comment":"Port $EB"},
        "8084": {"comment":"HL = data"},
        "8087": {"comment":"512 bytes"},
        "8091": {"comment":"CRC bytes"},
        "8099": {"comment":"Data response"},
        "8102": {"comment":"Accepted (5)?"},
        "8108": {"synopsis":"Card busy while it reads 0.","comment":"Still busy?"},
        "8114": {"comment":"Card choice back"},
        "8115": {"comment":"CMD13: status"},
        "8122": {"comment":"Refused?"},
        "8124": {"comment":"Status, second byte"},
        "8126": {"comment":"0: all well"},
        "8130": {"comment":"Bit 0, 1 or 5?"},
        "8132": {"comment":"rc_wp"},
        "8136": {"comment":"rc_crc"},
        "8140": {"synopsis":"Failure before the status.","comment":"Drop the card choice"},
        "8141": {"synopsis":"Error 0 (rc_ready).","comment":"rc_ready"},
        "8144": {"synopsis":"Deselect and return."},
        "8146": {"synopsis":"Adds 1 to the 32-bit counter at IX + $2B (the volume's free-cluster count in range B's\nnotes).","comment":"Low byte"},
        "8162": {"synopsis":"A = IX + $21, the volume's sectors per cluster."},
        "8166": {"synopsis":"$00 filler up to $1FF2."},
        "8179": {"synopsis":"Sets CONMEM (port $E3 = $80, RAM bank 0), then returns through the automap-off area: the\nfetch at $1FF8 ends the automap while CONMEM keeps this ROM paged for the RET. AF kept. From\n$03EB and the RST $08 handler ($0549).","comment":"Keep AF"},
        "8180": {"comment":"CONMEM on, bank 0"},
        "8184": {"comment":"Fetch here ends the automap"},
        "8185": {"synopsis":"RET in the automap-off area ($1FF8-$1FFF): jumped to (from $0042, $0076, $0404, $045A,\nDIVMMC_RELEASE), it returns with the automapped DivMMC memory released after this fetch,\nwhen NextReg $BB bit 6 enables the area.","comment":"Return, automap off"},
        "8186": {"comment":"No reference from this ROM"},
        "8188": {"synopsis":"Interrupt exit from $00EB: HL and AF back, interrupts on, return; the fetch at $1FFC ends\nthe automap.","comment":"HL back"},
        "8189": {"comment":"AF back"},
        "8190": {"comment":"Interrupts on"}
      }
    }
  },
