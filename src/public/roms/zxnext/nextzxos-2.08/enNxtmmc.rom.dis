        "5540": {"comment":"512 or more to go?"},
        "5547": {"comment":"The whole sector"},
        "5550": {"comment":"Straight to the destination"},
        "5553": {"comment":"HL after it"},
        "5556": {"comment":"Error"},
        "5558": {"comment":"512 bytes done"},
        "5563": {"synopsis":"Through the cache: up to the sector's end, at most what is wanted.","comment":"The byte's address"},
