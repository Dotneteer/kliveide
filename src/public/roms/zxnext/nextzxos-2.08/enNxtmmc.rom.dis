        "5429": {"synopsis":"Not open that way: A = $1D.","comment":"rc_number"},
        "5433": {"synopsis":"At the end: A = $19.","comment":"rc_eof"},
        "5435": {"synopsis":"Carry clear.","comment":"Carry clear"},
        "5437": {"synopsis":"DOS_BYTE_WRITE (the vector at $014B): the byte C at handle A's pointer, the size grown\nwhen it is at the end (FILE_SIZE_GROW), the sector marked for writing ($08E2), the pointer\nmoved on.\nExit: carry set; or carry clear and A = the error ($1D when not open for writing).","comment":"The handle"},
        "5440": {"comment":"Open for writing?"},
        "5446": {"comment":"The byte kept"},
        "5447": {"comment":"The size grown"},
        "5450": {"comment":"The byte's address"},
