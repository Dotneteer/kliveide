        "6938": {"synopsis":"Next character.","comment":"Whole field?"},
        "6941": {"synopsis":"'*': the rest of the field skipped; Z.","comment":"Skip the rest"},
        "6945": {"synopsis":"Pattern ended: it stays on its $FF; the rest must be spaces.","comment":"Pattern back on its end"},
        "6946": {"synopsis":"Z when the B bytes at HL are spaces; NZ and A = 0 at the first that is not.","comment":"A space?"},
        "6950": {"comment":"A = 0, flags kept"},
        "6952": {"comment":"No: NZ"},
        "6956": {"synopsis":"Compares pattern character A with name character C in either case; a name character outside\n$20-$7E equals only '_' (DIR_ENTRY_GET shows it so).\nExit: Z equal, NZ not; a letter comes back in lower case."},
        "6957": {"comment":"Name character printable?"},
