        "7867": {"synopsis":"Read the block."},
        "7868": {"comment":"Read the block"},
        "7871": {"synopsis":"IX, DE and BC back.","comment":"Device record back"},
        "7876": {"synopsis":"Writes sector BCDE of the device at IX from HL, 512 bytes (SD_TRANSFER with A = $80).\nExit: Fc=1; Fc=0 A = error (2 rc_seek beyond the device; 0 rc_ready, 1 rc_wp or 3 rc_crc\nfrom SD_BLOCK_WRITE).","comment":"A = $80: write"},
        "7880": {"synopsis":"Sector BCDE of the device record at IX as a card address:\n1. Error 2 (rc_seek) when BCDE is above the device's size (+$07).\n2. The device's first sector (+$01) added.\n3. x 512 when bit 1 of +$10 is 0 (a card addressed in bytes).\nExit: Fc=1, HLDE = the address, Z for card 0 (+$10 bit 0 = 0), NZ card 1; Fc=0 A = 2.","comment":"HL = size, low word"},
        "7886": {"comment":"Minus the sector"},
        "7889": {"comment":"Size, high word"},
        "7895": {"comment":"Sector beyond the size?"},
