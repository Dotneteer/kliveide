        "6911": {"comment":"Rest of the field spaces?"},
        "6915": {"comment":"Then the extension"},
        "6917": {"synopsis":"Matches B characters of an 8.3 field at HL against the pattern at DE: '?' any character, '*'\nthe rest of the field; when the pattern ends, the field's rest must be spaces.\nExit: Z match; NZ none, A = the pattern character.","comment":"A = pattern character"},
        "6919": {"comment":"'*'?"},
