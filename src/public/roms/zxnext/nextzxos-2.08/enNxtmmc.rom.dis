        "5109": {"synopsis":"Sets the size of handle A to DE:HL (the vector at $0163); nothing else changes.\nExit: IY, IX = the handle (HANDLE_SELECT).","comment":"The handle"},
        "5112": {"comment":"Its size"},
        "5114": {"synopsis":"Moves handle IY's pointer on by 1; with a valid position (bit 6 of +$0F) the byte in the\nsector too, and at 512 the next sector ($0577 on the fields at +$10). At the chain's end\nthe position is marked not valid.\nExit: carry set; or carry clear and A = the error.","comment":"The pointer + 1"},
        "5132": {"synopsis":"The position, when valid.","comment":"A valid position?"},
        "5136": {"comment":"No: done"},
        "5138": {"comment":"The byte in the sector + 1"},
        "5145": {"comment":"512?"},
        "5150": {"comment":"Byte 0"},
        "5154": {"comment":"Next sector or cluster"},
        "5160": {"comment":"Done"},
        "5161": {"comment":"Position not valid"},
        "5165": {"comment":"The chain's end?"},
        "5167": {"comment":"No: carry clear"},
        "5170": {"comment":"Yes: carry"},
        "5172": {"synopsis":"Moves handle IY's pointer on by BC; with a valid position, the byte in the sector too,\n512 at a time into the next sector ($0577). A BC with bit 7 set, or the chain's end, marks\nthe position not valid.\nExit: carry set; or carry clear and A = the error.","comment":"The pointer + BC"},
        "5187": {"comment":"The carry to its high word"},
        "5195": {"synopsis":"The position, when valid.","comment":"A valid position?"},
        "5201": {"comment":"BC from $8000?"},
        "5205": {"comment":"The byte in the sector + BC"},
        "5218": {"synopsis":"HL = the byte in the sector: a whole sector past it?","comment":"512 or more?"},
        "5225": {"comment":"Less 512"},
        "5231": {"comment":"Next sector or cluster"},
        "5237": {"comment":"The chain's end?"},
        "5239": {"comment":"Again with the rest"},
        "5247": {"synopsis":"No next sector: carry set at the chain's end, clear on an error.","comment":"The chain's end?"},
        "5252": {"comment":"No: carry clear"},
        "5253": {"synopsis":"The position marked not valid.","comment":"Position not valid"},
        "5258": {"synopsis":"The card position of handle IY's pointer.\n1. A valid position (bit 6 of +$0F) is used as it is.\n2. Otherwise from the first cluster (+$1B; a file without one gets a new cluster, $05BF):\none link of the chain per cluster's bytes in the pointer, the chain extended ($063E)\npast its end; the rest gives the sector (+$10) and the byte (+$15); bit 6 set.\nExit: carry set, BCDE = the sector ($06C3), HL = the byte in it; or carry clear and A = the\nerror.","comment":"A valid position?"},
        "5264": {"comment":"BCDE = the first cluster"},
        "5266": {"comment":"A cluster?"},
        "5271": {"comment":"None: a new one"},
        "5275": {"comment":"As the first"},
        "5279": {"synopsis":"BCDE = the first cluster: the current one.","comment":"As the current one"},
        "5283": {"comment":"DE:HL = the pointer"},
        "5286": {"comment":"BC = 256 x sectors per cluster"},
        "5291": {"synopsis":"One cluster's bytes off the pointer, in two halves.","comment":"Half a cluster's bytes off"},
        "5296": {"comment":"None left?"},
        "5300": {"comment":"Borrow from the high word"},
        "5301": {"synopsis":"The second half.","comment":"The other half"},
        "5305": {"comment":"None left?"},
        "5309": {"comment":"Borrow"},
        "5310": {"synopsis":"A whole cluster passed: the next cluster of the chain.","comment":"A whole cluster: the next"},
        "5313": {"comment":"BCDE = the current cluster"},
        "5315": {"comment":"Its link"},
        "5320": {"comment":"A cluster?"},
        "5325": {"comment":"The chain's end: link a new one"},
        "5332": {"synopsis":"The new current cluster.","comment":"The current cluster"},
        "5341": {"synopsis":"An error: the stacked words dropped."},
        "5345": {"synopsis":"Back over two halves.","comment":"Both halves back"},
        "5346": {"synopsis":"Back over one half: HL = the byte in the cluster.","comment":"One half back"},
        "5347": {"comment":"Bytes per sector"},
