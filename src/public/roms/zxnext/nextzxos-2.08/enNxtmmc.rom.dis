        "7622": {"comment":"Success"},
        "7624": {"synopsis":"Change: the path resolved, its text stored for the drive (DRV_PATH_SAVE), the search record\nmade the drive's current directory (vector $0127, B = 2).","comment":"Keep the drive"},
        "7625": {"comment":"Resolve the path"},
        "7628": {"comment":"D = drive"},
        "7629": {"comment":"Failed?"},
        "7632": {"comment":"Store the text"},
