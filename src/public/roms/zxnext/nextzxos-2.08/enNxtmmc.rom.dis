        "4691": {"comment":"Its checksum"},
        "4692": {"comment":"The same?"},
        "4697": {"comment":"Where the text starts"},
        "4701": {"synopsis":"The part's characters added before the text; the next entry.","comment":"Its characters before it"},
        "4704": {"comment":"The new start"},
        "4710": {"synopsis":"The last part (first met): a new long name of A parts.","comment":"The parts"},
