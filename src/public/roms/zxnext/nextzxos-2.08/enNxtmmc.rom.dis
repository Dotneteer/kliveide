        "5373": {"comment":"The sector in it"},
        "5376": {"comment":"Its card sector"},
        "5379": {"comment":"HL = the byte"},
        "5386": {"synopsis":"HL = the address of the byte at handle IY's pointer, its sector read into the cache\n(FILE_POS_SECTOR, then $0832).\nExit: carry set; or carry clear and A = the error.","comment":"The sector and byte"},
        "5389": {"comment":"Error"},
