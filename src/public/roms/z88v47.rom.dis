        "3116": {"comment":"save buffer adr."},
        "3117": {"comment":"Send CRLF sequense"},
        "3128": {"comment":"A < 32?"},
        "3132": {"comment":"Yes, send ESC B HH sequense of byte..."},
        "3139": {"comment":"put byte to serial port"},
        "3142": {"comment":"(translate if instructed to)"},
        "3144": {"synopsis":"OZ source name: continue_send_buffer."},
