        "12004": {"comment":"Fc=0, it's VDU code"},
        "12006": {"synopsis":"Gives the character code of the user-defined character numbered in sbf_VDU1: the number is\ntaken modulo 64 with 128K or more RAM (codes $C0-$FF) and modulo 32 otherwise ($E0-$FF),\nchecked with Chk128KB, and complemented.\nOZ source name: GetUserDefinedChar.\nEntry: sbf_VDU1 = character number.\nExit: A = complement of the number ($C0-$FF).\nChanges: AF."},
        "12014": {"comment":"20-3F"},
        "12016": {"comment":"00-3F"},
        "12018": {"comment":"C0-FF, E0-FF for unexpanded"},
        "12020": {"synopsis":"define User Defined Character"},
