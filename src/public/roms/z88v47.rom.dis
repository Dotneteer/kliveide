        "7604": {"comment":"no mem? exit"},
        "7605": {"comment":"mark page as splitted"},
        "7609": {"comment":"point HL to page"},
        "7612": {"comment":"and bind it in"},
        "7615": {"comment":"first chunk at H01"},
        "7618": {"comment":"chunk size, 255 bytes"},
        "7621": {"comment":"no more chunks"},
