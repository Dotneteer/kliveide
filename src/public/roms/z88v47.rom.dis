        "7408": {"comment":"extension used?"},
        "7413": {"comment":"put filename into buffer"},
        "7417": {"comment":"had extension?"},
        "7419": {"comment":"no extension, add '.*'"},
        "7429": {"comment":"check for '.' or '..'"},
        "7432": {"comment":"had one or another? get default dir"},
