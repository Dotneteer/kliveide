        "4693": {"comment":"D = banks of file area"},
        "4694": {"comment":"slot C (of bank B)"},
        "4700": {"comment":"Bank number of header only within range of physical card"},
        "4701": {"comment":"AM29F010B/ST29F010B Flash Memory in slot C?"},
        "4704": {"comment":"yes, it's a 16K sector architecture Flash Memory"},
        "4708": {"comment":"D = total of 64K sectors (banks/4) to be erased..."},
        "4712": {"comment":"begin to erase top sector (bank of header/4), then downwards.."},
