        "2329": {"comment":"entryID"},
        "2332": {"comment":"no, loop"},
        "2340": {"synopsis":"Entry: A=length, B=pageID, C=entryID, HL=list, (Buffer)=data.\nExit: HL=entrydata, IX=saved data; Fc=1 if error.","comment":"length"},
        "2342": {"comment":"zero? skip allocate"},
