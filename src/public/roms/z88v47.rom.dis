        "10536": {"synopsis":"directory window"},
        "10541": {"comment":"pos=0, activate cmd window"},
        "10545": {"comment":"Mod(pos,3)=0, activate cmd window"},
        "10549": {"comment":"otherwise just move left"},
        "10553": {"comment":"activate cmd window"},
        "10556": {"comment":"command window"},
