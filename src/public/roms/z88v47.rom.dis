        "3242": {"comment":"number of character written in buffer"},
        "3245": {"comment":"null terminated string"},
        "3252": {"comment":"restore S1"},
        "3262": {"synopsis":"convert internal format date to zoned format\nEntry: ABC = internal date.\nExit: A=number of days in month, B = month (1 = Jan, 12 = Dec); C7-C5=day of week (1=Mon,\n7=Sun); C4-C0: day of month (1-31); DE=year.\nChanges: AF, BC, DE."},
        "3263": {"comment":"ABC -> ABCDE"},
        "3270": {"synopsis":"convert zoned, external format date to internal format\nEntry: B = month, C7-C5=weekday (0=unspecified), C4-C0: day of month; DE=year.\nExit: ABC = internal date.\nChanges: AF, BC."},
        "3272": {"comment":"BCDE -> ABC"},
        "3280": {"synopsis":"get the current machine system date in internal format\nEntry: DE=destination.\nExit: ABC=date (if DE<256), DE=DE+3 (if DE>255).\nChanges: AFBCD../....","comment":"time into BHL"},
        "3286": {"comment":"write to DE(in)"},
        "3290": {"synopsis":"get (read) machine system time in internal format\nEntry: C=least significant byte from GN_Gmd (optional); DE=destination.\nExit: ABC=time (if DE<256), DE=DE+3 (if DE>255); Fz=1 if C(in) is consistent with time.\nChanges: AF, BC, DE.","comment":"BHL=date, CDE=seconds, A=cseconds"},
