        "13925": {"comment":"flush RX buffer"},
        "13928": {"comment":"enable RDRF interrupts, disable DCD, CTS, TDRE interrupts"},
        "13938": {"comment":"enable UART interrupt"},
        "13947": {"synopsis":"Serial interface soft reset\n\nset default timeout\napply panel speed\nset autoTX acknoledge mode\nset UART interrupt"},
        "13950": {"comment":"default timeout 1 minute"},
