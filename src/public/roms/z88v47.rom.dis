        "2825": {"comment":"Fc = 0, File Eprom parsed..."},
        "2831": {"synopsis":"Add file space to current sum of active or deleted file space.\nEntry: Fz = File status (active or deleted); A = length of filename; CDE = length of file.\nExit: (Amount of active/deleted file space updated).","comment":"not a valid File Entry"},
        "2832": {"comment":"preserve Z80 status flags"},
