        "372": {"synopsis":"EP_Req interface:\nEntry: C = poll for file header in slot number 0, 1, 2 or 3.\nExit: BHL = pointer to File Header for slot C (B = absolute bank of slot).; (or pointer to\nfree space in potential new File Area).; C = size of File Eprom Area in 16K banks; Fz = 1,\nFile Header found; A = \"oz\" File Eprom sub type."},
        "376": {"comment":"return \"oz\" File Area sub type (if file header found)"},
        "379": {"comment":"return C = size of File Eprom Area in 16K banks"},
        "382": {"comment":"return D = size of physical card in 16K banks"},
        "385": {"comment":"return BHL = pointer to File Header for slot C (B = absolute bank of slot)"},
        "387": {"synopsis":"Fz = 0, no header found, F already 0 in (iy+OSFrame_F), otherwise header found.\nOZ source name: ozFileEprFindFile."},
        "388": {"comment":"ensure local DE (from caller) is in segment 1"},
        "392": {"comment":"get slot number (from caller)"},
        "395": {"comment":"DE pointer to filename (to search) - available in segment 1"},
        "401": {"synopsis":"OZ source name: end__ozFileEprFindFile.","comment":"return BHL = pointer to found File entry or pointer to free byte in File area"},
        "404": {"synopsis":"OZ source name: exit_ozFileEprFindFile."},
        "405": {"comment":"restore original s1 binding"},
        "407": {"synopsis":"Common exit of the OS_Epr calls (entry inside ozFileEprFind): returns BHL to the caller\nthrough PutOSFrame_BHL and, when Fz = 1, sets Fz in the caller's frame (ret_fz).\nEntry: BHL = value to return; Fz = 1 to return Fz = 1; IY = OS frame.\nExit: frame B, H, L set; frame Fz set when Fz = 1 (it is 0 by default).","comment":"return BHL = pointer to found File entry or pointer to free byte in File area"},
        "410": {"comment":"Fz = 0 is returned by default in OS_Epr interface..."},
        "411": {"comment":"return Fz = 1"},
        "416": {"synopsis":"OZ source name: ozFileEprFindFileAt."},
        "417": {"comment":"ensure local DE (from caller) is in segment 1"},
        "421": {"comment":"DE pointer to filename (to search) - available in segment 1"},
        "429": {"synopsis":"OZ source name: ozFileEprFirstFile."},
        "432": {"comment":"return BHL = pointer to first file entry in slot (B=00h-FFh, HL=0000h-3FFFh)."},
        "433": {"comment":"return Fz = 1, File Entry marked as deleted, otherwise active."},
        "435": {"synopsis":"OZ source name: ozFileEprPrevFile."},
        "438": {"comment":"return BHL = pointer to previous file entry in slot (B=00h-FFh, HL=0000h-3FFFh)."},
        "439": {"comment":"return Fz = 1, File Entry marked as deleted, otherwise active."},
        "441": {"synopsis":"OZ source name: ozFileEprNextFile.","comment":"return BHL = pointer to next file entry or first byte of empty space"},
        "444": {"comment":"return Fz = 1, File Entry marked as deleted, otherwise active."},
        "446": {"synopsis":"OZ source name: ozFileEprLastFile."},
        "449": {"comment":"return BHL = pointer to last file entry in slot (B=00h-FFh, HL=0000h-3FFFh)."},
        "450": {"comment":"return Fz = 1, File Entry marked as deleted, otherwise active."},
        "452": {"synopsis":"OZ source name: ozFileEprTotalSpace."},
        "456": {"comment":"return BHL = Amount of active file space in bytes (24bit integer, B = MSB)"},
        "459": {"comment":"return CDE = Amount of deleted file space in bytes (24bit integer, C = MSB)"},
        "462": {"synopsis":"OZ source name: ozFileEprActiveSpace."},
        "469": {"comment":"return DEBC = Active space (visible files) (DE=high, BC=low)"},
        "471": {"synopsis":"OZ source name: ozFileEprFreeSpace."},
        "475": {"comment":"return DEBC = Free space (DE=high, BC=low)"},
        "477": {"synopsis":"OZ source name: ozFileEprCntFiles."},
        "484": {"comment":"return HL = total of active files, DE = total of deleted files"},
        "487": {"synopsis":"OZ source name: ozFileEprFileStatus."},
        "491": {"comment":"return Fz status (if file entry is marked as deleted or not)"},
        "493": {"synopsis":"OZ source name: ozFileEprNewFileEntry."},
        "497": {"comment":"return BHL that is pointer to potential new file entry"},
        "499": {"synopsis":"OZ source name: ozFileEprFileSize."},
        "503": {"comment":"return file entry size in CDE"},
        "506": {"comment":"return File status (active/deleted) in Fz"},
        "508": {"synopsis":"OZ source name: ozFileEprFilename."},
        "512": {"comment":"return length of copied filename"},
        "515": {"comment":"return File status (active/deleted) in Fz"},
        "517": {"synopsis":"OZ source name: ozFileEprFileImage."},
        "521": {"comment":"return BHL that is pointer to file entry image (contents)"},
