        "13897": {"synopsis":"Serial interface hard reset\n\nreset UART in blink\nreset UART interrupt mask\nset 9600 baud speed in short word mode\nset UART interrupt"},
        "13898": {"comment":"no XON/XOFF, no parity"},
        "13902": {"comment":"ack all int (DCD, RTS)"},
        "13904": {"comment":"ack TDRE"},
        "13906": {"comment":"ack RDRF"},
        "13910": {"comment":"reset UART in blink"},
        "13915": {"comment":"set SHTW, invert RTS  @ 9600 baud"},
