        "8115": {"comment":"bind B"},
        "8126": {"comment":"ld iy, hl"},
        "8141": {"comment":"chain CDE to last DOR as brother DOR"},
        "8152": {"comment":"chain CDE to :APP.- Front DOR as son DOR"},
