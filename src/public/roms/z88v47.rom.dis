        "9979": {"comment":"Fc=0, unnecessary"},
        "9981": {"synopsis":"allocate all pages with filesystem blocks, add unused blocks\ninto filesystem chain"},
        "9982": {"comment":"MAT size in pages"},
        "9990": {"comment":"DE=FsPtr"},
        "9992": {"comment":"MAT start"},
        "9997": {"comment":"no fs blocks? skip"},
        "10002": {"comment":"check 4 blocks"},
        "10006": {"comment":"fs block used? skip"},
        "10008": {"comment":"make block available to file system"},
        "10019": {"comment":"allocate page for file system"},
        "10032": {"comment":"HL+=2, DE+=4, BC-=2"},
        "10040": {"comment":"no BC underflow? loop"},
        "10045": {"synopsis":"Mark RAM reserved for bad apps\nEntry: D=bank; B=first page to mark; C=number of pages to mark."},
        "10050": {"synopsis":"Mark RAM reserved for system\nEntry: D=bank; B=first page to mark; C=number of pages to mark."},
        "10054": {"comment":"preserve S2, it will be destroyed"},
        "10059": {"comment":"get current segment 2 binding in AF"},
        "10061": {"comment":"restore bc on entry"},
