        "9044": {"comment":"directory was opened!"},
        "9046": {"comment":"free dor handle"},
        "9050": {"comment":"return \"directory already created!\""},
        "9057": {"comment":"find null-terminator"},
        "9065": {"comment":"length of buffer + 6 (max. length 255 bytes)"},
