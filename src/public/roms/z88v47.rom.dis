        "5551": {"comment":"no ESC"},
        "5556": {"synopsis":"Table of the VT52 escape sequences the Terminal turns into screen codes: each record is the\nletter after ESC and the 0-terminated text written for it (A up, B down, C right, D left, H\nhome, I reverse line feed, J erase to the end of the screen, K erase to the end of the line,\nL clear); a 0 ends it.","comment":"ESC A - up"},
        "5559": {"comment":"ESC B - down"},
        "5562": {"comment":"ESC C - right"},
        "5565": {"comment":"ESC D - left"},
        "5568": {"comment":"ESC H - cursor home"},
        "5575": {"comment":"ESC I - reverse lf"},
        "5578": {"comment":"ESC J - erase EOS"},
        "5584": {"comment":"ESC K - erase EOL"},
        "5590": {"comment":"ESC L - clear screen"},
