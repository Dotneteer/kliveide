        "1990": {"synopsis":"Get explicit free memory in specified RAM/EPR card slot.\n\n(Unfortunately, this call is ambiguous if there is both\nRAM and EPR in the same slot - using a Rakewell Hybrid card -\nRAM is always picked first)\n\n<RamDeviceNumber> = \"0\", \"1\", \"2\", \"3\" or \"-\" (all)\n\nClient:      ESC \"M\" <RamDeviceNumber> ESC \"Z\"\n\nServer:      ESC \"N\" <FreeMemory>          (RAM device found, free memory in bytes)\nESC \"Z\"\nor\nESC \"Z\"                       (RAM device not found)","comment":"fetch RAM device number"},
        "1996": {"comment":"get RAM device number"},
        "2001": {"comment":"send global free space string"},
        "2003": {"comment":"A = slot no of RAM card"},
        "2012": {"comment":"RAM was found... return free space in DE = 256 byte pages.."},
        "2014": {"comment":"get device number for possible EPR device in slot"},
        "2017": {"comment":"File area in slot A?"},
        "2020": {"comment":"this slot had no file area (no card)..."},
        "2028": {"comment":"return Free space of File Area in DEBC"},
        "2033": {"synopsis":"Get Device Info of specified device name\nUsing :RAM.- total free memory & total RAM size is returned.\n\n<Devicename> = \":RAM.x\", \":RAM.-\" or \":EPR.x\" (slot 0 - 3, or :RAM.-)\n\nClient:      ESC \"O\" <Devicename> ESC \"Z\"\n\nServer:      ESC \"N\" <FreeMemory>          (Device found, free memory in bytes)\nESC \"N\" <Device size>         (Device found, size of device in K)\nESC \"Z\"\nor\nESC \"Z\"                       (Device not found)","comment":"fetch Device name"},
        "2039": {"comment":"Device is \":EPR.x\"?"},
        "2042": {"comment":"Yes, check if file area is available.."},
        "2044": {"comment":"Device is \":RAM.x\"?"},
        "2047": {"comment":"Fz = 0 -> not a RAM card either..."},
        "2052": {"comment":"return A = total RAM in 16K banks, DE = total free 256 byte pages"},
        "2063": {"comment":"return A = RAM.x card in 16K banks, DE = free 256 byte pages"},
