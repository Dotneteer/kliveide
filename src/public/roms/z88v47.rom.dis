        "4095": {"comment":"4 - NUL (write to the void)"},
        "4101": {"comment":"6 - stdin - write protected"},
        "4105": {"comment":"7 - write byte to standard output"},
        "4114": {"comment":"8 - direct printer filter"},
        "4117": {"comment":"in S2 binded by OSFramePush"},
        "4121": {"comment":"Signal error: Bad handle"},
