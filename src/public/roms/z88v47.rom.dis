        "5909": {"comment":"restore original contents of BC"},
        "5911": {"synopsis":"PCLINK II protocol\nSend ESC B HH sequence of byte in A, acknowledged.\nOZ source name: Send_ESC_byte_ackn."},
        "5916": {"comment":"send ESC"},
        "5923": {"comment":"send 'B'"},
        "5938": {"comment":"send high nibble in HEX of byte"},
        "5949": {"comment":"send low nibble in HEX of byte"},
        "5952": {"synopsis":"OZ source name: exit_Send_ESC_byte_ackn."},
        "5955": {"synopsis":"Converts a value 0 to 15 to its ASCII hex digit, '0' to '9' or 'A' to 'F'. This is the\nserial byte module's own copy, used by Send_ESC_byte_ackn.\nEntry: A = value (0 to 15).\nExit: A = ASCII hex digit.\nChanges: AF."},
        "5965": {"synopsis":"Sends ESC 'N' to the remote computer (Send_ESC_Resp).\nExit: Fc = 0, Fz = 0.\nError: Fc = 1 (serial port error).\nChanges: F.\nKeeps: A, BC, DE, HL."},
        "5974": {"synopsis":"Sends ESC 'Y' to the remote computer (Send_ESC_Resp).\nExit: Fc = 0, Fz = 0.\nError: Fc = 1 (serial port error).\nChanges: F.\nKeeps: A, BC, DE, HL."},
        "5983": {"synopsis":"Sends ESC 'Z' to the remote computer (Send_ESC_Resp).\nExit: Fc = 0, Fz = 0.\nError: Fc = 1 (serial port error).\nChanges: F.\nKeeps: A, BC, DE, HL."},
        "5992": {"synopsis":"Sends ESC 'E' to the remote computer (Send_ESC_Resp).\nExit: Fc = 0, Fz = 0.\nError: Fc = 1 (serial port error).\nChanges: F.\nKeeps: A, BC, DE, HL."},
        "6001": {"synopsis":"Sends ESC 'F' to the remote computer (Send_ESC_Resp).\nExit: Fc = 0, Fz = 0.\nError: Fc = 1 (serial port error).\nChanges: F.\nKeeps: A, BC, DE, HL."},
        "6010": {"synopsis":"Sends CR and LF to the remote computer (Send_ESC_Resp).\nExit: Fc = 0, Fz = 0.\nError: Fc = 1 (serial port error).\nChanges: F.\nKeeps: A, BC, DE, HL."},
        "6019": {"synopsis":"Sends an ESC byte in its encoded form, the four bytes ESC \"B1B\" (ESC_1B), untranslated.\nExit: Fc = 0, Fz = 0.\nError: Fc = 1 (serial port error).\nChanges: F.\nKeeps: A, BC, DE, HL."},
        "6033": {"synopsis":"Sends the 2-byte sequence at HL untranslated (SendStringRaw, OS_Si SI_PX), copying it to the\noutput log file when serial port logging is on.\nOZ source name: Send_ESC_Response.\nEntry: HL = sequence.\nExit: Fc = 0, Fz = 0.\nError: Fc = 1 (serial port error; A keeps its value).\nChanges: F.\nKeeps: A, BC, DE, HL."},
        "6042": {"synopsis":"Send ESC B HH sequence of byte in A, (EazyLink protocol level 8+).\n\n..BCDEHL/IXIY same\nAF....../.... different"},
        "6054": {"comment":"preserve a copy of byte to ESC B encode..."},
        "6083": {"synopsis":"Send sequense of bytes, non-modified\nHL points to sequence to transmit, BC = length\n\nA.BCDEHL/IXIY same\n.F....../.... different"},
        "6093": {"comment":"don't log serial port output"},
        "6095": {"comment":"B is DJNZ loop counter..."},
        "6097": {"comment":"dump to debugging serport output file"},
        "6103": {"comment":"length of sequence.."},
        "6104": {"comment":"DE points at sequence to send"},
        "6107": {"comment":"send bytes to serial port"},
        "6113": {"synopsis":"Send sequense of bytes (optionally translated if enabled)\nHL points to sequence to transmit, null-terminated.\n\nA.BCDEHL/IXIY same\n.F....../.... different"},
        "6115": {"comment":"HL >> sequence, 0 terminated..."},
        "6117": {"comment":"Fc = 0, find null=terminator"},
        "6121": {"comment":"max size of sequence is 255 bytes."},
        "6126": {"comment":"point at null-terminator"},
        "6134": {"comment":"no data to be sent..."},
        "6137": {"comment":"BC = length of string"},
        "6138": {"comment":"HL >> start of sequence"},
        "6140": {"comment":"B is DJNZ loop counter..."},
        "6145": {"comment":"skip, translation not enabled.."},
        "6148": {"comment":"A contains translated byte"},
        "6151": {"comment":"update block with translated byte"},
        "6156": {"comment":"dump to debugging serport output file (if enabled)"},
        "6162": {"comment":"length of sequence.."},
        "6163": {"comment":"DE points at sequence to send"},
        "6166": {"comment":"send bytes to serial port"},
        "6174": {"comment":"reset Z flag, FC = 0"},
        "6175": {"comment":"restore original contents of A"},
        "6176": {"comment":"restore original contents of BC"},
        "6177": {"comment":"restore original contents of DE"},
        "6178": {"comment":"restore original contents of HL"},
        "6180": {"comment":"save contents of F register"},
        "6183": {"comment":"restore F register"},
        "6184": {"comment":"restore original contents of A"},
        "6185": {"comment":"restore original contents of BC"},
        "6186": {"comment":"restore original contents of DE"},
        "6187": {"comment":"restore original contents of HL"},
        "6189": {"synopsis":"Transmit file buffer contents\nHandles CRLF conversion, XON/XOFF & ESC byte sequences\nEntry: BC = Buffer length; HL = Start of of buffer.\nExit: Fc = 1, general transmit error (timeout, etc); Fc = 0, Buffer transmitted succesfully.","comment":"if file contents is binary, disable trans + CrLf conversion (then continue send)"},
        "6193": {"comment":"remember start of block"},
        "6194": {"comment":"fetch byte from buffer"},
        "6195": {"comment":"ESC?"},
        "6203": {"comment":"send ESC B 1B sequense for ESC"},
        "6209": {"comment":"XON?"},
        "6223": {"comment":"XOFF?"},
        "6227": {"comment":"CR?"},
        "6231": {"comment":"extended to CRLF?"},
        "6235": {"comment":"no!"},
        "6247": {"comment":"character translation?"},
        "6254": {"comment":"update block with translated byte (if enabled)"},
        "6261": {"synopsis":"Sends the run of buffer bytes before a byte that needs special handling. SendFileBuffer\ncalls it before it sends an escape, CRLF or ESC B HH sequence, and falls into it after the\nlast byte to send the rest. Nothing is sent when the run is empty.\nEntry: DE = start of the run; HL = position of the byte that ends it; Fc = 0.\nExit: Fc = 0; DE = HL + 1, the start of the next run.\nError: Fc = 1 (serial port error).\nChanges: F, DE.\nKeeps: A, BC, HL."},
        "6266": {"comment":"Fz = 1 (Fc = 0) if there is no block to send..."},
        "6269": {"comment":"BC = total bytes in sub-block"},
        "6270": {"comment":"HL = start of sub-block"},
        "6271": {"comment":"only transmit sub-block if BC > 0"},
        "6275": {"comment":"DE points at beginning of new sub-block (byte after terminator)"},
        "6278": {"comment":"restore original A (the terminator)"},
        "6281": {"synopsis":"Fetch sequense of bytes from terminal, ESC terminated.\nAll bytes received will also be dumped to debugging serial port file, optionally.\nHL points to buffer that will be filled from remote, max BC bytes\n\nReturns Fz = 1, A = ESC terminator\nReturns BC = length of block fetched\nReceived block is null-terminated.\n\n....DEHL/IXIY same\nAFBC..../.... different"},
        "6284": {"comment":"DE = pointer to buffer"},
        "6287": {"comment":"receive block of data, ESC terminated"},
        "6290": {"comment":"preserve Fc/z status..."},
        "6291": {"comment":"null-terminate received block (always)"},
        "6297": {"comment":"BC = total bytes received in buffer"},
        "6299": {"comment":"return pointer to start of received Block"},
        "6300": {"comment":"restore original contents of DE"},
        "6302": {"synopsis":"OZ source name: TranslateIncomingBlock.\nEntry: BC = Buffer length; HL = Start of of buffer.\nChanges: none.\nKeeps: AF, BC, DE, HL, IX, IY.","comment":"CRLF conversion or Translation enabled, check block for binary data"},
        "6307": {"comment":"end of buffer reached, no binary data discovered.."},
        "6322": {"synopsis":"Multi-fetch ESC sequence or just single byte, translated (if enabled).\n\nReturns:\nFc = 1, A = RC_xxx, serial port error (typically timeout)\n\nWhen [Serial port] -> X (any byte, no ESC id):\nA = X, Fz = 1, Fc = 0\n\nWhen [Serial port] -> ESC ESC (just ESC byte but not ESC id):\nA = ESC, Fz = 1, Fc = 0\n\nWhen [Serial port] -> ESC B HH (receive 'binary' byte):\nA = encoded byte, Fz = 1, Fc = 0\n\nWhen [Serial port] -> ESC X (ESC id):\nA = ESC Id, Fz = Fc = 0\nChanges: AF, B.\nKeeps: C, DE, HL, IX, IY.","comment":"byte in A."},
        "6325": {"comment":"serial port error or timeout"},
        "6330": {"comment":"Indicate Fc = 0, Fz = 1 (normal byte)"},
        "6332": {"comment":"byte in A."},
        "6335": {"comment":"serial port error or timeout"},
        "6336": {"comment":"is it a ESC ESC sequense ?"},
        "6338": {"comment":"Yes, return as ESC (Fz = 1, normal byte)"},
        "6339": {"comment":"ESC B HH sequence?"},
        "6341": {"comment":"Yes, ESC B HH sequense..."},
        "6343": {"comment":"Ensure Fc = 0 (no error) and Fz = 0"},
        "6344": {"comment":"(an ESC Id is also never a 0 byte)"},
        "6345": {"synopsis":"Entry inside FetchBytes, after ESC 'B': receives the two ASCII hex digits of an encoded byte\n(RxByte) and combines them.\nExit: A = byte; Fc = 0, Fz = 1 (a normal byte).\nError: Fc = 1, A = error code (serial port error or timeout).\nChanges: AF, B.","comment":"Yes, ESC B HH sequense..."},
        "6348": {"comment":"serial port error or timeout"},
        "6349": {"comment":"convert Ascii hex nibble into integer"},
        "6356": {"comment":"serial port error or timeout"},
        "6357": {"comment":"calculate second 4 bit nibble"},
        "6360": {"comment":"'binary' byte received."},
        "6361": {"comment":"return as normal byte (Fc = 0, Fz = 1)"},
        "6363": {"synopsis":"Receive file stream via protocol level 9 to RAM file\n(CRLF conversion is handled by client, before CRC-block is sent)\nOZ source name: FetchRamFileCrcBlock.","comment":"file reception is now enabled through Protocol level 9"},
        "6367": {"synopsis":"OZ source name: receive_crcblock_loop.","comment":"receive approx 128 bytes, but never more than 256 bytes..."},
        "6376": {"comment":"error or timeout - communication stopped"},
        "6378": {"comment":"block was not ESC terminated!"},
        "6380": {"comment":"fetched an ESC id, should be ESC 'N'... (total size of block stored)"},
        "6384": {"comment":"CRC-16 of received block in DE"},
        "6389": {"comment":"ESC 'N' was expected - protocol error..."},
        "6396": {"comment":"fetch 4 bytes of Ascii CRC-16 to validate received block..."},
        "6399": {"comment":"error or timeout - communication stopped"},
        "6401": {"comment":"sub-block was not ESC terminated!"},
        "6405": {"comment":"ESC ']' was expected, protocol error"},
        "6407": {"comment":"convert Ascii CRC-16 at (ScratchBuffer) to integer, return in HL"},
        "6410": {"comment":"CRC-16 match?"},
        "6412": {"comment":"Yes"},
        "6414": {"comment":"less max retries..."},
        "6417": {"comment":"respond with ESC Z to terminal to re-send block"},
        "6420": {"comment":"A = ']'"},
        "6421": {"comment":"timeout, terminal didn't fetch the acknowledge"},
        "6423": {"synopsis":"OZ source name: signal_received_block."},
        "6434": {"comment":"no need to check binary file validation, trans + crlf is already OFF..."},
        "6437": {"comment":"flush successfully received block to RAM file..."},
        "6442": {"comment":"signal I/O error / No Room to Terminal"},
        "6447": {"comment":"reset to max CRC-block retries for new block"},
        "6451": {"comment":"and respond with ESC Y to terminal to acknowledge"},
        "6455": {"synopsis":"OZ source name: crcblock_aborted.","comment":"ignore return address of this call to abort file reception"},
        "6458": {"synopsis":"Receive file stream from remote to RAM file\n1) receive file through byte I/O and buffer, or\n2) block CRC-16 I/O (protocol level 9)","comment":"initial buffer ready"},
        "6461": {"comment":"file reception is by default old protocol"},
        "6465": {"comment":"CRC-block retries"},
        "6469": {"synopsis":"receive file through byte-fetch I/O, using buffer\nOZ source name: receive_file_loop."},
        "6472": {"comment":"serial port error or timeout - communication stopped"},
        "6474": {"comment":"received byte to file"},
        "6478": {"comment":"ESC '[', protocol level 9 CRC-16 data block is being sent..."},
        "6483": {"comment":"ESC ']', CRC-block completed, get another block or wait for EOF.."},
        "6485": {"comment":"ESC 'E', EOF?"},
        "6491": {"synopsis":"OZ source name: check_crcblock_tries."},
        "6499": {"synopsis":"byte in A to file...","comment":"file reception is by default std protocol"},
        "6503": {"comment":"we're in Protocol level 9, skip any noise because of Blink UART"},
        "6505": {"comment":"is it a line feed?"},
        "6507": {"comment":"Yes, ignore LF (reverse CRLF) and fetch next byte..."},
        "6513": {"comment":"LF conversion active - ignore LF (reverse CRLF) and fetch next byte..."},
        "6515": {"synopsis":"OZ source name: no_linefeed.","comment":"put byte into buffer"},
        "6518": {"comment":"write error - memory full"},
        "6520": {"comment":"fetch next byte from serial port"},
        "6531": {"comment":"save contents of buffer..."},
        "6537": {"synopsis":"Generate CRC-16 of received CRC-block\nEntry: HL = point to buffer; C = size of buffer.\nExit: DE = updated CRC-16."},
        "6538": {"comment":"Reset to initial CRC-16 checksum"},
        "6543": {"comment":"iterate over buffer to update CRC-16 in DE..."},
        "6551": {"synopsis":"Update CRC-16 checksum\nImplemented by Dennis GrÃ¶ning (part of XY-modem)\n\nTest cases:\nDE = initial 0x0000, \"123456789\" generates 0x31C3 CRC-CCITT (XModem)\nDE = initial 0xFFFF, \"123456789\" generates 0x29B1 CRC-CCITT (0xFFFF)\nEntry: A = byte to update current CRC-16; DE = current CRC-16.\nExit: DE = updated CRC-16.\nChanges: AF, DE.\nKeeps: BC, HL, IX, IY."},
        "6588": {"synopsis":"Retrieve the 4 Ascii charecters of CRC-16 at (HL) and convert them to int\nEntry: HL = pointer to CRC16 (high-byte, low-byte order).\nExit: HL = CRC-16 (16bit integer)."},
        "6590": {"comment":"Hex Nibbles of High byte in A"},
        "6594": {"comment":"Hex Nibbles of low byte in A"},
        "6598": {"comment":"return HL = CRC-16"},
        "6602": {"synopsis":"Convert Ascii Hex byte at (HL), high byte - low byte order, to int in A"},
        "6604": {"comment":"convert Ascii hex nibble into integer"},
        "6610": {"comment":"calculate second 4 bit nibble"},
        "6615": {"synopsis":"Converts an ASCII hex digit to its value in the high nibble (ConvAscHexNibble, times 16).\nOZ source name: ConvAsciiHexHighNibble.\nEntry: A = '0' to '9' or 'A' to 'F'.\nExit: A = value * 16.\nChanges: AF.","comment":"convert Ascii hex nibble into integer"},
        "6621": {"comment":"first hex nibble * 16"},
        "6623": {"synopsis":"Converts an ASCII hex digit to its value: digits above '9' are taken as 'A' to 'F' (upper\ncase only).\nOZ source name: ConvAsciiHexNibble.\nEntry: A = '0' to '9' or 'A' to 'F'.\nExit: A = 0 to 15.\nChanges: AF.","comment":"digit >= \"a\"?"},
        "6625": {"comment":"digit is in interval \"a\" - \"f\""},
        "6627": {"comment":"digit is in interval \"0\" - \"9\""},
        "6633": {"synopsis":"if file buffer contents is binary, disable trans + CrLf conversion\n(if translation is already turned off, this routine exits immediately)\nEntry: BC = Buffer length; HL = Start of of buffer.\nExit: BB_LnfdConv,(IX + rtmflags) = 0, if file (buffer) contents is binary; BB_CharTrans,(IX\n+ rtmflags) = 0, if file (buffer) contents is binary.\nChanges: F.\nKeeps: A, BC, DE, HL, IX, IY."},
        "6643": {"comment":"no need to check binary file validation, trans + crlf is already OFF..."},
        "6644": {"synopsis":"OZ source name: init_validate_buf.","comment":"CRLF conversion or Translation enabled, check block for binary data"},
        "6649": {"comment":"end of buffer reached, no binary data discovered.."},
        "6656": {"comment":"buf[i] >= 32 (ascii)"},
        "6660": {"comment":"buf[i] = CR (ascii)"},
        "6662": {"comment":"13 < buf[i] < 32 (binary)"},
        "6666": {"comment":"buf[i] = LF (ascii)"},
        "6670": {"comment":"buf[i] = TAB (ascii)"},
        "6672": {"comment":"everything else is regarded as binary data, disable conversion + translation"},
        "6684": {"synopsis":"Load translation byte pairs [<in>,<out>] from file 'Translate,dat'\nIf file is not present in filing system, use the standard Z88 - IBM table."},
        "6686": {"comment":"if ':RAM.0/Translates' file is not"},
        "6687": {"comment":"found, ISO-IBM internal is instal-"},
        "6689": {"comment":"led from internal table."},
        "6692": {"comment":"open Std. Translations file"},
        "6695": {"comment":"not found or 'in use'..."},
        "6700": {"comment":"byte in A"},
        "6705": {"comment":"Value1"},
        "6711": {"comment":"Value2"},
        "6728": {"synopsis":"OZ source name: end_LoadTranslations."},
        "6732": {"synopsis":"Installs the built-in translation tables: copies the 512 bytes at IBM_TraTableIn over\nTraTableIn and TraTableOut, and writes \"Using ISO translations\" to the log window.\nOZ source name: Use_StdTranslations.\nChanges: BC, DE, HL.\nKeeps: AF."},
        "6733": {"comment":"size of complete translation table"},
        "6739": {"comment":"copy IBM table..."},
        "6752": {"synopsis":"Installs one translation pair read from the translation file: TraTableIn(D) = E and\nTraTableOut(E) = D.\nEntry: D = Z88 byte; E = byte on the remote computer.\nChanges: F.\nKeeps: BC, HL.","comment":"Install byte in tra-table..."},
        "6754": {"comment":"D = value1"},
        "6756": {"comment":"E = value2"},
        "6761": {"comment":"TraTable_in(Value1) = Value2"},
        "6767": {"comment":"TraTable_out(Value2) = Value1"},
        "6771": {"synopsis":"Reads the next byte of the open file ((file_handle)) with OS_Gb, unless the file is at its\nend (OS_Frm FA_EOF).\nEntry: (file_handle) = open file.\nExit: Fz = 0, A = byte; Fz = 1 at end of file.\nChanges: AF.\nKeeps: DE, IX."},
        "6790": {"synopsis":"HL points at filename, A = wildcard search specifier\nprocedure return Fc = 1 if no handle was available, otherwise 0 for success\n(wildcard_handle) contains handle for filename..."},
        "6796": {"comment":"open wildcard handler."},
        "6801": {"comment":"save handle for later use."},
        "6805": {"synopsis":"OZ source name: exit_Get_wcard_handle."},
        "6810": {"synopsis":"Find next file match from wildcard search handle...\nC = file length, A = File type\n(DE) contains found filename"},
        "6813": {"comment":"exit loop when last name have been"},
        "6817": {"comment":"processed."},
        "6820": {"comment":"maximum length of found filename."},
        "6822": {"comment":"fetch next file name ..."},
        "6829": {"synopsis":"Releases the wildcard handler held in (wildcard_handle) with GN_Wcl.\nOZ source name: Close_wcard_handler.\nKeeps: AF, IX."},
        "6836": {"comment":"release handle."},
        "6843": {"synopsis":"Abandons the file being received: closes it (Close_file) and deletes the file named in\nfilename_buffer with GN_Del.\nKeeps: AF, BC, HL."},
        "6861": {"synopsis":"Puts a byte into the file buffer and counts it ((buffer), (buflen)). When the buffer holds\n1280 bytes it is written to the file with Flush_buffer.\nEntry: A = byte.\nExit: Fc = 0.\nError: Fc = 1 when a full buffer could not be written.\nChanges: F, HL.\nKeeps: A, BC."},
        "6862": {"comment":"entry of buffer"},
        "6865": {"comment":"put byte into buffer"},
        "6867": {"comment":"save adr of next entry into buffer"},
        "6870": {"comment":"current size of buffer"},
        "6873": {"comment":"updated with new byte"},
        "6874": {"comment":"save back new buffer length"},
        "6881": {"comment":"is buffer full?"},
        "6885": {"comment":"Yes, write to file..."},
        "6889": {"comment":"return, fetch next byte..."},
        "6891": {"comment":"Fc = 0, byte written successfully to buffer"},
        "6893": {"synopsis":"Writes the (buflen) bytes of file_buffer to the open file ((file_handle)) with OS_Mv, when\nthere are any, then falls into Reset_buffer_ptrs, which empties the buffer.\nExit: Fc = 0; (buffer) = file_buffer; (buflen) = 0.\nError: Fc = 1 from OS_Mv (A keeps its value, not an error code).\nChanges: F, HL (HL = the AF value on entry).\nKeeps: A, BC, DE, IX."},
        "6902": {"comment":"nothing to flush..."},
        "6912": {"comment":"Also called directly if EOF before"},
        "6916": {"comment":"write buffer to file."},
        "6924": {"synopsis":"JP   Reset_buffer_ptrs           ; C detection in calling program\nOZ source name: Reset_buffer_ptrs."},
        "6939": {"synopsis":"Reads up to 1280 bytes of the open file ((file_handle)) into file_buffer with OS_Mv and\nstores the number read in (buflen). Nothing is read at end of file.\nExit: Fc = 0, Fz = 0; (buflen) = bytes read.\nError: Fc = 1 (OS_Frm error); Fz = 1 at end of file; an OS_Mv error is not reported.\nChanges: AF, BC, DE, HL.\nKeeps: IX."},
        "6949": {"comment":"I/O error"},
        "6951": {"comment":"EOF"},
        "6969": {"comment":"actual length of buffer"},
        "6975": {"synopsis":"Opens a file with GN_Opf (explicit name buffer of 128 bytes) and keeps its handle in\n(file_handle).\nEntry: A = open mode (OP_xxx); HL = filename; DE = buffer for the explicit filename.\nExit: Fc = 0; (file_handle) = handle; DE = end of the explicit name; B = segments, C =\ncharacters in the name.\nError: Fc = 1, A = error code (RC_xxx).\nChanges: AF, BC, DE.\nKeeps: HL, IX.","comment":"HL = local pointer to filename, C = buffer length"},
        "6980": {"comment":"IX = handle for file."},
        "6989": {"synopsis":"OZ source name: end_Get_file_handle."},
        "6992": {"synopsis":"Reads the size of the open file ((file_handle)) with OS_Frm FA_EXT and stores it as a 32-bit\nvalue at (File_ptr), low word first.\nExit: (File_ptr) = file size; DEBC = file size.\nChanges: AF, BC, DE.\nKeeps: IX."},
        "7003": {"comment":"get size of file"},
        "7009": {"comment":"low byte, high byte sequense"},
        "7016": {"synopsis":"Closes the open file with GN_Cl and clears (file_handle). Does nothing when (file_handle) is\n0, so it can be called after an error.\nKeeps: AF, HL, IX.","comment":"save F register flags"},
        "7018": {"comment":"(could be called if error occurres"},
        "7023": {"comment":"no file to close..."},
        "7044": {"synopsis":"Get CRC-32 of file (RAM or File Card)\n\nClient:      ESC \"i\" <Filename> ESC \"Z\"\n\nServer:      ESC \"N\" <CRC32> ESC \"Z\"  (File found)\nESC \"Z\"                  (File not found)"},
        "7047": {"comment":"load filename into filename_buffer"},
        "7055": {"comment":"Path begins with \":EPR.x\"?"},
        "7058": {"comment":"Yes, try to get CRC-32 of file in File Area..."},
        "7060": {"comment":"open file for transfer..."},
        "7063": {"comment":"(explicit filename overwrite original fname)"},
        "7064": {"comment":"open file"},
        "7067": {"comment":"ups, file not available"},
        "7072": {"comment":"close file"},
        "7075": {"comment":"low word of CRC-32"},
        "7079": {"comment":"high word of CRC-32"},
        "7083": {"comment":"convert 32bit integer"},
        "7086": {"comment":"to an ASCII string"},
        "7097": {"comment":"write File CRC-32 as ASCII string to Client"},
        "7105": {"synopsis":"OZ source name: file_not_found."},
        "7120": {"comment":"this slot had no file area (no card)..."},
        "7122": {"comment":"this slot had no file area (card, but no file area)"},
        "7124": {"comment":"search for filename beginning at \"/\" in filea area of slot C"},
        "7129": {"comment":"search for filename on file eprom..."},
        "7132": {"comment":"this slot had no file area (no card)..."},
        "7134": {"comment":"File Entry was not found..."},
        "7136": {"comment":"return CRC in DEBC"},
        "7141": {"synopsis":"Perform a CRC-32 of RAM file, already opened by caller, from current file pointer until EOF.\nIf the complete file is to be CRC'ed then it is vital that the current file pointer\nis at the beginning of the file (use FA_PTR / OS_FWM to reset file pointer) before\nexecuting this routine.\nEntry: None.\nExit: Fc = 0,; DEBC = CRC.\nChanges: AF, BC, DE, HL.\nKeeps: IX, IY."},
        "7149": {"comment":"use buffer"},
        "7155": {"comment":"Use FFFFFFFFh as initial Crc-32"},
        "7158": {"comment":"get CRC-32 of Open file (with buffer)"},
        "7164": {"synopsis":"Standard Z88 File Eprom Format.\n\nGenerate CRC-32 of file entry in file area.\n\nDesign & Programming by Gunther Strube, June 2012\nEntry: BHL = pointer to file entry to be CRC-32 scanned.\nExit: Fc = 0,; DEBC = CRC-32; Fc = 1,; File Entry at BHL was not found.; A = RC_Onf.\nChanges: AF, BC, DE, HL, IX, AF', BC', DE', HL'.\nKeeps: IY."},
        "7166": {"comment":"Use FFFFFFFFh as initial Crc-32"},
        "7169": {"comment":"get CRC-32 of File Entry"},
        "7173": {"synopsis":"Convert 32bit integer at (HL) to hexadecimal string at (DE)\nInteger is in low byte, high byte order"},
        "7182": {"comment":"DE points a null-terminator"},
        "7183": {"comment":"ready for first nibble of lowest byte of 32bit integer"},
        "7184": {"comment":"32bit integer is 4 bytes"},
        "7206": {"comment":"get ready for next byte of 32bit integer.."},
        "7210": {"synopsis":"Converts a value 0 to 15 to its ASCII hex digit, '0' to '9' or 'A' to 'F'. This is the\nCRC-32 module's copy, the one other modules call (Send_ESC_B).\nOZ source name: HexNibble.\nEntry: A = value (0 to 15).\nExit: A = ASCII hex digit.\nChanges: AF."},
        "7220": {"synopsis":"***                      Static definitions; device & filenames, messages, etc.                        **"},
        "7227": {"synopsis":"The name of the translation file LoadTranslations reads, \":*//Translate.dat\",\nnull-terminated."},
        "7245": {"synopsis":"The wildcard name of the RAM devices, \":RAM.*\", null-terminated."},
        "7252": {"synopsis":"The text \":EPR.\" without a terminator: EprDev_name copies its 5 bytes and appends the slot\ndigit."},
        "7257": {"synopsis":"The name of the serial port input log file, \"/rs232rcv.log\", null-terminated (created in the\ndefault RAM device).","comment":"create files in default RAM device"},
        "7271": {"synopsis":"The name of the serial port output log file, \"/rs232snd.log\", null-terminated."},
        "7285": {"synopsis":"The message \"Serial port logging \", led by the sequence 1, \"2H3\" that selects window 3,\nnull-terminated. msg_serdump_on or msg_serdump_off follows it on screen."},
        "7310": {"synopsis":"The message \"enabled\", null-terminated.\nOZ source name: msg_serdmpfile_enable."},
        "7318": {"synopsis":"The message \"disabled\", null-terminated.\nOZ source name: msg_serdmpfile_disable."},
        "7327": {"synopsis":"Two bytes: the start (5) and end (6) bytes of the PCLINK II synch sequence, read by\nFetch_synch."},
        "7329": {"synopsis":"Two bytes: the start (1) and end (2) bytes of the EazyLink extended protocol synch sequence,\nread by Fetch_synch."},
        "7331": {"synopsis":"The title \"EazyLink\", null-terminated, of the log window (LogWinDef)."},
        "7340": {"synopsis":"The title \"Commands\", null-terminated, of the command window (CmdWinDef)."},
        "7349": {"synopsis":"The message \"Running\", null-terminated."},
        "7357": {"synopsis":"The message \"Waiting...\", null-terminated, shown on a serial port timeout."},
        "7368": {"synopsis":"The message \"Hello\", null-terminated."},
        "7374": {"synopsis":"The message \"Receive files\", null-terminated."},
        "7388": {"synopsis":"The message \"Send file\", null-terminated."},
        "7398": {"synopsis":"The message \"Auto Translation ON\", null-terminated."},
        "7418": {"synopsis":"The message \"Auto Translation OFF\", null-terminated."},
        "7439": {"synopsis":"The message \"Auto CRLF ON\", null-terminated."},
        "7452": {"synopsis":"Zero-terminated message \"Auto CRLF OFF\", written to the log window by ESC_C_cmd2 when the\nclient switches off automatic CRLF conversion (ESC \"C\")."},
        "7466": {"synopsis":"Zero-terminated message \"Receive Files\", written to the log window by ImpExp_Receive (ESC\n\"b\")."},
        "7480": {"synopsis":"Zero-terminated message \"Send Files\", written to the log window by ImpExp_Send (ESC \"s\")."},
        "7491": {"synopsis":"Zero-terminated message \"Backup Files\", written to the log window by ImpExp_Backup (ESC\n\"k\")."},
        "7504": {"synopsis":"Zero-terminated message \"Sending \", printed before each file name while ImpExp_Send sends a\nbatch of RAM files or a file area entry."},
        "7513": {"synopsis":"Zero-terminated message \"Scanning directories...\", written by ImpExp_Backup before it\ncollects the directories of all RAM devices."},
        "7537": {"synopsis":"Zero-terminated message \"Using file translations\", written by LoadTranslations after it has\ninstalled the byte pairs of the translation file."},
        "7561": {"synopsis":"Zero-terminated message \"Using ISO translations\", written by Use_StdTranslations after it\nhas copied the built-in IBM tables into the translation tables."},
        "7584": {"synopsis":"Zero-terminated message \"Update Translation Table\", written by ESC_Z_cmd before it reloads\nthe translation file."},
        "7609": {"synopsis":"Zero-terminated message \"Delete file/dir \", written by ESC_R_cmd before the name it deletes."},
        "7626": {"synopsis":"Zero-terminated message \"Create dir \", written by ESC_Y_cmd before the directory it creates."},
        "7638": {"synopsis":"Zero-terminated message \"Rename file \", written by ESC_W_cmd before the file it renames."},
        "7651": {"synopsis":"Zero-terminated message \"Set Z88 Clock\", written by ESC_p_cmd (ESC \"p\") when the client sets\nthe system clock."},
        "7665": {"synopsis":"Zero-terminated message \"Using Xon/Xoff\", written by UseSoftwareHandshaking."},
        "7680": {"synopsis":"Zero-terminated message \"Using RTS/CTS\", written by UseHardwareHandshaking."},
        "7694": {"synopsis":"Zero-terminated message \"File received\", printed in the log window by Msg_file_received,\nfollowed by the elapsed time."},
        "7708": {"synopsis":"Zero-terminated message \"Change to 38.400bps\", written by ESC_L_cmd before it switches the\nserial port to 38400 baud."},
        "7728": {"synopsis":"Zero-terminated message \"File sent\", printed in the log window by Msg_file_sent, followed by\nthe elapsed time."},
        "7738": {"synopsis":"Zero-terminated message \"Escape pressed....\"; no EazyLink code loads its address."},
        "7757": {"synopsis":"Zero-terminated message \"File open error.\", written by Msg_File_open_error."},
        "7774": {"synopsis":"Zero-terminated message \"- command aborted...\", written by Msg_Command_aborted."},
        "7795": {"synopsis":"Zero-terminated message \"Protocol error: Unknown ESC command.\", written by\nMsg_Protocol_error."},
        "7832": {"synopsis":"Zero-terminated message \"File aborted.\", written by Msg_file_aborted."},
        "7846": {"synopsis":"Zero-terminated message \"No Room.\", written by Msg_No_Room."},
        "7855": {"synopsis":"Zero-terminated message \"File Card Write Error.\", written when a received file cannot be\nwritten to a file card."},
        "7878": {"synopsis":"Zero-terminated protocol response ESC \"Z\", sent by Send_ESC_Z: the end of a list of names or\nfiles."},
        "7881": {"synopsis":"Zero-terminated protocol response ESC \"F\", sent by Send_ESC_F."},
        "7884": {"synopsis":"Zero-terminated protocol response ESC \"E\", sent by Send_ESC_E."},
        "7887": {"synopsis":"Zero-terminated protocol response ESC \"N\", sent by Send_ESC_N before a name."},
        "7890": {"synopsis":"Zero-terminated protocol response ESC \"Y\", sent by Send_ESC_Y as the acknowledgement of a\ncommand (ESC_A_cmd1 answers the PCLINK II 'Hello' with it)."},
        "7893": {"synopsis":"Zero-terminated protocol response ESC \"B\"; blockio.asm imports it, but no instruction loads\nits address."},
        "7896": {"synopsis":"Zero-terminated protocol response ESC ESC; blockio.asm imports it, but no instruction loads\nits address."},
        "7899": {"synopsis":"The 4 bytes ESC \"B1B\" (zero-terminated): the escaped form of an ESC byte in the data stream,\nsent by Send_ESC."},
        "7904": {"synopsis":"Zero-terminated CR, LF pair, sent by Send_CRLF."},
        "7907": {"synopsis":"Zero-terminated ESC \"N\" \".\": the current directory entry that ESC_D_cmd2 and the PCLINK II\ndirectory command send first in a directory list."},
        "7911": {"synopsis":"Zero-terminated ESC \"N\" \"..\": the parent directory entry sent after Current_dir when the\npath is below the root."},
        "7916": {"synopsis":"Word 9600: the default transmit and receive baud rate that Define_PanelSettings installs\nwith OS_Sp (PA_Txb, PA_Rxb).","comment":"Default Values to be installed in Receive & Transmit Baud Rate"},
        "7918": {"synopsis":"Word 38400: the transmit and receive baud rate that ESC_L_cmd installs with OS_Sp when the\nclient asks for light speed (ESC \"L\").","comment":"Light speed values to be installed in Receive & Transmit Baud Rate"},
        "7920": {"synopsis":"Byte 'N': the Panel value given to OS_Sp for parity none (PA_Par) and for Xon/Xoff off\n(PA_Xon)."},
        "7921": {"synopsis":"Byte 'Y': the Panel value given to OS_Sp for Xon/Xoff on (PA_Xon) by\nSetPanel_SoftwareHandshaking."},
        "7922": {"synopsis":"Lookup table of commands available.\n(total of EazyLink commands identifiers in lookup tables, is specified in rtmvars.def)","comment":"PCLINK  II 'Hello'"},
        "7923": {"comment":"PCLINK  II Devices"},
        "7924": {"comment":"PCLINK  II Directories"},
        "7925": {"comment":"PCLINK  II Files"},
        "7926": {"comment":"PCLINK  II Send file (from Z88)"},
        "7927": {"comment":"PCLINK  II Receive f. (from term.)"},
        "7928": {"comment":"PCLINK  II Quit"},
        "7929": {"comment":"EasyLink 'Hello'"},
        "7930": {"comment":"EasyLink Devices"},
        "7931": {"comment":"EasyLink Directories"},
        "7932": {"comment":"EasyLink Files"},
        "7933": {"comment":"EasyLink Send files (ImpExp)"},
        "7934": {"comment":"EasyLink Receive files (ImpExp)"},
        "7935": {"comment":"EasyLink Backup files"},
        "7936": {"comment":"EasyLink Quit"},
        "7937": {"comment":"EasyLink Translation   ON"},
        "7938": {"comment":"EasyLink Translation   OFF"},
        "7939": {"comment":"EasyLink CRLF translation   ON"},
        "7940": {"comment":"EasyLink CRLF translation   OFF"},
        "7941": {"comment":"EasyLink Application & Protocol version (\"X.X-pp\")"},
        "7942": {"comment":"EasyLink File Size"},
        "7943": {"comment":"EasyLink File Update Date Stamp"},
        "7944": {"comment":"EasyLink Set File Date Stamp"},
        "7945": {"comment":"EasyLink File Exist query"},
        "7946": {"comment":"EasyLink Install translation table"},
        "7947": {"comment":"EasyLink Delete file on Z88"},
        "7948": {"comment":"EazyLink Create directory on Z88"},
        "7949": {"comment":"EazyLink Rename Filename on Z88"},
        "7950": {"comment":"EazyLink Get default Device/Directory"},
        "7951": {"comment":"EazyLink Get Estimated Free Memory"},
        "7952": {"comment":"EazyLink Set System Clock"},
        "7953": {"comment":"EazyLink Get System Clock"},
        "7954": {"comment":"EazyLink Get Explicit Free Memory (for RAM device)"},
        "7955": {"comment":"EazyLink File CRC-32"},
