        "7008": {"synopsis":"display interactive error box\nEntry: A=error code.\nExit: Fc=1, A=error:; RC_SUSP: error not fatal; RC_DRAW: error not fatal, windows corrupted;\nRC_QUIT: error fatal.\nChanges: AF."},
        "7010": {"comment":"we don't do anything for"},
        "7012": {"comment":"quit/draw/suspended"},
        "7027": {"comment":"save screen"},
        "7029": {"comment":"remember result"},
        "7033": {"comment":"get error string"},
        "7040": {"comment":"and print it"},
        "7044": {"comment":"non-fatal? handle it"},
        "7105": {"synopsis":"OZ source name: fatal_err_wait_key."},
        "7108": {"comment":"ESC or Q pressed, exit..."},
        "7112": {"comment":"\"Press ESC to Resume\""},
        "7121": {"comment":"need redraw"},
        "7123": {"comment":"couldn't save screen, exit"},
        "7127": {"comment":"restore screen"},
        "7131": {"comment":"couldn't restore screen, exit"},
        "7133": {"comment":"was pre-empted"},
        "7138": {"comment":"error saving screen? no restore"},
        "7142": {"comment":"restore screen"},
        "7144": {"comment":"fatal error, request quit"},
        "7152": {"synopsis":"Opens GN_Err's error window: two bleeps (OS_Blp, A = 2, BC = $050A), the pop-up window\ndescribed by ErrWinDef through GN_Win, then cursor off, centred text and the cursor at the\nwindow's row 2.\nEntry: none."},
        "7185": {"synopsis":"Prints GN_Err's 'PRESS ESC TO RESUME' line, centred on the last row of the error window.\nEntry: none."},
        "7235": {"synopsis":"Waits for ESC or Q in GN_Err. Reads raw keys with OS_Cli (CL_RIM, no timeout), ignoring\nextended keys and other keys; a pre-emption (RC_Susp) waits again, an escape condition is\nacknowledged with OS_Esc. It only returns with Fz = 1, so the callers' Fz = 0 loops do not\nrepeat.\nEntry: none.\nExit: Fz = 1; A = ESC, 'Q' (upper or lower case), or after an escape condition.\nChanges: AF, BC, DE.","comment":"wait infinitely"},
        "7238": {"comment":"raw input"},
        "7256": {"comment":"extended key? loop"},
        "7260": {"comment":"not 'Q'? loop"},
        "7261": {"comment":"not ESC? loop"},
        "7264": {"comment":"upper()"},
        "7271": {"synopsis":"return extended pointer to system error message\nEntry: A=error code.\nExit: BHL=error message, Fz=1 if error is fatal.\nChanges: F, B, HL."},
        "7281": {"comment":"set flags"},
        "7289": {"synopsis":"find error string\nEntry: A=error.\nExit: HL=string, A=flags."},
        "7300": {"synopsis":"Searches the error string table ErrStr_tbl (bound in S1 by FindErrStr) for an error code.\nEach entry is 4 bytes: code, flags, string address; a 0 code ends the table.\nEntry: A = error code; MTH_BNK in S1.\nExit: HL = message string; A = flags (Z80F_Z set when the error is fatal); unknown codes\ngive Unknown_err and A = Z80F_Z.\nChanges: AF, C, HL.","comment":"error code to search for"},
        "7304": {"comment":"get error code"},
        "7307": {"comment":"not end? compare"},
        "7309": {"comment":"else fallback to unknown"},
        "7312": {"comment":"Fz=1, error is fatal"},
        "7316": {"comment":"match? get string"},
        "7318": {"comment":"skip and loop"},
        "7323": {"comment":"flags"},
        "7328": {"comment":"HL=string"},
        "7329": {"comment":"A=flags"},
        "7331": {"synopsis":"GN_Win definition of GN_Err's window: window 1 with banner and bottom line drawn as a pop-up\n(ID byte $D1), at X = 20, Y = 0, 45 characters wide and 8 rows high, with the banner text\nerrbanner."},
        "7338": {"synopsis":"Banner text of the error window: \"ERROR\", null-terminated."},
        "7344": {"synopsis":"compress filename\nEntry: BHL=source, DE=destination, C=dest size, IX=destination handle (if DE<2).\nExit: DE=destination end (if DE>255); B=#segments written, C=#chars written; Fc=1, A=error.\nChanges: AF, BC, DE."},
        "7345": {"comment":"bind in source"},
        "7347": {"comment":"remember bindings, restore dest"},
        "7353": {"comment":"restore bindings"},
        "7357": {"synopsis":"expand filename\nEntry: BHL=source, DE=destination, C=dest size, IX=destination handle (if DE<2).\nExit: DE=destination end (if DE>255); B=#segments written, C=#chars written, A=flags; A0:\nextension specified; A1: filename specified; A2: explicit directory specified; A3: current\ndirectory (\".\") specified; A4: parent directory (\"..\") specified; A5: wild directory (\"//\")\nspecified; A6: device name specified; A7: wildcards were used; Fc=1, A=error.\nChanges: AF, BC, DE.","comment":"bind in source"},
        "7360": {"comment":"# of segments"},
        "7364": {"comment":"buffer space"},
        "7368": {"comment":"parse source"},
        "7372": {"comment":"error? exit"},
        "7375": {"comment":"remember flags"},
        "7376": {"comment":"clear '.' and '..' flags"},
        "7378": {"comment":"!! 'bit 6,a;set 6,a;ld osfA,a'"},
        "7381": {"comment":"device already specified?"},
        "7385": {"comment":"do it now"},
