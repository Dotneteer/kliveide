        "10068": {"comment":"mask"},
        "10069": {"comment":"skip/mark count"},
        "10070": {"comment":"no RAM? exit  !! ret c"},
        "10072": {"comment":"skip B entries"},
        "10075": {"comment":"skip one page MAT entry"},
        "10079": {"comment":"mark C entries"},
        "10083": {"comment":"word |= in(HL)"},
        "10091": {"comment":"if marking system RAM"},
        "10096": {"comment":"Fc=0"},
