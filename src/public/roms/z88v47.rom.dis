        "5638": {"comment":"Enable escape detection"},
        "5644": {"comment":"install error handler"},
        "5646": {"comment":"OZ V4.5 and later implements OS_Nq, NQ_Voz (verify OZ)"},
        "5651": {"comment":"This application only runs on latest ROM by principle"},
        "5655": {"comment":"return to Index in current running OZ... (not the OZ of these sources)"},
        "5666": {"comment":"init calculator window"},
        "5688": {"comment":"!! do two loads to re-use ld c,0"},
        "5694": {"comment":"column"},
        "5702": {"comment":"row"},
        "5708": {"comment":"init convert window"},
