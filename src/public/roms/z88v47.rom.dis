        "9083": {"comment":"fc = 0"},
        "9084": {"comment":"hl points at null-terminator"},
        "9085": {"synopsis":"create directory path...\n\ncreate directory sub-paths, recursively.\nEntry: hl = pointer to null-terminator; b = number of directory path segments (levels) to\ncreate; c = length of filename.\nExit: fc = 0, directory path created successfully, otherwise fc = 1."},
        "9086": {"comment":"preserve separator/null"},
        "9087": {"comment":"this segment is en of path"},
        "9091": {"comment":"only dev & root directory left.."},
        "9094": {"comment":"more than one sub directory"},
        "9100": {"comment":"now create this sub directory"},
        "9105": {"comment":"restore separator/null"},
        "9107": {"synopsis":"Scans backwards from HL for the directory separator '/'.\nEntry: HL = position inside a pathname, after a '/'.\nExit: HL = the separator.\nChanges: HL.\nKeeps: AF.","comment":"scan for end of previous segment"},
        "9111": {"comment":"directory separator found at (hl)"},
        "9116": {"comment":"HL points at segment separator"},
