        "5556": {"comment":"no more, exit"},
        "5561": {"comment":"Fc=0 !! unnecessary"},
        "5563": {"synopsis":"Draws the selection bar: toggles reverse on, applies it over the selected line\n(RemoveHighlight) and toggles reverse off again.\nEntry: none.\nChanges: AF, BC."},
        "5572": {"synopsis":"Moves to column 0 of the selected line (ubIdxSelectorPos) and applies the current attributes\nover it with ApplyA: 50 characters in the application window, 83 in the process window\n(ubIdxActiveWindow). With no attribute on, this removes the bar.\nEntry: none.\nChanges: AF, BC."},
        "5580": {"comment":"prepare for application window"},
        "5584": {"comment":"process window"},
