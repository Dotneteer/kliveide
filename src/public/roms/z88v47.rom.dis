        "963": {"comment":"pop AF - we do this in BC to  keep flags"},
        "967": {"comment":"not OS_Ent? skip"},
        "969": {"comment":"change RC_Draw into RC_Susp as screen is OK"},
        "971": {"comment":"push AF"},
        "972": {"comment":"prepare for call point at osent_4"},
