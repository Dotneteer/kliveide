        "1692": {"synopsis":"convert internal date to ASCII string\nEntry: HL=source, DE=destination, IX=dest handle (if DE<2); A=format, B=format, C=delimeter\n(if A5=1).\nExit: DE=output index/ptr; Fc=1, A=error.","comment":"Read ABC from HL"},
