        "3182": {"synopsis":"set error handler","comment":"remember old handler"},
        "3187": {"comment":"if HL=0 use default handler"},
        "3188": {"comment":"!! note that if you had AT2_IE set"},
        "3189": {"comment":"!! in DOR this enables error return"},
        "3191": {"comment":"!! ld l,<DefErrHandler"},
        "3197": {"comment":"get old handler"},
        "3199": {"comment":"remember old call level"},
        "3202": {"comment":"-1 for Os_Erh"},
        "3203": {"comment":"!! just ex af,af' after setting new value"},
        "3205": {"comment":"+1 for OS_Erh"},
        "3206": {"comment":"set new call level"},
        "3214": {"synopsis":"get error context"},
        "3219": {"comment":"resumption cycle, dynamic id"},
        "3224": {"comment":"last error code"},
        "3231": {"synopsis":"Runs the application's error handler for an OZ call that returned an error. Stores the error\nin ubAppLastError, gets Fz from GN_Esp (fatal error) and calls the handler\n(pAppErrorHandler) in bank A with Fc = 1 and A = error. The handler's answer: Fc = 1: GN_Err\nshows the error box and its result is offered to the handler again; Fc = 0, Fz = 1: return;\nFc = 0, Fz = 0: the handler is called once more and the system stops in an endless loop.\nEntry: A = S3 bank of the handler; AF' = error code and flags.\nExit: AF' = handler's A with Fc = 1.\nKeeps: AF, BC, DE, HL and the alternate BC, DE, HL."},
        "3239": {"comment":"push bank"},
        "3244": {"comment":"only for Fz"},
        "3247": {"comment":"for AppErrorHandler"},
        "3252": {"comment":"bank"},
        "3258": {"comment":"error/flags from AppErrorHandler"},
        "3261": {"comment":"not fatal? exit"},
        "3267": {"synopsis":"Hangs in a loop to itself: the call to $00B7 before it is not expected to come back.","comment":"crash"},
