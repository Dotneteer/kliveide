        "3754": {"comment":"return B = total of 16K banks on Flash Memory Chip"},
        "3757": {"comment":"CDE = extended pointer to null-terminated string description of chip"},
        "3760": {"comment":"A = FE_28F or FE_29F, defining the Flash Memory chip generation"},
        "3764": {"synopsis":"OZ source name: ozFlashEprFileFormat."},
        "3767": {"comment":"return C = Number of 16K banks of File Eprom Area"},
        "3768": {"comment":"BHL = absolute pointer to \"oz\" header in card"},
        "3770": {"synopsis":"OZ source name: ozFlashEprWriteBlock."},
        "3773": {"comment":"return error condition"},
