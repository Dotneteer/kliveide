        "1249": {"comment":"clear safe workspace and bad allocation table"},
        "1256": {"comment":"caps/CAPS state"},
        "1265": {"comment":"ignore errors?"},
        "1267": {"comment":"default error handler is either $00e0 or $00e1"},
        "1275": {"comment":"Set (install) Error Handler"},
        "1282": {"comment":"disable escape detection"},
        "1284": {"comment":"HL=env overhead"},
