        "3694": {"comment":"mark file as deleted in UV Eprom."},
        "3701": {"synopsis":"OS_Fep, Flash Eprom interface\nRST 20H, DEFB $C806\n\nOn entry, OSFrame is established.\n\nReason code in A\nArguments in BC, DE, HL, IX"},
        "3709": {"comment":"adjust for page crossing."},
        "3710": {"comment":"restore hl and push address"},
        "3711": {"comment":"execute subroutine defined by reason code"},
        "3712": {"comment":"reason code $00 for FEP_CDID"},
        "3715": {"comment":"reason code $03 for FEP_CDDT"},
        "3718": {"comment":"reason code $06 for FEP_SCER  (returns only error status in AF)"},
        "3721": {"comment":"reason code $09 for FEP_CDER  (returns only error status in AF)"},
        "3724": {"comment":"reason code $0C for FEP_FFMT"},
