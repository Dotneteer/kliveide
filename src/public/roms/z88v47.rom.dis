        "8536": {"comment":"IY=SP"},
        "8538": {"comment":"HL=SP+BC"},
        "8542": {"comment":"SP=HL"},
        "8543": {"comment":"DE=SP (DE is used below for the ldir)"},
        "8544": {"comment":"orig. stk: SP 0000 IY"},
