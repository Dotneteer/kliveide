        "1972": {"synopsis":"Fills B bytes from HL with zero.\nEntry: HL = start; B = count (0 means 256).\nExit: HL = byte after the block; B = 0; A = 0.\nChanges: AF, B, HL."},
        "1978": {"synopsis":"Returns an error to the caller of a DC call: stores A in the OS frame's A and sets Fc in its\nF.\nEntry: IY = OS frame; A = error code.\nExit: frame A = error code; frame Fc = 1.\nChanges: none."},
        "1986": {"synopsis":"Loads the caller's HL from the OS frame.\nEntry: IY = OS frame.\nExit: HL = caller's HL.\nChanges: HL."},
        "1993": {"synopsis":"Reads a process block's stacked environment, dynamic ID and handle; falls into\nGetProcHandle.\nOZ source name: GetProcEnvIDHandle.\nEntry: IY = process block (bound).\nExit: BHL = prc_stkProcEnv; C = prc_dynid; DE = prc_hndl.\nChanges: BC, DE, HL."},
        "2005": {"synopsis":"Reads a process block's application handle.\nEntry: IY = process block (bound).\nExit: DE = prc_hndl.\nChanges: DE."},
        "2012": {"synopsis":"Stores IX as a process block's application handle.\nEntry: IY = process block (bound); IX = handle.\nExit: prc_hndl = IX; DE = IX.\nChanges: DE."},
