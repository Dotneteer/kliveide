        "11148": {"comment":"if a <= $fe  &&"},
        "11151": {"comment":"if a >= $e1"},
        "11154": {"comment":"then a = a - 32"},
        "11157": {"synopsis":"GetConstant - parse the current line for a constant (decimal, hex or binary)\nand return a signed long integer.\n\n......../IXIY  ........ same\nAFBCDEHL/....  afbcdehl different\nEntry: None.\nExit: debc = long integer representation of parsed ASCII constant; Fc = 0, if integer\ncollected, otherwise Fc = 1 (syntax error)."},
        "11176": {"comment":"not a constant..."},
