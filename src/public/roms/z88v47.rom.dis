        "10969": {"comment":"restore A"},
        "10973": {"comment":"application number without slot mask"},
        "10976": {"comment":"slot mask (without application number) in B5B6"},
        "10979": {"comment":"A = slot number 0-3"},
        "10981": {"comment":"return IX = ActiveAppHandle of first Application DOR in slot"},
        "10985": {"comment":"no apps in slot? go into next slot and get first App DOR"},
        "10990": {"comment":"slot mask"},
        "10992": {"comment":"to A5A6"},
        "10993": {"comment":"compare to B"},
        "10994": {"comment":"reload slot maskB5B6"},
        "10995": {"comment":"same slot"},
        "10998": {"comment":"slot in A6A7"},
        "10999": {"comment":"!! useless (already done)"},
        "11001": {"comment":"next slot mask, (and top of slot)"},
        "11003": {"comment":"wrapped slot 3, goto first of slot 4"},
        "11006": {"comment":"0xx0 0001 - get first app handle in slot"},
        "11009": {"comment":"return brother DOR"},
