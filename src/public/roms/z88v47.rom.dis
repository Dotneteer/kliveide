        "6607": {"comment":"!! check this first"},
        "6626": {"comment":"BHL=next"},
        "6635": {"comment":"!! unnecessary"},
        "6638": {"comment":"ix[new][link]=next^prev"},
        "6653": {"comment":"ix[next][link]=new^prev"},
        "6661": {"comment":"ix[prev][link]=new^next"},
        "6695": {"comment":"BHL=CDE=prev"},
        "6701": {"comment":"prev=0? skip"},
        "6706": {"comment":"ix[prev][link] = new^next^(prev)"},
        "6728": {"comment":"BHL=next"},
        "6733": {"comment":"next=0? skip"},
        "6738": {"comment":"ix[next][link] = new^prev^(next)"},
        "6763": {"comment":"write three list headers"},
        "6768": {"comment":"restore stack and exit"},
        "6779": {"synopsis":"delete an entry from a linked list\nEntry: BHL=entry to delete, CDE=previous entry.\nExit: BHL=next entry, CDE=previous entry (=BHL(in)), Fz=1 if BHL=0; Fc=1, A=error.","comment":"no entry to delete? bad args"},
        "6785": {"comment":"prev^(this) = next"},
        "6790": {"comment":"reserve space for"},
        "6794": {"comment":"three list headers"},
        "6798": {"comment":"BHL(out)=next"},
        "6807": {"comment":"ix[next][address]=next"},
        "6816": {"comment":"remember next"},
        "6820": {"comment":"BHL=prev, CDE=this"},
        "6826": {"comment":"prev=0? skip"},
        "6828": {"comment":"ix[prev][address]=prev"},
        "6837": {"comment":"this^(prev)"},
        "6840": {"comment":"ix[prev][link] = this^(prev)^next"},
        "6862": {"comment":"BHL=next"},
        "6867": {"comment":"next=0? skip"},
        "6869": {"comment":"this^(next)"},
        "6872": {"comment":"ix[next][link] = this^(next)^prev"},
        "6901": {"comment":"write two list headers"},
        "6906": {"comment":"restore stack and exit"},
        "6927": {"synopsis":"cde'=(BHL)"},
        "6930": {"comment":"bind in BHL"},
