        "5365": {"comment":"SOH?"},
        "5369": {"comment":"number catched"},
        "5373": {"comment":"Classify a character"},
        "5378": {"comment":"0-9"},
        "5381": {"comment":"counter"},
        "5384": {"comment":"got counter"},
