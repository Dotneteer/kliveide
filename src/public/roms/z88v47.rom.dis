        "13738": {"comment":"re-stack DE"},
        "13739": {"comment":"DE=next"},
        "13745": {"comment":"DE=next block"},
        "13750": {"comment":"has next? write into it"},
        "13755": {"comment":"HL=de"},
        "13756": {"comment":"un-stack for branch"},
        "13758": {"comment":"no block? exit"},
        "13761": {"comment":"re-stack"},
        "13763": {"comment":"DE=next"},
        "13764": {"comment":"point this block to next"},
