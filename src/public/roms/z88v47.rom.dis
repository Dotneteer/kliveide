        "3365": {"comment":"preserve UV Eprom programming handle"},
        "3368": {"comment":"identify UV Eprom as Card type 0"},
        "3369": {"comment":"preserve card type of chip in slot C"},
        "3372": {"comment":"returned in DEBC (Fc = 0, Eprom available...)"},
        "3378": {"comment":"HL = low word of 32bit free space..."},
        "3382": {"comment":"HL = high word of 32bit free space..."},
        "3383": {"comment":"DE = high word of file size"},
        "3386": {"comment":"ptr. to File Entry"},
        "3389": {"comment":"return A=RC_Room, Fc =1, if file size (incl. File Entry Header) > free space..."},
