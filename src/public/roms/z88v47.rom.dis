        "5167": {"comment":"enquire (fetch) parameter"},
        "5169": {"comment":"$1FF4"},
        "5173": {"synopsis":"SAFE AREA\n\n(IY+00)\nInflow process control byte\n\nBit 0 : ESC F (0, enable SOH), ESC G (1, disable SOH, default)\nBit 1 : ESC, catch letter\nBit 2 : SOH, catch number (lenght of SOH string)\nBit 3 : number >0 (in IY+1 counter), process SOH string\nBit 4 : ESC Y, catch row\nBit 5 : ESC Y, catch col\nBit 6 : unused (set)\nBit 7 : unused (set)\n\n(IY+1)\nSOH counter\n\n(IY+2)\nrow\n\nclear screen"},
        "5175": {"comment":"cursor at 0,0"},
        "5180": {"comment":"erase EOS"},
        "5185": {"synopsis":"read serial input"},
        "5190": {"comment":"read a byte"},
        "5205": {"synopsis":"loop to handle keyboard input"},
        "5208": {"comment":"read a byte from std. input, with timeout"},
        "5212": {"comment":"Timeout, test serial input"},
        "5216": {"comment":"Suspicion of pre-emption"},
        "5220": {"comment":"Application pre-empted and screen corrupted"},
        "5227": {"comment":"exit if other error"},
        "5237": {"comment":"01 exit"},
        "5240": {"comment":"02 clear screen"},
        "5310": {"synopsis":"Table of 14 bytes: the control code the Terminal sends for menu commands 3 to 16: DEL, BS,\nBEL, HT, LF, FF, CR, SO, SI, DC1, DC3, CAN, SUB and ESC."},
        "5324": {"synopsis":"Sends a byte to the serial port with OS_SI (SI_PBT) and a 100 ms timeout. On a timeout it\nsounds the bell.\nEntry: A = the byte.\nExit: Fc = 0 when sent.\nError: Fc = 1, A = error code for an error other than RC_Time.\nChanges: AF, BC.\nKeeps: DE, HL."},
        "5325": {"comment":"100 ms timeout"},
        "5330": {"comment":"write byte A to handle IX, BC=timeout"},
        "5334": {"comment":"Timeout"},
        "5338": {"comment":"bell on error"},
        "5340": {"comment":"write a byte to std. output"},
