        "6520": {"comment":"cde'=CDE^(BHL)"},
        "6523": {"comment":"return CDE^(BHL)"},
        "6534": {"comment":"Fz set if BHL=0 on exit"},
        "6540": {"synopsis":"insert an entry into a linked list\nEntry: HL = pointer to a 9-byte parameter block; (HL+0)..(HL+2) entry to insert;\n(HL+3)..(HL+5) previous entry; (HL+6)..(HL+8) next entry."},
        "6542": {"comment":"reserve space for"},
        "6546": {"comment":"three list headers"},
        "6550": {"comment":"bind parameter block in"},
        "6555": {"comment":"ix[new][address]=new"},
        "6570": {"comment":"ix[prev][address]=CDE=prev"},
        "6585": {"comment":"ix[next][address]=next"},
        "6600": {"comment":"restore binding"},
