        "9106": {"synopsis":".defTr39        defb\n.Tr39out        defb\n.defTr40        defb\n.Tr40out        defb\n.defTr41        defb\n.Tr41out        defb"},
        "9275": {"synopsis":"Error text \"Unknown error\", zero-terminated (MTH bank). The fallback text: FindErrStr\nreturns it, with Fz = 1 (fatal), for a code ErrStr_tbl does not list, and GN_Esp returns it\nfor RC_Quit."},
        "9289": {"synopsis":"Error text \"Escape\", zero-terminated. ErrStr_tbl points here for RC_Esc; GN_Esp returns it\nin BHL (bank MTH_BNK)."},
        "9296": {"synopsis":"Error text \"Timeout\", zero-terminated. ErrStr_tbl points here for RC_Time; GN_Esp returns it\nin BHL (bank MTH_BNK)."},
        "9304": {"synopsis":"Error text \"Not applicable\", zero-terminated. ErrStr_tbl points here for RC_Na, marked fatal\n(Fz = 1); GN_Esp returns it in BHL (bank MTH_BNK).\nOZ source name: NotApplicable_err."},
        "9319": {"synopsis":"Error text \"No room\", zero-terminated. ErrStr_tbl points here for RC_Room and RC_Pre; GN_Esp\nreturns it in BHL (bank MTH_BNK)."},
        "9327": {"synopsis":"Error text \"Bad handle\", zero-terminated. ErrStr_tbl points here for RC_Hand, marked fatal\n(Fz = 1); GN_Esp returns it in BHL (bank MTH_BNK)."},
        "9338": {"synopsis":"Error text \"End of file\", zero-terminated. ErrStr_tbl points here for RC_Eof; GN_Esp returns\nit in BHL (bank MTH_BNK)."},
        "9350": {"synopsis":"Error text \"Filter full\", zero-terminated. ErrStr_tbl points here for RC_Flf; GN_Esp returns\nit in BHL (bank MTH_BNK)."},
        "9362": {"synopsis":"Error text \"Overflow\", zero-terminated. ErrStr_tbl points here for RC_Ovf; GN_Esp returns it\nin BHL (bank MTH_BNK)."},
        "9371": {"synopsis":"Error text \"Bad syntax\", zero-terminated. ErrStr_tbl points here for RC_Sntx; GN_Esp returns\nit in BHL (bank MTH_BNK)."},
        "9382": {"synopsis":"Error text \"Wrap\", zero-terminated. ErrStr_tbl points here for RC_Wrap; GN_Esp returns it in\nBHL (bank MTH_BNK)."},
        "9387": {"synopsis":"Error text \"Internal error\", zero-terminated. ErrStr_tbl points here for RC_Unk, RC_Bad,\nRC_Ms and RC_Err, marked fatal (Fz = 1); GN_Esp returns it in BHL (bank MTH_BNK)."},
        "9402": {"synopsis":"Error text \"Unexpected type\", zero-terminated. ErrStr_tbl points here for RC_Type, marked\nfatal (Fz = 1); GN_Esp returns it in BHL (bank MTH_BNK)."},
        "9418": {"synopsis":"Error text \"File not found\", zero-terminated. ErrStr_tbl points here for RC_Onf; GN_Esp\nreturns it in BHL (bank MTH_BNK)."},
        "9433": {"synopsis":"Error text \"Read protected\", zero-terminated. ErrStr_tbl points here for RC_Rp; GN_Esp\nreturns it in BHL (bank MTH_BNK)."},
        "9448": {"synopsis":"Error text \"Write protected\", zero-terminated. ErrStr_tbl points here for RC_Wp; GN_Esp\nreturns it in BHL (bank MTH_BNK)."},
        "9464": {"synopsis":"Error text \"In use\", zero-terminated. ErrStr_tbl points here for RC_Use; GN_Esp returns it\nin BHL (bank MTH_BNK)."},
        "9471": {"synopsis":"Error text \"Divide by 0\", zero-terminated. ErrStr_tbl points here for RC_Dvz; GN_Esp returns\nit in BHL (bank MTH_BNK)."},
        "9483": {"synopsis":"Error text \"Number too big\", zero-terminated. ErrStr_tbl points here for RC_Tbg; GN_Esp\nreturns it in BHL (bank MTH_BNK)."},
        "9498": {"synopsis":"Error text \"-ve root\", zero-terminated. ErrStr_tbl points here for RC_Nvr; GN_Esp returns it\nin BHL (bank MTH_BNK)."},
        "9507": {"synopsis":"Error text \"Log range\", zero-terminated. ErrStr_tbl points here for RC_Lgr; GN_Esp returns\nit in BHL (bank MTH_BNK)."},
        "9517": {"synopsis":"Error text \"Accuracy lost\", zero-terminated. ErrStr_tbl points here for RC_Acl; GN_Esp\nreturns it in BHL (bank MTH_BNK)."},
        "9531": {"synopsis":"Error text \"Exponent range\", zero-terminated. ErrStr_tbl points here for RC_Exr; GN_Esp\nreturns it in BHL (bank MTH_BNK)."},
        "9546": {"synopsis":"Error text \"Bad number\", zero-terminated. ErrStr_tbl points here for RC_Bdn; GN_Esp returns\nit in BHL (bank MTH_BNK)."},
        "9557": {"synopsis":"Error text \"Bad filename\", zero-terminated. ErrStr_tbl points here for RC_Ivf; GN_Esp\nreturns it in BHL (bank MTH_BNK)."},
        "9570": {"synopsis":"Error text \"Cannot satisfy request\", zero-terminated. ErrStr_tbl points here for RC_Push and\nRC_Fail; GN_Esp returns it in BHL (bank MTH_BNK)."},
        "9593": {"synopsis":"Error text \"Already exists\", zero-terminated. ErrStr_tbl points here for RC_Exis; GN_Esp\nreturns it in BHL (bank MTH_BNK)."},
