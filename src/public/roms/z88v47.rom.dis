        "12852": {"synopsis":".end_of_batch_quit_to_main\nLD HL,end_of_batch_str\nJR message_out_back_to_main\nOZ source name: no_room_quit_to_main."},
        "12857": {"synopsis":"OZ source name: message_out_back_to_main."},
        "12860": {"synopsis":"JR quit_to_main"},
        "12864": {"synopsis":"Shows the send spinner: for a block number of 1, 3, 5 or 7 modulo 8 prints '|', '/', '-' or\n'\\', for an even one a backspace.\nEntry: A = block number.\nChanges: AF."},
        "12904": {"comment":"write character to standard output"},
        "12907": {"synopsis":"Loads the X/Y-modem options into state_prg from ubImpExpSelProtocol: the crc, block1k and\nymodem bits; the other bits are cleared.\nExit: A = state_prg.\nChanges: AF."},
        "12911": {"comment":"fetch previous selected protocol parameters from OZ SYSVARS area"},
        "12920": {"synopsis":"Keeps the X/Y-modem options in the system variable ubImpExpSelProtocol: the crc, block1k and\nymodem bits of state_prg.\nChanges: AF."},
        "12925": {"comment":"preserve current selected protocol parameters in OZ SYSVARS area"},
        "12929": {"synopsis":"Closes the transfer's file with GN_Cl if the file_open bit of state_prg is set, and clears\nthe bit.\nEntry: IY = WorkSpace; IX = the file's handle (left there by open_file)."},
        "12934": {"comment":"close file"},
        "12942": {"synopsis":"Opens a file for a transfer with GN_Opf. The explicit name goes to fname_buf, or to\nfname_buf1 when a Ymodem header carried a date (date_rx). Sets file_open, prints the\nexplicit name on a new line followed by cursor_off, and points next_pos after the name.\nEntry: A = open mode (OP_In or OP_Out); HL = file name; IY = WorkSpace.\nExit: Fc = 0; IX = file handle.\nError: Fc = 1, A = error code from GN_Opf.\nChanges: AF, BC, DE, HL, IX.","comment":"address of explicit file name buffer"},
        "12951": {"comment":"address of explicit file name buffer"},
        "12954": {"comment":"size of explicit file name buffer (HL string is local, B=0)"},
        "12957": {"comment":"open file"},
        "12965": {"comment":"new line"},
        "12969": {"comment":"Terminate filename"},
        "12971": {"comment":"Where to read/write file length"},
        "12975": {"comment":"address of explicit file name buffer"},
        "12984": {"comment":"address of explicit file name buffer"},
        "12987": {"comment":"write string (HL)"},
        "12993": {"comment":"write string (HL)"},
        "12998": {"synopsis":".is_esc\nLD C,kbd\nLD B,0                  ;@01111111          ;A15\nIN A,(C)\nCP @11011111            ;D5\nRET NZ\nSCF\nRET                     ;ESC"},
        "13008": {"synopsis":"Disables the RTC (timer) interrupts: clears BB_INTTIME in the BL_INT softcopy and writes it\nto the port, so receiving at high speed is not interrupted.\nChanges: AF, BC."},
        "13018": {"synopsis":"Enables the RTC (timer) interrupts again: sets BB_INTTIME in the BL_INT softcopy and writes\nit to the port.\nChanges: AF, BC."},
        "13028": {"synopsis":".update_port\nLD B,4\nLD (BC),A\nOUT (C),A\nRET"},
        "13042": {"synopsis":".hw_rxbt\n;Receive byte with timeout using hardware directly.\n;In: 1<=A<=59, timeout=A+0-1 seconds.\n;Out: A=byte received, Fc=1 if unsuccesful.\n;Changed: AF....../..../.fbc....\n;Min time:               64\n;Cycle                   52\nEXX                     ; 4\nIN A,(uit)              ;11\nBIT rdrf,A              ; 8\nJR NZ,rx                ;12/7\nLD bc,$FFFF             ;10     Timeout\n.check_rdrf\nIN A,(uit)              ;11\nBIT rdrf,A              ; 8\nJR NZ,rx                ;12/7\nCPI                     ;16\nJP PE,check_rdrf        ;10\nEXX                     ; 4\nSCF                     ; 4\nRET                     ;10\n.rx\nEXX                     ; 4\nIN A,(rxd)              ;11\nOR A                    ; 4\nRET                     ;10","comment":"4"},
        "13043": {"comment":"11"},
        "13045": {"comment":"8"},
        "13051": {"synopsis":"Receives a byte from the UART directly, with a timeout. Polls BL_UIT 256 times first, then\nuntil the RTC seconds counter (BL_TIM1) reaches the start plus A (get_timeout_sec). A key\npressed stops it (BL_KBD read with B' = the target second, so the row with ESC is always\namong the rows read).\nEntry: A = timeout, 1 to 59 (the wait is A - 1 to A seconds).\nExit: Fc = 0; A = byte from BL_RXD.\nError: Fc = 1; Fz = 1 on timeout, Fz = 0 if a key was pressed.\nChanges: AF, AF', BC'.","comment":"4"},
        "13052": {"comment":"4"},
        "13055": {"comment":"11"},
        "13057": {"comment":"8"},
        "13059": {"comment":"12/7"},
        "13061": {"comment":"13/8"},
        "13063": {"comment":"4"},
        "13064": {"comment":"4     Timeout"},
        "13065": {"comment":"17 + min 96"},
        "13068": {"comment":"11"},
        "13070": {"comment":"4"},
        "13071": {"comment":"11"},
        "13073": {"comment":"4"},
        "13074": {"comment":"12/7"},
        "13076": {"comment":"4"},
        "13077": {"comment":"12/7"},
        "13079": {"comment":"7"},
        "13081": {"comment":"12"},
        "13083": {"comment":"7"},
        "13085": {"comment":"12/7"},
        "13087": {"comment":"11"},
        "13089": {"comment":"8"},
        "13091": {"comment":"12/7"},
        "13093": {"comment":"4"},
        "13094": {"comment":"11"},
        "13096": {"comment":"4"},
        "13097": {"comment":"10"},
        "13098": {"comment":"4"},
        "13099": {"comment":"4"},
        "13100": {"comment":"10"},
        "13101": {"synopsis":"Sends a byte through the UART directly: waits for the transmit register to empty (BL_UIT\nTDRE) for up to about 31 seconds, then writes it to BL_TXD. A key pressed stops it.\nEntry: A = byte to send.\nExit: Fc = 0; A = byte.\nError: Fc = 1, A lost; Fz = 1 on timeout, Fz = 0 if a key was pressed.\nChanges: F, AF', BC'; A on error.","comment":"4"},
        "13102": {"comment":"4"},
        "13111": {"comment":"13/8"},
        "13118": {"comment":"11"},
        "13120": {"comment":"4"},
        "13121": {"comment":"11"},
        "13123": {"comment":"4"},
        "13124": {"comment":"12/7"},
        "13126": {"comment":"4"},
        "13129": {"comment":"7"},
        "13131": {"comment":"12"},
        "13133": {"comment":"7"},
        "13135": {"comment":"12/7"},
        "13143": {"comment":"4"},
        "13150": {"comment":"4"},
        "13153": {"comment":"4"},
        "13156": {"synopsis":".check_timeout                ;Min 78\nCALL get_sec            ;17 + min 47\nCP b                    ; 4\nRET                     ;10","comment":"17 + min 47"},
        "13159": {"comment":"4"},
        "13160": {"comment":"7"},
        "13162": {"comment":"7/12"},
        "13164": {"comment":"4"},
        "13165": {"comment":"10"},
        "13166": {"comment":"7"},
        "13168": {"comment":"4"},
        "13169": {"comment":"10"},
        "13170": {"synopsis":"Reads the RTC seconds counter (BL_TIM1), reading again until two reads agree.\nExit: A = seconds, 0 to 59.\nChanges: AF, C.","comment":"11"},
        "13172": {"comment":"4"},
        "13173": {"comment":"11"},
        "13175": {"comment":"4"},
        "13176": {"comment":"5,11"},
        "13177": {"comment":"10"},
        "13180": {"synopsis":"The mailbox name \"NAME\", null-terminated: app_main reads a file name to send from it (OS_Sr\nSR_RPD)."},
        "13185": {"synopsis":"\"Xmodem\" in bold (SOH 'B' on and off), null-terminated: the protocol shown in the menu and\nwhen sending."},
        "13196": {"synopsis":"\"Ymodem\" in bold (SOH 'B' on and off), null-terminated: the protocol shown in the menu and\nwhen sending."},
        "13207": {"synopsis":"\"/Checksum\", null-terminated: shown in the menu when CRC is off."},
        "13217": {"synopsis":"\"/CRC\", null-terminated: shown in the menu when CRC is on."},
        "13222": {"synopsis":"\"-1K\", null-terminated: shown after the protocol when 1K blocks are on."},
        "13226": {"synopsis":".g_str                  DEFM \"-G\", 0"},
        "13242": {"synopsis":"\": E)nd batch\", null-terminated: the menu's extra command with Ymodem."},
        "13255": {"synopsis":"\": R)eceive file or S)end file? \" and SOH \"2+C\" (cursor on), null-terminated: the end of the\nX/Y-modem menu."},
        "13291": {"synopsis":".file_str               DEFM CR, \"Filename? \", 0","comment":"991216"},
        "13304": {"synopsis":"CR, LF, \"Canceled\", null-terminated: shown when the other side cancels with CAN CAN."},
        "13315": {"synopsis":"CR, LF, \"Timeout\", null-terminated: shown when a byte is not sent or received in time."},
        "13325": {"synopsis":"CR, LF, \"End of retries\", null-terminated: shown when a block fails 10 times.\nOZ source name: end_of_retries_str."},
        "13342": {"synopsis":"CR, LF, \"Out of sync\", null-terminated: shown when a block number is neither the expected\none nor the previous one."},
        "13356": {"synopsis":"CR, LF, \"Bad block number\", null-terminated: shown when a repeated block's complement does\nnot match.\nOZ source name: bad_block_number_str."},
        "13375": {"synopsis":"CR, LF, \"No ack on EOT\", null-terminated: shown when EOT is not acknowledged after 10 tries.\nOZ source name: no_ack_on_eot_str."},
        "13391": {"synopsis":"A backspace and SOH \"2C\" $FD, null-terminated: printed after a received file to remove the\nprogress spinner (the source's comment, \"CR & LF & 0\", is out of date).","comment":"CR & LF & 0"},
        "13397": {"synopsis":"CR, LF, \"Dor won't open\", null-terminated: shown when send_file cannot open the file's DOR.\nOZ source name: could_not_open_dor_str."},
        "13414": {"synopsis":"CR, LF, \"Could not open file\", null-terminated: shown when open_file fails.\nOZ source name: could_not_open_file_str."},
        "13436": {"synopsis":"CR, LF, \"End of batch\", null-terminated. Nothing uses it (its use is commented out in the\nsource)."},
        "13451": {"synopsis":"CR, LF, \"Escape\", null-terminated: shown when a transfer is stopped by a key."},
        "13460": {"synopsis":"Two spaces and SOH \"2-C\" (cursor off), null-terminated: printed by open_file after the file\nname."}
      }
    },
