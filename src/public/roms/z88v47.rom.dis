        "1496": {"comment":"for bank I/O (outside this executing code)"},
        "1497": {"comment":"offset mapped for MS_S1 segment"},
        "1499": {"synopsis":"Read byte at base record pointer in BHL, offset A.\nByte is returned in A.\n\nIf B<>0, the byte is read from extended address.\nIf B=0, the byte is read from local address space.\n\nRegister affected on return:\n..BCDEHL/IXIY same\nAF....../.... different\n\nDesign & programming by Gunther Strube, 1997, Sep 2004, Oct 2005, Aug 2012"},
        "1505": {"comment":"add offset to pointer"},
        "1510": {"comment":"pointer adjusted for reading bank in segment 1"},
        "1512": {"comment":"page in bank at C = Safe MS_S1 segment"},
        "1513": {"comment":"read byte at extended or local address"},
        "1514": {"comment":"restore previous bank binding"},
        "1519": {"synopsis":"Read 16bit word at record defined as extended (base) address in BHL, offset A.\n\nIf B<>0, the 16bit word is read from extended address.\nIf B=0, the 16bit word is read from local address space.\n\nReturn 16bit word in DE.\n\nRegister affected on return:\nA.BC..HL/IXIY same\n.F..DE../.... different\n\nDesign & programming by Gunther Strube, July 1998, Sep 2004, Oct 2005"},
        "1524": {"comment":"add offset to pointer"},
        "1529": {"comment":"pointer adjusted for reading bank in segment 1"},
        "1531": {"comment":"page in bank at C = Safe MS_S1 segment"},
        "1534": {"comment":"read 16bit word at extended or local address"},
        "1535": {"comment":"restore previous bank binding"},
        "1539": {"synopsis":"Set byte in C, at base record pointer in BHL, offset A.\n\nRegister affected on return:\nA.BCDEHL/IXIY same\n.F....../.... different\n\nDesign & programming by Gunther Strube, 1995-97, Sep 2004, Oct 2005, Aug 2012"},
        "1545": {"comment":"add offset to pointer"},
        "1550": {"comment":"pointer adjusted for reading bank in segment 1"},
        "1552": {"comment":"page in bank at C = Safe MS_S1 segment"},
        "1554": {"comment":"write byte at extended or local address"},
        "1555": {"comment":"restore previous bank binding"},
        "1557": {"comment":"original BC restored..."},
        "1561": {"synopsis":"Write word in DE, at base record pointer in BHL, offset A.\n\nRegister affected on return:\nA.BCDEHL/IXIY same\n.F....../.... different\n\nDesign & programming by Gunther Strube, 1995-98, Sep 2004, Oct 2005, Aug 2012"},
        "1567": {"comment":"add offset to pointer"},
        "1572": {"comment":"pointer adjusted for reading bank in segment 1"},
        "1574": {"comment":"page in bank at C = Safe MS_S1 segment"},
        "1576": {"comment":"write word at extended or local address"},
        "1579": {"comment":"restore previous bank binding"},
        "1583": {"synopsis":"Add distance CDE (24bit integer) to current pointer address BHL\n\nA new pointer is returned in BHL, preserving original\nslot mask and segment mask.\n\nThis routine is primarily used for File Eprom management.\n\nDesign & programming by Gunther Strube, InterLogic, Dec 1997\nOZ source name: AddPointerDistance.\nChanges: B, HL.\nKeeps: AF, C, DE, IX, IY."},
        "1586": {"comment":"preserve C register"},
        "1590": {"comment":"preserve segment mask"},
        "1598": {"comment":"preserve slot mask"},
        "1604": {"comment":"preserve distance in ADE"},
