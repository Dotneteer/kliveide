        "7311": {"comment":"<> c1-c7 f4-f7"},
        "7312": {"comment":"sh d1-d7 f8-fb"},
        "7314": {"synopsis":"Test if A is a foreign or a system key\n\nFc=1 if SYSTEM KEY  ($00-$98, $9F-$A0, $A9-$B8, $C0-$C8, $D0-$D8, $E0-$E8, $F0-$FF)\nFc=0 if FOREIGN KEY ($99-$9E, $A1-$A8, $B9-$BF, $C9-$CF, $D9-$DF, $E9-$EF)"},
        "7317": {"comment":"$00-$98 is system key (no to be translated)"},
