        "4832": {"comment":"preserve total size of card (in B)"},
        "4835": {"comment":"total no. of sectors to reduce file area.."},
        "4838": {"comment":"return free space of file area in DEBC (DE = most significant word..)"},
        "4841": {"comment":"restore slot no. in C (less significant word of free space is not used here)"},
