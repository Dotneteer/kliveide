        "6500": {"comment":"restore bindings"},
        "6504": {"synopsis":"index next entry in linked list\nEntry: BHL=current entry, CDE=previous entry.\nExit: BHL=next entry, CDE=new previous entry (=BHL(in)), Fz=1 if BHL=0; Fc=1, A=error.\nChanges: AF, BC, DE, HL."},
        "6509": {"comment":"BHL=0? EOF"},
