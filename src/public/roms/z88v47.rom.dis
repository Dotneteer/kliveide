        "2721": {"comment":"seconds to next alarm"},
        "2748": {"comment":"no keys? check alarms"},
        "2759": {"comment":"LCD on"},
        "2772": {"comment":"no caps lock? don't lock"},
        "2795": {"comment":"both shifts? loop"},
        "2797": {"comment":"one shift? loop"},
        "2808": {"comment":"KBF_B_SWOFF = 0, enable keyboard int"},
        "2811": {"comment":"!! set this in A before store"},
        "2821": {"comment":"LCD on"},
        "2834": {"synopsis":"Snooze until key press\nEntry: -.\nExit: -."},
        "2842": {"comment":"pop without error"},
