        "1460": {"comment":"is this an empty flash card with write/format support?"},
        "1463": {"comment":"no flash write/format support for this slot."},
        "1464": {"comment":"prompt the user to format the flash card."},
        "1468": {"comment":"user aborted selection, restore original slot..."},
        "1472": {"synopsis":"Display the contents of slots 0-3 in an easy understandable symbolically form.\nEntry: HL = Window Banner Title."},
