        "387": {"synopsis":"Entry: B=pageID, C=entryID.\nExit: A=optionChar, HL=IX=optionList.","comment":"for E(flags 0-3) and IX(saved data i.e. the 5 bytes settings)"},
        "390": {"comment":"save Fc (Fc=1 if eof i.e. entry does not exist)"},
