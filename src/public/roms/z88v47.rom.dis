        "1178": {"comment":"popdown? init screen"},
        "1184": {"comment":"DOR in S1"},
        "1187": {"comment":"name in S1"},
        "1192": {"comment":"no help file? skip"},
        "1212": {"comment":"DE=unsafe needed"},
        "1224": {"comment":"BC=safe needed"},
