        "1952": {"synopsis":"Reads the 3-byte link at IY into CDE.\nEntry: IY = list node (link at +0..+2: low, high, bank).\nExit: C = bank; DE = address.\nChanges: C, DE."},
        "1962": {"synopsis":"Reads the 3-byte link at IY into BHL.\nEntry: IY = list node or list head (link at +0..+2: low, high, bank).\nExit: B = bank; HL = address.\nChanges: B, HL."},
