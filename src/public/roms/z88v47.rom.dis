        "3167": {"comment":"ensure bit 4 is reset"},
        "3178": {"comment":"day of the week range 1-7"},
        "3180": {"comment":"0"},
        "3184": {"comment":">7"},
        "3187": {"comment":"ensure bit 4 is reset"},
