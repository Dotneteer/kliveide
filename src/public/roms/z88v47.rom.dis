        "5427": {"comment":"signal to HW"},
        "5430": {"comment":"preserve COM Blink register soft copy address"},
        "5431": {"comment":"preserve byte to be blown..."},
        "5432": {"comment":"Fc = 0"},
        "5438": {"comment":"Error: byte wasn't blown properly"},
        "5443": {"comment":"read byte at (HL) just blown"},
        "5444": {"comment":"equal to original byte?"},
        "5445": {"comment":"Error: byte wasn't blown properly"},
