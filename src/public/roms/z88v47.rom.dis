      "lineAnnotations": {
        "0": {"synopsis":"!! get rid of IY-based variables, use absolute addressing"},
        "13": {"comment":"OZ V4.5 and later implements OS_Nq, NQ_Voz (verify OZ)"},
        "18": {"comment":"This application only runs on latest ROM by principle"},
        "23": {"comment":"return to Index in current running OZ... (not the OZ of these sources)"},
        "44": {"comment":"bc = 0"},
        "71": {"synopsis":"Hangs in a loop to itself: OS_Bye does not come back.","comment":"never reached"},
        "109": {"synopsis":"The main loop of the Panel and PrinterEd: edits the current entry and runs the command that\nends the edit.\n1. Empties the buffer, then copies the entry's saved value into it (StrcpyIX_Buffer).\n2. Moves to the field, blanks it and moves back.\n3. Edits it: an option list through HandleComboBox, anything else through HandleInputLine,\nwhich return a command code in C ($20-$2E; other codes go back to main_1, which reloads the\nsaved value).\n4. Clears the message line and stores the input (ValidateInput). An error is printed and the\nentry edited again (main_2), except for Escape ($20), Next option ($26) and New ($2C).\n5. Jumps to the command's handler in CommandTable with MainLoop as its return address.\nEntry: IY = the variables (p_ubEntryID); the setting pool and buffers allocated.\nExit: never returns; the commands leave through Exit."},
        "114": {"comment":"copy entry data into buffer"},
        "124": {"synopsis":"Entry inside MainLoop: edits the current entry again without reloading the buffer, so the\ntext that failed validation stays in the field. MainLoop jumps here after printing the\nerror.","comment":"move cursor to setting"},
        "135": {"comment":"fill field with spaces"},
        "138": {"comment":"write a byte to std. output"},
        "142": {"comment":"move back to start"},
        "145": {"comment":"write a byte to std. output"},
        "150": {"comment":"move back to start (again?)"},
        "153": {"comment":"!! just push/pop af to get flags"},
        "156": {"comment":"combo box?"},
        "184": {"comment":"save carry"},
        "186": {"comment":"and error"},
        "189": {"comment":"escape"},
        "193": {"comment":"next option"},
        "197": {"comment":"new"},
        "201": {"comment":"no error?"},
        "226": {"synopsis":"Entry: A=entry flags, D=field width, HL=entrydata+2.\nExit: C=command code.","comment":"line width"},
        "227": {"comment":"has data, return special"},
        "231": {"comment":"not number? skip"},
        "233": {"comment":"force overwrite"},
        "238": {"comment":"not string? skip"},
        "240": {"comment":"single line lock"},
