      "localLabels": [
        {"name":"UMSGS_TABLE","value":13789}
      ],
      "lineAnnotations": {
        "13789": {"synopsis":"The table UMSGS points to after boot (JPOMSG's messages; ROM0's PRINT_UMSG prints one): 9\nmessages, numbered from 0, each ended by a byte with bit 7 set (ROM1 $DD5A counts them). A\nbyte whose low 7 bits are under $20 stands for that entry of the word list at ROM1 $F819 (in\nthe same form, read by $DD6D), so \"Nu\" $1E \"ric\" $8E reads \"Numeric array: \". Message 0 is\nthe start-up line ($7F is the font's character 127); the next are \"scroll?\", a space, the\ntape prompt and the headers of a file's kind (\"Basic: \" to \"Screen: \"). ERRMSGS_TABLE\nfollows directly.","comment":"UMSGS 0: \"   MILES GORDON TECHNOLOGY PLC       $7F 1990  SAM Coup\""},
        "13842": {"comment":"UMSGS 1: \"scroll?\""},
        "13849": {"comment":"UMSGS 2: \" \""},
        "13850": {"comment":"UMSGS 3: \"Start tape and then press a key\""},
        "13880": {"comment":"UMSGS 4: \"Basic: \""},
        "13887": {"comment":"UMSGS 5: \"Numeric array: \""},
        "13894": {"comment":"UMSGS 6: \"String array: \""},
        "13896": {"comment":"UMSGS 7: \"Code: \""},
        "13901": {"comment":"UMSGS 8: \"Screen: \""}
      }
    }
