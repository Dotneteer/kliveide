      "localLabels": [
        {"name":"RST08_ERROR","value":8}
      ],
      "lineAnnotations": {
        "8": {"synopsis":"RST $08: The error and DOS hook restart. The byte after the RST is the code: below 128 an\nerror, 128 and up a DOS hook. Switches to the alternate registers and goes on at $37CE,\nwhich reads the code through the return address and calls RST8V if set.\nEntry: the code byte follows the RST.\nExit: past the code byte when a hook returns; an error does not return."},
        "15": {"synopsis":"The ROM version: 30 ($1E) in ROM 3.0, 31 in ROM 3.1, what PEEK 15 shows","comment":"PEEK 15: the ROM version, 31 in this ROM"},
        "3369": {"synopsis":"Stops with error code 29. Reached from many places, from the command table (DIR, FORMAT,\nERASE, MOVE, REF, COPY, token $D0, RENAME, PROTECT, HIDE: statements this ROM does not carry\nout) and from the calculator table (codes $0B, $4E, $50)."}
      }
    },
