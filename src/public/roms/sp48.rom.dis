        "7732": {"comment":"Past the ','"},
        "7733": {"comment":"The next item"},
        "7735": {"synopsis":"Running: DATA_SKIP with A = the DATA token.","comment":"A = DATA's token"},
        "7737": {"synopsis":"Skips the statement whose keyword is A: back to it (CPDR from HL), then FIND_STATEMENT to\nthe statement after it.","comment":"B = the token"},
        "7738": {"comment":"Back to it"},
        "7740": {"comment":"D = 2: the next statement, E = 0: no token"},
        "7743": {"comment":"Run from there"},
        "7746": {"synopsis":"RESTORE: DATADD = the byte before line n (TAKE_WORD, then RESTORE_BC); READ starts there.","comment":"BC = the line number"},
        "7749": {"synopsis":"DATADD = the byte before the first line numbered BC or more (FIND_LINE). RUN enters here\nwith BC = 0.","comment":"HL = the line number"},
        "7751": {"comment":"HL = the line, or the one after"},
        "7754": {"comment":"The byte before it"},
        "7755": {"comment":"DATADD = it"},
        "7759": {"synopsis":"RANDOMIZE: SEED = n (TAKE_WORD); for 0 or no number, the low word of FRAMES.\nObserved: RANDOMIZE 5 left SEED 5; RANDOMIZE alone SEED = FRAMES' low word at the time.","comment":"BC = the number"},
        "7762": {"comment":"Zero?"},
        "7764": {"comment":"No: SEED = it"},
        "7766": {"comment":"BC = FRAMES' low word"},
        "7770": {"synopsis":"SEED = BC.","comment":"SEED = BC"},
        "7775": {"synopsis":"CONTINUE: a jump to OLDPPC, statement OSPPC (GO_TO_2).\nObserved: after 10 PRINT \"p\": STOP: PRINT \"q\" stopped at 10:2, CONTINUE printed q and ended\nat 10:3.","comment":"HL = OLDPPC"},
        "7778": {"comment":"D = OSPPC"},
        "7781": {"comment":"Jump there"},
        "7783": {"synopsis":"GO TO: a jump to line n (TAKE_WORD), statement 0; a line number of $F000 (61440) or more is\nreport B.\nObserved: GO TO 61440 gave report B.","comment":"BC = the line number"},
        "7786": {"comment":"HL = it"},
        "7788": {"comment":"Statement 0"},
        "7790": {"comment":"A = the high byte"},
        "7791": {"comment":"61440 or more?"},
        "7793": {"comment":"Then report B"},
