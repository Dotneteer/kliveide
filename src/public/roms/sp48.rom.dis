        "8945": {"comment":"Until the 0 is at the pixel"},
        "8947": {"comment":"B = the mask"},
        "8948": {"comment":"A = the display byte"},
        "8949": {"comment":"C = P_FLAG"},
        "8952": {"comment":"OVER 1?"},
        "8954": {"comment":"Yes: the pixel kept"},
        "8956": {"comment":"The pixel cleared"},
        "8957": {"synopsis":"INVERSE 0: the pixel set (XOR, CPL), or toggled after OVER 1.","comment":"INVERSE 1?"},
        "8959": {"comment":"Yes: the byte as it is"},
        "8961": {"comment":"The other bits inverted"},
