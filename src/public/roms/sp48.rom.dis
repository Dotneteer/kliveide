        "12817": {"comment":"The result's exponent"},
        "12820": {"synopsis":"truncate ($3A): the number with its fraction bits cleared (rounding towards 0); one that\nfits becomes a small integer.","comment":"A = the exponent"},
        "12822": {"comment":"Zero (or a small integer): done"},
        "12823": {"comment":"Exponent below $81 (|x| below 1)?"},
