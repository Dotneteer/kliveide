        "12739": {"comment":"Both into the registers"},
        "12742": {"comment":"H'L' (the exponents) kept"},
        "12744": {"comment":"H'L' = the dividend's top half"},
        "12747": {"comment":"HL = its low half"},
        "12749": {"comment":"The quotient's low byte A from 0"},
