        "12875": {"comment":"C = the sign: 0, or $FF for a negative number"},
        "12882": {"synopsis":"The implicit 1 and the sign.","comment":"The implicit 1"},
        "12884": {"comment":"Eight shifts or more?"},
        "12888": {"comment":"Fewer: shifted bit by bit"},
        "12890": {"comment":"Eight at once: the top byte down"},
        "12893": {"comment":"Eight fewer to go"},
        "12894": {"synopsis":"Stored as a small integer.","comment":"No shifts left"},
        "12896": {"comment":"B = the shifts"},
        "12897": {"synopsis":"Shifts the value into place.","comment":"DE shifted right"},
        "12903": {"synopsis":"SMALL_INT_PUT.","comment":"Stored as a small integer with sign C"},
        "12906": {"comment":"DE back"},
        "12908": {"synopsis":"A full number: the fraction bits ($A0 - exponent of them) cleared; none at $A0 and over.","comment":"A = the exponent"},
        "12909": {"synopsis":"The count of bits to clear.","comment":"$A0 or more: no fraction bits"},
        "12911": {"comment":"Then done"},
        "12912": {"comment":"A = $A0 - the exponent: the bits to clear"},
        "12914": {"synopsis":"Clears A bits from the end: whole bytes, then the rest with a mask.","comment":"DE kept"},
        "12915": {"comment":"DE = the number, HL = its end"},
        "12916": {"comment":"HL at its last byte"},
        "12917": {"comment":"B = whole bytes to clear (A / 8)"},
