        "8868": {"comment":"Dark: ink 7"},
        "8870": {"synopsis":"BORDCR = A.","comment":"BORDCR = A"},
        "8873": {"comment":"Done"},
        "8874": {"synopsis":"The display byte of pixel x = C, y = B (y counting up from the bottom, 0-175; more is report\nB): HL = its address, A = x AND 7, the pixel's place counting from the byte's left (bit 7).\nChanges: AF, B, HL.","comment":"175"},
        "8876": {"comment":"Less y: the line from the top"},
        "8877": {"comment":"Over 175: report B"},
        "8880": {"comment":"B = the line from the top"},
        "8881": {"comment":"Carry clear"},
        "8882": {"comment":"Line / 2"},
        "8883": {"comment":"Carry set"},
        "8884": {"comment":"Bit 7 set: $40 and line / 4"},
        "8885": {"comment":"Carry clear"},
        "8886": {"comment":"$40 and line / 8"},
        "8887": {"comment":"High bits from A, bits 0-2 from B"},
        "8891": {"comment":"H = the address's high byte"},
        "8892": {"comment":"A = x"},
        "8893": {"comment":"Rotated left 3"},
        "8896": {"comment":"Bits 3-5 from the line, the rest from x"},
        "8900": {"comment":"Rotated left 2"},
        "8902": {"comment":"L = line bits 3-5 and x / 8"},
        "8903": {"comment":"A = x"},
        "8904": {"comment":"The pixel's place in the byte"},
        "8907": {"synopsis":"POINT's value: 1 when the pixel at x, y (TAKE_TWO_BYTES, PIXEL_BYTE) is set, else 0, stacked\n(STACK_A).\nObserved: after PLOT 5,7, POINT (5,7) gave 1 and POINT (6,7) 0.","comment":"C = x, B = y"},
        "8910": {"comment":"HL = the byte, A = the place"},
        "8913": {"comment":"B = the place + 1"},
        "8915": {"comment":"A = the display byte"},
