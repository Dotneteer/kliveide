        "10205": {"comment":"','?"},
        "10207": {"comment":"No: the end"},
        "10210": {"comment":"The next argument"},
        "10212": {"synopsis":"')' must end them.","comment":"')'?"},
        "10214": {"synopsis":"Report C."},
        "10217": {"synopsis":"The result's type: a number unless the name had '$'.","comment":"Past the ')'"},
        "10218": {"comment":"HL = FLAGS"},
        "10221": {"comment":"A string for now"},
        "10223": {"comment":"The '$' test back"},
        "10224": {"comment":"'$': a string"},
        "10226": {"comment":"Otherwise a number"},
        "10228": {"synopsis":"To SCAN_OPERATOR."},
        "10231": {"synopsis":"Running: B = the name's letter (upper case), C = 0 for '$'; the DEF FN with that name is\nlooked for from the program's start (LOOK_PROG for $CE, FN_TEST); none is report P.","comment":"The name's letter"},
        "10232": {"comment":"Upper case"},
        "10234": {"comment":"B = it"},
        "10235": {"comment":"The character after it"},
        "10236": {"comment":"0 for '$'"},
        "10239": {"comment":"No '$': on"},
        "10241": {"comment":"Past the '$'"},
        "10242": {"synopsis":"Past '('; HL = the arguments, kept.","comment":"Past '('"},
        "10243": {"comment":"The arguments' position kept"},
        "10244": {"comment":"HL = PROG"},
        "10247": {"comment":"One byte before it"},
