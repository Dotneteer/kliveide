      "lineAnnotations": {
        "8": {"synopsis":"Reports an error. The byte after the RST holds the report code minus one; the custom disassembler lists it as a .defb."},
        "40": {"synopsis":"Enters the calculator. The bytes after the RST are its operation codes and literals, up to the end-calculation code; the custom disassembler decodes them."},
        "1218": {"synopsis":"Saves a block to tape: A = the flag byte, IX = the start, DE = the length. Klive traps it to save to the tape file."},
        "1366": {"synopsis":"Loads (carry set) or verifies (carry clear) a block from tape: A = the flag byte, IX = the start, DE = the length. Returns with carry set on success."},
        "1388": {"synopsis":"Where LOAD starts checking the tape input for a pilot pulse. Klive traps it to load a block from the tape file at once."},
        "1462": {"synopsis":"A RET NZ that leaves LOAD when the header read is not the one asked for. Klive fast load comes here to report a wrong header."},
        "1506": {"synopsis":"Where LOAD returns after a block has loaded. Klive fast load resumes here."},
        "4780": {"synopsis":"The BASIC main loop, reached once the ROM has set itself up. The code injection and tape load flows wait for the machine to get here."},
        "10930": {"synopsis":"Stacks a string for the calculator: A, DE (the start) and BC (the length)."},
        "10934": {"synopsis":"Stacks a five-byte number held in A, E, D, C and B on the calculator stack."},
        "11249": {"synopsis":"Takes the top number off the calculator stack into A, E, D, C and B."},
        "11747": {"synopsis":"Prints the number on top of the calculator stack through the current channel."},
        "15616": {"synopsis":"The character set: 96 characters of 8 bytes, from the space to the copyright sign, each row one byte with bit 7 the leftmost pixel."}
      }
    }
  },
