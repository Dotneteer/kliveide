        "11933": {"comment":"The top nibble dropped"},
        "11935": {"comment":"C = $FF: still in the leading zeros"},
        "11937": {"synopsis":"Unpacks the BCD digits to bytes (RLD), leading zeros dropped, counting digits ($5CAB) and\nthe point's place ($5CAC).","comment":"The next digit into A"},
        "11939": {"comment":"Not 0: stored"},
        "11941": {"comment":"C still $FF?"},
        "11943": {"comment":"Yes: a leading zero, skipped"},
        "11945": {"synopsis":"A digit stored.","comment":"Stored"},
        "11947": {"comment":"One digit more"},
        "11950": {"comment":"The point one place on"},
        "11953": {"comment":"C = 0: zeros count from now on"},
        "11955": {"synopsis":"On.","comment":"Every second digit"},
        "11959": {"comment":"The next BCD byte"},
        "11960": {"synopsis":"The next BCD byte every two digits."},
        "11962": {"comment":"The digits so far"},
