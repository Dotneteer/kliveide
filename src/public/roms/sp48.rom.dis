        "10736": {"comment":"No"},
        "10738": {"comment":"A = the character at CH_ADD"},
        "10739": {"comment":"')'?"},
        "10741": {"comment":"Yes: past it"},
        "10743": {"comment":"TO?"},
        "10745": {"comment":"Yes: a slice"},
        "10747": {"synopsis":"Running: offset = offset x this dimension + (subscript - 1) (GET_DIM, SUBSCRIPT, HL_MULT);\nthe next dimension (DJNZ).","comment":"The count and form kept"},
        "10748": {"comment":"The offset kept"},
