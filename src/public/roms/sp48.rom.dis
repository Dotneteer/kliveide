        "12763": {"comment":"The remainder H'L'HL x 2"},
        "12768": {"comment":"A carry out: larger than the divisor, surely"},
        "12770": {"synopsis":"Tries subtracting the divisor.","comment":"The remainder less the divisor D'E'DE"},
        "12776": {"comment":"No borrow: a 1 bit"},
        "12778": {"comment":"A borrow: the divisor added back"},
        "12783": {"comment":"A 0 bit"},
        "12786": {"synopsis":"A carry out of the shift: the divisor subtracted anyway.","comment":"Carry cleared"},
        "12787": {"comment":"The divisor subtracted"},
        "12793": {"synopsis":"A 1 bit.","comment":"A 1 bit"},
        "12794": {"synopsis":"The bits counted (B from $DF).","comment":"One bit more"},
        "12795": {"comment":"Negative still: the next bit"},
        "12798": {"comment":"The 33rd bit kept"},
        "12799": {"comment":"B = 0: one more, for the rounding"},
        "12801": {"comment":"The quotient into D'E'DE"},
        "12806": {"comment":"The rounding bits into B'"},
        "12813": {"comment":"B and C = the exponents"},
        "12814": {"comment":"HL = the result"},
