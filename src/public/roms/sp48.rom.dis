        "12926": {"synopsis":"Whole bytes zeroed.","comment":"Zeroed"},
        "12929": {"comment":"Back towards the exponent"},
        "12931": {"synopsis":"The rest.","comment":"Bits left over in the next byte"},
        "12933": {"comment":"None: done"},
        "12935": {"comment":"B = their count"},
        "12936": {"comment":"A mask of ones"},
        "12938": {"synopsis":"The mask.","comment":"The low B bits cleared"},
        "12942": {"comment":"The byte masked"},
        "12944": {"synopsis":"Done.","comment":"HL = the number again"},
        "12945": {"comment":"DE back"},
        "12947": {"synopsis":"Both operands into the full floating form (re-stack on DE, then on HL).","comment":"re-stack on DE first"},
        "12950": {"synopsis":"re-stack on the number at DE (HL and DE swapped).","comment":"HL = the number at DE"},
        "12951": {"synopsis":"re-stack ($3D): a small integer at HL into the full floating form (exponent $91 or $89 and\nthe shifted value); a full number is left as it is.\nObserved: LET w=1.5 stored 81 40 00 00 00.","comment":"A = the exponent byte"},
        "12953": {"comment":"Not 0: already in the full form"},
        "12954": {"comment":"DE kept"},
        "12955": {"comment":"C = the sign, DE = the value"},
