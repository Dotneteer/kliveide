        "12229": {"comment":"C and B = its low half (crossed)"},
        "12232": {"comment":"HL to the second number"},
        "12233": {"comment":"D = the first's byte 0, E = the second's"},
        "12235": {"comment":"For H'L'"},
        "12237": {"comment":"D and E = the second's top half"},
        "12240": {"comment":"For D'E'"},
        "12241": {"comment":"D'E' = the second's top half, H'L' = the byte 0s, B'C' = the first's top half"},
        "12246": {"comment":"D and E = the second's low half"},
        "12250": {"comment":"AF and HL back"},
        "12253": {"synopsis":"Shifts the second number right by A bits through both register sets (33 or more: it becomes\n0); a bit shifted out rounds up (ROUND_UP).","comment":"No shift: done"},
        "12255": {"comment":"33 bits or more?"},
        "12257": {"comment":"Then the second number becomes 0"},
        "12260": {"comment":"B = the count"},
        "12261": {"synopsis":"One bit."},
