        "7952": {"comment":"Over 65535: report 4"},
        "7954": {"comment":"Below the machine stack?"},
        "7956": {"comment":"Yes: room"},
        "7957": {"synopsis":"Stops with error code 3 (report 4): no room.","comment":"Error code 3: report 4"},
        "7959": {"comment":"Stops"},
