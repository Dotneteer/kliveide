        "8772": {"synopsis":"Stops with error code $13 (report K, \"Invalid colour\")."},
        "8774": {"synopsis":"HL = ATTR_T. 0-7: the colour itself; 8: the old ATTR_T bits (the mask below makes them the\nscreen's); 9: a contrast start value.","comment":"HL = ATTR_T"},
