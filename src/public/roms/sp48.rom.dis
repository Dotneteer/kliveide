        "12209": {"comment":"Complemented, plus the carry"},
        "12213": {"comment":"All five, the sign byte becoming $FF"},
        "12215": {"comment":"A = the exponent"},
        "12218": {"synopsis":"Loads the two prepared numbers at HL and DE into both register sets for the arithmetic; the\nfirst's sign byte becomes A.","comment":"HL and A kept"},
        "12220": {"comment":"C = the first's byte 0: its sign byte for addition, its exponent otherwise"},
        "12222": {"comment":"B = its top mantissa byte"},
        "12223": {"comment":"A in its place: the result's sign for multiply and division"},
