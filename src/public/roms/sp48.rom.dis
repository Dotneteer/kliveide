        "16136": {"synopsis":"$61 - Character: 'a'"},
        "16144": {"synopsis":"$62 - Character: 'b'"},
        "16152": {"synopsis":"$63 - Character: 'c'"},
        "16160": {"synopsis":"$64 - Character: 'd'"},
        "16168": {"synopsis":"$65 - Character: 'e'"},
