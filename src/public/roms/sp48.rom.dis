        "7841": {"synopsis":"RUN: GO TO line n (0 when none), RESTORE to the first line, then CLEAR with RAMTOP unchanged\n(CLEAR_RUN with BC = 0).","comment":"GO TO the line"},
        "7844": {"comment":"BC = 0"},
        "7847": {"comment":"RESTORE to the program's start"},
        "7850": {"comment":"CLEAR, RAMTOP unchanged"},
