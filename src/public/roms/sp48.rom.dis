        "7965": {"comment":"HL = STKEND + $50 - SP"},
        "7968": {"comment":"BC = it"},
        "7971": {"synopsis":"RETURN: takes the statement and line GO SUB kept from below the ERR_SP slot, moves the error\naddress and ERR_SP up, and jumps there (GO_TO_2). Reaching the $3E marker under RAMTOP\ninstead is report 7.\nObserved: RETURN with no GO SUB gave \"7 RETURN without GOSUB\".","comment":"BC = the return address"},
        "7972": {"comment":"HL = the error address"},
        "7973": {"comment":"DE = the line, or the marker"},
        "7974": {"comment":"The marker under RAMTOP?"},
