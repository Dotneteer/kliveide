        "11880": {"comment":"Negated"},
        "11882": {"comment":"Scaled down by 10 ^ it"},
        "11885": {"comment":"Split again"},
        "11887": {"synopsis":"A whole part up to 2^28: its mantissa bits shifted into the BCD buffer.","comment":"DE = the whole part"},
        "11888": {"comment":"Its mantissa into D'E'DE"},
        "11892": {"comment":"The implicit 1"},
        "11894": {"comment":"A = L', its exponent byte"},
        "11896": {"comment":"Less $80: B = the bits"},
        "11899": {"synopsis":"One bit: the BCD buffer x 2 + the bit (ADC, DAA over 5 bytes).","comment":"The top bit of D'E'DE into the carry"},
        "11909": {"comment":"HL = the BCD buffer's last byte"},
        "11912": {"comment":"5 bytes"},
