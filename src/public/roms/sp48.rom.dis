        "7798": {"comment":"NSPPC = D"},
        "7802": {"synopsis":"OUT: writes the byte to the port (TWO_PARAM: A the byte, BC the port).","comment":"A = the byte, BC = the port"},
        "7805": {"comment":"Out to the port"},
        "7808": {"synopsis":"POKE: stores the byte at the address (TWO_PARAM: A the byte, BC the address).\nObserved: POKE 30001,-1 stored 255; POKE 30001,300 was report B.","comment":"A = the byte, BC = the address"},
        "7811": {"comment":"Stored"},
        "7813": {"synopsis":"Two numbers off the calculator stack: A = the top one, a byte (FP_TO_A; -255 to 255, a\nnegative one taken as 256 less it; else report B), BC = the one below (TAKE_WORD).","comment":"A = the byte"},
        "7816": {"comment":"Over 255: report B"},
