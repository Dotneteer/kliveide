        "8979": {"comment":"Done"},
        "8980": {"synopsis":"A = the number on top of the calculator stack (FP_TO_A), C = its sign: 1, or $FF when\nnegative; over 255 is report B.","comment":"A = the number, Z when positive"},
        "8983": {"comment":"Over 255: report B"},
        "8986": {"comment":"C = 1"},
