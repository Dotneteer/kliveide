        "12264": {"comment":"Through D'E'"},
        "12269": {"comment":"Then DE; the last bit out in the carry"},
        "12273": {"comment":"Until B bits"},
        "12276": {"comment":"No bit out: done"},
        "12277": {"comment":"A bit out: rounded up"},
        "12280": {"comment":"Not 0 after the rounding: done"},
        "12281": {"synopsis":"The second number becomes 0."},
        "12282": {"comment":"A = 0"},
        "12283": {"synopsis":"The alternate registers' part zeroed.","comment":"L' = 0, the sign byte"},
        "12285": {"comment":"D'E' = 0"},
        "12288": {"comment":"DE = 0"},
        "12292": {"synopsis":"Adds 1 to the 32-bit value in E, D, E', D' (rounding).","comment":"The carry rippling from E to D'"},
        "12298": {"comment":"D' only when E' wrapped"},
        "12301": {"synopsis":"Done."},
        "12303": {"synopsis":"subtract ($03): the second operand negated, then addition."},
        "12304": {"comment":"The second operand negated (CALC_NEGATE)"},
        "12308": {"synopsis":"addition ($0F): two small integers are added as 16-bit numbers when the sum fits; otherwise\nboth in the full form (RESTACK_TWO, ADD_FULL).\nObserved: 65535+1 printed 65536; -65535-1 printed -1E-38, not -65536.","comment":"Both exponent bytes 0 (both small integers)?"},
        "12310": {"comment":"No: full addition"},
        "12312": {"comment":"DE kept"},
        "12314": {"comment":"HL at the first's sign byte, kept"},
        "12316": {"comment":"DE = the first's value"},
        "12322": {"comment":"A = the second's sign byte"},
        "12324": {"comment":"BC = the second's value"},
        "12329": {"comment":"The 16-bit sum"},
        "12331": {"comment":"The signs added, with the sum's carry"},
        "12332": {"comment":"A zero only when the sum's sign is $00 or $FF"},
        "12335": {"comment":"Otherwise it does not fit 16 bits"},
        "12337": {"comment":"The sign byte from the carry"},
        "12338": {"comment":"The sum stored"},
        "12343": {"comment":"HL back to the result"},
        "12346": {"comment":"DE back"},
        "12348": {"synopsis":"The small-integer sum did not fit: the full form.","comment":"HL back to the first number"},
        "12350": {"synopsis":"Full addition: both prepared in two's complement (ADD_TWOS_COMPL), the smaller shifted right\nby the exponent difference (SHIFT_RIGHT_A), the mantissas added; an overflow shifts right\nand raises the exponent (report 6 past $FF); the sign back to sign-and-magnitude; then the\nnormalising tail.","comment":"Both in the full form"},
        "12353": {"comment":"H'L' kept"},
        "12356": {"comment":"DE and HL kept"},
