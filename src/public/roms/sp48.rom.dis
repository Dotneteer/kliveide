        "8963": {"synopsis":"The byte back; the attribute (OUT_ATTR).","comment":"The byte back"},
        "8964": {"comment":"The cell's attribute"},
        "8967": {"synopsis":"Takes two numbers off the calculator stack (TAKE_BYTE_SIGN each): B = the top one, C = the\none below; D and E their signs (1 or $FF).","comment":"The top number"},
        "8970": {"comment":"B = it"},
