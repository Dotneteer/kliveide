        "12674": {"comment":"Up to 32 shifts"},
        "12676": {"comment":"All 32: the mantissa is 0"},
        "12678": {"synopsis":"Rounds by the bit below the mantissa (ROUND_UP); a carry out raises the exponent (report 6\npast $FF).","comment":"The rounding bit into the carry"},
        "12679": {"comment":"0: no rounding"},
