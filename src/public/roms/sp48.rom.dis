        "7855": {"synopsis":"Clears the variables (from VARS to E_LINE, RECLAIM_DE_HL) and the screen (CLS_CMD), and puts\nRAMTOP at BC (0: unchanged). RAMTOP must be above STKEND + 50 and not above P_RAMT, else\nreport M. The GO SUB stack is emptied (CLEAR_STACK).\nObserved: CLEAR 30000 set RAMTOP 30000 with $3E there; CLEAR 100 gave report M.","comment":"Zero?"},
        "7857": {"comment":"No: RAMTOP = it"},
        "7859": {"comment":"BC = RAMTOP: unchanged"},
        "7863": {"synopsis":"BC = the new RAMTOP, kept.","comment":"Kept"},
        "7864": {"comment":"DE = VARS"},
        "7868": {"comment":"HL = E_LINE"},
        "7871": {"comment":"Less 1: the $80 end marker kept"},
        "7872": {"comment":"The variables removed"},
        "7875": {"comment":"The screen cleared"},
        "7878": {"comment":"HL = STKEND"},
        "7881": {"comment":"Plus 50"},
        "7885": {"comment":"DE = the new RAMTOP"},
        "7886": {"comment":"STKEND + 50 or more?"},
        "7888": {"comment":"Then report M"},
        "7890": {"comment":"HL = P_RAMT"},
        "7893": {"comment":"Carry clear"},
        "7894": {"comment":"Not above P_RAMT?"},
        "7896": {"comment":"Then it is set"},
        "7898": {"synopsis":"Stops with error code $15 (report M, \"RAMTOP no good\")."},
        "7900": {"synopsis":"RAMTOP = DE; the machine stack starts again just below it with the $3E marker, the error\naddress (the ERR_SP slot's) pushed and ERR_SP pointing at it; returns to the caller through\nHL.","comment":"HL = the new RAMTOP"},
        "7901": {"comment":"RAMTOP"},
        "7904": {"comment":"DE = the return address"},
        "7905": {"comment":"BC = the error address"},
        "7906": {"comment":"$3E at RAMTOP"},
