        "12613": {"comment":"Too small: carry cleared"},
        "12614": {"synopsis":"In range.","comment":"The exponent"},
        "12615": {"comment":"Not 0: stored"},
        "12617": {"comment":"Carry: stored"},
        "12620": {"comment":"The mantissa's top bit set?"},
        "12623": {"comment":"Then too big: report 6"},
