        "10571": {"synopsis":"HL back; carry = B bit 7 (not found), Z when B bit 5 is clear: found, a string or an array;\nchecking or not found, a '(' follows.","comment":"HL = the variable, or the name's start"},
        "10572": {"comment":"Carry = bit 7, bit 5 into bit 6"},
        "10574": {"comment":"Z: bit 5 was clear"},
        "10577": {"synopsis":"Inside a DEF FN call: the function's parameters at DEFADD, each a letter (with '$' for a\nstring), its value's 5 bytes after a $0E for a number; ')' ends them (back to the search,\nLV_SEARCH).","comment":"HL = DEFADD, the parameters"},
        "10580": {"comment":"A = the first byte"},
        "10581": {"comment":"')': no parameters?"},
        "10583": {"comment":"Then the ordinary search"},
