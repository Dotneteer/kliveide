        "12074": {"comment":"The point one place on"},
        "12077": {"synopsis":"The digit count stored; the number deleted."},
        "12083": {"comment":"HL' back"},
        "12086": {"comment":"C = the digit count, B = the point's place"},
        "12090": {"comment":"HL = the digits"},
        "12093": {"comment":"A = the place"},
        "12094": {"comment":"Up to 8?"},
        "12096": {"comment":"Plain form"},
        "12098": {"comment":"From 9 to -5 ($FB): E form"},
        "12102": {"synopsis":"Plain form: a leading 0 when the point comes first, the digits, the point and any zeros\nafter it.","comment":"Place 0: a leading 0"},
        "12106": {"synopsis":"Prints the digits before the point (B of them).","comment":"A = -B"},
        "12108": {"comment":"B above 0: digits before the point"},
        "12111": {"comment":"B = the zeros after the point"},
        "12112": {"comment":"On to the point"},
        "12114": {"synopsis":"The next digit, or 0 once they run out.","comment":"Digits left?"},
        "12116": {"comment":"None: a 0"},
        "12118": {"comment":"The next digit"},
        "12121": {"synopsis":"Prints it (PRINT_A_DIGIT)."},
        "12124": {"comment":"B of them"},
        "12126": {"synopsis":"The point and the rest.","comment":"Digits left?"},
        "12128": {"comment":"None: done"},
        "12129": {"comment":"B one more: the point and the zeros"},
        "12130": {"comment":"The point"},
        "12132": {"synopsis":"Zeros between the point and the first digit."},
        "12133": {"comment":"Then zeros"},
        "12137": {"comment":"B = the digits left"},
        "12138": {"comment":"Printed"},
        "12140": {"synopsis":"E form: one digit before the point, then E and the exponent.","comment":"D = the place - 1: the exponent"},
        "12142": {"comment":"One digit before the point"},
        "12144": {"comment":"The digits"},
        "12147": {"comment":"E"},
        "12150": {"comment":"C = the exponent"},
        "12153": {"comment":"Positive"},
        "12156": {"comment":"Negative: C = |the exponent|"},
        "12159": {"comment":"'-'"},
        "12163": {"synopsis":"A '+' for a positive exponent."},
        "12165": {"synopsis":"The sign, then the exponent's digits (PRINT_BC_NUM)."},
        "12166": {"comment":"BC = the exponent"},
        "12168": {"comment":"Printed (PRINT_BC_NUM)"},
        "12171": {"synopsis":"A = (A x 10 + C) AND $FF, C = its high byte: one byte of a x 10 with carry."},
        "12172": {"comment":"HL = A"},
        "12175": {"comment":"DE = A"},
        "12177": {"comment":"Times 4"},
        "12179": {"comment":"Times 5"},
        "12180": {"comment":"Times 10"},
        "12181": {"comment":"+ C"},
        "12183": {"comment":"C = the carry out"},
        "12184": {"comment":"A = the low byte"},
        "12187": {"synopsis":"For addition: A = the number's exponent (the byte cleared); the mantissa's implicit 1 set; a\nnegative number made two's complement over its sign byte and four mantissa bytes.","comment":"A = the exponent"},
        "12188": {"comment":"The exponent byte becomes the sign byte, 0"},
        "12191": {"comment":"A zero number: done"},
        "12193": {"comment":"Z for a positive number"},
        "12195": {"comment":"The implicit 1 back in place of the sign bit"},
        "12198": {"comment":"Positive: done"},
        "12200": {"comment":"HL past the five bytes"},
        "12204": {"comment":"B = 5 bytes"},
        "12205": {"comment":"C = the exponent"},
        "12206": {"comment":"Carry: the +1 of the negation"},
