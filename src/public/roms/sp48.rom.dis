        "11854": {"comment":"Stored"},
        "11856": {"comment":"The point's place moved by it"},
        "11859": {"comment":"On to the fraction"},
        "11862": {"synopsis":"A large whole part: scaled down by 10 ^ (estimate - 7) first.","comment":"The binary exponent"},
        "11864": {"comment":"Below 28 bits?"},
        "11866": {"comment":"Yes: a medium number"},
        "11868": {"comment":"A = its decimal digits"},
        "11871": {"comment":"Less 7"},
