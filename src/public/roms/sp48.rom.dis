        "9038": {"comment":"$80 or more: 0.5 or more?"},
        "9040": {"comment":"Yes: the circle drawn"},
        "9042": {"comment":"Two values dropped"},
        "9046": {"comment":"The count dropped"},
        "9047": {"comment":"Only x, y plotted (PLOT_CMD)"},
        "9050": {"synopsis":"The first chord's end and start in the memories, COORDS = the first point (TAKE_BYTE twice),\nthen ARC_LOOP.","comment":"The first chord's values in the memories"},
        "9070": {"comment":"Memory 2 doubled (its exponent + 1)"},
        "9073": {"comment":"A = the top number"},
