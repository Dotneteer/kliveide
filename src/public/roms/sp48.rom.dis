        "8837": {"comment":"Then report K"},
        "8839": {"synopsis":"ATTR_T's bit from the value; MASK_T's bit set for 8 (keep the screen's), cleared for 0 and\n1.","comment":"A = the moved value"},
        "8840": {"comment":"HL = ATTR_T"},
        "8843": {"comment":"ATTR_T's bit; HL = MASK_T"},
        "8846": {"comment":"A = the moved value"},
