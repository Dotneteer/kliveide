        "10251": {"comment":"The name kept"},
        "10252": {"comment":"LOOK_PROG: the next DEF FN"},
        "10255": {"comment":"The name back"},
        "10256": {"comment":"Found one?"},
        "10258": {"comment":"Otherwise report P"},
        "10260": {"synopsis":"Its name against B and C.","comment":"The DEF FN's position kept"},
        "10261": {"comment":"HL = its name's letter"},
        "10264": {"comment":"Upper case"},
        "10266": {"comment":"The same letter?"},
        "10267": {"comment":"No: the next DEF FN"},
        "10269": {"comment":"The character after the letter"},
        "10272": {"comment":"Zero for '$'"},
        "10274": {"comment":"The same type?"},
        "10275": {"comment":"Yes: found"},
        "10277": {"synopsis":"Not this one: on from the next statement (FIND_STATEMENT).","comment":"The DEF FN's position back"},
        "10278": {"comment":"One byte back"},
        "10279": {"comment":"D = 2: the next statement"},
        "10282": {"comment":"The name kept"},
        "10283": {"comment":"FIND_STATEMENT"},
        "10286": {"comment":"The name back"},
        "10287": {"comment":"Searched again"},
        "10289": {"synopsis":"Found: CH_ADD = the call's arguments; HL at the DEF FN's parameters.","comment":"A string function?"},
        "10290": {"comment":"Then past its '$'"},
        "10293": {"comment":"The DEF FN's position dropped"},
        "10294": {"comment":"DE = the call's arguments"},
        "10295": {"comment":"CH_ADD = them"},
        "10299": {"comment":"HL = the first parameter, or ')'"},
        "10302": {"comment":"The parameters' start kept"},
        "10303": {"comment":"No parameters?"},
        "10305": {"comment":"Then to the body"},
        "10307": {"synopsis":"One parameter: a number has $0E after it, a string '$'. Its argument (SCAN_EXPR) must be the\nsame type (report Q); the value's 5 bytes (a string's start and length too) are moved off\nthe calculator stack into the parameter's room.","comment":"Past the parameter's letter"},
        "10308": {"comment":"The byte after it"},
        "10309": {"comment":"$0E: a number?"},
        "10311": {"comment":"D = $40, a number"},
        "10313": {"comment":"Yes"},
        "10315": {"comment":"Back to the letter"},
        "10316": {"comment":"HL = the '$'"},
        "10319": {"comment":"HL = its $0E"},
        "10320": {"comment":"D = 0, a string"},
        "10322": {"synopsis":"HL = the parameter's 5 bytes; the argument evaluated.","comment":"HL = the 5 bytes"},
        "10323": {"comment":"Kept"},
        "10324": {"comment":"The parameter's type kept"},
        "10325": {"comment":"SCAN_EXPR: the argument"},
        "10328": {"comment":"A = the parameter's type"},
        "10329": {"comment":"Against FLAGS"},
        "10332": {"comment":"Only bit 6"},
        "10334": {"comment":"Types differ: report Q"},
        "10336": {"comment":"HL = the 5 bytes"},
        "10337": {"comment":"DE = they, the destination"},
        "10338": {"comment":"HL = STKEND"},
        "10341": {"comment":"Five bytes"},
        "10344": {"comment":"HL = the value on the stack"},
        "10346": {"comment":"STKEND: the value dropped"},
        "10349": {"comment":"Copied into the parameter"},
        "10351": {"comment":"HL = past the 5 bytes"},
        "10352": {"comment":"HL = the last of them"},
        "10353": {"comment":"The next character of the DEF FN"},
        "10356": {"comment":"')': the last parameter?"},
        "10358": {"comment":"Yes: to the body"},
        "10360": {"comment":"The DEF FN's position kept"},
        "10361": {"comment":"The call's next character"},
        "10362": {"comment":"A ','?"},
        "10364": {"comment":"No: report Q"},
        "10366": {"comment":"Past the ','"},
