        "10368": {"comment":"HL = the next parameter"},
        "10371": {"comment":"The next parameter"},
        "10373": {"synopsis":"The call's ')' must close the arguments (report Q otherwise).","comment":"The DEF FN's position kept"},
        "10374": {"comment":"The call's next character"},
        "10375": {"comment":"')'?"},
        "10377": {"comment":"Yes: evaluated"},
        "10379": {"synopsis":"Stops with error code $19 (report Q, \"Parameter error\")."},
        "10381": {"synopsis":"Evaluates the body: CH_ADD = the DEF FN after its ')', DEFADD = its parameters (the old\nDEFADD kept), SCAN_EXPR past '='; then CH_ADD back after the call and DEFADD back.","comment":"DE = the DEF FN's ')'"},
        "10382": {"comment":"HL = it, DE = the call's ')'"},
        "10383": {"comment":"CH_ADD = the DEF FN's ')'"},
        "10386": {"comment":"HL = DEFADD"},
