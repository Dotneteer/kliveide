        "10720": {"synopsis":"TO: CH_ADD back one, to slice (SV_SLICE2).","comment":"HL = CH_ADD"},
        "10721": {"comment":"One byte back"},
        "10722": {"comment":"CH_ADD = it"},
        "10725": {"comment":"Sliced"},
        "10727": {"synopsis":"HL = 0: the element offset so far.","comment":"HL = the offset, 0 so far"},
        "10730": {"synopsis":"One subscript: past '(' or ','. Checking a string: ')' or TO at once is a slice.","comment":"The offset kept"},
        "10731": {"comment":"Past '(' or ','"},
        "10732": {"comment":"The offset back"},
        "10733": {"comment":"A = the name's form"},
