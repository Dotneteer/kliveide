        "12693": {"synopsis":"Stores the mantissa and puts the sign in bit 7 of its first byte."},
        "12694": {"comment":"HL to the first mantissa byte"},
        "12696": {"comment":"BC = the mantissa's top half"},
        "12699": {"comment":"A = the top byte"},
