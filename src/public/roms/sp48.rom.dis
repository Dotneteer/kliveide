        "10390": {"comment":"DEFADD = the parameters"},
        "10393": {"comment":"The call's ')' kept"},
        "10394": {"comment":"Past ')'"},
        "10395": {"comment":"Past '='"},
        "10396": {"comment":"SCAN_EXPR: the body"},
        "10399": {"comment":"HL = the call's ')'"},
        "10400": {"comment":"CH_ADD = it"},
        "10403": {"comment":"HL = the old DEFADD"},
        "10404": {"comment":"DEFADD back"},
        "10407": {"comment":"Past the call's ')'"},
        "10411": {"synopsis":"HL on to the next byte that is not a space or control code (below $21).","comment":"The next byte"},
        "10412": {"comment":"A = it"},
        "10413": {"comment":"A space or control code?"},
        "10415": {"comment":"Then skipped"},
        "10418": {"synopsis":"Looks up the variable named at CH_ADD: a letter, then letters and digits (a long number\nname, spaces and case ignored), '$' (a string) or '(' (an array, or a string to slice). C is\nthe name's form ($60 + letter a number, $40 + letter a string, $20 + letter a long name, the\nletter alone for an array). Checking: no search.\nRunning: VARS is searched (NEXT_ITEM between items); inside a DEF FN call (DEFADD set) the\nfunction's parameters first (LV_DEF_FN).\nExit: carry when it is not there; HL = the variable's first byte (or the name's, when not\nfound); Z for a string or an array found, or, checking or not found, when '(' follows; NZ\nfor a number or a DEF FN parameter; FLAGS bit 6 set for a number; CH_ADD past the name.\nObserved: LET total value=5: PRINT TotalValue printed 5.","comment":"FLAGS bit 6: a number for now"},
        "10422": {"comment":"A = the character at CH_ADD"},
        "10423": {"comment":"A letter?"},
        "10426": {"comment":"No: report C"},
        "10429": {"comment":"The name's start kept"},
        "10430": {"comment":"The letter's number, 1-26"},
        "10432": {"comment":"C = it, an array's form"},
        "10433": {"comment":"The next character"},
        "10434": {"comment":"Its position kept"},
        "10435": {"comment":"'(': an array?"},
        "10437": {"comment":"Yes: searched for"},
        "10439": {"comment":"C = $40 + letter, a string"},
        "10441": {"comment":"'$'?"},
        "10443": {"comment":"Yes"},
        "10445": {"comment":"C = $60 + letter, a number"},
        "10447": {"comment":"A letter or digit next?"},
        "10450": {"comment":"No: a single letter"},
        "10452": {"synopsis":"A long name: past its letters and digits; C bit 6 cleared ($20 + letter).","comment":"Another letter or digit?"},
        "10455": {"comment":"No: the name ends"},
        "10457": {"comment":"C = $20 + letter, a long name"},
        "10459": {"comment":"The next character"},
        "10460": {"comment":"On"},
        "10462": {"synopsis":"A '$': past it; FLAGS bit 6 cleared (a string).","comment":"Past the '$'"},
        "10463": {"comment":"FLAGS bit 6 cleared: a string"},
        "10467": {"synopsis":"A simple name: inside DEF FN (DEFADD set) and running, the parameters first (LV_DEF_FN).","comment":"A = DEFADD's high byte"},
        "10470": {"comment":"Zero: not in a DEF FN?"},
        "10471": {"comment":"Then the ordinary search"},
        "10473": {"comment":"Checking?"},
        "10476": {"comment":"Running: the parameters first"},
        "10479": {"synopsis":"B = C. Checking: C = its top 3 bits with bit 7 set, and no search (LV_END).","comment":"B = the name's form"},
        "10480": {"comment":"Checking?"},
        "10483": {"comment":"No: VARS searched"},
        "10485": {"comment":"A = the form"},
        "10486": {"comment":"Only its top 3 bits"},
        "10488": {"comment":"Bit 7: checking"},
        "10490": {"comment":"C = it"},
        "10491": {"comment":"No search"},
        "10493": {"synopsis":"Running: from VARS.","comment":"HL = VARS"},
        "10496": {"synopsis":"One variable: its first byte without bit 7 against C; $80 ends the area (LV_NOT_FOUND).","comment":"A = the variable's first byte"},
        "10497": {"comment":"Bit 7 removed"},
        "10499": {"comment":"$80: the end of the area?"},
        "10501": {"comment":"The same letter and form?"},
        "10502": {"comment":"No: the next variable"},
        "10504": {"comment":"Bit 6 into bit 7"},
        "10505": {"comment":"Carry = bit 6, sign = bit 5"},
        "10506": {"comment":"Bit 5 clear: an array or string, found"},
        "10509": {"comment":"Bits 5 and 6: a number, found"},
        "10511": {"synopsis":"A long name: compared with the name in the line letter by letter, spaces skipped and case\nignored (OR $20); its last letter has bit 7 set.","comment":"DE = the name in the line, after its letter"},
        "10512": {"comment":"Kept"},
        "10513": {"comment":"The variable kept"},
        "10514": {"synopsis":"The next letter of each.","comment":"The variable's next letter"},
        "10515": {"synopsis":"Skips spaces in the line's name.","comment":"A = the line's next character"},
        "10516": {"comment":"Past it"},
        "10517": {"comment":"A space?"},
        "10519": {"comment":"Skipped"},
        "10521": {"comment":"Lower case"},
        "10523": {"comment":"The same letter?"},
        "10524": {"comment":"Yes: on"},
        "10526": {"comment":"As a last letter, bit 7 set"},
        "10528": {"comment":"The variable's last letter?"},
        "10529": {"comment":"No: not this one"},
        "10531": {"comment":"A = the line's next character"},
        "10532": {"comment":"A letter or digit: the name goes on?"},
        "10535": {"comment":"No: the names match"},
        "10537": {"synopsis":"Not this one.","comment":"HL = the variable"},
        "10538": {"synopsis":"The next variable (NEXT_ITEM).","comment":"The name's form kept"},
        "10539": {"comment":"NEXT_ITEM: DE = the next variable"},
        "10542": {"comment":"HL = it"},
        "10543": {"comment":"The form back"},
        "10544": {"comment":"Tested"},
        "10546": {"synopsis":"Not found: B bit 7 set.","comment":"B bit 7: not found"},
        "10548": {"synopsis":"Checking or not found: B bit 5 set unless '(' follows.","comment":"The position after the letter dropped"},
        "10549": {"comment":"A = the character at CH_ADD"},
        "10550": {"comment":"'('?"},
        "10552": {"comment":"Yes: Z on exit"},
        "10554": {"comment":"B bit 5: no '('"},
        "10556": {"comment":"To the exit"},
        "10558": {"synopsis":"A long name matched: the line's name must end here.","comment":"The variable's position dropped"},
        "10559": {"synopsis":"Found: HL = the variable.","comment":"The name's positions dropped"},
        "10561": {"comment":"The variable kept"},
        "10562": {"comment":"A = the character at CH_ADD"},
        "10563": {"synopsis":"Past the rest of the name in the line.","comment":"A letter or digit?"},
        "10566": {"comment":"No: the name's end"},
        "10568": {"comment":"Past it"},
