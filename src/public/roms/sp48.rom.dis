        "12010": {"comment":"Rounded"},
        "12012": {"synopsis":"One digit: the fraction x 10 (MUL10_ADD over its bytes), the carry out the digit.","comment":"B = 2 rounds (DE, then D'E'), C = 0 the carry"},
