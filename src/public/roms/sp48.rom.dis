        "15960": {"synopsis":"$4B - Character: 'K'"},
        "15968": {"synopsis":"$4C - Character: 'L'"},
        "15976": {"synopsis":"$4D - Character: 'M'"},
        "15984": {"synopsis":"$4E - Character: 'N'"},
        "15992": {"synopsis":"$4F - Character: 'O'"},
        "16000": {"synopsis":"$50 - Character: 'P'"},
        "16008": {"synopsis":"$51 - Character: 'Q'"},
