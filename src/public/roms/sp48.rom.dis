        "12833": {"synopsis":"Exponent $81 or more.","comment":"Exponent $91 (|x| from 65536 to 131071)?"},
        "12837": {"comment":"HL to the third mantissa byte"},
        "12840": {"comment":"Its top bit"},
        "12843": {"comment":"Or the second byte"},
        "12845": {"comment":"HL to the first mantissa byte"},
        "12846": {"comment":"Not 0: not -65536"},
        "12848": {"comment":"Is the first byte $80 (the sign set, nothing else)?"},
        "12851": {"synopsis":"Exponent $91: -65536 is kept as a small integer.","comment":"HL back to the exponent; Z for -65536"},
        "12852": {"comment":"Not -65536: its fraction bits"},
        "12854": {"comment":"-65536 as a small integer: 0, $FF"},
        "12859": {"comment":"And 24 bits cleared: 00 FF 00 00 00"},
        "12863": {"synopsis":"Below $91: becomes a small integer (TRUNC_SMALL).","comment":"Above $91: its fraction bits"},
        "12865": {"comment":"DE kept"},
        "12866": {"comment":"A = $90 - the exponent: the shifts to make it a whole number"},
        "12870": {"comment":"D and E = the top two mantissa bytes"},
