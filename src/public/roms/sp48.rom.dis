        "12370": {"comment":"No: swapped, so HL is the larger number"},
        "12373": {"synopsis":"The difference of the exponents: the smaller number shifted right by it.","comment":"A = the larger exponent, kept; B = the smaller"},
        "12374": {"comment":"A = the difference"},
        "12375": {"comment":"Both into the registers"},
