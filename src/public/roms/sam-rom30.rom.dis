        "8860": {"synopsis":"Verifies (VERIFY) or loads (anything else) a data block through LDVD_BODY.\nEntry: HL = the start; C, DE = the length.\nError: 19.","comment":"CURCMD"},
        "8863": {"comment":"VERIFY: carry clear"},
        "8867": {"synopsis":"Loads a data block: LDVD_BODY with carry set.\nEntry: HL = the start; C, DE = the length.\nError: 19.","comment":"Carry: load"},
        "8868": {"synopsis":"JLDVD's body (ROM0's jump table): loads (carry) or verifies a data block (flag byte $FF)\nfrom tape or the ROM's network (JLOAD_BODY), or through the DOS's hooks 130 (HLOAD) and 131\n(HVERY) with IX = $4B00.\nEntry: carry = load; HL = the start; C, DE = the length.\nError: 19 when the tape or network load fails.","comment":"The flag byte: $FF, data"},
        "8870": {"comment":"Keep it and the carry"},
        "8871": {"comment":"Tape or the ROM's network?"},
        "8874": {"comment":"Yes"},
        "8876": {"comment":"The DOS: the header buffer"},
        "8880": {"comment":"Load or verify?"},
        "8883": {"comment":"DOS hook 131 (HVERY): verify"},
        "8886": {"synopsis":"DOS hook 130 (HLOAD), then returns.","comment":"DOS hook 130 (HLOAD): load"},
        "8889": {"synopsis":"Tape or network: JLOAD_BODY; error 19 when it fails.","comment":"A, carry back"},
        "8890": {"comment":"Load or verify the block"},
        "8893": {"comment":"Worked?"},
        "8894": {"synopsis":"Stops with error code 19 (a length that does not match, or a failed load or verify). ROM1\n$D961 jumps here too.","comment":"Stops with error code 19"},
        "8896": {"synopsis":"Loads or verifies a SCREEN$ file: switches to the file's mode first (JMODE; $20 means the\ncurrent one), loads the bytes into the current screen at $8000; then, unless VERIFY and only\nwhen the file is longer than the screen, copies the 40 bytes after the screen to $55D8 (the\nscreen shown) or to $BFD8 (another), and when the next byte is below $C3 and less than 512\nbytes are left, copies those after them with interrupts off and sets LINE to $FF.\nEntry: the header found at $4B50.\nError: 19.","comment":"MODE"},
        "8899": {"comment":"C = it"},
        "8900": {"comment":"The file's mode byte"},
        "8904": {"comment":"$20: none given (a Spectrum screen)"},
        "8908": {"comment":"The current mode"},
        "8910": {"synopsis":"Changes to the file's mode when it is not the current one.","comment":"The same mode?"},
        "8911": {"comment":"No: JMODE to the file's mode"},
        "8914": {"comment":"HMPR: the current screen's page"},
        "8917": {"comment":"The length found"},
        "8920": {"comment":"C:DE = it"},
        "8923": {"comment":"The screen at $8000"},
        "8926": {"comment":"Keep the length's offset"},
        "8927": {"comment":"Load or verify the bytes"},
