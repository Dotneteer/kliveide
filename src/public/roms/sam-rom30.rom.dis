        "8934": {"comment":"VERIFY: done"},
        "8937": {"comment":"The file's mode"},
        "8940": {"comment":"Keep the length's offset"},
        "8941": {"comment":"DE = its screen's size"},
        "8944": {"comment":"HL = the length's offset"},
