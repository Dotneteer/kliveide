        {"name":"CHAN_OUT_DCEE","value":15789},
        {"name":"PRINT_UMSG","value":15792},
        {"name":"POMSG_R1","value":15796},
        {"name":"CELL_ADDR","value":15799},
        {"name":"CELL_ADDR_M4","value":15811},
        {"name":"CELL_ADDR_M2","value":15824},
        {"name":"CELL_ADDR_M1","value":15844},
        {"name":"CELL_ADDR_M3","value":15861},
        {"name":"CELL_M3_NARROW","value":15879},
        {"name":"CELL_PIXEL_ROW","value":15890},
        {"name":"PIXEL_ADDR","value":15905},
        {"name":"PIXEL_ADDR_M1","value":15931},
        {"name":"PIXEL_ADDR_M2","value":15960},
        {"name":"PIXEL_ADDR_M34","value":15971},
        {"name":"PIXEL_ATTR","value":15980},
        {"name":"ATTR_ADDR_M1","value":15987},
        {"name":"SET_ATTR_TEMP","value":15991},
        {"name":"ATTR_PAPER_FIX","value":16015},
        {"name":"ATTR_STORE","value":16027},
        {"name":"COMPARE_STRS","value":16029},
        {"name":"CMP_SETUP","value":16051},
        {"name":"CMP_LOOP","value":16069},
        {"name":"CMP_COUNT","value":16082},
        {"name":"CMP_DONE","value":16090},
        {"name":"RESTORE_KEEP_F","value":16091},
        {"name":"STR_TO_BUFFER","value":16100},
        {"name":"STR_BUF_ERR","value":16104},
        {"name":"STR_TO_BUF_255","value":16106},
        {"name":"STR_TO_BUF_LIM","value":16108},
        {"name":"UNSTK_STR_PAGE","value":16135},
        {"name":"ROOM_CHECK_KEEP","value":16148},
        {"name":"ROOM_CHECK_PAGES","value":16156},
        {"name":"ROOM_CHECK_END","value":16199},
        {"name":"NO_ROOM_ERR","value":16203},
        {"name":"TEXT_TO_WKSP","value":16205},
        {"name":"TEXT_WKSP_COPY","value":16212},
        {"name":"SAVE_VAR_LOC","value":16243},
        {"name":"ADDR_TO_PAGE","value":16268},
        {"name":"ADDR_PAGE_IN","value":16287},
        {"name":"PAGE_CUR_SCREEN","value":16296},
        {"name":"SAVE_HMPR_SCREEN","value":16305},
        {"name":"PAGE_SCREEN","value":16310},
        {"name":"READ_SCREEN_BYTE","value":16315},
        {"name":"RESTORE_PAGING","value":16319},
        {"name":"SET_CHADP_PAGE","value":16334},
        {"name":"CHADP_PAGE_R1OFF","value":16337},
        {"name":"CHADP_PAGE","value":16343},
        {"name":"UNSTK_STR_IN","value":16348},
        {"name":"SET_HMPR_PAGE","value":16351},
        {"name":"NEXT_PAGE_DE","value":16363},
        {"name":"NORM_HL","value":16367},
        {"name":"NEXT_PAGE_HL","value":16370},
        {"name":"HMPR_NEXT","value":16372},
        {"name":"PREV_PAGE_HL","value":16377}
      ],
      "lineAnnotations": {
        "0": {"synopsis":"RST $00: The reset entry, where the RESET button and power-on start the CPU. Disables\ninterrupts and goes on at RESET_WAIT.\nEntry: none.\nExit: does not return."},
        "4": {"synopsis":"Pops its return address into HL and continues there: a CALL $0004 returns with HL holding\nthe address after the CALL.\nEntry: none.\nExit: HL = the caller's return address.\nChanges: HL."},
        "5": {"synopsis":"JP (HL): a CALL $0005 calls the routine HL points to. The vectors (RST8V, RST28V, NMIV) are\ncalled this way.\nEntry: HL = the routine.\nExit: as the routine leaves it."},
        "6": {"synopsis":"JP (IY): a CALL $0006 calls the routine IY points to.\nEntry: IY = the routine.\nExit: as the routine leaves it."},
        "8": {"synopsis":"RST $08: The error and DOS hook restart. The byte after the RST is the code: below 128 an\nerror, 128 and up a DOS hook. Switches to the alternate registers and goes on at $37CE,\nwhich reads the code through the return address and calls RST8V if set.\nEntry: the code byte follows the RST.\nExit: past the code byte when a hook returns; an error does not return."},
        "15": {"synopsis":"The ROM version: 30 ($1E) in ROM 3.0, 31 in ROM 3.1, what PEEK 15 shows","comment":"PEEK 15: the ROM version"},
        "16": {"synopsis":"RST $10: Prints the character in A to the current stream (PRINT_A).\nEntry: A = the character.\nExit: through the current channel's output routine.\nKeeps: BC, DE, HL, IX."},
        "19": {"synopsis":"Prints BC bytes from DE to the current stream (PRINT_BLOCK_RUN).\nEntry: DE = the first byte; BC = the count.\nExit: DE past the last byte printed."},
        "22": {"synopsis":"PUSH BC / RET: a CALL $0016 calls the routine BC points to.\nEntry: BC = the routine.\nExit: as the routine leaves it."},
        "24": {"synopsis":"RST $18: Gets the current character of the BASIC line, skipping spaces and control codes\n(GET_CHAR_SKIP). The pointer is the word at $5A97.\nEntry: ($5A97) = the pointer.\nExit: A = the character; HL = its address, also stored at $5A97.\nChanges: AF, HL.\nKeeps: BC, DE."},
        "32": {"synopsis":"RST $20: Moves the BASIC line pointer at $5A97 on by one, then gets the character there as\nRST $18 does (SET_PTR_SKIP).\nEntry: ($5A97) = the pointer.\nExit: A = the next character that is not a space or control code; HL = its address, stored\nat $5A97.\nChanges: AF, HL.\nKeeps: BC, DE."},
        "40": {"synopsis":"RST $28: Calls the floating-point calculator (CALC_ENTRY) on the operation bytes after the\nRST, up to the one that ends the stream ($33-$38).\nEntry: the operation bytes follow the RST.\nExit: past the stream's last byte."},
        "43": {"synopsis":"Waits B DJNZ loops, then jumps to the routine IX points to.\nEntry: B = the count; IX = where to go.\nExit: as the routine leaves it.\nChanges: B."},
        "45": {"synopsis":"JP (IX): a CALL $002D calls the routine IX points to.\nEntry: IX = the routine.\nExit: as the routine leaves it."},
        "48": {"synopsis":"RST $30: From ROM0's code (below $4000), calls or jumps to the ROM1 address in the word\nafter the RST (RST30_HANDLER); from anywhere else, jumps to the address in RST30V, the\nuser's restart.\nEntry: from ROM0, the word follows the RST.\nExit: as the routine called leaves it, past the word."},
        "51": {"synopsis":"PUSH DE / RET: a CALL $0033 calls the routine DE points to.\nEntry: DE = the routine.\nExit: as the routine leaves it."},
        "53": {"synopsis":"Waits B DJNZ loops.\nEntry: B = the count.\nExit: B = 0.\nChanges: B."},
        "56": {"synopsis":"RST $38: The mode 1 interrupt entry. Saves AF, BC and HL, reads the status port ($F9) into C\nand LMPR ($FA) into B, pages ROM0, ROM1 and RAM page 0 (the system variables, at $4000) in\n(LMPR = $5F) and jumps to the address in ANYIV (INT_DEFAULT unless a program changed it).\nEntry: none.\nExit: through ANYIV, with B = the interrupted LMPR, C = the status port.","comment":"C = the interrupt status"},
        "61": {"comment":"B = the interrupted program's LMPR"},
        "65": {"comment":"ROM0 and ROM1 in, page 0 at $4000"},
        "69": {"comment":"ANYIV"},
        "73": {"synopsis":"The interrupt handler ANYIV starts with (ROM1's $EC77 stores $0049 there). Runs ROM1's\nhandler at $D42D on a stack at $4C00 with the interrupted SP saved at $5AD2, then puts back\nthe SP that handler returns in HL, restores LMPR from A, AF, BC and HL, and re-enables\ninterrupts.\nEntry: B = the interrupted LMPR, C = the status port (INT_ENTRY); AF, BC, HL on the stack.\nExit: returns to the interrupted program.","comment":"Saves the interrupted program's SP"},
        "80": {"comment":"Returns HL = the SP to go back to, A = its LMPR"},
        "92": {"synopsis":"Writes A to HMPR (port $FB) and jumps to HL: pages the upper half and enters it.\nEntry: A = the HMPR value; HL = where to go.\nExit: as the routine leaves it."},
        "95": {"synopsis":"A delay: counts BC down, stopping after the pass that sees BC = 0.\nEntry: BC = the count.\nExit: BC = $FFFF; A = 0.\nChanges: AF, BC."},
        "102": {"synopsis":"The NMI entry (the BREAK button). Pages ROM0 and RAM page 0 in (LMPR = $1F: ROM1 out, the\nsystem variables at $4000), saves the old LMPR at $5AD9 and SP at $5AD7, and on a stack at\n$5188 calls the routine in NMIV if it is not zero. Then restores the stack, LMPR, HL and AF\nand returns with RETN.\nEntry: none.\nExit: returns to the interrupted program.\nKeeps: all.","comment":"Old LMPR"},
        "122": {"comment":"NMIV: 0 for nothing to do"},
        "143": {"synopsis":"LDIR / RET, for callers that cannot use the instruction in place (ROM1 code running with\nROM0 paged in).\nEntry: HL, DE, BC as for LDIR.\nExit: as LDIR.\nChanges: BC, DE, HL, F."},
        "146": {"synopsis":"LDDR / RET.\nEntry: HL, DE, BC as for LDDR.\nExit: as LDDR.\nChanges: BC, DE, HL, F."},
        "149": {"synopsis":"CPIR / RET.\nEntry: A, HL, BC as for CPIR.\nExit: as CPIR.\nChanges: BC, HL, F."},
        "152": {"synopsis":"CPDR / RET.\nEntry: A, HL, BC as for CPDR.\nExit: as CPDR.\nChanges: BC, HL, F."},
        "155": {"synopsis":"OTIR / RET.\nEntry: HL, B, C as for OTIR.\nExit: as OTIR.\nChanges: B, HL, F."},
        "158": {"synopsis":"OTDR / RET.\nEntry: HL, B, C as for OTDR.\nExit: as OTDR.\nChanges: B, HL, F."},
        "161": {"synopsis":"Skips a number held in a BASIC line: if the byte at HL is $0E, moves HL past the 5 bytes\nafter it and reads the byte there.\nEntry: HL = the byte to test.\nExit: A = the byte at HL; HL past a number when there was one.\nChanges: AF, HL."},
        "162": {"synopsis":"SKIP_NUMBER with the byte already in A.\nEntry: A = (HL); HL = its address.\nExit: as SKIP_NUMBER.\nChanges: AF, HL.","comment":"A number's marker?"},
        "167": {"comment":"Low byte of the address past the marker and 5 bytes"},
        "171": {"comment":"The addition carried into the high byte"},
        "172": {"synopsis":"LD A,(HL) / RET. PEEK_HL_R1OFF calls it with ROM1 paged out.\nEntry: HL = the address.\nExit: A = the byte.\nChanges: A."},
        "174": {"synopsis":"LD A,(DE) / RET.\nEntry: DE = the address.\nExit: A = the byte.\nChanges: A."},
        "176": {"synopsis":"The reset's start: waits about $FA00 loops, pages ROM0, ROM1 and RAM page 0 in (LMPR = $5F)\nand continues in ROM1 at $EBAE.\nEntry: none.\nExit: does not return."},
        "178": {"synopsis":"The reset's delay loop.\nEntry: BC = the count.\nExit: BC = 0."},
        "190": {"synopsis":"Stores HL at $5A97 as the BASIC line pointer, then gets the character there as RST $18 does.\nEntry: HL = the new pointer; BC on the stack (popped on exit).\nExit: as GET_CHAR_SKIP."},
        "193": {"synopsis":"Gets the character at HL, skipping spaces and control codes other than ENTER ($0D), with\nROM1 paged out so a line at $C000 and up can be read. Each skipped byte moves the pointer at\n$5A97 on.\nEntry: HL = the pointer; BC on the stack (popped on exit).\nExit: A = the character; HL = its address, stored at $5A97; LMPR as on entry.\nChanges: AF, HL."},
        "196": {"comment":"ROM1 out"},
        "200": {"synopsis":"Reads the byte at HL: one above $20 is the character; ENTER ends too; anything else is\nskipped.\nEntry: HL = the pointer; B = the LMPR to restore.\nExit: to SKIP_SPACES_END or SKIP_SPACES_CR."},
        "201": {"comment":"Printable?"},
        "205": {"synopsis":"Puts LMPR back from B and returns, popping the BC that RST $18 and RST $20 pushed.\nEntry: B = the LMPR to restore; BC on the stack.\nExit: BC restored."},
        "211": {"synopsis":"A space or control code: stops at ENTER, else moves the pointer on and reads the next byte.\nEntry: A = the byte; HL = its address.\nExit: loops to SKIP_SPACES_LP or stops at SKIP_SPACES_END.","comment":"ENTER?"},
        "221": {"synopsis":"Moves the BASIC line pointer at $5A97 on by one and reads the byte there, skipping nothing\nand paging nothing.\nEntry: ($5A97) = the pointer.\nExit: A = the byte; HL = its address, stored at $5A97.\nChanges: AF, HL."},
        "230": {"synopsis":"The calculator's entry (RST $28): swaps IX with the return address, so IX points to the\noperation bytes, saves BC at $5B86, pages ROM1 in and runs the calculator at $C7B7. On\nreturn the stack holds IX past the stream, so that is where the RST returns to; IX, BC and\nLMPR are put back.\nEntry: the operation bytes follow the RST.\nExit: past the stream.\nKeeps: BC, IX.","comment":"IX = the operation bytes, the caller's IX saved"},
        "239": {"comment":"ROM1 in"},
        "247": {"comment":"Return past the stream; IX restored"},
        "249": {"synopsis":"The calculator's exit: restores BC from $5B86, puts LMPR back from A and returns. ROM1's\n$C850 ends here too, for the operations that also return from the calculator's caller.\nEntry: A = the LMPR to restore.\nExit: BC restored."},
        "256": {"synopsis":"JSCRN: Selects the screen given in C (1-16), as SCREEN does. An error if it is not open.\nJumps to ROM1's $D256.\nEntry: C = the screen."},
        "259": {"synopsis":"JSVIN: Calls the routine named by the word after the CALL with the system variables paged in\n(SVIN_CALL).\nEntry: the routine's address follows the CALL.\nExit: as the routine leaves it, past the word.\nChanges: F, BC', DE', HL'; interrupts enabled."},
        "262": {"synopsis":"JHEAPROOM: Reserves BC bytes of the system heap (BC positive) or gives them back (BC\nnegative). Jumps to ROM1's $E877.\nEntry: BC = the bytes.\nExit: carry set when it worked."},
        "265": {"synopsis":"JWKROOM: Opens BC bytes of workspace.\nEntry: BC = the bytes.\nExit: DE = the space."},
        "268": {"synopsis":"JMKRBIG: Opens A 16K pages and BC bytes at HL in section C.\nEntry: A = the pages; BC = the bytes; HL = where."},
        "271": {"synopsis":"JCALLBAS: Calls the BASIC subroutine at line HL.\nEntry: HL = the line number.\nExit: A = the error code, 0 if none."},
        "274": {"synopsis":"JSETSTRM: Selects the stream in A ($FB-$FF, or $00-$03).\nEntry: A = the stream."},
        "277": {"synopsis":"JPOMSG: Prints message number A of the table at DE.\nEntry: A = the message number; DE = the table."},
        "280": {"synopsis":"JEXPTINUM: Checks the syntax of, or evaluates, a numeric expression.\nEntry: the BASIC line pointer at the expression."},
        "283": {"synopsis":"JEXPTSTR: Checks the syntax of, or evaluates, a string expression.\nEntry: the BASIC line pointer at the expression."},
        "286": {"synopsis":"JEXPTEXPR: Checks the syntax of, or evaluates, an expression of either kind.\nEntry: the BASIC line pointer at the expression."},
        "289": {"synopsis":"JGETINT: Takes a number off the calculator stack into HL. An error if it rounds to less than\n0 or more than 65535.\nEntry: a number on the calculator stack.\nExit: HL = the number."},
        "292": {"synopsis":"JSTRFETCH: Takes the last value off the calculator stack into AEDCB; a string gives its\npage, start and length (in BC).\nEntry: a value on the calculator stack.\nExit: A, E, D, C, B = the value."},
        "295": {"synopsis":"JSTKSTORE: Puts AEDCB on the calculator stack.\nEntry: A, E, D, C, B = the value."},
        "298": {"synopsis":"JSBUFFET: Copies a string from the calculator stack to a buffer in the system page. An error\nif it is empty or over 255 characters.\nEntry: a string on the calculator stack."},
        "301": {"synopsis":"JFARLDIR: Copies from page A, offset HL to page C, offset DE (LDIR).\nEntry: A, HL = the source; C, DE = the destination; the length as the manual gives it."},
        "304": {"synopsis":"JFARLDDR: JFARLDIR copying downwards (LDDR).\nEntry: as JFARLDIR."},
        "307": {"synopsis":"JPUT: Places a block on the screen (modes 3 and 4 only)."},
        "310": {"synopsis":"JGRAB: Stores a block of the screen in a buffer (modes 3 and 4 only)."},
        "313": {"synopsis":"JPLOT: Plots the pixel at C,B (HL,B for the thin pixels of mode 3).\nEntry: C (or HL) = x; B = y."},
        "316": {"synopsis":"JDRAW: Draws a horizontal or vertical line."},
        "319": {"synopsis":"JDRAWTO: Draws a line to C,B (HL,B in mode 3).\nEntry: C (or HL) = x; B = y."},
        "322": {"synopsis":"JCIRCLE: Draws a circle at C,B of radius A.\nEntry: C = x; B = y; A = the radius."},
        "325": {"synopsis":"JFILL: Fills from C,B with the 16x16 pattern at DE, or with the current PEN when DE is 0\n(modes 3 and 4 only).\nEntry: C = x; B = y; DE = the pattern or 0."},
        "328": {"synopsis":"JBLITZ: Runs the string of BC graphics commands at DE.\nEntry: DE = the commands; BC = their length."},
        "331": {"synopsis":"DROLL (the manual's name, without J): Scrolls or rolls part of the screen (modes 3 and 4\nonly)."},
        "334": {"synopsis":"JCLSBL: Clears the screen (A = 0) or its upper part.\nEntry: A = what to clear."},
        "337": {"synopsis":"JCLSLOWER: Clears the lower screen and selects channel K."},
        "340": {"synopsis":"JPALET (the manual prints JPA.LET): With A = $FF, sets palette entry E's colours in PALTAB\nfrom BC; otherwise sets a palette change at line A. Jumps to ROM1's $EE5D.\nEntry: A = $FF or the line; E = the entry; BC = the colours."},
        "343": {"synopsis":"JOPSCR: Opens screen C (2-16) in mode B. Jumps to ROM1's $D38A.\nEntry: C = the screen; B = the mode."},
        "346": {"synopsis":"JMODE: Sets the screen mode from A (0-3 for modes 1-4). Jumps to ROM1's $D6EB.\nEntry: A = the mode."},
        "349": {"synopsis":"JTDUMP: Dumps the text screen, when a dump utility is installed. Jumps to ROM1's $F20C."},
        "352": {"synopsis":"JGDUMP: Dumps the graphics screen, when a dump utility is installed. Jumps to ROM1's $F20B."},
        "355": {"synopsis":"JRECLAIM: Reclaims BC bytes at HL.\nEntry: HL = the bytes; BC = how many."},
        "358": {"synopsis":"JRBFLUSH (the manual's spelling): Empties the keyboard buffer."},
        "361": {"synopsis":"JREADREY (the manual's spelling): Reads the keyboard and empties the buffer, as INKEY$ does.\nExit: A = the key."},
        "364": {"synopsis":"JWAITREY (the manual's spelling): Reads the next key into A, waiting for one if needed.\nExit: A = the key."},
        "367": {"synopsis":"JBEEP: A beep of DE-1 cycles with a period of HL x 8 T-states. Jumps to ROM1's $EF1B.\nEntry: DE = the cycles + 1; HL = the period / 8."},
        "370": {"synopsis":"JSAVE: Saves CDE bytes from HL to tape or the network, as SLDEVT says. Jumps to ROM1's\n$E608.\nEntry: HL = the start; C, D, E = the length."},
        "373": {"synopsis":"JLOAD: Loads when carry is set, verifies when it is reset. Jumps to ROM1's $E60E.\nEntry: carry = load.\nExit: carry set when it worked."},
        "376": {"synopsis":"JLDVD: Loads or verifies data (not a header) from disk, tape or the network, as SLDEVT says.\nAn error if it fails. Jumps to ROM1's $E2A4."},
        "379": {"synopsis":"A jump table entry: jumps to $2045. The manual's list has JEDGE2 near here, but prints its\naddress as 0178H, so the name is not used."},
        "382": {"synopsis":"JSTRS: Makes the ASCII form of the number on top of the calculator stack in a buffer. Jumps\nto ROM1's $D997.\nEntry: a number on the calculator stack."},
        "385": {"synopsis":"JSENDA: Sends A to the parallel printer. An error if ESC is pressed. Jumps to ROM1's $E85D.\nEntry: A = the byte."},
        "388": {"synopsis":"JMCHAR: Looks for a character of the main or UDG set on the screen at line D, column E.\nJumps to ROM1's $F230.\nEntry: D = the line; E = the column.\nExit: carry reset when found, A = $20-$7F (main set) or $80-$A8 (UDG); carry set when not.\nThe manual says carry set when found; the code says the reverse (SCREEN$ at ROM1 $F229\ntakes NC as found)."},
        "391": {"synopsis":"A jump table entry: jumps to $2765. The manual's next name, JGRCOMP, is printed with a\ngarbled address, so it is not used here."},
        "394": {"synopsis":"A jump table entry past the manual's list: jumps to ROM1's $D6B0."},
        "397": {"synopsis":"A jump table entry past the manual's list: jumps to ROM1's $D2DB."},
        "411": {"synopsis":"Prints the digit in A (0-9) as its character.\nEntry: A = the digit.\nExit: as PRINT_A.\nChanges: AF, E."},
        "414": {"synopsis":"RST $10's body: calls the output routine of the current channel (the first word of the\nchannel CURCHL, $5C51, points to) with A.\nEntry: A = the character.\nExit: as the channel's routine leaves AF.\nKeeps: BC, DE, HL, IX.","comment":"CURCHL: the current channel"},
        "442": {"synopsis":"Calls the input routine of the current channel (the second word of the channel CURCHL points\nto), with the main registers kept in the alternates.\nEntry: none.\nExit: as the channel's routine leaves AF.\nChanges: DE'; the input routine's results."},
        "455": {"synopsis":"Jumps to the address in the word at HL.\nEntry: HL = the word.\nExit: as the routine leaves it.\nChanges: DE, HL."},
        "463": {"synopsis":"RST $30's body. With a return address below $4000 (ROM0's code) it reads the word there:\nwith bit 15 set, a call to that ROM1 address (the RST returns past the word); with bit 15\nclear, a jump to the address with bit 15 set. ROM1 is paged in for the routine and LMPR put\nback after it; BC is passed through $5B47. Any other caller jumps to the address in RST30V.\nEntry: the word follows the RST.\nExit: as the routine leaves it.; AF, BC and HL reach the routine as they were.","comment":"HL = the return address"},
        "466": {"comment":"From ROM0's code?"},
        "470": {"comment":"BC for the routine"},
        "478": {"comment":"A call?"},
        "482": {"comment":"A jump: the address in ROM1, the return dropped"},
        "488": {"synopsis":"RST $30 calling: leaves the address past the word as the return address.\nEntry: BC = the routine; HL, AF as in RST30_HANDLER.\nExit: as the routine leaves it."},
        "490": {"synopsis":"Pages ROM1 in and runs the routine at BC (PAGED_CALL).\nEntry: BC = the routine; AF' = the caller's AF.\nExit: as the routine leaves it; LMPR put back."},
        "498": {"synopsis":"RST $30 from code outside ROM0: jumps to the address in RST30V with every register as it\nwas.\nEntry: AF, the old HL and the return address on the stack.\nExit: as RST30V's routine leaves it.","comment":"RST30V"},
        "506": {"synopsis":"Jumps to the address in the word after the CALL, with ROM1 paged out. The return address is\ndropped. ROM1 uses it to go on in ROM0.\nEntry: the address follows the CALL.\nExit: does not return here.\nChanges: BC."},
        "513": {"synopsis":"Calls the address in the word after the CALL with ROM1 paged out, and returns past the word\nwith LMPR put back. ROM1 uses it to call ROM0.\nEntry: the address follows the CALL.\nExit: as the routine leaves it, past the word.\nChanges: BC: the routine gets BC from $5B47, which only RST $30 sets."},
        "519": {"synopsis":"CALL_BC_R1OFF with AF exchanged with AF' first.\nEntry: BC = the routine.\nExit: as CALL_BC_R1OFF."},
        "520": {"synopsis":"Calls the routine at BC with ROM1 paged out, then puts LMPR back.\nEntry: BC = the routine; AF' = the AF the routine gets.\nExit: as the routine leaves it; LMPR as on entry.","comment":"ROM1 out"},
        "525": {"synopsis":"Writes A to LMPR, calls the routine at BC with BC restored from $5B47, then puts back the\nLMPR saved on the stack.\nEntry: A = the LMPR for the routine; BC = the routine; ($5B47) = its BC; the old LMPR on the\nstack.\nExit: as the routine leaves it."},
        "537": {"synopsis":"Jumps to BC with BC restored from $5B47.\nEntry: BC = where to go; ($5B47) = the BC to pass.\nExit: as the routine leaves it."},
        "543": {"synopsis":"Pages ROM1 out and jumps to BC.\nEntry: BC = where to go.\nExit: as the routine leaves it."},
        "551": {"synopsis":"PRINT_BLOCK's body: prints BC bytes from DE through RST $10, with ROM1 paged out. When the\ncurrent channel's output routine starts with $40, calls the routine 3 bytes on to take the\nwhole block at once instead. Past $BFFF, $3FEB moves DE on to the next page.\nEntry: DE = the bytes; BC = the count.\nExit: DE past the bytes; LMPR as on entry.\nChanges: AF, BC, DE, HL.","comment":"HL = the current channel's output routine"},
        "568": {"comment":"A routine that takes a whole block?"},
        "580": {"synopsis":"Prints one byte and moves on, past a page end when DE reaches $C000.\nEntry: DE = the byte; BC = the bytes left.\nExit: loops to PRINT_BLOCK_TEST."},
        "589": {"synopsis":"Any bytes left?\nEntry: BC = the bytes left.\nExit: loops to PRINT_BLOCK_LP or ends."},
        "594": {"synopsis":"Puts LMPR back and returns.\nEntry: the old LMPR on the stack.\nExit: LMPR restored."},
        "598": {"synopsis":"Reads the byte at HL with ROM1 paged out (LD_A_HL_RET through CALL_INLINE).\nEntry: HL = the address.\nExit: A = the byte.\nKeeps: BC, DE, HL."},
        "606": {"synopsis":"JSVIN's body: reads the routine's address from the word after the CALL, pages ROM0 and RAM\npage 0 in (LMPR = $1F: ROM1 out, the system variables at $4000) with interrupts off,\nswitches to a stack at $4EC0 (the old SP saved at $5AD5) and calls the routine with A as it\ncame. SVIN_RETURN puts the stack and LMPR back.\nEntry: the address follows the CALL; A for the routine.\nExit: as the routine leaves it, past the word.\nChanges: BC', DE', HL'; interrupts enabled.","comment":"HL' = the word after the CALL"},
        "617": {"comment":"ROM0 in, ROM1 out, page 0 at $4000"},
        "631": {"comment":"The routine returns to SVIN_RETURN"},
        "639": {"synopsis":"Where a JSVIN routine returns: puts back the stack saved at $5AD5 and the caller's LMPR,\nkeeping the routine's AF.\nEntry: the old LMPR on the stack.\nExit: returns past JSVIN's word.\nKeeps: AF, BC, DE, HL."},
        "651": {"synopsis":"Nine start-up values: ROM1's $ECB9 copies them to $5C0C-$5C1D, each followed by the byte in\nC. ROM1's $D2B2 also reads $0290-$0293 by an index 0-3"},
        "660": {"synopsis":"The line editor's error return: ERRSP points at the word holding this address while a line\nis edited. On channel K or S with DEVICE = 1 it sounds the error beep, clears ERRNR and\nstarts editing again at ED_RESTART; otherwise it leaves through ED_EXIT, which passes the\nerror on.\nEntry: an error stopped the editor.\nExit: to ED_RESTART, or through ED_EXIT.","comment":"Channel K or S?"},
        "663": {"comment":"No: leave, passing the error on"},
        "666": {"comment":"DEVICE 1: error beep, ERRNR cleared"},
        "669": {"comment":"Edit the line again"},
        "671": {"synopsis":"Clears XPTR's high byte and ERRNR, then falls into ED_START. ROM1 calls it at $C3F2.\nEntry: none.\nExit: as ED_START.","comment":"XPTR's high byte = 0"},
        "675": {"comment":"ERRNR = 0"},
        "678": {"synopsis":"The line editor: calls the EDITV hook when it is set, keeps ERRSP and the print position\n(OLDPOS), and then reads keys into the line being edited (the edit line at ELINE, or the\nworkspace when FLAGE bit 5 is set) until a key ends it.\n1. EDITV, when not 0, is called through CALL_HL.\n2. The old ERRSP is stacked; OLDPOS = the position $3D89 gives for DEVICE.\n3. ED_RESTART sets ED_ERROR_RET as the error return and loops in ED_KEY_LOOP.\nEntry: the line to edit is in place.\nExit: ED_EXIT returns to the caller when ERRNR is 0.\nChanges: all.","comment":"EDITV: the editor's hook"},
        "681": {"comment":"Set?"},
        "683": {"comment":"Yes: call it"},
        "686": {"comment":"Keep the old ERRSP"},
        "690": {"comment":"DE = the print position for DEVICE"},
        "693": {"comment":"OLDPOS = it"},
        "697": {"synopsis":"Makes ED_ERROR_RET the error return (ERRSP), offers the next AUTO line number\n(ED_AUTO_NUMBER) and goes on into ED_KEY_LOOP.","comment":"Errors come back to ED_ERROR_RET"},
        "705": {"comment":"Put in the next AUTO line number, if any"},
        "708": {"synopsis":"Reads a key (ED_GET_KEY) and clicks; a code 7-15 goes through the offset table\nED_KEY_OFFSETS with HL = KCUR, codes 16-21 are put in with the parameter key after them, and\nany other code is put in at the cursor (ED_INSERT_CHAR). Each handler returns here: the loop\npushes its own address.","comment":"Each handler returns to this loop"},
        "712": {"comment":"A = the key"},
        "716": {"comment":"Click"},
        "720": {"comment":"Code $16 or more?"},
        "724": {"comment":"Below 7?"},
        "728": {"comment":"$10-$15?"},
        "732": {"comment":"Codes 7-15: the offset table, ED_KEY_OFFSETS at $0370"},
        "735": {"comment":"C = the key for the handler"},
        "740": {"comment":"E = the handler's offset from its own byte"},
        "742": {"comment":"The handler is the return address"},
        "743": {"comment":"HL = KCUR, its page in; on to the handler"},
        "746": {"synopsis":"Puts code A ($10-$15) in at the cursor, waits for the next key and puts that in after it.","comment":"The code"},
        "749": {"comment":"The next key is its parameter"},
        "752": {"comment":"Put it in too"},
        "754": {"synopsis":"The output routine of channel R (the channel table read by ROM1 at $FC54 names it): puts the\ncharacter into the line being edited at the cursor (ED_INSERT_CHAR). Codes $85 and up go to\nROM1's $DCBE unless INQUFG bit 0 is set; a space sets FLAGS bit 0, any other character\nresets it, and a ':' sets it when LSTFT is not 0.\nEntry: A = the character.\nChanges: AF, HL, BC, DE.","comment":"$85 or more?"},
        "758": {"comment":"FLAGS"},
        "761": {"comment":"A space?"},
        "765": {"comment":"Not a space: FLAGS bit 0 off"},
        "767": {"comment":"A ':'?"},
        "771": {"comment":"LSTFT"},
        "774": {"comment":"0?"},
        "777": {"comment":"Yes: put the ':' in"},
        "779": {"synopsis":"Sets FLAGS bit 0 and puts the character in (CHAN_R_OUTPUT).","comment":"FLAGS bit 0 on"},
        "783": {"synopsis":"CHAN_R_OUTPUT for a code $85 or more: put in as it is when INQUFG bit 0 is set, otherwise\nhanded to ROM1's $DCBE."},
        "784": {"comment":"INQUFG"},
        "787": {"comment":"Bit 0 set?"},
        "789": {"comment":"Yes: put the code in as it is"},
        "791": {"comment":"No: ROM1 $DCBE takes it"},
        "794": {"synopsis":"Puts A into the line being edited at KCUR and moves KCUR past it. The paging is kept.\nEntry: A = the byte.\nExit: KCUR advanced.\nChanges: AF, BC, DE, HL, IY.","comment":"B = the byte"},
        "795": {"comment":"Keep LMPR and HMPR"},
        "799": {"comment":"HL = KCUR, its page in"},
        "802": {"comment":"Make room for 1 byte there"},
        "808": {"comment":"A = the byte"},
        "811": {"comment":"KCUR = past it"},
        "814": {"comment":"Paging back"},
        "817": {"synopsis":"Waits for a key for the editor. Codes $C0-$C9 are '0'-'9' while KPFLG bit 0 is set; any\nother code from $C0 up that has a definition in the DKDEF list has its text put in at the\ncursor (ED_KEY_DEFN).\nEntry: none.\nExit: A = the key; or the defined text was put in and the return goes elsewhere\n(ED_KEY_DEFN).\nChanges: AF, BC, DE, HL.","comment":"A = the key"},
        "820": {"comment":"Below $C0: as it is"},
        "823": {"comment":"$CA or more?"},
        "828": {"comment":"KPFLG"},
        "831": {"comment":"Bit 0 set?"},
        "835": {"comment":"$C0-$C9 become '0'-'9'"},
        "838": {"synopsis":"A key from $C0 up: looks its definition up in DKDEF (KEYDEF_FIND). With none, returns A =\nthe key. Otherwise the text is put in at the cursor, without a last ':', and the return\naddress is dropped: a text that ended with ':' goes back to ED_KEY_LOOP, any other ends the\nline as ENTER does (ED_ENTER).\nEntry: A = the key.\nExit: A = the key with carry, when it has no definition.","comment":"HL = the text, BC = its length?"},
        "841": {"comment":"None: A = the key"},
        "843": {"comment":"Keep the text's address"},
        "844": {"comment":"HL = its last byte"},
        "847": {"comment":"A ':' at the end?"},
        "851": {"comment":"Yes: leave it out"},
        "852": {"synopsis":"Makes room at KCUR for the definition's text, copies it there and moves KCUR past it; then\nreturns to ED_KEY_LOOP (the text ended with ':') or ends the line (ED_ENTER).","comment":"Z: the text ended with ':'"},
        "854": {"comment":"HL = KCUR, its page in"},
        "857": {"comment":"Make room for BC bytes"},
        "860": {"comment":"DE = the room"},
        "863": {"comment":"HL = the text"},
        "865": {"comment":"Copy it in"},
        "868": {"comment":"KCUR = past the copy"},
        "871": {"comment":"Click"},
        "875": {"comment":"Drop the return to the caller"},
        "876": {"comment":"No ':' at the end: end the line"},
        "879": {"comment":"Back to ED_KEY_LOOP"},
        "880": {"synopsis":"The offsets of the editor's handlers for the codes 7-15, one byte each, counted from the\nbyte itself (read at $02E4): 7 ED_KEY_EDIT, 8 ED_CURSOR_LEFT, 9 ED_CURSOR_RIGHT, 10 and 11\nED_CURSOR_UPDN, 12 ED_DELETE_LEFT, 13 ED_ENTER, 14 ED_DELETE_RIGHT, 15 ED_KEYPAD_TOGGLE."},
        "889": {"synopsis":"The editor's code 7. In the workspace (FLAGE bit 5) it empties the line. Otherwise a line\nnumber alone in the edit line (not 0) becomes EPPC; the edit line is emptied and the program\nline $1A4D finds for EPPC (the one before it at the program's end) is listed into it through\nstream $FF, with LISTFLG off and EPPC's high byte $FF meanwhile. KCUR ends at ELINE + 5.\nEntry: HL = KCUR.\nExit: ret when there is no line.","comment":"FLAGE"},
        "892": {"comment":"Bit 5 set?"},
        "894": {"comment":"Yes: just empty the line"},
        "897": {"comment":"A line number in the edit line?"},
        "902": {"comment":"Nothing after it?"},
        "907": {"comment":"Not 0?"},
        "911": {"comment":"Yes: EPPC = it"},
        "915": {"synopsis":"Empties the line being edited and lists the program line $1A4D finds for EPPC into it\n(ED_KEY_EDIT's second part).","comment":"Empty the line"},
        "918": {"comment":"Find line EPPC"},
        "924": {"comment":"DE = its number, or the previous line's"},
        "927": {"comment":"No line?"},
        "930": {"comment":"Keep CURCHL"},
        "935": {"comment":"Keep EPPC's high byte"},
        "940": {"comment":"EPPC's high byte $FF while listing"},
        "945": {"comment":"Stream $FF"},
        "948": {"comment":"LISTFLG"},
        "952": {"comment":"Kept in LSTFT"},
        "955": {"comment":"LISTFLG off"},
        "957": {"comment":"HL = the line, LISTFLG's address kept"},
        "959": {"comment":"ROM1 $F314 lists the line"},
        "963": {"comment":"LISTFLG back"},
        "967": {"comment":"EPPC's high byte back"},
        "971": {"comment":"KCUR = ELINE + 5"},
        "981": {"comment":"The channel back"},
        "985": {"synopsis":"The editor's code 8: moves KCUR back one character, over both bytes of a two-byte item (one\nstarting with $FF).\nEntry: HL = KCUR.\nExit: carry set when the cursor was at the start already; HL = KCUR.\nChanges: AF, DE, HL.","comment":"DE = the start of the line"},
        "988": {"synopsis":"One byte back; stops at the start of the line, and again when the byte before is $FF.","comment":"Before the start?"},
        "992": {"comment":"Yes: no move"},
        "993": {"comment":"At the start: there"},
        "995": {"comment":"The byte before"},
        "998": {"comment":"$FF?"},
        "999": {"comment":"Yes: one more back"},
        "1003": {"synopsis":"The editor's code 9: moves KCUR on one character, over both bytes of a two-byte item ($FF\nfirst); not past the line's $0D.\nEntry: HL = KCUR.\nChanges: AF, HL.","comment":"The byte at the cursor"},
        "1005": {"comment":"The end of the line?"},
        "1008": {"comment":"$FF?"},
        "1009": {"comment":"Yes: past the next byte too"},
        "1011": {"synopsis":"Stores HL as KCUR."},
        "1015": {"synopsis":"The editor's codes 10 and 11: when the edit line is empty (and not the workspace), $0843\ntakes the code. Otherwise KPOS's high byte goes up by 1 (10) or down by 1 (11), KCUR is put\nat the end of the line, and the line is drawn again (ROM1 $F494 through $0576) with channel\nCHANS' first output address set to ED_ROW_OUTPUT; then MNOP is put back there.\nEntry: C = the code.","comment":"A = the code"},
        "1016": {"comment":"FLAGE"},
        "1019": {"comment":"Bit 5 set: the workspace"},
        "1023": {"comment":"HL = ELINE"},
        "1026": {"comment":"Empty edit line?"},
        "1030": {"comment":"Yes: $0843 takes the code"},
        "1033": {"synopsis":"Changes KPOS's high byte for code 10 (+1) or 11 (-1).","comment":"KPOS's high byte"},
        "1036": {"comment":"Code 11?"},
        "1040": {"comment":"Code 10: +1 overall"},
        "1042": {"synopsis":"Takes 1 from the byte at HL (KPOS's high byte)."},
        "1043": {"comment":"The output goes to ED_ROW_OUTPUT"},
        "1049": {"comment":"WORKSP - 1"},
        "1053": {"comment":"FLAGE"},
        "1056": {"comment":"Bit 5 set?"},
        "1060": {"comment":"Yes: WKEND instead"},
        "1063": {"synopsis":"Sets KCUR one byte before HL, clicks, draws the line again and puts MNOP back as CHANS'\nfirst output address."},
        "1064": {"comment":"KCUR = it"},
        "1067": {"comment":"Click"},
        "1070": {"comment":"Draw the line again"},
        "1073": {"comment":"MNOP: the output routine back"},
        "1077": {"synopsis":"Stores DE as the output address of the first channel at CHANS.\nEntry: DE = the routine.\nChanges: HL.","comment":"The first channel"},
        "1082": {"synopsis":"The editor's code 15: adds 1 to KPFLG, flipping bit 0, which makes $C0-$C9 digits\n(ED_GET_KEY).","comment":"KPFLG"},
        "1087": {"synopsis":"The editor's code 14: removes the character at the cursor, unless it is the line's $0D.\nEntry: HL = KCUR.","comment":"At the cursor"},
        "1088": {"comment":"The end of the line?"},
        "1093": {"synopsis":"The editor's code 12: moves the cursor back a character (ED_CURSOR_LEFT) and removes it.\nEntry: HL = KCUR.","comment":"Back one"},
        "1096": {"comment":"At the start: nothing"},
        "1097": {"synopsis":"Removes the character at HL: 2 bytes for an $FF item, else 1. When the byte before is a code\n$10-$15 (whose parameter this is), KCUR is put past the parameter and the byte removed is\nthe code.","comment":"2 bytes when an $FF item"},
        "1100": {"comment":"$FF?"},
        "1104": {"comment":"1 byte"},
        "1105": {"comment":"The byte before"},
        "1108": {"comment":"$16 or more?"},
        "1112": {"comment":"Below $10?"},
        "1116": {"comment":"$10-$15: KCUR past the parameter"},
        "1120": {"comment":"HL = the code"},
        "1122": {"synopsis":"Removes BC bytes at HL ($1E52)."},
        "1125": {"synopsis":"The editor's code 13 (and the end of a defined key's text): drops the loop's two return\naddresses and leaves through ED_EXIT.","comment":"Drop the return to ED_KEY_LOOP"},
        "1126": {"comment":"Drop ED_ERROR_RET"},
        "1127": {"synopsis":"Leaves the editor: ERRSP gets back the value stacked by ED_START. With ERRNR 0 it returns\nto the editor's caller; otherwise the stack is put at the old ERRSP and the error goes on\nthere.\nEntry: the old ERRSP on the stack.\nExit: ERRSP restored.","comment":"The old ERRSP"},
        "1128": {"synopsis":"ED_EXIT with the old ERRSP in HL (ROM1 calls it at $C2DA).","comment":"ERRSP back"},
        "1131": {"comment":"An error?"},
        "1135": {"comment":"No: return"},
        "1136": {"comment":"Yes: on to the old error return"},
        "1138": {"synopsis":"Puts OPSTORE back as the output address of the current channel.\nChanges: DE, HL.","comment":"OPSTORE"},
        "1142": {"synopsis":"Stores DE as the output address of the current channel (the first word CURCHL points at).\nEntry: DE = the routine.\nChanges: HL.","comment":"CURCHL"},
        "1145": {"synopsis":"Stores DE at HL, low byte first.\nChanges: HL (+1)."},
        "1149": {"synopsis":"An output routine ROM1 installs at $DEE0: keeps the byte at $5BBF (TVDATA's second byte) and\nmakes $3DA7 the current channel's output routine for the next one.\nEntry: A = the byte.","comment":"The next byte goes to $3DA7"},
        "1152": {"comment":"TVDATA's second byte"},
        "1157": {"synopsis":"The output routine set while ED_CURSOR_UPDN draws the line: jumps to ROM1's $F51F."},
        "1160": {"synopsis":"When DEVICE is 1 (the lower screen), sounds the error beep (ERROR_BEEP). Otherwise jumps to\nED_EXIT with this call's return address still on the stack. ROM1 calls it at $F4F7.\nEntry: none.","comment":"DEVICE"},
        "1163": {"comment":"1: the lower screen?"},
        "1166": {"synopsis":"Clears ERRNR and sounds a beep of ERRSOUND cycles with H = 7 (JBEEP's body, ROM1 $EF1B).\nChanges: AF, DE, HL; as JBEEP.","comment":"The period's high byte"},
        "1168": {"comment":"ERRNR = 0"},
        "1172": {"comment":"ERRSOUND: the length"},
        "1177": {"synopsis":"The key click: a beep of CLICK cycles with period $00FA (JBEEP's body, ROM1 $EF1B).\nChanges: AF, DE, HL; as JBEEP.","comment":"The period"},
        "1180": {"comment":"CLICK: the length"},
        "1183": {"synopsis":"A beep of A cycles with the period in HL, through ROM1's $EF1B (JBEEP's body).\nEntry: A = the cycles; HL = the period.","comment":"DE = A"},
        "1186": {"comment":"JBEEP's body"},
        "1189": {"synopsis":"Empties the line being edited: the bytes from its start up to WORKSP - 2 (the edit line) or\nWKEND - 1 (the workspace, FLAGE bit 5) are removed ($1E4F), and KCUR is set to HL with\nHMPR's page. ROM1 calls it.\nChanges: AF, BC, DE, HL.","comment":"DE = the start; Z: the edit line"},
        "1194": {"comment":"The workspace: up to WKEND"},
        "1199": {"synopsis":"ED_CLEAR_LINE for the edit line: up to WORKSP - 2.","comment":"WORKSP"},
        "1203": {"synopsis":"Removes the bytes from DE to HL - 1 ($1E4F) and sets KCUR (ED_SET_KCUR_HL)."},
        "1204": {"comment":"Remove them"},
        "1209": {"synopsis":"Sets KCUR to HL in the page HMPR holds ($1D77 calls it).\nEntry: HL = the address.\nChanges: AF.","comment":"HMPR's page"},
        "1211": {"comment":"KCURP"},
        "1214": {"comment":"KCUR"},
        "1218": {"synopsis":"DE = the start of the line being edited, its page in: ELINE (Z), or WORKSP when FLAGE bit 5\nis set (NZ).\nExit: DE = the start; Z for the edit line.\nChanges: AF, DE.\nKeeps: HL."},
        "1219": {"comment":"FLAGE"},
        "1222": {"comment":"Bit 5: the workspace?"},
        "1226": {"comment":"No: ELINE"},
        "1229": {"comment":"Z"},
        "1230": {"synopsis":"ED_LINE_START's end: WORKSP when NZ, then DE = the address."},
        "1231": {"comment":"The workspace: WORKSP"},
        "1235": {"synopsis":"Pops AF and HL and returns; ROM1 jumps here at $C4C8."},
        "1238": {"synopsis":"DE = the number of the program line at HL; when HL is at the program's $FF end, the number\nof the line at DE instead; D = E = 0 and Z when that is the end too.\nEntry: HL = a line; DE = the line before it.\nExit: DE = the line number (stored high byte first); HL past its first byte.\nChanges: AF, DE, HL.","comment":"The end of the program?"},
        "1242": {"comment":"Yes: the line before"},
        "1245": {"comment":"DE = 0 when that is the end too"},
        "1248": {"synopsis":"DE = the line number at HL, high byte first."},
        "1252": {"synopsis":"Empties the key buffer ($1CBD) and waits for a new key, with $0E5D's check (error 14) on\nevery pass. ROM1 calls it at $E00A.\nExit: A = the key (READ_KEY).","comment":"Empty the key buffer"},
        "1255": {"synopsis":"Loops until READ_KEY has a key, through $0E5D each time.","comment":"Error 14 check"},
        "1258": {"comment":"A key yet?"},
        "1264": {"synopsis":"Waits for a character from the current channel's input routine (CHAN_INPUT). DFLAG bit 3 is\nset first unless DFLAG bit 5 is.\nExit: A = the character.\nError: stops with error 22 when the routine returns NZ without carry.\nChanges: AF, HL; as the input routine.","comment":"DFLAG"},
        "1268": {"comment":"Bit 5 set?"},
        "1272": {"comment":"No: bit 3 on"},
        "1274": {"synopsis":"Calls the input routine until it returns carry (a character); Z means none yet.","comment":"The channel's input routine"},
        "1277": {"comment":"A character?"},
        "1278": {"comment":"Not yet"},
        "1280": {"comment":"Stops with error code 22"},
        "1282": {"synopsis":"The input routine of channels K and S (ROM1's channel table at $FC4A-$FC52 names it): when\nDFLAG bit 3 is set, calls $0576 first, then READ_KEY.\nExit: as READ_KEY.","comment":"DFLAG"},
        "1285": {"comment":"Bit 3 set?"},
        "1287": {"comment":"Yes: ROM1 $F494 first"},
        "1290": {"synopsis":"JWAITREY's body: takes the key FLAGS bit 5 announces (RBHEAD) and clears the bit. Code 6\nflips KLFLAG bit 3 and gives no key; codes $10-$15 are returned and make KEY_PARAM_INPUT the\nfirst channel's input routine for the parameter key; DFLAG bit 5 calls CLS_LOWER first.\nExit: carry and A = the key; Z without carry when there is none.\nChanges: AF, DE, HL.","comment":"FLAGS"},
        "1293": {"comment":"No carry"},
        "1294": {"comment":"Bit 5: a key?"},
        "1296": {"comment":"No"},
        "1297": {"comment":"RBHEAD"},
        "1300": {"comment":"Taken"},
        "1303": {"comment":"DFLAG"},
        "1304": {"comment":"Bit 5 set?"},
        "1306": {"comment":"Yes: clear the lower screen"},
        "1310": {"comment":"$16 or more?"},
        "1312": {"comment":"Yes: carry"},
        "1314": {"comment":"Code 6?"},
        "1318": {"comment":"Below $10?"},
        "1321": {"comment":"$10-$15: kept in RDATA"},
        "1324": {"comment":"The next key goes to KEY_PARAM_INPUT"},
        "1329": {"synopsis":"The input routine READ_KEY installs after a code $10-$15: takes the next key as its\nparameter, a digit 0-7 ('0'-'7'); for the codes $12-$14 only 0-1, for $15 only 0-3. A key\nthat fits is returned as its value and MNIP becomes the input routine again; any other key\nis dropped and this routine stays.\nExit: carry and A = the value; Z without carry when there is none.\nChanges: AF, B, DE, HL.","comment":"FLAGS"},
        "1333": {"comment":"Bit 5: a key?"},
        "1336": {"comment":"RBHEAD"},
        "1339": {"comment":"Taken"},
        "1341": {"comment":"Below '0'?"},
        "1345": {"comment":"Over '7'?"},
        "1349": {"comment":"B = the value"},
        "1350": {"comment":"RDATA: the code"},
        "1353": {"comment":"$10 or $11?"},
        "1357": {"comment":"$15?"},
        "1362": {"comment":"$12-$14: 2 or more?"},
        "1366": {"synopsis":"KEY_PARAM_INPUT: refuses a value of 4 or more.","comment":"4 or more?"},
        "1370": {"synopsis":"KEY_PARAM_INPUT: a value that fits; MNIP becomes the input routine again.","comment":"A = the value"},
        "1371": {"comment":"MNIP: the input routine back"},
        "1375": {"synopsis":"Stores DE as the input address of the first channel at CHANS and returns with carry.\nEntry: DE = the routine.\nExit: carry set.\nChanges: HL.","comment":"Carry: a key"},
        "1376": {"comment":"The first channel's input word"},
        "1384": {"synopsis":"READ_KEY's code 6: flips KLFLAG bit 3 and sets DFLAG bit 3; no key.","comment":"KLFLAG"},
        "1388": {"comment":"Flip bit 3"},
        "1391": {"comment":"DFLAG bit 3 on"},
        "1396": {"synopsis":"Returns Z without carry: no key."},
        "1398": {"synopsis":"Jumps to ROM1's $F494 (called when DFLAG bit 3 is set before a key is read; probably draws\nthe line being edited again)."},
        "1401": {"synopsis":"Jumps to ROM1's $E013. ROM1 calls it at $F4F2, $F536 and $F592."},
        "1404": {"synopsis":"When AUTOFLG is set, the edit line (not the workspace) is empty and EPPC + AUTOSTEP stays\nbelow $FF00, puts that number into the edit line: ROM1's $F5AB with BC = the number, through\nstream $FF, then stream 0 again.\nChanges: AF, BC, DE, HL.","comment":"FLAGE"},
        "1407": {"comment":"Bit 5: the workspace?"},
        "1410": {"comment":"AUTOFLG"},
        "1413": {"comment":"Off?"},
        "1415": {"comment":"HL = ELINE"},
        "1419": {"comment":"Empty?"},
        "1422": {"comment":"EPPC + AUTOSTEP"},
        "1430": {"comment":"$FF00 or more?"},
        "1435": {"comment":"Stream $FF"},
        "1440": {"comment":"BC = the number"},
        "1441": {"comment":"ROM1 $F5AB puts it in"},
        "1444": {"synopsis":"Selects stream 0 ($1163)."},
        "1448": {"synopsis":"HL = past the end of the DKDEF list (KEYDEF_FIND with A = $FF). ROM1 calls it."},
        "1450": {"synopsis":"Finds key A's entry in the list at DKDEF: each entry is the key's code, a length word and\nthat many bytes; a code $FF ends the list.\nEntry: A = the key.\nExit: HL = the text, BC = its length, Z; carry when not found (HL past the end marker).\nChanges: AF, BC, D, HL.","comment":"D = the key"},
        "1451": {"comment":"DKDEF"},
        "1454": {"synopsis":"One entry: its code, then BC = its length.","comment":"The code"},
        "1456": {"comment":"BC = the length"},
        "1460": {"comment":"$FF: the end?"},
        "1464": {"comment":"This key?"},
        "1466": {"comment":"Past the text"},
        "1469": {"synopsis":"Z when the current channel's letter (CLET) is 'K' or 'S'.\nExit: Z if K or S.\nChanges: AF.","comment":"CLET"},
        "1472": {"comment":"'K'?"},
        "1475": {"comment":"'S'?"},
        "1478": {"synopsis":"Clears the lower screen, then lists the program on the cleared upper screen from line SDTOP,\nmoving SDTOP so that line EPPC is near: to EPPC when EPPC is above it, or forward to the\nfirst line that starts less than 256 bytes before EPPC's line when EPPC is far below. LAST =\nEPPC. The listing ($08C5) can come back through ROM1's $DF65 to AUTO_LIST_END. Ends at $08CD\nwith ROM1 out.","comment":"Clear the lower screen"},
        "1487": {"synopsis":"AUTO_LIST without clearing the lower screen ($0E75 calls it).","comment":"SDTOP"},
        "1493": {"comment":"Clear the upper screen"},
        "1496": {"comment":"DFLAG = $10"},
        "1501": {"comment":"KLFLAG bit 0 on"},
        "1506": {"comment":"SDTOP"},
        "1509": {"comment":"EPPC"},
        "1513": {"comment":"LAST = EPPC"},
        "1517": {"comment":"EPPC above SDTOP?"},
        "1521": {"comment":"Yes: SDTOP = EPPC"},
        "1523": {"comment":"Find line EPPC"},
        "1526": {"comment":"Its page"},
        "1530": {"comment":"Find line SDTOP"},
        "1536": {"comment":"DE = EPPC's line"},
        "1538": {"comment":"256 bytes before it"},
        "1540": {"synopsis":"Walks the lines from SDTOP's until one is in EPPC's page and at or past the address 256\nbytes before EPPC's line.","comment":"B = HMPR's page now"},
        "1544": {"comment":"EPPC's page?"},
        "1547": {"comment":"There yet?"},
        "1552": {"synopsis":"On to the next program line: past the number and its length word.","comment":"Past the number"},
        "1554": {"comment":"BC = the length"},
        "1558": {"comment":"Keep the page"},
        "1559": {"comment":"Into the next page if needed"},
        "1566": {"synopsis":"HL = the number of the line found.","comment":"Its number, high byte first"},
        "1570": {"synopsis":"SDTOP = HL; lists from it, LISTSP keeping the stack for a way back.","comment":"SDTOP"},
        "1573": {"comment":"LISTSP"},
        "1577": {"comment":"List from line HL"},
        "1580": {"synopsis":"The end of the automatic listing: DFLAG bit 4 off, then $08CD with ROM1 out. ROM1 jumps here\nat $DF65 with SP from LISTSP.","comment":"DFLAG bit 4 off"},
        "1585": {"comment":"On at $08CD"},
        "1591": {"synopsis":"A command address in ROM1's table ($FDC1): lists the program to stream 3. The entry $063A\n(ROM1 $FDBF) starts inside the LD below and gives C = 2 (stream 2).\n1. Selects stream C (when running).\n2. Token $91: sets LISTFLG from a number 0-2 ($1F62, error $1E otherwise).\n3. Otherwise an optional '#' stream ($1132), then a line range ($3B4B); EPPC = FIRST and the\n   lines are listed from it ($08C5), then ROM1's $F2E4.\nEntry: CHAD at the command's parameters.","comment":"Stream 3"},
        "1593": {"comment":"Skips the next 2 bytes ($063A: C = 2)"},
        "1596": {"synopsis":"LIST_TO_S3 with the stream in C.","comment":"DFLAG = 0"},
        "1600": {"comment":"Carry: running"},
        "1604": {"comment":"Running: select stream C"},
        "1607": {"comment":"The next character"},
        "1608": {"comment":"Token $91?"},
        "1612": {"comment":"A number"},
        "1615": {"comment":"Below 3, or stops with error code $1E"},
        "1621": {"comment":"LISTFLG"},
        "1625": {"synopsis":"LIST_TO_C: an optional stream and a line range.","comment":"An optional '#' stream"},
        "1635": {"synopsis":"Reads the line range ($3B4B); stops here when checking the syntax only (FLAGS bit 7 off).","comment":"The range"},
        "1638": {"comment":"FLAGS bit 7"},
        "1641": {"comment":"Off: syntax only"},
        "1645": {"comment":"A = 0?"},
        "1648": {"comment":"LAST's high byte $FF"},
        "1652": {"synopsis":"EPPC = FIRST; FIRST not 0 with carry stops with error 30 ($1D39).","comment":"FIRST"},
        "1655": {"comment":"0?"},
        "1660": {"comment":"Carry: error 30"},
        "1664": {"synopsis":"EPPC = HL, then lists from it (LIST_FROM_LINE)."},
        "1665": {"comment":"EPPC"},
        "1668": {"synopsis":"Lists the program from line HL: finds it ($1A4D) and goes on at $08C5 with BC = LIST_DONE.\nEntry: HL = the line number.","comment":"Find line HL"},
        "1671": {"comment":"Where the listing goes next"},
        "1677": {"synopsis":"After a listing: jumps to ROM1's $F2E4."},
        "1680": {"synopsis":"Clears $5ABE and $5AC0 (two of the indented listing variables). Called from ROM1 and $08BF.\nChanges: AF."},
        "1688": {"synopsis":"Clears the whole screen and the lower screen (CLS_BY_A with A = 0). Reached from ROM1 at\n$D76A, $C0C7, $ED9C and from $393A."},
        "1691": {"synopsis":"A command address in ROM1's table ($FD83): '#' goes to ROM1's $ED7D; otherwise an optional\nnumber ($1D33, checked by $2866 with E = 6) is the A for CLS_BY_A.\nEntry: A = the character after the command.","comment":"'#'?"},
        "1695": {"comment":"Yes: ROM1 $ED7D"},
        "1698": {"synopsis":"CLS_CMD with a number.","comment":"Running only"},
        "1701": {"comment":"The number"},
        "1704": {"comment":"Checked by $2866, E = 6"},
        "1710": {"synopsis":"JCLSBL's body: with A = 1 clears the upper window only (CLS_UPPER_A); with any other A,\nCLS_UPPER_A with that A (0: the whole screen memory) and then the lower screen (CLS_LOWER).\nEntry: A = what to clear.\nChanges: all.","comment":"1: the upper window only"},
        "1714": {"comment":"The screen, then the lower part"},
        "1717": {"synopsis":"JCLSLOWER's body: clears the lower window and shrinks it to its last two rows (LWTOP = LWBOT\n- 1), selects stream $FD, sets DFLAG to 1, puts MNOP/MNIP back as the channel's routines and\nSPOSNL to the window's second row.\nChanges: all.","comment":"LWBOT"},
        "1722": {"comment":"LWBOT - LWTOP"},
        "1723": {"comment":"2 rows already?"},
        "1726": {"comment":"WINDTOP = LWTOP"},
        "1731": {"comment":"LWBOT - 1"},
        "1734": {"comment":"LWTOP = it"},
        "1735": {"comment":"WINDBOT = LWBOT - 2"},
        "1739": {"comment":"WINDRHS/WINDLHS = LWRHS/LWLHS"},
        "1745": {"comment":"M23PAPT/M231NKT = M23PAPP/M231NKP"},
        "1751": {"comment":"ATTRT = ATTRP"},
        "1757": {"comment":"Clear the window"},
        "1760": {"synopsis":"CLS_LOWER: stream $FD, DFLAG = 1, the channel's routines back, SPOSNL set.","comment":"Stream $FD"},
        "1763": {"comment":"DFLAG = 1"},
        "1768": {"comment":"Clear; HL = WINDLHS/WINDTOP"},
        "1771": {"comment":"The next row"},
        "1772": {"comment":"SPOSNL"},
        "1776": {"synopsis":"Clears the upper window (CLS_UPPER_A with A = 1). $0EC9 calls it."},
        "1778": {"synopsis":"Clears the screen: A = 0 fills the whole screen memory (CLEAR_SCREEN_MEM), any other A\nclears the window ($0B6D) after stream $FE is selected. Also sets XCOORD/YCOORD from two\nstacked constants ($2793, with an error return to $06FA made by $202E), clears ERRNR and\nXPTR's high byte, sets SCRCT to 1, puts the channel's routines back (MNOP/MNIP), SPOSNU to\nthe top left, KLFLAG bit 0 off, LPT's 30 bytes to 0 and LNPTR to $FF.\nEntry: A = 0 (all) or not.\nChanges: all."},
        "1779": {"comment":"Two numbers on the calculator stack"},
        "1783": {"comment":"Errors come back to $06FA"},
        "1786": {"comment":"The coordinates"},
        "1791": {"comment":"HL = C"},
        "1794": {"synopsis":"Stores the coordinates: XCOORD = HL, YCOORD = B.","comment":"XCOORD"},
        "1798": {"comment":"YCOORD"},
        "1801": {"comment":"The old ERRSP back"},
        "1806": {"comment":"XPTR's high byte = 0"},
        "1809": {"comment":"ERRNR = 0"},
        "1812": {"comment":"SCRCT = 1"},
        "1816": {"comment":"Stream $FE"},
        "1819": {"comment":"A = 0?"},
        "1823": {"comment":"Yes: the whole screen memory"},
        "1826": {"comment":"Routines back; HL = WINDLHS/WINDTOP"},
        "1830": {"synopsis":"CLS_UPPER_A for A not 0: clears the window (CLEAR_WIN_CHANS); then SPOSNU and the rest.","comment":"Else clear the window"},
        "1833": {"comment":"SPOSNU"},
        "1836": {"comment":"KLFLAG bit 0 off"},
        "1841": {"comment":"LPT: 30 bytes"},
        "1847": {"synopsis":"Clears LPT's 30 bytes; then LNPTR = $FF."},
        "1851": {"comment":"A = $FF"},
        "1852": {"comment":"LNPTR"},
        "1856": {"synopsis":"Clears the window WINDTOP-WINDBOT ($0B6D), then CHAN_RTNS_BACK.\nExit: HL = WINDLHS/WINDTOP."},
        "1859": {"synopsis":"Copies MNOP and MNIP to the current channel's output and input words.\nExit: HL = the word at WINDLHS (L = WINDLHS, H = WINDTOP).\nChanges: BC, DE, HL.","comment":"CURCHL"},
        "1863": {"comment":"MNOP, MNIP"},
        "1871": {"comment":"L = WINDLHS, H = WINDTOP"},
        "1875": {"synopsis":"Fills the screen memory for the MODE (FILL_SCREEN): MODEs 1 and 2 (value < 2) get 6144 zero\nbytes at $8000; then MODE 2 6144 bytes of ATTRP at $A000, MODE 1 768 bytes at $9800. MODEs 3\nand 4 get 24576 bytes of M23PAPP at $8000.\nChanges: all.","comment":"MODE"},
        "1878": {"comment":"3 or 4?"},
        "1882": {"comment":"$8000-$97FF with 0"},
        "1886": {"comment":"2048 + 4096 bytes"},
        "1894": {"comment":"E = ATTRP"},
        "1898": {"comment":"$A000-$B7FF"},
        "1903": {"comment":"MODE 2?"},
        "1906": {"comment":"MODE 1: $9800-$9AFF"},
        "1908": {"comment":"768 bytes"},
        "1913": {"synopsis":"CLEAR_SCREEN_MEM for MODEs 3 and 4: $8000-$DFFF with M23PAPP.","comment":"Up to $DFFF"},
        "1915": {"comment":"E = M23PAPP"},
        "1919": {"comment":"6 x 4096 bytes"},
        "1922": {"synopsis":"Fills screen memory with E, downwards from H x 256, by pushing DE with interrupts off: B x\n16 bytes, then (C - 1) x 4096 more (B = 0 counts 256). The current screen's page (CUSCRNP)\nis paged in at $8000 for it ($3FA8) and the paging put back ($3FBF).\nEntry: H = the end's high byte; E = the byte; B, C = the counts.\nChanges: all.","comment":"The screen's page in"},
        "1925": {"comment":"DE = E, E"},
        "1927": {"comment":"Keep SP in TEMPW1"},
        "1931": {"comment":"SP = the end"},
        "1934": {"synopsis":"Pushes DE 8 times (16 bytes), B times, C times."},
        "1947": {"comment":"SP back"},
        "1952": {"comment":"Paging back"},
        "1955": {"synopsis":"A command address in ROM1's table ($FDBD): prints to stream 3. The entry $07A6 (ROM1 $FDBB)\nstarts inside the LD below and gives C = 2 (stream 2). Prints the items (PRINT_ITEMS)\nseparated by ';', ',' (code 6) and an apostrophe (a new line); a newline ends the statement\nunless it ended with a separator or ')'.\nEntry: CHAD at the command's parameters.","comment":"Stream 3"},
        "1957": {"comment":"Skips the next 2 bytes ($07A6: C = 2)"},
        "1960": {"synopsis":"PRINT_TO_S3 with the stream in C: INQUFG bit 0 on, the stream selected when running, $118E\ncalled.","comment":"Carry: running"},
        "1964": {"comment":"INQUFG bit 0 on"},
        "1969": {"comment":"Running: select stream C"},
        "1975": {"synopsis":"Prints items and separators up to the end of the statement (')' ':' or $0D). ROM1 calls it\nat $C35F.","comment":"The next character"},
        "1976": {"comment":"The end already?"},
        "1981": {"synopsis":"Takes separators; stops at the end of the statement.","comment":"A separator?"},
        "1984": {"comment":"The end"},
        "1985": {"comment":"More separators"},
        "1987": {"comment":"An item"},
        "1990": {"comment":"A separator after it?"},
        "1996": {"synopsis":"The items ended without a separator: ')' returns, otherwise a newline is printed.","comment":"')'?"},
        "1999": {"synopsis":"Prints a newline ($0D) when running. ROM1 jumps here at $C356.","comment":"A newline"},
        "2001": {"synopsis":"Prints C through RST $10, only when running (FLAGS bit 7).\nEntry: C = the character.\nExit: NC when checking syntax only.","comment":"Running?"},
        "2008": {"synopsis":"Takes a separator at CHAD: ';' prints nothing, ',' prints code 6, an apostrophe a newline.\nExit: carry when there is none; else Z when the end of the statement follows. ROM1 calls it\nat $C349."},
        "2009": {"comment":"';'?"},
        "2013": {"comment":"Code 6 for ','"},
        "2015": {"comment":"','?"},
        "2019": {"comment":"An apostrophe?"},
        "2021": {"comment":"No: carry"},
        "2023": {"comment":"A newline for it"},
        "2025": {"synopsis":"Prints the separator's code C (PRINT_C_RUN) and moves on."},
        "2028": {"synopsis":"Past the separator, then PRINT_AT_END.","comment":"Past it"},
        "2029": {"synopsis":"Z when A is ')', ':' or $0D (the end of the statement); never carry. ROM1 calls it at $C344.\nEntry: A = the character.\nExit: Z at the end; NC.","comment":"')'?"},
        "2032": {"comment":"':'?"},
        "2035": {"comment":"$0D?"},
        "2037": {"comment":"No carry"},
        "2040": {"synopsis":"Prints one item. Token $88 takes a number ($1D2E) and goes on with code $17 at $081D; token\n$87 is at $0808 on; the rest is past this range. ROM1 jumps here at $C36D.","comment":"The item"},
        "2041": {"comment":"Token $88?"},
        "2045": {"comment":"A number"},
        "2048": {"comment":"The column, at most 65535"},
        "2051": {"comment":"D = it"},
        "2052": {"comment":"Code $17"},
        "2056": {"synopsis":"A PRINT item that is not TAB: AT line,column sends control $16, the line and the column;\nanything else goes on at PRINT_EXPR_ITEM. In syntax checking only the two numbers are\nchecked.\nEntry: A = the item's first character.","comment":"AT?"},
        "2060": {"comment":"Two numbers after AT; returns early when checking"},
        "2063": {"comment":"The column, 0-255"},
        "2067": {"comment":"The line, 0-255"},
        "2070": {"comment":"D = the line"},
        "2072": {"comment":"E = the column"},
        "2073": {"comment":"Hides LD D,A at $081A: the entry that takes the line in A"},
        "2075": {"comment":"AT control code"},
        "2077": {"synopsis":"Prints A, then D, then E to the current stream: a control code and its two operands. $081A\n(inside the CP $57 at $0819) is a second entry that first copies A into D; $0909, $0922 and\nROM1 $DE6A call it to send AT A,E.\nEntry: A = the code; D, E = the operands.\nChanges: A.","comment":"The control code"},
        "2078": {"comment":"First operand"},
        "2080": {"comment":"Second operand"},
        "2083": {"synopsis":"A PRINT item that is neither TAB nor AT: a colour item (PEN to OVER) is done by $1366; '#'\nselects a stream ($1135); otherwise an expression is evaluated and its value printed: a\nnumber through JSTRS's text, a string from its own page. HMPR is put back afterwards.\nEntry: A = the item's first character.\nExit: Carry clear and nothing printed when the item is a colour item or the line is being\nchecked.","comment":"A colour item? Done if so"},
        "2087": {"comment":"'#'? Selects the stream"},
        "2092": {"comment":"Evaluates it; returns when checking syntax"},
        "2096": {"comment":"Keeps HMPR"},
        "2099": {"comment":"A number? (NZ)"},
        "2101": {"comment":"String: DE = start, BC = length, its page in at $8000"},
        "2104": {"comment":"Sets Z so the number step is skipped"},
        "2105": {"synopsis":"Prints the value just evaluated: a number is first turned into text by JSTRS (Z clear), a\nstring is already addressed by DE and BC; then PRINT_BLOCK sends it and HMPR is put back\nfrom the stack.\nEntry: Z clear for a number on the calculator stack; Z set with DE, BC = the string; HMPR's\nold value pushed under the return address.","comment":"A number: its text in a buffer, DE/BC set"},
        "2108": {"comment":"Prints BC bytes from DE"},
        "2111": {"comment":"HMPR back"},
        "2115": {"synopsis":"An up or down key with an empty edit line (from $0406): moves the listing's current line\n(EPPC) and its marker, through stream -2, then selects stream 0 again.\nEntry: A = the key ($0B up, otherwise down)."},
        "2116": {"comment":"Stream -2 ($FE)"},
        "2119": {"comment":"B = the key"},
        "2123": {"comment":"Stream 0 again"},
        "2126": {"synopsis":"Moves EPPC to the previous ($0B) or the next line and moves the marker in the listing to it:\nup or down to the screen row whose LPT byte says a line starts there, or, at the window's\nedge, scrolls the window and lists the new line. When LNPTR is $40 or more (no marker on\nscreen) the listing is redrawn ($05C6).\nEntry: B = the key.","comment":"LNPTR: the marker's screen row"},
        "2129": {"comment":"No marker shown? Relists instead"},
        "2135": {"comment":"Up key?"},
        "2139": {"comment":"EPPC: the current line number"},
        "2143": {"comment":"DE = the line before it"},
        "2148": {"comment":"BC = that line's number (high byte first)"},
        "2151": {"comment":"The new EPPC"},
        "2156": {"comment":"Same line? Already the first"},
        "2161": {"comment":"A = the marker's row in the window"},
        "2165": {"synopsis":"One row up from row A: at the window's top row goes on at LCUR_UP_SCROLL, else stops at the\nfirst row above whose LPT byte is set (LCUR_SET_ROW).","comment":"Window's top row?"},
        "2168": {"comment":"L = $52 + row - 1: LPT's byte for the row above"},
        "2172": {"comment":"A = that row"},
        "2174": {"comment":"Does a line start there? (B nonzero)"},
        "2178": {"comment":"No: one more row up"},
        "2180": {"synopsis":"The previous line is above the window: measures how many rows it takes by listing it at row\n$41 (off screen) with $5AB7 = 1, scrolls the window down by that many rows (at most its\nheight), and lists the line at the window's top.\nEntry: DE = the line's address."},
        "2182": {"comment":"$5AB7 = 1 while measuring"},
        "2185": {"comment":"Keeps SPOSNU"},
        "2189": {"comment":"L = WINDLHS"},
        "2192": {"comment":"H = row $41, below the screen"},
        "2199": {"comment":"HL = the line"},
        "2200": {"comment":"Lists it; only the position moves"},
        "2207": {"comment":"WINDTOP"},
        "2210": {"comment":"H = the window's height in rows"},
        "2216": {"comment":"A = rows the line took"},
        "2221": {"comment":"More than the window? (then the height)"},
        "2225": {"synopsis":"Puts SPOSNU back, scrolls the window down A rows and lists the line from the window's\ntop-left corner.\nEntry: A = the rows; the line's address under SPOSNU's old value on the stack."},
        "2226": {"comment":"SPOSNU back"},
        "2229": {"comment":"Scrolls the window down A rows"},
        "2232": {"comment":"Print position: the window's top-left"},
        "2238": {"comment":"HL = the line"},
        "2239": {"synopsis":"Lists the program line at HL in the listing's format, with the indentation state ($5ABE,\n$5AC0) cleared.\nEntry: HL = the line."},
        "2242": {"synopsis":"Lists the program line at HL (ROM1 $F314 through LIST_LINE_R1), with $5ABD = 1 meanwhile.\nEntry: HL = the line."},
        "2245": {"synopsis":"Calls the routine at BC with $5ABD = 1 (listing a line) and clears $5ABD afterwards. $068A\nand ROM1 $F4CE use it.\nEntry: BC = the routine.\nExit: as the routine leaves it, A = 0.","comment":"$5ABD = 1 meanwhile"},
        "2250": {"comment":"Calls BC"},
        "2253": {"synopsis":"Clears $5ABD and returns. $0631 jumps here (through $021F) with ROM1 out."},
        "2258": {"synopsis":"Lists one program line: jumps to ROM1 $F314. Reached through BC from LIST_LINE_AT_HL.\nEntry: HL = the line."},
        "2261": {"synopsis":"The down key: moves EPPC to the next line; then down the window's rows to the next one whose\nLPT byte is set, or, at the bottom, scrolls the listing up a line.","comment":"Keeps the old EPPC"},
        "2265": {"comment":"EPPC to the next line; DE = its number"},
        "2269": {"comment":"Unchanged? Already the last line"},
        "2275": {"comment":"E = WINDTOP, D = WINDBOT"},
        "2279": {"comment":"A = the window's height"},
        "2283": {"comment":"A = the marker's row in the window"},
        "2286": {"comment":"D = the height"},
        "2287": {"synopsis":"One row down from row A: at the window's bottom goes on at LCUR_DOWN_SCROLL, else stops at\nthe row whose LPT byte is set.","comment":"Past the window's bottom?"},
        "2291": {"comment":"L = $52 + row: LPT's byte for it"},
        "2297": {"comment":"Does a line start there?"},
        "2302": {"synopsis":"Puts the marker on row A of the window: LNPTR = WINDTOP + A, AT the row, column 5, then ROM1\n$F564 draws it.\nEntry: A = the row in the window."},
        "2303": {"comment":"LNPTR = WINDTOP + row"},
        "2311": {"comment":"Column 5"},
        "2313": {"comment":"AT row,5 ($081A, inside the CP $57)"},
        "2319": {"synopsis":"The next line is below the window: advances SDTOP, prints at the marker's row with OVERT and\nSCRCT cleared, and lists the new current line and the one after it (the listing scrolls as\nit prints).","comment":"SDTOP to the next line"},
        "2323": {"comment":"OVERT = 0"},
        "2327": {"comment":"SCRCT = 0: no scroll prompt"},
        "2334": {"comment":"The marker's row in the window"},
        "2338": {"comment":"AT row,0 ($081A)"},
        "2341": {"comment":"HL = EPPC's line number"},
        "2342": {"comment":"HL = its line"},
        "2345": {"comment":"$5ABE = $5ABC"},
        "2351": {"comment":"Lists it"},
        "2354": {"comment":"New line"},
        "2357": {"comment":"Lists the next line too"},
        "2359": {"synopsis":"Replaces the line number in the word at HL (EPPC, SDTOP) by the number of the first program\nline at or after it, or $FFFF at the end. $05CC and $05D2 use it.\nEntry: HL = the word.\nExit: the word and DE = the number.","comment":"HL = the number in the word"},
        "2366": {"synopsis":"Moves SDTOP to the line after the one it names (the first line above its number).\nExit: DE = the new number."},
        "2371": {"synopsis":"Moves EPPC to the line after the one it names.\nExit: DE = the new number."},
        "2374": {"synopsis":"Moves the line number in the word at HL to the first line above it.\nEntry: HL = the word.\nExit: the word and DE = the new number."},
        "2379": {"comment":"One above the number"},
        "2380": {"synopsis":"Finds the first line at or after number HL and stores its number in the word pushed on the\nstack.\nEntry: HL = the number; the word's address + 1 on the stack.","comment":"HL = the first line at or after it"},
        "2383": {"comment":"DE = its number ($FFFF past the end)"},
        "2387": {"comment":"Stores it back"},
        "2391": {"synopsis":"DROLL's body: scrolls or rolls an area of the screen (modes 3 and 4) without parsing\nanything.\nEntry: A = 0 scroll (fill with M23PAPT) or nonzero roll (the bytes come back at the other\nside); C = the direction (1 left, 2 up, 3 right, 4 down); B = the pixels; H = the top row, L\n= the left x (even); D = the height, E = the width in pixels.\nError: 30 (through ROLL_SCROLL_RUN) for an area or count that does not fit.","comment":"E = width - 1, as the statement passes it"},
        "2392": {"comment":"TEMPB3 = scroll or roll"},
        "2401": {"synopsis":"The ROLL statement (command table entry $E5): goes on at the shared parser with TEMPB3 = $FF\n(roll).","comment":"Roll"},
        "2405": {"synopsis":"The SCROLL statement (command table entry $E6): SCROLL CLEAR and SCROLL RESTORE store $B3 or\n0 in SPROMPT; anything else is parsed as ROLL's parameters with TEMPB3 = 0 (scroll).","comment":"SCROLL CLEAR?"},
        "2409": {"comment":"SCROLL RESTORE? (A = 0 then)"},
        "2413": {"synopsis":"SCROLL CLEAR or SCROLL RESTORE: stores $B3 or 0 in SPROMPT when running.\nEntry: A = $B3 or 0."},
        "2414": {"comment":"Past the keyword; returns when checking"},
        "2417": {"comment":"SPROMPT = $B3 or 0"},
        "2422": {"synopsis":"SCROLL with parameters: TEMPB3 = 0 (scroll, not roll), then the shared parser."},
        "2423": {"synopsis":"Parses ROLL/SCROLL dir[,pixels[,x,y,width,height]] and does it. The defaults are 1 pixel and\nthe whole screen (x 0, y 0, 256 x 192). In syntax checking only the parameters are checked.\nEntry: A = TEMPB3's value ($FF roll, 0 scroll).\nError: 30 for a 0 height, a width over 256 or a bad area.","comment":"TEMPB3: $FF roll, 0 scroll"},
        "2426": {"comment":"The direction"},
        "2429": {"comment":"More?"},
        "2433": {"comment":"Returns when checking"},
        "2436": {"comment":"1 pixel"},
        "2440": {"synopsis":"ROLL/SCROLL dir,pixels: reads the pixel count; with a further comma the area follows\n(ROLL_SCROLL_AREA).","comment":"The pixels"},
        "2443": {"comment":"An area too?"},
        "2450": {"comment":"A = the pixels"},
        "2453": {"synopsis":"No area given: pushes the whole screen as the area (192 rows, 256 pixels from 0,0).","comment":"D = 192 rows, E = 255 (width - 1)"},
        "2457": {"comment":"Top-left 0,0"},
        "2463": {"synopsis":"Reads x,y,width,height: the height must be 1-255 and the width at most 256; the width is\nmade even (less 1) and x even.","comment":"Four more numbers"},
        "2466": {"comment":"Returns when checking"},
        "2469": {"comment":"The height"},
        "2472": {"comment":"0? Error 30"},
        "2476": {"comment":"The width"},
        "2479": {"comment":"Even, less 1"},
        "2482": {"comment":"Over 256?"},
        "2486": {"comment":"D = the height, E = width - 1"},
        "2489": {"comment":"The position: B = y, C = x"},
        "2492": {"comment":"Even x"},
        "2495": {"comment":"The pixel count"},
        "2498": {"synopsis":"Pushes the pixel count and reads the direction from the calculator stack; then\nROLL_SCROLL_RUN."},
        "2499": {"comment":"C = the direction"},
        "2502": {"synopsis":"The common part of ROLL, SCROLL and DROLL: checks the mode (3 or 4), resets the temporary\ncolours, pages the screen in, checks the area and the direction, works out the area's\naddress and goes on at the horizontal or the vertical move. The moves run an unrolled chain\nof RRD/RLD, LDI or LDD that ROM1 builds at $4D00 (in RAM).\nEntry: on the stack (top first): the direction in C, the pixels in A, the position (H y, L\nx), the size (D height, E width - 1).\nError: 34 below mode 3; 30 for a 0 count, a direction not 1-4 or an area off the screen."},
        "2503": {"comment":"Mode 3 or 4? Error 34 if not"},
        "2506": {"comment":"The temporary colours from the permanent ones"},
        "2509": {"comment":"The screen paged in"},
        "2516": {"comment":"No pixels?"},
        "2519": {"comment":"B = the pixels"},
        "2521": {"comment":"Direction 1-4?"},
        "2526": {"synopsis":"Stops with error code 30: a parameter of ROLL/SCROLL that does not fit.","comment":"Stops with error code 30"},
        "2528": {"synopsis":"Checks that the area ends on the screen (y + height at most 192, x + width at most 256) and,\nfor direction 4, starts from its bottom row.","comment":"y + height"},
        "2532": {"comment":"Below row 192?"},
        "2536": {"comment":"Direction 4 (down)? Starts at the bottom row"},
        "2542": {"synopsis":"Works out the area's screen address ($8000 + y * 128 + x / 2), its width in bytes, and B' =\nthe height; then the horizontal move for directions 1 and 3, the vertical one\n(ROLL_SCROLL_VERT) for 2 and 4.","comment":"x + width - 1"},
        "2544": {"comment":"Past x 255?"},
        "2546": {"comment":"B' = the height in rows"},
        "2550": {"comment":"HL = $8000 + y * 128 + x / 2"},
        "2555": {"comment":"E = the width in bytes"},
        "2560": {"comment":"D = the pixels"},
        "2561": {"comment":"Direction 2 or 4?"},
        "2566": {"comment":"E = bytes - 1"},
        "2567": {"comment":"More than 1 pixel? Moves bytes"},
        "2569": {"comment":"D = the direction"},
        "2570": {"comment":"A nibble step a byte (RLD/DEC L for 1, RRD/INC L for 3)"},
        "2573": {"comment":"Direction 3? Starts at the left end"},
        "2576": {"comment":"Left: starts at the right end"},
        "2579": {"comment":"E = -(bytes - 1): back to the far end"},
        "2583": {"synopsis":"Moves each row of the area by one pixel (a nibble in mode 4) through the RRD/RLD chain at\n$4D00: the nibble that comes in is M23PAPT's for a scroll or the one leaving the far end for\na roll.","comment":"D = TEMPB3"},
        "2587": {"comment":"Row stride 128"},
        "2590": {"synopsis":"One row of the one-pixel move."},
        "2591": {"comment":"B = the row's start (low byte)"},
        "2592": {"comment":"HL = the far end of the row"},
        "2595": {"comment":"Scroll: the paper colour comes in"},
        "2598": {"comment":"Roll?"},
        "2602": {"comment":"Roll: the far end's byte"},
        "2603": {"comment":"The nibble that leaves, low"},
        "2609": {"synopsis":"Runs the nibble chain on the row with A's low nibble coming in, then steps to the next row.","comment":"Back to the row's start"},
        "2611": {"comment":"The RRD/RLD chain"},
        "2615": {"comment":"Next row: + 128"},
        "2619": {"comment":"All rows?"},
        "2623": {"synopsis":"Moves each row by several pixels, whole bytes at a time (D = pixels / 2): builds an LDI\n(direction 1) or LDD (3) chain for the bytes that stay, then rolls or scrolls each row.","comment":"The pixels"},
        "2625": {"comment":"D = pixels / 2: the bytes to move by"},
        "2628": {"comment":"More than the width? Error 30"},
        "2633": {"comment":"Builds the LDI or LDD chain"},
        "2637": {"comment":"Direction 1? Starts at the left end"},
        "2640": {"comment":"Right: starts at the right end"},
        "2643": {"synopsis":"Picks the row loop: roll left, roll right, scroll left or scroll right."},
        "2646": {"comment":"Scroll? (Carry for TEMPB3 = 0)"},
        "2651": {"comment":"Left? (Z for direction 1)"},
        "2652": {"comment":"A = the bytes to move by"},
        "2658": {"synopsis":"Rolls one row left: saves the D bytes at its left end at $E003, moves the rest left with the\nLDI chain and puts the saved bytes back at the right end."},
        "2659": {"comment":"BC = the bytes to save"},
        "2662": {"comment":"Saves the left end"},
        "2668": {"comment":"Moves the rest left"},
        "2671": {"comment":"Back from the save buffer"},
        "2674": {"comment":"B = 0: the chain left BC at $FFxx"},
        "2679": {"comment":"Next row: + 128"},
        "2685": {"synopsis":"The move is done: puts the paging back (jumps to $3FBF)."},
        "2688": {"synopsis":"Rolls one row right: as ROLL_LEFT_ROW from the right end with LDDR/LDD and the buffer's end\nat $E082."},
        "2692": {"comment":"Saves the right end"},
        "2698": {"comment":"Moves the rest right"},
        "2701": {"comment":"Back from the save buffer"},
        "2717": {"synopsis":"Scroll: right (NZ) or left."},
        "2719": {"synopsis":"Scrolls one row left: moves it with the LDI chain from D bytes on, then fills the D bytes at\nthe right end with M23PAPT."},
        "2724": {"comment":"Source: D bytes on"},
        "2725": {"comment":"Moves the row left"},
        "2730": {"comment":"The paper colour"},
        "2733": {"synopsis":"Fills B bytes from DE up with A."},
        "2745": {"synopsis":"Jumps to ROLL_SCROLL_DONE."},
        "2747": {"synopsis":"Scrolls one row right: moves it with the LDD chain from D bytes back, then fills the D bytes\nat the left end with M23PAPT."},
        "2748": {"synopsis":"The next row of SCROLL_RIGHT_ROW."},
        "2753": {"comment":"Source: D bytes back"},
        "2755": {"comment":"Moves the row right"},
        "2760": {"comment":"The paper colour"},
        "2763": {"synopsis":"Fills B bytes from DE down with A."},
        "2777": {"synopsis":"Moves an area up (stride +128 bytes) or, with bit 2 of C set, down (stride -128) by D rows.\nAlso the window scroll's path in modes 3 and 4.\nEntry: HL = the first row's address; E = the width in bytes; D = the rows to move by; B' =\nthe height; C bit 2 = down; TEMPB3 = roll (nonzero) or scroll.","comment":"Down?"},
        "2779": {"comment":"Stride +128"},
        "2784": {"comment":"Down: stride -128"},
        "2785": {"synopsis":"The vertical move: builds an LDI chain of E bytes, saves the rows that leave when rolling,\nmoves the rows that stay by D rows (MOVE_ROWS), then puts the saved rows back or fills the\nfreed rows with M23PAPT.\nEntry: as ROLL_SCROLL_VERT, BC = the stride.\nError: 30 when D is more than the height."},
        "2786": {"comment":"An LDI chain of E bytes"},
        "2790": {"comment":"A' = the width"},
        "2792": {"comment":"B' = C' = the rows to move by"},
        "2797": {"comment":"Rows that stay"},
        "2798": {"comment":"Moving by more than the height? Error 30"},
        "2802": {"comment":"Roll? Saves the rows that leave"},
        "2810": {"comment":"None stay?"},
        "2813": {"comment":"B' = the rows that stay"},
        "2815": {"comment":"DE = the first row"},
        "2818": {"synopsis":"Adds the stride D times: HL = the row the first one is copied from."},
        "2822": {"comment":"Copies the rows that stay"},
        "2826": {"synopsis":"DE = the first freed row: puts the saved rows back (roll) or fills them (scroll)."},
        "2827": {"comment":"Roll?"},
        "2833": {"comment":"Roll: from the save buffer"},
        "2838": {"synopsis":"Copies one saved row back from the buffer."},
        "2854": {"synopsis":"Fills B' rows of A' bytes (the chain at $4D00), stepping BC, with M23PAPT: the first byte is\nset and the LDI chain from $4D02 spreads it. Ends at $3FBF, which puts the paging back.\nEntry: DE = the first row; BC = the stride; C' = the rows."},
        "2855": {"comment":"The fill byte"},
        "2859": {"comment":"B' = the rows"},
        "2860": {"synopsis":"Fills one row: sets its first byte and copies it along with the chain less its first LDI."},
        "2863": {"comment":"DE = the next byte"},
        "2864": {"comment":"The first byte"},
        "2867": {"comment":"The chain from its second LDI spreads it"},
        "2872": {"comment":"Next row"},
        "2876": {"synopsis":"Puts the paging back (jumps to $3FBF)."},
        "2879": {"synopsis":"Copies B' rows of A' bytes, stepping BC, from HL to the buffer at $E003 with the LDI chain\nat $4D00, and records the byte count (rows x width) in TEMPW2. $2925 uses it too.\nEntry: HL = the first row; D = the rows; A' = the width; BC = the stride.\nExit: HL, DE kept.\nError: 36 when the rows would run past $FFFF."},
        "2881": {"comment":"A = the width"},
        "2886": {"comment":"HL = rows x width"},
        "2888": {"synopsis":"Adds the width once per row."},
        "2892": {"comment":"TEMPW2 = the byte count"},
        "2895": {"comment":"Room up to $FFFF?"},
        "2901": {"comment":"Stops with error code 36"},
        "2903": {"synopsis":"Room enough: copies the rows to $E003."},
        "2905": {"comment":"The buffer"},
        "2909": {"synopsis":"Copies one row into the buffer and steps to the next."},
        "2925": {"synopsis":"Clears the current window: scrolls it up by its own height, so every row is filled with the\npaper colour. In the upper window (DEVICE 0) LSOFF is added to the rows. $06DD and $0740\ncall it.","comment":"WINDBOT - WINDTOP + 1: the rows"},
        "2932": {"comment":"Up"},
        "2934": {"comment":"The window's address, width and rows"},
        "2937": {"comment":"Upper window?"},
        "2944": {"comment":"Adds LSOFF"},
        "2949": {"synopsis":"B' = D: every row is freed, none is moved."},
        "2954": {"synopsis":"Scrolls the current window down by A text rows and shifts LPT with it (ROM1 $F3E1). The\nlisting uses it when the marker moves above the window.\nEntry: A = the rows."},
        "2957": {"comment":"LPT down by A rows"},
        "2961": {"comment":"Down"},
        "2965": {"synopsis":"Scrolls the current window up one text row and LPT with it. ROM1 calls it ($DFAB, $DFD6)."},
        "2968": {"comment":"LPT up by one row"},
        "2973": {"comment":"Up"},
        "2975": {"synopsis":"Scrolls the current window by A text rows, up or (C bit 2) down, in any mode.\nEntry: A = the rows; C = 2 up, 4 down."},
        "2978": {"synopsis":"Pages the screen in and moves the window: modes 3 and 4 through ROLL_SCROLL_VERT; mode 2\n(pixels and then attributes $2000 higher) and mode 1 (the Spectrum layout, next-row routine\nin IX) here.","comment":"The screen paged in"},
        "2981": {"comment":"Mode 3 or 4?"},
        "2989": {"comment":"Down?"},
        "2991": {"comment":"Up: +32 bytes per pixel row"},
        "2994": {"comment":"Mode 1's next pixel row down"},
        "3000": {"comment":"Down: -32 bytes"},
        "3003": {"comment":"Mode 1's pixel row up"},
        "3007": {"synopsis":"Modes 1 and 2: mode 2 moves the pixels (filled with 0), then the attributes $2000 higher\n(filled with ATTRT); mode 1 goes on at SCROLL_WIN_M1.","comment":"Mode 1?"},
        "3013": {"comment":"Mode 2: pixels filled with 0"},
        "3023": {"comment":"Moves the pixel rows"},
        "3030": {"comment":"The attributes, $2000 higher"},
        "3034": {"comment":"Filled with ATTRT"},
        "3043": {"comment":"Moves the attribute rows"},
        "3046": {"synopsis":"Mode 1 (the Spectrum's layout at $8000, attributes at $9800): moves the pixel rows that stay\nrow by row with the routine in IX, clears the freed ones to 0, then moves the attribute rows\nand fills the freed ones with ATTRT.","comment":"An LDI chain of E bytes"},
        "3054": {"comment":"Rows that stay"},
        "3055": {"comment":"Moving by more than the height? Error 30"},
        "3061": {"comment":"A = the rows to move by"},
        "3063": {"comment":"C = the width, B = the rows to move by"},
        "3069": {"synopsis":"Steps HL on by B pixel rows with the routine in IX: the row the first one is copied from."},
        "3074": {"synopsis":"Copies the pixel rows that stay (none when Z) from the source rows to the destination rows."},
        "3082": {"synopsis":"Copies one pixel row and steps both addresses to the next row."},
        "3086": {"comment":"Copies the row"},
        "3091": {"comment":"Next destination row"},
        "3096": {"comment":"Next source row"},
        "3102": {"synopsis":"Clears the freed pixel rows to 0, then works on the attributes."},
        "3106": {"comment":"Clears with 0"},
        "3108": {"synopsis":"Clears one freed pixel row (C bytes) and steps to the next."},
        "3110": {"synopsis":"Stores E in B bytes along the row."},
        "3122": {"comment":"The source's attribute address"},
        "3127": {"comment":"The destination's attribute address"},
        "3133": {"comment":"Moves the attribute rows that stay"},
        "3136": {"comment":"Freed attributes get ATTRT"},
        "3145": {"synopsis":"Turns a mode 1 pixel address into the address of its attribute byte: H = $98 + the screen\nthird, L kept.\nEntry: HL = the pixel address.\nExit: HL = the attribute's address; A = H."},
        "3151": {"comment":"Attributes from $9800"},
        "3155": {"synopsis":"Copies B' rows with the LDI chain at $4D00 from HL to DE, stepping both by BC after each\nrow.\nEntry: HL = the source; DE = the destination; BC = the stride; B' = the rows.\nExit: HL, DE past the last rows."},
        "3156": {"synopsis":"Copies one row and steps both addresses by the stride."},
        "3160": {"comment":"The chain copies the row"},
        "3174": {"synopsis":"Works out a window scroll: the address of the window's first pixel row to move (its top for\nup, its bottom row for down), its width in bytes for the mode, the pixel rows to move by and\nthe window's height in pixel rows. TEMPB3 is set to 0 (scroll).\nEntry: A = the text rows to move by; C = 2 up, 4 down.\nExit: HL = the address; E = the width in bytes; D = the pixel rows to move by; B' = the\nwindow's pixel rows; C kept."},
        "3175": {"comment":"C' = the text rows"},
        "3177": {"comment":"Pixel rows to move by"},
        "3181": {"comment":"TEMPB3 = 0: scroll"},
        "3185": {"comment":"E = WINDLHS, D = WINDTOP"},
        "3189": {"comment":"Up? The top-left address"},
        "3193": {"comment":"Down: the row below the window"},
        "3198": {"comment":"Its address"},
        "3201": {"comment":"Mode 3 or 4? -128 bytes"},
        "3211": {"comment":"Mode 2: -32 bytes"},
        "3216": {"comment":"Mode 1: one pixel row up in its layout"},
        "3220": {"comment":"Hides ADD HL,DE at $0C95, the modes 2-4 entry"},
        "3223": {"comment":"Sets Z: the address is already made"},
        "3224": {"synopsis":"Up: the window's top-left address (DE = WINDLHS, WINDTOP); then the window's pixel height in\nB' and its width in bytes in E."},
        "3227": {"comment":"WINDBOT - WINDTOP + 1: the rows"},
        "3238": {"comment":"B' = the window's pixel rows"},
        "3245": {"comment":"WINDRHS - WINDLHS + 1: the columns"},
        "3250": {"comment":"D = the pixel rows to move by"},
        "3252": {"comment":"Mode 1 or 2? A byte per column"},
        "3258": {"comment":"Mode 4? 4 bytes per column"},
        "3262": {"comment":"Mode 3: FL60R8 picks 1.5 or 2 bytes per column"},
        "3272": {"synopsis":"Adds A to E: the width in bytes for mode 3."},
        "3275": {"synopsis":"Mode 4: four bytes per column."},
        "3280": {"synopsis":"TEXT_ROWS_PIX for the rows in D. $3E12 calls it."},
        "3281": {"synopsis":"Turns a count of text rows into pixel rows: A x CSIZEH + DHADJ.\nEntry: A = the text rows.\nExit: A = the pixel rows.\nKeeps: BC."},
        "3283": {"comment":"B = CSIZEH - 5"},
        "3289": {"comment":"A = 5 x rows"},
        "3293": {"synopsis":"Adds the rows once for each pixel of character height over 5."},
        "3297": {"comment":"Plus DHADJ"},
        "3303": {"synopsis":"Moves HL one pixel row up in mode 1's (the Spectrum's) screen layout.\nEntry: HL = a pixel address.\nExit: HL = the one above.\nChanges: A.","comment":"Up within the character cell?"},
        "3309": {"comment":"Up a character row"},
        "3314": {"comment":"Same screen third: H + 8"},
        "3319": {"synopsis":"Moves HL one pixel row down: mode 1's layout (M1_ROW_DOWN) or 32 bytes on (mode 2). ROM1\n$F27C calls it.\nEntry: HL = a pixel address.\nExit: HL = the one below.","comment":"Mode 1?"},
        "3325": {"comment":"Mode 2: 32 bytes on"},
        "3332": {"synopsis":"Moves HL one pixel row down in mode 1's screen layout.\nEntry: HL = a pixel address.\nExit: HL = the one below.\nChanges: A.","comment":"Down within the character cell?"},
        "3337": {"synopsis":"The part of M1_ROW_DOWN after the cell's last pixel row: the next character row, or the next\nscreen third. $3CA9 calls it with H's low bits already 0.","comment":"Next character row"},
        "3342": {"comment":"Same screen third: back 8"},
        "3347": {"synopsis":"Checks the syntax of the line in the edit area: clears syntax-checking state (FLAGS bit 7,\nIFTYPE, REFFLG, SUBPPC, ERRNR), reads the line number if any and runs the statements in\nchecking mode. The main loop and ROM1 $C2BB call it.\nError: 29 for a line number that is too large."},
        "3350": {"comment":"FLAGS bit 7 clear: checking syntax"},
        "3355": {"comment":"IFTYPE, REFFLG = 0"},
        "3358": {"comment":"SUBPPC = 0"},
        "3361": {"comment":"ERRNR = 0"},
        "3364": {"comment":"CHAD to the edit line, its line number read"},
        "3367": {"comment":"Number fits? Checks the statements"},
        "3369": {"synopsis":"Stops with error code 29. Reached from many places, from the command table (DIR, FORMAT,\nERASE, MOVE, REF, COPY, token $D0, RENAME, PROTECT, HIDE: statements ROM 3.0 does not carry\nout) and from the calculator table (codes $0B, $4E, $50).","comment":"Stops with error code 29"},
        "3371": {"synopsis":"Runs the edit line from statement C: NSPPC = C, then RUN_ELINE. ROM1 $C2D2 and $1945 use it.\nEntry: C = the statement."},
        "3375": {"synopsis":"Runs the line in the edit area from statement NSPPC: no current program line (CLA's high\nbyte 0, PPC = $FFFF), NXTLINE at the end of the edit line, then the statement is found as\nfor a program line."},
        "3376": {"comment":"CLA's high byte 0: not in the program"},
        "3379": {"comment":"PPC = $FFFF: the edit line"},
        "3385": {"comment":"The edit line's start and page"},
        "3389": {"comment":"HL = WORKSP - 1: past the edit line"},
        "3393": {"comment":"The statement"},
        "3399": {"synopsis":"Skips forward to the statement token E that matches (D is the nesting token, such as DO for\nLOOP or IF for END IF; $1D9E searches) and goes on running from it. The CALL is followed by\nan error code byte: when the search fails, RST $08 reads it as the error ($18EE: 9, $1B18:\n0, $3278: 13). On success the caller is not returned to.\nEntry: D, E = the tokens; the error code after the CALL.","comment":"Searches forward for the statement"},
        "3402": {"comment":"Not found? Error code from after the CALL"},
        "3405": {"comment":"Drops the error byte's address"},
        "3406": {"comment":"SUBPPC = the statement found"},
        "3409": {"synopsis":"Goes on running at CHAD after a search or a jump moved it: records the page in CLAPG, CHADP\nand NXTLINEP, and, for a program line (CLA high byte nonzero), PPC and NXTLINE from the\nline's header. A WHILE or UNTIL condition at CHAD is skipped to the next statement.","comment":"The page in section C"},
        "3411": {"comment":"CLAPG, CHADP, NXTLINEP = it"},
        "3414": {"comment":"CLA: the current line"},
        "3417": {"comment":"The edit line? (high byte 0)"},
        "3421": {"comment":"PPC = the line's number"},
        "3429": {"comment":"The line's length"},
        "3433": {"comment":"NXTLINE = past the line"},
        "3437": {"synopsis":"At WHILE or UNTIL ($8A, $8B) skips their condition ($10F2) before running."},
        "3438": {"comment":"WHILE or UNTIL?"},
        "3449": {"synopsis":"Steps CHAD past a ':' and runs the next statement."},
        "3450": {"synopsis":"CHAD = HL, then STMT_START."},
        "3453": {"synopsis":"Starts a statement: clears the workspace and the calculator stack, increments SUBPPC.","comment":"WKEND = WORKSP, STKEND = FPSBOT"},
        "3456": {"comment":"SUBPPC + 1"},
        "3460": {"synopsis":"Finds the statement's first character from CHAD: skips spaces and control characters; a $0D\nends the line, a ':' is an empty statement.","comment":"CHAD"},
        "3463": {"synopsis":"Skips characters below '!' (a $0D ends the line). The ON ERROR handler is entered here."},
        "3464": {"comment":"Printable?"},
        "3468": {"comment":"End of the line?"},
        "3473": {"comment":"Skips it"},
        "3479": {"synopsis":"Runs one statement with STMT_DONE as its return: an empty one goes on at NEXT_STATEMENT.","comment":"':'? An empty statement"},
        "3483": {"comment":"Returns to STMT_DONE"},
        "3486": {"synopsis":"Runs the statement at HL with DE as its return ($198D passes $0E17): CSA = its start; CMDV\nis called first when its high byte is nonzero; CURCMD = its token. A character below $90\ngoes to $32DB; tokens $90-$F6 go through the command table at CMDADDRT, read with ROM1 paged\nin: an entry with bit 15 set runs with ROM1 in, else with ROM1 out. Above $F6: error 29.\nEntry: HL = the statement's first character; A = it; DE = the return."},
        "3487": {"comment":"CSA = the statement's start"},
        "3490": {"comment":"CMDV set? Called first"},
        "3498": {"comment":"CURCMD = the token"},
        "3501": {"comment":"Not a keyword? To $32DB"},
        "3506": {"comment":"Past the last command ($F6)?"},
        "3510": {"comment":"Two bytes an entry"},
        "3514": {"comment":"CMDADDRT: the command table"},
        "3518": {"comment":"LMPR: ROM1 in, to read the table"},
        "3526": {"comment":"DE = the routine"},
        "3529": {"comment":"Past the token"},
        "3530": {"comment":"A ROM1 routine? (bit 15)"},
        "3534": {"comment":"LMPR: ROM1 out again"},
        "3538": {"synopsis":"Jumps to the statement's routine."},
        "3540": {"synopsis":"Where a statement returns: tests ESC (error 15), puts back CHAD's page, then goes on with\nthe next statement, or, when NSPPC asks for a jump, to line NEWPPC (or the edit line when\nits high byte is $FF), statement NSPPC.\nError: 0 past the program's end; 31 when the statement is not there.","comment":"ESC pressed? Error 15"},
        "3543": {"comment":"ROM1 out, CHADP's page in"},
        "3546": {"comment":"NSPPC = $FF? No jump"},
        "3552": {"comment":"NEWPPC"},
        "3555": {"comment":"$FFxx? The edit line"},
        "3560": {"comment":"HL = the line, Z if it is there"},
        "3564": {"comment":"CLAPG and friends = its page"},
        "3570": {"comment":"The statement"},
        "3573": {"comment":"The line exists? Runs it"},
        "3575": {"comment":"A statement in a missing line? Error 31"},
        "3579": {"comment":"Past the program's end ($FF)?"},
        "3583": {"synopsis":"Stops with error code 0: the program ran past its end.","comment":"Stops with error code 0"},
        "3585": {"synopsis":"After a statement: ':' or THEN runs the next statement, $0D ends the line; anything else is\nerror 29."},
        "3586": {"synopsis":"Tests A for ':', THEN or $0D.","comment":"':'?"},
        "3588": {"synopsis":"Jumps to NEXT_STATEMENT."},
        "3591": {"comment":"THEN?"},
        "3595": {"comment":"End of the line?"},
        "3599": {"synopsis":"Stops with error code 29: an unknown command or a statement not ended properly.","comment":"Stops with error code 29"},
        "3601": {"synopsis":"The REM statement (command table entry $B7): drops STMT_DONE's return and ends the line.","comment":"Drops STMT_DONE"},
        "3602": {"synopsis":"The end of a line: returns when checking syntax; when running, goes on with the line at\nNXTLINE. ROM1 $C487 makes it a return address.","comment":"Checking? Returns"},
        "3607": {"synopsis":"LINE_END's running part after putting CHADP's page back; $1988 makes it STMT_DISPATCH_DE's\nreturn."},
        "3610": {"synopsis":"Goes on with the line at NXTLINE, from its first statement.\nError: 0 at the program's end.","comment":"NXTLINE"},
        "3613": {"comment":"The end ($FF)?"},
        "3617": {"comment":"Statement 0, run as 1"},
        "3618": {"synopsis":"Runs line HL from statement A (0 meaning 1): when HL has run into section D, the next page\nis paged in first.\nEntry: HL = the line; A = the statement.","comment":"0 becomes 1"},
        "3622": {"comment":"Into section D ($C000)?"},
        "3627": {"comment":"Next page, HL back in section C"},
        "3630": {"synopsis":"Records the page now in section C as CLAPG, CHADP and NXTLINEP; $194F jumps here."},
        "3634": {"synopsis":"Makes HL the current line: CLA = HL, PPC = its number, NXTLINE = the next line, HL = the\ntext.","comment":"CLA = the line"},
        "3637": {"comment":"PPC = its number (high byte first)"},
        "3645": {"comment":"Its length"},
        "3650": {"comment":"HL = the next line"},
        "3651": {"comment":"DE = the text"},
        "3652": {"synopsis":"Sets NXTLINE and runs statement A of the line whose text is at DE: NSPPC = $FF, SUBPPC = A -\n1; statement 1 starts at once, another is found by $10F8.\nEntry: HL = NXTLINE; DE = the line's text; A = the statement.\nError: 31 when the line has no such statement.","comment":"NXTLINE"},
        "3657": {"comment":"NSPPC = $FF: no jump pending"},
        "3662": {"comment":"SUBPPC = statement - 1"},
        "3666": {"comment":"Statement 1? CHAD = its start"},
        "3669": {"comment":"Finds statement D"},
        "3672": {"comment":"Found? Checks its separator"},
        "3675": {"synopsis":"Stops with error code 31: the line or statement to go to is not there.","comment":"Stops with error code 31"},
        "3677": {"synopsis":"Stops with error code 14 when ESC is pressed (and BREAKDI is 0); otherwise returns. Used by\nmany slow statements in ROM0 and ROM1."},
        "3681": {"comment":"Stops with error code 14"},
        "3683": {"synopsis":"Stops with error code 15 when ESC is pressed (and BREAKDI is 0): the test between\nstatements."},
        "3687": {"comment":"Stops with error code 15"},
        "3689": {"synopsis":"Tests the ESC key (row 3 bit 5, on port $F9 with A11 low).\nExit: NZ when ESC is up or BREAKDI is nonzero (break disabled); Z when it should stop.\nChanges: A.","comment":"A11 low: keyboard row 3"},
        "3693": {"comment":"ESC up?"},
        "3696": {"comment":"BREAKDI: breaks disabled?"},
        "3701": {"synopsis":"Enters the main loop from ROM1 $D884 (after AUTOSTEP is set): $05CF (SDTOP snapped to a\nline, the listing set up), then a fresh edit line."},
        "3706": {"synopsis":"The edit line has a line number: puts it into the program ($10A0); on an error reports it,\notherwise relists and edits a fresh line.","comment":"Into the program"},
        "3709": {"comment":"ERRNR set? Reports it"},
        "3716": {"synopsis":"Calls $05C6 (EPPC and SDTOP snapped to lines, the listing set up), then a fresh edit line."},
        "3719": {"synopsis":"Clears the edit line, then edits.","comment":"An empty edit line"},
        "3722": {"synopsis":"The main loop's top: selects stream 0, lets the user edit a line ($02A6), prepares it\n($3872) and checks its syntax. With an error in the lower screen the error's place is shown\nand the line is edited again; a numbered line goes into the program; a direct command is run\n(statement 1 of the edit line) and its report printed.","comment":"Stream 0"},
        "3725": {"comment":"Edits a line"},
        "3731": {"comment":"Checks its syntax"},
        "3734": {"comment":"SUBPPC 128 or more?"},
        "3740": {"comment":"ERRNR = $21"},
        "3745": {"synopsis":"After checking: an error while editing in the lower screen (DEVICE 1) strips the line's\nhidden numbers, beeps ($048E) and edits again; another device reports it.","comment":"An error?"},
        "3751": {"comment":"Editing in the lower screen?"},
        "3757": {"comment":"Back to the edit line's start"},
        "3760": {"comment":"Removes the hidden 5-byte numbers"},
        "3763": {"comment":"The error sound"},
        "3768": {"synopsis":"The line is correct: a line number takes it into the program; an empty line relists; a\ndirect command is run: FLAGS bit 7 set, ERRNR 0, NSPPC 1, SCRCT set from the upper window's\nprint row, then RUN_ELINE, and its report.","comment":"A line number?"},
        "3771": {"comment":"Too large? Error 29"},
        "3774": {"comment":"Numbered: into the program"},
        "3777": {"comment":"Nothing typed?"},
        "3781": {"comment":"KLFLAG bit 0?"},
        "3791": {"comment":"UWTOP"},
        "3795": {"comment":"SCRCT = print row - UWTOP + 1"},
        "3803": {"comment":"FLAGS bit 7: running"},
        "3808": {"comment":"ERRNR = 0"},
        "3811": {"comment":"NSPPC = 1"},
        "3818": {"comment":"Runs the edit line"},
        "3821": {"synopsis":"Where running stops (also a return address pushed at $0F31, $1CA1 and ROM1 $ED13): resets\nthe state of a run (DEFADD, XPTR, stream 0, FLAGE, AUTOFLG), clears the edit line, and\neither goes to the ON ERROR handler or prints the report and edits again.","comment":"ROM1 out, CHADP's page in"},
        "3825": {"comment":"SUBPPC 0?"},
        "3832": {"comment":"Then it comes from ONSTORE"},
        "3836": {"synopsis":"Resets DEFADD, XPTR, stream 0's entry (1), FLAGE and AUTOFLG; clears the edit line; ERRNR 0\nor $10 goes straight to the report, any other gives an ON ERROR handler the chance first."},
        "3839": {"comment":"DEFADD = 0"},
        "3842": {"comment":"XPTR = 0"},
        "3847": {"comment":"Stream 0's offset = 1"},
        "3850": {"comment":"FLAGE = 0"},
        "3853": {"comment":"AUTOFLG = 0"},
        "3859": {"comment":"An empty edit line"},
        "3862": {"comment":"ERRNR 0 or $10?"},
        "3872": {"comment":"FLAGS bit 7: running"},
        "3877": {"comment":"ONERRFLG bit 7: ON ERROR on? Cleared"},
        "3886": {"comment":"Records CONTINUE's place"},
        "3889": {"comment":"The handler returns to MAIN_REPORT"},
        "3896": {"comment":"Error 15 (ESC)?"},
        "3903": {"comment":"PPC, SUBPPC = CONTINUE's place (COPPC, COSPPC)"},
        "3914": {"synopsis":"Goes to the ON ERROR statement recorded in ERRLN and ERRSTAT and runs what follows its\nkeyword.\nError: 31 when the line or the ON ERROR statement is not there.","comment":"ERRLN"},
        "3917": {"comment":"Finds the line; Z if it is there"},
        "3922": {"comment":"Past its number and length"},
        "3926": {"comment":"ERRSTAT: the statement"},
        "3933": {"comment":"Its keyword"},
        "3934": {"comment":"ON ERROR?"},
        "3936": {"synopsis":"Stops with error 31 unless the statement found is ON ERROR; then runs what follows it."},
        "3939": {"comment":"Past ON ERROR"},
        "3940": {"comment":"Runs the handler"},
        "3943": {"synopsis":"Prints the report for ERRNR (PRINT_REPORT) in the lower screen, with FLAGS bit 7 clear, and\nedits again."},
        "3946": {"comment":"DFLAG bit 5"},
        "3951": {"comment":"FLAGS bit 7 clear"},
        "3963": {"synopsis":"Prints the report for error code A. Code 80 ($50) is the start-up screen: UMSGS's message 0,\nthe memory size in K ((PRAMTP + 1) x 16), then a key wait. Codes 1-79 take their text from\nERRMSGS, codes over 80 from the DOS's table (its page in DOSFLG, the table's address at\n$8210). The report is: the code, the message (for code 2 with the variable's name from $513F\nbefore it, '$' or '()' added), then ', ' or a new line, PPC, ':' and SUBPPC.\nEntry: A = the code.","comment":"Code 80: the start-up screen?"},
        "3968": {"comment":"UMSGS's message 0"},
        "3971": {"comment":"BGFLG = $82 while printing $82"},
        "3978": {"comment":"BGFLG = 0"},
        "3983": {"comment":"PRAMTP + 1: the RAM pages"},
        "3990": {"comment":"x 16: K"},
        "3996": {"comment":"Prints BC as a number"},
        "3999": {"comment":"'K'"},
        "4002": {"synopsis":"Waits for a key; then sets $5600 to $FF and records CONTINUE's place ($102F).","comment":"A key?"},
        "4010": {"comment":"$5600 = $FF"},
        "4018": {"synopsis":"Finds the message for code A: below 80 in ERRMSGS ($0FC2, inside the LD IX at $0FC1); over\n80 the DOS's table: C = code - 81, the DOS's page in and HL from $8210 (the LD IX then just\nskips the LD HL). ROM1 $DD4C finds it; then the code is printed.","comment":"A BASIC error? (to $0FC2)"},
        "4020": {"comment":"C = the DOS message's index"},
        "4023": {"comment":"DOSFLG: the DOS's page"},
        "4029": {"comment":"The DOS's message table"},
        "4033": {"comment":"At $0FC2: LD HL,(ERRMSGS); here it only skips"},
        "4037": {"comment":"DE = the table"},
        "4038": {"comment":"Finds the message"},
        "4041": {"comment":"WINDRHS - the message's length"},
        "4048": {"comment":"13 or more columns left?"},
        "4050": {"comment":"No: starts at the lower window's top row"},
        "4056": {"synopsis":"Prints the error code and a space, then for code 2 the variable's name."},
        "4057": {"comment":"ERRNR"},
        "4061": {"comment":"Prints A as a number"},
        "4068": {"comment":"Code 2?"},
        "4073": {"comment":"The name's type and length"},
        "4080": {"comment":"An array? '()'"},
        "4089": {"comment":"A number? (FLAGS bit 6)"},
        "4096": {"comment":"A string: \"$\" after the name"},
        "4098": {"comment":"Print it with the one extra byte"},
        "4100": {"synopsis":"An array name in the report: puts \"()\" after it and counts both.","comment":"Array: \"(\" after the name"},
        "4102": {"comment":"and \")\""},
        "4105": {"comment":"Two extra bytes"},
        "4106": {"synopsis":"Prints the variable's name from $5140 (PRINT_BLOCK), C bytes long.","comment":"Print the name"},
        "4109": {"synopsis":"Prints the message text built at $50C0 (BC bytes), then \", \" or, when the line had less than\n13 columns left, a new line; then the line number (PPC), \":\" and the statement (SUBPPC).\nFalls into ERR_SET_CONTINUE.","comment":"BC = the message length"},
        "4110": {"comment":"The message text"},
        "4116": {"comment":"Carry: under 13 columns were left"},
        "4117": {"comment":"Then a new line"},
        "4121": {"comment":"Else \", \""},
        "4126": {"synopsis":"Prints the separator in A, then \"PPC:SUBPPC\" through ROM1's number printers."},
        "4127": {"comment":"The line number"},
        "4131": {"comment":"Print BC (ROM1)"},
        "4134": {"comment":"Then \":\""},
        "4137": {"comment":"The statement number"},
        "4140": {"comment":"Print A (ROM1)"},
        "4143": {"synopsis":"Ends an error report: tidies the edit line (L04A5) and, unless ERRNR is 0, sets the point\nCONTINUE goes back to (COPPC, COSPPC). That is the statement a pending jump (NEWPPC, NSPPC)\nnames, else the statement that stopped (PPC, SUBPPC), or the one after it for errors 15 and\n16 unless CURCMD is $C1. A line number $FFxx (the edit line) sets nothing.\nEntry: ERRNR, PPC, SUBPPC, NEWPPC, NSPPC.\nExit: NSPPC = $FF; COPPC and COSPPC set.\nChanges: AF, B, HL; what L04A5 changes.","comment":"Tidy the edit line, set KCUR"},
        "4146": {"comment":"No error?"},
        "4151": {"comment":"Zero only for errors 15 and 16"},
        "4153": {"comment":"B = 0: CONTINUE repeats the statement"},
        "4158": {"comment":"Errors 15 and 16: unless CURCMD is $C1"},
        "4165": {"comment":"CONTINUE goes on at the next statement"},
        "4166": {"synopsis":"Takes the CONTINUE point from NEWPPC/NSPPC when a jump was pending, else from PPC/SUBPPC +\nB.","comment":"NSPPC: the statement of a pending jump"},
        "4170": {"comment":"No jump pending from now on"},
        "4172": {"comment":"HL = NEWPPC"},
        "4175": {"comment":"Was a jump pending?"},
        "4179": {"comment":"No: the statement that stopped, + B"},
        "4183": {"comment":"HL = PPC"},
        "4186": {"synopsis":"Stores HL in COPPC and A in COSPPC, unless HL is a line $FFxx.","comment":"A line $FFxx (the edit line)?"},
        "4187": {"comment":"Then no CONTINUE point"},
        "4189": {"comment":"COPPC = the line"},
        "4192": {"comment":"COSPPC = the statement"},
        "4196": {"synopsis":"Checks that the statement ends here (L0E01), then takes the hidden numbers out of the line\nwhose address was in HL (STRIP_NUMBERS). ROM1's $C479 jumps here when checking syntax; the\ncaller's return address is dropped (it is in HL during L0E01).\nEntry: HL = the line; CHAD at the statement's end.\nExit: as STRIP_NUMBERS.","comment":"Line address to the stack, return address to HL"},
        "4197": {"comment":"Check the statement ends here"},
        "4200": {"comment":"The line address back"},
        "4201": {"synopsis":"Takes every hidden number ($0E and its 5 bytes) out of the line at HL, up to and including\nits $0D, reclaiming the 6 bytes each time (JRECLAIM's body, L1E52).\nEntry: HL = the first byte of the line text.\nExit: HL past the $0D.\nChanges: AF, BC, HL; what L1E52 changes.","comment":"A hidden number is 6 bytes"},
        "4203": {"comment":"A hidden number marker?"},
        "4206": {"comment":"B = 0 when it is"},
        "4207": {"comment":"Reclaim $0E and its 5 bytes"},
        "4210": {"comment":"The byte now at HL"},
        "4212": {"comment":"The end of the line?"},
        "4217": {"synopsis":"Reads the number at the start of the edit line: points CHAD and the line page variables at\nELINE (SET_ELINE_PAGES), calls ROM1's $E80B, then reads decimal digits (READ_DECIMAL) and\ntakes the result off the calculator stack into BC (L1D3B).\nEntry: ELINE.\nExit: carry set when the number is too big for a line number ($FF00 or more); else BC = the\nnumber, Z when it is 0 (no number); CHAD at the first byte after the digits.\nChanges: AF, BC, DE, HL.","comment":"CHAD's page, CLAPG, NXTLINEP = ELINE's page"},
        "4220": {"comment":"CHAD = ELINE"},
        "4226": {"comment":"The first character"},
        "4227": {"comment":"Read the digits onto the calculator stack"},
        "4230": {"comment":"BC = the number"},
        "4233": {"comment":"Too big?"},
        "4234": {"comment":"A line number $FFxx?"},
        "4237": {"comment":"Then carry: not a line number"},
        "4238": {"comment":"Z when the number is 0"},
        "4241": {"synopsis":"Pages ELINE in (L1F35) and falls into SET_LINE_PAGES with its page.\nExit: HL = ELINE; A = its page; CLAPG, CHADP and NXTLINEP = that page.\nChanges: AF, HL.","comment":"HL = ELINE, A = its page"},
        "4244": {"synopsis":"Stores page A (bits 0-4) in CLAPG, CHADP and NXTLINEP.\nEntry: A = the page (HMPR's value).\nExit: A = the page.\nChanges: AF.","comment":"The page number only"},
        "4246": {"comment":"CLAPG"},
        "4249": {"comment":"CHADP"},
        "4252": {"comment":"NXTLINEP"},
        "4256": {"synopsis":"Puts the edit line into the program as line BC. Sets COMPFLG to $FF (L33C3) and skips one\nspace after the line number. Deletes the line of that number if there is one (L1E46); if the\nrest of the edit line is only its $0D, that is all. Otherwise opens room for a new line\nwhere the old one was or would be (L1E1B), writes the line number (high byte first) and the\nlength (low byte first), and copies the text from CHAD with JFARLDIR's body (L2A5E).\nEntry: BC = the line number; CHAD after the number in the edit line.\nExit: EPPC = the line number.\nError: stops with error code 1 when the text is $3F00 bytes or more.\nChanges: AF, BC, DE, HL; HMPR.","comment":"Keep the line number"},
        "4257": {"comment":"COMPFLG = $FF"},
        "4260": {"comment":"HL = WORKSP"},
        "4263": {"comment":"BC = CHAD, after the line number"},
        "4268": {"comment":"A space after the number?"},
        "4274": {"comment":"Only the $0D after it?"},
        "4278": {"comment":"Then stay on the space"},
        "4279": {"synopsis":"Moves CHAD past the space after the line number.","comment":"CHAD past the space"},
        "4283": {"synopsis":"HL = WORKSP - CHAD - 1, the length of the text to enter.","comment":"HL = WORKSP - CHAD - 1"},
        "4286": {"comment":"$3F00 bytes or more?"},
        "4289": {"comment":"Error 1"},
        "4292": {"comment":"HL = the line number, the length kept"},
        "4293": {"comment":"EPPC = the line number"},
        "4296": {"comment":"Delete the line of that number, if any"},
        "4299": {"comment":"BC = the length"},
        "4300": {"comment":"Only the $0D?"},
        "4303": {"comment":"Then the line is only deleted"},
        "4305": {"comment":"Plus 4 for the number and the length"},
        "4309": {"comment":"Open the room at HL"},
        "4312": {"comment":"The line number, high byte first"},
        "4320": {"comment":"The length, low byte first"},
        "4324": {"comment":"PAGCOUNT and MODCOUNT = the length"},
        "4328": {"comment":"DE = where the text goes"},
        "4329": {"comment":"C = its page"},
        "4332": {"comment":"HL = CHAD, A = its page"},
        "4335": {"comment":"Copy the text (JFARLDIR's body)"},
        "4338": {"synopsis":"Moves CHAD to the end of the current statement: the next \":\" or token $8D outside quotes, or\nthe line's $0D. Hidden numbers are skipped whole (SKIP_NUMBER_A).\nEntry: CHAD in the statement.\nExit: CHAD and HL at the \":\" / $8D (carry reset) or at the $0D (carry set); A = that byte.\nChanges: AF, DE, HL.","comment":"HL = CHAD"},
        "4339": {"comment":"D = 1 statement; E bit 0: inside quotes"},
        "4344": {"synopsis":"Sets CHAD to just before statement D of a line, so that RST $20 reads its first character:\none byte before the text for statement 1, at the separator before statement D otherwise.\nEntry: HL = the first byte of the line text; D = the statement number (1 or more).\nExit: CHAD and HL as above; carry set when the line ended first (CHAD at the $0D).\nChanges: AF, DE, HL.","comment":"One before the text"},
        "4345": {"synopsis":"FIND_STATEMENT with HL already one byte before the line text.\nEntry: HL = the byte before the text; D = the statement number.","comment":"Not inside quotes"},
        "4347": {"comment":"Statement 1 needs no scan"},
        "4349": {"synopsis":"The scan's next byte."},
        "4350": {"synopsis":"Tests the byte at HL: a hidden number is skipped, a quote flips E's bit 0, a \":\" or $8D is a\nseparator, the $0D ends the line.","comment":"The next byte"},
        "4351": {"comment":"A hidden number?"},
        "4353": {"comment":"Skip it"},
        "4356": {"comment":"A quote?"},
        "4360": {"comment":"Flip \"inside quotes\""},
        "4361": {"synopsis":"Is it a statement separator (\":\" or $8D) or the end of the line?","comment":"A separator?"},
        "4365": {"comment":"Token $8D separates statements too"},
        "4369": {"comment":"The end of the line?"},
        "4373": {"comment":"Counts the last statement"},
        "4374": {"comment":"Carry: the line ended"},
        "4377": {"synopsis":"A separator: ignored inside quotes, else counts one statement.","comment":"Inside quotes?"},
        "4381": {"synopsis":"Counts a statement off D; goes on until D reaches 0.","comment":"One more statement passed"},
        "4384": {"synopsis":"Stores the position in CHAD.","comment":"CHAD = the position"},
        "4388": {"synopsis":"The command whose word is at ROM1's $FDB7 (beside READ_CMD's): when running, skips the rest\nof the statement (SKIP_STATEMENT); when checking syntax, checks a list of expressions\nseparated by commas (EVAL_EXPR_BODY). These are the DATA items READ_CMD reads.\nEntry: CHAD at the first item.\nExit: A = the character after the statement or the list.","comment":"Running?"},
        "4391": {"comment":"Then skip the statement"},
        "4393": {"synopsis":"Checks one item and goes on while a comma follows.","comment":"Check an expression"},
        "4396": {"comment":"A comma after it?"},
        "4399": {"comment":"Past it"},
        "4402": {"synopsis":"When the character is \"#\", reads the stream number after it and selects that stream: the\nnumber is evaluated (L3A57; when checking syntax that returns from here), checked\n(STREAM_ENTRY) and the channel made current (SELECT_STREAM_DE).\nEntry: A = the character; CHAD at it.\nExit: NZ and nothing done when A is not \"#\".\nError: stops with error code 21 for a stream over 16, 47 for a closed one.","comment":"A \"#\"?"},
        "4405": {"synopsis":"STREAM_HASH after the test for \"#\".","comment":"Evaluate the stream number"},
        "4408": {"comment":"A = the number, 0-255"},
        "4411": {"comment":"DE = its displacement"},
        "4414": {"comment":"Select it, error 47 if closed"},
        "4416": {"synopsis":"Takes a stream number (0-255) off the calculator stack (L1D33) and finds its entry\n(STREAM_ENTRY).\nEntry: the number on the calculator stack.\nExit: as STREAM_ENTRY.\nError: 30 when it is not 0-255, 21 when it is over 16.","comment":"A = the number, 0-255"},
        "4419": {"synopsis":"Finds stream A's word in STREAMS: the displacement from CHANS to its channel, 0 for a closed\nstream. Stream 16 uses stream -4's word.\nEntry: A = the stream (0-16).\nExit: DE = the displacement; Z when it is 0 (closed); HL at the word's high byte.\nError: stops with error code 21 when A is over 16.\nChanges: AF, DE, HL; C = $FC for stream 16.","comment":"Stream 17 or more?"},
        "4423": {"synopsis":"STREAM_ENTRY without the test for 17 or more: A may also be a negative stream ($FB-$FF).","comment":"Stream 16?"},
        "4427": {"comment":"is stream -4 ($FC)"},
        "4430": {"synopsis":"HL = $5C16 + 2A, the word of stream A in STREAMS (streams -5 to 15 from $5C0C).","comment":"Streams -5 to 15 from $5C0C: $5C16 + 2A"},
        "4434": {"comment":"In the system variables"},
        "4436": {"comment":"DE = the displacement"},
        "4439": {"comment":"Zero: closed"},
        "4442": {"synopsis":"Stops with error code 21 (a stream number over 16).","comment":"Stops with error code 21"},
        "4444": {"synopsis":"Stops with error code 47 (the stream is not open).","comment":"Stops with error code 47"},
        "4446": {"synopsis":"Selects stream -2 (SELECT_STREAM with A = $FE). The LD HL after it hides a second entry at\n$1161, LD A,$FD, which selects stream -3.\nExit: as SELECT_STREAM.","comment":"Stream -2"},
        "4448": {"comment":"Hides LD A,$FD: stream -3 enters at $1161"},
        "4451": {"synopsis":"JSETSTRM's body: selects stream A: stores it in STRNO, finds its channel (STREAM_ENTRY_A)\nand makes the channel current (SELECT_STREAM_DE).\nEntry: A = the stream ($FB-$FF or 0-15).\nError: stops with error code 47 when the stream is closed.\nChanges: AF, BC, DE, HL, HL'.","comment":"STRNO = the stream"},
        "4454": {"comment":"DE = the displacement"},
        "4457": {"synopsis":"Makes the channel DE bytes on from CHANS current: CURCHL = CHANS + DE - 1, then as\nSELECT_CHANNEL.\nEntry: DE = the stream's displacement; Z when it is 0 (error 47).","comment":"Closed?"},
        "4459": {"comment":"CHANS"},
        "4463": {"comment":"CURCHL = CHANS + DE - 1"},
        "4464": {"synopsis":"Makes the channel at HL current (CURCHL = HL) and sets up for its letter (the byte 4 on):\nCLET = the letter; for \"S\", \"K\" and \"P\" DEVICE = 0, 1 or 2, then the temporary colours and\nthe window are set for it (DEVICE_COLOURS). Any other letter leaves DEVICE as it is.\nEntry: HL = the channel.\nExit: CURCHL, CLET; DEVICE, the temporary colours, WINDRHS-WINDBOT and CEXTAB for S, K, P.\nChanges: AF, BC, DE, HL, HL'."},
        "4467": {"comment":"The channel's letter is 4 bytes on"},
        "4472": {"comment":"CLET = the letter"},
        "4475": {"comment":"C = 2 for \"P\""},
        "4477": {"comment":"The printer?"},
        "4481": {"comment":"C = 1 for \"K\""},
        "4482": {"comment":"The lower screen?"},
        "4486": {"comment":"C = 0 for \"S\""},
        "4487": {"comment":"The upper screen? Any other: done"},
        "4490": {"synopsis":"Stores C in DEVICE and falls into DEVICE_COLOURS."},
        "4491": {"comment":"DEVICE = 0, 1 or 2"},
        "4494": {"synopsis":"Sets up printing for DEVICE: the temporary colours (TEMP_COLOURS), the window\n(WINDRHS-WINDBOT from UWRHS-UWBOT, or from LWRHS-LWBOT for the lower screen, DEVICE = 1) and\nthe colour table (MAKE_CEXTAB).\nEntry: DEVICE.\nChanges: AF, BC, DE, HL, HL'.","comment":"The temporary colours for DEVICE"},
        "4497": {"comment":"UWRHS, UWLHS"},
        "4500": {"comment":"UWTOP, UWBOT"},
        "4507": {"comment":"The lower screen?"},
        "4510": {"comment":"LWRHS, LWLHS"},
        "4513": {"comment":"LWTOP, LWBOT"},
        "4517": {"synopsis":"Stores HL and DE in WINDRHS/WINDLHS and WINDTOP/WINDBOT.","comment":"WINDRHS, WINDLHS"},
        "4520": {"comment":"WINDTOP, WINDBOT"},
        "4524": {"synopsis":"Makes CEXTAB for modes 3 and 4 (MODE 2 or 3): each byte of EXTAB (16 in mode 3, 32 in mode\n4) becomes (byte AND (M231NKT XOR M23PAPT)) XOR M23PAPT, so its set bits take the temporary\npen's bits and its clear bits the paper's. Nothing is done in modes 1 and 2.\nEntry: MODE, M23PAPT, M231NKT.\nExit: CEXTAB.\nChanges: AF, BC, DE, HL, HL'.","comment":"MODE"},
        "4527": {"comment":"Modes 1 and 2 (0, 1) need no table"},
        "4530": {"comment":"32 bytes in mode 4"},
        "4534": {"comment":"16 in mode 3"},
        "4536": {"synopsis":"D = the pen, E = the paper; HL = EXTAB, HL' = CEXTAB.","comment":"E = M23PAPT, D = M231NKT"},
        "4540": {"comment":"EXTAB"},
        "4544": {"comment":"CEXTAB, in HL'"},
        "4548": {"comment":"C = the bits that differ"},
        "4551": {"synopsis":"Makes one byte of CEXTAB."},
        "4552": {"comment":"Pen bits where EXTAB's are set"},
        "4554": {"comment":"and paper bits where they are clear"},
        "4556": {"comment":"Into CEXTAB"},
        "4562": {"synopsis":"Sets DEVICE to 0 (the upper screen) and falls into TEMP_COLOURS.","comment":"DEVICE = 0: the upper screen"},
        "4566": {"synopsis":"Copies the 9 permanent colour variables (THFATP-GOVERP) to the temporary ones (THFATT-\nGOVERT). For DEVICE other than 0 then ATTRT = BORDCR, MASKT = 0, OVERT = INVERT = 0 and\nM23PAPT/M231NKT = M23LSC. Outside mode 3 (MODE not 2) THFATT is set to 1.\nEntry: DEVICE; MODE.\nExit: BC = 0.\nChanges: AF, BC, DE, HL.","comment":"THFATP-GOVERP"},
        "4569": {"comment":"to THFATT-GOVERT"},
        "4572": {"comment":"9 bytes"},
        "4577": {"comment":"The upper screen?"},
        "4583": {"comment":"HL = 0 (B is 0 after the LDIR)"},
        "4585": {"comment":"OVERT and INVERT off"},
        "4588": {"comment":"BORDCR"},
        "4592": {"comment":"ATTRT = BORDCR, MASKT = 0"},
        "4595": {"comment":"M23LSC"},
        "4598": {"comment":"to M23PAPT and M231NKT"},
        "4601": {"synopsis":"THFATT = 1 unless the mode is 3 (MODE = 2).","comment":"Mode 3 (MODE = 2)?"},
        "4607": {"comment":"Other modes: THFATT = 1"},
        "4613": {"synopsis":"The command whose word is at ROM1's $FE07: POKE address, value [,value...] or POKE address,\nstring. An address and then an expression of either kind are read.\n1. A string (when running): its bytes are copied to the address (JFARLDIR's body, L2A5E).\n2. A number: the address is kept in calculator memory 0; up to 31 more numbers may follow\n   after commas. When running, the values are taken off the stack from the last and stored\n   down from address + count - 1 (a negative value is stored negated, -255 to 255).\nEntry: CHAD at the address.\nError: stops with error code 29 at a 33rd value; 30 for a value out of range.","comment":"The address, a number"},
        "4616": {"comment":"Needs a comma"},
        "4619": {"comment":"The value, either kind"},
        "4622": {"comment":"A number?"},
        "4624": {"comment":"A string: only when running"},
        "4625": {"comment":"A = page, DE = start, BC = length"},
        "4630": {"comment":"PAGCOUNT and MODCOUNT = the length"},
        "4633": {"comment":"A = the block, HL = the offset"},
        "4636": {"comment":"C = the destination page"},
        "4638": {"comment":"DE = the destination offset"},
        "4639": {"comment":"in $8000-$BFFF"},
        "4642": {"comment":"A = the string's page"},
        "4643": {"comment":"Copy (JFARLDIR's body)"},
        "4646": {"synopsis":"A number to store: when running, swaps it with the address (calc $06) and keeps the address\nin memory 0.","comment":"Checking syntax?"},
        "4648": {"comment":"Swap the value and the address"},
        "4650": {"comment":"Memory 0 = the address"},
        "4652": {"synopsis":"E counts the values after the first.","comment":"E = values after the first"},
        "4655": {"comment":"The character after the value"},
        "4658": {"synopsis":"Reads one more value after a comma; error 29 at the 32nd extra value."},
        "4659": {"comment":"The next value, a number"},
        "4663": {"comment":"Count it"},
        "4664": {"comment":"A 32nd extra value?"},
        "4666": {"comment":"Error 29"},
        "4669": {"synopsis":"Is there another value? When the list ends and the statement is running, stores them.","comment":"A comma: another value"},
        "4673": {"comment":"Checking syntax: done"},
        "4677": {"comment":"The address"},
        "4680": {"comment":"HL = the address, paged in"},
        "4684": {"comment":"HL = the last value's address"},
        "4685": {"comment":"E = the number of values"},
        "4686": {"synopsis":"Stores one value, the last first, at HL and moves HL down."},
        "4688": {"comment":"A = the value, Z when positive"},
        "4691": {"comment":"Over 255?"},
        "4696": {"comment":"A negative value: its negation"},
        "4698": {"synopsis":"Writes the byte."},
        "4700": {"comment":"Store the byte"},
        "4702": {"comment":"All of them?"},
        "4706": {"synopsis":"The command whose word is at ROM1's $FE09: DPOKE address,value. Reads two numbers (L3A5F;\nwhen checking syntax that returns from here) and stores the value (0-65535, L1D2E) at the\naddress, low byte first. The address is paged in through L3F9F.\nEntry: CHAD at the address.\nError: stops with error code 30 for a value out of range.","comment":"The address and the value"},
        "4709": {"comment":"BC = the value, 0-65535"},
        "4712": {"comment":"HL = the address, paged in"},
        "4715": {"comment":"Low byte first"},
        "4719": {"synopsis":"Takes an address in the linear space (16K block 0, then RAM page n as block n+1) off the\ncalculator stack and makes it addressable: L3F8C splits it into the block (A, 0-32) and the\noffset (HL). Blocks 0 and 1 are addressed at $0000-$7FFF as they are, blocks 2 and 3 at\n$8000-$FFFF with HMPR = page 1; block 4 and up at $8000-$BFFF with HMPR = block - 1. The LD\nDE at $1278 hides a second entry at $1279 (PUSH BC / PUSH AF), which ROM1's $E294 calls with\nthe block in A and the offset in HL (bit 7 set): it keeps DE and returns A, F as they were\non entry.\nEntry: the address on the calculator stack.\nExit: HL = the address; HMPR paged; A, F = HMPR as it was.\nError: stops with error code 30 for an address of 33 blocks or more.\nChanges: DE = $F5C5, HL, HMPR.\nKeeps: BC.","comment":"Keep BC"},
        "4720": {"comment":"Keep HMPR"},
        "4723": {"comment":"A = the block, HL = the offset"},
        "4726": {"comment":"In $8000-$BFFF"},
        "4728": {"comment":"Hides PUSH BC / PUSH AF ($1279)"},
        "4731": {"comment":"Block 4 or more?"},
        "4735": {"comment":"Block 2?"},
        "4740": {"comment":"Block 3?"},
        "4742": {"comment":"Blocks 0 and 1: in $0000-$7FFF"},
        "4744": {"comment":"Block 0?"},
        "4747": {"synopsis":"Block 1 or 3: moves HL up 16K (to section B or D).","comment":"16K up: section B or D"},
        "4749": {"synopsis":"Pages in page 1 (A = 2 - 1).","comment":"Page 1 (A = 2 - 1)"},
        "4750": {"synopsis":"HMPR's page = A - 1; restores A, F and BC.","comment":"Page = block - 1"},
        "4751": {"comment":"HMPR's page"},
        "4754": {"comment":"A, F as pushed"},
        "4757": {"synopsis":"Returns when the screen mode is 3 or 4 (MODE 2 or 3), otherwise stops with error code 34.\nEntry: MODE.\nChanges: AF.","comment":"MODE"},
        "4760": {"comment":"Mode 3 or 4?"},
        "4763": {"synopsis":"Stops with error code 34 (not mode 3 or 4); ROM1's $CF3D jumps here too.","comment":"Stops with error code 34"},
        "4765": {"synopsis":"The command whose word is at ROM1's $FDB5: READ var [,var...]. For each variable (looked up\nfor assignment by L2CF7, or after token $8C by L2CF6, which must name a string):\n1. Saves CHAD and CHADP in PRPTR and PRPTRP and moves CHAD to DATADD (L1F38).\n2. A space or comma there is stepped over; otherwise the next statement starting with token\n   $B9 (DATA) is searched for (L1D9C), keeping CLA. None left: error 3.\n3. The item is evaluated and assigned (L2AFA), or for the $8C form its text, without the\n   hidden numbers, is assigned as a string (READ_TEXT_ITEM).\n4. DATADD and DATADDP are left after the item and CHAD put back. When checking syntax only\n   the variable list is checked.\nEntry: A = the first character; CHAD at it.\nError: stops with error code 3 when the DATA runs out, 29 for a bad item or a numeric $8C\nvariable.","comment":"Token $8C: the text form"},
        "4767": {"comment":"Keep the answer (Z)"},
        "4770": {"comment":"Past the token; look the variable up"},
        "4773": {"comment":"FLAGS"},
        "4776": {"comment":"A numeric variable?"},
        "4778": {"comment":"Error 29"},
        "4781": {"synopsis":"Looks up an ordinary variable (L2CF7); when checking syntax, goes on to the next one.","comment":"Look the variable up for assignment"},
        "4784": {"comment":"Running?"},
        "4787": {"comment":"No: on to the next variable"},
        "4790": {"comment":"HL = CHAD"},
        "4791": {"comment":"PRPTR = CHAD"},
        "4794": {"comment":"CHADP"},
        "4797": {"comment":"PRPTRP = CHADP"},
        "4800": {"comment":"HL = DATADD, paged in"},
        "4803": {"comment":"CHADP = its page"},
        "4806": {"comment":"The byte at DATADD"},
        "4807": {"comment":"A space?"},
        "4811": {"comment":"A comma, between two items?"},
        "4815": {"comment":"CHAD = DATADD"},
        "4818": {"comment":"Look for token $B9 (DATA)"},
        "4820": {"comment":"Keep CLA"},
        "4824": {"comment":"Find the next DATA statement"},
        "4828": {"comment":"CLA put back"},
        "4832": {"comment":"CHADP = the page found"},
        "4837": {"comment":"Found?"},
        "4839": {"comment":"Stops with error code 3"},
        "4841": {"synopsis":"Steps over the space or comma before the item.","comment":"Past the space or comma"},
        "4845": {"synopsis":"Reads the item: the $8C form goes to READ_TEXT_ITEM, the other is evaluated and assigned.","comment":"The $8C form?"},
        "4848": {"comment":"Evaluate the item and assign it"},
        "4853": {"synopsis":"The $8C form: measures the item up to a \",\", \":\" or $0D (quoted text whole, hidden numbers\nskipped), copies it to the buffer at $4F00 (L3F4D), takes the hidden numbers out\n(STRIP_NUMBERS), stacks it as a string (L1CE7) and assigns it (L2B0F).","comment":"BC counts the item's bytes"},
        "4856": {"comment":"Keep the start"},
        "4857": {"synopsis":"Looks at the next byte of the item; a quote starts a quoted run.","comment":"A quote?"},
        "4862": {"synopsis":"Counts bytes up to the closing quote.","comment":"Up to the closing quote"},
        "4867": {"synopsis":"Skips a hidden number, counts the byte and stops at the item's end.","comment":"Skip a hidden number"},
        "4870": {"comment":"CHAD = here"},
        "4875": {"comment":"A \",\", \":\" or $0D?"},
        "4880": {"comment":"DE = the start"},
        "4881": {"comment":"Keep the count"},
        "4882": {"comment":"BC = the bytes spanned"},
        "4886": {"comment":"Copy them to $4F00, ended by $0D"},
        "4891": {"comment":"Take the hidden numbers out"},
        "4895": {"comment":"BC = the text's length"},
        "4896": {"comment":"Stack it as a string"},
        "4899": {"comment":"Assign it"},
        "4902": {"synopsis":"Keeps the DATA position in DATADD/DATADDP, puts CHAD back from PRPTR/PRPTRP (L3FCE) and goes\non while a comma follows. The CP $F1 hides POP AF at $133C, where the syntax check comes in.","comment":"HL = CHAD, after the item"},
        "4903": {"comment":"DATADD"},
        "4906": {"comment":"Its page"},
        "4908": {"comment":"DATADDP"},
        "4911": {"comment":"CHAD back from PRPTR"},
        "4917": {"comment":"and CHADP from PRPTRP, paged in"},
        "4923": {"comment":"Hides POP AF: the syntax check enters at $133C"},
        "4925": {"comment":"The character after the variable"},
        "4926": {"comment":"A comma: another variable"},
        "4929": {"comment":"Past it"},
        "4933": {"synopsis":"Reads the colour items (tokens $A1-$A6, each with a number) that may come before a graphics\ncommand's coordinates, each followed by \";\" or \",\". When running, first resets the temporary\ncolours from the permanent ones for the upper screen (UPPER_TEMP_COLS), sets bits 3-7 of\nMASKT and clears bit 6 of PFLAGT.\nEntry: CHAD at the first character.\nExit: carry set; A = the first character that is not a colour item.","comment":"Running?"},
        "4938": {"comment":"The upper screen"},
        "4942": {"comment":"Temporary colours = the permanent ones"},
        "4945": {"comment":"MASKT"},
        "4949": {"comment":"Bits 3-7 set"},
        "4953": {"comment":"PFLAGT bit 6 off"},
        "4955": {"synopsis":"Reads the current character."},
        "4956": {"synopsis":"Handles one colour item, or returns at the first other character.","comment":"A colour item?"},
        "4959": {"comment":"No: done"},
        "4961": {"comment":"Needs \";\" or \",\""},
        "4966": {"synopsis":"When A is a colour token ($A1-$A6), reads its number and sets the temporary colour: item A -\n$91 ($10-$15) through ROM1's $F02B, then remakes CEXTAB (MAKE_CEXTAB).\nEntry: A = the character; CHAD at it.\nExit: carry set when A was not a colour token (nothing done); else carry reset.\nError: stops with error code 30 when the number is not 0-255.","comment":"Below $A1?"},
        "4969": {"comment":"$A7 or more?"},
        "4971": {"comment":"Carry: not a colour token"},
        "4973": {"comment":"Keep the token"},
        "4974": {"comment":"Past it"},
        "4976": {"synopsis":"Reads the number for colour item A - $91 and, when running, sets it (COLOUR_ITEM_SET).\nEntry: A = the token or command code; CHAD at the number.\nExit: carry reset.","comment":"Item = the code - $91"},
        "4979": {"comment":"The value, a number"},
        "4982": {"comment":"B = the item"},
        "4983": {"comment":"Running?"},
        "4988": {"comment":"The value, 0-255"},
        "4991": {"comment":"D = the value"},
        "4992": {"comment":"A = the item"},
        "4993": {"synopsis":"Sets colour item A to D through ROM1's $F02B and remakes CEXTAB. ROM1's $DEFA jumps here.\nEntry: A = the item; D = the value.\nExit: carry reset.","comment":"Set item A to D (ROM1)"},
        "4996": {"comment":"Remake CEXTAB"},
        "4999": {"comment":"Carry reset"},
        "5001": {"synopsis":"The command for six words at ROM1's $FD87-$FD91 (CURCMD $91-$96, items 0-5): when running,\nsets the temporary colours for the upper screen (DEVICE 0, DEVICE_COLOURS); then reads and\nsets item CURCMD - $91 (COLOUR_ITEM_A) and makes the temporary colours permanent\n(TEMP_TO_PERM).\nEntry: CHAD at the number.\nError: stops with error code 30 when the number is not 0-255.","comment":"Running?"},
        "5006": {"comment":"The upper screen"},
        "5010": {"comment":"Its temporary colours and window"},
        "5013": {"synopsis":"Reads and sets the item for CURCMD.","comment":"The command's code, $91-$96"},
        "5016": {"comment":"Read and set the item"},
        "5019": {"comment":"Checking syntax: done"},
        "5022": {"synopsis":"Copies the 8 temporary colour variables ATTRT-GOVERT to ATTRP-GOVERP (THFATT is not copied).\nROM1's $ED92 calls it.\nChanges: BC = 0, DE, HL.","comment":"ATTRT-GOVERT"},
        "5025": {"comment":"to ATTRP-GOVERP"},
        "5028": {"synopsis":"Copies 8 bytes from HL to DE (LDIR). ROM1's $DFEA jumps here.\nEntry: HL = the source; DE = the destination.\nExit: HL, DE past them; BC = 0."},
        "5034": {"synopsis":"Reads the variable name at CHAD and looks the variable up. The name goes to $5140\n(READ_VAR_NAME) and its type/length byte to $513F; CHAD moves past it, its \"$\" and its \"(\".\n1. A simple numeric variable is looked for in NVARS's lists (FIND_NUM_VAR).\n2. A string or an array: the length byte becomes the length (1-10, else error 40) and the\n   variable is looked for in the SAVARS list (FIND_SAVARS). When checking syntax nothing is\n   looked up and NZ is returned.\nEntry: CHAD at the name.\nExit: NZ when found: for a number HL = its value, IX = its link word, C = its type byte; for\nthe others HL = its 3-byte length, C = its type byte, STRLOCN = its entry. Z when not found.\nFLAGS bit 6 set for a number.\nError: stops with error code 29 when there is no letter, 40 for a name too long.\nChanges: AF, BC, DE, HL, IX, alternates; HMPR.","comment":"The first character"},
        "5035": {"synopsis":"LOOKUP_VAR with the first character in A and HL at it.","comment":"The name to $5140, C = its length - 1"},
        "5038": {"comment":"CHAD past the name"},
        "5042": {"comment":"An array?"},
        "5048": {"comment":"FLAGS"},
        "5049": {"comment":"A string?"},
        "5053": {"comment":"A simple number"},
        "5054": {"comment":"Its type/length byte to $513F"},
        "5057": {"comment":"Checking syntax: no lookup"},
        "5058": {"synopsis":"Looks for the numeric variable named at $5140 (type/length byte C) in its letter's list: the\nletter's word at NVARS (26 words, a-z) and then each variable's link word are offsets to the\nnext variable; $FFFF ends the list. A variable matches on its type/length byte (bit 6, the\nFOR-NEXT bit, ignored) and the name's other letters.\nEntry: $5140 = the name; C = the type/length byte (length - 1 in bits 0-4).\nExit: NZ when found: HL = the value, IX = the link word, C = the type byte. Z when not.\nChanges: AF, BC, DE, HL, IX; HMPR.","comment":"The first letter"},
        "5061": {"comment":"Its word's offset: 2 x (letter - \"a\")"},
        "5067": {"comment":"HL = NVARS, paged in"},
        "5070": {"comment":"HL = the letter's word"},
        "5071": {"comment":"Hides POP HL: a name mismatch enters at $13D0"},
        "5073": {"synopsis":"Follows the link word at HL to the next variable of the letter.","comment":"The type/length byte to match"},
        "5074": {"comment":"DE = the offset to the next variable"},
        "5077": {"comment":"HL = that variable"},
        "5078": {"comment":"Carried?"},
        "5080": {"comment":"Above $BFFF?"},
        "5084": {"synopsis":"Compares the variable's type/length byte with C (bit 6 ignored).","comment":"The same type/length byte?"},
        "5085": {"comment":"Bit 6 (FOR-NEXT) aside"},
        "5087": {"comment":"HL at its link word"},
        "5088": {"comment":"No: the next one"},
        "5090": {"comment":"A = the name's length - 1"},
        "5093": {"comment":"Keep the link word's address"},
        "5094": {"comment":"HL = the name's second letter"},
        "5096": {"comment":"A one-letter name matches now"},
        "5098": {"comment":"B = the letters to compare"},
        "5099": {"comment":"The name's second letter"},
        "5103": {"synopsis":"Compares the rest of the name with $5141 on."},
        "5106": {"comment":"The same letter?"},
        "5107": {"comment":"No: drop the pointer, the next one"},
        "5114": {"synopsis":"Found: IX = the link word, C = the type byte, NZ.","comment":"IX = the link word"},
        "5116": {"comment":"C = the type byte"},
        "5119": {"synopsis":"Returns NZ: a match, or the syntax check, which looks nothing up.","comment":"NZ: found"},
        "5121": {"synopsis":"The offset carried: $FFFF ends the list (Z); otherwise L1F9D pages the next part in.","comment":"Offset $FFFF: the end of the list?"},
        "5122": {"comment":"Z: not found"},
        "5123": {"comment":"Page the part past $FFFF in"},
        "5126": {"comment":"Z: skips the next call"},
        "5127": {"synopsis":"Above $BFFF: L3FF2 moves HL down 16K with the next page.","comment":"Down 16K with the next page"},
        "5133": {"synopsis":"Copies a name of A AND $0F bytes from HL to $5140, keeps the address after it in BSTKEND,\nand looks for it in the SAVARS list with type A AND $6F (FIND_SAVARS).\nEntry: A = the type/length byte; HL = the name.\nExit: as FIND_SAVARS.","comment":"The name goes to $5140"},
        "5137": {"comment":"C = its length"},
        "5141": {"comment":"Copy it"},
        "5145": {"comment":"BSTKEND = after the name"},
        "5148": {"comment":"The type bits and the length"},
        "5152": {"synopsis":"A string or an array: makes the length 1-based, keeps the byte at $513F, and looks the name\nup when running (FIND_SAVARS).","comment":"Length 1-based"},
        "5154": {"comment":"Kept at $513F"},
        "5157": {"comment":"The length"},
        "5159": {"comment":"11 or more?"},
        "5161": {"comment":"Error 40"},
        "5164": {"comment":"FLAGS"},
        "5165": {"comment":"Checking syntax?"},
        "5166": {"comment":"Then return NZ"},
        "5169": {"synopsis":"Looks for the string or array named at $5140 in the SAVARS list. Each entry is a type/length\nbyte, 10 name bytes, a 3-byte length (pages, then bytes) and the data; a type byte $FF ends\nthe list. An entry matches on its type/length byte (bit 6 ignored) and the name.\nEntry: A = the type/length byte; $5140 = the name.\nExit: NZ when found: HL = the 3-byte length, C = the type byte, STRLOCN = the entry, its\npage in HMPR. Z when not found, with the main and alternate registers exchanged.\nChanges: AF, BC, DE, HL, BC', DE', HL'; HMPR.","comment":"C' = the type/length byte to match"},
        "5171": {"comment":"B' = the length's bits"},
        "5173": {"comment":"E' = the bits compared (not bit 6)"},
        "5176": {"comment":"HL = SAVARS, paged in"},
        "5179": {"comment":"A = HMPR"},
        "5181": {"synopsis":"Pages the entry in and compares its type/length byte with C'.","comment":"The name to match"},
        "5184": {"comment":"Page the entry in"},
        "5186": {"comment":"STRLOCN = the entry"},
        "5189": {"comment":"Its type/length byte"},
        "5192": {"comment":"The same type?"},
        "5196": {"comment":"B = the name's length"},
        "5201": {"comment":"The first letter"},
        "5203": {"comment":"Differs: the next entry"},
        "5207": {"synopsis":"Compares the next name byte.","comment":"The next letter"},
        "5213": {"synopsis":"Counts the name's bytes; all equal: found."},
        "5215": {"comment":"Found: the entry"},
        "5218": {"comment":"C = its type byte"},
        "5220": {"comment":"HL = the entry + 11, its length"},
        "5226": {"synopsis":"The type byte differs: $FF ends the list (Z).","comment":"Type $FF ends the list"},
        "5227": {"comment":"Z: not found (the banks exchanged)"},
        "5229": {"synopsis":"Moves to the next entry: past the 11 bytes of type and name, the 3-byte length and the data.","comment":"The entry"},
        "5232": {"comment":"Past its type and name"},
        "5236": {"comment":"A = HMPR + the length's pages"},
        "5240": {"comment":"BC = the length MOD 16K"},
        "5244": {"comment":"HL = the next entry"},
        "5245": {"comment":"Past $FFFF?"},
        "5247": {"comment":"Above $BFFF?"},
        "5249": {"comment":"No: test it"},
        "5251": {"comment":"Down 16K"},
        "5253": {"synopsis":"One page on; back to the test.","comment":"One page on"},
        "5256": {"synopsis":"Past $FFFF: back into $8000-$BFFF two pages on.","comment":"Two pages on"},
        "5257": {"comment":"Back into $8000-$BFFF"},
        "5261": {"synopsis":"Copies a variable name from the BASIC line to $5140: a letter, then letters (made lower\ncase), digits and \"_\", with spaces left out. A \"$\" after it makes a string, \"(\" an array.\nEntry: A = the first character (a letter, else error 29); HL = its address.\nExit: C = the length - 1, with bit 6 set for \"$(\" and bit 5 for a numeric name with \"(\";\nFLAGS bit 6 reset for a \"$\" name, set otherwise; DE past the name, \"$\" and \"(\"; Z when \"(\"\nfollowed; HL = FLAGS's address.\nError: stops with error code 40 at 32 characters.\nChanges: AF, BC, DE, HL.","comment":"At most 32 characters"},
        "5263": {"comment":"The name buffer"},
        "5266": {"comment":"A letter? Else error 29"},
        "5269": {"comment":"Lower case"},
        "5272": {"synopsis":"Reads the name's next character, skipping spaces."},
        "5273": {"comment":"The next character"},
        "5274": {"comment":"Spaces are left out"},
        "5278": {"comment":"A letter or digit?"},
        "5283": {"comment":"An underline?"},
        "5285": {"comment":"Anything else ends the name"},
        "5287": {"comment":"Kept as it is"},
        "5289": {"synopsis":"A letter or digit: made lower case.","comment":"Lower case"},
        "5291": {"synopsis":"Stores the character and counts it."},
        "5292": {"comment":"Into the buffer"},
        "5293": {"comment":"32 characters?"},
        "5295": {"comment":"CHAD at the name"},
        "5298": {"synopsis":"Stops with error code 40 (the name is too long).","comment":"Stops with error code 40"},
        "5300": {"synopsis":"The name has ended: C = its length - 1; looks for \"$\" and \"(\".","comment":"DE = the character after the name"},
        "5301": {"comment":"FLAGS"},
        "5304": {"comment":"C = the characters after the first"},
        "5308": {"comment":"A \"$\"?"},
        "5313": {"comment":"A string"},
        "5316": {"comment":"A \"(\" after the \"$\"?"},
        "5320": {"comment":"Past it"},
        "5321": {"comment":"A string array"},
        "5324": {"synopsis":"A numeric name: FLAGS bit 6 set; a \"(\" makes it an array (C bit 5).","comment":"A number"},
        "5326": {"comment":"A \"(\"?"},
        "5329": {"comment":"Past it"},
        "5330": {"comment":"A numeric array (or a function)"},
        "5333": {"comment":"Not reached by any branch or table found"},
        "5338": {"synopsis":"LOOKUP_VAR, then reports the kind: F' = the lookup's flags (Z: not found).\nExit: A = FLAGS shifted left: S set for a number, carry set when running.\nChanges: as LOOKUP_VAR.","comment":"Look the variable up"},
        "5341": {"comment":"F' = the lookup's flags"},
        "5342": {"comment":"FLAGS"},
        "5345": {"comment":"S: a number; carry: running"},
        "5347": {"synopsis":"Evaluates the expression at CHAD with ROM1 paged out (EVAL_EXPR_BODY through CALL_INLINE).\nWhen running, the value is left on the calculator stack; when checking syntax it is only\nchecked, and each number written in the line gets its hidden 5-byte form.\nEntry: CHAD at the expression.\nExit: C = the character after it (CHAD at it); A = FLAGS, bit 6 set for a number.\nError: stops with error code 29 for a bad expression; others from what it evaluates.\nChanges: AF, BC, DE, HL; the calculator's state.","comment":"EVAL_EXPR_BODY with ROM1 paged out"},
        "5352": {"comment":"C = the character after it"},
        "5353": {"comment":"A = FLAGS"},
        "5357": {"synopsis":"The expression evaluator. Values go to the calculator stack and operators to the machine\nstack, each as a word: D = its byte (bit 7: number result, bit 6: number operands, bits 0-3\nthe priority) and E = its calculator code; D = 0 marks the bottom.\n1. An operand: a variable (LOOKUP_VAR_A, or a DEF FN parameter through L336E), a number, a\n   string in quotes, a bracket, a function token $FF xx (EVAL_FUNCTION), or a unary \"-\" or\n   \"+\".\n2. After it, an operator: \"*\", \"+\", \"-\", \"/\", \"^\", \"<\", \"=\", \">\" or $FF $7A-$83\n   (EVAL_OPERATOR). While the waiting operator's priority is not lower than the new one's,\n   it is applied (calc $24 when running, a type check when checking syntax).\n3. No operator: the waiting ones are applied, and at the bottom word it returns through\n   RST18_GET_CHAR.\nEntry: CHAD at the expression.\nExit: A = the character after it; FLAGS bit 6 set for a number.\nError: stops with error code 29 for a bad expression.","comment":"The bottom word: priority 0"},
        "5359": {"comment":"The first character"},
        "5360": {"comment":"Hides RST $20 ($14F1): read the next operand"},
        "5362": {"comment":"The waiting operator (D, E)"},
        "5363": {"synopsis":"Reads an operand starting with the character in A.","comment":"Keep the character"},
        "5364": {"comment":"Upper case"},
        "5366": {"comment":"Above \"Z\"?"},
        "5370": {"comment":"Below \"A\"?"},
        "5375": {"comment":"DEFADD's high byte"},
        "5378": {"comment":"In a DEF FN?"},
        "5381": {"synopsis":"A variable: looked up (LOOKUP_VAR_A); not found: error 2 (L2D08).","comment":"The first letter"},
        "5382": {"comment":"Look the variable up"},
        "5385": {"comment":"Not found: error 2"},
        "5388": {"comment":"FLAGS"},
        "5391": {"comment":"A string?"},
        "5395": {"comment":"A numeric array?"},
        "5399": {"synopsis":"A string or an array: its subscripts or slice are dealt with (L2D54).","comment":"Subscripts or a slice"},
        "5402": {"comment":"FLAGS"},
        "5406": {"comment":"A string: on to a slice or an operator"},
        "5409": {"synopsis":"A simple number: when running, its value is copied to the calculator stack (L1D20).","comment":"Running: stack the value"},
        "5412": {"synopsis":"Pages CHAD's page back in and goes on to the operator.","comment":"Page CHAD's page back in"},
        "5415": {"comment":"The character after it"},
        "5419": {"synopsis":"Inside a DEF FN (DEFADD set): tries the name as a parameter first (L336E).","comment":"A parameter of the DEF FN?"},
        "5422": {"comment":"No: an ordinary variable"},
        "5424": {"comment":"A string parameter?"},
        "5431": {"synopsis":"A character above \"Z\": only the function prefix $FF is allowed. Code = the token after it -\n$1A; EVALUV is called first when it is set. Codes $21-$38 have a routine (EVAL_FN_ROUTINE),\n$39-$4E are functions of one number with priority $CF, $4F-$5C take their byte from\nEVAL_FN_PRIORITY.","comment":"The function prefix $FF?"},
        "5432": {"comment":"Anything else: error 29"},
        "5434": {"comment":"The function token"},
        "5436": {"comment":"Code = token - $1A"},
        "5439": {"comment":"CHAD at the token"},
        "5442": {"comment":"EVALUV"},
        "5445": {"comment":"Set?"},
        "5447": {"comment":"Then call it"},
        "5450": {"comment":"Codes $21-$38 have a routine"},
        "5454": {"comment":"Priority $CF: a function of a number"},
        "5456": {"comment":"Codes $39-$4E"},
        "5460": {"comment":"Code $5D or more?"},
        "5464": {"synopsis":"D = EVAL_FN_PRIORITY's byte for code E; the function waits for its operand.","comment":"DE = the code"},
        "5466": {"comment":"EVAL_FN_PRIORITY at $1647 + code"},
        "5470": {"comment":"D = the function's byte"},
        "5471": {"comment":"Read its operand"},
        "5473": {"synopsis":"The function routine for code $31 (token $FF $4B), a string result: with \"#\" after it, it\nbecomes the stream form, code $5B, a function of one number. Otherwise, when running, reads\na key (JREADREY's body, L1CB1) and goes on in ROM1's $CFCE.\nEntry: CHAD at the token.","comment":"The character after the token"},
        "5474": {"comment":"A \"#\"?"},
        "5476": {"comment":"Code $5B: the stream form"},
        "5478": {"comment":"Drop the return address"},
        "5479": {"comment":"The \"#\" form: a function of a number"},
        "5481": {"comment":"The return address back"},
        "5482": {"comment":"Checking syntax: a string result"},
        "5485": {"comment":"Read a key"},
        "5488": {"comment":"On in ROM1 (jumps)"},
        "5491": {"synopsis":"Codes $21-$38: the routine from EVAL_FN_ROUTINES, called with the return address set for a\nnumber (codes $21-$30, EVAL_NUM_RESULT) or a string (codes $31-$38, EVAL_STR_RESULT). A word\nwith bit 15 set is a ROM1 routine (RST30_GO).","comment":"Below $21?"},
        "5495": {"comment":"Word offset"},
        "5499": {"comment":"EVAL_FN_ROUTINES"},
        "5503": {"comment":"BC = the routine"},
        "5506": {"comment":"Return: a number"},
        "5509": {"comment":"Codes $21-$30?"},
        "5513": {"comment":"Codes $31-$38: a string"},
        "5516": {"synopsis":"Pushes the return address and runs the routine at BC.","comment":"The return address"},
        "5517": {"comment":"A ROM1 routine?"},
        "5519": {"comment":"Run it with ROM1 paged in"},
        "5522": {"comment":"A ROM0 routine: jump to it"},
        "5524": {"synopsis":"A string result: FLAGS bit 6 reset (L2E3E), then a slice or an operator may follow.","comment":"FLAGS bit 6 reset: a string"},
        "5529": {"synopsis":"A character below \"A\": a digit starts a number; the others are tested at EVAL_SYMBOL_2.","comment":"The character"},
        "5530": {"comment":"Below \"0\"?"},
        "5535": {"comment":"A digit?"},
        "5539": {"synopsis":"Stops with error code 29 (a bad expression).","comment":"Stops with error code 29"},
        "5541": {"synopsis":"The function routine for code $29 (token $FF $43): drops the return address and reads the\nbinary number that follows as a number written in the line (EVAL_NUMBER, READ_NUMBER).","comment":"Drop the return address"},
        "5542": {"comment":"The token byte"},
        "5543": {"synopsis":"A number written in the line. When running, its hidden 5-byte form (after the $0E) is copied\nto the calculator stack; when checking syntax it is read (READ_NUMBER) and its hidden form\nis put into the line after it (L3364).","comment":"FLAGS"},
        "5546": {"comment":"Checking syntax?"},
        "5549": {"synopsis":"Steps through the number's text to the $0E.","comment":"Past the text"},
        "5551": {"comment":"The hidden number?"},
        "5555": {"comment":"Its 5 bytes"},
        "5559": {"comment":"To STKEND"},
        "5565": {"comment":"STKEND past them"},
        "5569": {"synopsis":"CHAD = past the hidden number.","comment":"CHAD past the number"},
        "5574": {"synopsis":"Checking syntax: reads the number and inserts $0E and its 5 bytes after the text.","comment":"Read the number onto the stack"},
        "5577": {"comment":"HL = after its text"},
        "5580": {"comment":"Insert $0E and room for 5 bytes"},
        "5583": {"comment":"DE = the room"},
        "5584": {"comment":"HL = the number, taken off the stack"},
        "5587": {"comment":"Into the line"},
        "5592": {"comment":"HL past them"},
        "5595": {"synopsis":"A \"(\" after a value: a string is sliced (L2E69) and may be sliced again; after a number it\ngoes to the operator test.","comment":"FLAGS"},
        "5598": {"comment":"A number?"},
        "5602": {"comment":"Past the \"(\""},
        "5603": {"comment":"Slice the string"},
        "5606": {"comment":"Past the \")\""},
        "5609": {"synopsis":"A numeric result: FLAGS bit 6 set; on to the operator.","comment":"FLAGS"},
        "5612": {"comment":"Bit 6 set: a number"},
        "5614": {"comment":"The character after it"},
        "5617": {"synopsis":"Pages CHAD's page back in (L3FD7).","comment":"Page CHAD's page back in"},
        "5620": {"synopsis":"After a value: reads the character.","comment":"The character after the value"},
        "5621": {"synopsis":"Is it a \"(\" (a slice)?","comment":"A \"(\": a slice"},
        "5625": {"synopsis":"Looks for an operator: D = 0 (none) unless the character is one. Its index into\nEVAL_OP_PRIORITY is the character - $2A (\"*\" to \"/\", with \"^\" as 4) or $12-$14 (\"<\", \"=\",\n\">\"), or 8 + (the token after $FF - $7A) for $FF $7A-$83.","comment":"D = 0: no operator yet"},
        "5627": {"comment":"The prefix $FF?"},
        "5630": {"comment":"The token after it"},
        "5631": {"comment":"Below $7A?"},
        "5636": {"comment":"Above $83?"},
        "5640": {"comment":"CHAD at the token"},
        "5643": {"comment":"Index 8-17"},
        "5647": {"synopsis":"Not $FF: is it one of the operator characters?","comment":"Index = character - $2A"},
        "5651": {"comment":"A \".\"?"},
        "5655": {"comment":"\"*\" to \"/\"?"},
        "5659": {"comment":"Index 6-$11: not an operator"},
        "5663": {"comment":"\"<\", \"=\" or \">\"?"},
        "5667": {"comment":"A \"^\"?"},
        "5669": {"comment":"Index 4"},
        "5673": {"synopsis":"D = EVAL_OP_PRIORITY's byte for index E.","comment":"E = the index"},
        "5674": {"comment":"EVAL_OP_PRIORITY"},
        "5678": {"comment":"D = the operator's byte"},
        "5679": {"synopsis":"Takes the waiting operator (B, C) off the stack and compares the priorities: the new\noperator waits when it binds more tightly; both 0: the expression is done.","comment":"B, C = the waiting operator"},
        "5680": {"comment":"Does the new one bind more tightly?"},
        "5684": {"comment":"Then it waits"},
        "5686": {"comment":"Both 0?"},
        "5687": {"comment":"Then the expression is done"},
        "5690": {"comment":"Keep the new operator"},
        "5691": {"comment":"FLAGS"},
        "5695": {"comment":"Running?"},
        "5698": {"comment":"The operands' type"},
        "5699": {"comment":"Does the value's type differ?"},
        "5701": {"comment":"Then error 29"},
        "5706": {"synopsis":"Running: applies the waiting operator, code C (calc $24 with B = the code).","comment":"Keep the operator"},
        "5707": {"comment":"B = its code"},
        "5708": {"comment":"Apply it"},
        "5712": {"comment":"FLAGS"},
        "5715": {"synopsis":"Sets FLAGS bit 6 from the operator's bit 7 (a number result) and compares again.","comment":"The operator's byte"},
        "5716": {"comment":"The new operator back"},
        "5717": {"comment":"A number"},
        "5719": {"comment":"A number result?"},
        "5722": {"comment":"No: a string"},
        "5726": {"synopsis":"The new operator waits: for a string value only \"+\" (code 2), the operator at index $0E\n(code $15) and the comparisons $0F-$14 (codes $16-$1B, number results) are allowed; then the\nnext operand is read.","comment":"The waiting operator back"},
        "5727": {"comment":"FLAGS"},
        "5730": {"comment":"A number value?"},
        "5731": {"comment":"Then read the next operand"},
        "5734": {"comment":"A string value: A = the index"},
        "5735": {"comment":"A string result"},
        "5737": {"comment":"Index $0E?"},
        "5741": {"comment":"String operands"},
        "5743": {"comment":"Code 2 for \"+\""},
        "5744": {"comment":"A \"+\": joining strings"},
        "5748": {"comment":"A number result"},
        "5750": {"comment":"Any other below $0E?"},
        "5752": {"comment":"Then error 29"},
        "5755": {"synopsis":"Code = the index + 7.","comment":"Code = index + 7"},
        "5758": {"synopsis":"Reads the next operand."},
        "5761": {"synopsis":"The binary operators' bytes, by index (EVAL_OPERATOR): bit 7 a number result, bit 6 number\noperands, bits 0-3 the priority. 0-5 are \"*\", \"+\", \",\", \"-\", \"^\", \"/\" (\",\" is 0: no\noperator), 6 and 7 are unused, 8-17 the tokens $FF $7A-$83, 18-20 \"<\", \"=\", \">\". Read by\nEVAL_OP_TABLE ($162A).","comment":"0-3: \"*\" \"+\" \",\" \"-\""},
        "5765": {"comment":"4-7: \"^\" \"/\", two unused"},
        "5769": {"comment":"8-11: $FF $7A-$7D"},
        "5773": {"comment":"12-15: $FF $7E-$81"},
        "5777": {"comment":"16-19: $FF $82, $FF $83, \"<\", \"=\""},
        "5781": {"comment":"20: \">\""},
        "5782": {"synopsis":"The bytes of the function codes $4F-$5D (EVAL_UNARY_PRI reads them at $1647 + code), in the\nsame form as EVAL_OP_PRIORITY's: $8F a number from a string, $0F a string from a string, $4F\na string from a number; $5B is the \"#\" form of FN_READ_KEY, $5C has $C4, and $5D ($C9) is\nthe unary minus (EVAL_NEGATE).","comment":"Codes $4F-$52"},
        "5786": {"comment":"Codes $53-$56"},
        "5790": {"comment":"Codes $57-$5A"},
        "5794": {"comment":"Codes $5B-$5D ($5D: unary minus)"},
        "5797": {"synopsis":"The routines of the function codes $21-$38 (tokens $FF $3B-$52), read by EVAL_FN_ROUTINE: a\nword below $8000 is in ROM0, one with bit 15 set in ROM1. $0D29 (error 29) marks a token\nthat is not a function. Codes $21-$30 give numbers, $31-$38 strings.","comment":"Codes $21-$30: number results"},
        "5829": {"comment":"Codes $31-$38: string results"},
        "5845": {"synopsis":"Operands starting with a symbol: a quote, \"&\" or \".\" (a number), \"(\", \"-\" or \"+\"; anything\nelse is error 29.","comment":"A quote: a string"},
        "5849": {"comment":"\"&\": a number in hex"},
        "5853": {"comment":"A bracket"},
        "5857": {"comment":"A unary \"-\""},
        "5861": {"comment":"A \".\" starts a number"},
        "5863": {"synopsis":"\"&\" or \".\": a number (EVAL_NUMBER)."},
        "5866": {"comment":"A unary \"+\"?"},
        "5868": {"comment":"Anything else: error 29"},
        "5871": {"comment":"Past it; the operand"},
        "5875": {"synopsis":"A unary \"-\": code $5D with EVAL_FN_PRIORITY's byte $C9.","comment":"Code $5D"},
        "5880": {"synopsis":"A bracket: evaluates the expression inside (EVAL_EXPR) and needs a \")\" (L3A95).","comment":"Past the bracket"},
        "5881": {"comment":"Evaluate inside"},
        "5884": {"comment":"The character after it"},
        "5885": {"comment":"Needs a \")\""},
        "5891": {"synopsis":"A string in quotes. Without doubled quotes it is stacked where it is in the line (L1CE7);\nwith them it is copied to the buffer at $4F00, each \"\" as one quote, and stacked from there\n(L3C67). Nothing is stacked when checking syntax.\nError: stops with error code 29 when the line ends first, 42 when the copy passes 255 bytes.","comment":"Past the quote"},
        "5892": {"comment":"Keep the start"},
        "5893": {"comment":"FLAGS"},
        "5896": {"comment":"Carry: running"},
        "5897": {"comment":"kept in F'"},
        "5898": {"comment":"BC counts the bytes"},
        "5901": {"synopsis":"Counts the bytes up to the closing quote.","comment":"The next byte"},
        "5904": {"comment":"The end of the line?"},
        "5906": {"comment":"Error 29"},
        "5909": {"comment":"The closing quote?"},
        "5913": {"comment":"DE = the start"},
        "5914": {"comment":"The byte after the quote"},
        "5915": {"comment":"Another quote: doubled"},
        "5919": {"comment":"CHAD after the string"},
        "5922": {"comment":"Running?"},
        "5923": {"comment":"Stack the string where it is"},
        "5926": {"synopsis":"A string result (EVAL_STR_RESULT)."},
        "5929": {"synopsis":"Doubled quotes: copies the text to $4F00, C counting the bytes.","comment":"The copy goes to $4F00"},
        "5932": {"comment":"C counts its bytes"},
        "5935": {"synopsis":"Copies the next byte; a quote is tested at STR_QUOTES_PAIR.","comment":"The next byte"},
        "5937": {"comment":"A quote?"},
        "5941": {"synopsis":"Stores the byte when running.","comment":"The byte to copy"},
        "5942": {"comment":"Running?"},
        "5945": {"comment":"Copy it"},
        "5947": {"synopsis":"Counts it; 256 bytes is error 42."},
        "5948": {"comment":"Count it"},
        "5949": {"comment":"256 bytes?"},
        "5951": {"comment":"Stops with error code 42"},
        "5953": {"synopsis":"A quote: a second one is a quote in the text, anything else ends the string.","comment":"The byte after the quote"},
        "5955": {"comment":"A doubled quote?"},
        "5957": {"comment":"Then copy one quote"},
        "5959": {"comment":"BC = the length"},
        "5961": {"comment":"Back to the byte after the string"},
        "5962": {"comment":"CHAD there"},
        "5966": {"comment":"HL = $4F00"},
        "5967": {"comment":"Running?"},
        "5968": {"comment":"Stack a copy of the buffer"},
        "5973": {"synopsis":"Reads a number written in the line onto the calculator stack: after \"&\" in ROM1's $D0C5;\nafter the token byte $43 binary digits (16 at most, error 28 for more) into BC, stacked by\nL1CDD; otherwise decimal digits with a \".\" and an exponent \"E\" (sign, digits) as\nREAD_NUM_DECIMAL reads them.\nEntry: HL = CHAD at the number.\nExit: the number on the calculator stack; CHAD and A at the character after it.\nError: stops with error code 29 for a bad number, 28 for one too big.","comment":"The first character"},
        "5974": {"comment":"An \"&\"?"},
        "5978": {"comment":"A hex number: in ROM1 (jumps)"},
        "5981": {"synopsis":"The binary token: BC collects the \"0\" and \"1\" digits after it.","comment":"The binary token byte?"},
        "5986": {"comment":"BC collects the digits"},
        "5989": {"synopsis":"Reads the next character: \"0\" or \"1\" is a digit, anything else ends the number.","comment":"The next character"},
        "5990": {"comment":"A \"0\"?"},
        "5994": {"comment":"A \"1\"?"},
        "5996": {"comment":"Carry: the digit 1"},
        "5997": {"comment":"Anything else: stack BC, done"},
        "6000": {"synopsis":"Shifts the digit (the carry) into BC; a 17th digit is error 28.","comment":"Shift the digit in"},
        "6004": {"comment":"A 17th digit?"},
        "6006": {"comment":"Stops with error code 28"},
        "6008": {"synopsis":"A decimal number: the integer part (READ_DECIMAL), a fraction after \".\", then an exponent.","comment":"A \".\" first?"},
        "6012": {"comment":"The character after it"},
        "6013": {"comment":"Needs a digit"},
        "6016": {"comment":"Error 29"},
        "6019": {"comment":"The integer part is 0"},
        "6022": {"comment":"On to the fraction"},
        "6024": {"synopsis":"Reads the integer part.","comment":"The integer part"},
        "6027": {"comment":"A \".\"?"},
        "6031": {"comment":"The character after it"},
        "6032": {"comment":"A digit?"},
        "6037": {"synopsis":"The fraction: memory 0 holds the digit's place value, starting from calc constant $E6 (1).","comment":"Memory 0 = 1, the place value"},
        "6041": {"comment":"The digit"},
        "6044": {"synopsis":"Adds a digit: place value / 10 (calc $05 with constant $EC), times the digit, added.","comment":"The digit's value"},
        "6047": {"comment":"value + digit x (memory 0 / 10)"},
        "6056": {"comment":"The next character"},
        "6057": {"synopsis":"Another digit?","comment":"A digit?"},
        "6062": {"synopsis":"An \"E\" or \"e\" starts the exponent; anything else ends the number.","comment":"Upper case"},
        "6064": {"comment":"An \"E\"?"},
        "6067": {"comment":"The character after it"},
        "6068": {"comment":"C = \"+\", the sign by default"},
        "6073": {"comment":"A \"-\"?"},
        "6077": {"comment":"C = \"-\""},
        "6078": {"synopsis":"Steps past the sign.","comment":"Past the sign"},
        "6079": {"synopsis":"Needs a digit; reads the exponent (READ_DECIMAL) as a byte below 128.","comment":"Needs a digit"},
        "6082": {"comment":"Error 29"},
        "6085": {"comment":"Keep the sign"},
        "6086": {"comment":"Read the exponent"},
        "6089": {"comment":"A = it, 0-255"},
        "6092": {"comment":"Over 255?"},
        "6094": {"comment":"128 or more?"},
        "6097": {"synopsis":"Stops with error code 28 (a number too big). ROM1's number routines ($CA3E, $CC14, $CCA4,\n$CCC8, $D0E7) jump here too.","comment":"Stops with error code 28"},
        "6099": {"synopsis":"Negates the exponent after \"-\"."},
        "6100": {"comment":"C = the sign"},
        "6101": {"comment":"A \"+\" ($2B) has bit 1 set"},
        "6105": {"comment":"A \"-\": a negative exponent"},
        "6107": {"synopsis":"Scales the number by the exponent in A in ROM1's $DBD4.","comment":"Scale by the exponent (ROM1, jumps)"},
        "6110": {"synopsis":"Reads decimal digits onto the calculator stack: starts from calc constant $E1 (0) and for\neach digit multiplies by constant $EC (10, calc $00) and adds the digit (calc $23, $01).\nDigits are read with NEXT_CHAR_RAW, so spaces end the number.\nEntry: A = the first character (CHAD at it).\nExit: the number on the calculator stack (0 when A is not a digit); A = the first character\nthat is not a digit, CHAD at it.\nChanges: AF, B, HL; the calculator's state.","comment":"Keep the character"},
        "6111": {"comment":"Start from 0"},
        "6115": {"comment":"Is it a digit?"},
        "6117": {"synopsis":"value = value x 10 + the digit, then the next character.","comment":"The digit's value"},
        "6120": {"comment":"value x 10 + the digit"},
        "6126": {"comment":"The next byte, nothing skipped"},
        "6129": {"synopsis":"Another digit?","comment":"A digit?"},
        "6135": {"synopsis":"Runs machine code at the linear address on the calculator stack (LINEAR_ADDR) and returns to\nL1CE7 + 4 ($1CEB), which stacks the string AEDCB the code leaves, with IY = L1CDD (which\nstacks BC as a number). The code is called with A = TEMPB3, BC = its address and its page in\nHMPR; HMPR and IX are put back after it. ROM1's $D10F jumps here (through JUMP_INLINE). The\nLD IY hides a second entry at $17FB, LD HL,$1CDD, used by ROM1's $D114: it returns to L1CDD,\nstacking BC. The third entry, CALL_CODE, returns to the caller.\nEntry: the address on the calculator stack.","comment":"Return through $1CEB: stack AEDCB"},
        "6138": {"comment":"IY = L1CDD; hides LD HL,$1CDD ($17FB)"},
        "6142": {"comment":"The return address for the code"},
        "6143": {"synopsis":"Runs machine code at the linear address on the calculator stack (see CALL_CODE_STR) and\nreturns to the caller. ROM1's $EB6E jumps here (through JUMP_INLINE).\nEntry: the address on the calculator stack.\nExit: as the code leaves it; HMPR and IX put back.","comment":"Keep IX"},
        "6145": {"comment":"Page and address of the user's code from the argument"},
        "6148": {"comment":"Keep that address in BC"},
        "6150": {"comment":"Keep the HMPR that $126F returns"},
        "6151": {"comment":"TEMPB3 for the called code"},
        "6154": {"comment":"Call the code at HL"},
        "6157": {"comment":"Put HMPR back"},
        "6160": {"comment":"Restore IX; returns to the string stacker pushed first"},
        "6163": {"synopsis":"MEM$'s body (the function table at $16A5 reaches it): MEM$(a TO b). Checks the '(', the\nfirst\nnumber and TO, then the second number and the ')'; when running it jumps to ROM1's $D06F to\nmake the string.\nEntry: the BASIC pointer at MEM$.\nExit: through ROM1's $D06F; returns at once when checking syntax.\nError: stops with error code 29 when TO is missing.","comment":"Next character must be '('"},
        "6166": {"comment":"The first number"},
        "6169": {"comment":"TO?"},
        "6171": {"comment":"No: stops with error code 29"},
        "6174": {"comment":"The second number and ')'; carry when running"},
        "6177": {"comment":"Checking syntax: done"},
        "6178": {"comment":"Make the string in ROM1"},
        "6181": {"synopsis":"RAMTOP's body (the function table at $16A5 reaches it): stacks RAMTOP as an address counted\nfrom the page LMPR shows at $0000, as STK_PAGE_REL does.\nEntry: the BASIC pointer at RAMTOP.\nExit: the address on the calculator stack; returns at once when checking syntax.","comment":"Past RAMTOP; done when checking syntax"},
        "6184": {"comment":"RAMTOP's offset and page"},
        "6190": {"comment":"B = RAMTOPP"},
        "6191": {"synopsis":"Stacks the paged address B:HL as a number counted from the page LMPR shows at $0000: the\npage\nless LMPR's, times 16K, plus HL's low 14 bits. ROM1's $E949 jumps here.\nEntry: B = the page; HL = the offset.\nExit: the number on the calculator stack.\nChanges: AF, BC, DE, HL.","comment":"LMPR: the low page"},
        "6194": {"comment":"Page relative to LMPR's"},
        "6198": {"synopsis":"FREE's body (the function table at $16A5 reaches it): stacks the free memory between WKEND\nand RAMTOP (FREE_MEMORY) as a number.\nEntry: the BASIC pointer at FREE.\nExit: the number on the calculator stack; returns at once when checking syntax.","comment":"Past FREE; done when checking syntax"},
        "6201": {"comment":"A:HL = RAMTOP - WKEND - 1, linear"},
        "6206": {"synopsis":"Stacks the paged address A:HL as a 19-bit linear number (page x 16K + the offset's low 14\nbits).\nEntry: A = the page; HL = the offset.\nExit: the number on the calculator stack.\nChanges: AF, BC, DE, HL.","comment":"To linear: A = bits 18-16, HL = bits 15-0"},
        "6209": {"synopsis":"Stacks the 19-bit number A:HL: HL as an integer, then the calculator adds A (bits 18-16)\ntimes 65536 to it (probably; the operations $23, $00, $05, $01 are not yet read).\nEntry: A = bits 18-16; HL = bits 15-0.\nExit: the number on the calculator stack; returns from the caller's caller ($34).\nChanges: AF, BC, DE, HL.","comment":"Keep the high bits"},
        "6210": {"comment":"Stack HL as an integer"},
        "6213": {"comment":"B = the high bits"},
        "6214": {"comment":"Combine them; ends with $34, returning past the caller"},
        "6224": {"synopsis":"XMOUSE's body (the function table at $16A5 reaches it): stacks the word at MXCRD.\nEntry: the BASIC pointer at XMOUSE.\nExit: the number on the calculator stack; returns at once when checking syntax.","comment":"Past XMOUSE; done when checking syntax"},
        "6227": {"comment":"MXCRD, stacked as an integer"},
        "6233": {"synopsis":"YMOUSE's body (the function table at $16A5 reaches it): stacks the byte at MYCRD.\nEntry: the BASIC pointer at YMOUSE.\nExit: the number on the calculator stack; returns at once when checking syntax.","comment":"Past YMOUSE; done when checking syntax"},
        "6236": {"comment":"MYCRD"},
        "6241": {"synopsis":"XPEN's body (the function table at $16A5 reaches it): stacks LPEN (port $00F8, the beam's\nhorizontal position) shifted right twice, 0-63.\nEntry: the BASIC pointer at XPEN.\nExit: the number on the calculator stack; returns at once when checking syntax.","comment":"Past XPEN; done when checking syntax"},
        "6244": {"comment":"Port $00F8: LPEN"},
        "6249": {"comment":"Drop the two low bits"},
        "6255": {"synopsis":"YPEN's body (the function table at $16A5 reaches it): stacks HPEN (port $01F8, the beam's\nline).\nEntry: the BASIC pointer at YPEN.\nExit: the number on the calculator stack; returns at once when checking syntax.","comment":"Past YPEN; done when checking syntax"},
        "6258": {"comment":"Port $01F8: HPEN"},
        "6263": {"synopsis":"Calculator operation $46 (the table at ROM1 $C6FB points here): IN. Takes the port number\noff\nthe calculator stack and stacks the byte read from it.\nEntry: the port (0-65535) on the calculator stack.\nExit: the byte on the calculator stack.\nError: stops with error code 30 when the port is out of range.","comment":"BC = the port"},
        "6266": {"synopsis":"Reads port BC and stacks the byte.\nEntry: BC = the port.\nExit: the byte on the calculator stack.","comment":"Read the port"},
        "6268": {"synopsis":"Stacks A as an integer (STK_A) and returns.\nEntry: A = the byte.\nExit: as STK_A.","comment":"Stack A"},
        "6271": {"synopsis":"Calculator operation $1C (the table at ROM1 $C6FB points here): swaps the top value of the\ncalculator stack with the third.\nEntry: three values on the calculator stack.\nExit: DE = STKEND.\nChanges: AF, BC, DE, HL.","comment":"BC = -10: the third from the top"},
        "6275": {"synopsis":"Calculator operation $1D (the table at ROM1 $C6FB points here): swaps the second value of\nthe\ncalculator stack with the third.\nEntry: three values on the calculator stack.\nExit: DE = STKEND.\nChanges: AF, BC, DE, HL.","comment":"BC = -5: the value below the second"},
        "6277": {"comment":"Start at the second: STKEND - 10"},
        "6282": {"synopsis":"Swaps the top two values of the calculator stack.\nEntry: two values on the calculator stack.\nExit: DE = STKEND.\nChanges: AF, BC, DE, HL.","comment":"BC = -5: the second from the top"},
        "6284": {"synopsis":"Swaps the top value of the calculator stack with the one C bytes below it (C negative).\nEntry: C = the distance, $F6 or $FB.\nExit: DE = STKEND.\nChanges: AF, BC, DE, HL.","comment":"Start at the top: STKEND - 5"},
        "6287": {"synopsis":"Swaps the 5 bytes at STKEND + DE with the 5 bytes BC further on (DE and BC negative; B is\ntaken from D, $FF).\nEntry: DE = the first value's distance from STKEND; C = the second's from the first.\nExit: DE = STKEND.\nChanges: AF, BC, DE, HL.","comment":"BC = $FFxx: a negative distance"},
        "6288": {"comment":"STKEND"},
        "6291": {"comment":"DE = the first value"},
        "6294": {"comment":"HL = the second value"},
        "6295": {"synopsis":"Calculator operation $06 (the table at ROM1 $C6FB points here): swaps the 5 bytes at DE with\nthe 5 at HL; from the calculator, the top two values. Also the tail of the swaps above.\nEntry: DE, HL = the two values.\nExit: DE = STKEND.\nChanges: AF, BC, DE, HL.","comment":"Five bytes"},
        "6297": {"synopsis":"Swaps one byte of the two values; ROM1's $EDC9 also loops here with its own B.\nEntry: DE, HL = the bytes; B = the count.\nExit: DE = STKEND.","comment":"Swap a byte"},
        "6306": {"comment":"DE = STKEND"},
        "6311": {"synopsis":"PI's body (the function table at $16A5 reaches it): stacks calculator constant 16 and adds 1\nto its exponent, doubling it.\nEntry: the BASIC pointer at PI.\nExit: the number on the calculator stack; returns at once when checking syntax.","comment":"Past PI; done when checking syntax"},
        "6314": {"comment":"Stack constant 16"},
        "6317": {"comment":"Double it: exponent + 1"},
        "6319": {"synopsis":"ITEM's body (the function table at $16A5 reaches it): looks at the DATA item the DATADD\npointer is at and stacks 0 when there is none (no ',' or space there), 1 for a string (a\nquote, or a name ending in '$'), 2 for anything else.\nEntry: the BASIC pointer at ITEM.\nExit: 0, 1 or 2 on the calculator stack; HMPR as on entry; returns at once when checking\nsyntax.","comment":"Past ITEM; done when checking syntax"},
        "6322": {"comment":"Keep HMPR"},
        "6325": {"comment":"DATADD paged in, HL = it"},
        "6328": {"comment":"0: no item"},
        "6331": {"comment":"The byte at the DATA pointer"},
        "6332": {"comment":"A space?"},
        "6336": {"comment":"Or a ','?"},
        "6338": {"comment":"Neither: no item"},
        "6340": {"synopsis":"An item follows: counts 1, skips to the next character and checks for a quote.\nEntry: HL = the separator.\nExit: to ITEM_SCAN_LP or ITEM_DONE.","comment":"At least 1"},
        "6341": {"comment":"Next character above a space"},
        "6344": {"comment":"A quote: a string"},
        "6348": {"synopsis":"Skips the letters, digits and spaces of a name; a '$' after it makes a string (1), anything\nelse\na number (2).\nEntry: HL = the item.\nExit: C = 1 or 2.","comment":"Next byte of the item"},
        "6350": {"comment":"Letter or digit?"},
        "6355": {"comment":"Space?"},
        "6359": {"comment":"'$': a string name"},
        "6363": {"comment":"Otherwise a number: 2"},
        "6364": {"synopsis":"Puts HMPR back and stacks the count in C.\nEntry: C = 0-2; HMPR on the stack.\nExit: the number on the calculator stack.","comment":"Put HMPR back"},
        "6367": {"comment":"Stack BC"},
        "6370": {"synopsis":"DO's body (token $D4; ROM1's command table at $FDC5 reaches it). Tests the WHILE or UNTIL\nafter DO (DO_COND_TEST); when the loop is to run, pushes a DO entry (type $80) on the BASIC\nstack; when not, skips to after the matching LOOP (SKIP_TO_LOOP).\nEntry: the BASIC pointer past DO.\nExit: to the statement loop.\nError: stops with error code 9 when there is no matching LOOP, 41 when the BASIC stack is\nfull.","comment":"WHILE/UNTIL: carry when the loop runs"},
        "6373": {"comment":"Runs: push the entry"},
        "6375": {"synopsis":"Skips past the LOOP that matches this DO (nested DOs counted) through $0D47, which jumps to\nthe statement after it; EXIT IF comes here too. The byte after the CALL is the error code\n$0D47 stops with when there is none.\nEntry: the statement's return address on the stack.\nExit: does not return.\nError: stops with error code 9 when no LOOP follows.","comment":"Drop the return address"},
        "6376": {"comment":"Open with DO ($D4), close with LOOP ($D5)"},
        "6379": {"comment":"Find it and go on there"},
        "6382": {"synopsis":"The error code $0D47 stops with (through RST $08's body, as the return address points here)\nwhen SKIP_TO_LOOP finds no LOOP: 9."},
        "6383": {"synopsis":"Pushes a DO entry (type $80) on the BASIC stack.\nEntry: none.\nExit: as BSTK_PUSH.","comment":"Type $80: DO"},
        "6385": {"synopsis":"Pushes a 4-byte entry on the BASIC stack, which grows down from BSTKEND towards HEAPEND: the\ntype in bits 7-5 with CLAPG's page in bits 4-0, then CLA (the current line's address) and\nSUBPPC. GO SUB pushes type $00, DO type $80, PROC $40.\nEntry: B = the type.\nExit: BSTKEND = the new entry; HL = its last byte.\nError: stops with error code 41 when the entry does not fit above HEAPEND.\nChanges: AF, DE, HL.","comment":"BSTKEND - 4: the new entry"},
        "6392": {"comment":"Above HEAPEND?"},
        "6398": {"comment":"Yes: room"},
        "6400": {"synopsis":"The BASIC stack has no room: stops with error code 41. $34BA jumps here too.\nEntry: none.\nExit: does not return.","comment":"Stops with error code 41"},
        "6402": {"synopsis":"Writes the new entry: type and page, CLA, SUBPPC.\nEntry: HL + DE = BSTKEND - 4; DE = HEAPEND; B = the type.\nExit: as BSTK_PUSH.","comment":"HL = the entry - 1"},
        "6404": {"comment":"CLAPG's page"},
        "6409": {"comment":"With the type"},
        "6411": {"comment":"SUBPPC"},
        "6414": {"comment":"CLA"},
        "6418": {"synopsis":"Makes HL the new BSTKEND and writes DE and A after the entry's first byte, which the caller\nhas stored. $3269 comes here with its own entry.\nEntry: HL = the entry; DE = the address; A = the statement.\nExit: HL = the entry's last byte.\nChanges: HL.","comment":"The new BSTKEND"},
        "6421": {"comment":"The address"},
        "6426": {"comment":"The statement"},
        "6428": {"synopsis":"LOOP IF's body (token $D3; ROM1's command table reaches it): evaluates the condition; when\nit\nis false does nothing, when true ends the loop as LOOP does (LOOP_END_TEST with carry set).\nEntry: the BASIC pointer past LOOP IF.\nExit: to the statement loop.\nError: stops with error code 10 when no DO entry is on the BASIC stack.","comment":"The condition; returns when checking syntax"},
        "6431": {"comment":"Take it off: zero?"},
        "6434": {"comment":"False: carry on after it"},
        "6435": {"comment":"True: loop back"},
        "6438": {"synopsis":"EXIT IF's body (token $D6; ROM1's command table reaches it): when the condition is true,\ndrops\nthe DO entry and skips past the matching LOOP.\nEntry: the BASIC pointer past EXIT IF.\nExit: to the statement loop.\nError: stops with error code 10 when no DO entry is on the BASIC stack, 9 when no LOOP\nfollows.","comment":"The condition; returns when checking syntax"},
        "6441": {"comment":"Take it off: zero?"},
        "6444": {"comment":"False: carry on"},
        "6445": {"comment":"Drop the DO entry (carry clear)"},
        "6448": {"comment":"Skip past the LOOP"},
        "6450": {"synopsis":"LOOP's body (token $D5; ROM1's command table reaches it): tests a WHILE or UNTIL after it,\nthen falls into LOOP_END_TEST.\nEntry: the BASIC pointer past LOOP.\nExit: to the statement loop, or back to the DO.\nError: stops with error code 10 when no DO entry is on the BASIC stack.","comment":"Carry when the loop goes on"},
        "6453": {"synopsis":"Takes the DO entry off the BASIC stack; with carry clear returns (the loop is over), with\ncarry set jumps back to the DO's statement (BSTK_JUMP_BACK).\nEntry: carry = loop again.\nExit: returns with carry clear, or does not return.\nError: stops with error code 10 when the top entry is not a DO.","comment":"Keep the carry"},
        "6454": {"comment":"Type $80: DO"},
        "6456": {"comment":"Pop it: Z when it was there"},
        "6461": {"comment":"Stops with error code 10"},
        "6463": {"synopsis":"The entry is popped: returns when the loop is over, else goes back to the DO.\nEntry: AF' = the carry; HL = the line; A = the page; C = the statement.\nExit: returns or to BSTK_JUMP_BACK.","comment":"Carry back"},
        "6464": {"comment":"Over: carry on after LOOP"},
        "6466": {"synopsis":"Goes back to the statement a BASIC stack entry recorded: drops the caller's return address;\nwith H = 0 (an entry made by a direct command) goes on at $0D2B with C, else pages the line\nin and runs statement C of the line at HL through $0E2E. RETURN and NEXT come here too.\nEntry: HL = the line's address; A = the entry's type and page; C = the statement.\nExit: does not return.","comment":"Drop the return address"},
        "6467": {"comment":"H = 0: no line"},
        "6469": {"comment":"A direct command: to $0D2B"},
        "6472": {"comment":"The page"},
        "6474": {"synopsis":"Pages A in and runs statement C of the line at HL ($0E2E). $3329 jumps here.\nEntry: A = the page; HL = the line; C = the statement.\nExit: does not return.","comment":"B = the statement, for $0E2E"},
        "6476": {"comment":"HMPR = page A"},
        "6479": {"comment":"Run the line from that statement"},
        "6482": {"synopsis":"ON's body (token $DE; ROM1's command table reaches it): ON n GO TO / GO SUB a, b, ... or ON\nn\nwith names. Takes n (0-255), adds it to SUBPPC and skips n items with $10F9. A GO SUB or a\nname (ON_CALL_ITEM) is run as the next statement; GO TO, another keyword or ':' are handled\nat ON_KEYWORD.\nEntry: the BASIC pointer past ON.\nExit: to the statement loop.\nError: stops with error code 30 when n is not 0-255.","comment":"n; returns when checking syntax"},
        "6485": {"comment":"A = n, 0-255"},
        "6489": {"comment":"SUBPPC + n"},
        "6494": {"comment":"The character after n"},
        "6495": {"comment":"Skip n items: carry when there are fewer"},
        "6499": {"comment":"Look at the next item"},
        "6503": {"comment":"A letter: a name"},
        "6508": {"comment":"GO SUB?"},
        "6512": {"synopsis":"A GO SUB or a name: points CHAD at it, makes CLA the next line's address, keeps SUBPPC in\nONSTORE and sets SUBPPC to $FF, so the statement loop runs the item as the next statement.\nEntry: HL = the item.\nExit: returns to the statement loop.","comment":"CHAD = the item"},
        "6515": {"comment":"CLA = NXTLINE"},
        "6521": {"comment":"SUBPPC into ONSTORE"},
        "6528": {"comment":"SUBPPC = $FF"},
        "6531": {"synopsis":"Not a GO SUB: drops the return address; GO TO runs as a statement through $0D9E with that\naddress as its return; another keyword runs with $0E17 as its return; ':' jumps to the\ndropped return address.\nEntry: A = the item's first character.\nExit: does not return.\nError: stops with error code 29 when the item is not a keyword or ':' (through $0D9E).","comment":"The statement loop's return address"},
        "6532": {"comment":"GO TO?"},
        "6536": {"comment":"Else return to $0E17"},
        "6539": {"synopsis":"Runs the keyword as a statement, or with ':' jumps to DE.\nEntry: A = the character; DE = the return address.\nExit: does not return.","comment":"':'?"},
        "6541": {"comment":"No: run the keyword"},
        "6544": {"comment":"Yes: go on at DE"},
        "6546": {"synopsis":"Takes a line number off the calculator stack and makes it the next line to run: NEWPPC = it,\nNSPPC = 0. $38F9 calls it.\nEntry: the number on the calculator stack.\nExit: NEWPPC, NSPPC set; A = 0.\nError: stops with error code 30 when the number is not 0-65279.\nChanges: AF, BC, HL.","comment":"HL = the line"},
        "6550": {"comment":"$FFxx: out of range"},
        "6554": {"synopsis":"Sets NEWPPC = HL and NSPPC = 0: jump to line HL, its first statement.\nEntry: HL = the line.\nExit: A = 0.","comment":"Statement 0"},
        "6555": {"synopsis":"Sets NSPPC = A and NEWPPC = HL: the line and statement the statement loop goes to next.\nEntry: HL = the line; A = the statement.\nExit: NEWPPC, NSPPC set.","comment":"NSPPC"},
        "6558": {"comment":"NEWPPC"},
        "6562": {"synopsis":"CONTINUE's body (token $B2; ROM1's command table reaches it): jumps to the line in COPPC and\nthe statement in COSPPC.\nEntry: the BASIC pointer past CONTINUE.\nExit: NEWPPC, NSPPC set; returns at once when checking syntax.","comment":"Done when checking syntax"},
        "6565": {"synopsis":"Makes COPPC and COSPPC (where CONTINUE goes on) the next line and statement: NEWPPC, NSPPC.\n$0F3F calls it after error code 15.\nEntry: none.\nExit: HL = COPPC; A = COSPPC; NEWPPC, NSPPC set.\nChanges: A, HL.","comment":"COSPPC"},
        "6568": {"comment":"COPPC"},
        "6573": {"synopsis":"JCALLBAS's body: calls the BASIC subroutine at line HL. Sets NEWPPC to it, pushes a GO SUB\nentry with statement $FF (which RETURN treats as a return to here), sets an error return,\nruns the statement loop ($0DD4), then puts ERRSP and HMPR back.\nEntry: HL = the line number.\nExit: A = ERRNR, Z when there was no error.\nChanges: AF, BC, DE, HL.","comment":"NEWPPC = HL, statement 0"},
        "6576": {"comment":"B = 0: a GO SUB entry"},
        "6577": {"comment":"SUBPPC = $FF: the mark RETURN looks for"},
        "6581": {"comment":"Keep HMPR"},
        "6584": {"comment":"Push the GO SUB entry"},
        "6587": {"comment":"Errors come back here"},
        "6590": {"comment":"Run the line"},
        "6593": {"comment":"Put ERRSP back"},
        "6597": {"comment":"Put HMPR back"},
        "6600": {"comment":"ERRNR: zero when it ran"},
        "6605": {"synopsis":"RETURN's body (token $B6; ROM1's command table reaches it): takes the GO SUB entry (type\n$00)\noff the BASIC stack and goes back to its statement. An entry with statement $FF, pushed by\nJCALLBAS, returns from the statement loop to it instead.\nEntry: the BASIC pointer past RETURN.\nExit: does not return; returns at once when checking syntax.\nError: stops with error code 8 when the top entry is not a GO SUB.","comment":"Done when checking syntax"},
        "6608": {"comment":"Type $00: GO SUB"},
        "6610": {"comment":"Pop it"},
        "6613": {"comment":"Not there: error"},
        "6615": {"comment":"Statement $FF?"},
        "6618": {"comment":"Yes: back to CALL_BASIC_LINE"},
        "6620": {"synopsis":"No GO SUB entry on the BASIC stack: stops with error code 8.\nEntry: none.\nExit: does not return.","comment":"Stops with error code 8"},
        "6622": {"synopsis":"END PROC's body (token $CB; ROM1's command table reaches it): takes the PROC entry off the\nBASIC stack ($332C) and the procedure's locals ($370A), then returns to the caller's\nstatement as RETURN does.\nEntry: the BASIC pointer past END PROC.\nExit: does not return; returns at once when checking syntax.","comment":"Done when checking syntax"},
        "6625": {"comment":"Pop the PROC entry"},
        "6631": {"comment":"Drop the locals"},
        "6637": {"synopsis":"Goes back to a popped entry's statement; when ONERRFLG's bit 0 is set (probably while an ON\nERROR line runs) sets it to $81 first.\nEntry: A = the entry's type and page; HL = the line; C = the statement.\nExit: to BSTK_JUMP_BACK.","comment":"Keep the type and page"},
        "6638": {"comment":"ONERRFLG bit 0?"},
        "6644": {"comment":"Set: make it $81"},
        "6649": {"synopsis":"Jumps back to the entry's statement.\nEntry: B = the type and page.\nExit: to BSTK_JUMP_BACK.","comment":"The page"},
        "6653": {"synopsis":"Tests the WHILE or UNTIL after DO or LOOP. Without one returns with carry set, but only when\nrunning: when checking syntax it returns from the caller. With one, evaluates the condition\n(DO_COND_EVAL).\nEntry: A = the character after DO or LOOP.\nExit: carry set = the loop goes on (no condition, WHILE true, UNTIL false); carry clear = it\nends; returns from the caller when checking syntax.\nChanges: AF, BC, HL.","comment":"WHILE? (carry clear)"},
        "6657": {"comment":"UNTIL? (carry set)"},
        "6662": {"comment":"Neither: our return address"},
        "6663": {"comment":"Checking syntax: return from the caller"},
        "6667": {"comment":"Running: back with carry set"},
        "6668": {"synopsis":"Evaluates the condition after WHILE or UNTIL and sets the carry from it.\nEntry: carry clear for WHILE, set for UNTIL.\nExit: as DO_COND_TEST.","comment":"Keep which one"},
        "6669": {"comment":"The condition"},
        "6672": {"comment":"Checking syntax?"},
        "6677": {"comment":"Take it off: zero?"},
        "6680": {"comment":"False: carry as WHILE/UNTIL gave it"},
        "6682": {"comment":"True: the opposite carry"},
        "6685": {"synopsis":"Checking syntax: drops the flags and returns from the caller.\nEntry: the flags and the return address on the stack.\nExit: returns from the caller.","comment":"Drop the flags"},
        "6686": {"synopsis":"Returns with the flags saved on the stack (or, from DO_COND_SYNTAX, drops the return\naddress).\nEntry: a word on the stack.\nExit: returns.","comment":"Flags back (or drop the return address)"},
        "6688": {"synopsis":"Takes the top entry off the BASIC stack when its type (bits 7-5 of its first byte) is B.\nEntry: B = the type: $00 GO SUB, $40 PROC, $80 DO.\nExit: Z when popped: A = the type and page byte, HL = the line's address, C = the statement,\nDE = the new BSTKEND; NZ when the top entry is another type.\nChanges: AF, C, DE, HL.","comment":"BSTKEND: the top entry"},
        "6692": {"comment":"Its type"},
        "6695": {"comment":"Not B: NZ"},
        "6696": {"synopsis":"Takes the top entry off the BASIC stack whatever its type. ROM1's $C2F8 calls it.\nEntry: HL = BSTKEND.\nExit: A = the type and page; HL = the address; C = the statement; DE = the new BSTKEND.\nChanges: AF, C, DE, HL.","comment":"Type and page"},
        "6698": {"comment":"The address"},
        "6702": {"comment":"The statement"},
        "6704": {"comment":"The new BSTKEND"},
        "6709": {"synopsis":"Finds program line HL, searching from the current line (CLA) when it is not before PPC, and\nfrom the start of the program otherwise or when checking syntax. $0DE8 (GO TO) calls it.\nEntry: HL = the line number.\nExit: as FIND_LINE_FROM.\nChanges: AF, BC, DE, HL.","comment":"BC = the line wanted"},
        "6711": {"comment":"Checking syntax: from the start"},
        "6716": {"comment":"PPC - 1 below it?"},
        "6723": {"comment":"No: from the start"},
        "6725": {"comment":"Yes: from the current line"},
        "6733": {"synopsis":"Finds program line HL, searching from the start of the program (PROG).\nEntry: HL = the line number.\nExit: as FIND_LINE_FROM.\nChanges: AF, BC, DE, HL.","comment":"BC = the line wanted"},
        "6735": {"synopsis":"Finds program line BC from PROG. ROM1's $C67A calls it.\nEntry: BC = the line number.\nExit: as FIND_LINE_FROM.","comment":"PROG's address and page"},
        "6741": {"synopsis":"Steps through the program from the line at A:HL to the first line whose number is BC or more\n(numbers are stored high byte first; the $FF after the last line ends it), moving on a page\nwhen a line starts at $C000 or above.\nEntry: A = the page; HL = the first line; BC = the line number.\nExit: HL = that line, paged in; DE = the line before it (TEMPW1); Z when its number is BC,\nNZ when it is higher.\nChanges: AF, DE, HL.","comment":"HMPR = the page"},
        "6744": {"comment":"TEMPW1 = the line"},
        "6749": {"synopsis":"Moves HL to the next line: past the number and the length word plus the length.\nEntry: HL = a line.\nExit: HL = the next line; TEMPW1 = this one.","comment":"At $C000 or above: next page"},
        "6754": {"comment":"TEMPW1 = this line"},
        "6757": {"comment":"Past the number"},
        "6759": {"comment":"The length"},
        "6763": {"comment":"The next line"},
        "6764": {"synopsis":"Compares this line's number with BC: lower moves on.\nEntry: HL = the line; BC = the number.\nExit: to FIND_LINE_NEXT or FIND_LINE_DONE.","comment":"High byte lower?"},
        "6769": {"comment":"Higher: found the next line"},
        "6771": {"comment":"Low byte lower?"},
        "6778": {"synopsis":"Returns the line before in DE.\nEntry: TEMPW1 = the line before.\nExit: DE = it.","comment":"DE = the line before"},
        "6783": {"synopsis":"IF's body (tokens $D7 and $D8; ROM1's command table reaches it). Evaluates the condition and\nkeeps the character after it in IFTYPE; when that is THEN, changes the IF token in the line\nto $D8 (the one-line IF). When running and the condition is false: a one-line IF skips to an\nELSE ($DA) in its line or to the next line (IF_SKIP_LINE); an IF without THEN looks through\nthe program for its ELSE ($D9) or END IF ($DB) (IF_SKIP_BLOCK).\nEntry: the BASIC pointer past IF.\nExit: returns to run what follows when the condition is true; else goes on at the statement\nfound.\nError: stops with error code 39 when an IF block has no END IF.","comment":"Back from CHAD to the IF token"},
        "6786": {"synopsis":"Steps back over spaces and control codes.\nEntry: HL = the pointer.\nExit: HL = the IF token.","comment":"Skip back below '!'"},
        "6792": {"comment":"Keep the IF token's address"},
        "6793": {"comment":"The condition"},
        "6797": {"comment":"IFTYPE = the character after it"},
        "6800": {"comment":"THEN?"},
        "6805": {"comment":"Yes: the token becomes $D8"},
        "6807": {"synopsis":"Tests the condition when running.\nEntry: D = the character after the condition.\nExit: returns when true; to IF_SKIP_BLOCK or IF_SKIP_LINE when false.","comment":"Checking syntax: done"},
        "6810": {"comment":"Take it off: zero?"},
        "6813": {"comment":"True: run what follows"},
        "6814": {"comment":"Drop the return address"},
        "6816": {"comment":"With THEN?"},
        "6820": {"synopsis":"A false IF without THEN: looks through the program for the ELSE ($D9) or END IF ($DB) at\nthis\nlevel (IFs $D7 nest). At END IF goes on after it; at ELSE IF evaluates the next condition\nand\ngoes on after it when true, searches again when false; at a plain ELSE goes on after it.\nEntry: the BASIC pointer past the condition.\nExit: to $0D51.\nError: stops with error code 39 when there is none.","comment":"B' = $FF: the whole program; C' = ELSE"},
        "6825": {"comment":"Depth 1, ELSE matches"},
        "6828": {"comment":"IF opens, END IF closes"},
        "6831": {"comment":"Find one: carry when found"},
        "6836": {"comment":"SUBPPC = its statement"},
        "6839": {"comment":"The token found"},
        "6840": {"comment":"END IF: go on after it"},
        "6844": {"comment":"ELSE: the character after it"},
        "6845": {"comment":"ELSE IF?"},
        "6850": {"comment":"Its condition"},
        "6853": {"comment":"False: look again"},
        "6858": {"synopsis":"Goes on at the statement found ($0D51).\nEntry: CHAD past the token.\nExit: does not return.","comment":"Run from there"},
        "6861": {"synopsis":"No ELSE or END IF found: stops with error code 39.\nEntry: none.\nExit: does not return.","comment":"Stops with error code 39"},
        "6863": {"synopsis":"A false one-line IF: looks for its ELSE ($DA) in the rest of the line, one-line IFs ($D8)\nnesting. Found: goes on after it; not found: goes on at the next line ($0E12).\nEntry: the BASIC pointer past the condition.\nExit: does not return.","comment":"B' = 0: this line only"},
        "6868": {"comment":"IF $D8 opens, ELSE $DA closes"},
        "6871": {"comment":"Find it"},
        "6874": {"comment":"None: the next line"},
        "6877": {"comment":"SUBPPC = its statement"},
        "6880": {"comment":"Go on after it"},
        "6883": {"synopsis":"ELSE's body (token $D9; ROM1's command table reaches it). Running: the IF's true part is\ndone,\nso skips to the matching END IF (ELSE_SKIP_BLOCK). Checking syntax: when the last IF had\nTHEN (IFTYPE), changes the token to the one-line ELSE $DA; an ELSE IF gets its IF made $D8\nand\nits condition checked.\nEntry: A = the character after ELSE; the BASIC pointer at it.\nExit: to the statement loop.\nError: stops with error code 29 for ELSE IF ... THEN; 0 when no END IF follows (probably\nending the program).","comment":"Keep the character after ELSE"},
        "6884": {"comment":"Running: skip to END IF"},
        "6889": {"comment":"Back from CHAD to the ELSE token"},
        "6892": {"synopsis":"Steps back over spaces and control codes.\nEntry: HL = the pointer.\nExit: HL = the ELSE token.","comment":"Skip back below '!'"},
        "6898": {"comment":"IFTYPE: THEN?"},
        "6905": {"comment":"Followed by IF ($D7 or $D8)?"},
        "6910": {"comment":"No: a plain ELSE"},
        "6912": {"comment":"ELSE IF: its IF becomes $D8"},
        "6917": {"comment":"Its condition"},
        "6920": {"comment":"No THEN: fine"},
        "6923": {"synopsis":"Stops with error code 29. FOR comes here when '=' or TO is missing.\nEntry: none.\nExit: does not return.","comment":"Stops with error code 29"},
        "6925": {"synopsis":"After IF ... THEN: the ELSE token becomes $DA.\nEntry: HL = the ELSE token.\nExit: to IF_NEXT_STMT.","comment":"The one-line ELSE"},
        "6929": {"synopsis":"Running into ELSE: skips past the END IF ($DB) of this IF block ($D7 nests) through $0D47.\nThe byte after the CALL is the error code $0D47 stops with when there is none.\nEntry: the statement's return address on the stack.\nExit: does not return.","comment":"Drop the return address"},
        "6930": {"comment":"IF opens, END IF closes"},
        "6933": {"comment":"Find it and go on after it"},
        "6936": {"synopsis":"The error code $0D47 stops with (through RST $08's body, as the return address points here)\nwhen ELSE_SKIP_BLOCK finds no END IF: 0."},
        "6937": {"synopsis":"The one-line ELSE's body (token $DA; ROM1's command table reaches it): running, the IF's\nTHEN\npart is done, so goes on at the next line ($0E11); checking syntax, goes on with the next\nstatement.\nEntry: the BASIC pointer past ELSE.\nExit: does not return.","comment":"Running: the next line"},
        "6943": {"synopsis":"Drops the return address and goes on with the next statement ($0D84).\nEntry: the return address on the stack.\nExit: does not return.","comment":"Drop the return address"},
        "6947": {"synopsis":"Takes the top value off the calculator stack and tests it for zero by ORing its last four\nbytes (a condition's result).\nEntry: a number on the calculator stack.\nExit: Z when it is zero; STKEND = HL = the value taken off.\nChanges: AF, HL.","comment":"STKEND"},
        "6952": {"comment":"OR the last four bytes"},
        "6959": {"comment":"STKEND = the value: dropped"},
        "6962": {"synopsis":"END IF's body (token $DB; ROM1's command table reaches it): does nothing. Also the tail of\nCALC_POP_ZERO.\nEntry: none.\nExit: returns."},
        "6963": {"synopsis":"FOR's body (token $C0; ROM1's command table reaches it): FOR v = a TO b [STEP c].\n1. Finds the variable ($2CD3), evaluates a, TO, b and STEP c (1 without STEP).\n2. Marks the name at $5160 as a FOR-NEXT variable (bit 6) and assigns a ($2B37).\n3. Stores the limit and the step after the value, and copies the value, limit and step to\n$5121-$512F (probably the calculator memories MEM points to).\n4. Stores the loop address: the page, the line (or the next line when FOR ends the line,\nstatement 1) and the statement after FOR.\n5. When the loop is already over (FOR_LOOP_OVER) skips to the NEXT with this variable's\n   name.\nEntry: the BASIC pointer past FOR.\nExit: to the statement loop.\nError: stops with error code 29 when '=' or TO is missing, 6 when no NEXT follows.","comment":"Find the variable"},
        "6966": {"comment":"'='?"},
        "6971": {"comment":"The start value"},
        "6974": {"comment":"TO?"},
        "6979": {"comment":"The limit"},
        "6982": {"comment":"STEP?"},
        "6986": {"comment":"No STEP: done when checking syntax"},
        "6989": {"comment":"Stack constant 9 (the step)"},
        "6992": {"comment":"NZ: no STEP to read"},
        "6993": {"synopsis":"Reads the STEP value when there is one, then builds the loop.\nEntry: Z = STEP present.\nExit: as CMD_FOR.","comment":"The step; returns when checking syntax"},
        "6996": {"comment":"The character after the statement"},
        "6998": {"comment":"Start, limit, step: swap the top two"},
        "7001": {"comment":"Then the top and the third: limit, step, start"},
        "7004": {"comment":"The name: a FOR-NEXT variable"},
        "7009": {"comment":"Assign the start value"},
        "7012": {"comment":"Take the limit and step off"},
        "7024": {"comment":"Store them after the value"},
        "7026": {"comment":"Where the loop address goes"},
        "7028": {"comment":"The step's last byte"},
        "7030": {"comment":"Value, limit, step to $5121-$512F"},
        "7037": {"comment":"FOR ends the line?"},
        "7041": {"comment":"The statement after FOR"},
        "7046": {"comment":"PPC's high byte: $FF in a direct command"},
        "7051": {"comment":"Direct: H = 0, no line"},
        "7053": {"comment":"CLA: this line"},
        "7058": {"synopsis":"FOR ends its line: the loop starts at the next line, statement 1.\nEntry: none.\nExit: HL = NXTLINE; C = 1.","comment":"NXTLINE"},
        "7061": {"comment":"Statement 1"},
        "7063": {"synopsis":"Stores the loop address after the step: page, line, statement.\nEntry: HL = the line; C = the statement; the place on the stack.\nExit: then tests the loop."},
        "7064": {"comment":"Where it goes"},
        "7065": {"comment":"NXTLINEP: the line's page"},
        "7070": {"comment":"The line"},
        "7074": {"comment":"The statement"},
        "7076": {"comment":"FLAGE bit 0: a new variable?"},
        "7081": {"comment":"Yes: $2BBB records it"},
        "7084": {"comment":"Loop over already?"},
        "7087": {"comment":"No: run the body"},
        "7088": {"comment":"CHAD's page in"},
        "7091": {"synopsis":"Finds the next NEXT ($C1) in the program.\nEntry: CHAD = where to look from.\nExit: to FOR_NEXT_FOUND.\nError: stops with error code 6 when there is none.","comment":"Look for NEXT"},
        "7098": {"comment":"Stops with error code 6"},
        "7100": {"synopsis":"A NEXT: when the name after it is the FOR's ($5160), goes on after it; else looks again.\nEntry: A = its statement; DE past it.\nExit: to $0D51.","comment":"SUBPPC = its statement"},
        "7103": {"comment":"Same name as the FOR's?"},
        "7109": {"comment":"No: the next NEXT"},
        "7111": {"comment":"CHAD past it"},
        "7115": {"comment":"Drop the return address"},
        "7119": {"synopsis":"The variable is not a FOR-NEXT variable: stops with error code 5.\nEntry: none.\nExit: does not return.","comment":"Stops with error code 5"},
        "7121": {"synopsis":"NEXT's body (token $C1; ROM1's command table reaches it). Checks BREAK, then adds the step\nto\nthe value: for small integers fast (NEXT_INT_STEP), else through the calculator memories.\nWhen the loop is over returns; else jumps back to the loop address stored after the step\n(NEXT_JUMP_BACK).\nEntry: the BASIC pointer past NEXT.\nExit: to the statement loop.\nError: stops with error code 5 when the variable is not a FOR-NEXT one.","comment":"Find the variable"},
        "7124": {"comment":"Done when checking syntax"},
        "7127": {"comment":"BREAK?"},
        "7130": {"comment":"STRIL bit 6: a FOR-NEXT variable?"},
        "7137": {"comment":"DEST: the value, paged in"},
        "7140": {"comment":"Small integers: added already"},
        "7143": {"comment":"Then Z; A = 0 when over ($1C08)"},
        "7145": {"comment":"Value, limit, step to memories 0-2"},
        "7158": {"comment":"Memory 0 = value + step"},
        "7164": {"comment":"Copy it back to the variable"},
        "7171": {"comment":"Over?"},
        "7174": {"comment":"Yes: carry on after NEXT"},
        "7175": {"comment":"Skipped: $1C08 is AND A / RET Z"},
        "7178": {"synopsis":"Jumps back to the loop address stored 15 bytes after the value: page, line, statement.\nEntry: DEST = the variable's value.\nExit: to BSTK_JUMP_BACK.","comment":"Past value, limit and step"},
        "7185": {"comment":"The page"},
        "7187": {"comment":"The line"},
        "7191": {"comment":"The statement"},
        "7196": {"synopsis":"Asks the calculator whether a loop is over from memories 0-2 (value, limit, step), comparing\nthe value and the limit the other way round for a negative step.\nEntry: the memories set.\nExit: Z when the loop is over.\nChanges: AF, DE, HL.","comment":"Value, limit, step: compare in the step's direction"},
        "7208": {"comment":"The result's third byte"},
        "7211": {"comment":"Z when it is 1"},
        "7213": {"synopsis":"NEXT for small integers: when the value, limit and step are all small integers (exponent 0)\nand the sum does not overflow, stores value + step and compares it with the limit.\nEntry: HL = the value, followed by the limit and the step.\nExit: NZ when it cannot (the calculator must do it); Z with A = 0 when the loop is over, Z\nwith A nonzero when it goes on.\nChanges: AF, BC, DE, HL, AF'.","comment":"The value small?"},
        "7216": {"comment":"B = its sign, DE = it"},
        "7224": {"comment":"The limit small?"},
        "7231": {"comment":"The step small?"},
        "7234": {"comment":"Its sign, also in A'"},
        "7238": {"comment":"HL = the step"},
        "7242": {"comment":"Value + step"},
        "7243": {"comment":"Signs and carry: overflow?"},
        "7247": {"comment":"Yes: let the calculator do it"},
        "7248": {"comment":"The new sign"},
        "7250": {"comment":"Store the new value"},
        "7263": {"comment":"The limit's sign"},
        "7265": {"comment":"HL = the limit"},
        "7269": {"comment":"Same sign as the value?"},
        "7272": {"comment":"A = $FF: equal goes on"},
        "7273": {"comment":"Limit - value: equal?"},
        "7276": {"comment":"B = $FF when the limit is above"},
        "7279": {"synopsis":"Gives A = the step's sign XOR B, with Z: 0 means the loop is over.\nEntry: B = $FF when the limit is above the value, else 0; A' = the step's sign.\nExit: Z; A = 0 when over.","comment":"The step's sign"},
        "7280": {"comment":"Matches the direction?"},
        "7283": {"synopsis":"ON ERROR's body (token $DD; ROM1's command table reaches it). ON ERROR STOP sets ONERRFLG to\n0. Otherwise records PPC in ERRLN and SUBPPC in ERRSTAT, skips the rest of the statement\n($10F2) and sets ONERRFLG to $81, or to 0 in a direct command.\nEntry: the BASIC pointer past ON ERROR.\nExit: returns; checking syntax goes on at $0D7D.","comment":"Our return address"},
        "7284": {"comment":"Checking syntax: to $0D7D"},
        "7291": {"comment":"STOP?"},
        "7296": {"comment":"Past it: off"},
        "7300": {"synopsis":"Records where the ON ERROR statement is and turns it on.\nEntry: none.\nExit: to ON_ERROR_FLAG.","comment":"ERRLN = PPC"},
        "7306": {"comment":"ERRSTAT = SUBPPC"},
        "7313": {"comment":"Skip the statement"},
        "7316": {"comment":"PPC's high byte: $FF in a direct command?"},
        "7320": {"comment":"On"},
        "7322": {"synopsis":"Stores A in ONERRFLG.\nEntry: A = 0 (off) or $81 (on).\nExit: returns.","comment":"ONERRFLG"},
        "7326": {"synopsis":"The default NMI routine: ROM1's $EC6E sets NMIV to it, so the BREAK button lands here. Moves\nthe stack to $4F00 with $0EED as the error return, and stops with error code 15.\nEntry: from NMI_ENTRY.\nExit: does not return.","comment":"A fresh stack"},
        "7329": {"comment":"$0EED is where the error returns"},
        "7333": {"comment":"ERRSP"},
        "7337": {"comment":"Stops with error code 15"},
        "7339": {"comment":"Not reached by any jump: a key read"},
        "7345": {"synopsis":"JREADREY's body: reads the keyboard through ROM1's $D5B8 and $D59A, then empties the\nkeyboard\nqueue (KEY_BUF_FLUSH).\nEntry: none.\nExit: carry set with A = the key; carry clear with A = 0 when there is none.","comment":"A key waiting? Z when there is"},
        "7350": {"comment":"None: A = 0, carry clear"},
        "7352": {"synopsis":"A key: gets it and empties the queue.\nEntry: none.\nExit: A = the key; carry set.","comment":"Get the key"},
        "7355": {"comment":"Carry set: a key"},
        "7357": {"synopsis":"JRBFLUSH's body: empties the keyboard queue (KBQP = 0) and clears FLAGS bit 5 (a new key).\nEntry: none.\nExit: KBQP = 0.\nChanges: HL.","comment":"KBQP = 0: empty"},
        "7363": {"synopsis":"Clears FLAGS bit 5 (a new key).\nEntry: none.\nExit: FLAGS bit 5 clear.\nChanges: HL.","comment":"FLAGS bit 5 off"},
        "7369": {"synopsis":"Scans the keyboard (ROM1's $D510) and reads RBHEAD, clearing FLAGS bit 5.\nEntry: none.\nExit: Z when there was no new key; A = RBHEAD.","comment":"Scan the keyboard"},
        "7372": {"comment":"FLAGS bit 5: a new key?"},
        "7377": {"comment":"RBHEAD"},
        "7382": {"synopsis":"Stacks HL as a small integer on the calculator stack.\nEntry: HL = the number.\nExit: DE = the new STKEND (STK_STORE leaves it in HL, and EX DE,HL at $1CE5 swaps it).\nChanges: AF, BC, DE, HL.","comment":"D, C = HL's low, high"},
        "7386": {"synopsis":"Stacks A as a small integer on the calculator stack.\nEntry: A = the number.\nExit: as STK_HL.\nChanges: AF, BC, DE, HL.","comment":"BC = A"},
        "7389": {"synopsis":"Stacks BC as a small integer on the calculator stack.\nEntry: BC = the number.\nExit: as STK_HL.\nChanges: AF, BC, DE, HL.","comment":"D, C = BC's low, high"},
        "7391": {"synopsis":"Stacks 0, 0, D, C, 0: a positive small integer with low byte D and high byte C.\nEntry: D, C = the number's bytes.\nExit: as STK_HL.","comment":"Exponent 0, sign 0, last byte 0"},
        "7397": {"comment":"HL = STKEND, DE as it was"},
        "7399": {"synopsis":"Stacks a string in the page HMPR shows: DE = its start, BC = its length.\nEntry: DE, BC.\nExit: as JSTKSTORE; FLAGS: a string result.","comment":"The page"},
        "7401": {"synopsis":"Stacks a string in page A (bit 7 dropped).\nEntry: A = the page; DE = the start; BC = the length.\nExit: as STK_STR.","comment":"Without bit 7"},
        "7403": {"synopsis":"Marks the result as a string (FLAGS bit 6 off) and stacks A, E, D, C, B.\nEntry: A, E, D, C, B.\nExit: as STK_STORE.","comment":"FLAGS bit 6 off: a string"},
        "7408": {"synopsis":"JSTKSTORE's body: puts the 5 bytes A, E, D, C, B on the calculator stack at STKEND.\nEntry: A, E, D, C, B = the value.\nExit: STKEND and HL past it.\nChanges: HL.","comment":"STKEND"},
        "7421": {"comment":"The new STKEND"},
        "7425": {"synopsis":"JSTRFETCH's body: takes the top 5 bytes off the calculator stack into A, E, D, C, B.\nEntry: a value on the calculator stack.\nExit: A, E, D, C, B = it (a string: A the page, DE the start, BC the length); HL = STKEND.\nChanges: AF, BC, DE, HL.","comment":"STKEND"},
        "7438": {"synopsis":"Stores the new STKEND.\nEntry: HL = it.\nExit: returns.","comment":"The new STKEND"},
        "7442": {"synopsis":"Drops the top value of the calculator stack.\nEntry: a value on the calculator stack.\nExit: HL = STKEND = the value dropped; A = L.\nChanges: AF, HL.","comment":"STKEND - 5, low byte first"},
        "7452": {"comment":"No borrow: done"},
        "7453": {"comment":"Borrow from the high byte"},
        "7456": {"synopsis":"Copies the 5 bytes at HL onto the calculator stack.\nEntry: HL = the value.\nExit: STKEND = DE past it; HL past the source; BC = 0.\nChanges: BC, DE, HL.","comment":"Five bytes to STKEND"},
        "7470": {"synopsis":"JGETINT's body: takes a number off the calculator stack as an integer 0-65535.\nEntry: a number on the calculator stack.\nExit: HL = BC = the number; A = its low byte.\nError: stops with error code 30 when it is negative or too big.\nChanges: AF, BC, HL.","comment":"Carry: too big"},
        "7475": {"synopsis":"Takes a number off the calculator stack as a byte 0-255.\nEntry: a number on the calculator stack.\nExit: A = C = the number; HL = BC.\nError: stops with error code 30 when it is negative or over 255.\nChanges: AF, BC, HL.","comment":"Carry: over 255"},
        "7478": {"synopsis":"Too big, or negative: an error; positive returns.\nEntry: carry = too big; Z = positive.\nExit: returns or does not.","comment":"Too big"},
        "7480": {"comment":"Positive: fine"},
        "7481": {"synopsis":"Stops with error code 30, used for a number out of range by many callers.\nEntry: none.\nExit: does not return.","comment":"Stops with error code 30"},
        "7483": {"synopsis":"Takes the top number off the calculator stack as a 16-bit integer. A number that is not a\nsmall integer (exponent not 0) goes through the calculator first ($E0, $01, $44).\nEntry: a number on the calculator stack.\nExit: carry set when it does not fit 16 bits; Z when positive, with BC = HL = the number;\nNZ when negative, with BC = HL = its negation; A = C.\nChanges: AF, BC, HL.","comment":"The top value"},
        "7490": {"comment":"A small integer?"},
        "7494": {"comment":"No: make it one if it can"},
        "7499": {"synopsis":"Drops the value and reads its integer.\nEntry: HL = the value.\nExit: as CALC_POP_INT.","comment":"Dropped"},
        "7502": {"comment":"Carry when the exponent is not 0"},
        "7505": {"comment":"Sign: Z when positive"},
        "7508": {"comment":"BC = the integer"},
        "7514": {"comment":"Positive: done"},
        "7515": {"comment":"Too big: done"},
        "7516": {"comment":"Negative: HL = -BC"},
        "7525": {"synopsis":"Takes the top number off the calculator stack as a byte.\nEntry: a number on the calculator stack.\nExit: A = C = its low byte; carry set when its size is over 255; Z when positive.\nChanges: AF, BC, HL.","comment":"As a 16-bit integer"},
        "7529": {"comment":"High byte 0? (flags kept)"},
        "7535": {"synopsis":"The high byte is not 0: sets carry.\nEntry: none.\nExit: carry set."},
        "7537": {"synopsis":"Empties the edit line: writes ENTER and $FF at ELINE, puts KCUR (the cursor) there, then\nempties the workspace and the calculator stack (CLEAR_WORKSP).\nEntry: none.\nExit: WORKSP just past the $FF; HMPR as on entry.\nChanges: AF, HL.","comment":"Keep HMPR"},
        "7540": {"comment":"ELINE paged in"},
        "7543": {"comment":"KCUR = ELINE"},
        "7546": {"comment":"ENTER and $FF"},
        "7552": {"comment":"WORKSP after them"},
        "7558": {"comment":"Put HMPR back"},
        "7561": {"synopsis":"Empties the workspace (WKEND = WORKSP) and the calculator stack (CLEAR_CALC_STK).\nEntry: none.\nExit: WKEND = WORKSP; STKEND = FPSBOT.\nChanges: AF, HL.","comment":"WORKSP"},
        "7567": {"comment":"WKEND = it"},
        "7573": {"synopsis":"Empties the calculator stack: STKEND = FPSBOT. $3808 calls it.\nEntry: none.\nExit: STKEND = FPSBOT.\nChanges: HL.","comment":"FPSBOT"},
        "7580": {"synopsis":"Finds the next statement starting with token E in the program, without nesting (D and C are\n$8D, which the search handles before it compares them).\nEntry: E = the token; CHAD = where to start; SUBPPC = its statement.\nExit: as FIND_TOKENS.\nChanges: AF, BC, DE, HL, AF', BC'.","comment":"No opener"},
        "7582": {"synopsis":"Finds the token E that closes the opener D, nested ones counted, anywhere in the rest of the\nprogram.\nEntry: D = the opener; E = the closer; CHAD = where to start.\nExit: as FIND_TOKENS.\nChanges: AF, BC, DE, HL, AF', BC'.","comment":"B' = $FF: up to the end; C' = no middle token"},
        "7587": {"synopsis":"FIND_NESTED with the caller's BC': B' = the line limit, C' = the middle token at depth 1.\nEntry: D, E, BC'.\nExit: as FIND_TOKENS.","comment":"Depth 1; no middle token"},
        "7590": {"synopsis":"Looks through the program from CHAD for a statement token, counting statements:\n1. Skips numbers ($0E and 5 bytes), strings and REM's lines.\n2. ':' and THEN start a new statement; ENTER a new line (its address to CLA, statement 1),\nstopping when the next line's number's high byte is B' or more ($FF ends the program, 0\nstops at this line's end).\n3. D opens a level (and C becomes $8D, matching nothing, until it closes); E closes one; C\nmatches only at depth 1 (C' is put back into C when the depth returns to 1).\nEntry: D = the opener; E = the closer; C = the middle token; B = the depth (1); B' = the\nline limit; C' = the middle token; CHAD = where to start; SUBPPC = its statement.\nExit: carry set when found: A = the statement number, A' = the token, CHAD past it; carry\nclear when not.\nChanges: AF, BC, HL, AF'.","comment":"HL = CHAD"},
        "7591": {"comment":"The statement count starts at SUBPPC"},
        "7596": {"synopsis":"':' or THEN: counts a statement.\nEntry: A' = the count.\nExit: to FIND_TOKEN_LP.","comment":"One more statement"},
        "7598": {"synopsis":"Keeps the statement count in A' and goes on.\nEntry: A = the count.\nExit: to FIND_TOKEN_LP.","comment":"Count to A'"},
        "7601": {"synopsis":"Skips the 5 bytes of a number (or, from FIND_SKIP4, the 4 of a line's number and length).\nEntry: HL past the $0E.\nExit: to FIND_TOKEN_LP.","comment":"Past a number's five bytes"},
        "7602": {"synopsis":"Skips a line's number and length.\nEntry: HL = the line.\nExit: to FIND_TOKEN_LP."},
        "7606": {"synopsis":"Reads the next byte and decides what it is.\nEntry: HL = the byte.\nExit: loops, or returns.","comment":"Next byte"},
        "7608": {"comment":"A number?"},
        "7612": {"comment":"ENTER?"},
        "7616": {"comment":"REM?"},
        "7620": {"comment":"A quote?"},
        "7624": {"comment":"':'?"},
        "7628": {"comment":"THEN?"},
        "7632": {"comment":"The opener?"},
        "7635": {"comment":"The middle token?"},
        "7638": {"synopsis":"Is it the closer? At depth 1 it is the one wanted.\nEntry: A = the byte; B = the depth.\nExit: to FIND_FOUND or on.","comment":"The closer?"},
        "7642": {"comment":"Depth 1 reached: found"},
        "7644": {"synopsis":"Found: CHAD past the token; A = the statement number.\nEntry: HL past the token.\nExit: carry set.","comment":"CHAD past it"},
        "7647": {"comment":"A = the statement; A' = the token"},
        "7650": {"synopsis":"A closer inside: one level less; back at depth 1 the middle token comes back from C'.\nEntry: B = the depth - 1.\nExit: to FIND_TOKEN_LP.","comment":"Back to depth 1?"},
        "7652": {"comment":"Yes: the middle token from C'"},
        "7656": {"synopsis":"Puts the depth right and goes on.\nEntry: B.\nExit: to FIND_TOKEN_LP.","comment":"Undo one decrement"},
        "7659": {"synopsis":"REM: skips to the end of the line.\nEntry: HL past REM.\nExit: to FIND_LINE_END.","comment":"Look for ENTER"},
        "7661": {"synopsis":"Skips one byte of the REM.\nEntry: HL.\nExit: loops until past ENTER."},
        "7666": {"synopsis":"A line ended: stops at the line limit, else starts the next line at statement 1.\nEntry: HL = the next line.\nExit: returns with carry clear, or loops.","comment":"Next line number's high byte"},
        "7668": {"comment":"B' or more: stop, not found"},
        "7671": {"comment":"At $C000 or above: next page"},
        "7676": {"comment":"CLA = the line"},
        "7679": {"comment":"Statement 1"},
        "7685": {"synopsis":"Skips a string to its closing quote.\nEntry: A = '\"'; HL past the opening one.\nExit: to FIND_TOKEN_LP.","comment":"The closing quote?"},
        "7692": {"synopsis":"The opener: one level deeper, and the middle token switched off ($8D).\nEntry: B = the depth.\nExit: to FIND_CMP_CLOSE.","comment":"Deeper"},
        "7693": {"comment":"No middle token inside"},
        "7697": {"synopsis":"Opens BC bytes at HL like MAKE_ROOM but without its 150-byte check. $0325 calls it.\nEntry: HL = where; BC = the bytes.\nExit: as MAKE_ROOM_DO.\nError: stops with error code 1 when they do not fit below RAMTOP.","comment":"No whole pages"},
        "7699": {"comment":"Fits below RAMTOP?"},
        "7704": {"synopsis":"Opens one byte at HL (MAKE_ROOM).\nEntry: HL = where.\nExit: as MAKE_ROOM_DO.","comment":"One byte"},
        "7707": {"synopsis":"Opens BC bytes at HL (MAKE_ROOM_PAGES with no whole pages).\nEntry: HL = where; BC = the bytes.\nExit: as MAKE_ROOM_DO.","comment":"No whole pages"},
        "7708": {"synopsis":"JMKRBIG's body: opens A 16K pages and BC bytes at HL, moving everything above up to WKEND.\nError 1 unless more than 150 bytes stay free below RAMTOP.\nEntry: A = the pages; BC = the bytes; HL = where.\nExit: as MAKE_ROOM_DO.\nError: stops with error code 1 when there is no room.","comment":"Fits below RAMTOP? DE = what is left"},
        "7712": {"comment":"150 bytes or less left: error 1"},
        "7720": {"synopsis":"Opens the room: moves the system's pointers past HL up by the length (ROM1's $E792, carry\nclear), then the memory from HL to WKEND ($2A4E).\nEntry: A = the pages; BC = the bytes (bits 13-0); HL = where.\nExit: HL = the room's first byte; DE = its last.\nChanges: AF, BC, DE, HL.","comment":"C:DE = the length; AND clears carry"},
        "7730": {"comment":"Move the pointers up"},
        "7733": {"comment":"WKEND"},
        "7741": {"comment":"Move the memory up"},
        "7746": {"comment":"DE = the room's last byte"},
        "7750": {"synopsis":"Deletes program line HL if there is one ($10C8 calls it when a line is entered).\nEntry: HL = the line number.\nExit: NZ when there was no such line.\nChanges: AF, BC, DE, HL.","comment":"Find it: Z when it is there"},
        "7754": {"synopsis":"Reclaims the program line at HL. ROM1's $C681 and $C6AB call it.\nEntry: HL = the line.\nExit: as RECLAIM_BC.","comment":"BC = its length"},
        "7759": {"synopsis":"Reclaims the bytes from DE up to HL.\nEntry: DE = the first; HL = past the last.\nExit: as RECLAIM_BC.","comment":"BC = HL - DE; HL = DE"},
        "7762": {"synopsis":"JRECLAIM's body: reclaims BC bytes at HL (bits 13-0 of BC), moving the pointers past them\ndown\n(ROM1's $E792, carry set) and the memory above them down over them ($2A5E).\nEntry: HL = the bytes; BC = how many.\nExit: HL = where they were; HMPR as on entry.\nChanges: AF, BC, DE, HL.","comment":"No high part"},
        "7763": {"synopsis":"Reclaims A:BC bytes at HL: A gives bits 18-16, BC bits 13-0.\nEntry: A; BC; HL = the bytes.\nExit: as RECLAIM_BC; returns at once when the length is 0.","comment":"BC to 14 bits"},
        "7768": {"comment":"Nothing to do?"},
        "7771": {"comment":"C:DE = the length"},
        "7778": {"comment":"Move the pointers down"},
        "7785": {"comment":"Keep HMPR"},
        "7789": {"comment":"At $C000 or above: next page"},
        "7796": {"synopsis":"Moves the memory above the block down over it.\nEntry: A:HL = the block; C:DE = the length.\nExit: HL = the block.","comment":"A:HL = the block's end"},
        "7801": {"comment":"C = HMPR: the block's page"},
        "7803": {"comment":"Move down"},
        "7808": {"synopsis":"JWKROOM's body: opens BC bytes at the end of the workspace ($3F24 checks they fit) and moves\nWKEND past them.\nEntry: BC = the bytes.\nExit: DE = the first byte of the space, paged in; HL = its last.\nError: stops with error code 1 when there is no room.\nChanges: BC, DE, HL.","comment":"Keep AF"},
        "7809": {"comment":"A:HL = WKEND + BC"},
        "7813": {"comment":"WKEND's page in"},
        "7819": {"comment":"WKENDP = the new page"},
        "7823": {"comment":"DE = the old WKEND"},
        "7827": {"comment":"WKEND = the new end"},
        "7830": {"comment":"HL = the space's last byte"},
        "7836": {"synopsis":"Adjusts the one pointer (page byte, address word) at HL as ADJUST_PTRS does.\nEntry: HL = the pointer; C:DE = the place; AF' carry and TEMPW4/TEMPW5 as ADJUST_PTRS.\nExit: as ADJUST_PTRS.","comment":"IY = the pointer"},
        "7839": {"comment":"Just one"},
        "7841": {"synopsis":"Moves the pointers that point past a place by the length of a block opened or reclaimed\nthere. Each is a page byte and an address word at IY; an address of 0-$00FF (H = 0) is left\nalone; one at $C000 or above is counted as the next page. A pointer past page C, offset DE\ngets the length in TEMPW4 (bits 18-16) and TEMPW5 (bits 15-0) subtracted when AF''s carry is\nset, added when it is clear. ROM1's $E792 calls it for the system's pointers.\nEntry: IY = the first pointer; B = how many; C = the page; DE = the offset; AF' = the\ndirection.\nExit: IY past the last pointer.\nChanges: AF, B, HL, IY.","comment":"The pointer's page"},
        "7844": {"comment":"And address"},
        "7850": {"comment":"H = 0: not in use"},
        "7854": {"comment":"At $C000 or above?"},
        "7858": {"comment":"The next page, at $8000"},
        "7861": {"synopsis":"Compares the pointer with the place.\nEntry: A = the page; HL = the address.\nExit: to ADJ_PTR_MOVE or ADJ_PTR_NEXT.","comment":"Page below C: leave it"},
        "7866": {"comment":"Page above: move it"},
        "7868": {"comment":"Same page: past DE?"},
        "7875": {"synopsis":"Adds or subtracts the length.\nEntry: A:HL = the pointer.\nExit: to ADJ_PTR_STORE."},
        "7877": {"comment":"The length: TEMPW4, TEMPW5"},
        "7885": {"comment":"Down?"},
        "7889": {"comment":"Up: add"},
        "7894": {"synopsis":"Subtracts the length.\nEntry: A:HL, C:DE.\nExit: to ADJ_PTR_STORE."},
        "7895": {"comment":"Down: subtract"},
        "7898": {"synopsis":"Writes the moved pointer back.\nEntry: A:HL = it.\nExit: to ADJ_PTR_NEXT."},
        "7900": {"comment":"Store page and address"},
        "7909": {"synopsis":"Moves IY to the next pointer.\nEntry: B = the pointers left.\nExit: loops or returns.","comment":"Next pointer"},
        "7918": {"synopsis":"Moves the loop addresses of every FOR-NEXT numeric variable (type bit 6) as ADJUST_PTR_HL\ndoes,\nfollowing each of the 26 letter chains from NVARS. ROM1's $E838 calls it (through CALL\n$0201)\nafter a block of the program moved.\nEntry: HL = NVARS's first chain word; D = the page; TEMPW3 = the offset; carry = the\ndirection.\nExit: AF as on entry.\nChanges: BC, DE, HL, IY.","comment":"The direction to AF'"},
        "7919": {"comment":"C = the page"},
        "7920": {"comment":"26 letters"},
        "7922": {"synopsis":"Starts a letter's chain.\nEntry: HL = its word.\nExit: to ADJ_FOR_CHAIN.","comment":"Keep the letter's word"},
        "7923": {"synopsis":"Follows one link of the chain: the word at HL is the offset to the next variable.\nEntry: HL = the offset word.\nExit: to ADJ_FOR_NEXTLET at the chain's end ($FFFF).","comment":"The offset"},
        "7926": {"comment":"$FFFF: the chain ends"},
        "7929": {"comment":"A FOR-NEXT variable?"},
        "7935": {"comment":"Past the name, value, limit and step"},
        "7944": {"comment":"TEMPW3: the place"},
        "7948": {"comment":"Move its loop address"},
        "7953": {"synopsis":"On to the variable's offset word.\nEntry: HL = the type byte.\nExit: to ADJ_FOR_CHAIN.","comment":"The next link"},
        "7956": {"synopsis":"On to the next letter's word.\nEntry: the letter's word on the stack.\nExit: loops, or returns.","comment":"Next letter"},
        "7961": {"comment":"AF back"},
        "7963": {"synopsis":"Pages DESTP in and gets DEST (SYSPTR_PAGE_IN).\nEntry: none.\nExit: HL = DEST; A = its page.\nChanges: AF, HL.","comment":"DESTP"},
        "7967": {"synopsis":"Pages NVARSP in and gets NVARS (SYSPTR_PAGE_IN).\nEntry: none.\nExit: HL = NVARS; A = its page.\nChanges: AF, HL.","comment":"NVARSP"},
        "7971": {"synopsis":"Pages NUMENDP in and gets NUMEND (SYSPTR_PAGE_IN).\nEntry: none.\nExit: HL = NUMEND; A = its page.\nChanges: AF, HL.","comment":"NUMENDP"},
        "7975": {"synopsis":"Pages SAVARSP in and gets SAVARS (SYSPTR_PAGE_IN).\nEntry: none.\nExit: HL = SAVARS; A = its page.\nChanges: AF, HL.","comment":"SAVARSP"},
        "7979": {"synopsis":"Pages WORKSPP in and gets WORKSP (SYSPTR_PAGE_IN).\nEntry: none.\nExit: HL = WORKSP; A = its page.\nChanges: AF, HL.","comment":"WORKSPP"},
        "7983": {"synopsis":"Pages KCURP in and gets KCUR (SYSPTR_PAGE_IN). The LD HL instructions after it hide four\nmore\nentries inside their operands, each loading A and skipping the rest: $1F32 PROG, $1F35\nELINE,\n$1F38 DATADD, $1F3B CHAD.\nEntry: none.\nExit: HL = the address; A = its page.\nChanges: AF, HL.","comment":"KCURP"},
        "7985": {"comment":"$1F32: LD A,$9F (PROGP)"},
        "7988": {"comment":"$1F35: LD A,$93 (ELINEP)"},
        "7991": {"comment":"$1F38: LD A,$8A (DATADDP)"},
        "7994": {"comment":"$1F3B: LD A,$96 (CHADP)"},
        "7997": {"comment":"L = the variable"},
        "7998": {"synopsis":"Reads a pointer kept in the system variables as a page byte and an address word at $5A00 +\nL:\nwrites the page to HMPR's bits 4-0 and loads the address.\nEntry: L = the page byte's offset.\nExit: HL = the address; A = the page (HMPR bits 4-0).\nChanges: AF, HL."},
        "8000": {"synopsis":"SYSPTR_PAGE_IN for any HL. $3385 calls it.\nEntry: HL = the page byte.\nExit: as SYSPTR_PAGE_IN.","comment":"Page it in"},
        "8004": {"comment":"The address"},
        "8009": {"comment":"A = the page"},
        "8014": {"synopsis":"For the program line at HL: its length with the 4-byte head, and the next line.\nEntry: HL = the line.\nExit: HL = the line; DE = the next line; BC = the length.\nChanges: AF, BC, DE, HL."},
        "8015": {"comment":"The length word"},
        "8021": {"comment":"HL = the next line"},
        "8023": {"synopsis":"The length of the block from DE up to HL.\nEntry: DE = the start; HL = past the end.\nExit: BC = HL - DE; HL = the start; DE = past the end.\nChanges: F, BC, DE, HL.","comment":"BC = HL - DE"},
        "8031": {"synopsis":"Takes a number n off the calculator stack and checks it is 1 to D. The next instruction's\noperand hides another entry, $1F62 (XOR A), which checks 0 to D-1.\nEntry: D = the limit; E = the error code.\nExit: C = n; A = n - 1 (from $1F62, A = n).\nError: stops with error code E when n is out of range.\nChanges: AF, BC, HL.","comment":"Subtract 1 ($1F62: XOR A, subtract 0)"},
        "8037": {"comment":"n, 0-255?"},
        "8041": {"comment":"Over 255 or negative: error"},
        "8046": {"comment":"n - 1 (or n) below D?"},
        "8049": {"synopsis":"Stops with error code E: puts E in ERRNR and jumps into RST $08's body with ERRNR as the\nreturn address, so the code is read from there.\nEntry: E = the error code.\nExit: does not return.","comment":"ERRNR = E"},
        "8053": {"comment":"The 'return address' for RST $08's body"},
        "8057": {"synopsis":"Splits the length in BC into 16K pages (BC's bits 15-14 to PAGCOUNT) and the rest (bits 13-0\nto MODCOUNT).\nEntry: BC = the length.\nExit: PAGCOUNT, MODCOUNT set; BC = bits 13-0.\nChanges: BC."},
        "8058": {"comment":"Keep the top bits in A"},
        "8059": {"comment":"Clear bits 15-14"},
        "8063": {"comment":"MODCOUNT"},
        "8067": {"comment":"PAGCOUNT"},
        "8076": {"synopsis":"The free memory between WKEND and RAMTOP, as a 19-bit linear number.\nEntry: none.\nExit: A:HL = RAMTOP - WKEND - 1; carry set when there is none.\nChanges: AF, HL."},
        "8078": {"comment":"WKEND, linear"},
        "8083": {"comment":"RAMTOP, linear"},
        "8086": {"comment":"RAMTOP - WKEND - 1"},
        "8093": {"synopsis":"An address that wrapped past $FFFF (an ADD that set carry): pages HMPR on and puts HL back\nat\n$8000-$BFFF (WRAP_ADDR).\nEntry: HL = the wrapped address.\nExit: HMPR = the new page; HL = $8000-$BFFF.\nChanges: AF, HL.","comment":"From the current page"},
        "8098": {"comment":"Write HMPR"},
        "8100": {"synopsis":"Turns page A and an address HL that wrapped past $FFFF into a page and an offset at\n$8000-$BFFF: A + 2 (the 32K of sections C and D) plus HL's bits 15-14 as pages.\nEntry: A = the page; HL = the wrapped address.\nExit: A = the page; HL = $8000-$BFFF.\nChanges: AF, HL.","comment":"Past sections C and D"},
        "8102": {"comment":"Bit 14: one more page"},
        "8109": {"synopsis":"Bit 15: two more pages.\nEntry: A, HL.\nExit: to WRAP_ADDR_SET.","comment":"Bit 15: two more pages"},
        "8115": {"synopsis":"Puts HL in $8000-$BFFF.\nEntry: HL with bit 14 clear.\nExit: HL = $8000-$BFFF.","comment":"Into section C"},
        "8118": {"synopsis":"The byte before the edit line: pages ELINEP in and moves to ELINE - 1 (PTR_PREV).\nEntry: none.\nExit: HL = ELINE - 1, paged in at $8000-$BFFF.\nChanges: AF, HL.","comment":"ELINE paged in"},
        "8121": {"synopsis":"Moves HL back one byte, paging down when it falls below $8000.\nEntry: HL; HMPR its page.\nExit: as PTR_BELOW_8000.","comment":"One back"},
        "8122": {"synopsis":"When HL has fallen below $8000, pages HMPR down and puts HL back in $8000-$BFFF: one page\nfrom\n$4000-$7FFF, two from below $4000.\nEntry: HL; HMPR its page.\nExit: HL = $8000-$BFFF with HMPR set.\nChanges: AF, HL.","comment":"Still in section C or D: done"},
        "8125": {"comment":"One page down"},
        "8130": {"comment":"Was it $4000-$7FFF?"},
        "8134": {"comment":"No: two pages down"},
        "8135": {"synopsis":"Puts HL in $8000-$BFFF and writes HMPR.\nEntry: A = the page.\nExit: as PTR_BELOW_8000.","comment":"Into section C"},
        "8137": {"synopsis":"Writes A to HMPR.\nEntry: A = the value.\nExit: returns.","comment":"HMPR"},
        "8140": {"synopsis":"Adds BC to the paged address A:HL.\nEntry: A = the page; HL = the offset; BC = the amount.\nExit: as LINEAR_TO_PAGED.\nChanges: AF, HL.","comment":"To linear"},
        "8143": {"comment":"Add BC"},
        "8148": {"synopsis":"Subtracts BC from the paged address A:HL.\nEntry: A = the page; HL = the offset; BC = the amount.\nExit: as LINEAR_TO_PAGED.\nChanges: AF, HL.","comment":"To linear"},
        "8151": {"comment":"Subtract BC"},
        "8158": {"synopsis":"Adds the paged address C:DE to the paged address A:HL, both counted linearly.\nEntry: A:HL, C:DE = page and offset each.\nExit: as LINEAR_TO_PAGED.\nChanges: AF, HL.\nKeeps: BC, DE."},
        "8160": {"comment":"Both to linear"},
        "8163": {"comment":"Add"},
        "8167": {"synopsis":"Subtracts the paged address C:DE from the paged address A:HL, both counted linearly.\nEntry: A:HL, C:DE = page and offset each.\nExit: as LINEAR_TO_PAGED; carry also set when the result is negative.\nChanges: AF, HL.\nKeeps: BC, DE."},
        "8169": {"comment":"Both to linear"},
        "8172": {"comment":"Subtract"},
        "8176": {"synopsis":"Restores DE and BC, then LINEAR_TO_PAGED.\nEntry: DE, BC on the stack.\nExit: as LINEAR_TO_PAGED."},
        "8178": {"synopsis":"Turns the 19-bit linear address A:HL (A = bits 18-16) into a page and an offset at\n$8000-$BFFF.\nEntry: A:HL = the linear address.\nExit: A = the page; HL = $8000-$BFFF; carry set when the page is 32 or more.\nChanges: AF, HL.","comment":"Bits 15-14 into A"},
        "8184": {"comment":"HL's top bits 1, 0: $8000-$BFFF"},
        "8189": {"comment":"Page 32 or more?"},
        "8193": {"synopsis":"Converts two page/offset addresses to 19-bit linear form: A:HL through PAGE_OFS_LINEAR, then\nfalls into LINEAR_CDE for C:DE.\nEntry: A, HL = the first page and offset; C, DE = the second.\nExit: A:HL and C:DE = the linear addresses (A and C = bits 16-18).\nChanges: F.\nKeeps: B.","comment":"Linear form of A:HL"},
        "8196": {"synopsis":"Converts the page/offset address C:DE to 19-bit linear form through PAGE_OFS_LINEAR (ROM1\ncalls it too).\nEntry: C = the page; DE = the offset.\nExit: C:DE = the linear address (C = bits 16-18).\nChanges: F.\nKeeps: A, B, HL.","comment":"Keep the first result"},
        "8197": {"comment":"C:DE to A:HL"},
        "8199": {"comment":"Linear form of C:DE"},
        "8202": {"comment":"Back to C:DE"},
        "8206": {"synopsis":"Gives RAMTOP as a 19-bit linear address: RAMTOPP and RAMTOP through PAGE_OFS_LINEAR.\nEntry: none.\nExit: A:HL = the address (A = bits 16-18).\nChanges: AF, HL.","comment":"RAMTOPP"},
        "8209": {"comment":"RAMTOP"},
        "8214": {"synopsis":"Gives WKEND as a 19-bit linear address: WKENDP and WKEND through PAGE_OFS_LINEAR, counting\nan offset of $C000 or more in the next page.\nEntry: none.\nExit: A:HL = the address (A = bits 16-18).\nChanges: AF, HL.","comment":"WKENDP"},
        "8217": {"comment":"WKEND"},
        "8220": {"comment":"Offset in $C000-$FFFF?"},
        "8224": {"comment":"Then it is in the next page"},
        "8225": {"synopsis":"Converts a page and an offset into a 19-bit linear address: page x 16K + (offset AND $3FFF).\nBits 14-15 of the offset are ignored, so an offset in $8000-$BFFF and one in $C000-$FFFF\ngive the same result.\nEntry: A = the page (0-31); HL = the offset.\nExit: A = bits 16-18 (0-7); HL = bits 0-15; carry reset.\nChanges: AF, HL.","comment":"Offset bits 15-14 into bits 1-0"},
        "8229": {"comment":"Page bit 0 into the carry"},
        "8230": {"comment":"Into offset bit 14"},
        "8232": {"comment":"Page bit 1 into the carry"},
        "8233": {"comment":"Into offset bit 15"},
        "8235": {"comment":"Page bits 4-2 are bits 18-16"},
        "8238": {"synopsis":"Makes an error in the caller's next CALL come back as if that CALL returned: saves ERRSP\nunder the return address and points ERRSP at the slot the next CALL's return address takes.\nThe caller then restores ERRSP with POP HL and LD (ERRSP),HL (as at $0709 and $19C1).\nEntry: none.\nExit: the old ERRSP on the stack; ERRSP = SP - 2.\nChanges: HL.","comment":"ERRSP"},
        "8241": {"comment":"Old ERRSP under the return address"},
        "8242": {"comment":"Return address back on top"},
        "8243": {"comment":"ERRSP: the slot the next CALL fills"},
        "8248": {"synopsis":"Reads the 3-byte pointer at $4B22 (system page): C = its first byte, DE = the next two\n(probably a page and an offset). ROM1 calls this entry, $203B (the same for $4B72: the LD\nDE,nn at $203A hides its LD L,$72) and READ_PTR3_HL.\nEntry: none.\nExit: C, DE = the pointer; HL = its last byte.\nChanges: C, DE, HL.","comment":"$4B22 (the LD DE skips the next LD L)"},
        "8250": {"comment":"$203B entry: LD L,$72 for $4B72"},
        "8253": {"comment":"System page"},
        "8255": {"synopsis":"Reads a 3-byte pointer at HL: C = the first byte, DE = the next two. PTR3_AT_4B22 ends here.\nEntry: HL = the pointer.\nExit: C, DE = its bytes; HL = its last byte.\nChanges: C, DE, HL.","comment":"First byte"},
        "8257": {"comment":"Then a word"},
        "8261": {"synopsis":"JT_017B's body: waits for two level changes on the tape input (EAR, port $FE bit 6),\ncounting in C from 0 through TAPE_EDGE.\nEntry: B = the last level in bit 6, border bits 0-2 and 3-4 to output.\nExit: carry set: both edges came, C = the count, B = the new level; carry reset: the key was\ndown or the count ran out (a timeout on the first edge returns the entry's carry).\nChanges: AF, BC.","comment":"Count from 0"},
        "8263": {"synopsis":"TAPE_TWO_EDGES counting on from C (ROM1 calls this entry).\nEntry: B as TAPE_TWO_EDGES; C = the count so far.\nExit: as TAPE_TWO_EDGES.\nChanges: AF, BC.","comment":"First edge"},
        "8266": {"comment":"Key down or timeout?"},
        "8267": {"comment":"Carry reset: a timeout now fails"},
        "8268": {"synopsis":"Waits for one level change on the tape input (port $FE bit 6) after a short delay, counting\nthe samples in C, and flips the border colour on it.\nEntry: B = the last level in bit 6 and the border bits; C = the count so far; carry = what a\ntimeout returns.\nExit: on an edge: B = the new level (bits 0-2, 5 and 6 flipped), the border written, A = C =\nthe count, carry = bit 5 of STATUS read with row $F7 (reset while that key is down); C\nreaching 0: Z set, carry as on entry.\nChanges: AF, BC.","comment":"Delay before sampling"},
        "8270": {"synopsis":"TAPE_EDGE's delay before sampling: 8 turns."},
        "8273": {"synopsis":"TAPE_EDGE's sampling loop: counts in C until the EAR bit differs from B's bit 6.","comment":"EAR is bit 6 (port $FE, all key rows)"},
        "8275": {"comment":"Count the sample"},
        "8276": {"comment":"Count ran out?"},
        "8277": {"comment":"Level changed?"},
        "8283": {"comment":"Flip the level and the border colour"},
        "8286": {"comment":"Border, MIC and beeper bits"},
        "8288": {"comment":"Show the edge in the border"},
        "8290": {"comment":"Key row $F7"},
        "8292": {"comment":"STATUS: keys in bits 5-7"},
        "8296": {"comment":"Carry = bit 5 (reset: key down)"},
        "8297": {"comment":"A = the count"},
        "8299": {"synopsis":"JCIRCLE's body: draws a circle round C,B with radius A, the thin-pixel window base in HL. As\nwritten, the radius the ring loop pops at $20A5 is the F pushed here (L = F), not A; A only\nsets the error term.\nEntry: C = x; B = the row; A = the radius; HL = the window base for thin pixels (TEMPW1).\nChanges: all.","comment":"Radius (but $20A5 pops it as HL: L = F)"},
        "8300": {"comment":"TEMPW1: the thin-pixel window base"},
        "8305": {"synopsis":"The CIRCLE command (reached through ROM1's command table at $FD79): reads the leading items\nand x,y ($3AF2), a comma and the radius, returns when checking syntax, then draws.\n1. Coordinates and radius from the line ($3AF2, $3A85, $3A58); the radius 0-255 ($1D33).\n2. CIRCLE_AT_R.\nError: stops with error code 30 for a radius out of range, 29 for a bad separator.","comment":"Colour items, then x,y"},
        "8308": {"comment":"Comma next?"},
        "8311": {"comment":"Radius; return if checking syntax"},
        "8314": {"comment":"Radius 0-255 in A and C"},
        "8317": {"synopsis":"Draws a circle of radius C at the x,y on the calculator stack: ROM1's $E9C8 fetches the\npoint (through GET_PLOT_COORDS, giving a thin-pixel window in TEMPW1), then CIRCLE_DRAW.\nBLITZ_LOOP calls it for a recorded circle.\nEntry: C = the radius; A = C; x and y on the calculator stack.\nChanges: all.","comment":"Radius under the point's word"},
        "8319": {"comment":"Fetch the centre; carry: thin pixels"},
        "8323": {"synopsis":"Draws a circle: records it (when THFATT is not 0), pages the screen in, picks the plot\nroutine (PLOT_SELECT, or CIRC_THIN_PLOT for thin pixels), plots the centre alone for radius\n0, else the ring by the midpoint method, eight points per step, and pages the screen out.\nEntry: C = x; B = the row; A = the radius; the radius also in the low byte of the word on\nthe stack.\nChanges: all.","comment":"Ring points return here"},
        "8327": {"comment":"Radius"},
        "8328": {"comment":"Error term starts at radius/2"},
        "8331": {"comment":"Record kind 3: a circle"},
        "8333": {"comment":"THFATT"},
        "8337": {"comment":"Record it, unless thin pixels"},
        "8340": {"comment":"Screen in at $8000"},
        "8343": {"comment":"IY = the plot routine, A = the colour"},
        "8346": {"comment":"Thin pixels?"},
        "8348": {"comment":"Thin: plot through the window"},
        "8352": {"synopsis":"Puts the colour from PLOT_SELECT in D' and the centre in DE (D = row, E = x), takes the\nradius off the stack.","comment":"D' = the colour"},
        "8355": {"comment":"DE = the centre (row, x)"},
        "8357": {"comment":"L = the radius"},
        "8358": {"comment":"Radius 0?"},
        "8362": {"comment":"Plot the centre alone"},
        "8363": {"comment":"Then page the screen out"},
        "8369": {"synopsis":"Draws the ring: the four axis points, then CIRCLE_STEP to the diagonal.","comment":"Points at (+-r, 0)"},
        "8374": {"comment":"Now L = 0, H = r"},
        "8377": {"comment":"Point at (0, +r)"},
        "8381": {"comment":"H = -r"},
        "8384": {"comment":"Point at (0, -r)"},
        "8388": {"comment":"L = 1"},
        "8389": {"synopsis":"CIRCLE_RING's loop: eight points at (+-L, +-H) and (+-H, +-L), then the error term in A'\ndecides whether H moves in.","comment":"Eight points"},
        "8392": {"comment":"L one further"},
        "8393": {"comment":"Error term"},
        "8394": {"comment":"Take L off"},
        "8395": {"comment":"Still positive?"},
        "8397": {"comment":"Add H and move H in"},
        "8399": {"synopsis":"Ends the loop once L has passed H; adds the four diagonal points when L equals H, then pages\nthe screen out.","comment":"Error term kept"},
        "8400": {"comment":"L past H?"},
        "8402": {"comment":"Loop while L < H"},
        "8405": {"comment":"L = H: the diagonal points"},
        "8409": {"comment":"Screen out"},
        "8412": {"synopsis":"Plots the eight points (+-L, +-H) and (+-H, +-L) round the centre DE: CIRC_SWAP_4 twice, so\nH and L end as they started.\nEntry: D, E = the centre row and x; H, L = the offsets; IY = the plot routine.\nChanges: AF, BC.","comment":"Swapped quadrants"},
        "8415": {"synopsis":"Swaps H and L, then plots the four points (+-L, +-H) (CIRC_4_POINTS).","comment":"Swap H and L"},
        "8418": {"synopsis":"Plots the four points (+-L, +-H) round the centre: CIRC_NEG_PAIR twice, so H ends as it\nstarted.\nEntry: as CIRC_8_POINTS.\nChanges: AF, BC.","comment":"With -H"},
        "8421": {"synopsis":"Negates H, then plots the pair (+-L, H) (CIRC_PAIR).","comment":"Negate H"},
        "8424": {"synopsis":"Plots the pair of points at x E+L and E-L, row D+H, skipping any off the screen.\nEntry: D, E = the centre; H, L = the offsets; IY = the plot routine.\nChanges: AF, BC.","comment":"x = E + L"},
        "8426": {"comment":"No carry: on the screen"},
        "8429": {"synopsis":"Plots the point at x E-L, row D+H, unless x is off the left.","comment":"x = E - L"},
        "8431": {"comment":"Off the left?"},
        "8432": {"synopsis":"Plots the point at x A, row D+H through IY with CIRC_PLOT_DONE as IX's return, unless the\nrow is past 191; keeps H and L in B, C.","comment":"Keep the offsets"},
        "8434": {"comment":"L = x"},
        "8435": {"comment":"Row = D + H"},
        "8437": {"comment":"Past row 191?"},
        "8441": {"comment":"H = the row"},
        "8442": {"comment":"Plot; returns through IX"},
        "8444": {"synopsis":"The return of a circle point's plot (IX): H and L back from B and C.","comment":"Offsets back"},
        "8447": {"synopsis":"The plot routine (IY) for a circle in thin pixels: x = TEMPW1 + L, row H, through PLOT_THIN;\nreturns through IX.\nEntry: H = the row; L = x within the window; IX = the return.\nChanges: AF."},
        "8451": {"comment":"B = the row"},
        "8452": {"comment":"DE = x within the window"},
        "8455": {"comment":"TEMPW1: the window base"},
        "8458": {"comment":"HL = the thin x"},
        "8459": {"comment":"Plot it"},
        "8466": {"comment":"Back to the circle code"},
        "8468": {"synopsis":"JDRAWTO's body: draws a line from the last point to C,B (HL,B for thin pixels when THFATT is\n0), as DRAW_TO_XY.\nEntry: C (or HL) = x; B = the row.\nChanges: all.","comment":"THFATT"},
        "8471": {"comment":"Carry: thin pixels"},
        "8473": {"comment":"Kept in F'"},
        "8476": {"synopsis":"The DRAW command (reached through ROM1's command table at $FDCB): DRAW x,y draws relative to\nthe last point, DRAW followed by token $8E (probably TO) to x,y; a third number, the angle,\nmakes an arc, drawn by ROM1 ($EA5E relative, $EA38 absolute, the angle in calculator memory\n0).\nEntry: A = the character after the command.\nError: stops with error code 30 for a point off the screen, 32 when the line leaves it.","comment":"Token $8E after DRAW?"},
        "8478": {"comment":"TEMPB3: 0 for DRAW TO"},
        "8481": {"comment":"Relative DRAW?"},
        "8483": {"comment":"Past the token"},
        "8484": {"synopsis":"Reads the leading items and x,y, then an optional third number.","comment":"Leading items, then x,y"},
        "8487": {"comment":"A third number?"},
        "8491": {"comment":"The angle; return if checking syntax"},
        "8494": {"comment":"TEMPB3"},
        "8498": {"comment":"DRAW TO?"},
        "8501": {"comment":"Relative arc: ROM1 draws it"},
        "8504": {"synopsis":"DRAW TO with an angle: marks TEMPB3 not 0, puts the angle in calculator memory 0 and goes on\nto the end point.","comment":"TEMPB3 not 0: an arc"},
        "8505": {"comment":"Angle into calculator memory 0"},
        "8510": {"synopsis":"No angle: returns when checking syntax, then a relative DRAW goes to DRAW_REL_STACK, DRAW TO\non to DRAW_TO_FETCH.","comment":"Return if checking syntax"},
        "8513": {"comment":"TEMPB3"},
        "8517": {"comment":"Relative DRAW?"},
        "8519": {"synopsis":"Takes the end point off the calculator stack (GET_PLOT_COORDS), records a DRAW TO without an\nangle (kind 2), then draws (DRAW_TO_XY). BLITZ_LOOP calls it for a recorded DRAW TO.\nEntry: x and y on the calculator stack; TEMPB3 = 0 for a line, not 0 for an arc.\nError: stops with error code 30 for a point off the screen.\nChanges: all.","comment":"End point; carry: thin pixels"},
        "8524": {"comment":"TEMPB3"},
        "8528": {"comment":"Record kind 2: DRAW TO"},
        "8530": {"comment":"Record it, unless an arc"},
        "8533": {"comment":"Carry reset: ordinary pixels"},
        "8534": {"synopsis":"Keeps the thin-pixel flag (carry) in F'.","comment":"Thin-pixel flag into F'"},
        "8535": {"synopsis":"Turns the end point into a relative line from YCOORD, XCOORD: B = |dy|, D = the row step, C\n(or HL) = |dx|, E = the x step; then an arc goes to ROM1, a line on to LINE_REL.\nEntry: C (or HL with carry in F') = x; B = the row.\nChanges: all.","comment":"YCOORD"},
        "8538": {"comment":"Rows to go"},
        "8539": {"comment":"Row step up"},
        "8541": {"comment":"Moving up?"},
        "8543": {"comment":"Down: |dy|"},
        "8545": {"comment":"Row step down"},
        "8547": {"synopsis":"B = |dy|; then the x distance, thin or not.","comment":"B = |dy|"},
        "8548": {"comment":"Thin pixels?"},
        "8549": {"comment":"Thin: 16-bit x"},
        "8551": {"comment":"XCOORD"},
        "8554": {"comment":"Columns to go"},
        "8555": {"comment":"x step left"},
        "8557": {"comment":"Moving left?"},
        "8559": {"comment":"Right: |dx|"},
        "8561": {"comment":"x step right"},
        "8563": {"synopsis":"C = |dx| (ordinary pixels)."},
        "8566": {"synopsis":"Thin pixels: HL = |x - XCOORD| (16 bits), E = the x step.","comment":"Keep the steps"},
        "8567": {"comment":"XCOORD (16 bits)"},
        "8572": {"comment":"x - XCOORD"},
        "8574": {"comment":"Step right"},
        "8575": {"comment":"Not negative?"},
        "8577": {"comment":"Negative: HL = -(x - XCOORD)"},
        "8583": {"comment":"Step left ($FF)"},
        "8584": {"synopsis":"E = the x step for thin pixels."},
        "8585": {"comment":"E = the x step"},
        "8586": {"synopsis":"An arc (TEMPB3 not 0) jumps to ROM1's $EA38; a line goes on to LINE_REL.","comment":"TEMPB3"},
        "8590": {"comment":"A line?"},
        "8592": {"comment":"Absolute arc: ROM1 draws it"},
        "8595": {"synopsis":"Draws a line by the dx,dy on the calculator stack: scales them (SCALE_DELTAS), takes them as\nmagnitudes and steps (GET_DRAW_DELTAS), records it (ordinary pixels) and falls into\nLINE_REL. BLITZ_LOOP calls it for a recorded relative DRAW.\nEntry: dx and dy on the calculator stack.\nError: stops with error code 30 for a distance out of range, 32 when the line leaves the\nscreen.\nChanges: all.","comment":"Scale dx,dy"},
        "8598": {"comment":"Magnitudes and steps"},
        "8601": {"comment":"Record kind: E - 1 (x sign)"},
        "8602": {"comment":"Record it, unless thin pixels"},
        "8605": {"comment":"Step back"},
        "8606": {"synopsis":"JDRAW's body: draws a line from the last point (YCOORD, XCOORD) by the given distances,\nplotting with the PLOT_SELECT routine; thin pixels go to LINE_THIN. A line whose end is off\nthe screen is drawn to the edge, then stops with error 32.\n1. IY = the plot routine, HL' = the start (H = row, L = x).\n2. Checks the end point: a start on the edge moving out stops at once; an end off the screen\n   makes LINE_EDGE_NEXT the plot's return.\n3. LINE_STEPS, then LINE_END stores the last point.\nEntry: B = |dy|; D = the row step (1 down, $FF up); C = |dx|; E = the x step (1 or $FF);\ncarry set for thin pixels (HL = |dx|).\nExit: YCOORD, XCOORD = the end.\nError: stops with error code 32.\nChanges: all.","comment":"Screen in at $8000"},
        "8609": {"comment":"IY = the plot routine, A = the colour"},
        "8612": {"comment":"Thin pixels?"},
        "8615": {"comment":"Colour in A'"},
        "8616": {"comment":"Plots return to LINE_NEXT"},
        "8620": {"comment":"YCOORD, XCOORD"},
        "8623": {"comment":"H = row, L = x"},
        "8626": {"comment":"Start into HL'"},
        "8630": {"comment":"Any distance across?"},
        "8634": {"comment":"Start x"},
        "8635": {"comment":"Moving right?"},
        "8638": {"comment":"Left from x = 0?"},
        "8641": {"comment":"End x"},
        "8644": {"synopsis":"Moving right: x already 255 stops with error 32, else the end x.","comment":"Right from x = 255?"},
        "8648": {"comment":"End x"},
        "8649": {"synopsis":"Past the edge across? Then the line is clipped (LINE_CLIPPED).","comment":"Step back"},
        "8650": {"comment":"Off the screen across?"},
        "8652": {"synopsis":"The row the line ends on, by the row step.","comment":"Any distance down or up?"},
        "8654": {"comment":"Start row"},
        "8657": {"comment":"Moving down?"},
        "8660": {"comment":"Up from row 0?"},
        "8663": {"comment":"End row"},
        "8666": {"synopsis":"Moving down: row 191 already stops with error 32, else the end row.","comment":"Down from row 191?"},
        "8668": {"synopsis":"A start on the edge moving out: stops with error 32.","comment":"Yes: off the screen"},
        "8670": {"comment":"End row"},
        "8671": {"synopsis":"Restores D; a borrow or carry (off the top, or past 255) clips the line.","comment":"Step back"},
        "8672": {"comment":"Off the top, or past 255?"},
        "8674": {"synopsis":"End row past 191? Then the line is clipped.","comment":"End row on the screen?"},
        "8678": {"synopsis":"The end is off the screen: each plot returns to LINE_EDGE_NEXT, which stops at the edge.","comment":"Plots return to LINE_EDGE_NEXT"},
        "8682": {"synopsis":"Draws the line (LINE_STEPS), then stores its end with carry set (no error).","comment":"Draw the line"},
        "8686": {"comment":"Carry: no error"},
        "8687": {"comment":"Store the end"},
        "8690": {"synopsis":"Steps a line from the point in HL' (H = row, L = x), plotting each point through IY with IX\nas the return: the longer distance is the count, the shorter one adds to an error term that\ndecides each diagonal step (a Bresenham line).\nEntry: B = |dy|, C = |dx|; D, E = the row and x steps; A' = the colour; HL' = the start; IY\n= the plot; IX = LINE_NEXT or LINE_EDGE_NEXT.\nExit: HL' = the last point.\nChanges: all.","comment":"Steps into BC'"},
        "8693": {"comment":"x step left?"},
        "8696": {"comment":"Then borrow from the row"},
        "8697": {"synopsis":"BC' = the diagonal step as a word added to HL' (row, x).","comment":"Back to the x step"},
        "8699": {"comment":"dx"},
        "8700": {"comment":"dx >= dy?"},
        "8703": {"comment":"dy is the long axis: L = dx"},
        "8704": {"comment":"Straight step: the row only"},
        "8708": {"synopsis":"dx >= dy: x is the long axis, the straight step moves x only; nothing to draw when both are\n0.","comment":"Both 0?"},
        "8710": {"comment":"dx is the long axis: L = dy"},
        "8711": {"comment":"B = the count"},
        "8712": {"comment":"Straight step: x only"},
        "8714": {"synopsis":"DE' = the straight step as a word added to HL'.","comment":"Straight step into DE'"},
        "8717": {"comment":"x step left?"},
        "8720": {"comment":"Then borrow from the row"},
        "8721": {"synopsis":"D = the colour, H = the count, A = the error term (half the count).","comment":"Back to the x step"},
        "8723": {"comment":"Colour from A'"},
        "8724": {"comment":"D = the colour"},
        "8725": {"comment":"H = the long distance"},
        "8727": {"comment":"Error term = half of it"},
        "8729": {"synopsis":"LINE_STEPS' loop: adds the short distance to the error term; a step past the count goes\ndiagonally, else straight.","comment":"Add the short distance"},
        "8730": {"comment":"Overflow: diagonal"},
        "8732": {"comment":"Reached the long distance?"},
        "8735": {"synopsis":"A diagonal step (HL' + BC'), then the plot.","comment":"Take it off"},
        "8736": {"comment":"Error term in C"},
        "8738": {"comment":"Diagonal step"},
        "8739": {"comment":"Plot; returns through IX"},
        "8741": {"synopsis":"A straight step (HL' + DE'), then the plot.","comment":"Error term in C"},
        "8743": {"comment":"Straight step"},
        "8744": {"comment":"Plot; returns through IX"},
        "8746": {"synopsis":"The plot's return (IX) for a line on the screen: the error term back, then the next step\nuntil the count runs out.","comment":"Error term back"},
        "8748": {"comment":"Next point"},
        "8751": {"synopsis":"The plot's return (IX) for a line that leaves the screen: goes on while the point is inside\n(x 1-254, row 1-190), else ends at LINE_END with carry reset (error 32).","comment":"x at 0 or 255?"},
        "8756": {"comment":"Yes: end with carry reset"},
        "8758": {"comment":"Row 1-190?"},
        "8762": {"comment":"Yes: next point"},
        "8764": {"synopsis":"Stores the last point in YCOORD, XCOORD and pages the screen out; returns with carry set,\nelse stops with error 32.","comment":"Keep the carry"},
        "8765": {"comment":"Back to L = row, H = x"},
        "8768": {"comment":"YCOORD, XCOORD"},
        "8771": {"comment":"Screen out"},
        "8775": {"comment":"Carry: done"},
        "8776": {"synopsis":"Stops with error code 32 (a line leaving the screen)."},
        "8778": {"synopsis":"LINE_REL for thin pixels: steps offsets from 0 in HL' with LINE_THIN_PLOT as the plot, which\nplots each point from XCOORD, YCOORD and stores it; a distance across of 256 or more is\ndrawn in two halves by LINE_STEPS.\nEntry: as LINE_REL with HL = |dx|.\nError: stops with error code 32 when the line leaves the screen.\nChanges: all.","comment":"Offsets from 0 in HL'"},
        "8783": {"comment":"Plot through LINE_THIN_PLOT"},
        "8787": {"synopsis":"dx over 255: draws half of dx and dy (LINE_STEPS), then the rest with the halves' lost bits\nadded back.","comment":"dx 256 or more?"},
        "8791": {"comment":"Halve dx"},
        "8794": {"comment":"C = dx / 2"},
        "8795": {"comment":"Keep its lost bit"},
        "8796": {"comment":"Halve dy"},
        "8799": {"comment":"B = dy / 2"},
        "8800": {"comment":"Keep its lost bit"},
        "8802": {"comment":"Draw the first half"},
        "8806": {"comment":"dy's rest: half + its lost bit"},
        "8810": {"comment":"dx's rest: half + its lost bit"},
        "8811": {"comment":"H = 1: assume 256 or more"},
        "8816": {"comment":"Still over 255?"},
        "8818": {"synopsis":"The last (or only) part: LINE_STEPS for C = dx, then the screen out.","comment":"C = dx"},
        "8819": {"comment":"Draw it"},
        "8822": {"comment":"Screen out"},
        "8825": {"synopsis":"The plot routine (IY) of LINE_THIN: adds the step in HL (H = row, L = x, each -1, 0 or +1)\nto YCOORD and the 16-bit XCOORD, stops with error 32 off the screen (x 512 or more, row 192\nor more), plots and stores the point (PLOT_THIN_SET), clears HL and goes on at LINE_NEXT.\nEntry: HL = the step.\nError: stops with error code 32."},
        "8827": {"comment":"DE = the step"},
        "8828": {"comment":"YCOORD"},
        "8831": {"comment":"Plus the row step"},
        "8833": {"comment":"XCOORD (16 bits)"},
        "8836": {"comment":"Any x step?"},
        "8840": {"comment":"Right?"},
        "8843": {"comment":"Left: the borrow came off the row"},
        "8844": {"comment":"x - 1 (with the INC HL)"},
        "8846": {"synopsis":"x one to the right (or, from $228B, one to the left), then the edge checks.","comment":"x + 1"},
        "8847": {"comment":"x 512 or more?"},
        "8852": {"comment":"Row 192 or more?"},
        "8857": {"synopsis":"Plots and stores the point, then the next step from 0.","comment":"Plot and store the point"},
        "8860": {"comment":"Next step from 0"},
        "8865": {"comment":"Next point"},
        "8868": {"synopsis":"JPLOT's body: plots the point C,B, or HL,B in thin pixels when THFATT is 0; the point\nbecomes YCOORD, XCOORD.\nEntry: C (or HL) = x; B = the row (0 = top).\nChanges: all.","comment":"THFATT"},
        "8872": {"comment":"Not thin: plot C,B"},
        "8874": {"comment":"Thin: plot HL,B"},
        "8876": {"synopsis":"The PLOT command (reached through ROM1's command table at $FD7B): reads the leading items\nand x,y, returns when checking syntax, then PLOT_STACK_XY.\nError: stops with error code 30 for a point off the screen.","comment":"Leading items, then x,y"},
        "8879": {"comment":"Return if checking syntax"},
        "8882": {"synopsis":"Plots the x,y on the calculator stack: GET_PLOT_COORDS, a record of kind 1 (ordinary\npixels), then PLOT_ROW_COL or PLOT_THIN_PAGED. BLITZ_LOOP calls it for a recorded PLOT.\nEntry: x and y on the calculator stack.\nError: stops with error code 30 for a point off the screen.\nChanges: all.","comment":"The point; carry: thin pixels"},
        "8885": {"comment":"Thin?"},
        "8888": {"comment":"Record kind 1: PLOT"},
        "8890": {"comment":"Record it"},
        "8893": {"synopsis":"Plots the point C,B in ordinary pixels: pages the screen in, stores YCOORD and XCOORD's low\nbyte, picks the plot routine (PLOT_SELECT) and runs it with the screen restored on the way\nout ($3FC6).\nEntry: C = x; B = the row.\nChanges: all.","comment":"Screen in at $8000"},
        "8896": {"comment":"L = row, H = x"},
        "8898": {"comment":"YCOORD and XCOORD's low byte"},
        "8901": {"comment":"H = row, L = x"},
        "8903": {"comment":"IY = the plot routine, A = the colour"},
        "8906": {"comment":"D' = the colour"},
        "8909": {"comment":"Return: restore the screen paging"},
        "8913": {"comment":"Plot"},
        "8915": {"synopsis":"Plots the thin pixel HL,B with the screen paged in (PLOT_THIN_SET), then pages it out.","comment":"Screen in at $8000"},
        "8918": {"comment":"Plot and store"},
        "8921": {"comment":"Screen out"},
        "8924": {"synopsis":"Stores HL,B in XCOORD (16 bits) and YCOORD, then falls into PLOT_THIN.\nEntry: HL = x (0-511); B = the row.\nChanges: AF.","comment":"XCOORD (16 bits)"},
        "8927": {"comment":"YCOORD"},
        "8931": {"synopsis":"Plots a thin pixel of the mode 3 screen (paged in at $8000: 128 bytes a row, 4 pixels a\nbyte): the colour is M231NKT, or M23PAPT with INVERT $FF; OVERT 1 flips the pixel's two bits\ninstead (and does nothing with INVERT on). It takes its return address into IX.\nEntry: HL = x (0-511); B = the row.\nChanges: AF, IX.\nKeeps: BC, DE, HL.","comment":"Return address into IX"},
        "8936": {"comment":"Keep x's low byte"},
        "8937": {"comment":"HL = x / 2"},
        "8941": {"comment":"H = the row"},
        "8942": {"comment":"Pixel in the byte (x AND 3)"},
        "8944": {"comment":"Turns: pixel + 1"},
        "8946": {"comment":"HL = $8000 + row x 128 + x / 4"},
        "8951": {"comment":"Mask before turning"},
        "8953": {"synopsis":"Rotates the mask $FC right by 2 for each pixel position: C clears the pixel's two bits.","comment":"Two bits a pixel"},
        "8957": {"comment":"C = mask clearing the pixel"},
        "8958": {"comment":"E = OVERT, D = INVERT"},
        "8962": {"comment":"M231NKT: the ink"},
        "8965": {"comment":"INVERT $FF?"},
        "8968": {"comment":"Then M23PAPT: the paper"},
        "8971": {"synopsis":"B = the colour; OVERT 1 goes to PLOT_THIN_OVER, else the pixel's bits take B's.","comment":"B = the colour"},
        "8972": {"comment":"OVERT 1?"},
        "8975": {"comment":"Pixel's bits from B, others kept"},
        "8981": {"synopsis":"OVERT 1: flips the pixel's two bits, unless INVERT is on.","comment":"INVERT on?"},
        "8984": {"comment":"Pixel's two bits set"},
        "8986": {"comment":"Flipped in the byte"},
        "8987": {"synopsis":"Writes the byte back and returns through IX.","comment":"Write it back"},
        "8990": {"synopsis":"The plot routine (IY) for mode 1: the pixel's address and bit from $3E3B, then\nPLOT_BIT_MASK.\nEntry: H = the row; L = x; IX = the return.\nChanges: AF.\nKeeps: BC, DE, HL."},
        "8993": {"comment":"BC = x, row"},
        "8995": {"comment":"Address in HL, bit in A"},
        "8998": {"comment":"B = the bit"},
        "9001": {"synopsis":"The plot routine (IY) for mode 2: the pixel's address and bit from $3E58, then\nPLOT_BIT_MASK.\nEntry: H = the row; L = x; IX = the return.\nChanges: AF.\nKeeps: BC, DE, HL."},
        "9004": {"comment":"Address in HL, bit in B"},
        "9007": {"synopsis":"Sets, clears (INVERT $FF) or flips (OVERT 1) the pixel's bit B at HL, sets its attribute\n($3E6C) and returns through IX.","comment":"Mask before turning"},
        "9009": {"comment":"Turns: bit + 1"},
        "9010": {"synopsis":"Rotates the mask: C = all bits but the pixel's.","comment":"One bit a pixel"},
        "9013": {"comment":"C = all but the pixel's bit"},
        "9014": {"comment":"E = OVERT, D = INVERT"},
        "9018": {"comment":"Screen byte"},
        "9019": {"comment":"OVERT 1?"},
        "9022": {"comment":"No: clear the pixel's bit"},
        "9023": {"synopsis":"INVERT $FF leaves the bit clear; otherwise it is set (or, with OVERT 1, flipped).","comment":"INVERT $FF?"},
        "9026": {"comment":"No: set (or flip) the bit"},
        "9028": {"synopsis":"Writes the byte and the pixel's attribute.","comment":"Write it back"},
        "9029": {"comment":"Set the pixel's attribute"},
        "9032": {"synopsis":"Restores BC, DE, HL and returns through IX."},
        "9035": {"comment":"Back to the caller"},
        "9037": {"synopsis":"The plot routine (IY) for mode 4 (and fat mode 3) with GOVERT 0: the pixel's nibble at $8000\n+ row x 128 + x / 2 takes D''s nibble; HL ends as it started.\nEntry: H = the row; L = x; D' = the colour in both nibbles; IX = the return.\nChanges: AF.","comment":"HL = $8000 + row x 128 + x / 2"},
        "9042": {"comment":"Screen byte"},
        "9043": {"comment":"To the colour's set"},
        "9044": {"comment":"Odd x?"},
        "9046": {"comment":"High nibble from D'"},
        "9051": {"comment":"Write it back"},
        "9052": {"comment":"HL back to row, x"},
        "9055": {"synopsis":"Odd x: the low nibble; HL back with L's bit 0 set.","comment":"Low nibble from D'"},
        "9060": {"comment":"Write it back"},
        "9061": {"comment":"HL back to row, x"},
        "9062": {"comment":"Odd x"},
        "9065": {"synopsis":"The plot routine (IY) for GOVERT 1: XORs the colour into the pixel's nibble.\nEntry: as PLOT_NIB_SET.\nChanges: AF.","comment":"HL = the pixel's byte"},
        "9071": {"comment":"Colour"},
        "9073": {"comment":"Odd x?"},
        "9075": {"comment":"High nibble"},
        "9077": {"comment":"XORed in"},
        "9079": {"comment":"HL back to row, x"},
        "9082": {"synopsis":"Odd x: XORs into the low nibble.","comment":"Low nibble"},
        "9084": {"comment":"XORed in"},
        "9086": {"comment":"HL back to row, x"},
        "9088": {"synopsis":"The plot routine (IY) for GOVERT 1 with INVERT on: plots nothing, returns through IX."},
        "9090": {"synopsis":"The plot routine (IY) for GOVERT 2: ORs the colour into the pixel's nibble.\nEntry: as PLOT_NIB_SET.\nChanges: AF.","comment":"HL = the pixel's byte"},
        "9096": {"comment":"Colour"},
        "9098": {"comment":"Odd x?"},
        "9100": {"comment":"High nibble"},
        "9102": {"comment":"ORed in"},
        "9104": {"comment":"HL back to row, x"},
        "9107": {"synopsis":"Odd x: ORs into the low nibble.","comment":"Low nibble"},
        "9109": {"comment":"ORed in"},
        "9111": {"comment":"HL back to row, x"},
        "9115": {"synopsis":"The plot routine (IY) for GOVERT 3 or more: ANDs the colour into the pixel's nibble.\nEntry: as PLOT_NIB_SET.\nChanges: AF.","comment":"HL = the pixel's byte"},
        "9121": {"comment":"Colour"},
        "9123": {"comment":"Odd x?"},
        "9125": {"comment":"Low nibble kept"},
        "9127": {"comment":"ANDed in"},
        "9129": {"comment":"HL back to row, x"},
        "9132": {"synopsis":"Odd x: ANDs into the low nibble.","comment":"High nibble kept"},
        "9134": {"comment":"ANDed in"},
        "9136": {"comment":"HL back to row, x"},
        "9140": {"synopsis":"Picks the plot routine for the screen mode into IY: PLOT_MODE1 (MODE 0), PLOT_MODE2 (MODE\n1), the nibble routines by GOVERT for MODE 3 and for MODE 2 with THFATT not 0; MODE 2 with\nTHFATT 0 (thin pixels) returns carry set. When SETIYV's high byte is not 0, the routine at\nSETIYV is called instead (with A = MODE).\nEntry: none.\nExit: IY = the routine; A = the colour (M231NKT, or M23PAPT with INVERT on) for the nibble\nroutines; carry set for thin pixels.\nChanges: AF, IY.","comment":"SETIYV's high byte"},
        "9144": {"comment":"MODE (0-3 for modes 1-4)"},
        "9147": {"comment":"A vector set?"},
        "9149": {"comment":"Mode 1"},
        "9155": {"comment":"Mode 2"},
        "9161": {"comment":"Mode 3?"},
        "9164": {"comment":"THFATT"},
        "9168": {"comment":"Thin pixels: carry set"},
        "9170": {"synopsis":"The nibble routines: PLOT_NIB_SET for GOVERT 0, else by GOVERT.","comment":"GOVERT"},
        "9173": {"comment":"GOVERT 0: set"},
        "9180": {"comment":"GOVERT 1?"},
        "9183": {"comment":"GOVERT 2: OR"},
        "9190": {"comment":"GOVERT 3 or more: AND"},
        "9194": {"synopsis":"A = M231NKT, or M23PAPT when INVERT is on.","comment":"INVERT"},
        "9198": {"synopsis":"A = M231NKT; returns unless INVERT is on.","comment":"M231NKT: the ink"},
        "9202": {"comment":"M23PAPT: the paper"},
        "9206": {"synopsis":"GOVERT 1: PLOT_NIB_XOR with the ink, or PLOT_NIB_NONE when INVERT is on.","comment":"GOVERT 1: XOR"},
        "9210": {"comment":"INVERT"},
        "9216": {"comment":"Inverse XOR: plot nothing"},
        "9221": {"synopsis":"Calls the routine at SETIYV (CALL_HL) and returns with carry reset."},
        "9222": {"comment":"SETIYV"},
        "9225": {"comment":"Call it"},
        "9229": {"comment":"Carry reset"},
        "9231": {"synopsis":"BLITZ_STRING's loop: runs one recorded graphics command and steps past it. The record's\nfirst byte is its kind: $00 or $FF a relative DRAW (that byte is dx's sign: dx, dy's sign,\ndy; 4 bytes); 1 PLOT, 2 DRAW TO (x, row; 3 bytes); 3 CIRCLE (x, row, radius; 4 bytes); 4\nGOVERT, 5 the pen (M231NKT and ATTRT's ink bits), 6 a clear through JCLSBL's routine\n($06AE), 7 a ROM1 call ($F00E) with C = the byte (2 bytes each). The rows are turned back\ninto y = 191 - ORGOFF - row.\nEntry: DE = the record; HL = the bytes left - 1.\nError: stops with error code 35 for another kind.","comment":"HL = the record, DE = the count"},
        "9232": {"comment":"Keep the count"},
        "9233": {"comment":"Keep the record"},
        "9234": {"comment":"Kind"},
        "9237": {"comment":"Second byte"},
        "9239": {"comment":"B = the third"},
        "9240": {"comment":"Kind $FF or $00?"},
        "9245": {"comment":"Kind 3?"},
        "9249": {"comment":"Fourth byte: the radius"},
        "9251": {"comment":"Carry for kinds 1-3"},
        "9252": {"synopsis":"Kinds 4 and up go to BLITZ_SETTING; kinds 1-3 stack x and y, then run PLOT, DRAW TO or\nCIRCLE.","comment":"Kinds 4 and up?"},
        "9254": {"comment":"Keep the kind's flags"},
        "9255": {"comment":"x as a small integer"},
        "9258": {"comment":"Stack x"},
        "9261": {"comment":"ORGOFF"},
        "9265": {"comment":"y = 191 - row - ORGOFF"},
        "9271": {"comment":"Negative?"},
        "9273": {"comment":"Sign bytes $FF"},
        "9275": {"synopsis":"Stacks y (negative when the row is below ORGOFF's line), then runs the command by its kind.","comment":"Stack y"},
        "9278": {"comment":"Kind 3?"},
        "9281": {"comment":"C = the radius"},
        "9282": {"comment":"CIRCLE"},
        "9287": {"synopsis":"Kind 2: DRAW TO (DRAW_TO_FETCH); kind 1: PLOT (PLOT_STACK_XY); a 3-byte record.","comment":"Kind 2?"},
        "9290": {"comment":"DRAW TO"},
        "9293": {"comment":"Z: skip the PLOT"},
        "9294": {"synopsis":"Kind 1: PLOT_STACK_XY; then a 3-byte step.","comment":"PLOT"},
        "9297": {"comment":"3 bytes"},
        "9301": {"synopsis":"Kinds 4-7: a setting from the record's second byte; another kind stops with error 35.","comment":"Kind 4?"},
        "9304": {"comment":"Kind 5?"},
        "9307": {"comment":"Kind 6?"},
        "9310": {"comment":"Kind 7?"},
        "9313": {"comment":"C = the byte"},
        "9316": {"comment":"ROM1 routine"},
        "9321": {"synopsis":"Kind 6: the clear of JCLSBL's routine ($06AE) with A = the byte; a 2-byte record.","comment":"A = the byte"},
        "9322": {"comment":"JCLSBL's routine"},
        "9325": {"comment":"2 bytes"},
        "9329": {"synopsis":"Kind 5: the pen: M231NKT = the byte, ATTRT's bits 0-2 from it.","comment":"M231NKT: the pen"},
        "9333": {"comment":"ATTRT"},
        "9336": {"comment":"Ink bits from the byte"},
        "9343": {"synopsis":"Kind 4: GOVERT = the byte.","comment":"The byte"},
        "9345": {"comment":"GOVERT"},
        "9348": {"synopsis":"A 2-byte record.","comment":"2 bytes"},
        "9352": {"synopsis":"Kinds $00 and $FF: stacks dx and dy, each with its sign byte, and draws (DRAW_REL_STACK); a\n4-byte record.","comment":"Fourth byte: dy"},
        "9354": {"comment":"Keep it"},
        "9355": {"comment":"dx with its sign byte"},
        "9357": {"comment":"Stack dx"},
        "9361": {"comment":"dy's sign byte"},
        "9365": {"comment":"Stack dy"},
        "9368": {"comment":"Relative DRAW"},
        "9371": {"synopsis":"A 4-byte record.","comment":"4 bytes"},
        "9373": {"synopsis":"Steps the pointer past the record (on into the next page when it reaches $FFxx: $3FF2),\ncounts the bytes off and loops while any are left; at the end restores GRARF.","comment":"BC = the length"},
        "9375": {"comment":"Record pointer"},
        "9376": {"comment":"Past the record"},
        "9377": {"comment":"Reached $FFxx?"},
        "9379": {"comment":"Then on into the next page"},
        "9382": {"comment":"DE = the pointer"},
        "9383": {"comment":"Count"},
        "9384": {"synopsis":"Takes the record's length off the count; loops while it does not go below 0.","comment":"Take the length off"},
        "9386": {"comment":"More?"},
        "9389": {"comment":"GRARF as it was"},
        "9394": {"synopsis":"The BLITZ command (reached through ROM1's command table at $FD7F): reads a string, returns\nwhen checking syntax, then runs it as recorded graphics commands (BLITZ_STRING).","comment":"String; return if checking syntax"},
        "9397": {"comment":"DE = its start, BC = its length, paged in"},
        "9400": {"synopsis":"JBLITZ's body: runs BC bytes of recorded graphics commands at DE (BLITZ_LOOP), with GRARF\ncleared so nothing is recorded meanwhile.\nEntry: DE = the commands (paged in); BC = their length.\nError: stops with error code 35 for an unknown kind.\nChanges: all."},
        "9402": {"comment":"Set up output ($11D2)"},
        "9407": {"comment":"GRARF"},
        "9411": {"comment":"Keep it"},
        "9413": {"comment":"No recording"},
        "9414": {"comment":"HL = the length"},
        "9416": {"comment":"Count - 1 for the first test"},
        "9421": {"synopsis":"Stops with error code 35 (an unknown graphics record)."},
        "9423": {"synopsis":"JFILL's body: fills from C,B with the 128-byte pattern at DE, or with the pen when DE is 0,\nas FILL_LOAD_PAT; TEMPW1 = HL (the thin-pixel window), TEMPB1 = A.\nEntry: C = x; B = the row; DE = the pattern or 0; HL = the window's first byte for thin\npixels.\nChanges: all.","comment":"TEMPW1: the thin-pixel window"},
        "9426": {"comment":"The point"},
        "9427": {"comment":"B not 0: copy 128 bytes"},
        "9429": {"comment":"TEMPB1"},
        "9434": {"synopsis":"The FILL command (reached through ROM1's command table at $FE1B): an optional token $85 with\na pattern string and a separator, the leading items and x,y, then an optional ,0 or ,1 into\nTEMPB3; returns when checking syntax; modes 3 and 4 only; then fills.\n1. The pattern (or 0 for the pen) stays on the calculator stack; ROM1's $E9C8 fetches the\n   point.\n2. Thin pixels: TEMPW1 = the window's first byte in a row, C = x within it.\n3. FILL_LOAD_PAT.\nError: stops with error code 34 outside modes 3 and 4, 30 for a point off the screen or a\nlast number other than 0 or 1.","comment":"Token $85: a pattern?"},
        "9438": {"comment":"String; return if checking syntax"},
        "9441": {"comment":"Then ; or ,"},
        "9444": {"comment":"Z: skip the 0"},
        "9445": {"synopsis":"No pattern string: stacks 0 when running ($3AFC), then the point.","comment":"No pattern: stack 0 (running)"},
        "9448": {"comment":"Leading items, then x,y"},
        "9451": {"comment":"A last number?"},
        "9455": {"comment":"It; return if checking syntax"},
        "9458": {"comment":"Up to 1, else error 30"},
        "9466": {"synopsis":"No last number: returns when checking syntax; TEMPB3 = 0.","comment":"Return if checking syntax"},
        "9469": {"comment":"No number: 0"},
        "9470": {"synopsis":"TEMPB3 = the last number (0: build the fill map from the start point's colour; otherwise use\nthe map at $E000 as it is), then the mode check and the point.","comment":"TEMPB3"},
        "9473": {"comment":"Modes 3 and 4 only"},
        "9476": {"comment":"The point; carry: thin pixels"},
        "9479": {"comment":"Thin?"},
        "9481": {"comment":"Window start x / 4"},
        "9486": {"comment":"Even byte, a multiple of 8 pixels"},
        "9488": {"comment":"TEMPW1: the window's first byte"},
        "9491": {"comment":"Window start's low 3 bits"},
        "9494": {"comment":"Added to x"},
        "9496": {"synopsis":"Keeps the point and takes the pattern (or 0) off the calculator stack, paged in ($3FDC).","comment":"Keep the point"},
        "9497": {"comment":"DE = the pattern, BC = its length"},
        "9500": {"synopsis":"Fills from C,B: copies the pattern (128 bytes, 16 rows of 8) to $5080, or fills $5080 with\nM231NKT when DE is 0; pages the screen in; builds the fill map unless TEMPB3 is not 0\n(FILL_MAP_AT_PT); runs FLOOD_FILL on a stack at $FEB0, then restores SP and the screen\npaging.\nEntry: the point (C = x, B = the row) on the stack; DE = the pattern or 0; BC = its length\n(B not 0: 128 bytes; 131: a 3-byte header first).\nChanges: all.","comment":"Pattern buffer"},
        "9503": {"comment":"No pattern?"},
        "9507": {"comment":"M231NKT: the pen"},
        "9511": {"comment":"Fill the buffer with it"},
        "9514": {"comment":"127 more"},
        "9519": {"synopsis":"A pattern string of 131 bytes starts 3 bytes in.","comment":"Length under 256?"},
        "9523": {"comment":"131 bytes?"},
        "9528": {"comment":"Skip a 3-byte header"},
        "9531": {"synopsis":"Copies 128 pattern bytes to $5080.","comment":"From the pattern"},
        "9532": {"comment":"128 bytes"},
        "9535": {"synopsis":"The copy (or the pen fill), then the screen in and the fill.","comment":"Copy"},
        "9537": {"comment":"Screen in at $8000"},
        "9540": {"comment":"TEMPB3"},
        "9544": {"comment":"HL = the point"},
        "9546": {"comment":"Build the map from the point's colour"},
        "9549": {"comment":"BC = the point"},
        "9550": {"comment":"TEMPW3: keep SP"},
        "9554": {"comment":"Seed stack below $FEB0"},
        "9557": {"comment":"Fill"},
        "9560": {"comment":"SP back"},
        "9564": {"comment":"Screen out"},
        "9567": {"synopsis":"Fills the area round C,B on the fill map at $E000 (32 bytes a row, a bit a pixel: 1 = border\nor done) and writes the pattern at $5080 to the screen's pixels in it. Seeds (row, x) wait\non the stack, with a row of $FE at the bottom. For each seed: scans left to the run's start,\nthen right, marking the map, writing each pixel and pushing one seed for each new open\nstretch above and below; a whole open map byte with nothing new above or below goes 8 pixels\nat a time (FLOOD_NEXT_BYTE). Mode 4 writes nibbles at $8000 + row x 128 + x / 2; mode 3 thin\npixels from TEMPW1's window.\nEntry: C = x; B = the row; the map built; the screen paged in at $8000.\nChanges: all; TEMPW2.","comment":"Bottom mark: row $FE"},
        "9570": {"comment":"The first seed"},
        "9571": {"synopsis":"Takes the next seed; ends at the $FE mark; skips a row past 191 and a pixel already set on\nthe map; finds the map byte and bit of the seed.","comment":"Next seed: B = row, C = x"},
        "9573": {"comment":"The mark?"},
        "9576": {"comment":"Row past 191?"},
        "9580": {"comment":"L = x"},
        "9581": {"comment":"HL = $E000 + row x 32 + x / 8"},
        "9593": {"comment":"Pixel in the byte"},
        "9598": {"comment":"Bit $80 for pixel 0"},
        "9600": {"synopsis":"Rotates the bit right to the pixel's place in the map byte."},
        "9604": {"comment":"D = the pixel's bit"},
        "9605": {"comment":"Already set on the map?"},
        "9608": {"synopsis":"Moves left while the map pixel is open, into the byte before at a byte's edge, stopping at x\n= 0.","comment":"Map pixel set?"},
        "9611": {"comment":"Bit one left"},
        "9613": {"comment":"x - 1"},
        "9615": {"comment":"Same byte?"},
        "9617": {"comment":"The byte before"},
        "9618": {"comment":"Was x 0?"},
        "9621": {"comment":"x - 1 again"},
        "9624": {"synopsis":"A set pixel on the left: one step back to the right.","comment":"Back to the open pixel"},
        "9625": {"synopsis":"The bit back one place right (and the byte, when it crosses).","comment":"Bit one right"},
        "9627": {"comment":"Same byte?"},
        "9629": {"comment":"The byte after"},
        "9630": {"synopsis":"The run's start: TEMPW2 = IX = its map byte; E = $80 in mode 3, 0 in mode 4 (bit 0: a seed\nabove pending, bit 1: below); C' = the pattern row's offset in $5080, H' = $50.","comment":"TEMPW2: the run's map byte"},
        "9633": {"comment":"IX too, for above and below"},
        "9636": {"comment":"MODE"},
        "9639": {"comment":"Mode 4: flags 0"},
        "9643": {"comment":"Mode 3: bit 7"},
        "9645": {"synopsis":"E = the mode flag; the pattern row for the seed's row into BC', H'.","comment":"E = the flags"},
        "9646": {"comment":"Point into BC'"},
        "9650": {"comment":"Row x 8: its pattern row"},
        "9653": {"comment":"C' = $80 + (row AND 15) x 8"},
        "9656": {"comment":"H' = $50"},
        "9661": {"synopsis":"One pixel right: ends the run past x = 255; at a byte's edge FLOOD_NEXT_BYTE may fill whole\nbytes.","comment":"x + 1"},
        "9662": {"comment":"Past 255: next seed"},
        "9664": {"comment":"Bit one right"},
        "9666": {"comment":"A new byte: whole bytes at once?"},
        "9669": {"synopsis":"Ends the run at a set map pixel; else marks it, writes the pattern's pixel to the screen and\nchecks above and below.","comment":"TEMPW2: the map byte"},
        "9672": {"comment":"Map pixel set?"},
        "9674": {"comment":"Yes: the run ends"},
        "9676": {"comment":"Mark it"},
        "9679": {"comment":"Row"},
        "9681": {"comment":"D' = $80 + row / 2"},
        "9685": {"comment":"x"},
        "9686": {"comment":"Mode 3?"},
        "9689": {"comment":"E' = (row AND 1) x $80 + x / 2"},
        "9690": {"comment":"Mode 3?"},
        "9692": {"comment":"DE' = the screen byte"},
        "9693": {"comment":"Even x: write the high nibble"},
        "9697": {"comment":"Odd x: the low nibble"},
        "9701": {"synopsis":"Mode 3: the screen byte from x / 4 plus TEMPW1, and a mask for the pixel's two bits.","comment":"x / 4 in a row"},
        "9705": {"comment":"E' = the screen byte, in the window"},
        "9706": {"comment":"TEMPW1: the window"},
        "9712": {"comment":"x"},
        "9714": {"comment":"Pixel 0: bits 7-6"},
        "9716": {"comment":"Pixel in the byte"},
        "9720": {"comment":"Pixel 1"},
        "9725": {"comment":"Pixel 2"},
        "9730": {"comment":"Pixel 3"},
        "9732": {"synopsis":"A = the screen byte's offset, for the pattern byte."},
        "9733": {"synopsis":"The pattern byte for the pixel (offset AND 7 in the pattern row) goes into the screen byte\nwhere B is 0.","comment":"Byte in the pattern row"},
        "9736": {"comment":"HL' = the pattern byte"},
        "9737": {"comment":"Screen byte"},
        "9738": {"comment":"Pattern where B is 0"},
        "9741": {"comment":"Write it"},
        "9743": {"comment":"Map byte above"},
        "9746": {"comment":"A seed above pending?"},
        "9750": {"comment":"Above set?"},
        "9753": {"comment":"Seed: the row above"},
        "9756": {"comment":"Pending above"},
        "9760": {"synopsis":"A seed above pending: a set pixel above ends that stretch, so the next open one gets a seed.","comment":"Above set?"},
        "9763": {"comment":"Then a new seed may follow"},
        "9765": {"synopsis":"The map pixel below: an open one starts a stretch with a seed (row + 1) unless one is\npending.","comment":"Map byte below"},
        "9768": {"comment":"A seed below pending?"},
        "9772": {"comment":"Below set?"},
        "9775": {"comment":"Seed: the row below"},
        "9778": {"comment":"Pending below"},
        "9782": {"synopsis":"A seed below pending: a set pixel below ends that stretch.","comment":"Below set?"},
        "9785": {"comment":"Then a new seed may follow"},
        "9787": {"synopsis":"On to the next pixel right."},
        "9790": {"synopsis":"At a map byte's edge: steps TEMPW2 and IX on, and fills the next 8 pixels at once when the\nbyte below and above are all set (no seed pending) or all open (a seed pending), and the\nbyte itself is all open: the map byte becomes $FF and 4 screen bytes (2 in mode 3) come from\nthe pattern; repeats for the bytes after, and drops back to the pixel loop otherwise.\nEntry: C = x of the byte's first pixel; E = the flags.\nChanges: AF, HL, IX, DE', HL'; TEMPW2.","comment":"Next map byte"},
        "9800": {"comment":"Byte below"},
        "9803": {"comment":"A seed below pending?"},
        "9807": {"comment":"All set ($FF)?"},
        "9810": {"comment":"No: pixel by pixel"},
        "9811": {"synopsis":"A seed below pending: only a byte below that is all open goes on.","comment":"All open?"},
        "9813": {"synopsis":"The byte above, the same way by bit 0.","comment":"Byte above"},
        "9816": {"comment":"A seed above pending?"},
        "9820": {"comment":"All set ($FF)?"},
        "9823": {"comment":"No: pixel by pixel"},
        "9824": {"synopsis":"A seed above pending: only a byte above that is all open goes on.","comment":"All open?"},
        "9826": {"synopsis":"The map byte itself must be all open: marks it all set and writes 8 pixels from the pattern.","comment":"This map byte"},
        "9830": {"comment":"Not all open: pixel by pixel"},
        "9832": {"comment":"All 8 done"},
        "9834": {"comment":"Row"},
        "9836": {"comment":"D' = $80 + row / 2"},
        "9840": {"comment":"x"},
        "9842": {"comment":"Mode 3?"},
        "9845": {"comment":"x / 2 with the row's bit 0"},
        "9848": {"comment":"Mode 3: x / 4 in a row"},
        "9853": {"comment":"Plus TEMPW1"},
        "9858": {"comment":"Byte in the pattern row"},
        "9864": {"synopsis":"Mode 4: 4 screen bytes from the pattern row.","comment":"DE' = the screen byte"},
        "9865": {"comment":"Byte in the pattern row"},
        "9869": {"comment":"4 bytes from the pattern"},
        "9877": {"synopsis":"The last 2 bytes (all of them in mode 3)."},
        "9883": {"comment":"x"},
        "9884": {"comment":"Next byte's first x"},
        "9887": {"comment":"Past 255?"},
        "9890": {"comment":"Try the next byte too"},
        "9892": {"synopsis":"Past x = 255: drops the return and takes the next seed.","comment":"Drop the return"},
        "9893": {"comment":"Next seed"},
        "9896": {"synopsis":"Builds the fill map for the colour of the pixel at the start point: reads that pixel (a\nnibble in mode 4, two bits of TEMPW1's window in mode 3), then COLOUR_MAP over the whole\nscreen into $E000 (192 rows of 32 bytes; a bit is 0 where the pixel has that colour).\nEntry: H = the row; L = x; the screen paged in at $8000.\nChanges: all; the alternate BC, DE, HL.","comment":"Bit 15 set for the screen address"},
        "9897": {"comment":"Keep x"},
        "9898": {"comment":"HL = $8000 + row x 128 + x / 2"},
        "9902": {"comment":"MODE"},
        "9905": {"comment":"Mode 4?"},
        "9909": {"comment":"Mode 3: x / 4 in a row"},
        "9915": {"comment":"Plus TEMPW1"},
        "9920": {"comment":"Pixel in the byte"},
        "9923": {"comment":"Turns: pixel + 1"},
        "9925": {"comment":"Screen byte"},
        "9926": {"synopsis":"Rotates the pixel's two bits down to bits 1-0.","comment":"Two bits a pixel"},
        "9932": {"synopsis":"Mode 4: the pixel's nibble into the low nibble.","comment":"Screen byte"},
        "9933": {"comment":"Odd x?"},
        "9937": {"comment":"Even: high nibble down"},
        "9941": {"synopsis":"HL' = $E000 (the map), D' = 192 rows, E' = 32 bytes a row; HL = $8000."},
        "9942": {"comment":"The map"},
        "9945": {"comment":"192 rows, 32 bytes a row"},
        "9949": {"comment":"The screen"},
        "9952": {"synopsis":"Turns screen rows into a bit map against a colour: each map bit is 0 where the pixel has the\ncolour, 1 elsewhere. Mode 4: 4 screen bytes (8 pixels) to a map byte, E' map bytes a row, D'\nrows; mode 3: 2 bytes of the row from TEMPW1's offset (L) to a map byte, skipping 64 bytes\nat each row's end. CELL_PATTERN uses it for one byte a row.\nEntry: A = the colour in the low nibble (two bits in mode 3); HL = the screen; HL' = the\nmap; D' = the rows; E' = the bytes a row.\nExit: HL, HL' past the last row.\nChanges: AF, BC, DE, HL, all alternates.","comment":"D = the colour"},
        "9955": {"comment":"E = it in the high nibble"},
        "9960": {"comment":"MODE"},
        "9963": {"comment":"Mode 4?"},
        "9967": {"comment":"TEMPW1: the window's first byte"},
        "9971": {"comment":"Two bits in mode 3"},
        "9976": {"synopsis":"Mode 3: a row of E' map bytes.","comment":"Map bytes a row"},
        "9977": {"synopsis":"Mode 3: a map byte from 2 screen bytes.","comment":"2 screen bytes a map byte"},
        "9979": {"synopsis":"Mode 3: 4 pixels of a screen byte into the map byte's bits."},
        "9980": {"comment":"Screen byte"},
        "9981": {"comment":"4 pixels"},
        "9983": {"synopsis":"Mode 3: one pixel: a bit 0 when its two bits equal the colour.","comment":"Next pixel's bits"},
        "9987": {"comment":"Equal to the colour?"},
        "9992": {"comment":"Carry in: 1 when equal"},
        "9996": {"comment":"Next screen byte"},
        "9999": {"comment":"Second byte"},
        "10001": {"comment":"Bits 0 where equal"},
        "10002": {"comment":"Map byte"},
        "10004": {"comment":"Row done?"},
        "10008": {"comment":"Past the rest of the 128-byte row"},
        "10013": {"comment":"Next row"},
        "10018": {"synopsis":"Mode 4: the map, E' bytes a row for D' rows.","comment":"Compare value for equal"},
        "10021": {"synopsis":"Mode 4: a row of E' map bytes.","comment":"Map bytes a row"},
        "10022": {"synopsis":"Mode 4: C = 1 as the end marker for 8 bits."},
        "10023": {"comment":"Marker bit"},
        "10024": {"synopsis":"Mode 4: two pixels of a screen byte into the map byte, until the marker comes out.","comment":"Even pixel"},
        "10027": {"comment":"Equal?"},
        "10029": {"comment":"Carry in"},
        "10031": {"comment":"Odd pixel"},
        "10035": {"comment":"Equal?"},
        "10037": {"comment":"Carry in"},
        "10039": {"comment":"Until the marker comes out"},
        "10042": {"comment":"Bits 0 where equal"},
        "10045": {"comment":"Map byte"},
        "10047": {"comment":"Row done?"},
        "10050": {"comment":"Next row"},
        "10055": {"synopsis":"Reads an 8x8 character cell of the mode 3 or 4 screen as a 1-bit pattern (ROM1's JMCHAR code\ncalls it at $F24C): the colour of the cell's first pixel counts as the background, and each\nof the 8 bytes at DE has a bit set where a pixel differs from it (COLOUR_MAP, a byte a row).\nPages ROM1 out and the screen in ($3FA8) and back ($3FBF).\nEntry: HL = the cell's first byte (in the screen paged at $8000); DE = the 8-byte buffer;\ncarry set picks the thin-pixel cell: Z takes the first pixel from bits 7-6, NZ from bits\n3-2.\nExit: the 8 bytes at DE.\nChanges: all.","comment":"Keep the flags"},
        "10056": {"comment":"ROM1 out, screen in"},
        "10060": {"comment":"The buffer"},
        "10061": {"comment":"Thin-pixel cell?"},
        "10063": {"comment":"First byte; Z: bits 7-6"},
        "10066": {"comment":"Bits 3-2 down"},
        "10070": {"synopsis":"Mode 3: the first pixel is bits 7-6; mode 4 the high nibble.","comment":"MODE"},
        "10073": {"comment":"Mode 3?"},
        "10078": {"comment":"Mode 4: high nibble"},
        "10080": {"synopsis":"Rotates the first pixel's bits down to the low end.","comment":"Into the low bits"},
        "10082": {"synopsis":"HL' = the buffer, then CELL_PAT_COLOUR."},
        "10083": {"comment":"HL' = the buffer"},
        "10084": {"comment":"Carry: already paged"},
        "10085": {"synopsis":"JT_0187's body (the rest of CELL_PATTERN): reads 8 screen rows of a cell into 8 pattern\nbytes against the colour A, paging the screen in first when carry is reset.\nEntry: A = the background colour; carry reset to page; HL = the buffer; HL' = the cell's\nfirst byte.\nExit: the 8 bytes; LMPR and HMPR from $5A7A and CURP ($3FBF).\nChanges: all.","comment":"B = the colour"},
        "10086": {"comment":"Page when carry is reset"},
        "10090": {"comment":"8 rows"},
        "10092": {"synopsis":"One row of the cell: TEMPW1 = its address, one map byte from COLOUR_MAP."},
        "10094": {"comment":"1 row of 1 map byte"},
        "10098": {"comment":"Keep the row's address"},
        "10099": {"comment":"TEMPW1 (mode 3 reads L from it)"},
        "10102": {"comment":"The row's pattern byte"},
        "10106": {"comment":"Next screen row (128 bytes on)"},
        "10113": {"synopsis":"On to the next row until 8 are done, then the paging back."},
        "10116": {"comment":"8 rows?"},
        "10118": {"comment":"LMPR and HMPR back"},
        "10121": {"synopsis":"GET_PLOT_COORDS, with a thin-pixel x halved into C.\nEntry: x and y on the calculator stack.\nExit: B = the row; C = x (halved for thin pixels, the lost bit in the carry); carry reset\nfor ordinary pixels.\nError: as GET_PLOT_COORDS.\nChanges: AF, BC, DE, HL.","comment":"The point"},
        "10124": {"comment":"Ordinary pixels: done"},
        "10125": {"comment":"Thin: x / 2"},
        "10129": {"comment":"C = x / 2"},
        "10131": {"synopsis":"Takes a point x,y off the calculator stack as a screen position: applies the scaling\n(SCALE_COORDS), turns y into a row (GET_PLOT_ROW) and checks x: 0-511 for thin pixels\n(THFATT 0), else 0-255. TEMPW2 = x, TEMPB1 = the row (the recorder at $2866 reads them).\nEntry: x and y on the calculator stack.\nExit: B = the row (0 = top); carry reset: C = x; carry set (thin pixels): HL = x.\nError: stops with error code 30 for a point off the screen.\nChanges: AF, BC, DE, HL.","comment":"Scaling"},
        "10134": {"comment":"y into a row"},
        "10137": {"comment":"Keep the row"},
        "10138": {"comment":"x into HL (error 30 if negative)"},
        "10141": {"comment":"TEMPW2 = x"},
        "10144": {"comment":"THFATT"},
        "10148": {"comment":"x's high byte"},
        "10149": {"comment":"B = the row"},
        "10150": {"comment":"Ordinary pixels?"},
        "10152": {"comment":"Thin: x under 512?"},
        "10155": {"synopsis":"Ordinary pixels: x must be under 256, C = x, carry reset.","comment":"C = x"},
        "10156": {"comment":"x under 256?"},
        "10160": {"synopsis":"Takes y off the calculator stack and turns it into a row: 191 - (ORGOFF + y); stores it in\nTEMPB1.\nEntry: y on the calculator stack.\nExit: A = the row; B = ORGOFF + y.\nError: stops with error code 30 off the screen.\nChanges: AF, BC, DE, HL.","comment":"y: C = |y|, Z if positive"},
        "10165": {"comment":"ORGOFF"},
        "10168": {"comment":"Negative y?"},
        "10170": {"comment":"ORGOFF + y"},
        "10173": {"synopsis":"Stops with error code 30 (a coordinate out of range)."},
        "10175": {"synopsis":"A negative y: ORGOFF - |y|, an error below 0.","comment":"ORGOFF - |y|"},
        "10178": {"synopsis":"The row = 191 - (ORGOFF + y); an error below 0.","comment":"B = ORGOFF + y"},
        "10179": {"comment":"Row 191 at the bottom"},
        "10182": {"comment":"Above the top?"},
        "10184": {"comment":"TEMPB1 = the row"},
        "10188": {"synopsis":"Takes dx and dy off the calculator stack as magnitudes and steps for a line: |dy| 0-255,\n|dx| 0-255 (0-511 for thin pixels).\nEntry: dx and dy on the calculator stack.\nExit: B = |dy|; D = the row step ($FF for a positive dy, up; 1 down); E = the x step (1 or\n$FF); carry reset: C = |dx|; carry set (thin pixels): HL = |dx|.\nError: stops with error code 30 for a distance out of range.\nChanges: AF, BC, DE, HL.","comment":"dy: C = |dy|, Z if positive"},
        "10193": {"comment":"Up for a positive dy"},
        "10197": {"comment":"Down"},
        "10199": {"synopsis":"Keeps dy, then dx with its sign as H = 1 or $FF.","comment":"Keep the step and |dy|"},
        "10200": {"comment":"dx: BC = |dx|, Z if positive"},
        "10205": {"comment":"x step right"},
        "10209": {"comment":"Left"},
        "10211": {"synopsis":"D = the row step, B = |dy|, E = the x step; ordinary pixels need |dx| under 256.","comment":"D = row step, E = |dy|"},
        "10212": {"comment":"THFATT"},
        "10216": {"comment":"|dx|'s high byte"},
        "10217": {"comment":"B = |dy|"},
        "10218": {"comment":"E = the x step"},
        "10219": {"comment":"Thin pixels?"},
        "10221": {"comment":"Under 256?"},
        "10225": {"synopsis":"Thin pixels: HL = |dx|, under 512.","comment":"HL = |dx|"},
        "10227": {"comment":"Under 512?"},
        "10232": {"synopsis":"SCALE_COORDS without the offsets, for distances (DRAW_REL_STACK).\nEntry: dx and dy on the calculator stack.\nExit: them scaled.\nChanges: all.","comment":"Carry: no offsets"},
        "10235": {"synopsis":"Applies the graphics scaling to the x,y on the calculator stack, using the values held at\nNVARS + $39, + $43, + $4D and + $57 (5-byte values 10 bytes apart, probably numeric\nvariables BASIC keeps first there): through $2832, y with the first two, x with the last\ntwo; the first of each pair is applied as an offset, the second as a range against the\ndefault (192 for y, 512 for x, 256 when THFATT is not 0). Each step is skipped while its\nvalue holds the default (offsets 0).\nEntry: x and y on the calculator stack.\nExit: them scaled.\nChanges: all.","comment":"Default offset 0"},
        "10238": {"comment":"Carry reset: an offset"},
        "10239": {"comment":"y's offset"},
        "10245": {"synopsis":"Where the entry at $27F8 joins the transformation: scales the y coordinate by yrg next. The\ncarry pushed here says whether x's offset is skipped (set when entered from $27F8, which\napplies no offsets).","comment":"Keep the entry's carry: set means no x offset"},
        "10246": {"comment":"Carry' set: a range follows"},
        "10248": {"comment":"yrg, default 192"},
        "10253": {"comment":"Scale y"},
        "10256": {"comment":"Bring x to the top"},
        "10259": {"comment":"Entered at $27F8?"},
        "10262": {"comment":"BC = 0, the offset's default"},
        "10264": {"comment":"Carry' clear: an offset"},
        "10265": {"comment":"xos"},
        "10267": {"comment":"Add the x offset"},
        "10270": {"comment":"A range follows"},
        "10271": {"synopsis":"Scales x by xrg: the default range is 512, or 256 when THFATT is not 0. Swaps the\ncoordinates back at the end.","comment":"Into carry'"},
        "10272": {"comment":"xrg's default 512"},
        "10275": {"comment":"THFATT"},
        "10278": {"comment":"0?"},
        "10281": {"comment":"Otherwise 256"},
        "10282": {"synopsis":"Scales by xrg with BC the default range just chosen.","comment":"xrg"},
        "10284": {"comment":"Scale x"},
        "10287": {"comment":"Swap the coordinates back and return"},
        "10290": {"synopsis":"Applies one of the graphics variables kept after the 26 letter entries of NVARS to the\nnumber on top of the calculator stack. E selects it: $39 yos, $43 yrg, $4D xos, $57 xrg (the\nnames the ROM stores there, read in a run). A variable still holding its default (BC)\nchanges nothing. Otherwise an offset (carry' clear) is added; a range (carry' set) scales\nthe number by default / variable.\nEntry: E = the value's offset from NVARS; BC = the default as a small integer; carry' = 1\nfor a range.\nExit: the top number transformed; HMPR restored.\nChanges: AF, BC, DE, HL, AF'.","comment":"Keep HMPR"},
        "10293": {"comment":"Page NVARS in, HL = NVARS"},
        "10296": {"comment":"HL = the variable's value"},
        "10299": {"comment":"Keep its address in DE"},
        "10301": {"comment":"Still the default?"},
        "10304": {"comment":"Yes: restore HMPR and return"},
        "10307": {"comment":"Keep the default"},
        "10308": {"comment":"Stack the variable's value"},
        "10313": {"comment":"Restore HMPR"},
        "10316": {"comment":"A range?"},
        "10319": {"comment":"An offset: number + variable, then return"},
        "10322": {"synopsis":"A range: multiplies the number by the default (BC) and divides by the variable.","comment":"Stack the default"},
        "10325": {"comment":"Swap, divide, multiply: number * default / variable"},
        "10330": {"synopsis":"Tests whether the 5-byte number at HL is the small integer BC: the first two bytes 0, then\nC, then B (the fifth byte is not looked at).\nEntry: HL = the number.\nExit: Z if it is BC; HL = its fourth byte when all three tests ran.\nChanges: AF, HL.","comment":"First byte 0"},
        "10332": {"comment":"...and the sign byte 0?"},
        "10333": {"comment":"No: not a small positive integer"},
        "10335": {"comment":"Low byte C?"},
        "10339": {"comment":"High byte B?"},
        "10342": {"synopsis":"Records one graphics action while RECORD is on (GRARF not 0), except inside a PRINT (CURCMD\n= $BB): builds a record at $4F00 from the action code and its operands and sends it to\nstream 16, keeping CURCHL. Callers pass E = 1 after a PLOT ($22BA), 4-7 from other graphics\ncommands.\n1. Codes 1-3 take C and B from TEMPW2 and TEMPB1 (the last coordinates).\n2. Codes 0, $FE and $FF make the signed operands B and C into magnitudes (code $FE/$FF moved\n   up by one, D set to $FF) and store them reordered.\n3. The record is the code and 1-3 operand bytes (3 bytes for codes 1-2, 4 for code 3 and the\n   signed forms, 2 otherwise).\nEntry: E = the action code; C, B, D its operands.\nKeeps: BC, DE, HL.","comment":"GRARF: recording?"},
        "10346": {"comment":"No"},
        "10347": {"comment":"CURCMD"},
        "10350": {"comment":"PRINT? Not recorded here"},
        "10353": {"comment":"Keep the registers"},
        "10356": {"comment":"The action code"},
        "10357": {"comment":"The record buffer"},
        "10360": {"comment":"Code 1-$FD?"},
        "10365": {"comment":"Code 0?"},
        "10368": {"comment":"$FE/$FF: the code moves up by one"},
        "10369": {"comment":"C = -C"},
        "10372": {"synopsis":"Makes B a magnitude unless D is already $FF.","comment":"D = $FF already?"},
        "10375": {"comment":"No: D = $FF and B = -B"},
        "10380": {"synopsis":"Stores the code and the reordered signed operands; four bytes in all.","comment":"Store the code"},
        "10381": {"comment":"Swap B and D"},
        "10384": {"comment":"Record length 4"},
        "10388": {"synopsis":"Codes 1-3 take their operands from TEMPW2 and TEMPB1.","comment":"Code 1-3?"},
        "10392": {"comment":"C = TEMPW2's low byte"},
        "10396": {"comment":"B = TEMPB1"},
        "10400": {"synopsis":"Stores the code byte at $4F00.","comment":"Store the code"},
        "10401": {"synopsis":"Stores C, B and D after the code byte.","comment":"Then C, B, D"},
        "10407": {"comment":"Length: 3 for codes 1-2"},
        "10415": {"comment":"4 for code 3"},
        "10419": {"comment":"2 for the others"},
        "10421": {"synopsis":"Sends the record (C bytes at $4F00) to stream 16 and restores CURCHL.","comment":"Keep CURCHL"},
        "10426": {"comment":"Stream 16"},
        "10432": {"comment":"BC = the length"},
        "10434": {"comment":"Send the record"},
        "10440": {"comment":"Restore CURCHL"},
        "10444": {"comment":"Restore the registers"},
        "10448": {"synopsis":"The GRAB command (token $AB; ROM1's command table reaches it): GRAB string variable, x, y,\nwidth, height. Copies a block of the screen into the string. Modes 3 and 4 only (error 34);\nthe height must be 1-192 (error 30), the width 1-256 pixels.\n1. Finds the string variable (error 29 for a numeric one) and reads the four numbers.\n2. Turns the width into bytes ((width + 1) / 2) and reads the coordinates through $2789.\n3. Grabs the block (GRAB_BLOCK) and assigns the string it describes to the variable.\nError: 29, 30, 34; 36 from $0B3F when the block is too big.","comment":"Find the target variable"},
        "10451": {"comment":"FLAGS bit 6: numeric?"},
        "10456": {"comment":"Numeric: error 29"},
        "10458": {"comment":"A comma next?"},
        "10461": {"synopsis":"Error 29 unless the variable is a string and a comma follows.","comment":"Stops with error code 29"},
        "10464": {"comment":"Read x, y, width and height"},
        "10467": {"comment":"Checking syntax: done"},
        "10470": {"comment":"Modes 3 and 4 only"},
        "10473": {"comment":"Height 1-192, else error 30"},
        "10479": {"comment":"A = the height"},
        "10481": {"comment":"BC = the width"},
        "10484": {"comment":"Width 1-256?"},
        "10487": {"comment":"No: error 30"},
        "10490": {"comment":"Bytes = (width + 1) / 2"},
        "10496": {"comment":"D = height, E = bytes"},
        "10499": {"comment":"Read the coordinates"},
        "10503": {"comment":"Grab the block"},
        "10506": {"comment":"Stack the string"},
        "10509": {"comment":"Assign it to the variable"},
        "10512": {"synopsis":"JGRAB's body: stores a block of the screen as a string at $E000 of the screen's page: a 0,\nthe width in bytes, the height, then the rows. Clips the height at the screen's bottom\n(CLIP_BLOCK_H), has ROM1 $EA23 build an unrolled copy routine of E LDIs at $4D00, and copies\nthe rows through $0B3F, which keeps the size in TEMPW2.\nEntry: C = x (0-255, mode 4 pixels), B = y; E = the width in bytes, D = the height.\nExit: A = the screen page, DE = $E000, BC = the string's length (TEMPW2 + 3); HMPR restored.\nError: 36 (from $0B3F) when the block does not fit below $FFFF.","comment":"Page the screen in"},
        "10515": {"comment":"The block's header at $E000"},
        "10518": {"comment":"0, width, height"},
        "10524": {"comment":"Clip; HL = the screen address"},
        "10527": {"comment":"Build E LDIs at $4D00"},
        "10531": {"comment":"A' = the width"},
        "10533": {"comment":"Copy the rows to $E003"},
        "10536": {"comment":"The string: $E000"},
        "10539": {"comment":"...TEMPW2 + 3 bytes long"},
        "10546": {"comment":"A = the screen page"},
        "10548": {"comment":"Restore HMPR and return"},
        "10551": {"synopsis":"Clips a block's height so that it ends at line 191.\nEntry: B = the top line; D = the height.\nExit: D = the clipped height.\nChanges: AF, D.","comment":"Last line = y + height - 1"},
        "10554": {"comment":"Past 255?"},
        "10556": {"comment":"Within 0-191?"},
        "10559": {"comment":"Lines past the bottom - 1, negated"},
        "10561": {"synopsis":"Takes the lines past the bottom off D.","comment":"...and taken off the height"},
        "10567": {"synopsis":"Prepares a block copy on the mode 3/4 screen (128 bytes a line): clips the height and works\nout the screen address of the top left byte.\nEntry: C = x (0-255, mode 4 pixels), B = y; E = the width in bytes, D = the height.\nExit: HL = $8000 + y * 128 + x / 2; BC = 128; A' = the width; B' = the clipped height.\nChanges: AF, AF', BC, HL, B'.","comment":"A' = the width"},
        "10569": {"comment":"Clip the height"},
        "10572": {"comment":"B' = the clipped height"},
        "10576": {"comment":"HL = (B * 256 + C) / 2 + $8000"},
        "10583": {"comment":"128 bytes a line"},
        "10587": {"synopsis":"The PUT command (token $AC; ROM1's command table reaches it): PUT [colour items;] x, y,\nblock string [, mask string]. Copies the block (a GRAB string) to the screen at $E000 of the\nscreen's page and puts it there through PUT_BLOCK. With a mask, the mask goes to $F000, must\nhave the same width and height (error 38) and the masked mode 5 is used. Otherwise GOVERT (0\ncopy, 1 XOR, 2 OR, 3 AND) chooses the mode, and a plain copy without INVERT or GOVERT uses\nLDIR (mode 4).\nError: 29 when a string is expected; 34 outside modes 3/4; 37 for a string that is not a\nblock; 38.","comment":"Colour items, then x, y"},
        "10590": {"comment":"A comma and a string"},
        "10593": {"comment":"A mask string too?"},
        "10597": {"comment":"Read the mask string"},
        "10600": {"comment":"The mask goes to $F000"},
        "10606": {"comment":"Mode 5: masked"},
        "10610": {"synopsis":"No mask: stops here when checking syntax; mode 0 for now.","comment":"Checking syntax: done"},
        "10613": {"comment":"Mode 0 for now"},
        "10614": {"synopsis":"Copies the block to $E000, reads the coordinates and pages the screen in."},
        "10615": {"comment":"The block goes to $E000"},
        "10621": {"comment":"Read the coordinates"},
        "10624": {"comment":"Page the screen in"},
        "10628": {"comment":"With a mask?"},
        "10631": {"comment":"HL' = the mask's data"},
        "10636": {"comment":"Width and height"},
        "10639": {"comment":"...the same as the mask's?"},
        "10645": {"comment":"Yes"},
        "10647": {"comment":"Stops with error code 38"},
        "10649": {"synopsis":"Chooses the mode from INVERT and GOVERT: 4 when both are 0, else GOVERT AND 3.","comment":"E = INVERT, D = GOVERT"},
        "10653": {"comment":"Both 0?"},
        "10655": {"comment":"Then LDIR (mode 4)"},
        "10659": {"comment":"Else mode GOVERT AND 3"},
        "10662": {"synopsis":"The block's header (width, height) is at $E001.","comment":"The block's width byte"},
        "10667": {"synopsis":"JPUT's body: puts a block on the mode 3/4 screen. Picks the row routine from the table of\n10-byte routines at $29E8 (mode 0 copy, 1 XOR, 2 OR, 3 AND, 4 LDIR, 5 masked) and runs it\nfor each row, with C = INVERT XORed into every byte. Pages the screen in itself.\nEntry: A = the mode (0-5); HL = the block's width byte (width in bytes, then height, then\nthe data); C = x (0-255, mode 4 pixels), B = y; for mode 5 HL' = the mask's data.\nExit: HMPR restored.","comment":"Keep the mode"},
        "10668": {"comment":"Page the screen in"},
        "10672": {"synopsis":"IY = $29E8 + mode * 10; then the rows.","comment":"Mode * 10"},
        "10680": {"comment":"IY = the mode's row routine"},
        "10686": {"comment":"E = width, D = height"},
        "10690": {"comment":"DE will be the data"},
        "10691": {"comment":"Clip; HL = the screen address"},
        "10694": {"comment":"A = 128 - width: the skip to the next line"},
        "10697": {"comment":"Rows return here"},
        "10701": {"comment":"E' = the line skip"},
        "10703": {"comment":"INVERT, kept in A'"},
        "10707": {"comment":"C' = the width"},
        "10708": {"synopsis":"Runs the row routine for B bytes with C = INVERT; it returns through IX.","comment":"B = the width"},
        "10710": {"comment":"C = INVERT"},
        "10712": {"comment":"Copy one row"},
        "10714": {"synopsis":"Where each row routine returns (IX): moves HL to the next screen line and counts the rows in\nB'.","comment":"Keep INVERT in A'"},
        "10716": {"comment":"The line skip"},
        "10719": {"comment":"To the next screen line"},
        "10722": {"comment":"A = the width"},
        "10723": {"comment":"More rows?"},
        "10725": {"comment":"Restore HMPR and return"},
        "10728": {"synopsis":"Mode 0: copies B bytes from DE to HL, XORed with C. Returns through IX.","comment":"Block byte, inverted?"},
        "10730": {"comment":"To the screen"},
        "10735": {"comment":"Back to PUT_NEXT_ROW"},
        "10737": {"synopsis":"A padding byte: keeps the row routines 10 bytes apart."},
        "10738": {"synopsis":"Mode 1: XORs B bytes from DE (XORed with C) onto HL. Returns through IX.","comment":"Block byte, inverted?"},
        "10740": {"comment":"XOR the screen"},
        "10746": {"comment":"Back to PUT_NEXT_ROW"},
        "10748": {"synopsis":"Mode 2: ORs B bytes from DE (XORed with C) onto HL. Returns through IX.","comment":"Block byte, inverted?"},
        "10750": {"comment":"OR the screen"},
        "10756": {"comment":"Back to PUT_NEXT_ROW"},
        "10758": {"synopsis":"Mode 3: ANDs B bytes from DE (XORed with C) onto HL. Returns through IX.","comment":"Block byte, inverted?"},
        "10760": {"comment":"AND the screen"},
        "10766": {"comment":"Back to PUT_NEXT_ROW"},
        "10768": {"synopsis":"Mode 4: copies B bytes from DE to HL with LDIR. Returns through IX.","comment":"HL = the block, DE = the screen"},
        "10769": {"comment":"BC = the width"},
        "10772": {"comment":"Copy the row"},
        "10775": {"comment":"Back to PUT_NEXT_ROW"},
        "10777": {"synopsis":"A padding byte: keeps PUT_ROW_MASK at $29E8 + 50."},
        "10778": {"synopsis":"Mode 5: for B bytes, changes only the screen bits set in the mask (HL' moving along the\nmask) to the block's bits (XORed with C). Returns through IX.","comment":"Block byte, inverted"},
        "10780": {"comment":"XOR screen"},
        "10781": {"comment":"Keep the bits the mask sets"},
        "10783": {"comment":"Next mask byte"},
        "10786": {"comment":"XOR screen again: masked bits from the block"},
        "10791": {"comment":"Back to PUT_NEXT_ROW"},
        "10793": {"synopsis":"Stops with error code 37: the string is not a block."},
        "10795": {"synopsis":"Takes a block string off the calculator stack and copies it to HL in the screen's page\n(CUSCRNP). Modes 3/4 only (error 34). The string must be non-empty, start with 0 and fit\nbelow $10000 from HL (error 37).\nEntry: HL = the destination ($E000 or $F000); the string on the calculator stack.\nError: 34, 37.","comment":"TEMPW1 = the destination"},
        "10798": {"comment":"Modes 3 and 4 only"},
        "10801": {"comment":"Unstack the string, page it in"},
        "10804": {"comment":"Empty?"},
        "10808": {"comment":"A block starts with 0"},
        "10812": {"comment":"Does it fit from the destination?"},
        "10818": {"comment":"Split the length into PAGCOUNT, MODCOUNT"},
        "10821": {"comment":"C = CUSCRNP: to the screen's page"},
        "10825": {"comment":"A = the string's page"},
        "10827": {"comment":"Upwards (LDIR)"},
        "10830": {"synopsis":"JFARLDDR's body: copies downwards between two pages. Turns source and destination addresses\nbelow $C000 into the previous page + $4000 (the copy works in $C000-$FFFF), then joins\nJFARLDIR's code with the carry clear. JFARLDIR itself enters at $2A5E, the $37 (SCF) inside\nthe LD B,$37 at $2A5D: carry set for an upward copy.\nThe copy (both entries): the length is PAGCOUNT 16K pages plus MODCOUNT bytes. It goes\nthrough a 256-byte buffer at $4C00 in chunks (FAR_COPY_BC), paging source and destination in\nturn at HMPR. TEMPW1 and TEMPB2 hold the destination as it moves.\nEntry: A, HL = the source page and address; C, DE = the destination page and address;\nPAGCOUNT, MODCOUNT = the length.\nExit: HMPR and LMPR restored.","comment":"Source below $C000?"},
        "10834": {"comment":"Then the page before, + $4000"},
        "10837": {"synopsis":"The same for the destination in C, DE.","comment":"Destination below $C000?"},
        "10841": {"comment":"Then the page before, + $4000"},
        "10844": {"synopsis":"Carry clear: downwards; the LD B,$37 skips JFARLDIR's SCF.","comment":"Carry clear: downwards"},
        "10845": {"comment":"JFARLDIR enters at $2A5E: its $37 is SCF"},
        "10847": {"comment":"HL = destination, DE = source"},
        "10848": {"comment":"TEMPW1 = the destination address"},
        "10851": {"synopsis":"The far copy's common part: keeps the destination page in TEMPB2 and the direction in\ncarry', saves LMPR and HMPR with ROM1 off, pages the source in and copies PAGCOUNT pages of\n16K, then MODCOUNT bytes.","comment":"H = the source page"},
        "10852": {"comment":"TEMPB2 = the destination page"},
        "10856": {"comment":"Carry' = the direction"},
        "10857": {"comment":"Save HMPR and LMPR, ROM1 out"},
        "10860": {"comment":"Page the source in"},
        "10864": {"comment":"PAGCOUNT: whole 16K pages"},
        "10870": {"synopsis":"Copies one 16K page a pass, PAGCOUNT times.","comment":"Copy one page"},
        "10878": {"comment":"More pages?"},
        "10881": {"synopsis":"Copies the MODCOUNT bytes left and restores LMPR and HMPR.","comment":"MODCOUNT: the bytes left"},
        "10888": {"comment":"Restore LMPR and HMPR"},
        "10891": {"synopsis":"Copies BC bytes (none when BC = 0) from the source (HMPR, DE) to the destination (TEMPB2,\nTEMPW1) in chunks of up to 256 bytes through the buffer at $4C00, moving both across pages.\nWhen INSLV's high byte is not 0 it jumps to INSLV instead (a hook).\nEntry: BC = the length; DE = the source in the paged-in page; carry' = 1 upwards.\nExit: DE = past the source; TEMPB2, TEMPW1 = past the destination.","comment":"Nothing to copy?"},
        "10894": {"synopsis":"Copies BC bytes (not 0) in chunks, unless INSLV takes over.","comment":"INSLV hooked?"},
        "10899": {"comment":"Yes: jump to it"},
        "10902": {"comment":"HL = the bytes left"},
        "10904": {"synopsis":"Takes a 256-byte chunk, or what is left when that is less.","comment":"A 256-byte chunk"},
        "10907": {"comment":"...or fewer when that is all"},
        "10913": {"synopsis":"Copies the chunk from the source into the buffer at $4C00.","comment":"Keep the bytes left and the chunk"},
        "10915": {"comment":"HL = the source"},
        "10916": {"comment":"The buffer at $4C00"},
        "10919": {"comment":"Upwards?"},
        "10923": {"comment":"Downwards: from $4BFF"},
        "10927": {"comment":"Source below $C000?"},
        "10929": {"comment":"Then back a page"},
        "10934": {"synopsis":"Upwards: LDIR into the buffer; moves the source to the next page past $BFFF."},
        "10935": {"comment":"Into the buffer"},
        "10938": {"comment":"Source past $BFFF: next page"},
        "10941": {"synopsis":"Pages the destination in and copies the buffer to it.","comment":"Keep the source and its page"},
        "10945": {"comment":"Page the destination in"},
        "10951": {"comment":"DE = the destination"},
        "10957": {"comment":"From the buffer"},
        "10960": {"comment":"Upwards?"},
        "10963": {"comment":"Downwards: from $4BFF"},
        "10967": {"comment":"Destination below $C000?"},
        "10974": {"synopsis":"Upwards: LDIR to the destination; moves it to the next page past $BFFF."},
        "10975": {"comment":"Out of the buffer"},
        "10978": {"comment":"Destination past $BFFF: next page"},
        "10981": {"synopsis":"Saves the destination, pages the source back and loops while bytes remain.","comment":"Save the destination's page"},
        "10986": {"comment":"...and address"},
        "10991": {"comment":"Page the source back"},
        "10994": {"comment":"DE = the source"},
        "10995": {"comment":"Bytes left - the chunk"},
        "10999": {"comment":"More?"},
        "11002": {"synopsis":"Evaluates the expression at CHAD and, when running, assigns it to the variable found before\n(FIND_DEST). The expression must be of the variable's type (the FLAGS bit 6 kept from the\nsearch), else error 29. Returns after the expression when checking syntax.\nEntry: FLAGS bit 6 = the variable's type; DEST, DESTP, FLAGE set by FIND_DEST.\nError: 29.","comment":"Keep FLAGS (the variable's type)"},
        "11006": {"comment":"Evaluate the expression"},
        "11009": {"comment":"Same type as the variable?"},
        "11017": {"comment":"No: error 29"},
        "11020": {"comment":"Running?"},
        "11023": {"synopsis":"Assigns the value on the calculator stack to the variable found before (ASSIGN_VALUE), then\npages CHAD's page back in.","comment":"Assign"},
        "11026": {"comment":"Page CHAD back in"},
        "11029": {"synopsis":"Replaces the 5-byte number at HL with itself doubled (A = 0) or halved (A not 0); a run gave\n6 -> 12 and 6 -> 3.\nEntry: HL = the number; A selects.\nChanges: AF, BC, DE, HL.","comment":"Keep the address"},
        "11030": {"comment":"Stack the number"},
        "11033": {"comment":"B = the choice"},
        "11034": {"comment":"Times 2 when B = 0, else divided by 2"},
        "11045": {"comment":"DE = the address"},
        "11046": {"comment":"Store the result there"},
        "11048": {"synopsis":"Assigns the number on the calculator stack to the numeric variable whose type byte and name\nare at $513F/$5140, creating it when needed: looks it up (from $13C2), sets the destination\n(SET_DEST) and falls into ASSIGN_VALUE. ROM1 enters at $2B2B with C = the type byte.","comment":"A = the type byte"},
        "11051": {"synopsis":"ASSIGN_NUM_NAMED with C = the type byte; marks the value numeric (FLAGS bit 6)."},
        "11052": {"comment":"FLAGS: numeric"},
        "11057": {"comment":"Look the name up"},
        "11060": {"comment":"Set the destination"},
        "11063": {"synopsis":"Assigns the value on the calculator stack to the destination found by FIND_DEST: a number is\ncopied into an existing variable or makes a new one (NEW_NUM_VAR); a string goes to\nASSIGN_STRING.\nEntry: DEST, DESTP, FLAGE (bit 0: new), STRIL set by FIND_DEST; FLAGS bit 6 = numeric.","comment":"Page DEST in, HL = DEST"},
        "11066": {"comment":"Numeric (FLAGS bit 6)?"},
        "11070": {"comment":"FLAGE"},
        "11073": {"comment":"A string"},
        "11076": {"comment":"DE = the destination"},
        "11077": {"comment":"A new variable?"},
        "11080": {"synopsis":"Moves the top number off the calculator stack to DE.\nEntry: DE = where it goes.\nExit: DE = past it; HL = past the dropped number.\nChanges: AF, BC, DE, HL.","comment":"Drop the number, HL = it"},
        "11083": {"comment":"Copy its 5 bytes"},
        "11089": {"synopsis":"Makes a new numeric variable at NUMEND and links it in: the link at DEST (the letter's entry\nor the last variable's) gets the distance from DEST + 1 to the new variable. When fewer than\n60 bytes are free below SAVARS, makes 512 bytes of room first. Writes the type byte and name\nfrom the copy at $5160, $FFFF as its link, the value from the calculator stack, and moves\nNUMEND past it.","comment":"C = DEST's page"},
        "11095": {"comment":"HL = NUMEND"},
        "11098": {"comment":"Pages between them?"},
        "11104": {"comment":"16K a page"},
        "11107": {"synopsis":"Adds 16K for each page NUMEND is past DEST's page."},
        "11112": {"synopsis":"The link: NUMEND - DEST - 1, kept on the stack.","comment":"Link = NUMEND - DEST - 1"},
        "11116": {"comment":"C = NUMEND's page"},
        "11120": {"comment":"HL = SAVARS"},
        "11123": {"comment":"In NUMEND's page?"},
        "11129": {"comment":"No: 16K on"},
        "11131": {"synopsis":"DE = the free bytes between NUMEND and SAVARS.","comment":"Free = SAVARS - NUMEND"},
        "11138": {"comment":"At least 256 free?"},
        "11142": {"comment":"At least 60?"},
        "11147": {"comment":"No: at SAVARS - 1"},
        "11153": {"comment":"...make 512 bytes of room"},
        "11159": {"comment":"Page DEST in again"},
        "11162": {"synopsis":"Stores the link at DEST and writes the new variable at NUMEND.","comment":"Store the link at DEST"},
        "11166": {"comment":"Page NUMEND in, HL = NUMEND"},
        "11169": {"comment":"The type byte"},
        "11174": {"comment":"Link $FFFF: the last of its letter"},
        "11181": {"comment":"The name after its first letter"},
        "11184": {"comment":"Name length - 1 chars"},
        "11190": {"comment":"Copy them"},
        "11192": {"synopsis":"Writes the value and moves NUMEND past it.","comment":"The value"},
        "11195": {"synopsis":"Stores NUMEND; moves it into the next page when it reached $C000.","comment":"NUMEND = past it"},
        "11199": {"comment":"Reached $C000?"},
        "11202": {"comment":"Back $4000"},
        "11204": {"comment":"...in the next page"},
        "11213": {"synopsis":"Assigns the string on the calculator stack. A new variable (FLAGE bit 0) is made by\nNEW_STRING_VAR; a whole string variable (DESTP bit 7) is replaced (REPLACE_STRING). A slice\nor a string array element keeps its length (STRIL): the string is copied over it, cut or\npadded with spaces.\nEntry: HL = DEST paged in; A = FLAGE shifted right once; BC = STRIL.","comment":"A new variable?"},
        "11217": {"comment":"BC = STRIL, the destination's length"},
        "11221": {"comment":"DESTP bit 7: a whole string variable?"},
        "11227": {"comment":"Nothing to assign to?"},
        "11230": {"comment":"Keep the destination"},
        "11232": {"comment":"Unstack the string: A, DE, BC"},
        "11235": {"comment":"Room - length"},
        "11238": {"comment":"Fits?"},
        "11240": {"comment":"No: copy only the room"},
        "11243": {"comment":"...and pad nothing"},
        "11246": {"synopsis":"Copies the string over the fixed-length destination with the far copy, then pads the rest\nwith spaces.","comment":"Spaces to pad on the stack, HL = destination"},
        "11247": {"comment":"DE = destination, HL = source"},
        "11248": {"comment":"Keep the source page"},
        "11249": {"comment":"The length to PAGCOUNT, MODCOUNT"},
        "11252": {"comment":"C = the destination page"},
        "11256": {"comment":"JFARLDIR: copy the string"},
        "11259": {"comment":"Spaces to pad"},
        "11263": {"comment":"Page in where the copy ended"},
        "11269": {"comment":"HL = there"},
        "11272": {"comment":"C = the 256-byte blocks, B = the rest"},
        "11277": {"comment":"A space"},
        "11279": {"synopsis":"Writes spaces, B at a time, moving to the next page past $BFFF."},
        "11283": {"comment":"More blocks?"},
        "11285": {"comment":"Past $BFFF: next page"},
        "11290": {"synopsis":"The RECORD command (token $EF; ROM1's command table reaches it). RECORD STOP clears GRARF.\nRECORD TO string variable deletes the variable when it exists, keeps its name in STRM16NM,\nsets GRARF and makes the variable again, empty; RECORD_GRAPHIC then records graphics through\nstream 16.\nError: 29 for anything else, a numeric variable or a string array.","comment":"STOP?"},
        "11294": {"comment":"GRARF = 0: recording off"},
        "11298": {"comment":"Past STOP"},
        "11300": {"synopsis":"RECORD TO: reads the variable's name.","comment":"TO?"},
        "11304": {"comment":"Past TO"},
        "11305": {"comment":"Look the variable up"},
        "11308": {"comment":"Numeric: error 29"},
        "11311": {"comment":"Running?"},
        "11313": {"comment":"A string array?"},
        "11316": {"synopsis":"Stops with error code 29."},
        "11318": {"synopsis":"Running: deletes the old variable, keeps the name for stream 16 and makes an empty string\nvariable.","comment":"Found?"},
        "11319": {"comment":"Then delete it"},
        "11322": {"comment":"STRM16NM: stream 16's variable"},
        "11325": {"comment":"Copy the name there"},
        "11328": {"comment":"GRARF = $5B, not 0: recording on"},
        "11332": {"comment":"Copy the name to $5160"},
        "11335": {"comment":"Make the variable, empty"},
        "11337": {"synopsis":"Replaces a whole string variable: makes the new copy (NEW_STRING_VAR), then deletes the old\nvariable, found 14 bytes (its header) before DEST.","comment":"Make the new copy"},
        "11340": {"comment":"Page DEST in"},
        "11343": {"comment":"Back 14 bytes to the old header"},
        "11347": {"comment":"Normalise the address"},
        "11350": {"comment":"Delete the old variable"},
        "11352": {"synopsis":"DELETE_STRVAR with page A paged in first.","comment":"Page the variable in"},
        "11355": {"synopsis":"Deletes the string or array variable at STRLOCN (where the last search found it).\nEntry: STRLOCN = the variable, its page paged in.","comment":"STRLOCN: the variable"},
        "11358": {"synopsis":"Deletes the string or array variable at HL: its 14-byte header (type byte, 10 name bytes,\n3-byte length) and its data.\nEntry: HL = the variable's type byte."},
        "11359": {"comment":"Past the type byte and name"},
        "11363": {"comment":"Its size with the header"},
        "11366": {"comment":"BC = the size"},
        "11369": {"comment":"Reclaim A pages + BC at HL"},
        "11372": {"synopsis":"Reads a 3-byte length (16K pages, then length MOD 16K) and adds 14, the size of the header.\nEntry: HL = the length.\nExit: A = the pages, HL = the rest (A moved up when it reaches $4000).\nChanges: AF, BC, DE, HL.","comment":"Pages"},
        "11374": {"comment":"Length MOD 16K"},
        "11378": {"comment":"Plus the 14-byte header"},
        "11382": {"comment":"Reached $4000?"},
        "11385": {"comment":"Yes: one page more"},
        "11387": {"synopsis":"Makes a new string variable holding the string on the calculator stack: room at the end of\nthe variables (MAKE_NAMED_VAR) with the type byte and name from $5160, the 3-byte length,\nthen the text copied with JFARLDIR. A string lying past WKEND is kept in FIRST/LAST instead\nof XPTR while room is made (probably so that making room moves the pointer with it).\nError: 42 when the length + 14 passes 64K.","comment":"Unstack the string: A, DE, BC"},
        "11390": {"comment":"H = its page"},
        "11393": {"comment":"WKENDP"},
        "11397": {"comment":"Page before WKEND's?"},
        "11403": {"comment":"Same page: address up to WKEND?"},
        "11410": {"synopsis":"The string lies past WKEND: keeps it in FIRST and LAST, A = $FF.","comment":"FIRST = the address"},
        "11414": {"comment":"LAST = the page"},
        "11417": {"comment":"Flag: kept in FIRST/LAST"},
        "11419": {"synopsis":"Keeps the string in XPTR, makes the room and writes the header.","comment":"Keep the flag and the length"},
        "11421": {"comment":"XPTR = the string"},
        "11428": {"comment":"Length + 14 for the header"},
        "11435": {"comment":"Past 64K: error 42"},
        "11438": {"synopsis":"Makes the room: A = its 16K pages, then BC.","comment":"A = 16K pages (bits 15-14)"},
        "11443": {"comment":"Make the room, write type and name"},
        "11446": {"comment":"Write the 3-byte length"},
        "11450": {"comment":"C = the destination page"},
        "11454": {"comment":"Kept in FIRST/LAST?"},
        "11455": {"comment":"No: the source from XPTR"},
        "11463": {"comment":"Yes: from LAST, FIRST"},
        "11469": {"synopsis":"Copies the text into the new variable with JFARLDIR.","comment":"Stores the page at $5AA4"},
        "11472": {"comment":"JFARLDIR: copy the text"},
        "11475": {"synopsis":"Finds the numeric variable that FOR and NEXT work on (both call it). Error 29 for a string\nor an array. A plain numeric variable of the same name is passed over: bit 5 of its type\nbyte is set and the search goes on to the next one, until one with the FOR-NEXT bit (6) is\nfound or there is none. Then goes on as FIND_DEST (SET_DEST).\nError: 29.","comment":"Look the variable up"},
        "11478": {"comment":"A string: error 29"},
        "11481": {"comment":"An array: error 29"},
        "11486": {"comment":"Checking syntax?"},
        "11488": {"comment":"The search's result: found?"},
        "11489": {"synopsis":"Not found, or found with the FOR-NEXT bit: on to SET_DEST."},
        "11491": {"comment":"A FOR-NEXT variable?"},
        "11495": {"comment":"HL = the variable"},
        "11498": {"comment":"Mark the plain one: bit 5"},
        "11502": {"comment":"Search on"},
        "11507": {"synopsis":"Checking syntax: on to SET_DEST.","comment":"The search's flags back"},
        "11510": {"synopsis":"FIND_DEST after moving CHAD on by one.","comment":"Past the current character"},
        "11511": {"synopsis":"Finds the variable named at CHAD that a value will be assigned to (LET, GRAB and others) and\nkeeps where the value goes.\n1. Looks the name up ($13AA). FLAGE = 1 when it does not exist (an array that does not\n   exist: error 2).\n2. For an array element or a slice reads the subscripts (VAR_SUBSCRIPTS).\n3. Keeps STRIL = the length (strings), DEST/DESTP = the value's address and page, $5AB1 = 0\n   when the first four bytes there are 0, $FF, 0, 0 (else not 0), and copies the type byte\n   and name to $5160.\nExit: CHADP paged in.\nError: 2; the subscript errors (4, 30).","comment":"Look the variable up"},
        "11514": {"synopsis":"From the search's result on: FLAGE, the subscripts and the destination.","comment":"DE = the variable"},
        "11515": {"synopsis":"SET_DEST entered with the variable already in DE.","comment":"FLAGE = 0"},
        "11520": {"comment":"Found?"},
        "11522": {"comment":"FLAGE = 1: a new variable"},
        "11523": {"comment":"An array?"},
        "11528": {"synopsis":"Stops with error code 2: the array does not exist.","comment":"An array that does not exist: error 2"},
        "11530": {"synopsis":"The variable exists: strings and arrays read their subscripts.","comment":"A string?"},
        "11537": {"comment":"A numeric array?"},
        "11541": {"synopsis":"Reads the subscripts; a string's place comes off the calculator stack.","comment":"Read the subscripts"},
        "11544": {"comment":"A number?"},
        "11551": {"comment":"A string: unstack its place when running"},
        "11557": {"synopsis":"A simple variable: the value is where the search left it."},
        "11558": {"synopsis":"A = the current page (HMPR AND $1F).","comment":"The variable's page"},
        "11562": {"synopsis":"Stores STRIL, DEST and DESTP and sets $5AB1.","comment":"STRIL = the length"},
        "11566": {"comment":"DEST = the value's address"},
        "11569": {"comment":"DESTP = its page"},
        "11572": {"comment":"First four bytes 0, $FF, 0, 0?"},
        "11581": {"comment":"$5AB1 = 0 then"},
        "11584": {"synopsis":"Copies the type byte and name at $513F to $5160, then pages CHAD's page in.\nChanges: AF, BC, DE, HL.","comment":"To $5160"},
        "11587": {"synopsis":"Copies the type byte and name at $513F (type AND $1F + 2 bytes) to DE, then pages CHAD's\npage in.","comment":"From the type byte at $513F"},
        "11590": {"comment":"Type AND $1F + 2 bytes"},
        "11596": {"synopsis":"Copies C bytes from HL to DE, then pages CHAD's page in."},
        "11598": {"comment":"Copy"},
        "11600": {"comment":"Page CHAD back in"},
        "11603": {"synopsis":"Reads the subscripts after a variable's name. Checking syntax, only parses them: numbers\nseparated by commas for a numeric array, numbers and TO ranges for a string array, then the\nclosing bracket. Running, finds the place they select: a string (simple or whole 1-dimension\narray) is stacked as page, address and length (bit 7 of the page set for a whole simple\nstring), sliced when a bracket follows the name; an array element's address is worked out\n(ARRAY_ELEMENT). $2D54 is entered with HL already swapped.\nEntry: DE = the variable's value or header (its page paged in); C = the type byte (bit 6\nstring array, bit 5 numeric array); carry = running.\nExit: a string: on the calculator stack, FLAGS bit 6 clear; a number: A = its page, HL = its\naddress.\nError: 4 (subscript out of range or missing), 29, 30.","comment":"HL = the variable"},
        "11604": {"synopsis":"VAR_SUBSCRIPTS with the variable already in HL.","comment":"Running?"},
        "11606": {"comment":"A string array?"},
        "11610": {"comment":"Not an array: nothing to read"},
        "11613": {"comment":"Hides RST $20 at $2D5E (used after a comma)"},
        "11615": {"synopsis":"Checks the syntax of a numeric array's subscripts: numbers separated by commas, then ')'.\nThe CP $E7 before it hides the RST $20 at $2D5E, which the loop uses to step over each\ncomma.\nError: 29.","comment":"A number"},
        "11618": {"comment":"Another?"},
        "11622": {"comment":"Then ')'"},
        "11625": {"synopsis":"Checks the syntax of a string array's subscripts: numbers separated by commas, a TO range in\nthe last place, then ')'. Clears FLAGS bit 6 (a string).\nError: 29.","comment":"The current character"},
        "11626": {"comment":"')' at once?"},
        "11630": {"comment":"Hides RST $20 at $2D6F (used after a comma)"},
        "11632": {"comment":"TO?"},
        "11636": {"comment":"A number"},
        "11639": {"comment":"Another?"},
        "11643": {"comment":"TO?"},
        "11647": {"comment":"Then ')'"},
        "11652": {"synopsis":"After TO: an optional number, then ')'.","comment":"Past TO"},
        "11653": {"comment":"')' at once?"},
        "11657": {"comment":"A number, then ')'"},
        "11660": {"comment":"Hides the RST $20 at $2D8D"},
        "11662": {"synopsis":"Done: the result is a string.","comment":"A string result"},
        "11665": {"synopsis":"Running: a simple string is stacked; arrays go on at ARRAY_ELEMENT.","comment":"An array?"},
        "11670": {"comment":"Simple string: its 3-byte length"},
        "11674": {"comment":"Pages into bits 7-6 of B"},
        "11678": {"comment":"H = $80: a whole simple string"},
        "11680": {"synopsis":"Stacks the string at DE + 1 (A pages, length BC; H = $80 for a whole simple string)."},
        "11681": {"comment":"DE = the text"},
        "11682": {"comment":"A = the page"},
        "11684": {"comment":"Past $BFFF?"},
        "11688": {"comment":"Then the next page"},
        "11691": {"synopsis":"Stacks it with the page (and H's bit 7); slices it when '(' followed the name.","comment":"The page, with H's bit 7"},
        "11694": {"comment":"Stack the string"},
        "11697": {"comment":"Page CHAD back in"},
        "11700": {"comment":"'(' after the name?"},
        "11706": {"comment":"Then slice it"},
        "11709": {"synopsis":"Running, an array: B = the number of dimensions. A 1-dimension string array is a\nfixed-length string. Otherwise each subscript is checked against its dimension and the\nelement's number accumulates on the calculator stack (number * dimension + subscript - 1).","comment":"Past the 3-byte length"},
        "11712": {"comment":"B = the dimensions"},
        "11713": {"comment":"A numeric array?"},
        "11717": {"comment":"One dimension?"},
        "11719": {"comment":"Then a fixed string: H = 0"},
        "11721": {"comment":"...BC = its length"},
        "11726": {"synopsis":"A string array of more dimensions needs subscripts (error 4 without).","comment":"Subscripts given?"},
        "11733": {"synopsis":"Starts the element's number at 0 on the calculator stack.","comment":"Keep the array's page"},
        "11739": {"comment":"Element number 0"},
        "11745": {"synopsis":"Reads the next subscript against its dimension and accumulates it.","comment":"Page the array in"},
        "11750": {"comment":"BC = this dimension"},
        "11756": {"comment":"Page CHAD in"},
        "11759": {"comment":"Stack the dimension"},
        "11763": {"comment":"Read the subscript, 1 to BC"},
        "11766": {"synopsis":"Error 4 unless the subscript was in range (carry).","comment":"Out of range: error 4"},
        "11769": {"comment":"Stack subscript - 1"},
        "11772": {"comment":"Number * dimension + subscript - 1"},
        "11777": {"comment":"DE = past this dimension"},
        "11779": {"comment":"The current character"},
        "11780": {"comment":"The last dimension?"},
        "11783": {"comment":"No: a comma must follow"},
        "11787": {"comment":"Past it"},
        "11791": {"synopsis":"After the last subscript: a numeric element's address, or a string array element stacked as\na string (its length the last dimension) and sliced when '(' or ',' follows.","comment":"A numeric array?"},
        "11795": {"comment":"Page the array in"},
        "11798": {"comment":"BC = the element length"},
        "11803": {"comment":"DE = the data"},
        "11805": {"comment":"Its address"},
        "11809": {"comment":"DE = it"},
        "11810": {"comment":"Stack the element as a string"},
        "11813": {"comment":"Page CHAD in"},
        "11816": {"comment":"')'?"},
        "11821": {"comment":"',' starts a slice"},
        "11825": {"synopsis":"Stops with error code 4.","comment":"Stops with error code 4"},
        "11827": {"synopsis":"Past ')': another '(' slices again.","comment":"Past ')'"},
        "11828": {"comment":"'(' again?"},
        "11832": {"synopsis":"Steps over the '(' or ',' before a slice.","comment":"Past '(' or ','"},
        "11833": {"synopsis":"Slices the string on the calculator stack; loops while slices follow.","comment":"Slice"},
        "11838": {"synopsis":"Clears FLAGS bit 6: the result is a string.","comment":"FLAGS bit 6 clear: a string"},
        "11844": {"synopsis":"A numeric array element: ')' then the address of element n (5 bytes each).","comment":"')'?"},
        "11848": {"comment":"Past it"},
        "11849": {"comment":"5 bytes an element"},
        "11852": {"comment":"A = the array's page"},
        "11853": {"comment":"The element's address"},
        "11856": {"comment":"Page it in"},
        "11859": {"synopsis":"Works out an array element's address: base + element number * element size, across pages.\nEntry: A = the base's page, DE = the base; BC = the element size; the element number on the\ncalculator stack.\nExit: A = the page, HL = the address (from $1FDE).","comment":"Keep the base"},
        "11861": {"comment":"Stack the element size"},
        "11864": {"comment":"Number * size"},
        "11867": {"comment":"Split into pages and offset"},
        "11870": {"comment":"The base back"},
        "11872": {"comment":"C = the base's page"},
        "11873": {"comment":"Base past $BFFF?"},
        "11877": {"comment":"Then the next page"},
        "11878": {"synopsis":"Adds the offset (pages A, HL) to the base (C, DE).","comment":"Add them"},
        "11881": {"synopsis":"Slices a string: reads '(from TO to)' with either number optional ('(n)' is one character,\n'()' all), and replaces the string on the calculator stack with the part. A slice past the\nends is an error unless it is empty (TEMPB2, cleared by GET_SUBSCRIPT, tells).\nEntry: CHAD at the first thing after '('; the string on the calculator stack when running.\nExit: CHAD past ')'; FLAGS bit 6 clear.\nError: 4.","comment":"Running?"},
        "11884": {"comment":"Unstack the string: A, DE, BC"},
        "11887": {"comment":"Keep its page"},
        "11888": {"comment":"The current character"},
        "11889": {"comment":"H = the page"},
        "11890": {"comment":"'()': the whole string"},
        "11894": {"comment":"TEMPB2 not 0: no index out of range yet"},
        "11897": {"comment":"Keep the start and page"},
        "11899": {"comment":"Start offset 0"},
        "11902": {"comment":"TO at once?"},
        "11906": {"comment":"Read the start, 1 to the length"},
        "11909": {"comment":"DE = start - 1"},
        "11910": {"comment":"TO?"},
        "11915": {"comment":"')'?"},
        "11917": {"synopsis":"No TO: a ')' must follow; the slice is one character.","comment":"No: error 4"},
        "11919": {"comment":"End = start"},
        "11923": {"synopsis":"After TO: the end defaults to the length.","comment":"Past TO"},
        "11924": {"comment":"')' at once?"},
        "11926": {"comment":"End = length - 1"},
        "11931": {"comment":"Read the end"},
        "11936": {"comment":"In range?"},
        "11938": {"comment":"End 0: an empty slice"},
        "11942": {"synopsis":"A ')' must follow."},
        "11943": {"comment":"')'?"},
        "11949": {"synopsis":"Length = end - start + 1; an empty slice when negative.","comment":"End - start"},
        "11951": {"comment":"Length 0"},
        "11954": {"comment":"...when the end is before the start"},
        "11956": {"comment":"An index out of range?"},
        "11959": {"comment":"Then error 4"},
        "11963": {"comment":"Length = end - start + 1"},
        "11964": {"synopsis":"BC = the slice's length."},
        "11966": {"synopsis":"The slice's address: the string's start + the start offset, across pages.","comment":"A = the page, HL = the string"},
        "11968": {"comment":"+ the start offset"},
        "11969": {"comment":"Carried past $FFFF: normalise"},
        "11972": {"comment":"Past $BFFF?"},
        "11976": {"comment":"Then the next page"},
        "11979": {"synopsis":"H = the slice's page.","comment":"DE = the slice"},
        "11981": {"synopsis":"Marks a string result and, running, stacks the slice.","comment":"FLAGS bit 6 clear: a string"},
        "11989": {"comment":"Checking syntax: done"},
        "11991": {"comment":"Stack the slice"},
        "11995": {"synopsis":"The DIM command (token $C5; ROM1's command table reaches it): DIM array(sizes)[,\narray(sizes)...]. Deletes an array of the same name, then makes the new one at the end of\nthe variables: the type byte and name, the 3-byte length, the number of dimensions, each\ndimension (2 bytes), then the elements filled with spaces (string arrays) or zeros.\nError: 29 for a name that is not an array; 30 when it would pass 32 pages ($3F8C).","comment":"Read the name, look it up"},
        "11998": {"comment":"Keep its page and the search's flags"},
        "12002": {"comment":"Copy the name to $5160"},
        "12006": {"comment":"An array?"},
        "12011": {"comment":"No: error 29"},
        "12014": {"comment":"Running?"},
        "12019": {"comment":"Check the subscripts' syntax"},
        "12022": {"synopsis":"Another array after a comma?","comment":"Another array?"},
        "12025": {"comment":"Past the comma"},
        "12028": {"synopsis":"Running: deletes the old array and works out the size from the dimensions.","comment":"Found before?"},
        "12030": {"comment":"Then delete it"},
        "12033": {"comment":"Page CHAD in"},
        "12037": {"comment":"A numeric array?"},
        "12039": {"comment":"1 byte a character"},
        "12044": {"comment":"...5 a number"},
        "12046": {"synopsis":"Reads the dimensions, multiplying the size (1 a character, 5 a number) by each; the CP $E7\nhides the RST $20 at $2F12, used to step over each comma.","comment":"Stack the size"},
        "12049": {"comment":"Hides the RST $20 at $2F12 (used after a comma)"},
        "12051": {"comment":"Read a dimension"},
        "12054": {"comment":"HL = the dimension"},
        "12055": {"comment":"Keep it"},
        "12057": {"comment":"Size * dimension"},
        "12064": {"comment":"Count the dimensions"},
        "12065": {"comment":"Another?"},
        "12070": {"comment":"Then ')'"},
        "12073": {"comment":"B = dimensions, C = element size"},
        "12074": {"comment":"Header = 2 * dimensions + 1"},
        "12079": {"comment":"Size + header, and + 14"},
        "12092": {"comment":"Pages and rest of the total"},
        "12095": {"comment":"Make room, write the name"},
        "12099": {"comment":"Pages and rest of the length"},
        "12104": {"comment":"The 3-byte length"},
        "12110": {"comment":"The number of dimensions"},
        "12112": {"comment":"HL = the last dimension's high byte"},
        "12117": {"comment":"DE = the end of the dimensions"},
        "12119": {"synopsis":"Stores the dimensions, last first, from the stack.","comment":"A dimension, last first"},
        "12124": {"comment":"More?"},
        "12127": {"comment":"The elements' size: pages and rest"},
        "12131": {"comment":"As a 19-bit count"},
        "12135": {"comment":"HL = the first element"},
        "12137": {"comment":"B = the low byte, DE = the 256-blocks"},
        "12140": {"comment":"Low byte 0?"},
        "12144": {"comment":"No: one block more"},
        "12145": {"synopsis":"Fills the elements: spaces for a string array, zeros for a numeric one.","comment":"A string array?"},
        "12150": {"comment":"Space"},
        "12154": {"comment":"Else 0"},
        "12155": {"synopsis":"Fills B bytes; moves to the next page past $BFFF.","comment":"Past $BFFF: next page"},
        "12158": {"synopsis":"Writes the fill byte.","comment":"Fill"},
        "12162": {"comment":"More blocks?"},
        "12167": {"comment":"Page CHAD in"},
        "12171": {"comment":"Another array?"},
        "12174": {"synopsis":"Makes room for a new string or array variable just before ELINE - 1 (the end of the\nvariables) and writes its type byte and 10 name bytes from $5160.\nEntry: A = 16K pages, BC = the rest of the size.\nExit: DE = where the 3-byte length goes.\nChanges: AF, BC, DE, HL.","comment":"Keep the pages"},
        "12175": {"comment":"HL = ELINE - 1"},
        "12179": {"comment":"Make A pages + BC of room there"},
        "12182": {"comment":"DE = the room"},
        "12183": {"comment":"The type byte and 10 name bytes"},
        "12192": {"synopsis":"Reads a number at CHAD as a subscript and checks it is 1 to BC. Checking syntax, returns\nafter the number.\nEntry: BC = the limit.\nExit: running: carry set if in range, HL = the number - 1 (0 for 0); out of range: carry\nclear and TEMPB2 = 0.\nError: 29, 30 (not 0-65535).","comment":"Keep the limit"},
        "12193": {"comment":"Read a number"},
        "12196": {"comment":"Running?"},
        "12200": {"synopsis":"Running: HL = the number; is it 1 to BC?","comment":"HL = the number"},
        "12203": {"comment":"The limit"},
        "12204": {"comment":"0?"},
        "12207": {"comment":"Number - 1 below the limit?"},
        "12211": {"comment":"Yes: in range"},
        "12212": {"synopsis":"Out of range: TEMPB2 = 0, carry clear.","comment":"TEMPB2 = 0: out of range"},
        "12217": {"synopsis":"A pass over the program (or the edit line while COMPFLG bit 7 is clear, $3019) for the names\nthat carry a marker byte after them. When REFFLG is not 0, first lists the DEF FN statements\n(LIST_DEF_FNS) and handles the $FE-marked names (FN references, matched against that list at\n$30AA). Then handles each $FD-marked name at $30CC (which searches with DEF PROC, token $CA;\nso probably the procedure references). $2FBF is entered with the carry deciding about the\nDEF FN part.\nExit: carry set.","comment":"REFFLG"},
        "12220": {"comment":"Carry when not 0"},
        "12223": {"synopsis":"LINK_FN_PROC with carry set: the DEF FN part runs.","comment":"Then list the DEF FNs first"},
        "12226": {"comment":"Where to search"},
        "12229": {"synopsis":"Finds the next $FD-marked name ($304C) and handles it ($30CC).","comment":"The $FD marker"},
        "12231": {"comment":"Find the next one"},
        "12234": {"comment":"None left"},
        "12236": {"comment":"Handle it"},
        "12242": {"synopsis":"Lists the DEF FN statements (token $C8) of the program at $4F00: page, then address, 3 bytes\neach, TEMPW1 the end; then handles the $FE-marked names ($3009 on). Returns at once for an\nempty program.\nError: 52 when the list reaches $50FD.","comment":"The list at $4F00"},
        "12245": {"comment":"TEMPW1 = its end"},
        "12248": {"comment":"Page PROG in, HL = PROG"},
        "12251": {"comment":"No program ($FF)?"},
        "12254": {"comment":"Past the line number and length"},
        "12257": {"synopsis":"Finds the next DEF FN statement from HL and adds it to the list."},
        "12258": {"comment":"CHAD = there"},
        "12261": {"comment":"DEF FN"},
        "12263": {"comment":"Find the next statement starting with it"},
        "12266": {"comment":"None: on to the $FE names"},
        "12268": {"comment":"DE = its place"},
        "12270": {"comment":"The list's end"},
        "12273": {"comment":"Full ($50FD)?"},
        "12281": {"comment":"Store the page"},
        "12285": {"comment":"...and the address"},
        "12288": {"comment":"Past the stored address"},
        "12289": {"comment":"TEMPW1: the table's new end"},
        "12292": {"comment":"Back to the statement position"},
        "12293": {"comment":"Look for the next DEF FN"},
        "12295": {"synopsis":"Stops with error code 52. Reached when the DEF FN address table at $4F00 is full (the scan\nbefore\nit, and ROM1 $C4D8).\nError: always (code 52).","comment":"Stops with error code 52"},
        "12297": {"synopsis":"Reached when the DEF FN scan has listed every DEF FN in the table at $4F00: fills in each FN\nreference's hidden pointer. Sets up the search area (FIND_AREA_SETUP) and visits every\nhidden number marked $FE $FE (FIND_REF_MARKER), resolving each with FN_RESOLVE_ONE.\nExit: carry, when the area is searched.","comment":"HL, BC, B': the program or the edit line"},
        "12300": {"synopsis":"Finds the next FN reference marker ($FE $FE) and resolves it; returns at the area's end.","comment":"Marker byte for an FN reference"},
        "12305": {"comment":"Area searched?"},
        "12307": {"comment":"Point the reference at its DEF FN"},
        "12311": {"comment":"Next reference"},
        "12313": {"synopsis":"Sets up a byte search over the program (COMPFLG bit 7 set: PROG to NVARS) or over the edit\nline (clear: ELINE to WORKSP), for FIND_REF_MARKER.\nExit: HL = the area's start, its page in HMPR; BC = the length mod 8K (the first pass);\nB' = the 8K passes to make + 1.\nChanges: AF, BC, DE, HL, B'.","comment":"COMPFLG: bit 7 picks the program"},
        "12319": {"comment":"A:HL = ELINE"},
        "12322": {"comment":"Keep the start"},
        "12323": {"comment":"C:DE = the start"},
        "12325": {"comment":"WORKSP: the area's end"},
        "12331": {"comment":"Length from the end and the start"},
        "12333": {"synopsis":"The program case: the area runs from PROG to NVARS.","comment":"A:HL = PROG"},
        "12339": {"comment":"NVARS: the area's end"},
        "12345": {"synopsis":"Turns the area's ends into a pass count in B' and a first-pass count in BC; the start in HL.","comment":"A:HL = the length between them"},
        "12348": {"comment":"Three shifts move the page count into A"},
        "12353": {"comment":"B' = the passes: pages + 1"},
        "12358": {"comment":"BC = the length mod 8K"},
        "12362": {"comment":"HL = the area's start"},
        "12364": {"synopsis":"Finds the next PROC or FN reference marker in the area FIND_AREA_SETUP set up: a hidden\nnumber\n$0E, D, D, then a byte with bit 7 set (and not $0E $0E before it, which would be a number's\nown bytes). Copies the name before the marker to $5140 (a length byte, then the name).\nWith D = $FE (FN), a $FF byte before the name also drops the name's first byte.\nEntry: D = the marker byte ($FD PROC call, $FE FN); HL, BC, B' from FIND_AREA_SETUP or the\nlast call.\nExit: NC: found, HL = the marker's second byte, BC and B' to go on; carry: the area is\nsearched.\nChanges: AF, DE, HL, BC, B', $5140-$5160.","comment":"Bytes left in this pass?"},
        "12368": {"comment":"Search for the marker byte"},
        "12371": {"comment":"None in this pass"},
        "12373": {"comment":"Followed by a second marker byte?"},
        "12376": {"comment":"Back to the byte before the first"},
        "12378": {"comment":"A number's $0E before it?"},
        "12383": {"comment":"No: on past this pair"},
        "12387": {"synopsis":"A $0E precedes the pair: rejects it when a second $0E precedes that, and when the byte\nafter the pair has bit 7 clear.","comment":"$0E twice: number data, not a marker"},
        "12389": {"comment":"HL on the second marker byte"},
        "12394": {"comment":"Bit 7 of the third byte set?"},
        "12400": {"comment":"A marker: keep its position and count"},
        "12402": {"comment":"Back past the $0E"},
        "12404": {"comment":"C counts the name's characters"},
        "12407": {"synopsis":"Steps back over the name before the marker: '$', letters, digits and '_'."},
        "12410": {"comment":"A '$' belongs to the name"},
        "12414": {"comment":"Letter, digit or '_'?"},
        "12419": {"comment":"$FF before the name?"},
        "12422": {"comment":"Only for an FN reference "},
        "12427": {"comment":"... the first name byte goes too"},
        "12429": {"synopsis":"Copies the name (1-32 bytes) after a length byte to $5140, and returns NC with HL on the\nmarker's second byte.","comment":"HL = the name's first byte"},
        "12430": {"comment":"$5140: length, then the name"},
        "12433": {"comment":"Length 1-32"},
        "12441": {"comment":"Copy the name"},
        "12443": {"comment":"Restore the count and the marker's position"},
        "12446": {"synopsis":"The pass is done: goes on in the next page while passes remain; carry when none do.","comment":"The next pass: BC = 8K"},
        "12448": {"comment":"Past the page's end: the next page"},
        "12451": {"comment":"One pass fewer"},
        "12454": {"comment":"Passes left: search on"},
        "12456": {"comment":"Carry: no more markers"},
        "12458": {"synopsis":"Looks the name at $5140 up in the DEF FN address table ($4F00 to TEMPW1: page, then address,\nfor each DEF FN) and stores the found definition's address in the marker's last three bytes\n(page + $80, then the address after the name in the DEF FN); $FF there when no DEF FN has\nthe name.\nEntry: HL = the marker's second byte (FIND_REF_MARKER).\nExit: the marker filled; HL kept; HMPR restored.\nChanges: AF, BC, DE.","comment":"Keep the marker's position"},
        "12459": {"comment":"Keep HMPR"},
        "12462": {"comment":"The DEF FN table's start"},
        "12465": {"synopsis":"Compares the name with the next DEF FN in the table; stops at the table's end (TEMPW1).","comment":"TEMPW1: the table's end"},
        "12472": {"comment":"End of the table: not found"},
        "12475": {"comment":"An entry: page, then address"},
        "12481": {"comment":"HMPR: the DEF FN's page"},
        "12484": {"comment":"Same name as $5140?"},
        "12488": {"comment":"No: the next entry"},
        "12490": {"comment":"Yes: DE is past the name"},
        "12492": {"synopsis":"Looks the name at $5140 up among the program's DEF PROC lines and stores the found line's\naddress in the marker's last three bytes (page + $80, then the line's start); $FF there\nwhen no DEF PROC has the name.\nEntry: HL = the marker's second byte (FIND_REF_MARKER).\nExit: the marker filled; HL kept; HMPR restored.\nChanges: AF, BC, DE, CHAD.","comment":"Keep the marker's position"},
        "12493": {"comment":"Keep HMPR"},
        "12496": {"comment":"A:HL = PROG, the first line"},
        "12499": {"comment":"Skips ADD HL,DE: a jump to $30D4 adds it"},
        "12501": {"comment":"Lines starting with DEF PROC ($CA)"},
        "12504": {"comment":"Find the next one"},
        "12507": {"comment":"None: not found"},
        "12509": {"comment":"Keep the line length and the token's position"},
        "12511": {"comment":"CHAD: the DEF PROC token"},
        "12515": {"comment":"Same name as $5140?"},
        "12520": {"comment":"No: on from the next line ($30D4)"},
        "12522": {"comment":"Back to the line's start"},
        "12526": {"comment":"DE = the line's start"},
        "12527": {"synopsis":"Writes the marker's page byte (B: the found page + $80, or $FF), then DE as its address,\nafter restoring HMPR. Common end of FN_RESOLVE_ONE and PROC_RESOLVE_ONE.","comment":"Found: page + $80"},
        "12535": {"comment":"Skipped: the not-found entry at $30F8 loads B = $FF"},
        "12538": {"comment":"Restore HMPR"},
        "12541": {"comment":"The marker's second byte"},
        "12543": {"comment":"Page byte"},
        "12545": {"comment":"Then the address"},
        "12551": {"synopsis":"Compares the name at HL with the one held at $513F: a type/length byte (length - 1 in bits\n4-0), then the name from $5140. Falls into NAME_CMP_TYPED. No caller was found in either\npage.\nEntry: HL = the name's first byte.\nExit: as NAME_CMP_TYPED.","comment":"The name buffer's type byte"},
        "12554": {"synopsis":"Compares the name at HL with a name record at DE: a type/length byte (length - 1 in bits\n4-0), then the name. Spaces in the text are skipped; letters match in either case.\nEntry: DE = the record ($1BBF passes $5160); HL = the text's first byte.\nExit: NC: the same name, and no letter, digit or '_' follows it; carry: different.\nDE past the compared text.\nChanges: AF, B, DE, HL.","comment":"DE = the text, HL = the record"},
        "12555": {"comment":"Length - 1 "},
        "12559": {"comment":"... + 1 characters"},
        "12560": {"comment":"The record's name"},
        "12561": {"comment":"Compare from the text's first byte"},
        "12563": {"synopsis":"Compares the name in the program after DE with the one at $5140 (a length byte, then the\nname, as FIND_REF_MARKER left it). Spaces in the text are skipped; letters match in\neither case.\nEntry: DE = the byte before the name.\nExit: NC: the same name, and no letter, digit or '_' follows it; carry: different.\nDE on the byte after the name.\nChanges: AF, B, DE, HL.","comment":"$5140: the length, then the name"},
        "12568": {"synopsis":"Steps to the text's next byte, skipping spaces, and compares it with the record's next."},
        "12569": {"synopsis":"Compares the text byte at DE (spaces skipped) with the next name byte, either case."},
        "12570": {"comment":"Skip spaces"},
        "12574": {"comment":"Same letter, either case?"},
        "12578": {"comment":"Carry: different"},
        "12580": {"comment":"Next character"},
        "12582": {"comment":"The byte after the name "},
        "12584": {"comment":"... must not go on with the name"},
        "12587": {"synopsis":"Evaluates an FN call: the FN function's handler, reached through the word at $16B3 in the\nfunction table. In a syntax check it goes to FN_SYNTAX. When running it follows the call's\nhidden pointer to its DEF FN, evaluates each argument and stores it in the hidden 5-byte\nslot after that parameter's name in the DEF FN, then evaluates the expression after the\nDEF FN's '=' with DEFADD pointing at the parameter list (FN_PARAM_LOOKUP reads it).\nEntry: CHAD on the FN token.\nExit: the result on the calculator stack; a string result goes on at $1594; Z/NZ\nas the body's type.\nError: 7 when the FN has no DEF FN; 26 when the arguments do not match the parameters.","comment":"Running? (FLAGS bit 7)"},
        "12590": {"comment":"No: check the syntax"},
        "12593": {"comment":"Past FN's token"},
        "12596": {"synopsis":"Steps forward to the call's hidden number ($0E after the name)."},
        "12600": {"comment":"The pointer's page byte"},
        "12603": {"comment":"Bit 5 set: $FD or $FF, no definition"},
        "12607": {"comment":"DE = the definition: after its name"},
        "12611": {"comment":"CHAD on the marker's last byte"},
        "12614": {"comment":"The byte after the marker"},
        "12615": {"comment":"An argument list?"},
        "12619": {"comment":"The first byte inside it"},
        "12622": {"comment":"Empty: '()'?"},
        "12626": {"comment":"Past the '()'"},
        "12628": {"synopsis":"Sets Z: the call has an argument list (or an empty '()')."},
        "12629": {"synopsis":"Keeps the call's Z/NZ (arguments or none) in F' and moves to the DEF FN's text.","comment":"F' = the call has arguments?"},
        "12630": {"comment":"HL = the definition"},
        "12631": {"comment":"Its page"},
        "12635": {"comment":"'=' straight after the name?"},
        "12638": {"comment":"No: a parameter list"},
        "12640": {"comment":"A = 0: no parameters"},
        "12641": {"comment":"The call had no arguments either?"},
        "12642": {"comment":"Yes: evaluate"},
        "12644": {"synopsis":"Stops with error code 26: the FN call's arguments do not match the DEF FN's parameters.\nError: always (code 26).","comment":"Stops with error code 26"},
        "12646": {"synopsis":"Stops with error code 7: the FN call's hidden pointer holds no DEF FN.\nError: always (code 7).","comment":"Stops with error code 7"},
        "12648": {"synopsis":"The DEF FN has a parameter list: the call must have arguments; an empty list goes straight\nto the body.","comment":"The call had arguments?"},
        "12651": {"comment":"The first parameter"},
        "12654": {"comment":"An empty list?"},
        "12657": {"comment":"Yes: find the '='"},
        "12660": {"comment":"Keep the definition's position"},
        "12661": {"synopsis":"Finds the next parameter's hidden slot in the DEF FN, evaluates the next argument and\nchecks its type against the parameter's ('$' before the slot: a string).","comment":"Find the parameter's slot ($0E)"},
        "12667": {"comment":"Keep the definition's page"},
        "12670": {"comment":"The name's last byte: '$'?"},
        "12672": {"comment":"A = 1 for a string parameter"},
        "12674": {"comment":"HL = the slot's first byte"},
        "12678": {"comment":"Back to the call's page"},
        "12681": {"comment":"Evaluate the argument: Z for a string"},
        "12684": {"comment":"DE = the slot"},
        "12685": {"comment":"B = 1 for a string parameter"},
        "12686": {"comment":"A string argument?"},
        "12688": {"comment":"Numeric: needs B > 1"},
        "12690": {"synopsis":"A string argument: the parameter must be a string (B = 1), else error 26."},
        "12692": {"synopsis":"The argument's type matches: steps past a ')' in the call, keeping the separator in A'.","comment":"The call's ')'?"},
        "12696": {"comment":"Skip it, keeping the flags"},
        "12699": {"synopsis":"Copies the argument's 5 bytes from the calculator stack into the parameter's slot and\nchecks that the call and the DEF FN go on alike (',' or ')')."},
        "12700": {"comment":"Back to the definition's page"},
        "12703": {"comment":"Take the argument off the stack"},
        "12706": {"comment":"Into the parameter's slot"},
        "12711": {"comment":"The byte after the slot"},
        "12712": {"comment":"Skip spaces"},
        "12716": {"comment":"Same separator as the call's?"},
        "12720": {"comment":"',': the next parameter"},
        "12724": {"comment":"Must be ')'"},
        "12728": {"synopsis":"Steps to the DEF FN's '=', before its expression."},
        "12734": {"comment":"Skipped: the A' flags stay"},
        "12737": {"synopsis":"Evaluates the DEF FN's expression: saves CHAD and DEFADD, points DEFADD at the\nparameter list (at the stacked word) and CHAD at the '=', evaluates, then restores both.","comment":"Save the call's CHAD "},
        "12741": {"comment":"... its page "},
        "12745": {"comment":"... and DEFADDP"},
        "12749": {"comment":"CHAD on the '='"},
        "12752": {"comment":"DEFADD = the parameter list"},
        "12759": {"comment":"Both on the definition's page"},
        "12769": {"comment":"Evaluate the expression after '='"},
        "12776": {"comment":"Restore DEFADDP"},
        "12780": {"comment":"The call's page, keeping the type flags"},
        "12782": {"comment":"Restore CHADP, ROM1 out"},
        "12786": {"comment":"Restore CHAD"},
        "12790": {"comment":"Restore DEFADD"},
        "12794": {"synopsis":"Returns for a numeric result (NZ); a string result goes on at $1594."},
        "12795": {"comment":"A string: drop the return address"},
        "12799": {"synopsis":"Checks an FN call's syntax and inserts its hidden reference marker ($0E $FE $FE $FE and\ntwo bytes) after the name, then checks the argument list.\nEntry: CHAD on the FN token.\nExit: NZ for a numeric FN; a string FN goes on at $1594.\nChanges: IFTYPE (the name's first byte).","comment":"The name's first byte"},
        "12800": {"comment":"IFTYPE: kept there"},
        "12803": {"comment":"Past the name: A = 1 for a string"},
        "12806": {"comment":"Keep the type"},
        "12807": {"comment":"Insert the FN marker"},
        "12812": {"comment":"An argument list?"},
        "12816": {"comment":"An empty one?"},
        "12821": {"synopsis":"Checks the next argument's expression; ',' goes on, ')' ends.","comment":"Check an expression"},
        "12824": {"comment":"The byte after it"},
        "12829": {"comment":"Must be ','"},
        "12834": {"synopsis":"Steps past the closing ')'."},
        "12835": {"synopsis":"Sets Z for a string FN and returns through FN_RESULT."},
        "12836": {"comment":"Z: a string FN"},
        "12839": {"synopsis":"Checks a name at CHAD and steps past it, its letters, digits and '_' and a '$'.\nEntry: CHAD on the name's first byte (a letter, else an error at $3AEC).\nExit: HL past the name; A = 1 for a string ('$'), otherwise the byte after the name - $23.\nChanges: AF, HL.","comment":"Must start with a letter"},
        "12842": {"synopsis":"Steps past the name's letters, digits and '_'."},
        "12849": {"comment":"A '$' after it?"},
        "12853": {"comment":"Past the '$'"},
        "12854": {"synopsis":"Returns A = 1 for a string name."},
        "12856": {"synopsis":"LOCAL: the command table's entry for token $D2 (ROM1 $FDE9). In a syntax check it checks a\nlist of names (PARAM_LIST_LOOP). When running it binds the names as new variables like a\nprocedure's parameters, with an empty argument list: PRPTR points at $0450, a $0D in\nROM0. The records go into the procedure's frame on the BASIC stack.\nError: 12 when no procedure is running (PROC_FRAME_CHECK); 41 when the BASIC stack is\nfull.","comment":"Running?"},
        "12859": {"comment":"No list keyword to skip in a check"},
        "12863": {"comment":"PRPTRP = 0 "},
        "12867": {"comment":"... PRPTR = $0450: a $0D, no arguments"},
        "12873": {"comment":"The names follow CHAD"},
        "12876": {"comment":"DPPTRP, DPPTR: the names"},
        "12882": {"comment":"A procedure frame on top?"},
        "12885": {"comment":"Keep the frame's type and entry"},
        "12888": {"comment":"Bind the names"},
        "12891": {"comment":"CHAD back to the statement"},
        "12894": {"comment":"The frame's type byte, below the records"},
        "12903": {"comment":"Put the frame back on top"},
        "12905": {"comment":"Store it and BSTKEND"},
        "12908": {"synopsis":"DEF PROC: the command table's entry for token $CA (ROM1 $FDD9). When running, skips past the\nmatching END PROC ($0D47 with token $CB, error 13 if none). In a syntax check, checks the\nname and then DATA, or a parameter list (names, REF before a name, commas).","comment":"Running?"},
        "12913": {"comment":"Yes: drop the return address"},
        "12914": {"comment":"Find the END PROC token $CB"},
        "12917": {"comment":"The byte after: its error code"},
        "12920": {"synopsis":"Error code 13 for the CALL $0D47 before it: $0D47 jumps to the RST $08 entry with this\nbyte's address as the return address when it finds no END PROC."},
        "12921": {"synopsis":"Checks DEF PROC's syntax: a name, then DATA or a parameter list."},
        "12922": {"comment":"Must start with a letter"},
        "12925": {"synopsis":"Steps past the procedure's name."},
        "12932": {"comment":"CHAD past the name"},
        "12936": {"comment":"DATA ($B9) after it?"},
        "12940": {"comment":"Past DATA: done"},
        "12942": {"synopsis":"Ends at the statement's end; otherwise checks the parameter list with REF ($CE) allowed.","comment":"No parameters?"},
        "12946": {"comment":"REF allowed before a name"},
        "12948": {"synopsis":"Checks one item of a name list: an optional keyword D (REF; $20 for LOCAL, never one),\nthen a name or 'name()'; ',' goes on, the statement's end stops.","comment":"The keyword?"},
        "12951": {"comment":"Skip it"},
        "12952": {"synopsis":"Checks a name, or a name with '()', in a name list."},
        "12953": {"comment":"A name with '()'?"},
        "12956": {"comment":"No: check the variable's name"},
        "12959": {"comment":"The statement's end?"},
        "12964": {"comment":"Must be ','"},
        "12969": {"synopsis":"Measures the name at CHAD without moving CHAD: letters, digits and '_', then a '$'.\nEntry: CHAD on the name.\nExit: NC: not a letter, or longer than 10 characters; carry: a name of 1-10. HL past\nthe name ('$' included); A = the byte there.\nChanges: AF, BC, HL."},
        "12970": {"comment":"Starts with a letter?"},
        "12974": {"comment":"Keep CHAD's position"},
        "12975": {"comment":"B = 11, C counts"},
        "12978": {"synopsis":"Counts the name's letters, digits and '_'."},
        "12985": {"comment":"A '$' after it?"},
        "12990": {"synopsis":"Sets carry for a length under 11 and puts CHAD back.","comment":"Carry: 10 characters or fewer"},
        "12992": {"comment":"CHAD back to the start"},
        "12997": {"comment":"The byte after the name"},
        "12999": {"synopsis":"Checks for an array parameter: a name followed by '()' (spaces allowed inside).\nEntry: CHAD on the item.\nExit: Z: 'name()', CHAD past the ')'; NZ: something else, CHAD unchanged (NC when it is\nnot a name of 1-10 characters).\nChanges: AF, BC, HL.","comment":"A name?"},
        "13002": {"comment":"Keeps the carry"},
        "13004": {"comment":"'(' after it?"},
        "13007": {"comment":"The first byte inside"},
        "13010": {"comment":"')'?"},
        "13013": {"comment":"CHAD on the ')'"},
        "13016": {"comment":"Past it; Z"},
        "13019": {"synopsis":"Runs a statement that starts with a name: a procedure call (the statement dispatcher at\n$0DAF sends a byte below $90 here). In a syntax check it inserts the call's hidden marker\n($0E $FD $FD $FD and two bytes) after the name and checks the arguments. When running it\nfollows the marker's pointer to the DEF PROC line, keeps the arguments' position in\nPRPTR and the parameters' position in DPPTR, binds the parameters (PROC_BIND_PARAMS),\npushes a procedure frame ($40) and goes on in the DEF PROC line.\nEntry: A = the statement's first byte - $90.\nError: 12 when the marker holds no DEF PROC; 41 when the BASIC stack is full.","comment":"The first byte again"},
        "13021": {"comment":"Must be a letter"},
        "13025": {"comment":"Running?"},
        "13028": {"comment":"No: check the syntax"},
        "13032": {"synopsis":"Steps forward to the call's hidden number ($0E after the name)."},
        "13036": {"comment":"The pointer's page byte"},
        "13039": {"comment":"Bit 5 set: no DEF PROC"},
        "13043": {"comment":"DE = the DEF PROC line"},
        "13047": {"comment":"PRPTR: the arguments, after the marker"},
        "13051": {"comment":"PRPTRP: their page"},
        "13056": {"comment":"DPPTRP: the DEF PROC's page"},
        "13060": {"comment":"Page it in"},
        "13063": {"comment":"Past the line number, length and token"},
        "13067": {"comment":"Skip spaces"},
        "13070": {"synopsis":"Steps past the procedure's name in the DEF PROC line."},
        "13077": {"comment":"DPPTR: the parameters"},
        "13080": {"comment":"Keep the line's start"},
        "13081": {"comment":"Bind the parameters to the arguments"},
        "13084": {"comment":"A procedure frame ($40) "},
        "13089": {"comment":"... with its count at 1"},
        "13090": {"comment":"HL = the DEF PROC line"},
        "13092": {"comment":"Its page"},
        "13095": {"comment":"Go on at its second statement"},
        "13100": {"synopsis":"Checks that a procedure frame ($40) is on top of the BASIC stack and takes it off\n($1A20).\nExit: as $1A20 leaves it: the frame's bytes in A, DE, C.\nError: 12 when the top frame is not a procedure's.","comment":"A procedure frame?"},
        "13106": {"synopsis":"Stops with error code 12: no DEF PROC for the call, or no procedure running for LOCAL.\nError: always (code 12).","comment":"Stops with error code 12"},
        "13108": {"synopsis":"Checks a procedure call's syntax: steps past the name, inserts the $FD marker, then\nchecks the arguments: expressions or 'name()' items, separated by commas."},
        "13115": {"comment":"Insert the PROC marker"},
        "13120": {"comment":"No arguments?"},
        "13124": {"synopsis":"Checks one argument: an array as 'name()', or an expression.","comment":"An array: 'name()'?"},
        "13127": {"comment":"No: an expression"},
        "13130": {"comment":"The statement's end?"},
        "13134": {"comment":"Must be ','"},
        "13139": {"synopsis":"Inserts a reference marker at HL: a hidden number $0E, A, A, A and two bytes (a page byte\nwith bit 7 set and bit 5 set means 'not resolved yet'), then moves CHAD past it.\nEntry: HL = where it goes (after the name); A = $FD (PROC call) or $FE (FN).\nExit: CHAD on the marker's last byte, A = the byte after it (RST $20).\nChanges: AF, BC, DE, HL."},
        "13140": {"comment":"Room for $0E and 5 bytes"},
        "13144": {"comment":"The marker byte, twice"},
        "13148": {"comment":"And as the page: unresolved"},
        "13151": {"comment":"CHAD on its last byte"},
        "13154": {"comment":"The byte after it"},
        "13156": {"synopsis":"Opens 6 bytes at HL ($1E1B) and writes the hidden number's $0E there (also used by $15CC\nand ROM1 $C511).\nEntry: HL = the place.\nExit: HL = the first of the 5 bytes after the $0E.\nChanges: AF, BC, DE, HL.","comment":"6 bytes"},
        "13162": {"comment":"The hidden number's marker"},
        "13166": {"synopsis":"Looks a one-letter name (optionally with '$') up among the parameters of the DEF FN being\nevaluated (DEFADD, set by FN_EVAL_BODY) and stacks its value from the parameter's hidden\nslot. Called by the expression evaluator at $152B.\nEntry: CHAD on the name.\nExit: carry: found, the value on the calculator stack, CHAD on the name's last byte,\nFLAGS bit 6 set for a number, clear for a string. NC: not a parameter (or a syntax\ncheck), CHAD unchanged.\nChanges: AF, BC, DE, HL.","comment":"Running?"},
        "13170": {"comment":"Keep the name's position"},
        "13171": {"comment":"B = the letter"},
        "13172": {"comment":"A '$' after it?"},
        "13175": {"comment":"C = $0E: a number"},
        "13179": {"comment":"C = '$': a string"},
        "13181": {"synopsis":"A longer name is not a parameter; otherwise reads the parameter list at DEFADD.","comment":"More name: not a parameter"},
        "13186": {"comment":"A:HL = DEFADD, its page in HMPR"},
        "13192": {"synopsis":"Steps to the next parameter's slot ($0E) and compares its name with the one sought."},
        "13198": {"comment":"The byte before the slot"},
        "13200": {"comment":"'$' sought and found?"},
        "13203": {"comment":"The letter before the '$'"},
        "13206": {"synopsis":"Compares the parameter's letter (in A) with the one sought, either case.","comment":"Same letter, either case?"},
        "13211": {"comment":"No: past the slot"},
        "13215": {"comment":"Skip spaces"},
        "13218": {"comment":"Another parameter?"},
        "13222": {"synopsis":"Not a parameter: returns NC with CHAD unchanged."},
        "13225": {"synopsis":"Found: stacks the slot's 5 bytes and sets FLAGS bit 6 for a number.","comment":"The slot's 5 bytes"},
        "13228": {"comment":"Onto the calculator stack"},
        "13231": {"comment":"Drop the saved position"},
        "13235": {"comment":"FLAGS: a string "},
        "13237": {"comment":"... when C = '$'"},
        "13241": {"comment":"FLAGS: a number"},
        "13244": {"synopsis":"Steps HL forward and over bytes below $21 (spaces and control codes).\nEntry: HL = the byte before.\nExit: HL and A = the first byte from $21 up; NC.\nChanges: AF, HL."},
        "13245": {"synopsis":"Steps HL over bytes below $21 (spaces and control codes), starting at HL.\nEntry: HL = the first byte.\nExit: HL and A = the first byte from $21 up; NC.\nChanges: AF, HL."},
        "13246": {"comment":"A space or control code?"},
        "13251": {"synopsis":"Sets COMPFLG to $FF (searches and preparation go over the program, not the edit line).\nExit: A = $FF.\nChanges: A.","comment":"COMPFLG: the program"},
        "13257": {"synopsis":"Sets the next statement to run to PPC's next one (NEWPPC, NSPPC through $199B), sets\nPPC's high byte to $FF, then prepares the program (PREP_PROGRAM). ROM1 jumps here ($C27E,\n$C621) and to $33D0, inside the next instruction, with a statement number and line\nstacked instead.\nChanges: AF, BC, DE, HL, NEWPPC, NSPPC.","comment":"SUBPPC"},
        "13260": {"comment":"PPC"},
        "13263": {"comment":"Skips POP AF / POP HL: ROM1 enters at $33D0"},
        "13266": {"comment":"The next statement"},
        "13267": {"comment":"NEWPPC, NSPPC"},
        "13270": {"comment":"PPC's high byte: $FF"},
        "13275": {"synopsis":"Prepares the program for running, with COMPFLG set: falls into PREP_PROGRAM_2.\nChanges: AF, BC, DE, HL, COMPFLG.","comment":"COMPFLG: the program"},
        "13278": {"synopsis":"Prepares the program (COMPFLG set) or the edit line (clear) for running, keeping CHAD and\nCLA:\n1. With COMPFLG set, sets each LABEL's variable to its line's number ($38EA) for every line\nthat starts with LABEL ($EA).\n2. Builds the DEF FN table and resolves the PROC and FN markers ($2FBF with carry, or\n$2FB9 as IFTYPE says), then clears COMPFLG.\n3. Restores CLA, CHAD and CHADP (ROM1 paged out).\nChanges: AF, BC, DE, HL, KCURP, KCUR (used to keep CHAD).","comment":"Keep CHAD in KCUR"},
        "13290": {"comment":"Keep CLA and CLAPG"},
        "13298": {"comment":"COMPFLG: the program?"},
        "13304": {"comment":"A:HL = PROG"},
        "13307": {"synopsis":"Finds the next line that starts with LABEL ($EA) and sets the label's variable to the\nline's number.","comment":"Lines starting with LABEL ($EA)"},
        "13310": {"comment":"Find the next one"},
        "13313": {"comment":"No more"},
        "13315": {"comment":"CHADP: the line's page"},
        "13320": {"comment":"Keep the next line's address"},
        "13323": {"comment":"Back to the line number"},
        "13326": {"comment":"BC = the line number"},
        "13329": {"comment":"Stack it"},
        "13332": {"comment":"Assign it to the label's name"},
        "13338": {"comment":"The next line"},
        "13341": {"synopsis":"The program's labels are set: builds the DEF FN table, resolves the markers and clears\nCOMPFLG.","comment":"Carry: the DEF FN table and the markers"},
        "13344": {"comment":"COMPFLG: off"},
        "13348": {"synopsis":"Resolves the markers as IFTYPE says ($2FB9), then restores CLA, CHAD and CHADP."},
        "13351": {"comment":"Restore CLAPG"},
        "13355": {"comment":"Restore CLA"},
        "13359": {"comment":"Restore CHAD"},
        "13365": {"comment":"Restore CHADP, ROM1 out"},
        "13371": {"synopsis":"Steps to the next line (HL + DE) and falls into FIND_TOKEN_LINE."},
        "13372": {"synopsis":"Finds the next program line, from HL on, whose text starts with the token C (leading bytes\nbelow B skipped; a line whose first byte is below B is searched for its first byte from B\nup).\nEntry: HL = a line's start (its page in HMPR); C = the token; B = $21.\nExit: NC: found, CHAD and HL = the token, DE = the line's length; carry: the program's end\n($FF).\nChanges: AF, DE, HL.","comment":"$FF: the program's end?"},
        "13376": {"comment":"Past the page's end: the next page"},
        "13379": {"comment":"Past the line number"},
        "13381": {"comment":"DE = the length"},
        "13385": {"comment":"The text's first byte: the token?"},
        "13389": {"comment":"From $21 up: not this line"},
        "13392": {"comment":"Keep the text's start"},
        "13393": {"synopsis":"Skips the line's leading bytes below B; gives up on the line at its $0D.","comment":"The line's end?"},
        "13402": {"comment":"CHAD on the first byte from $21"},
        "13406": {"comment":"The token?"},
        "13409": {"synopsis":"Not this line: on to the next."},
        "13412": {"synopsis":"Found: CHAD = the token; returns NC."},
        "13416": {"synopsis":"Pushes a zero word on the BASIC stack (BSTKEND), the mark UNWIND_LOCALS stops at, then\nfalls into BIND_LIST.\nEntry: as BIND_LIST.","comment":"BSTKEND - 2: a zero word"},
        "13427": {"synopsis":"Binds a list of names (at DPPTR: a DEF PROC's parameters or a LOCAL's names) to the\narguments at PRPTR, one by one (BIND_NEXT), pushing records on the BASIC stack that\nUNWIND_LOCALS undoes later. After the names: DATA points DATADD at the arguments\ninstead; then the variables are hidden or shown (BIND_HIDE_LOOP), the REF strings are\nlinked (BIND_REF_STRINGS) and no argument may be left over.\nEntry: DPPTRP/DPPTR = the names; PRPTRP/PRPTR = the arguments.\nError: 26 when arguments are left over or do not match; 41 when the BASIC stack is full.","comment":"A zero AF ends the stacked list"},
        "13429": {"comment":"RNSTKE: a list at $4B00, empty"},
        "13436": {"comment":"CHAD on the names: any?"},
        "13442": {"comment":"DATA?"},
        "13447": {"comment":"DATADD = the arguments"},
        "13455": {"synopsis":"RESTORE: the command table's entry for token $BA (ROM1 $FDB9). Takes the line number (0\nwhen none follows) and points DATADD just before that line, or the next one after it.\nError: 30 when the number is out of range ($1D2E).","comment":"The line number, or 0"},
        "13458": {"comment":"As a line number in HL"},
        "13461": {"synopsis":"Finds line HL (or the next after it, $1A4D) and points DATADD just before it.","comment":"Find the line"},
        "13464": {"comment":"The byte before it"},
        "13467": {"synopsis":"Stores A:HL in DATADDP/DATADD.","comment":"DATADD"},
        "13470": {"comment":"DATADDP"},
        "13474": {"synopsis":"Points DATADD before the program's first line (RESTORE to line 0). Called at $38FC and from\nROM1.\nChanges: AF, BC, DE, HL, TEMPW1."},
        "13485": {"synopsis":"Binds the next name in the list: checks the BASIC stack's room (23 bytes), notes REF\n($CE) in IFTYPE (0 for REF), looks the name up ($14DA) and goes on at BIND_STRING for a\nstring or an array, or binds a number here.","comment":"23 bytes of BASIC stack left?"},
        "13492": {"comment":"HEAPEND"},
        "13498": {"comment":"No: error 41"},
        "13501": {"comment":"REF?"},
        "13503": {"comment":"IFTYPE: 0 for REF"},
        "13508": {"comment":"Past REF"},
        "13509": {"synopsis":"Looks the parameter's name up and keeps the position after it in DPPTR.","comment":"Look the name up; F' = found?"},
        "13513": {"comment":"DPPTR: past the name"},
        "13519": {"comment":"A string?"},
        "13522": {"comment":"An array?"},
        "13527": {"comment":"A variable of that name already?"},
        "13530": {"comment":"Keep its position "},
        "13535": {"comment":"... and its page, to be hidden"},
        "13541": {"comment":"Another of that name further on?"},
        "13546": {"comment":"No: blank the name buffer "},
        "13551": {"comment":"... and the found one's link"},
        "13561": {"comment":"Skips LD C,D / EX DE,HL ($34FA)"},
        "13564": {"synopsis":"Makes the new numeric variable ($2CFB), then, with an argument left, looks for an\nunused variable of the name to reuse and pushes the variable's record ($40).","comment":"Make the variable"},
        "13567": {"comment":"CHAD on the arguments: any left?"},
        "13573": {"comment":"C = the type byte, B = the letter"},
        "13578": {"comment":"Blanked?"},
        "13581": {"comment":"(letter - 'a') * 2"},
        "13586": {"comment":"NVARS: the letter's chain"},
        "13589": {"comment":"Look for one no longer in use"},
        "13593": {"synopsis":"Follows the letter's chain of numeric variables, looking for the type byte in C.","comment":"The offset to the next"},
        "13597": {"comment":"The chain's end?"},
        "13602": {"comment":"This one's type?"},
        "13607": {"comment":"Found: hide it "},
        "13619": {"comment":"... and copy the name after it"},
        "13629": {"synopsis":"Keeps the variable's value position in DESTP/DEST and stacks it to be hidden later.","comment":"DEST: the value"},
        "13634": {"comment":"DESTP: its page"},
        "13644": {"comment":"FLAGE = 0"},
        "13648": {"comment":"IX = NUMEND"},
        "13652": {"comment":"A $40 record: a local, deleted later"},
        "13657": {"comment":"CHAD on the argument"},
        "13660": {"comment":"REF?"},
        "13664": {"comment":"No: assign the argument"},
        "13666": {"comment":"Look the argument's variable up"},
        "13669": {"comment":"A string: error 26"},
        "13672": {"comment":"Found?"},
        "13675": {"comment":"No: make it with the value 1"},
        "13693": {"synopsis":"A numeric REF: pushes a $A0 record for the caller's variable (the value is copied back\nby UNWIND_LOCALS), marks the local's record $60, and copies the value in."},
        "13694": {"comment":"Keep the caller's variable "},
        "13698": {"comment":"... and its page"},
        "13703": {"comment":"A $A0 record: the caller's variable"},
        "13707": {"comment":"The local's record: $40 to $60"},
        "13717": {"comment":"Found: stack its value "},
        "13721": {"comment":"... and assign it"},
        "13725": {"synopsis":"Assigns the argument's value to the parameter ($2AFA), unless REF already did."},
        "13730": {"synopsis":"Binds a string or array parameter: pushes its name record ($10, or $90 when a variable of\nthe name exists, which is hidden), then assigns the argument (BIND_STR_VALUE) or, for\nREF, records the caller's variable.","comment":"A name record"},
        "13732": {"comment":"A variable of that name already?"},
        "13735": {"comment":"Yes: a $90 record "},
        "13737": {"comment":"... keeping STRLOCN"},
        "13741": {"comment":"... and its page, to be hidden"},
        "13748": {"synopsis":"Pushes the parameter's name record; ends when no argument is left.","comment":"Push the name record"},
        "13751": {"comment":"CHAD on the argument: any?"},
        "13759": {"comment":"REF?"},
        "13765": {"comment":"A REF: the argument's type "},
        "13769": {"comment":"... must be a variable's"},
        "13780": {"comment":"Skips POP AF ($35D5)"},
        "13784": {"comment":"Wrong type: error 26"},
        "13790": {"comment":"RNSTKE: a 5-byte entry"},
        "13793": {"comment":"BSTKEND"},
        "13801": {"comment":"STRLOCN"},
        "13809": {"comment":"The page + $80"},
        "13818": {"synopsis":"Pushes the REF string's name record and a $FF mark after it."},
        "13823": {"comment":"A $FF mark on the BASIC stack"},
        "13834": {"synopsis":"Assigns a string argument to the parameter: the argument must be a string.","comment":"A number?"},
        "13838": {"comment":"Yes: error 26"},
        "13841": {"comment":"$5160's bit 6: a string"},
        "13846": {"comment":"Evaluate the argument"},
        "13849": {"comment":"Assign it"},
        "13852": {"synopsis":"Reads the byte after the argument on CHAD's page."},
        "13856": {"synopsis":"Keeps the arguments' position in PRPTR, stepping past a ')' and a ','.","comment":"PRPTR"},
        "13859": {"comment":"')'?"},
        "13867": {"synopsis":"Steps past a ',' after the argument.","comment":"','?"},
        "13875": {"synopsis":"Back to the name list: steps past a ')'.","comment":"CHAD on the names"},
        "13883": {"synopsis":"',' in the name list: the next name; otherwise the list is done.","comment":"Another name?"},
        "13888": {"comment":"Bind it"},
        "13891": {"synopsis":"Takes one stacked variable (page byte, then address): clears its bit 7, or, with bit 6 of\nthe page byte set, sets it (hidden) and, with bit 7 also set, pushes a $80 record so\nUNWIND_LOCALS shows it again. A page byte with bit 6 clear clears its bit 5 instead."},
        "13892": {"comment":"Its page"},
        "13896": {"comment":"Bit 6: hide it"},
        "13898": {"comment":"Shown "},
        "13903": {"comment":"... or hidden"},
        "13905": {"comment":"Bit 7: a $80 record to show it later"},
        "13910": {"comment":"Skips RES 5,(HL): $3657 for bit 6 clear"},
        "13913": {"synopsis":"Takes the stacked variables until the zero AF, then links the REF strings.","comment":"The next stacked variable"},
        "13914": {"comment":"The zero AF ends them"},
        "13917": {"synopsis":"Takes the RNSTKE list's entries (5 bytes each, at $4B00 up: BSTKEND, STRLOCN, page + $80;\na 0 ends it) and for each copies the REF string's name record onto the BASIC stack,\nwith the caller's variable found (FIND_SAVED_NAME) when its bit 7 is set.","comment":"RNSTKE"},
        "13920": {"comment":"Any entries left?"},
        "13924": {"comment":"The entry's page"},
        "13927": {"comment":"DE = STRLOCN"},
        "13932": {"comment":"HL = the BSTKEND then"},
        "13937": {"comment":"Drop the entry"},
        "13942": {"comment":"The name record's length "},
        "13946": {"comment":"... and type bits"},
        "13951": {"comment":"Bit 7 of the type: find the original"},
        "13956": {"comment":"Store the record"},
        "13964": {"synopsis":"The names are bound: the arguments must be used up.","comment":"CHAD on the arguments: at the end?"},
        "13968": {"synopsis":"Stops with error code 26: a procedure's arguments do not match its parameters.\nError: always (code 26).","comment":"Stops with error code 26"},
        "13970": {"synopsis":"Searches the BASIC stack from BSTKEND for a name record (bit 4) with the same type bits\n(mask $AF) and name as the record at DE, skipping 3-byte variable records and $FF marks;\nclears bit 7 of the found record's type.\nEntry: DE = the name record (type byte, then the name).\nExit: the found record's bit 7 clear.\nError: 26 when a 0 type byte (the frame's start) comes first.\nKeeps: BC, DE, HL."},
        "13973": {"comment":"BSTKEND"},
        "13976": {"synopsis":"Examines the next record on the BASIC stack; a 0 type byte ends the search with error 26.","comment":"The record's type"},
        "13978": {"comment":"0: the frame's start"},
        "13980": {"comment":"A name record?"},
        "13984": {"comment":"No: 3 bytes"},
        "13988": {"synopsis":"A name record: skips a $FF mark before its type byte."},
        "13994": {"synopsis":"Compares the record's type bits with the sought one's.","comment":"C = the name's length"},
        "13997": {"comment":"Same type bits?"},
        "14004": {"synopsis":"Steps over the record (C bytes)."},
        "14009": {"synopsis":"Same type: compares the names."},
        "14012": {"synopsis":"Compares the next name byte."},
        "14020": {"synopsis":"Different names: on to the next record; the same: clears bit 7 of its type."},
        "14024": {"comment":"Back to the type byte"},
        "14025": {"comment":"Found: bit 7 off"},
        "14031": {"synopsis":"Pushes a 3-byte variable record on the BASIC stack: a type byte (B | the page count), then\nthe offset of HL (in the current HMPR page) from NVARS, so the record survives the\nvariables moving.\nEntry: HL = the variable (its page in HMPR); B = the record's kind ($40 local, $80 hidden\nvariable, $A0 REF's caller variable).\nExit: BSTKEND lowered by 3.\nChanges: AF, C, DE, HL.","comment":"C:DE = NVARS"},
        "14039": {"comment":"A:HL = the variable"},
        "14041": {"comment":"The offset from NVARS"},
        "14045": {"comment":"BSTKEND - 3"},
        "14053": {"comment":"The type: kind | pages"},
        "14057": {"synopsis":"Stores HL in BSTKEND."},
        "14061": {"synopsis":"Pushes a name record on the BASIC stack from the name buffer at $513F: the type byte\n(its bits $6F, or B), then its length (bits 3-0) bytes from $5140.\nEntry: B = the record's kind ($00, $10, $90).\nExit: BSTKEND lowered.\nChanges: AF, BC, DE, HL.","comment":"The name buffer"},
        "14067": {"comment":"C = the length"},
        "14071": {"comment":"The type byte with the kind"},
        "14077": {"comment":"BSTKEND - the length - 1"},
        "14084": {"synopsis":"Stores the type byte A at DE and copies C bytes after it from HL + 1.\nEntry: DE = the place; HL = the byte before the name; A = the type; BC = the length.\nChanges: BC, DE, HL."},
        "14087": {"comment":"The name"},
        "14090": {"synopsis":"Undoes the records a procedure call and its LOCALs pushed on the BASIC stack, up to the\nzero word that opened them (taken off too). Called at $19E7 (with the procedure frame) and\nfrom ROM1 $C319. Variable records (3 bytes, offsets from NVARS):\n- $A0: the REF caller's variable, kept for the next record;\n- $60: a REF local: marked no longer in use (bit 5) and its 5-byte value copied (through\n$5AC8) into the kept variable;\n- $40: a local: hidden bit cleared, marked no longer in use;\n- $80: a hidden variable: shown again (bit 7 cleared).\nName records (bit 4 set: strings and arrays) are handled at UNWIND_NAME_REC.\nExit: BSTKEND past the zero word.","comment":"BSTKEND: the record's type"},
        "14096": {"comment":"0: the opening word"},
        "14100": {"comment":"A name record?"},
        "14105": {"comment":"DE = the offset from NVARS"},
        "14109": {"comment":"Drop the record"},
        "14112": {"comment":"C = the pages"},
        "14115": {"comment":"C:DE = NVARS "},
        "14118": {"comment":"... + the offset: the variable"},
        "14122": {"comment":"Bit 5: a REF pair?"},
        "14126": {"comment":"$A0: keep the caller's variable"},
        "14135": {"synopsis":"A $60 record: marks the local no longer in use and copies its value into the variable the\n$A0 record kept.","comment":"No longer in use"},
        "14137": {"comment":"Past the name: the value's last byte"},
        "14146": {"comment":"Copy the value to $5AC8-$5ACC"},
        "14155": {"comment":"The kept variable and its page"},
        "14159": {"comment":"Copy the value into it"},
        "14165": {"synopsis":"A $40 or $80 record: clears the variable's bit 7 (shown); a $40 local is also marked no\nlonger in use (bit 5)."},
        "14166": {"comment":"Shown"},
        "14168": {"comment":"$80: done"},
        "14170": {"comment":"$40: no longer in use"},
        "14174": {"synopsis":"A name record: a $FF-marked one is a REF string, whose local's contents go back to the\ncaller's variable; others go on at UNWIND_NAME_DEL.","comment":"A $FF mark: a REF string"},
        "14178": {"comment":"The name's length"},
        "14186": {"comment":"The type of the record after it"},
        "14193": {"comment":"Find the local by name"},
        "14224": {"synopsis":"A plain name record: finds the local of that name ($140D) and deletes it ($2C5B).","comment":"Bit 4 off"},
        "14227": {"comment":"Find the local by name"},
        "14230": {"comment":"Found: delete it"},
        "14234": {"synopsis":"Bit 7 set: finds the hidden variable of that name and shows it again (bit 7 cleared).","comment":"Bit 7: a hidden one to show?"},
        "14241": {"synopsis":"Follows the variables of that name ($146D) to the hidden one."},
        "14253": {"comment":"Back to its page"},
        "14255": {"comment":"Shown"},
        "14257": {"synopsis":"The next record."},
        "14260": {"synopsis":"Moves CHAD to DPPTRP/DPPTR (the name list being bound) and reads the byte there.\nExit: A = the byte (RST $18); Z at a ':' or $0D.\nChanges: AF, HL, CHAD.","comment":"DPPTR"},
        "14268": {"synopsis":"Moves CHAD to PRPTRP/PRPTR (the arguments) and reads the byte there.\nExit: A = the byte (RST $18); Z at a ':' or $0D.\nChanges: AF, HL, CHAD.","comment":"PRPTR"},
        "14274": {"synopsis":"Stores A:HL as CHADP/CHAD, pages it in and reads the byte there; Z at a ':' or $0D.","comment":"CHAD"},
        "14280": {"comment":"Page it in"},
        "14283": {"comment":"Read it: Z at the statement's end"},
        "14286": {"synopsis":"RST $08's body (in the alternate registers): keeps CHAD in XPTRP/XPTR, reads the code byte\nafter the RST and steps the return address past it, calls RST8V when it is set, then:\nwith DOSCNT bit 0 set, or below 128 with DOSFLG clear, stores the code in ERRNR and\nreturns through ERRSP; with DOSFLG set it goes on at $380B (the DOS hooks); a hook\n(128 up) with no DOS stores 53.\nEntry: the code byte follows the RST.\nExit: an error returns to the address at ERRSP, the calculator stack reset ($1D95).","comment":"XPTR: where the error happened"},
        "14292": {"comment":"Keep A in A'"},
        "14293": {"comment":"XPTRP"},
        "14299": {"comment":"The code byte's address"},
        "14300": {"comment":"The code"},
        "14301": {"comment":"Return past it"},
        "14304": {"comment":"RST8V set?"},
        "14309": {"comment":"Yes: call it"},
        "14312": {"comment":"DOSCNT bit 0: store the code as it is"},
        "14319": {"comment":"DOSFLG: a DOS present?"},
        "14324": {"comment":"Yes: on at $380B"},
        "14326": {"comment":"A hook (128 up)?"},
        "14330": {"comment":"No DOS: code 53"},
        "14332": {"synopsis":"Stores the code in ERRNR, clears DOSCNT bit 0, sets SP from ERRSP and resets the\ncalculator stack ($1D95), returning to the error handler ERRSP held.\nEntry: A = the code.\nExit: to the address at ERRSP.","comment":"ERRNR"},
        "14335": {"comment":"DOSCNT bit 0 off"},
        "14347": {"synopsis":"RST $08 with a DOS present (DOSFLG nonzero): passes the code to the DOS. Code 0 goes\nstraight to the error exit at $37FC. Otherwise the DOS's page (DOSFLG) is put into section B\n($4000) with LMPR = DOSFLG - 1, SP moved to $8000, and the DOS is called at $4203 for a code\nbelow $80 (an error) or at $4200 for a code of $80 or more (a hook). Then LMPR and SP are\nput back. A nonzero DOSER makes it jump there; otherwise an A returned nonzero stops with\nerror code A. A zero A after an error code 1, 2 or 3 goes on at $E1FD, $E4DB or $E1FA;\nanything else returns.\nEntry: A = the code byte; E is set from it; the return address past the code byte on the\nstack.\nExit: returns past the code byte after a hook the DOS handled; otherwise does not return.","comment":"Code 0?"},
        "14350": {"comment":"E = the code"},
        "14351": {"comment":"B = the current LMPR"},
        "14355": {"comment":"HL = the current SP"},
        "14359": {"comment":"A = DOSFLG - 1: the DOS page in section B"},
        "14363": {"comment":"LMPR: the DOS at $4000"},
        "14366": {"comment":"A stack in the DOS page"},
        "14370": {"comment":"Keep the old LMPR"},
        "14371": {"comment":"Keep the old SP"},
        "14373": {"comment":"A hook ($80 or more)?"},
        "14377": {"comment":"An error code: the DOS at $4203"},
        "14380": {"comment":"Carry: it was an error code"},
        "14381": {"synopsis":"Calls the DOS's hook entry at $4200 when carry is clear (a code of $80 or more), then puts\nthe caller's LMPR and SP back and looks at DOSER.\nEntry: as RST08_DOS at $3824.\nExit: as RST08_DOS."},
        "14384": {"comment":"The old SP"},
        "14385": {"comment":"The old LMPR"},
        "14387": {"comment":"LMPR put back"},
        "14389": {"comment":"SP put back"},
        "14391": {"comment":"HL = DOSER"},
        "14394": {"comment":"DOSER set?"},
        "14398": {"comment":"A hook: skip the stack reset"},
        "14400": {"comment":"An error code: SP = ERRSP - 2"},
        "14406": {"synopsis":"Acts on the A the DOS returned: nonzero stops with that error code; zero after an error code\n1, 2 or 3 jumps to ROM1 $E1FD, $E4DB or $E1FA; otherwise returns.\nEntry: A = the DOS's result; E = the code byte.","comment":"Did the DOS give an error code?"},
        "14409": {"comment":"Code 1?"},
        "14413": {"comment":"Code 2?"},
        "14417": {"comment":"Code 3?"},
        "14421": {"comment":"Back past the code byte"},
        "14422": {"synopsis":"Jumps to the address the DOS left in DOSER.\nEntry: HL = DOSER."},
        "14423": {"synopsis":"Copies ROM1 code into RAM page 0 at $4F00 and runs it there (ROM1 $E226 jumps here for\nMERGE). The LD IX instructions hide more entries, each loading another source into HL: $385B\n(the INPUT command's entry in the command table) copies $C31D, $385F (RENUM's) copies $C000;\neach copies $0200 bytes.\nEntry: A and the flags are passed to the copied code.\nExit: as the copied code leaves it.","comment":"Source: ROM1 $C5D4"},
        "14426": {"comment":"Hides $385B: LD HL,$C31D (INPUT)"},
        "14430": {"comment":"Hides $385F: LD HL,$C000 (RENUM)"},
        "14434": {"comment":"$0200 bytes"},
        "14437": {"comment":"To $4F00 and run"},
        "14439": {"synopsis":"The KEYIN command (its entry in the command table): copies $51 bytes of ROM1 from $C292 to\n$4B00 and runs them there.\nExit: as the copied code leaves it.","comment":"Source: ROM1 $C292"},
        "14442": {"comment":"Run at $4B00"},
        "14445": {"comment":"$51 bytes"},
        "14450": {"synopsis":"Calls $04C2, then copies $A1 bytes of ROM1 from $C533 to $4D80 and runs them there.\nExit: as the copied code leaves it."},
        "14453": {"synopsis":"RAMRUN_C533 without the call of $04C2 (ROM1 reaches it through CALL_INLINE): copies $A1\nbytes of ROM1 from $C533 to $4D80 and runs them there.\nExit: as the copied code leaves it.","comment":"Main registers into the alternates"},
        "14454": {"comment":"Source: ROM1 $C533"},
        "14457": {"comment":"Run at $4D80"},
        "14460": {"comment":"$A1 bytes"},
        "14465": {"synopsis":"The GET command (its entry in the command table): copies $91 bytes of ROM1 from $C200 to\n$4F00 and runs them there. The LD IX instructions hide the entries of four more commands,\neach with its own source: $3885 DELETE ($C230), $3889 POP ($C2E3), $388D DEF KEYCODE\n($C46E), $3891 DEF FN ($C4EF).\nExit: as the copied code leaves it.","comment":"Source: ROM1 $C200 (GET)"},
        "14468": {"comment":"Hides $3885: LD HL,$C230 (DELETE)"},
        "14472": {"comment":"Hides $3889: LD HL,$C2E3 (POP)"},
        "14476": {"comment":"Hides $388D: LD HL,$C46E (DEF KEYCODE)"},
        "14480": {"comment":"Hides $3891: LD HL,$C4EF (DEF FN)"},
        "14484": {"comment":"$91 bytes"},
        "14487": {"synopsis":"Copies BC bytes from HL to $4F00 and runs them there (RAMRUN_COPY).\nEntry: HL = the source in ROM1; BC = the count.","comment":"Destination and run address"},
        "14490": {"synopsis":"Copies BC bytes from ROM1 at HL to DE in RAM page 0, with ROM1 paged in for the copy, then\nreturns to DE: the copied code runs there.\nEntry: HL = the source; DE = the destination; BC = the count; A and the flags are passed on.\nExit: as the copied code leaves it.","comment":"The copy is where RET goes"},
        "14492": {"comment":"LMPR: ROM1 in, page 0 at $4000"},
        "14496": {"comment":"Copy the code"},
        "14498": {"comment":"LMPR: ROM1 out"},
        "14502": {"comment":"A and flags as on entry"},
        "14503": {"comment":"Run the copy"},
        "14504": {"synopsis":"The DEFAULT command (its entry in the command table): LTDFF = $FF, then as LET. The CP $AF\nhides LET's entry at $38AB (XOR A, LTDFF = 0), and the CP $E7 hides the loop's entry at\n$38B0 (RST $20, past a comma). For each assignment: $2CF7 finds the variable, '=' must\nfollow (error 29 at $0D29 if not), and $2AFA assigns the value. DEFAULT, when running, skips\nthe assignment of a variable that $2CF7 found (FLAGE bit 0 clear and $5AB1, set by $2CF7,\nnonzero: probably an existing variable): $3B08 evaluates the value and $1D12 drops it.\nEntry: the BASIC pointer past the keyword.\nExit: at the end of the statement.","comment":"DEFAULT: LTDFF = $FF"},
        "14506": {"comment":"Hides $38AB: XOR A (LET)"},
        "14508": {"comment":"LTDFF: 0 LET, $FF DEFAULT"},
        "14511": {"comment":"Hides $38B0: RST $20, the next assignment"},
        "14513": {"comment":"Find the variable"},
        "14516": {"comment":"The character after the name"},
        "14517": {"comment":"'='?"},
        "14519": {"comment":"No: stops with error code 29"},
        "14522": {"comment":"Past the ="},
        "14523": {"comment":"LTDFF"},
        "14526": {"comment":"LET?"},
        "14529": {"comment":"Running?"},
        "14534": {"comment":"FLAGE bit 0 set?"},
        "14540": {"comment":"Does the variable exist?"},
        "14546": {"comment":"Yes: evaluate the value"},
        "14549": {"comment":"And drop it"},
        "14552": {"comment":"Variable kept"},
        "14554": {"synopsis":"LET's assignment: $2AFA evaluates the value and assigns it, then goes on at LET_NEXT.","comment":"Assign the value"},
        "14557": {"synopsis":"After an assignment: a comma starts the next one (back to $38B0), anything else ends the\nstatement.","comment":"The character after the value"},
        "14558": {"comment":"Another assignment?"},
        "14563": {"synopsis":"The LABEL command (its entry in the command table). When running, jumps to $10F2. When\nchecking syntax, the name must be a numeric variable (NEED_NUM_VAR). The CP $E7 hides the\nentry $38EA (RST $20, then NEED_NUM_VAR) that $3414 calls.\nEntry: the BASIC pointer past the keyword.","comment":"Running?"},
        "14566": {"comment":"Yes: on at $10F2"},
        "14569": {"comment":"Hides $38EA: RST $20"},
        "14571": {"synopsis":"Finds the variable named at the BASIC pointer ($2CF7) and returns if it is numeric (FLAGS\nbit 6); otherwise stops with error code 29.\nEntry: the BASIC pointer at the name.\nError: 29 for a string name.","comment":"Find the variable"},
        "14574": {"comment":"FLAGS"},
        "14577": {"comment":"Numeric?"},
        "14580": {"comment":"No: stops with error code 29"},
        "14582": {"synopsis":"The RUN command (its entry in the command table): takes an optional line number (0 when\nthere is none; SYN_OPT_NUM ends the command when checking syntax), sets it as the line to go\nto ($1992, $34A2), then clears the variables as CLEAR with RAMTOP unchanged.\nEntry: the BASIC pointer at the character after the keyword.\nExit: as CLEAR_TO.","comment":"Optional line number"},
        "14585": {"comment":"Line to go to"},
        "14591": {"comment":"CLEAR with RAMTOP kept"},
        "14593": {"synopsis":"The CLEAR command (its entry in the command table): takes an optional address (0 when there\nis none) for the new RAMTOP. 0 keeps RAMTOP.\nEntry: the BASIC pointer at the character after the keyword.\nExit: as CLEAR_TO.","comment":"Optional address"},
        "14596": {"comment":"A = address div 16K; HL = BC = rest"},
        "14599": {"comment":"C = its page at $8000"},
        "14601": {"comment":"Zero?"},
        "14603": {"comment":"HL in $8000-$BFFF"},
        "14605": {"comment":"No: the new RAMTOP"},
        "14607": {"synopsis":"CLEAR with the current RAMTOP: C:HL = RAMTOPP:RAMTOP, then CLEAR_TO.","comment":"RAMTOPP"},
        "14610": {"comment":"RAMTOP"},
        "14614": {"synopsis":"Clears the variables and sets a new RAMTOP, then resets the machine stack.\n1. Reclaims the variables area from NVARS up to ELINE less $025D ($1E53), and builds a fresh\n   one (RESET_VARS).\n2. $33DB and $0698 do the rest of the clearing.\n3. The new RAMTOP must be at least $B4 bytes past WKEND and within LASTPAGE, or it stops\n   with error code 48 (RAMTOP_ERR).\n4. RAMTOPP and RAMTOP are set, SP is moved to $4F00, the caller's error address is pushed\n   there and ERRSP points at it.\nEntry: C = the page of the new RAMTOP; HL = its address ($8000-$BFFF).\nExit: returns to the caller with the new stack.\nError: 48.","comment":"Keep the new RAMTOP"},
        "14616": {"comment":"C:DE = NVARS"},
        "14621": {"comment":"ELINE"},
        "14630": {"comment":"Less $025D"},
        "14636": {"comment":"BC = the end"},
        "14638": {"comment":"From NVARS"},
        "14641": {"comment":"Reclaim the variables"},
        "14644": {"comment":"A fresh variables area"},
        "14653": {"comment":"WKEND"},
        "14659": {"comment":"Plus $B4 bytes"},
        "14665": {"comment":"The new RAMTOP"},
        "14667": {"comment":"Below WKEND + $B4?"},
        "14672": {"comment":"LASTPAGE"},
        "14675": {"comment":"Within the last page?"},
        "14678": {"synopsis":"Stops with error code 48: the new RAMTOP is too low or past the last page.","comment":"Stops with error code 48"},
        "14680": {"synopsis":"Stores the new RAMTOP and resets the machine stack to $4F00, keeping the caller's return\naddress and the error address below it.\nEntry: C = RAMTOPP; DE = RAMTOP; the stack as CLEAR_TO left it.","comment":"RAMTOPP"},
        "14684": {"comment":"RAMTOP"},
        "14688": {"comment":"The return address"},
        "14689": {"comment":"The error address"},
        "14690": {"comment":"A new machine stack"},
        "14694": {"comment":"ERRSP"},
        "14698": {"comment":"Back to the caller"},
        "14699": {"synopsis":"Builds an empty variables area: silences the sound chip, clears GRARF and ONERRFLG, ends\nBASSTK's stack with $FF, fills the letter table at NVARS with $FF words except for x and y,\nwhich get the four variables copied from VAR_TEMPLATE (names ending \"os\" and \"rg\"), then\nsets NUMEND past them and SAVARS $0200 bytes further, ended by $FF. The last variable's\nvalue is set to 256, or 512 when THFATT is 0 (thin pixels).\nEntry: none.\nChanges: AF, BC, DE, HL, IY.","comment":"Sound chip off; A = 0"},
        "14702": {"comment":"GRARF = 0"},
        "14705": {"comment":"ONERRFLG = 0"},
        "14708": {"comment":"BASSTK"},
        "14711": {"comment":"Empty"},
        "14713": {"comment":"BSTKEND = BASSTK"},
        "14716": {"comment":"HL = NVARS"},
        "14719": {"comment":"23 letters: no variable"},
        "14721": {"synopsis":"RESET_VARS's loop: fills the letter table's first 46 bytes with $FF (no variable for a-w)."},
        "14726": {"comment":"DE past them"},
        "14727": {"comment":"x, y and two variables"},
        "14730": {"comment":"26 bytes"},
        "14734": {"comment":"Two more variables"},
        "14737": {"comment":"20 bytes"},
        "14741": {"comment":"HL past the variables"},
        "14742": {"comment":"NUMEND"},
        "14745": {"comment":"$0200 bytes on"},
        "14747": {"comment":"SAVARS"},
        "14750": {"comment":"No strings or arrays"},
        "14752": {"comment":"Back to NUMEND"},
        "14754": {"comment":"The last value's low byte"},
        "14757": {"comment":"Low byte 0"},
        "14759": {"comment":"High byte 1: 256"},
        "14761": {"comment":"THFATT"},
        "14766": {"comment":"Thin pixels: 512"},
        "14768": {"synopsis":"Stores the address HL, in the page HMPR holds, as SAVARSP and SAVARS (STORE_PPTR).\nEntry: HL = the address.\nChanges: IY.","comment":"SAVARSP"},
        "14774": {"synopsis":"Stores the address HL, in the page HMPR holds, as NUMENDP and NUMEND (STORE_PPTR).\nEntry: HL = the address.\nChanges: IY.","comment":"NUMENDP"},
        "14778": {"synopsis":"Stores a page and address pointer at IY: the HMPR page, then HL; an address past $BFFF is\nstored $4000 lower with the page one higher.\nEntry: IY = the pointer; HL = the address ($8000-$FFFF).\nExit: HL, AF kept."},
        "14779": {"comment":"HMPR"},
        "14781": {"comment":"Its page"},
        "14786": {"comment":"The address"},
        "14793": {"comment":"Past $BFFF?"},
        "14796": {"comment":"Yes: $4000 lower"},
        "14800": {"comment":"In the next page"},
        "14804": {"synopsis":"Writes 0 to every register of the sound chip, $1F down to $00.\nExit: A = 0, B = 0, C = $FF.","comment":"32 registers"},
        "14806": {"synopsis":"SOUND_OFF's loop: selects register A-1 and writes 0 to it.","comment":"Port $01FF"},
        "14809": {"comment":"The next register down"},
        "14810": {"comment":"Sound chip: select register A"},
        "14812": {"comment":"Port $00FF"},
        "14813": {"comment":"Sound chip: write 0"},
        "14815": {"comment":"Register 0 done?"},
        "14819": {"synopsis":"Data: the start of a fresh numeric variables area, copied by RESET_VARS. The first 6 bytes\nare the letter table's x, y and z words ($0019, $0003, $FFFF); then two variables, each 10\nbytes: the type/length byte 2 (three-letter names), the offset to the next one of the same\nletter, the name's other letters (\"os\", \"rg\") and the value (0, then 192 in the integer\nform). RESET_VARS copies the 20 bytes of variables twice: one pair for y, one for x."},
        "14845": {"synopsis":"Adds character A to the end of the string variable whose name is in STRM16NM (the output\nroutine $01AF calls it with ROM1 paged out): finds the variable ($1431), makes its length\none more (error 42 when it would reach 64K), opens room for the character at its end\n($1E18), stores it and writes the new 3-byte length (PUT_LEN3). HMPR is put back.\nEntry: A = the character.\nError: 2 when there is no such variable ($2D08); 42.","comment":"B = the character"},
        "14846": {"comment":"Keep HMPR"},
        "14850": {"comment":"STRM16NM: the name"},
        "14853": {"comment":"To the search buffer"},
        "14856": {"comment":"11 bytes"},
        "14859": {"comment":"A = the type/length byte"},
        "14862": {"comment":"C = the type"},
        "14863": {"comment":"Find the variable"},
        "14866": {"comment":"Not found: stops with error code 2"},
        "14870": {"comment":"Keep the variable's page"},
        "14875": {"comment":"Its length: the pages byte"},
        "14877": {"comment":"The low byte"},
        "14879": {"comment":"Pages into bits 7-6"},
        "14881": {"comment":"With the high byte"},
        "14883": {"comment":"One more"},
        "14884": {"comment":"Would it reach 64K?"},
        "14888": {"synopsis":"Stops with error code 42; a string length would reach 64K ($3A26) or 16K ($3EB8, $2CAB and\ntwo places in ROM1).","comment":"Stops with error code 42"},
        "14890": {"synopsis":"STR_CHAN_OUT with the new length: room for the character at the string's end, the character\nstored, the length written back.","comment":"Keep the new length"},
        "14891": {"comment":"HL = the string's end"},
        "14892": {"comment":"Carried past 64K: the next page"},
        "14895": {"comment":"Past $BFFF: the next page"},
        "14898": {"comment":"Open room for one byte"},
        "14902": {"comment":"The character"},
        "14903": {"comment":"Store it"},
        "14904": {"comment":"DE = the length field"},
        "14905": {"comment":"The variable's page"},
        "14908": {"comment":"Write the new length"},
        "14911": {"comment":"The caller's HMPR"},
        "14915": {"synopsis":"Writes BC as a 3-byte length at DE: the pages byte (bits 15-14 of BC), then BC MOD 16K\n(through PAGCOUNT and MODCOUNT).\nEntry: BC = the length; DE = where.\nExit: DE past the 3 bytes.\nChanges: BC, HL.","comment":"PAGCOUNT, MODCOUNT from BC"},
        "14918": {"comment":"PAGCOUNT"},
        "14921": {"comment":"3 bytes"},
        "14928": {"synopsis":"Reads an optional numeric expression at the BASIC pointer (OPT_NUM). When checking syntax,\nreturns from its caller too; when running, returns with the number on the calculator stack.\nEntry: the BASIC pointer at the character after the keyword.\nExit: carry (running).","comment":"The current character"},
        "14932": {"comment":"Running: back to the caller"},
        "14933": {"comment":"Checking: drop the caller"},
        "14935": {"synopsis":"Steps past the current character, then as SYN_NUM."},
        "14936": {"synopsis":"Checks or evaluates a numeric expression (EXPECT_NUM). When checking syntax, returns from\nits caller too.\nExit: carry (running); the number on the calculator stack.\nError: 29 for a string."},
        "14939": {"comment":"Running: back to the caller"},
        "14940": {"comment":"Checking: drop the caller"},
        "14942": {"synopsis":"Steps past the current character, then as SYN_2NUM."},
        "14943": {"synopsis":"Checks or evaluates two numeric expressions separated by a comma (TWO_NUM). When checking\nsyntax, returns from its caller too.\nExit: carry (running); both numbers on the calculator stack."},
        "14946": {"comment":"Running: back to the caller"},
        "14947": {"comment":"Checking: drop the caller"},
        "14949": {"synopsis":"Steps past the current character, then as SYN_STR."},
        "14950": {"synopsis":"Checks or evaluates a string expression (EXPECT_STR). When checking syntax, returns from its\ncaller too.\nExit: carry (running); the string on the calculator stack.\nError: 29 for a number."},
        "14953": {"comment":"Running: back to the caller"},
        "14954": {"comment":"Checking: drop the caller"},
        "14956": {"synopsis":"Tests A for a comma or a semicolon.\nEntry: A = the character.\nExit: Z for ',' or ';'.","comment":"','?"},
        "14959": {"comment":"';'?"},
        "14962": {"synopsis":"Tests A for TO ($8E), a comma, ':' or CR. The CP $DF hides the entry $3A79 (RST $18, then\nIS_STMT_END).\nEntry: A = the character.\nExit: Z for any of them.","comment":"TO?"},
        "14965": {"synopsis":"Tests A for a comma, ':' or CR.\nEntry: A = the character.\nExit: Z for any of them.","comment":"','?"},
        "14968": {"comment":"Hides $3A79: RST $18, then IS_STMT_END"},
        "14970": {"synopsis":"Tests A for the end of a statement, ':' or CR. Its entry $3A79 (hidden in the CP $DF before\nit) reads the current character first (RST $18).\nEntry: A = the character.\nExit: Z at the end of a statement.","comment":"':'?"},
        "14973": {"comment":"CR?"},
        "14977": {"synopsis":"Requires a semicolon or a comma at the BASIC pointer and steps past it.\nEntry: A = the current character.\nError: 29 for anything else.","comment":"';'?"},
        "14981": {"synopsis":"Requires a comma at the BASIC pointer and steps past it.\nEntry: A = the current character.\nError: 29 for anything else.","comment":"','?"},
        "14983": {"comment":"No: stops with error code 29"},
        "14985": {"synopsis":"Steps past the current character (RST $20) and returns."},
        "14987": {"synopsis":"Steps past the current character and requires '(' next, then steps past it too.\nError: 29 when '(' is missing."},
        "14988": {"comment":"'('?"},
        "14992": {"comment":"Past it"},
        "14994": {"synopsis":"A numeric expression (EXPECT_NUM) followed by ')', as NEED_RPAREN."},
        "14997": {"synopsis":"Requires ')' at the BASIC pointer and steps past it.\nEntry: A = the current character.\nError: 29 when it is missing.","comment":"')'?"},
        "15001": {"comment":"Past it"},
        "15003": {"synopsis":"Requires a comma, then a string expression (EXPECT_STR).\nError: 29.","comment":"The current character"},
        "15004": {"comment":"','?"},
        "15008": {"synopsis":"Steps past the current character, then as EXPECT_STR."},
        "15009": {"synopsis":"JEXPTSTR's body: checks the syntax of, or evaluates, an expression ($14E3) and requires it\nto be a string (FLAGS bit 6 clear).\nEntry: the BASIC pointer at the expression.\nExit: A = the next character; carry when running (FLAGS bit 7); the string on the calculator\nstack.\nError: 29 for a number.","comment":"The expression; A = FLAGS"},
        "15012": {"comment":"Carry: running; sign: numeric"},
        "15013": {"comment":"A = the next character"},
        "15014": {"comment":"A string: done"},
        "15015": {"synopsis":"Stops with error code 29: a character or expression of the wrong kind where the syntax\nrequires another.","comment":"Stops with error code 29"},
        "15017": {"synopsis":"A comma, a string expression and ')', then RPAREN_RUN."},
        "15022": {"synopsis":"Steps past the current character, then '(', two numeric expressions separated by a comma and\n')'.\nExit: carry when running.\nError: 29.","comment":"'('"},
        "15025": {"comment":"Two numbers"},
        "15030": {"comment":"'('"},
        "15033": {"comment":"A string"},
        "15036": {"comment":"','?"},
        "15040": {"synopsis":"Steps past the current character, then a numeric expression and ')', then RPAREN_RUN."},
        "15043": {"synopsis":"Requires ')' (NEED_RPAREN), then as IS_RUNNING.\nError: 29."},
        "15046": {"synopsis":"Tells whether a statement is running or having its syntax checked: carry from FLAGS bit 7\n(set when running; observed clear for the syntax pass of CLEAR 40000 and set for its run).\nExit: carry when running; A = FLAGS * 2 (sign: FLAGS bit 6).","comment":"FLAGS"},
        "15049": {"comment":"Bit 7 to carry"},
        "15051": {"synopsis":"Steps past the current character, then '(', a numeric expression, a comma, a string\nexpression and ')'.\nExit: carry when running.\nError: 29."},
        "15059": {"synopsis":"Steps past the current character, then as FOUR_NUM."},
        "15060": {"synopsis":"Four numeric expressions separated by commas: two pairs, each read by the routine at $3ADC.\nExit: carry when running.\nError: 29.","comment":"Two numbers"},
        "15063": {"comment":"','?"},
        "15068": {"synopsis":"Two numeric expressions separated by a comma.\nExit: carry when running.\nError: 29.","comment":"The first number"},
        "15071": {"synopsis":"Requires a comma, then a numeric expression.\nEntry: A = the current character.\nError: 29.","comment":"','?"},
        "15075": {"synopsis":"Steps past the current character, then as EXPECT_NUM."},
        "15076": {"synopsis":"JEXPTINUM's body: checks the syntax of, or evaluates, an expression ($14E3) and requires it\nto be numeric (FLAGS bit 6 set).\nEntry: the BASIC pointer at the expression.\nExit: A = the next character; carry when running (FLAGS bit 7); the number on the calculator\nstack.\nError: 29 for a string.","comment":"The expression; A = FLAGS"},
        "15079": {"comment":"Carry: running; sign: numeric"},
        "15080": {"comment":"A = the next character"},
        "15081": {"comment":"Numeric: done"},
        "15082": {"comment":"A string: stops with error code 29"},
        "15084": {"synopsis":"Requires A to be a letter (IS_LETTER).\nEntry: A = the character.\nExit: carry.\nError: 29."},
        "15087": {"comment":"A letter: done"},
        "15090": {"synopsis":"Calls $1345 (which, when running, sets DEVICE to the upper screen and sets up the temporary\ncolours, then reads the items before the coordinates), then two numeric expressions\nseparated by a comma (TWO_NUM).\nExit: carry when running.","comment":"The items before the numbers"},
        "15095": {"synopsis":"An optional numeric expression: at the end of a statement there is none and 0 is stacked\nwhen running; otherwise EXPECT_NUM.\nEntry: A = the current character.\nExit: carry when running; the number (or 0) on the calculator stack.","comment":"End of the statement?"},
        "15098": {"comment":"No: a number"},
        "15100": {"synopsis":"When running, stacks 0 on the calculator stack; returns with carry. When checking syntax,\nreturns with no carry.","comment":"FLAGS"},
        "15103": {"comment":"Running?"},
        "15105": {"comment":"Stack 0"},
        "15109": {"comment":"Carry: running"},
        "15111": {"synopsis":"Steps past the current character, then as EXPR_ANY."},
        "15112": {"synopsis":"JEXPTEXPR's body: checks the syntax of, or evaluates, an expression of either kind ($14E3).\nEntry: the BASIC pointer at the expression.\nExit: A = the next character; carry when running; NZ for a number, Z for a string.","comment":"The expression; A = FLAGS"},
        "15115": {"comment":"Carry: running"},
        "15116": {"comment":"Numeric?"},
        "15118": {"comment":"A = the next character"},
        "15120": {"synopsis":"Pages in the BASIC line's page (CHADP), then as SYNTAX_STOP. The CP $E7 hides the entry\n$3B14: RST $20 (past the current character), then SYNTAX_STOP.","comment":"HMPR: the page of CHAD"},
        "15123": {"comment":"Hides $3B14: RST $20"},
        "15125": {"synopsis":"Ends a command after its syntax check: when checking syntax, returns from its caller too;\nwhen running, returns with carry.\nEntry: A = the current character.\nExit: A kept; carry.","comment":"Keep the character"},
        "15126": {"comment":"FLAGS"},
        "15129": {"comment":"Running?"},
        "15131": {"comment":"Running: back to the caller"},
        "15132": {"comment":"Checking: drop the caller"},
        "15134": {"synopsis":"Tests A for a letter, A-Z or a-z.\nEntry: A = the character.\nExit: carry for a letter; A kept.","comment":"Below 'A'?"},
        "15138": {"comment":"Past 'z'?"},
        "15141": {"comment":"A-Z?"},
        "15144": {"comment":"'a' or more?"},
        "15148": {"synopsis":"Tests A for a letter or a digit.\nEntry: A = the character.\nExit: carry for either; A kept.","comment":"A letter?"},
        "15152": {"synopsis":"Tests A for a digit, 0-9.\nEntry: A = the character.\nExit: carry for a digit; A kept.","comment":"Past '9'?"},
        "15155": {"comment":"'0' or more?"},
        "15159": {"synopsis":"Tests A for a letter, '$' or '_'.\nEntry: A = the character.\nExit: carry for any of them; A kept.","comment":"A letter?"},
        "15163": {"comment":"'$'?"},
        "15169": {"synopsis":"Tests A for a letter, a digit or '_'.\nEntry: A = the character.\nExit: carry for any of them; A kept.","comment":"A letter or digit?"},
        "15173": {"synopsis":"Tests A for '_'.\nExit: carry for '_'; A kept.","comment":"'_'?"},
        "15179": {"synopsis":"Reads an optional line range into FIRST and LAST: nothing (1 to $FEFF), \"n\" (n to n), \"n TO\"\n(n to $FEFF), \"n TO m\" or \"TO m\". The numbers are stored only when running: the first in\nFIRST (and in LAST without TO), a TO number in LAST unless it is past $FEFF.\nEntry: A = the current character.\nExit: carry when the first number is below 1 (FIRST is set to it) or a TO number past $FEFF.\nChanges: AF, BC, HL.","comment":"FIRST: 1"},
        "15182": {"comment":"LAST: $FEFF"},
        "15192": {"comment":"TO first?"},
        "15196": {"comment":"A letter or digit?"},
        "15199": {"comment":"No: the whole program"},
        "15200": {"comment":"The first number"},
        "15203": {"comment":"Checking syntax"},
        "15205": {"comment":"Below FIRST (1)?"},
        "15212": {"comment":"FIRST = the number"},
        "15216": {"synopsis":"After the first number: with no TO, LAST is set to it too.","comment":"TO?"},
        "15218": {"comment":"A = 0 (NC on the way out)"},
        "15220": {"comment":"No: LAST = the number"},
        "15222": {"synopsis":"The TO part: an optional second number for LAST.","comment":"Past TO"},
        "15223": {"comment":"A number after it?"},
        "15226": {"comment":"No: LAST stays $FEFF"},
        "15227": {"comment":"The number"},
        "15230": {"comment":"Checking syntax: done"},
        "15232": {"comment":"LAST"},
        "15235": {"comment":"Past $FEFF?"},
        "15238": {"comment":"HL = the number"},
        "15240": {"synopsis":"Stores HL as LAST and returns with no carry.","comment":"LAST"},
        "15245": {"synopsis":"Steps past the current character, then as LINE_NUM_EXPR."},
        "15246": {"synopsis":"A numeric expression (EXPECT_NUM); when running, it is taken from the calculator stack into\nBC and HL ($1D2E).\nExit: carry when checking syntax; when running, no carry, HL = BC = the number, A = the\ncurrent character.","comment":"The number"},
        "15249": {"comment":"Checking syntax: carry"},
        "15251": {"comment":"BC = the number"},
        "15254": {"comment":"The current character"},
        "15259": {"synopsis":"The DISPLAY command (its entry in the command table): takes an optional screen number (0\nwhen there is none), stores it in CURDISP and shows that screen: 0 the current one\n(CUSCRNP), any other after ROM1 $D282 has accepted it (error 43 if not). ROM1 $E52C works\nout the screen; with Z there is nothing to change. Otherwise the 40 bytes at $55D8 are saved\nwith the screen shown so far, VMPR gets the new one and its 40 bytes are loaded\n(SWAP_SCREEN_40).\nEntry: the BASIC pointer at the character after the keyword.\nError: 43.","comment":"Optional screen number"},
        "15262": {"comment":"A = the number"},
        "15265": {"synopsis":"DISPLAY with A as the screen number: stores it in CURDISP and shows that screen.\nEntry: A = the screen number (0: the current one).","comment":"CURDISP"},
        "15268": {"comment":"0: the current screen"},
        "15271": {"comment":"Does the screen exist?"},
        "15274": {"comment":"Yes"},
        "15276": {"synopsis":"Stops with error code 43 (ROM1 jumps here from the screen commands too).","comment":"Stops with error code 43"},
        "15278": {"synopsis":"DISPLAY 0: the screen is CUSCRNP's.","comment":"CUSCRNP"},
        "15281": {"synopsis":"Shows the screen A through ROM1 $E52C: returns at once on Z, otherwise swaps the 40 bytes at\n$55D8 and writes D to VMPR."},
        "15284": {"comment":"Nothing to change?"},
        "15285": {"comment":"D: the new VMPR value"},
        "15286": {"comment":"NC: save to the old screen"},
        "15290": {"comment":"A = D"},
        "15291": {"comment":"VMPR: the new screen"},
        "15293": {"comment":"Carry: load from the new screen"},
        "15294": {"synopsis":"Copies the 40 bytes at $55D8 to or from $BFD8 in page A + 1 (the screen's second page) at\n$8000. Carry: from the screen's page to $55D8; no carry: from $55D8 to the screen's page.\nHMPR is put back.\nEntry: A = the screen's page (bits 4-0); carry as above.\nChanges: AF, BC, DE, HL.","comment":"Keep the flags"},
        "15295": {"comment":"Keep HMPR"},
        "15299": {"comment":"Keep the carry"},
        "15300": {"comment":"Its second page"},
        "15301": {"comment":"HMPR"},
        "15304": {"comment":"In the screen"},
        "15307": {"comment":"In the system page"},
        "15311": {"comment":"Carry: screen to system"},
        "15313": {"comment":"No carry: system to screen"},
        "15314": {"synopsis":"SWAP_SCREEN_40's copy of 40 bytes, then HMPR put back.","comment":"40 bytes"},
        "15319": {"comment":"HMPR put back"},
        "15322": {"synopsis":"Makes screen A the current one (CUSCRNP) and loads its saved variables: the 60 bytes at\n$5A34-$5A6F from $FEB0 and the 64 bytes at $5B00-$5B3F (CEXTAB, EXTAB) from $FF7C in the\nscreen's pages at $8000. The LD H,$A7 hides SAVE_SCREEN_VARS's entry at $3BDF (AND A), which\ncopies the other way, from the system variables into the current screen.\nEntry: A = the screen's page.\nChanges: AF, BC, DE, HL; the paging is put back.","comment":"CUSCRNP"},
        "15325": {"comment":"Carry: from the screen"},
        "15326": {"comment":"Hides $3BDF: AND A (to the screen)"},
        "15328": {"comment":"The screen variables"},
        "15331": {"comment":"Their copy in the screen"},
        "15334": {"comment":"No carry: system to screen"},
        "15337": {"synopsis":"Copies the screen variables between the system page and the screen: 60 bytes, a $90-byte\ngap, 64 bytes; then the paging put back (RESTORE_PAGING).","comment":"The screen at $8000"},
        "15340": {"comment":"60 bytes"},
        "15345": {"comment":"Skip $90 bytes"},
        "15351": {"comment":"64 bytes"},
        "15355": {"comment":"Paging put back"},
        "15358": {"synopsis":"Searches DE bytes at HL for the pattern at $4F00 (ROM1 calls it through CALL_INLINE). A\npattern character equal to C' matches any character.\nEntry: HL = the text; DE = its length; A = the pattern's length; the pattern at $4F00; C' =\nthe character that matches anything; BC = a base for the position.\nExit: found: no carry, BC = the base + the position of the match's first character (1 for\nthe first); not found: carry, BC = 0, DE = the base.\nChanges: AF, AF', BC, DE, HL.","comment":"Keep the base"},
        "15359": {"comment":"BC = the text's length"},
        "15361": {"comment":"The pattern"},
        "15364": {"comment":"Keep the length"},
        "15365": {"synopsis":"Looks for the pattern's first character in the rest of the text; then compares the rest of\nthe pattern (the LD A,$23 hides the loop's INC HL at $3C0F).","comment":"Keep the pattern length"},
        "15367": {"comment":"Its first character"},
        "15368": {"comment":"Find it"},
        "15370": {"comment":"Not in the text"},
        "15373": {"comment":"Keep where it was found"},
        "15374": {"comment":"Hides $3C0F: INC HL"},
        "15376": {"comment":"The count left"},
        "15377": {"comment":"All matched?"},
        "15381": {"comment":"The next pattern character"},
        "15383": {"comment":"Same as the text?"},
        "15386": {"comment":"The any-character code?"},
        "15391": {"comment":"No: back to the pattern start"},
        "15394": {"comment":"And the text after the first match"},
        "15398": {"synopsis":"The pattern matched: BC = the base + the position of the match.","comment":"Drop the saved values"},
        "15400": {"comment":"The length"},
        "15402": {"comment":"Less what was left"},
        "15404": {"comment":"Plus the base"},
        "15409": {"synopsis":"No match: drops the saved values and returns with carry and BC = 0.","comment":"Drop the saved values"},
        "15411": {"synopsis":"Pops DE, then returns with carry and BC = 0 (ROM1 jumps here)."},
        "15412": {"synopsis":"Returns with carry and BC = 0 (ROM1 jumps here).","comment":"BC = 0"},
        "15415": {"comment":"Carry: not found"},
        "15417": {"synopsis":"Prints a character pattern on the current screen: ROM1 paged out, CUSCRNP's page in HMPR,\nPRINT_PATTERN, then LMPR and HMPR put back.\nEntry: as PRINT_PATTERN.","comment":"Save LMPR, HMPR; ROM1 out"},
        "15420": {"comment":"HMPR: the current screen"},
        "15423": {"comment":"Print the pattern"},
        "15426": {"synopsis":"Puts back the LMPR and then the HMPR that SAVE_PAGING pushed.\nEntry: LMPR, then HMPR on the stack.\nChanges: AF (A = the HMPR value).","comment":"LMPR put back"},
        "15429": {"synopsis":"Puts back the HMPR on the stack.\nEntry: the HMPR on the stack.\nChanges: AF.","comment":"HMPR put back"},
        "15433": {"synopsis":"Pushes HMPR and then LMPR on the caller's stack and pages ROM1 out; RESTORE_PAGING2 pops\nthem.\nExit: LMPR on top of the stack, then HMPR.\nChanges: AF, IY.","comment":"The return address"},
        "15435": {"comment":"Push HMPR"},
        "15438": {"comment":"Push LMPR"},
        "15441": {"comment":"ROM1 out"},
        "15447": {"synopsis":"Reads the line number (high byte first) stored after HL, in the program's page, and returns\nFIRST in HL (ROM1 calls it).\nEntry: DE = the address before the line number.\nExit: DE = the line number; HL = FIRST; HMPR as on entry.\nChanges: AF, BC.","comment":"HL = the line"},
        "15449": {"comment":"Keep HMPR"},
        "15452": {"comment":"The program's page"},
        "15455": {"comment":"High byte first"},
        "15458": {"comment":"FIRST"},
        "15463": {"synopsis":"Copies BC bytes from HL to new room at WKEND ($1E80) and puts the copy on the calculator\nstack as a string ($1CE7). The paging is put back.\nEntry: HL = the bytes; BC = the count.\nExit: HL = the copy's start.","comment":"Save LMPR, HMPR; ROM1 out"},
        "15467": {"comment":"Room for BC bytes: DE"},
        "15473": {"comment":"Copy them"},
        "15477": {"comment":"Stack the copy as a string"},
        "15480": {"comment":"HL = the copy"},
        "15483": {"synopsis":"Draws a character's pattern at the print position in the current screen mode (MODE: 0-3 for\nmodes 1-4), at most 8 rows (CSIZEH). Each pattern row is XORed with C, and the screen byte\nis ANDed with B first: B = 0 replaces, B = $FF XORs (OVER). Mode 1 and 2 cells also get the\ntemporary attribute.\nEntry: HL = the pattern; B = the screen mask; C = the inverting byte; the screen paged in at\n$8000.\nChanges: AF, BC, DE, HL, the alternates.","comment":"CSIZEH"},
        "15486": {"comment":"DE' = the pattern"},
        "15489": {"comment":"More than 8 rows?"},
        "15493": {"comment":"At most 8"},
        "15495": {"synopsis":"Sets the row count B' and picks the mode's drawing loop.","comment":"B' = the rows"},
        "15497": {"comment":"MODE"},
        "15500": {"comment":"Mode 3?"},
        "15504": {"comment":"Mode 4"},
        "15507": {"comment":"Mode 2?"},
        "15510": {"comment":"Mode 1: DE = the cell"},
        "15513": {"comment":"Keep it for the attribute"},
        "15515": {"synopsis":"Mode 1's row loop: one screen byte a row, down the cell's pixel lines."},
        "15516": {"comment":"The screen byte"},
        "15517": {"comment":"Masked"},
        "15518": {"comment":"With the pattern row"},
        "15519": {"comment":"Inverted"},
        "15520": {"comment":"Store"},
        "15522": {"comment":"The next pixel line"},
        "15523": {"comment":"Past a character row?"},
        "15528": {"comment":"Yes: the next row's first line"},
        "15533": {"synopsis":"The next row of mode 1's loop; then the cell's attribute from its first line's address."},
        "15534": {"comment":"Rows left?"},
        "15536": {"comment":"The cell's address"},
        "15537": {"comment":"Z: mode 1"},
        "15541": {"synopsis":"Mode 2: one screen byte a row, 32 bytes a line; then 8 attribute bytes, $2000 above the\npixels, get the temporary attribute.","comment":"DE = the cell"},
        "15545": {"synopsis":"Mode 2's row loop."},
        "15546": {"comment":"The screen byte"},
        "15547": {"comment":"Masked"},
        "15548": {"comment":"With the pattern row"},
        "15549": {"comment":"Inverted"},
        "15550": {"comment":"Store"},
        "15552": {"comment":"The next line: 32 bytes on"},
        "15559": {"synopsis":"The next row of mode 2's loop; then the attributes."},
        "15560": {"comment":"Rows left?"},
        "15563": {"comment":"The attributes below the pixels"},
        "15567": {"comment":"The first one"},
        "15570": {"comment":"7 more"},
        "15575": {"synopsis":"Copies the attribute A down 7 more lines, 32 bytes apart.","comment":"The next line"},
        "15576": {"comment":"Same attribute"},
        "15580": {"synopsis":"Mode 3: two bits a pixel, the pattern bits expanded to screen bytes through CEXTAB ($5B00).\nWith 6-pixel cells (FL60R8 0) an even column starts on a byte, an odd one in the middle of\none (PAT_M3_ODD). With 8-pixel cells the pattern is first copied to $5121 rotated right one\nbit.","comment":"DE = the cell; carry: 6-pixel"},
        "15583": {"comment":"HL: CEXTAB"},
        "15585": {"comment":"The inverting byte"},
        "15587": {"comment":"To C'"},
        "15588": {"comment":"6-pixel cells?"},
        "15590": {"comment":"8-pixel cells: a buffer"},
        "15594": {"synopsis":"Copies the pattern to the buffer at $5121, each row rotated right one bit.","comment":"A pattern row"},
        "15595": {"comment":"Rotated"},
        "15601": {"comment":"The row count"},
        "15602": {"comment":"The pattern: the buffer"},
        "15609": {"synopsis":"6-pixel cells: an odd column goes to PAT_M3_ODD; an even one keeps the low nibble of the\nsecond byte (mask B OR $0F)."},
        "15610": {"comment":"The mask"},
        "15611": {"comment":"Odd column?"},
        "15613": {"comment":"Keep the second byte's right half"},
        "15616": {"synopsis":"Sets the second byte's mask C from A, then PAT_M3E_ROW."},
        "15617": {"synopsis":"Mode 3's row loop for a cell that starts on a byte: pattern bits 6-3 through CEXTAB to the\nfirst byte, bits 3-0 (shifted up) to the second.","comment":"A pattern row"},
        "15618": {"comment":"Inverted"},
        "15622": {"comment":"Bits 6-3"},
        "15627": {"comment":"CEXTAB entry"},
        "15628": {"comment":"The screen byte"},
        "15629": {"comment":"Mixed in under the mask"},
        "15632": {"comment":"Store"},
        "15634": {"comment":"The row again"},
        "15635": {"comment":"The lower bits"},
        "15638": {"comment":"CEXTAB entry"},
        "15639": {"comment":"The second byte"},
        "15640": {"comment":"Under mask C"},
        "15643": {"comment":"Store"},
        "15644": {"comment":"The next line: 128 bytes on"},
        "15651": {"synopsis":"The next row of PAT_M3E_ROW's loop."},
        "15652": {"comment":"Rows left?"},
        "15655": {"synopsis":"6-pixel cells in an odd column: the first byte keeps its left half (mask B OR $F0); the\npattern's high bits go to its right half, the rest to the next byte.","comment":"Keep the first byte's left half"},
        "15659": {"synopsis":"Mode 3's row loop for a cell that starts in the middle of a byte.","comment":"A pattern row"},
        "15660": {"comment":"Inverted"},
        "15664": {"comment":"The high bits"},
        "15669": {"comment":"CEXTAB entry"},
        "15670": {"comment":"The screen byte"},
        "15671": {"comment":"Under mask C"},
        "15674": {"comment":"Store"},
        "15676": {"comment":"The row again"},
        "15677": {"comment":"The lower bits"},
        "15680": {"comment":"CEXTAB entry"},
        "15681": {"comment":"The second byte"},
        "15682": {"comment":"Under mask B"},
        "15685": {"comment":"Store"},
        "15686": {"comment":"The next line: 128 bytes on"},
        "15693": {"synopsis":"The next row of PAT_M3O_ROW's loop."},
        "15694": {"comment":"Rows left?"},
        "15697": {"synopsis":"Mode 4: four bits a pixel, 4 screen bytes a row; each nibble of the pattern row picks a\n2-byte entry of CEXTAB.","comment":"DE = the cell"},
        "15700": {"comment":"HL: CEXTAB"},
        "15702": {"comment":"The inverting byte"},
        "15704": {"comment":"To C'"},
        "15705": {"synopsis":"Mode 4's row loop.","comment":"A pattern row"},
        "15706": {"comment":"Inverted"},
        "15709": {"comment":"Keep it"},
        "15710": {"comment":"The high nibble * 2"},
        "15715": {"comment":"CEXTAB entry"},
        "15716": {"comment":"The screen byte"},
        "15717": {"comment":"Masked"},
        "15718": {"comment":"With the entry's first byte"},
        "15720": {"comment":"The entry's second byte"},
        "15722": {"comment":"The next screen byte"},
        "15727": {"comment":"The low nibble * 2"},
        "15732": {"comment":"Third screen byte"},
        "15738": {"comment":"Fourth screen byte"},
        "15742": {"comment":"The next line: 128 bytes on"},
        "15749": {"synopsis":"The next row of mode 4's loop."},
        "15750": {"comment":"Rows left?"},
        "15753": {"synopsis":"Gives the current device's print position and its right-hand limit: DEVICE 0 (the upper\nscreen) SPOSNU, 1 (the lower screen) SPOSNL, both with WINDRHS; otherwise (the printer)\nPRPOSN with PRRHS.\nExit: DE = the position; A = the right-hand limit; carry for the printer.","comment":"DEVICE"},
        "15756": {"comment":"Upper screen?"},
        "15759": {"comment":"SPOSNL"},
        "15763": {"comment":"Lower screen?"},
        "15766": {"comment":"PRPOSN"},
        "15770": {"comment":"PRRHS"},
        "15773": {"comment":"Carry: the printer"},
        "15775": {"synopsis":"The upper screen: DE = SPOSNU.","comment":"SPOSNU"},
        "15779": {"synopsis":"A = WINDRHS for a screen device.","comment":"WINDRHS"},
        "15783": {"synopsis":"A temporary output routine of the current channel ($047D sets it): puts OPSTORE back as the\nchannel's output routine ($0472) and goes on at ROM1 $DEF3 with the character.\nEntry: A = the character.","comment":"The saved output routine back"},
        "15789": {"synopsis":"A temporary output routine of the current channel (ROM1 $DCE8 sets it): goes on at ROM1\n$DCEE.\nEntry: A = the character."},
        "15792": {"synopsis":"Prints message A of the table UMSGS points to (as JPOMSG).\nEntry: A = the message number.","comment":"UMSGS"},
        "15796": {"synopsis":"JPOMSG's body: goes on at ROM1 $DD1B.\nEntry: A = the message number; DE = the table."},
        "15799": {"synopsis":"Gives the screen address of a character cell in the current mode.\nEntry: D = the row; E = the column (as in SPOSNU).\nExit: DE = the address in the screen at $8000; for mode 3, carry for 6-pixel cells and then\nZ for an even column.\nChanges: AF.","comment":"MODE"},
        "15802": {"comment":"Mode 1?"},
        "15805": {"comment":"Mode 2?"},
        "15808": {"comment":"Mode 3?"},
        "15811": {"synopsis":"Mode 4's cell address: 128 bytes a pixel line, 4 bytes a column.","comment":"D = the pixel line"},
        "15814": {"comment":"Column * 8"},
        "15818": {"comment":"D = $80 + line / 2"},
        "15821": {"comment":"Odd line: + 128"},
        "15824": {"synopsis":"Mode 2's cell address: 32 bytes a pixel line.","comment":"D = the pixel line"},
        "15827": {"comment":"Line * 32 spread over D, E"},
        "15832": {"comment":"With the column"},
        "15837": {"comment":"D = $80 + line / 8"},
        "15844": {"synopsis":"Mode 1's cell address (PIXEL_ADDR_M1 with x = column * 8).","comment":"D = the pixel line"},
        "15848": {"comment":"B = y"},
        "15849": {"comment":"C = column * 8"},
        "15855": {"comment":"HL = the address"},
        "15861": {"synopsis":"Mode 3's cell address: 128 bytes a pixel line; 2 bytes a column for 8-pixel cells (FL60R8\nnonzero, no carry), 1.5 for 6-pixel ones (CELL_M3_NARROW).","comment":"D = the pixel line"},
        "15864": {"comment":"FL60R8"},
        "15869": {"comment":"6-pixel cells?"},
        "15871": {"comment":"Column * 4"},
        "15874": {"comment":"D = $80 + line / 2"},
        "15879": {"synopsis":"Mode 3 with 6-pixel cells: column * 3 / 2 bytes in.\nExit: carry; Z for an even column.","comment":"Column * 3"},
        "15882": {"comment":"D = $80 + line / 2"},
        "15885": {"comment":"Z: an even column"},
        "15888": {"comment":"Carry: 6-pixel cells"},
        "15890": {"synopsis":"Turns the row D into its first pixel line ($0CD0, with CSIZEH), adding LSOFF for a device\nother than the upper screen.\nEntry: D = the row; E = the column.\nExit: D = the pixel line.\nChanges: AF.","comment":"A = the pixel line"},
        "15894": {"comment":"DEVICE"},
        "15897": {"comment":"The upper screen?"},
        "15899": {"comment":"LSOFF"},
        "15905": {"synopsis":"Gives the screen address of the pixel at (x, y) in the current mode. With thin pixels\n(THFATT 0, mode 3) x is HL, 0-511; otherwise C. The CP $69 hides the fat-pixel path's LD L,C\nat $3E2D.\nEntry: B = y; C = x (HL = x for thin pixels).\nExit: HL = the address in the screen at $8000; B = A = x's low bits (the pixel in the byte);\nmode 1 as PIXEL_ADDR_M1.\nChanges: AF, B, C.","comment":"THFATT"},
        "15908": {"comment":"Fat pixels?"},
        "15911": {"comment":"Thin: C = x low"},
        "15912": {"comment":"L = x / 2"},
        "15916": {"comment":"Hides $3E2D: LD L,C (fat pixels)"},
        "15918": {"comment":"H = y"},
        "15919": {"comment":"MODE"},
        "15922": {"comment":"Mode 1?"},
        "15925": {"comment":"Mode 2?"},
        "15928": {"comment":"Modes 3 and 4: the pixel bits"},
        "15931": {"synopsis":"Mode 1's pixel address: the thirds, character rows and pixel lines laid out as on the\nSpectrum's screen, at $8000.\nEntry: B = y (0-191); C = x.\nExit: HL = the address; A = x MOD 8.","comment":"L = y"},
        "15933": {"comment":"y / 8"},
        "15936": {"comment":"Plus $80"},
        "15938": {"comment":"The third"},
        "15941": {"comment":"With the pixel line"},
        "15944": {"comment":"H"},
        "15945": {"comment":"x"},
        "15949": {"comment":"Row bits of y"},
        "15953": {"comment":"With x / 8"},
        "15955": {"comment":"L"},
        "15956": {"comment":"x MOD 8"},
        "15960": {"synopsis":"Mode 2's pixel address: HL = $8000 + (y * 256 + x) / 8, 32 bytes a line.\nEntry: H = y; L = x.\nExit: HL = the address; B = A = x MOD 8.","comment":"x"},
        "15962": {"comment":"/ 2"},
        "15967": {"comment":"/ 4"},
        "15971": {"synopsis":"HL = $8000 + HL / 2 and B = A MOD 8: the address in modes 3 and 4 (128 bytes a line), the\nlast step of mode 2's.","comment":"The pixel bits"},
        "15974": {"comment":"Bit 15 set"},
        "15975": {"comment":"HL / 2 + $8000"},
        "15980": {"synopsis":"Sets the temporary attribute for the screen byte at HL: in mode 1 the attribute's address\ncomes from $0C49, otherwise it is $2000 above (bit 5 of H).\nEntry: HL = the screen address.\nChanges: AF, BC, H.","comment":"MODE"},
        "15983": {"comment":"Mode 1?"},
        "15985": {"comment":"Others: $2000 above"},
        "15987": {"synopsis":"In mode 1 (Z) turns the screen address's H into the attribute's ($0C49); then SET_ATTR_TEMP.","comment":"Mode 1: the attribute row"},
        "15990": {"comment":"H = the attribute's"},
        "15991": {"synopsis":"Writes the temporary attribute into the byte at HL: ATTRT where MASKT is 0, the old bits\nwhere MASKT is 1. PFLAGT bit 4 sets the ink bits to 7, or 0 when the attribute's bit 5 is\nset; bit 6 does the same for the paper bits with bit 2.\nEntry: HL = the attribute.\nExit: A = the new attribute.\nChanges: BC.","comment":"C = ATTRT, B = MASKT"},
        "15995": {"comment":"The old attribute"},
        "15996": {"comment":"Old bits where MASKT is set"},
        "15999": {"comment":"C = PFLAGT"},
        "16003": {"comment":"Ink to contrast?"},
        "16007": {"comment":"Ink 7"},
        "16009": {"comment":"Paper bright?"},
        "16013": {"comment":"Ink 0"},
        "16015": {"synopsis":"SET_ATTR_TEMP's paper step: PFLAGT bit 6.","comment":"Paper to contrast?"},
        "16019": {"comment":"Paper 7"},
        "16021": {"comment":"Ink bright?"},
        "16025": {"comment":"Paper 0"},
        "16027": {"synopsis":"Stores the new attribute.","comment":"Store"},
        "16029": {"synopsis":"Compares the two strings on top of the calculator stack, byte by byte with each in its own\npage, and unstacks both. S1 is the top one, S2 the one below it.\nExit: Z when equal; carry when S1 sorts after S2 (a greater byte, or the same start and\nlonger); neither when S1 sorts before S2.\nError: 42 when the shorter one is 16K or longer.\nKeeps: HL; LMPR and HMPR.","comment":"Save LMPR, HMPR; ROM1 out"},
        "16033": {"comment":"S1: A = HMPR, DE, BC"},
        "16039": {"comment":"S2"},
        "16042": {"comment":"S1's length"},
        "16044": {"comment":"Z: equal lengths; carry: S1 shorter"},
        "16047": {"comment":"S2 not longer: BC is the shorter"},
        "16049": {"comment":"BC = S1's length"},
        "16051": {"synopsis":"Keeps the length flags in F' and sets up the loop: HMPR values in H (S1) and L (S2), the\naddresses in HL' (S1) and DE (S2).","comment":"L = S2's HMPR"},
        "16052": {"comment":"Keep the length flags"},
        "16054": {"comment":"16K or more?"},
        "16059": {"comment":"H = S1's HMPR"},
        "16062": {"comment":"C = the HMPR port"},
        "16065": {"comment":"The count"},
        "16066": {"comment":"S1's address"},
        "16069": {"synopsis":"Compares the next byte pair."},
        "16070": {"comment":"HMPR: S2's page"},
        "16072": {"comment":"S2's byte"},
        "16074": {"comment":"HMPR: S1's page"},
        "16077": {"comment":"Same as S1's?"},
        "16082": {"synopsis":"Counts the bytes left to compare.","comment":"Bytes left?"},
        "16086": {"comment":"The length flags"},
        "16087": {"comment":"Equal lengths: equal strings"},
        "16089": {"comment":"Carry: S1 longer"},
        "16090": {"synopsis":"Ends the comparison: HL put back, then RESTORE_KEEP_F.","comment":"HL as on entry"},
        "16091": {"synopsis":"Puts back the LMPR and HMPR SAVE_PAGING pushed, keeping the flags (and A') in AF'.\nEntry: LMPR, then HMPR on the stack.\nExit: AF as before the call.","comment":"Keep the result"},
        "16092": {"comment":"LMPR put back"},
        "16095": {"comment":"HMPR put back"},
        "16100": {"synopsis":"JSBUFFET's body: copies the string on the calculator stack to the buffer at $4F00\n(STR_TO_BUF_LIM).\nExit: DE = $4F00; BC = the length; NZ.\nError: 27 when it is empty or over 255 characters.","comment":"Copy it"},
        "16103": {"comment":"Not empty: done"},
        "16104": {"synopsis":"Stops with error code 27 (an empty or too long string; ROM1 jumps here too).","comment":"Stops with error code 27"},
        "16106": {"synopsis":"STR_TO_BUF_LIM with a limit of 255 characters.","comment":"At most 255"},
        "16108": {"synopsis":"Unstacks a string and copies it to the buffer at $4F00, with ROM1 paged out and the paging\nput back. Too long (A + its length's high byte past 255): error 27.\nEntry: A = $FF less the largest high byte of the length allowed.\nExit: Z for an empty string; otherwise DE = $4F00, BC = the length, NZ.\nError: 27.","comment":"Keep the limit"},
        "16109": {"comment":"Save LMPR, HMPR; ROM1 out"},
        "16112": {"comment":"The string, paged in"},
        "16115": {"comment":"The limit"},
        "16116": {"comment":"Too long?"},
        "16119": {"comment":"Empty?"},
        "16123": {"comment":"HL = the string"},
        "16124": {"comment":"The buffer"},
        "16129": {"comment":"Copy it"},
        "16135": {"synopsis":"Unstacks a string ($1D01) and gives the HMPR value that pages it in.\nExit: A = HMPR with the string's page in bits 4-0; DE = its address; BC = its length.\nChanges: H.","comment":"A = page, DE, BC"},
        "16139": {"comment":"HMPR"},
        "16141": {"comment":"Bits 7-5 kept, the page in 4-0"},
        "16146": {"comment":"Stops with error code 20"},
        "16148": {"synopsis":"ROOM_CHECK_PAGES keeping AF and BC."},
        "16156": {"synopsis":"Checks that a block of A pages and BC bytes fits between WKEND and RAMTOP. The CP $AF hides\nthe entry $3F24 (XOR A: BC bytes), which $1E80 uses before it claims room.\nEntry: A:BC = the size (A = 0 at $3F24).\nExit: A:HL = the page and address WKEND would move to; DE = the room that is left, bit 15\nset when it is 64K or more; BC = the size's low 16 bits.\nError: 1 when it does not fit (NO_ROOM_ERR).","comment":"The size as A pages, HL"},
        "16158": {"comment":"A:HL as one number"},
        "16161": {"comment":"BC = its low 16 bits"},
        "16163": {"comment":"Hides $3F24: XOR A"},
        "16166": {"comment":"D = the high part"},
        "16167": {"comment":"A:HL = WKEND as one number"},
        "16170": {"comment":"Plus the size"},
        "16172": {"comment":"Back to page and address"},
        "16177": {"comment":"C:DE = the new end"},
        "16179": {"comment":"RAMTOPP"},
        "16182": {"comment":"RAMTOP"},
        "16185": {"comment":"RAMTOP less the new end"},
        "16188": {"comment":"Below RAMTOP?"},
        "16190": {"comment":"The room left as one number"},
        "16194": {"comment":"64K or more?"},
        "16197": {"comment":"Bit 15 set"},
        "16199": {"synopsis":"Returns the new end in A:HL.","comment":"The new end"},
        "16203": {"synopsis":"Stops with error code 1: there is no room below RAMTOP (ROOM_CHECK_PAGES; $10C1, $1E25 and\nROM1 jump here too).","comment":"Stops with error code 1"},
        "16205": {"synopsis":"Copies up to 255 bytes from DE into new room at WKEND ($1E80), through the buffer at $4F00,\nand puts CR ($0D) in place of the last byte.\nEntry: DE = the text; BC = its length.\nExit: DE = the copy; HL = its last byte; BC = the length copied; LMPR put back; HMPR left on\nthe workspace's page, A = the HMPR on entry.","comment":"Over 255?"},
        "16209": {"comment":"At most 255"},
        "16212": {"synopsis":"TEXT_TO_WKSP's copy, with ROM1 paged out.","comment":"Save LMPR, HMPR; ROM1 out"},
        "16215": {"comment":"HL = the text"},
        "16216": {"comment":"The buffer"},
        "16221": {"comment":"Copy to it"},
        "16225": {"comment":"Room at WKEND: DE"},
        "16229": {"comment":"HL = the buffer"},
        "16231": {"comment":"Copy to the room"},
        "16235": {"comment":"The last byte"},
        "16236": {"comment":"Becomes CR"},
        "16238": {"comment":"LMPR put back"},
        "16241": {"comment":"A = the old HMPR"},
        "16243": {"synopsis":"Finds the variable named at the BASIC pointer ($13AA) and records where it is: its address\nat $5121, the HMPR value at $5123 and 7 bytes from it at $5124; then CHADP's page goes back\ninto HMPR (ROM1 calls it through CALL_INLINE).\nExit: AF, BC, DE as $13AA left them.","comment":"Find the variable"},
        "16249": {"comment":"Its address"},
        "16252": {"comment":"HMPR"},
        "16257": {"comment":"Its page"},
        "16259": {"comment":"7 bytes from it, then CHADP's page"},
        "16268": {"synopsis":"Splits the address on the calculator stack into a count of 16K pages and the rest: the\ncalculator divides by 16K (constant 2, operation $08, memory 3); A must be below $21.\nExit: A = the address div 16K; BC = the address MOD 16K (observed: 40000 gives A = 2 and HL\n= BC = $1C40).\nError: 30 for 33 pages or more."},
        "16273": {"comment":"A = the pages"},
        "16276": {"comment":"More than 32?"},
        "16282": {"comment":"BC = the rest"},
        "16287": {"synopsis":"Pages in the address on the calculator stack ($126F) and moves an address past $BFFF to the\nnext page (NEXT_PAGE_HL).\nExit: HL below $C000 in the page HMPR holds.","comment":"Page it in"},
        "16290": {"comment":"Past $BFFF?"},
        "16296": {"synopsis":"Saves LMPR in CLRP and HMPR in CURP, pages ROM1 out and puts the current screen (CUSCRNP) in\nHMPR. RESTORE_PAGING undoes it.\nChanges: AF.","comment":"LMPR"},
        "16298": {"comment":"CLRP"},
        "16301": {"comment":"ROM1 out"},
        "16305": {"synopsis":"Saves HMPR in CURP and puts the current screen in HMPR.\nChanges: AF.","comment":"HMPR"},
        "16307": {"comment":"CURP"},
        "16310": {"synopsis":"Puts the current screen's page (CUSCRNP) in HMPR.\nChanges: AF.","comment":"CUSCRNP"},
        "16315": {"synopsis":"Reads the byte at HL in the current screen.\nEntry: HL = the address ($8000-$FFFF).\nExit: A = the byte; the paging put back.","comment":"The screen in"},
        "16318": {"comment":"The byte"},
        "16319": {"synopsis":"Puts LMPR back from CLRP and HMPR from CURP, keeping AF. The LD A,$08 hides the entry $3FC6\n(EX AF,AF'), which puts back only HMPR.\nExit: AF as on entry.","comment":"Keep AF"},
        "16320": {"comment":"CLRP"},
        "16323": {"comment":"LMPR put back"},
        "16325": {"comment":"Hides $3FC6: EX AF,AF'"},
        "16327": {"comment":"CURP"},
        "16330": {"comment":"HMPR put back"},
        "16334": {"synopsis":"Sets CHADP to A, pages ROM1 out and puts CHADP's page in HMPR.\nEntry: A = the page.\nChanges: AF.","comment":"CHADP"},
        "16337": {"synopsis":"Pages ROM1 out and puts CHADP's page in HMPR.\nChanges: AF.","comment":"LMPR"},
        "16339": {"comment":"ROM1 out"},
        "16343": {"synopsis":"Puts CHADP's page (the BASIC pointer's) in HMPR.\nChanges: AF.","comment":"CHADP"},
        "16348": {"synopsis":"Unstacks a string ($1D01) and pages it in at $8000.\nExit: DE = its address; BC = its length; A = the HMPR value.","comment":"A = page, DE, BC"},
        "16351": {"synopsis":"Puts page A in HMPR, keeping HMPR's bits 7-5.\nEntry: A = the page (bits 4-0).\nExit: A = the HMPR value; HL kept."},
        "16352": {"comment":"H = the page"},
        "16353": {"comment":"HMPR"},
        "16355": {"comment":"Bits 7-5 kept, the page in 4-0"},
        "16359": {"comment":"HMPR: the page"},
        "16363": {"synopsis":"Moves DE from $C000-$FFFF back to $8000-$BFFF and HMPR on to the next page.\nEntry: DE = the address.\nChanges: AF.","comment":"DE $4000 lower"},
        "16367": {"synopsis":"An HL past $BFFF moves $4000 lower with HMPR on to the next page; any other HL is left.\nChanges: AF.","comment":"Past $BFFF?"},
        "16370": {"synopsis":"Moves HL $4000 lower and HMPR on to the next page.\nChanges: AF.","comment":"HL $4000 lower"},
        "16372": {"synopsis":"Puts the page after HMPR's into HMPR.\nChanges: AF.","comment":"HMPR"},
        "16374": {"comment":"The next page"},
        "16377": {"synopsis":"Moves HL $4000 higher and HMPR back to the previous page.\nChanges: AF.","comment":"HL $4000 higher"},
        "16379": {"comment":"HMPR"},
        "16381": {"comment":"The previous page"}
      }
    },
