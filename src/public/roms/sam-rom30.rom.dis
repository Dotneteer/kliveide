        "9539": {"comment":"Each byte: NET_PUT_BYTE"},
        "9543": {"comment":"Send the block"},
        "9546": {"comment":"The check byte"},
        "9549": {"synopsis":"Sends A over MIDI OUT (port $FD) once the byte before has gone (TXFMST, port $F8 bit 1,\nclear), testing ESC (error 14).\nEntry: A = the byte.\nExit: AF as on entry.","comment":"Keep the byte"},
        "9550": {"synopsis":"Loop: waits for TXFMST to clear.","comment":"ESC? Error 14"},
        "9553": {"comment":"Port $F8 read with A = 0"},
        "9554": {"comment":"LPEN"},
        "9556": {"comment":"TXFMST: a byte still going out?"},
        "9560": {"comment":"ESC? Error 14"},
        "9563": {"comment":"The byte"},
        "9564": {"comment":"MIDI OUT"},
        "9567": {"synopsis":"Saves a block on tape (the network: NET_SAVE): a leader of 3000 x ceil(256 / H) edges (twice\nas many for flag 0), two sync edges, then the flag byte, the bytes and the XOR check byte\n(sent twice), each bit two edges of H counts (a 1) or L counts (a 0), H = 2 x SLNUMT + 3 (at\nmost 255) and L = SLNUMT. Port $FE carries MIC and the border. ESC stops it.\nEntry: A = the flag byte; HL = the start (HMPR paged); C, DE = the length (pages, offset).\nExit: carry clear when it was saved, set when ESC stopped it (JSAVE_BODY turns it round).\nChanges: all, the alternate registers.","comment":"No interrupts"},
        "9568": {"comment":"Keep the flag byte"},
        "9569": {"comment":"Tape?"},
        "9572": {"comment":"No: the network"},
        "9574": {"comment":"C:DE as a linear count"},
        "9577": {"comment":"The flag byte"},
        "9579": {"comment":"Timing registers"},
        "9580": {"comment":"B = the flag byte"},
        "9581": {"comment":"A': the XOR check, from the flag byte"},
        "9582": {"comment":"SLNUMT: the speed"},
        "9585": {"comment":"L: the count for a 0 half"},
        "9586": {"comment":"2 x (SLNUMT + 1)"},
        "9588": {"comment":"Past 255?"},
        "9590": {"comment":"Yes: $FF"},
        "9592": {"synopsis":"H = the count of a 1 half, L of a 0 half.","comment":"+ 1"},
        "9593": {"comment":"H: the count for a 1 half"},
        "9594": {"comment":"Keep them"},
        "9595": {"comment":"C: the leader's half"},
        "9596": {"comment":"HL = 0, A = 0"},
        "9599": {"comment":"3000 edges each pass"},
        "9602": {"synopsis":"Loop: 3000 more leader edges for every C that fits in 256.","comment":"HL = 3000 x passes"},
        "9603": {"comment":"Until A passes 256"},
        "9606": {"comment":"The flag byte 0?"},
        "9609": {"comment":"Yes: a leader twice as long"},
        "9610": {"synopsis":"Sends the leader (HL edges of C), then the two sync edges (C / 4 + 3).","comment":"D: border 2; E: two passes"},
        "9613": {"synopsis":"One edge: flips the level and waits C.","comment":"The other level"},
        "9617": {"comment":"MIC and the border"},
        "9619": {"comment":"A half"},
        "9620": {"synopsis":"Loop: waits B."},
        "9623": {"comment":"The next edge"},
        "9626": {"comment":"Until HL is 0"},
        "9628": {"comment":"The sync's half: C / 4 + 3"},
        "9635": {"comment":"Two edges"},
        "9637": {"comment":"The leader, then the sync"},
        "9640": {"comment":"H, L: the bit counts"},
        "9641": {"comment":"The flag byte"},
