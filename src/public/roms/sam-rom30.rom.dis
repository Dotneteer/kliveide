        "9307": {"comment":"Yes: the next header"},
        "9309": {"comment":"Show the names?"},
        "9313": {"comment":"A new line"},
        "9315": {"comment":"No: done"},
        "9318": {"synopsis":"Reads a header block (flag byte 1, 80 bytes) into $4B50 through JLOAD_BODY. A SAM header\n(type bit 4) stays as it is. A Spectrum header (17 bytes, read as flag 1) of type 3 becomes\ntype $13, or $14 when it starts in $4000-$5AFF (mode byte 0, else $20), with its length and\nstart as pages and offsets at $4B72 and $4B6F and no auto-run; the flags byte ($4B5F) is set\nto 0.\nExit: carry set when a header was read.\nChanges: all.","comment":"Load to $4B50"},
        "9321": {"comment":"80 bytes"},
        "9324": {"comment":"C = 0, A = 1: a header block"},
        "9327": {"comment":"Carry: load"},
        "9328": {"comment":"Read it"},
        "9331": {"comment":"Failed?"},
        "9332": {"comment":"The type"},
        "9336": {"comment":"Bit 4: a SAM file"},
        "9338": {"comment":"Yes: done (carry set)"},
        "9339": {"comment":"A Spectrum file: CODE (3)?"},
        "9341": {"comment":"The flags byte: 0"},
        "9346": {"comment":"No: done"},
        "9347": {"comment":"CODE: type $13"},
        "9349": {"comment":"DE = the type"},
        "9350": {"comment":"A:HL = its length"},
        "9354": {"comment":"As a page and an offset"},
        "9357": {"comment":"The length found: pages"},
        "9360": {"comment":"and the rest"},
        "9363": {"comment":"No mode: $20"},
        "9365": {"comment":"Its start"},
        "9368": {"comment":"In $4000-$5AFF?"},
        "9375": {"comment":"No"},
        "9377": {"comment":"Yes: a screen, type $14"},
        "9380": {"comment":"In mode 1 (0)"},
        "9382": {"synopsis":"Stores the mode byte ($4B60) and converts the start.","comment":"The mode byte"},
        "9386": {"comment":"The flags byte: 0"},
        "9390": {"comment":"The start as a page and an offset"},
        "9393": {"comment":"One less"},
