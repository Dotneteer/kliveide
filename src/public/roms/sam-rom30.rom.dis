        "9980": {"synopsis":"Loop: another 64K of bytes.","comment":"The bit registers"},
        "9981": {"synopsis":"Stores (load) or compares (verify) the byte read; a VERIFY difference returns NZ. Then steps\nthe address, paging on at $C000.","comment":"The load flag"},
        "9982": {"comment":"The byte read"},
