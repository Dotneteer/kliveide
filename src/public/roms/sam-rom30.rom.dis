        "8696": {"comment":"The header found is at $4B50"},
        "8698": {"synopsis":"Finds the header on tape (FIND_HEADER) and goes on at SLC_HEADER_GOT. ROM0's DOS_RESULT\njumps here when the DOS hands the work back (code 3).","comment":"Find the header on tape"},
        "8701": {"synopsis":"With the header found at $4B50: CODE goes to SLC_BLOCK_LOAD (MERGE drops its auto-run unless\nthe flags byte's bit 1 is set); SCREEN$ to LOAD_SCREEN; LOAD of a program or array to\nLOAD_PROG_ARRAY; MERGE of a program to ROM0's RAMRUN_C5D4; the rest (VERIFY) to\nSLC_BLOCK_LOAD. ROM0's DOS_RESULT jumps here (code 1).","comment":"The type found"},
        "8704": {"comment":"CODE?"},
        "8706": {"comment":"No"},
        "8708": {"comment":"CURCMD"},
        "8711": {"comment":"MERGE?"},
        "8713": {"comment":"No: load or verify the bytes"},
        "8715": {"comment":"Its flags byte: bit 1 (keep auto-run)?"},
        "8720": {"comment":"Yes"},
        "8722": {"comment":"A = $FF"},
        "8723": {"comment":"No auto-run"},
        "8728": {"synopsis":"Not CODE: SCREEN$ to LOAD_SCREEN, then by CURCMD.","comment":"SCREEN$?"},
