        "8947": {"comment":"More than the screen?"},
        "8949": {"comment":"No: done"},
        "8951": {"comment":"DE = the bytes after the screen"},
        "8953": {"comment":"The 40 palette bytes"},
        "8956": {"comment":"HL = what follows them"},
        "8958": {"comment":"Keep it"},
        "8959": {"comment":"HL = the bytes after the screen"},
        "8960": {"comment":"CUSCRNP"},
        "8963": {"comment":"Is it the screen shown?"},
        "8966": {"comment":"Yes: to $55D8"},
        "8971": {"comment":"No: to the screen's own copy at $BFD8"},
        "8974": {"synopsis":"Copies the 40 bytes, then the rest when it is short and starts below $C3.","comment":"Copy the 40 bytes"},
        "8976": {"comment":"The next byte"},
        "8977": {"comment":"Below $C3?"},
        "8979": {"comment":"Copied"},
        "8980": {"comment":"BC = what is left"},
        "8981": {"comment":"No: done"},
        "8982": {"comment":"Under 512 bytes?"},
        "8985": {"comment":"No: done"},
        "8986": {"comment":"The rest, with no interrupts"},
        "8989": {"comment":"LINE: $FF, no line interrupt"},
        "8995": {"synopsis":"LOAD of a program or an array: checks the room for the file (or for how much longer it is\nthan the old one; error 1), reclaims the old program and its variables (or the old array),\nopens room for the file at PROG (or before the byte at ELINE - 1), puts $FF at its start and\nloads it there. An array is then renamed to the name in the command; a program gets NVARS,\nNUMEND and SAVARS from the file's offsets, is prepared for running and jumps to its auto-run\nline (LINE n of the command, or the file's own) when there is one.\nEntry: the header buffer at $4B00 and the header found at $4B50.\nError: 1, 19.","comment":"C:DE = the length found"},
        "8998": {"comment":"Keep its offset"},
        "8999": {"comment":"A = its pages"},
        "9000": {"comment":"C:DE = the old length"},
        "9003": {"comment":"HL = the length found"},
        "9004": {"comment":"None ($FF)?"},
        "9007": {"comment":"The length found less the old one"},
        "9008": {"comment":"A:HL = the extra length"},
        "9011": {"comment":"Shorter: no check"},
        "9013": {"synopsis":"Checks that A:HL bytes fit (ROM0's $3F1E; error 1).","comment":"Room for A:HL bytes? Error 1 if not"},
        "9016": {"synopsis":"Reclaims what the file replaces: nothing for a new array ($FF start).","comment":"The old start"},
        "9019": {"comment":"C:DE = it"},
        "9022": {"comment":"A = its page"},
        "9023": {"comment":"None ($FF: a new array)?"},
        "9026": {"comment":"Keep the page"},
        "9027": {"comment":"and the address"},
        "9028": {"comment":"C:DE = the old length"},
        "9031": {"comment":"Its offset"},
        "9032": {"comment":"D = its pages"},
        "9033": {"comment":"BC = its offset"},
        "9034": {"comment":"HL = the old start"},
        "9035": {"comment":"A = its page"},
        "9036": {"comment":"HMPR: it"},
        "9039": {"comment":"The type"},
        "9042": {"comment":"A program?"},
        "9044": {"comment":"No: an array"},
        "9046": {"comment":"NVARSP and NVARS's high byte: 0"},
        "9049": {"comment":"so the reclaim leaves NVARS alone"},
        "9052": {"comment":"D = the pages"},
        "9053": {"comment":"Reclaim the old program and variables"},
        "9056": {"comment":"BASSTK"},
        "9059": {"comment":"to BSTKEND"},
        "9062": {"comment":"A:HL = PROG: room there"},
        "9067": {"synopsis":"Reclaims the old array.","comment":"D = the pages"},
        "9068": {"comment":"Reclaim the old array"},
