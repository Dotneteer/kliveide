        "8732": {"comment":"CURCMD"},
        "8735": {"comment":"LOAD of a program or array"},
        "8740": {"comment":"MERGE: ROM0 RAMRUN_C5D4"},
        "8745": {"synopsis":"Loads or verifies the file's bytes where the header buffer says (CODE, VERIFY): error 19\nwhen the file is longer than the length asked for, or (VERIFY) not the same; the start is\nthe one asked for (block - 1 + LDCO for code) or the file's (+ LDCO); then a code file with\nan auto-run address (the one asked for, or the file's when none was or its flags byte's bit\n1 is set) is called with ROM1 out.\nError: 19.","comment":"C:DE = the length asked for"},
        "8748": {"comment":"B = its pages"},
        "8749": {"comment":"Keep it"},
        "8751": {"comment":"C:DE = the length found"},
        "8754": {"comment":"HL = the length asked for"},
        "8755": {"comment":"A = its pages"},
        "8756": {"comment":"None asked ($FF)?"},
        "8761": {"comment":"Asked less found"},
        "8763": {"comment":"Pages"},
        "8764": {"comment":"The file is longer: error 19"},
        "8767": {"comment":"Equal?"},
        "8771": {"comment":"CURCMD"},
        "8774": {"comment":"VERIFY needs the same length: error 19"},
        "8779": {"synopsis":"Works out the start: the one in the header buffer, or for code with none given the file's\nown.","comment":"The start asked for"},
        "8782": {"comment":"C:DE = it"},
        "8785": {"comment":"The type"},
        "8788": {"comment":"CODE?"},
