        "9439": {"comment":"Bit 1: no prompt"},
        "9442": {"comment":"Tape?"},
        "9445": {"comment":"Message 3: start tape, press a key"},
        "9450": {"synopsis":"Saves the 80-byte header block, then the data block.","comment":"C = 0, A = 1: a header block"},
        "9453": {"comment":"80 bytes"},
