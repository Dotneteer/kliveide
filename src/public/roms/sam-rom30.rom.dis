        "9259": {"comment":"The types"},
        "9260": {"comment":"The same?"},
        "9263": {"comment":"CODE or SCREEN$ found?"},
        "9267": {"comment":"No: a mismatch"},
        "9269": {"comment":"Take the type wanted"},
        "9271": {"comment":"CODE or SCREEN$ wanted?"},
        "9275": {"comment":"Yes: they match"},
        "9277": {"synopsis":"Counts a different type.","comment":"A mismatch"},
        "9278": {"synopsis":"Compares the names; with $FF as the wanted one's first byte, the name found is compared with\nitself.","comment":"The names"},
        "9280": {"comment":"The first name byte wanted"},
        "9281": {"comment":"$FF: any name"},
        "9284": {"comment":"Compare the found name with itself"},
        "9286": {"synopsis":"Loop over 10 name bytes, ignoring bit 5 (case), printing the found name when names are\nshown.","comment":"A name byte found"},
        "9287": {"comment":"Differs, ignoring case?"},
        "9290": {"comment":"No"},
        "9292": {"comment":"A mismatch"},
        "9293": {"synopsis":"Prints the name byte found unless names are not shown.","comment":"Show the names?"},
