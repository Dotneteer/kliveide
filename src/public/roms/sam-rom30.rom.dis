        "9186": {"comment":"None: the file's auto-run"},
        "9192": {"comment":"None?"},
        "9194": {"synopsis":"Runs from line HL: PPC's high byte $FF, then SET_NEWPPC_0.","comment":"A = $FF"},
        "9195": {"comment":"PPC's high byte: $FF"},
        "9198": {"comment":"Jump to line HL"},
        "9201": {"synopsis":"Reads header blocks from tape (READ_HEADER) until one matches the header buffer at $4B00: a\ntype in $10-$14 or a Spectrum type 0-4 (CODE and SCREEN$ match each other, and the wanted\ntype is taken), and the same 10-character name ignoring case ($FF: any). Unless TPROMPTS bit\n0 or the file's flags byte bit 0 is set, prints each one found on stream -2: a new line, '*'\nfor a Spectrum file, its type (UMSGS message 4-8) and name.\nExit: the header at $4B50.\nChanges: all.","comment":"Read a header block"},
        "9204": {"comment":"Failed? Try again"},
        "9206": {"comment":"Select stream -2"},
        "9209": {"comment":"The type found"},
        "9212": {"comment":"Keep it"},
        "9213": {"comment":"$10-$14, or a Spectrum type 0-4?"},
        "9215": {"comment":"Not one of them? The next"},
        "9219": {"comment":"The file's flags byte"},
        "9222": {"comment":"TPROMPTS bit 0: no names shown"},
        "9227": {"comment":"Or the file's own bit 0"},
        "9229": {"comment":"Show the name?"},
        "9230": {"comment":"No"},
        "9232": {"comment":"A new line"},
        "9235": {"comment":"A '*'"},
        "9237": {"comment":"For a Spectrum file"},
        "9242": {"comment":"The type"},
        "9243": {"comment":"As $10-$14"},
        "9245": {"comment":"Less 12: message 4-8"},
        "9247": {"comment":"Print the type's name"},
        "9250": {"synopsis":"Compares the header found with the one wanted: C counts the differences.","comment":"B = 10, C = 0 mismatches"},
