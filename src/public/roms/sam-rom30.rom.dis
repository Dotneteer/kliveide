        "10008": {"comment":"Counting from 3"},
        "10010": {"synopsis":"Loop: one cycle, a bit.","comment":"A cycle"},
        "10013": {"comment":"None: failed"},
        "10014": {"comment":"The thresholds"},
        "10015": {"comment":"Too long?"},
        "10016": {"comment":"Yes: failed"},
        "10017": {"comment":"Long enough for a 1?"},
        "10018": {"comment":"Carry: 1"},
        "10020": {"comment":"Into the byte"},
        "10022": {"comment":"Count from 0 for the next bit"},
        "10024": {"comment":"Until the marker is out"},
        "10026": {"comment":"Into the check"},
        "10029": {"comment":"The first byte?"},
        "10030": {"comment":"Yes: the flag byte"},
        "10032": {"comment":"The flags back"},
        "10033": {"comment":"More bytes?"},
        "10035": {"comment":"Yes: store or verify"},
