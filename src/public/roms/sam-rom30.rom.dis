        "8805": {"synopsis":"Adds LDCO to the start's page.","comment":"LDCO"},
        "8808": {"comment":"Added"},
        "8809": {"synopsis":"Pages the start in and loads or verifies the file's length of bytes there\n(LOAD_VERIFY_DATA); VERIFY stops here; then the auto-run.","comment":"Keep the offset"},
        "8810": {"comment":"HMPR: the start's page"},
        "8813": {"comment":"C:DE = the length found"},
