        "8852": {"synopsis":"Calls the code at the auto-run address A:HL (paged in by ROM0's $1279) through\nCALL_BC_R1OFF_X.\nEntry: A = the block; HL = the offset.","comment":"Page the address in: HL"},
        "8855": {"comment":"BC = the address"},
