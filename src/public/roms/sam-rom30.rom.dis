        "10041": {"comment":"The check"},
        "10042": {"comment":"Carry: it is 0"},
        "10045": {"synopsis":"Waits until the MIDI IN line (VMPR read, bit 7) has stayed 1 for about 1024 passes, testing\nESC (error 14).\nChanges: AF.","comment":"Keep HL"},
        "10046": {"synopsis":"Starts the count again.","comment":"H = 4: about 1024 passes"},
        "10048": {"synopsis":"Loop: counts down while the line stays 1.","comment":"ESC? Error 14"},
        "10051": {"comment":"Bit 7: the MIDI IN line"},
        "10053": {"comment":"To carry"},
