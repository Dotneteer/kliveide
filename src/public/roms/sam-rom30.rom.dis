        "10056": {"comment":"Idle: count down"},
        "10059": {"comment":"Long enough?"},
        "10061": {"comment":"HL back"},
        "10063": {"synopsis":"Waits up to 300 passes for a byte from MIDI IN: the MIDI IN bit of STATUS (port $F9 bit 2)\ngoing 0 and back to 1, then reads port $FD. Tests ESC (error 14).\nExit: carry set with A = the byte; carry clear on a timeout.\nChanges: AF.","comment":"Keep HL"},
        "10064": {"comment":"300 passes at most"},
        "10067": {"synopsis":"Loop: counts down until STATUS bit 2 is 0.","comment":"Count down"},
        "10070": {"comment":"Out of time: NC"},
        "10072": {"comment":"ESC? Error 14"},
        "10075": {"comment":"STATUS"},
        "10077": {"comment":"MIDI IN (bit 2): a byte coming?"},
        "10081": {"synopsis":"Loop: waits for STATUS bit 2 to be 1 again.","comment":"Wait for its end"},
        "10087": {"comment":"The byte"},
        "10089": {"comment":"Carry: got one"},
        "10090": {"synopsis":"Puts HL back.","comment":"HL back"},
        "10092": {"synopsis":"Calls the routine at IX for each byte of a block: C 16K pages, then DE bytes (bit 15\nignored), from HL, paging on at $C000. The XOR check in H' starts as A.\nEntry: A = the flag byte; IX = the routine; HL = the start; C = the pages; DE = the rest.","comment":"The check starts with the flag byte"},
        "10095": {"comment":"The offset's bit 15"},
        "10097": {"comment":"The 16K pages"},
        "10098": {"comment":"None?"},
        "10101": {"synopsis":"Loop: one 16K page.","comment":"Keep the count"},
        "10102": {"comment":"and the rest"},
        "10103": {"comment":"16K"},
        "10106": {"comment":"A page's bytes"},
        "10109": {"comment":"The rest back"},
        "10111": {"comment":"The next page"},
        "10114": {"synopsis":"Loop: DE bytes through IX.","comment":"More bytes?"},
        "10116": {"comment":"No: done"},
        "10117": {"comment":"Past $BFFF?"},
        "10120": {"comment":"Yes: the next page"},
        "10123": {"comment":"The byte: through IX"},
        "10126": {"comment":"The next"},
        "10127": {"comment":"One fewer"},
        "10130": {"synopsis":"Moves the system's pointers for a block opened (carry clear) or reclaimed (carry set) at HL:\nthe 14 pointer triples from SAVARSP through ADJUST_PTRS (length in TEMPW4/TEMPW5), $E825\nwhen NVARS moved, WORKSPP, WKENDP and KCURP (and CHADP when CLA's high byte is 0) put in\nELINEP's page through $E80B; then PAGCOUNT and MODCOUNT get the bytes to move: WKEND - the\nplace (less the length when reclaiming), + 1. ROM0's MAKE_ROOM_DO and RECLAIM_ABC call it.\nEntry: HL = the place (HMPR paged); C, DE = the length (bits 18-16, 15-0); carry = reclaim.\nExit: A:HL = WKEND before the move.\nChanges: BC, DE, IY, TEMPW4, TEMPW5, PAGCOUNT, MODCOUNT.","comment":"14 pointers"},
        "10132": {"comment":"From SAVARSP"},
        "10136": {"comment":"The direction in AF'"},
        "10137": {"comment":"TEMPW4: the length's bits 18-16"},
        "10141": {"comment":"TEMPW5: the rest"},
        "10145": {"comment":"DE = the place"},
        "10146": {"comment":"HMPR"},
        "10148": {"comment":"The place's page"},
        "10151": {"comment":"At $C000 or above?"},
        "10155": {"comment":"The next page"},
        "10156": {"comment":"Into $8000-$BFFF"},
        "10158": {"synopsis":"A:HL = WKEND, an offset at $C000 or above counted in the next page.","comment":"WKENDP"},
        "10161": {"comment":"WKEND"},
        "10164": {"comment":"At $C000 or above?"},
        "10168": {"comment":"The next page"},
        "10169": {"comment":"Into $8000-$BFFF"},
        "10171": {"synopsis":"Keeps WKEND and HMPR, moves the pointers and puts the pages right.","comment":"Keep WKEND"},
        "10173": {"comment":"HMPR"},
        "10175": {"comment":"Keep it"},
        "10176": {"comment":"HL = NVARS"},
        "10179": {"comment":"Keep it"},
        "10180": {"comment":"Move the 14 pointers"},
        "10183": {"comment":"The place's page"},
        "10184": {"comment":"BC = NVARS before"},
        "10185": {"comment":"NVARS now"},
        "10189": {"comment":"Moved?"},
        "10191": {"comment":"Yes: $E825 adjusts the rest"},
        "10194": {"comment":"C = the place's page"},
        "10195": {"comment":"HMPR back"},
        "10198": {"comment":"ELINEP"},
        "10201": {"comment":"WORKSPP, WKENDP, KCURP to its page"},
        "10204": {"comment":"L = ELINEP"},
        "10205": {"comment":"CLA's high byte"},
        "10208": {"comment":"0?"},
        "10209": {"comment":"A = ELINEP"},
        "10210": {"comment":"CHADP"},
