        "7807": {"comment":"Yes: no longer kept"},
        "7809": {"comment":"A = it, with carry"},
        "7813": {"synopsis":"$5B66 bit 3 clear: ROM 3's CHAN_NO_INPUT, report J.","comment":"Report J"},
        "7816": {"comment":"Not reached: report J stops"},
        "7817": {"synopsis":"Nothing kept: BREAK tested, then RS232_RECV_7.","comment":"BREAK: report L"},
        "7820": {"synopsis":"Reads a byte with the data in on bit 7 and the handshake out on bit 2 of the AY's port A,\ninterrupts off: this end signals ready (handshake clear) and waits a while for a start bit;\nthe byte's 8 bits are read at the rate in $5B5F, low bit first, then not ready again; a\nsecond byte that starts at once is read too and kept at $5B61-$5B62.\nExit: carry and A = the byte; no carry when none came; interrupts on.","comment":"Interrupts off for the timing"},
        "7821": {"comment":"The timing in the alternate set"},
        "7822": {"comment":"DE = the bit time, HL half of it"},
        "7829": {"comment":"HL = half the bit time"},
        "7833": {"comment":"Clear carry"},
