        "6501": {"comment":"One more"},
        "6502": {"comment":"11: report o"},
        "6507": {"comment":"Kept"},
        "6511": {"synopsis":"No length given: the current one, once.","comment":"PLAY_BACK_CHAR: back to the note's name"},
