        "2276": {"synopsis":"Another +3DOS error, reported through $0E99.","comment":"Report the +3DOS error in A"},
        "2280": {"synopsis":"A ':' second: the first character may name the device (T, or a drive letter A-P).","comment":"The second character"},
        "2283": {"comment":"':'?"},
        "2287": {"comment":"The first, as a capital"},
        "2290": {"comment":"T?"},
        "2294": {"comment":"Below A?"},
