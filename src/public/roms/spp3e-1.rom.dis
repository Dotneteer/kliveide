        "6584": {"synopsis":"The routines of PLAY's commands, from the index PLAY_FIND_LETTER gives (0 for none): a note\n(PLAY_NOTE), '!', O, N, '(', ')', T, M, V, U, W, X, Y, Z, H."},
        "6614": {"synopsis":"W's envelope shapes for 0-7: 0, 4, 11, 13, 8, 12, 14, 10."},
        "6622": {"synopsis":"Looks A up in PLAY_LETTERS (CPIR).\nExit: Z when found; C = its index from the end (H is 14), 0 when not found.","comment":"15 letters"},
        "6625": {"comment":"HL = PLAY_LETTERS"},
