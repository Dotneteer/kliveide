        "6430": {"comment":"The third counted, then stored"},
        "6432": {"synopsis":"1-9: the current length.","comment":"The current length = n"},
        "6435": {"comment":"PLAY_LEN_UNITS: DE = its units"},
        "6438": {"synopsis":"One more length counted (report o past 10).","comment":"PLAY_TIE_COUNT: one more length (report o)"},
        "6441": {"synopsis":"'_'? Then the next length is added to it.","comment":"PLAY_SKIP_SPACE: A = the next character"},
        "6444": {"comment":"A '_'?"},
