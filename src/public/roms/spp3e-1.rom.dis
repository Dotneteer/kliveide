        "6167": {"comment":"BC = 2 x A, the entry's offset"},
        "6169": {"comment":"C = A"},
        "6172": {"comment":"HL = the entry"},
        "6174": {"synopsis":"T n: the tempo, 60-240 (report n otherwise), set only by the first string: 4 x n stacked\n(ROM 3's STACK_BC), then TEMPO_CODE's copy at IY + 43 run with ROM 3 paged in: SWAP_ROM_HIGH\n($5B10) flips the ROM's high bit and returns into the copy, whose RET goes to SWAP_HIGH_GO\n($5B2A), which flips it back and goes on at $5B5A = PLAY_TEMPO_SET. The result (ROM 3's\nFP_TO_BC) is the delay at IY + 39.","comment":"PLAY_NUMBER: BC = n"},
        "6177": {"comment":"Over 255: report n"},
        "6182": {"comment":"60 or more"},
        "6188": {"comment":"Below 241"},
        "6193": {"comment":"Only the first string's"},
        "6197": {"comment":"Not the first: ignored"},
        "6198": {"comment":"HL = n"},
        "6202": {"comment":"4 x n"},
        "6204": {"comment":"BC = 4 x n"},
        "6206": {"comment":"IY (the shared block) kept"},
        "6208": {"comment":"Stacked (ROM 3's STACK_BC)"},
        "6211": {"comment":"Interrupts off again after ROM 3"},
        "6212": {"comment":"IY = the shared block, kept again"},
        "6214": {"comment":"And kept on the stack for PLAY_TEMPO_SET"},
        "6216": {"comment":"HL = IY + 43: TEMPO_CODE's copy"},
        "6219": {"comment":"+ 43"},
        "6223": {"comment":"IY for ROM 3"},
        "6227": {"comment":"The copy's address stacked"},
