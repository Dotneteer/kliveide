        "6733": {"comment":"Registers 2n, 2n + 1"},
        "6736": {"comment":"D = 2n"},
        "6738": {"comment":"Register 2n = the low byte"},
        "6739": {"comment":"AY_WRITE"},
        "6742": {"comment":"Register 2n + 1 = the high byte"},
        "6744": {"comment":"AY_WRITE"},
