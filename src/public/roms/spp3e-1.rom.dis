        "6411": {"comment":"1-9: PLAY_LEN_SET"},
        "6413": {"comment":"PLAY_LEN_UNITS: DE = the triplet's units"},
        "6416": {"comment":"PLAY_TIE_COUNT: one length"},
        "6419": {"comment":"Stored in the list"},
        "6420": {"comment":"Next byte"},
        "6422": {"synopsis":"A triplet length: twice more in the list.","comment":"PLAY_TIE_COUNT: one more length"},
