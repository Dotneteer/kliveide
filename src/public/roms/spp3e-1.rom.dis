        "6691": {"comment":"/ 4"},
        "6695": {"comment":"Register 6: the noise period"},
        "6697": {"comment":"E = the noise period"},
        "6698": {"comment":"AY_WRITE"},
        "6701": {"synopsis":"The note kept; a tone for AY channels A-C.","comment":"The note kept at IX + 0"},
        "6704": {"comment":"The string's number"},
        "6707": {"comment":"AY channels A-C only"},
        "6710": {"comment":"HL = PLAY_PERIODS"},
        "6713": {"comment":"B = 0 for BC"},
        "6715": {"comment":"A = the note"},
