        "8079": {"comment":"A keyword?"},
        "8081": {"comment":"Below $A3: RS232_PLAIN"},
        "8083": {"comment":"$5B5A kept round the call"},
        "8087": {"comment":"ROM 3's OUT_UDG_TOKEN"},
