        "7656": {"comment":"$5B66 bit 6 cleared: no third number"},
        "7661": {"comment":"','?"},
        "7665": {"comment":"Yes: bit 6 set"},
        "7667": {"comment":"Past it"},
        "7668": {"comment":"ROM 3's CLASS_6: m"},
