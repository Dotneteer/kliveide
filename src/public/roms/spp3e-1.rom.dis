        "6234": {"comment":"SWAP_HIGH_GO ($5B2A) under it: the copy's RET"},
        "6237": {"comment":"The copy's address into HL"},
        "6238": {"comment":"The copy on top: where SWAP_ROM_HIGH returns"},
        "6239": {"comment":"AF and a BC (HL) for SWAP_ROM_HIGH to pop"},
        "6240": {"comment":"BC's place: HL"},
        "6241": {"comment":"Flip to ROM 3 (SWAP_ROM_HIGH at $5B10)"},
        "6244": {"synopsis":"Back in this ROM: the number as BC (ROM 3's FP_TO_BC) is the delay at IY + 39.","comment":"Back in this ROM: interrupts off"},
        "6245": {"comment":"ROM 3's FP_TO_BC: BC = the delay"},
        "6248": {"comment":"Off again after ROM 3"},
        "6249": {"comment":"IY = the shared block"},
        "6251": {"comment":"The delay at IY + 39"},
        "6254": {"comment":"IY + 40"},
