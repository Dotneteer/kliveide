      "lineAnnotations": {
        "461": {"synopsis":"Returns fixed values (DOS_JUMPS $0103); nothing is read.\nExit: A = 0, BC = 0, DE = $0101, HL = $0070, carry set. (v4.1 English: DE = $0100, HL =\n$0069.)","comment":"A = 0, B = C = 0"},
        "464": {"comment":"DE = $0101"},
        "467": {"comment":"HL = $0070"},
        "470": {"comment":"Success"},
        "759": {"synopsis":"Asks what to do about disk error A, through the routine at $DB20 (SET_ERR_HOOK). With none\nset it returns NZ and carry clear (cancel). Otherwise the error's message is built at $DB22\n(BUILD_MESSAGE) and the routine called with HL = the message (CALL_ERR_HOOK); the code it\nreturns in A decides: 1 gives Z and carry, 2 NZ and carry, 0 no carry. This version passes\nno list of keys.\nExit: A = the error.\nObserved: on the Spanish +3, CAT with no disk asked \"UNIDAD A: PISTA 000 SECTOR 000\", \"SIN\nDATOS\", \"]REINTENTAR, IGNORAR O CANCELAR?\" (] is the inverted question mark there); this ROM\nholds no Spanish text, so the routine at $DB20 writes its own. C gave \"SIN DATOS, 0:1\".","comment":"B = the error"},
        "760": {"comment":"A routine set?"},
        "763": {"comment":"Is it 0?"},
        "765": {"comment":"A = the error"},
        "766": {"comment":"Yes: ask it"},
        "768": {"comment":"No: NZ, carry clear (cancel)"},
        "770": {"synopsis":"A routine is set: the message built, the routine called, its code turned into the flags.","comment":"Error kept"},
        "771": {"comment":"HL = the message at $DB22"},
        "776": {"comment":"The routine (CALL_ERR_HOOK)"},
        "780": {"comment":"Code less 1: Z for code 1"},
        "782": {"comment":"Carry for codes 1 and 2"},
        "783": {"comment":"A = the error"},
        "785": {"synopsis":"Jumps to the routine at $DB20 with HL kept; its RET goes back to the caller of\nCALL_ERR_HOOK.","comment":"HL kept"},
        "786": {"comment":"The routine's address"},
        "789": {"comment":"On the stack, HL back"},
        "790": {"comment":"Off to it"},
        "791": {"synopsis":"Builds message 10, the request to put in the disk for drive C, at $DB22 (BUILD_MESSAGE).\nCalled from $1939.\nEntry: C = the drive letter.\nExit: HL = $DB22.","comment":"Message 10"},
        "793": {"synopsis":"Builds message A (bit 7 ignored) of DOS_MESSAGES at $DB22 and ends it with $FF.\nEntry: A = the message; C = the drive letter, D and E the numbers for the codes $FE, $FD and\n$FC.\nExit: HL = $DB22.\nChanges: AF, B, IX.","comment":"IX = where it goes"},
        "797": {"comment":"Kept as the result"},
        "799": {"comment":"The text"},
        "802": {"comment":"Its end"},
        "806": {"comment":"HL = the start"},
        "808": {"synopsis":"Puts message A AND $7F of DOS_MESSAGES into the buffer at IX. A byte below $80 is a\ncharacter; $FE puts in the drive letter in C, $FD the number in D and $FC the number in E,\nin decimal; any other byte from $80 puts in message (byte AND $7F) through MESSAGE_TEXT\nagain.\nEntry: A, IX; C, D, E.\nExit: IX past the text.","comment":"The message number"},
        "810": {"comment":"The first message"},
        "813": {"comment":"B = number + 1"},
        "815": {"comment":"Into the count"},
        "817": {"synopsis":"Steps over one message, up to its $FF.","comment":"Up to the $FF"},
        "819": {"comment":"$FF?"},
        "822": {"synopsis":"Next message, until B reaches the one wanted.","comment":"Skip another?"},
        "824": {"synopsis":"One byte of the message.","comment":"The next byte"},
        "826": {"comment":"The end?"},
        "829": {"comment":"Pointer kept"},
        "830": {"comment":"It goes in"},
        "834": {"comment":"Next byte"},
        "836": {"synopsis":"Puts one byte of a message into the buffer: a character, the drive letter, a number or\nanother message.","comment":"A character?"},
        "840": {"comment":"$FE: the drive letter?"},
        "844": {"comment":"$FD: the number in D?"},
        "848": {"comment":"$FC: the number in E?"},
        "850": {"comment":"No: another message"},
        "852": {"comment":"A = the number in E"},
        "855": {"synopsis":"A = the number in D.","comment":"A = the number in D"},
        "856": {"synopsis":"A (0-255) into the buffer in decimal, without leading zeros. BC and DE kept.","comment":"DE, BC kept"},
        "858": {"comment":"HL = the number"},
        "859": {"comment":"Number in L, H = 0"},
        "861": {"comment":"D = 0: no digit yet"},
        "862": {"comment":"Hundreds"},
        "868": {"comment":"Tens"},
        "874": {"comment":"Units, always put in"},
        "875": {"comment":"As a digit"},
        "877": {"comment":"BC, DE back"},
        "879": {"comment":"It goes in"},
        "881": {"synopsis":"Counts how many times -BC goes into HL and leaves the rest in HL; the count goes into the\nbuffer as a digit unless it is a leading 0 (D = 0 while no digit has been put in).\nExit: D = $30 once a digit has gone in.","comment":"Count -1"},
        "883": {"synopsis":"One more subtraction.","comment":"Value kept"},
        "884": {"comment":"One more"},
        "885": {"comment":"Take one 100 or 10"},
        "886": {"comment":"Below 0: count done"},
        "888": {"comment":"Keep the new value"},
        "890": {"comment":"Again"},
        "892": {"synopsis":"The count is the digit.","comment":"HL = what was left"},
        "893": {"comment":"Count 0?"},
        "894": {"comment":"Not a digit yet?"},
        "896": {"comment":"No: digits from now on"},
        "898": {"synopsis":"The digit, or nothing for a leading 0.","comment":"A = the digit, or 0 when leading"},
        "899": {"comment":"Leading 0: nothing"},
        "900": {"comment":"Put it in"},
        "902": {"synopsis":"A = the drive letter in C.","comment":"A = the drive letter"},
        "903": {"synopsis":"A goes into the buffer at IX.","comment":"Into the buffer"},
        "906": {"comment":"Next place"},
        "909": {"synopsis":"The disk-error messages, sixteen of them, each ended by $FF and read by MESSAGE_TEXT. Inside\none, $FE stands for the drive letter, $FD for the track and $FC for the sector, and a byte\n$80 + n for message n. Messages 0-9 are those of errors 0-9; 10 asks for a disk to be put\nin; 11-15 are pieces the others use. Message 0: (11) \"not ready\" (15)."},
        "921": {"synopsis":"Message 1: (12) \"write protected\" (15)."},
        "939": {"synopsis":"Message 2: (13) \"seek fail\" (15)."},
        "951": {"synopsis":"Message 3: (14) \"data error\" (15)."},
        "964": {"synopsis":"Message 4: (14) \"no data\" (15)."},
        "974": {"synopsis":"Message 5: (14) \"missing address mark\" (15)."},
        "997": {"synopsis":"Message 6: (11) \"bad format\" (15)."},
        "1010": {"synopsis":"Message 7: (14) \"unknown error\" (15)."},
        "1026": {"synopsis":"Message 8: (12) \"changed, please replace\" (15)."},
        "1052": {"synopsis":"Message 9: (12) \"unsuitable\" (15)."},
        "1065": {"synopsis":"Message 10: \"Please put the disk for x: into the drive then press any key\", x the drive\nletter."},
        "1126": {"synopsis":"Message 11: \"Drive x: \", x the drive letter."},
        "1136": {"synopsis":"Message 12: (11) \"disk \"."},
        "1143": {"synopsis":"Message 13: (11) \"track n, \", n the number in D."},
        "1154": {"synopsis":"Message 14: (13) \"sector n, \", n the number in E."},
        "1166": {"synopsis":"Message 15: \" - Retry, Ignore or Cancel? \"."},
        "1195": {"synopsis":"Shifts DE right A times (A = 0 leaves it).\nEntry: A = the count, DE.\nExit: DE shifted, A = 0.\nChanges: F.","comment":"No shift?"},
        "1197": {"synopsis":"One place.","comment":"DE halved"},
        "1201": {"comment":"Again?"},
        "1205": {"synopsis":"Shifts DE left A times (A = 0 leaves it).\nEntry: A = the count, DE.\nExit: DE shifted, A = 0. HL kept.\nChanges: F.","comment":"No shift?"},
        "1207": {"comment":"HL = the value"},
        "1208": {"synopsis":"One place.","comment":"Doubled"},
        "1209": {"comment":"Again?"},
        "1212": {"comment":"DE = the result"},
        "1214": {"synopsis":"Jumps to HL: a CALL to here calls the routine at HL. Called from $13B5.","comment":"To HL"},
        "1215": {"synopsis":"Turns a lower-case letter in A (a-z) into its capital; any other value stays.\nChanges: F.","comment":"Below a?"},
        "1218": {"comment":"Above z?"},
        "1221": {"comment":"Less $20: the capital"},
        "1224": {"synopsis":"Unused: $00 up to $04FF (the English v4.1 has the key list and longer code here)."},
        "1474": {"synopsis":"Writes back every open file on drive A (DOS_JUMPS $0142). The letter is made a capital and\nthe drive checked (L0C27, which also scans its directory if that is not yet done); then\nWRITE_BACK runs for each open record of the 18 whose drive is the drive's letter (IX+$1C).\nEntry: A = the drive letter.\nExit: carry set for success; carry clear and A = the error. BC kept.","comment":"A capital"},
        "1477": {"comment":"IX = the drive"},
        "1480": {"comment":"No such drive"},
        "1798": {"synopsis":"Opens a whole drive as file number B (DOS_JUMPS $014B). The record's first byte becomes $22,\nits mode byte C and its drive A; ACCESS_CONFLICT checks it. Its length (record + $23-$25)\nbecomes the word at IX+5 plus 1, shifted left IX+2 times, through L19C0, times 512. Then\nMARK_OPEN.\nEntry: A = the drive letter, B = the file number, C = the mode.\nExit: carry set for success; carry clear and A = the error ($15 or $16 from L184D, $1D\nalready open, $1E a clash).","comment":"A capital"},
        "1801": {"comment":"D = the letter"},
        "1802": {"comment":"E = the mode"},
        "1803": {"comment":"Record free and cleared?"},
        "1806": {"comment":"No"},
        "1807": {"comment":"First byte $22: a whole drive"},
        "1809": {"comment":"The record's first byte"},
        "1810": {"comment":"The mode byte"},
        "1815": {"comment":"Its drive"},
        "1817": {"comment":"IX = the drive"},
        "1818": {"comment":"IX = the drive's table"},
        "1821": {"comment":"Clash with an open file?"},
        "1824": {"comment":"Error"},
        "1825": {"comment":"DE = the word at IX+5, plus 1"},
        "1831": {"comment":"One more"},
        "1832": {"comment":"Shifted left IX+2 times"},
        "1835": {"comment":"DE << A"},
        "1838": {"comment":"Through L19C0"},
        "1841": {"comment":"Doubled: x 512 with +$23 = 0"},
        "1845": {"comment":"Length bytes 2 and 3"},
        "1848": {"comment":"+$24, +$25"},
        "1852": {"comment":"Success"},
        "1853": {"comment":"Marked open"},
        "2290": {"synopsis":"Counts the unused space of drive A (DOS_JUMPS $0121): the letter is made a capital and the\ndrive checked (L0C27, which also scans its directory if that is not yet done), then L0FA9\ncounts the clear bits of the drive's block map (at IX+$28).\nEntry: A = the drive letter.\nExit: as L0FA9; carry clear and A = the error when there is no such drive.","comment":"A capital"},
        "2293": {"comment":"IX = the drive"},
        "2296": {"comment":"No such drive"},
        "2297": {"comment":"Count the unused blocks"},
        "2319": {"synopsis":"Sets or reads the default drive (DOS_JUMPS $012D). A drive letter in A, in either case,\nbecomes the default drive at $DF94 when the drive has a table (L184D); $FF only reads it.\nEntry: A = the drive letter, or $FF.\nExit: carry set and A = the default drive letter; carry clear and A = $15 (not A-P) or $16\n(no table for the drive).\nChanges: AF, B, IX (the drive's table, when a letter is given).","comment":"Drive letter to upper case"},
        "2322": {"comment":"$FF only reads the default?"},
        "2324": {"comment":"Yes"},
        "2326": {"comment":"B = the drive letter"},
        "2327": {"comment":"IX = its drive table; is the drive there?"},
        "2330": {"comment":"Error?"},
        "2331": {"comment":"Make it the default drive"},
        "3032": {"synopsis":"Reads the character at HL of the name text.\nExit: carry clear and Z at the $FF end; otherwise carry set, A = the character with bit 7\ndropped and in upper case, and Z for a space.","comment":"End marker?"},
        "3033": {"comment":"Is it $FF?"},
        "3035": {"comment":"Yes: carry clear, Z"},
        "3036": {"comment":"Drop bit 7, make it upper case"},
        "3038": {"comment":"Upper case"},
        "3041": {"comment":"Z for a space"},
        "3043": {"comment":"Carry set: a character"},
        "3583": {"synopsis":"Reads the directory sector that holds entry DE into a buffer (L15F4) and checks it. For a\nsector in the checked part of the directory (DIR_SECTOR_SUM), the sum of its bytes must\nequal the one stored for it or, while logging in (bit 1 of (IX+$1B)), is stored. When the\nsums differ, L166C is called and error $08 is reported for the drive through L1A34; Z from\nit reads the sector again.\nEntry: DE = the entry number, IX = the drive's table.\nExit: carry set, A = the buffer's bank and HL = the buffer; carry clear and A = the error.\nChanges: AF, HL."},
        "3585": {"comment":"DE = the entry's record, 4 entries each"},
        "3587": {"comment":"Shift right 2"},
        "3590": {"comment":"DE = the sector holding it"},
        "3636": {"synopsis":"Copies the entry at $DFA2 (bank 7) into its slot in the buffer of its directory sector,\nwhich L1624 marks as changed, and updates the sector's stored sum if it is a checked one.\nThe sector itself is written later (L1719).\nEntry: DE = the entry number, IX = the drive's table.\nExit: carry set on success; carry clear and A = the error.\nChanges: AF."},
        "3639": {"comment":"C = the entry number"},
        "3640": {"comment":"DE = the entry's record"},
        "3642": {"comment":"Shift right 2"},
        "3645": {"comment":"DE = the sector holding it"},
        "3649": {"comment":"Get its buffer for changing"},
        "3652": {"comment":"Get the buffer for changing"},
        "3656": {"comment":"Error?"},
        "3658": {"comment":"B = the buffer's bank"},
        "3664": {"comment":"HL = the slot in the buffer"},
        "3665": {"comment":"HL = the slot"},
        "3668": {"comment":"HL = $DFA2, DE = the slot"},
        "3669": {"comment":"From bank 7"},
        "3671": {"comment":"Copy the entry into the buffer"},
        "3679": {"comment":"New sum for the sector"},
        "3682": {"comment":"Not checked"},
        "3684": {"comment":"Store it"},
        "3685": {"comment":"Success"},
        "3788": {"synopsis":"Clears the drive's block bitmap (one bit per block, bit 7 of the first byte for block 0, at\n(IX+$28)) and puts the directory's blocks, the bytes at (IX+$09) and (IX+$0A), into its\nfirst two bytes.\nChanges: AF, DE, HL.","comment":"HL = the bitmap, DE = the last block"},
        "3791": {"comment":"DE = the last block's byte"},
        "3793": {"comment":"DE = the bytes - 1"},
        "3796": {"comment":"DE = bytes in the bitmap"},
        "3817": {"synopsis":"Sets block DE's bit in the bitmap to C's.\nEntry: DE = the block, C = $00 (free) or $FF (used).\nChanges: AF."},
        "3820": {"comment":"DE = the block / 8"},
        "3822": {"comment":"Shift right 3"},
        "3826": {"comment":"HL = the bitmap"},
        "3830": {"comment":"HL = the block's byte"},
        "3831": {"comment":"DE = the block"},
        "3832": {"comment":"Bit number within the byte"},
        "3833": {"comment":"Bit number"},
        "3836": {"comment":"A = $80 shifted right by it"},
        "3838": {"comment":"B = the bit number + 1"},
        "5026": {"synopsis":"Maps a record other than the one mapped (MAP_REC).","comment":"Select the file's drive, logged in"},
        "5029": {"comment":"Let go of the record mapped before"},
        "5032": {"comment":"Error"},
        "5033": {"comment":"Keep the handler"},
        "5034": {"comment":"$29-$2A = the record number"},
        "5038": {"comment":"Low byte"},
        "5040": {"comment":"High byte"},
        "5041": {"comment":"Handler back"},
        "5042": {"comment":"DE = the record number"},
        "5045": {"comment":"Call the handler"},
        "5048": {"comment":"Error"},
        "5049": {"comment":"Keep the buffer address"},
        "5050": {"comment":"$2B-$2C = the sector"},
        "5054": {"comment":"Low byte"},
        "5056": {"comment":"High byte"},
        "5057": {"comment":"DE = the buffer address"},
        "5058": {"comment":"$2D-$2E = it"},
        "5059": {"comment":"Low byte"},
        "5061": {"comment":"High byte"},
        "5062": {"comment":"$2F = the buffer's bank"},
        "5180": {"synopsis":"Finds the disk sector holding a byte of a block: the block's first record (block number\ntimes 2 to the power IX+$02) becomes its first sector (REC_TO_SECTOR), and the byte offset /\n512 is added.\nEntry: HL = the block number, DE = the byte offset within the block, IX = the drive.\nExit: DE = the sector, HL = the offset within that 512-byte sector.\nChanges: DE, HL.","comment":"Keep BC and AF"},
        "5182": {"comment":"DE = the block, HL = the offset"},
        "5183": {"comment":"A = the records per block, as a shift"},
        "5186": {"comment":"DE = the block's first record"},
        "5189": {"comment":"DE = the block's first sector"},
        "5192": {"comment":"HL = that sector, DE = the offset"},
        "5193": {"comment":"B = the offset's high byte"},
        "5194": {"comment":"DE = the offset within a 512-byte sector"},
        "5198": {"comment":"DE = the first sector, HL = that offset"},
        "5199": {"comment":"A = the offset's high byte, bit 0 cleared"},
        "5200": {"comment":"A = the offset / 512: the sector in the block"},
        "5201": {"comment":"DE = the block's first sector + that"},
        "5202": {"comment":"E = the low byte"},
        "5203": {"comment":"Carry into the high byte"},
        "5206": {"comment":"BC and AF back"},
        "5209": {"synopsis":"Looks up the block holding record DE in the directory entry kept in file record BC: bytes\n$10-$1F hold sixteen one-byte block numbers, or eight two-byte ones when IX+$06 is not 0.\nEntry: DE = the record number, BC = the file record, IX = the drive.\nExit: DE = the record's byte offset within its block; carry set and HL = the block number,\nor carry clear, A = $19 and HL = the address of the empty place in the block list.\nChanges: AF, DE, HL.","comment":"Keep BC"},
        "5210": {"comment":"HL = the file record"},
        "5212": {"comment":"A = the record's place in its block"},
        "5216": {"comment":"BC = that x 128: the byte offset"},
        "5217": {"comment":"B = the place / 2"},
        "5220": {"comment":"Bit 0 of the place to bit 7"},
        "5221": {"comment":"C = it"},
        "5222": {"comment":"A = the records per block, as a shift"},
        "5225": {"comment":"E = the record's block index"},
        "5228": {"comment":"Only the low byte counts"},
        "5230": {"comment":"Two-byte block numbers?"},
        "5234": {"comment":"A = the block index"},
        "5235": {"comment":"No"},
        "5237": {"comment":"Yes: place $11 + 2 x (index mod 8)"},
        "5239": {"comment":"x 2"},
        "5240": {"comment":"Place $11 + it: the high byte"},
        "5243": {"comment":"HL = the high byte's place"},
        "5244": {"comment":"D = the high byte"},
        "5245": {"comment":"HL = the low byte's place"},
        "5246": {"comment":"E = the low byte"},
        "5355": {"synopsis":"Handler for MAP_REC when the file record is a whole-disk one (byte 0 = $22), for reading and\nwriting: record DE is the disk's 128-byte record DE counted from track 0, four to a sector,\nand its sector is read if it is not cached. Error $19 when the sector lies past the disk's\nend: the records of all IX+$05-$06 + 1 blocks plus the reserved tracks.\nEntry: DE = the record number, IX = the drive.\nExit: carry set, HL = the record's address in its buffer, A = the buffer's bank, DE = the\nsector; or carry clear and A = the error.","comment":"H = record mod 4"},
        "5359": {"comment":"HL = that x 128: the offset in the sector"},
        "5365": {"comment":"DE = record / 4: the sector"},
        "5370": {"comment":"Keep both"},
        "5372": {"comment":"HL = the sector"},
        "5373": {"comment":"A = the records per block, as a shift"},
        "5376": {"comment":"DE = the number of blocks"},
        "5383": {"comment":"DE = the disk's records"},
        "5386": {"comment":"DE = the sector past the disk's end"},
        "5389": {"comment":"Sector before it?"},
        "5392": {"comment":"DE = the sector"},
        "5393": {"comment":"HL = the offset in it"},
        "5394": {"comment":"The error if not"},
        "5396": {"comment":"Buffer and record address"},
        "5715": {"synopsis":"If drive IX has not been used in the last 100 frames (DRIVE_RECENT), drops from the cache\nits unchanged sectors up to the last sector of the directory, so that the directory is read\nafresh.\nEntry: IX = the drive.\nExit: carry set.\nChanges: AF; HL, DE and BC are kept.","comment":"Used in the last 100 frames?"},
        "5718": {"comment":"Yes: keep everything"},
        "5719": {"comment":"Keep the registers"},
        "5722": {"comment":"DE = the directory entries: IX+$07-$08 + 1"},
        "5729": {"comment":"Four to a record"},
        "5734": {"comment":"DE = the sector after the directory"},
        "5737": {"comment":"DE = its last sector"},
        "5738": {"comment":"Drop up to it"},
        "6215": {"synopsis":"(DOS_JUMPS $0151) Finds the parameter block of the drive whose letter is in A (a-p taken as\nA-P).\nEntry: A = the drive letter.\nExit: carry set and IX = the drive's parameter block; carry clear with A = $15 for a letter\noutside A-P, or A = $16 and IX = 0 when the drive is not set up. HL = $E2A0, the drive\ntable.\nChanges: AF, HL, IX.","comment":"Upper case"},
        "6218": {"comment":"HL = the drive table"},
        "6455": {"synopsis":"Calls the routine at $E3EB (set by DRIVE_B_SET) with A = the drive letter and HL = the text\nL0338 makes at $DB29 from its message $0A, C being the letter.\nEntry: A = the drive letter.","comment":"Keep the letter"},
        "6456": {"comment":"C = the letter"},
        "6457": {"comment":"HL = message $0A's text"},
        "6460": {"comment":"A = the letter"},
        "6461": {"comment":"Jump to the routine at $E3EB, HL kept"},
        "6462": {"comment":"HL = the routine's address"},
        "6465": {"comment":"Address to the stack, HL back"},
        "6466": {"comment":"Jump to it"},
        "6611": {"synopsis":"Tracks left? (REC_TO_SECTOR).","comment":"Tracks left?"},
        "6615": {"comment":"DE = the total"},
        "6616": {"comment":"HL and BC back"},
        "6618": {"comment":"Divided by 4"},
        "6638": {"synopsis":"One more track (SECTOR_TO_TRACK).","comment":"One track more"},
        "6639": {"comment":"Take a track's records"},
        "6641": {"comment":"Until it goes below 0"},
        "6643": {"comment":"HL = the records left over"},
        "6644": {"comment":"DE = them"},
        "6645": {"comment":"E = them / 4: the sector in the track"},
        "6650": {"comment":"D = the track"},
        "6651": {"comment":"BC and HL back"},
        "9294": {"synopsis":"Calls ROM 0's $3FF0 (CALL_ROM0) with A = 0 and HL = BC, keeping CURCHL, FLAGS and FLAGS2\nround the call. The English v4.1 does not set HL from BC.","comment":"Stack CURCHL, HL kept"},
        "9299": {"comment":"Stack FLAGS"},
        "9304": {"comment":"Stack FLAGS2"},
        "9309": {"comment":"A = 0, zero flag set"},
        "9312": {"comment":"Call ROM 0's $3FF0"},
        "9315": {"synopsis":"CALL_ROM0's address: $3FF0 in ROM 0."},
        "9317": {"comment":"Restore FLAGS2"},
        "9321": {"comment":"Restore FLAGS"},
        "9325": {"comment":"Restore CURCHL"},
        "9330": {"synopsis":"As ROM0_HOOK_A0, but A is passed on as it is (the zero flag set if A is 0, carry clear). ROM\n1 hands this address over in HL at ROM 1 $25F7.\nEntry: A, HL = the values ROM 0's $3FF0 takes.\nExit: as ROM 0's $3FF0 returns, except HL.\nChanges: HL.","comment":"Stack CURCHL, HL kept"},
        "9335": {"comment":"Stack FLAGS"},
        "9340": {"comment":"Stack FLAGS2"},
        "9345": {"comment":"A kept, zero flag set if A is 0"},
        "9346": {"comment":"Call ROM 0's $3FF0"},
        "9349": {"synopsis":"CALL_ROM0's address: $3FF0 in ROM 0."},
        "9351": {"comment":"Restore FLAGS2"},
        "9355": {"comment":"Restore FLAGS"},
        "9359": {"comment":"Restore CURCHL"},
        "9364": {"synopsis":"The disk drive test program, $2494-$3091 of this ROM copied to $6000-$6BFF and run there\nwith ROM 1 and RAM bank 0 paged in (ROM 0 $3586 copies $0C00 bytes and calls $6000). Every\naddress the code uses (calls, jumps, messages, variables) is its RAM address, $3B6C above\nthe ROM address; relative jumps read the same in both. The ROM 1 RST $28 calls the ROM 3\naddress in the word after it. This entry ($6000) clears the screen, opens stream 2, runs the\ntest (DT_RUN) and prints \"The disk drive test passed.\" or, after the disk error message when\nA is not $FF, \"The disk drive test failed.\". It then asks for R to run it all again or Q to\nreturn.\nExit: AF = the test's result (carry set if it passed; otherwise A = a disk error number, or\n$FF when the failure was already reported).","comment":"ROM 1 and RAM bank 0 in"},
        "9367": {"comment":"Clear the screen (ROM 3's $0D6B)"},
        "9370": {"comment":"Open stream 2, the main screen (ROM 3's $1601)"},
        "9375": {"comment":"Run the test: carry set if every drive passed"},
        "9378": {"comment":"Keep its result"},
        "9379": {"comment":"HL = \"The disk drive test passed.\""},
        "9382": {"comment":"Passed?"},
        "9384": {"comment":"A not $FF: print disk error A first"},
        "9389": {"comment":"HL = \"The disk drive test failed.\""},
        "9392": {"synopsis":"Prints the verdict and asks for R or Q.","comment":"Print the verdict"},
        "9395": {"comment":"\"Press R to repeat, Q to quit\""},
        "9400": {"comment":"HL = the test's AF"},
        "9401": {"synopsis":"Waits for R or Q, upper or lower case."},
        "9402": {"comment":"Wait for a key"},
        "9406": {"comment":"Upper case"},
        "9408": {"comment":"R: run it all again"},
        "9413": {"comment":"Not Q: wait for another key"},
        "9417": {"comment":"AF = the test's result"},
        "9420": {"synopsis":"Runs the test on every drive found: prints the title, calls DOS_JUMPS $0100, and checks with\nDOS_JUMPS $0157 that the controller answers (\"NO DISK INTERFACE !\" otherwise). DOS_JUMPS\n$017B says whether drive B is there; the drives found are printed (\"Found Drive(s) :A\" or\n\":A&B\") and the last one's letter kept at $6A90. After DOS_JUMPS $0178 with A = 0 and IX =\n$6A4E it tests drive A (DT_TEST_DRIVE) and then drive B if there is one.\nExit: carry set if every drive passed; carry clear with A = $FF after a failure already\nreported, or with A = the error a DOS call returned.","comment":"Print the title"},
        "9425": {"comment":"ROM 2 and RAM bank 7 in"},
        "9428": {"comment":"DOS_JUMPS $0100"},
        "9431": {"comment":"Failed: return its error"},
        "9434": {"comment":"Failed?"},
        "9435": {"comment":"ROM 2 and RAM bank 7 in"},
        "9438": {"comment":"DOS_JUMPS $0157: carry set if the controller answers"},
        "9441": {"comment":"ROM 1 and RAM bank 0 back in"},
        "9444": {"comment":"Controller there?"},
        "9446": {"comment":"\"NO DISK INTERFACE !\" and \"Test Aborted.\""},
        "9451": {"comment":"Carry clear and A = $FF: already reported"},
        "9455": {"synopsis":"The controller answered: list the drives.","comment":"Drive 0 (A) is tested first"},
        "9459": {"comment":"\"Found Drive(s) :A\""},
        "9464": {"comment":"ROM 2 and RAM bank 7 in"},
        "9467": {"comment":"DOS_JUMPS $017B: carry set if drive 1 answers"},
        "9470": {"comment":"ROM 1 and RAM bank 0 back in"},
        "9473": {"comment":"Only drive A: the last drive is 'A'"},
        "9477": {"comment":"Print \"&B\""},
        "9483": {"comment":"The last drive is 'B'"},
        "9485": {"synopsis":"Notes the last drive's letter and starts the tests.","comment":"Note the last drive's letter"},
        "9488": {"comment":"End the line"},
        "9491": {"comment":"IX = the parameter block at $6A4E"},
        "9495": {"comment":"A = 0 for it"},
        "9497": {"comment":"ROM 2 and RAM bank 7 in"},
        "9500": {"comment":"DOS_JUMPS $0178"},
        "9503": {"comment":"ROM 1 and RAM bank 0 back in"},
        "9506": {"comment":"Failed?"},
        "9507": {"comment":"Test drive A"},
        "9510": {"comment":"Failed?"},
        "9511": {"comment":"Then drive 1 (B)"},
        "9516": {"comment":"Is there a drive B?"},
        "9521": {"comment":"Test it too"},
        "9525": {"synopsis":"Tests the drive whose number is at $6A91 with the two sides of a test disk.\n1. \"Testing Drive \" and the drive's letter; if a disk is in, asks for it to be removed and\n   waits until the drive is not ready, then asks for side 1 and waits until it is ready.\n2. After DOS_JUMPS $015A: formats tracks 19, 0 and 39 filled with $E5 and tracks 18, 1 and\n   38 with $AA (DT_FORMAT_TRACK), and reads them back (DT_READ_CHECK); then formats tracks\n   0, 1, 18, 19, 38 and 39 with $00 and reads those back.\n3. Asks for the disk out, clears the screen, asks for side 2 and waits for it. That side\n   must be write protected (\"Disk is not write-protected.\" otherwise): its tracks 39 to 0\n   are read and each must hold $11 times (track + 1) in every byte.\n4. Asks for the disk out and clears the screen.\nExit: carry set and A = 0 if the drive passed; carry clear with A = $FF after a failure\nalready reported, or with A = the error a DOS call returned.","comment":"\"Testing Drive \""},
        "9530": {"comment":"The drive's letter"},
        "9536": {"comment":"End the line"},
        "9539": {"comment":"Disk in the drive already?"},
        "9544": {"comment":"\"Remove disk from drive\""},
        "9549": {"synopsis":"Waits until the drive is not ready.","comment":"Wait until the drive is not ready"},
        "9554": {"synopsis":"Asks for side 1 of the test disk.","comment":"\"Insert side 1 of test disk.\""},
        "9559": {"synopsis":"Waits until the drive is ready.","comment":"Wait until the drive is ready"},
        "9564": {"comment":"ROM 2 and RAM bank 7 in"},
        "9567": {"comment":"DOS_JUMPS $015A"},
        "9570": {"comment":"ROM 1 and RAM bank 0 back in"},
        "9573": {"comment":"\"Formatting tracks.\""},
        "9578": {"comment":"Filler $E5 for tracks 19, 0 and 39"},
        "9583": {"comment":"Track 19"},
        "9588": {"comment":"Failed?"},
        "9589": {"comment":"Track 0"},
        "9594": {"comment":"Failed?"},
        "9595": {"comment":"Track 39"},
        "9600": {"comment":"Failed?"},
        "9601": {"comment":"Filler $AA for tracks 18, 1 and 38"},
        "9606": {"comment":"Track 18"},
        "9611": {"comment":"Failed?"},
        "9612": {"comment":"Track 1"},
        "9617": {"comment":"Failed?"},
        "9618": {"comment":"Track 38"},
        "9623": {"comment":"Failed?"},
        "9624": {"comment":"Tracks 0, 19 and 39 read back as $E5?"},
        "9629": {"comment":"Track 0"},
        "9634": {"comment":"Failed?"},
        "9635": {"comment":"Track 19"},
        "9640": {"comment":"Failed?"},
        "9641": {"comment":"Track 39"},
        "9646": {"comment":"Failed?"},
        "9647": {"comment":"Tracks 1, 18 and 38 read back as $AA?"},
        "9652": {"comment":"Track 1"},
        "9657": {"comment":"Failed?"},
        "9658": {"comment":"Track 18"},
        "9663": {"comment":"Failed?"},
        "9664": {"comment":"Track 38"},
        "9669": {"comment":"Failed?"},
        "9670": {"comment":"Filler $00 for the same six tracks"},
        "9674": {"comment":"Track 0"},
        "9679": {"comment":"Failed?"},
        "9680": {"comment":"Track 1"},
        "9685": {"comment":"Failed?"},
        "9686": {"comment":"Track 18"},
        "9691": {"comment":"Failed?"},
        "9692": {"comment":"Track 19"},
        "9697": {"comment":"Failed?"},
        "9698": {"comment":"Track 38"},
        "9703": {"comment":"Failed?"},
        "9704": {"comment":"Track 39"},
        "9709": {"comment":"Failed?"},
        "9710": {"comment":"Read the six back: all $00?"},
        "9715": {"comment":"Failed?"},
        "9716": {"comment":"Track 1"},
        "9721": {"comment":"Failed?"},
        "9722": {"comment":"Track 18"},
        "9727": {"comment":"Failed?"},
        "9728": {"comment":"Track 19"},
        "9733": {"comment":"Failed?"},
        "9734": {"comment":"Track 38"},
        "9739": {"comment":"Failed?"},
        "9740": {"comment":"Track 39"},
        "9745": {"comment":"Failed?"},
        "9746": {"comment":"\"Remove disk from drive\""},
        "9751": {"synopsis":"Waits until the drive is not ready.","comment":"Wait until the drive is not ready"},
        "9756": {"comment":"Clear the whole screen (ROM 3's $0DAF)"},
        "9759": {"comment":"\"Insert side 2 of test disk.\""},
        "9764": {"synopsis":"Waits until the drive is ready.","comment":"Wait until the drive is ready"},
        "9769": {"comment":"ROM 2 and RAM bank 7 in"},
        "9772": {"comment":"DOS_JUMPS $015A"},
        "9775": {"comment":"ROM 1 and RAM bank 0 back in"},
        "9778": {"comment":"C = the drive"},
        "9782": {"comment":"ROM 2 and RAM bank 7 in"},
        "9785": {"comment":"DOS_JUMPS $017E: A = the drive's status"},
        "9788": {"comment":"ROM 1 and RAM bank 0 back in"},
        "9791": {"comment":"Write protected (bit 6)?"},
        "9795": {"comment":"\"Disk is not write-protected.\""},
        "9800": {"comment":"Carry clear and A = $FF: already reported"},
        "9804": {"synopsis":"Side 2 is write protected: checks its data.","comment":"\"Checking Data.\""},
        "9809": {"comment":"Tracks 39 down to 0"},
        "9811": {"synopsis":"One track of side 2 (DT_CHECK_SIDE2).","comment":"Keep the count"},
        "9812": {"comment":"Expected byte: $11 times (track + 1)"},
        "9821": {"comment":"D = the track"},
        "9823": {"comment":"Every byte as expected?"},
        "9827": {"comment":"Failed?"},
        "9828": {"comment":"Next track down"},
        "9830": {"comment":"\"Remove disk from drive\""},
        "9835": {"synopsis":"Waits until the drive is not ready.","comment":"Wait until the drive is not ready"},
        "9840": {"comment":"Clear the whole screen (ROM 3's $0DAF)"},
        "9843": {"comment":"A = 0 and carry set: the drive passed"},
        "9846": {"synopsis":"Measures the drive's speed. Nothing in the ROMs calls it (the message \"Spin test not\nimplemented.\" is in the table too). It times the 765's READ DATA for a sector $FE twice\n(DT_TIME_TURN) and compares the second count with $736F, putting '+' (below) or '-' (at or\nabove) into the message \"Spin speed difference *00 %\" at $650E. The difference is divided by\n$0127 counts a per cent, 99 if the count reaches $10000, and added to the message's \"00\";\n\"Spin speed is INCORRECT !\" follows at 3 % or more.\nExit: A = $FF; carry set if the difference is under 3 %.","comment":"\"Starting spin-speed test.\""},
        "9851": {"comment":"Time a READ DATA once (its count is dropped)"},
        "9854": {"comment":"And again: DE:HL = the count"},
        "9857": {"comment":"The figure starts as \"00\""},
        "9865": {"comment":"Keep the count's high word"},
        "9866": {"comment":"Keep the low word"},
        "9869": {"comment":"Above or below $736F?"},
        "9875": {"comment":"'-' when at or above it"},
        "9879": {"comment":"'+' when below"},
        "9881": {"synopsis":"Puts the sign into the message.","comment":"Into the message"},
        "9884": {"comment":"A = the high word, the comparison's carry kept"},
        "9887": {"comment":"High word 0?"},
        "9891": {"comment":"Too far out: report 99 %"},
        "9896": {"synopsis":"The count is under $10000: work out the difference.","comment":"Carry from the comparison"},
        "9897": {"comment":"HL = the count"},
        "9903": {"comment":"Below $736F: subtract the other way"},
        "9906": {"synopsis":"HL = the difference from $736F, A = 0.","comment":"A = 0, the per cent count"},
        "9907": {"comment":"HL = the difference"},
        "9909": {"comment":"One per cent is $0127 counts"},
        "9912": {"synopsis":"Counts whole $0127s in the difference.","comment":"Another $0127 in it?"},
        "9917": {"comment":"One per cent more"},
        "9920": {"synopsis":"Puts the per cent figure A into the message and prints it.","comment":"Keep the per cent figure"},
        "9921": {"comment":"Nothing to add?"},
        "9924": {"comment":"B = the figure"},
        "9925": {"synopsis":"Adds one to the message's two digits, B times.","comment":"Add one to the two digits"},
        "9933": {"synopsis":"Prints the figure and, at 3 % or more, the warning.","comment":"\"Spin speed difference\" with the figure"},
        "9938": {"comment":"3 % or more?"},
        "9941": {"comment":"Then \"Spin speed is INCORRECT !\""},
        "9947": {"comment":"Carry set if under 3 %"},
        "9948": {"comment":"A = $FF"},
        "9951": {"synopsis":"Adds one to the decimal number whose last ASCII digit is at HL, carrying into the digits\nbefore it.\nEntry: HL = the last digit.\nChanges: AF, HL.","comment":"Add one to the digit at HL"},
        "9954": {"comment":"Past '9'?"},
        "9957": {"comment":"Back to '0', carrying into the digit before"},
        "9962": {"synopsis":"Reads a sector of track D of the drive at $6A91 into the buffer at $684E through DOS_JUMPS\n$0163 (B = 0, E = 0, IX = $6A4E) and checks that all 512 bytes equal the filler at $684D. B\nis set to 9 and E to B - 1, but no loop follows and E is then set to 0, so one sector a\ntrack is read.\nEntry: D = the track.\nExit: carry set if every byte matched; carry clear with A = $FF after \"Data not read\ncorrectly.\", or with A = the error DOS_JUMPS $0163 returned.","comment":"B = 9 (no loop follows)"},
        "9966": {"comment":"C = the drive"},
        "9969": {"comment":"E = B - 1, overwritten below"},
        "9971": {"comment":"B = 0"},
        "9973": {"comment":"E = 0"},
        "9975": {"comment":"HL = the sector buffer"},
        "9978": {"comment":"IX = the parameter block"},
        "9982": {"comment":"ROM 2 and RAM bank 7 in"},
        "9985": {"comment":"DOS_JUMPS $0163: the sector into the buffer"},
        "9988": {"comment":"ROM 1 and RAM bank 0 back in"},
        "9991": {"comment":"Failed?"},
        "9992": {"comment":"Failed?"},
        "9994": {"comment":"512 bytes from the buffer"},
        "10000": {"synopsis":"One byte of the buffer against the filler (DT_READ_CHECK).","comment":"Each the expected byte?"},
        "10006": {"comment":"Next byte"},
        "10008": {"comment":"All 512?"},
        "10012": {"comment":"Carry set: every byte matched"},
        "10015": {"synopsis":"A byte did not match: report it.","comment":"\"Data not read correctly.\""},
        "10021": {"comment":"Carry clear and A = $FF: already reported"},
        "10025": {"synopsis":"Formats track D of the drive at $6A91 through DOS_JUMPS $016C, filled with the byte at\n$684D: E = the filler, B = 0, C = the drive, HL = the sector list built at $6A68\n(DT_FORMAT_LIST), IX = $6A4E.\nEntry: D = the track.\nExit: as DOS_JUMPS $016C returns (carry set on success, otherwise A = the error).","comment":"E = the filler byte"},
        "10029": {"comment":"B = 0"},
        "10031": {"comment":"C = the drive"},
        "10035": {"comment":"HL = the sector list for track D"},
        "10041": {"comment":"IX = the parameter block"},
        "10045": {"comment":"ROM 2 and RAM bank 7 in"},
        "10048": {"comment":"DOS_JUMPS $016C: format track D"},
        "10051": {"comment":"ROM 1 and RAM bank 0 back in"},
        "10055": {"synopsis":"Builds the list of sector IDs for formatting a track: nine entries of four bytes, track D,\nhead 0, sectors 1 to 9 and size code 2 (512 bytes).\nEntry: HL = the list, D = the track.\nChanges: nothing.","comment":"Keep AF, BC and HL"},
        "10058": {"comment":"Nine sectors"},
        "10060": {"synopsis":"One sector's ID (DT_FORMAT_LIST).","comment":"Track D"},
        "10062": {"comment":"Head 0"},
        "10065": {"comment":"Sector 1 to 9"},
        "10070": {"comment":"Size code 2: 512 bytes"},
        "10073": {"comment":"Next entry"},
        "10079": {"synopsis":"Waits until the drive is ready, calls DOS_JUMPS $0196 (which turns the motor on) and times\nDT_TIME_READ with interrupts off.\nExit: DE:HL = the count.","comment":"Wait until the drive is ready"},
        "10084": {"comment":"ROM 2 and RAM bank 7 in"},
        "10087": {"comment":"DOS_JUMPS $0196: the motor on"},
        "10090": {"comment":"ROM 1 and RAM bank 0 back in"},
        "10093": {"comment":"Time the command with interrupts off"},
        "10099": {"synopsis":"Waits until the controller is not busy, sends the 765's READ DATA ($66: MFM, skip deleted\ndata) for the drive at $6A91, cylinder 0, head 0, sector $FE, size code 3, last sector $FE,\ngap $2A, data length $FF, then counts in DE:HL while the main status register (port $2FFD)\ndoes not show bit 7. A data byte in the execution phase (bit 5) is read from port $3FFD and\nthe count goes on; otherwise it waits for bit 7 and returns with the result bytes unread.\nExit: DE:HL = the count.\nChanges: AF, BC, DE, HL.","comment":"Controller busy (bit 4)?"},
        "10108": {"comment":"The 765's READ DATA, MFM, skip deleted data"},
        "10113": {"comment":"The drive, head 0"},
        "10119": {"comment":"Cylinder 0"},
        "10123": {"comment":"Head 0"},
        "10127": {"comment":"Sector $FE"},
        "10132": {"comment":"Size code 3"},
        "10137": {"comment":"Last sector $FE"},
        "10142": {"comment":"Gap length $2A"},
        "10147": {"comment":"Data length $FF"},
        "10152": {"comment":"DE:HL = 0, the count"},
        "10158": {"synopsis":"Points BC at the main status register again and counts on.","comment":"Main status register"},
        "10161": {"synopsis":"Counts until the controller shows bit 7 (DT_TIME_READ)."},
        "10163": {"comment":"Ready for the processor (bit 7)?"},
        "10167": {"comment":"Count one more"},
        "10168": {"comment":"Low word wrapped?"},
        "10172": {"comment":"Carry into the high word"},
        "10175": {"synopsis":"Bit 7 set: a data byte, or the end of the command?","comment":"Execution phase (bit 5)?"},
        "10179": {"comment":"Take a data byte and count on"},
        "10186": {"synopsis":"Waits for bit 7 of the main status register.","comment":"Wait until the result phase is ready"},
        "10196": {"synopsis":"Sends A to the 765: waits until the main status register (port $2FFD) reads ready, direction\nto the controller, not in execution (bits 7-5 = 100), writes A to the data register (port\n$3FFD) and waits a little.\nEntry: A = the byte.\nChanges: AF, BC, D.","comment":"D = the byte to send"},
        "10197": {"comment":"Main status register"},
        "10200": {"synopsis":"Waits for the controller to take a byte."},
        "10202": {"comment":"Ready for a byte from the processor?"},
        "10208": {"comment":"Send it to the data register"},
        "10214": {"comment":"Short delay"},
        "10219": {"synopsis":"Reads the status of the drive at $6A91 through DOS_JUMPS $017E, waits $4000 counts, reads it\nagain and keeps its bit 5 (ready).\nExit: A = the status AND $20; zero flag clear if the drive is ready.","comment":"C = the drive"},
        "10223": {"comment":"ROM 2 and RAM bank 7 in"},
        "10226": {"comment":"DOS_JUMPS $017E: the drive's status"},
        "10229": {"comment":"ROM 1 and RAM bank 0 back in"},
        "10232": {"comment":"Wait a while"},
        "10235": {"synopsis":"Counts BC down to 0.","comment":"Count down"},
        "10242": {"comment":"C = the drive"},
        "10246": {"comment":"The drive's status again"},
        "10249": {"comment":"DOS_JUMPS $017E again"},
        "10252": {"comment":"ROM 1 and RAM bank 0 back in"},
        "10255": {"comment":"Ready (bit 5)?"},
        "10258": {"synopsis":"Prints message A of the test's own messages (DT_MESSAGES) through DT_PRINT_NTH, with SCR_CT\nset to $FF so the screen scrolls without asking.\nEntry: A = the message number.","comment":"Keep the message number"},
        "10259": {"comment":"No \"scroll?\" prompts: SCR_CT = $FF"},
        "10265": {"comment":"HL = the test's messages"},
        "10268": {"comment":"Print message A"},
        "10271": {"synopsis":"The test's messages, $00 ending each, $0D for a new line: 0 an empty line, 1 \"Integral disk\ntest  V1.5\", 2 \"Found Drive(s) :A\", 3 \"NO DISK INTERFACE !\" and \"Test Aborted.\", 4 \"Testing\nDrive \", 5 \"Insert side 1 of test disk.\", 6 \"Remove disk from drive\", 7 \"Insert side 2 of\ntest disk.\", 8 \"Disk is not write-protected.\", 9 \"Spin test not implemented.\" (not used), 10\n\"Checking Data.\", 11 \"Starting spin-speed test.\", 12 \"Data not read correctly.\", 13 \"Press R\nto repeat, Q to quit\", 14 \"Formatting tracks.\", 15 \"Spin speed difference *00 %\"\n(DT_SPIN_TEST writes the sign at $29A2 and the digits at $29A3), 16 \"Spin speed is INCORRECT\n!\", then the two verdicts that DT_START prints from their own addresses, \"The disk drive\ntest passed.\" ($29C5) and \"The disk drive test failed.\" ($29E2). In RAM the table is at\n$638B."},
        "10751": {"synopsis":"Prints AT 0,0, keeping AF. Nothing calls it.","comment":"Keep AF"},
        "10752": {"comment":"Print AT 0,0"},
        "10761": {"synopsis":"Prints the message for disk error A (DT_ERROR_TEXTS) and a new line. Errors 10 and over take\nentry A - 10.\nEntry: A = the error number.","comment":"HL = the disk error messages"},
        "10764": {"comment":"Error 10 or more?"},
        "10768": {"comment":"Those are entry A - 10"},
        "10770": {"synopsis":"Prints the entry.","comment":"Print the entry"},
        "10773": {"comment":"End the line"},
        "10777": {"synopsis":"Prints string A of a list of strings each ended by $00, up to its $00 or a $FF.\nEntry: A = the string's number (0 for the first), HL = the list.","comment":"B = A + 1 strings to pass"},
        "10779": {"comment":"A = 0, the terminator"},
        "10780": {"synopsis":"Passes one string (DT_PRINT_NTH).","comment":"DE = this string's start"},
        "10782": {"synopsis":"Looks for the string's $00.","comment":"At its terminator?"},
        "10786": {"comment":"Next string"},
        "10788": {"comment":"HL = string A's start"},
        "10789": {"synopsis":"Prints the string at HL up to a $00 or $FF, through ROM 3's $0010.\nEntry: HL = the string.\nExit: HL = the address after the terminator.","comment":"Next character"},
        "10791": {"comment":"Terminator $00?"},
        "10793": {"comment":"Or $FF?"},
        "10796": {"comment":"Print it (ROM 3's $0010)"},
        "10801": {"synopsis":"The disk error messages, $00 ending each, for DT_PRINT_ERROR: entries 0-9 \"Drive not\nready.\", \"Disc is write protected.\", \"Disc seek fail.\", \"Disc CRC data error.\", \"No data on\ndisc.\", \"Address mark missing.\", \"Unrecognized disc format.\", \"Unknown disc error. - Well\ndone !\", \"Disc changed while in use.\", \"Wrong type of disc in drive.\"; entries 10-27 (errors\n20-37) \"Bad filename.\", \"Bad parameter.\", \"Drive not found.\", \"File not found.\", \"File\nalready exists.\", \"End of file.\", \"Disc full.\", \"Directory full.\", \"Read-only file.\", \"File\nnot open, or wrong access.\", \"Access denied, file in use.\", \"Cannot rename between drives\",\n\"Extent is missing.\", \"Uncached. (software error)\", \"File too big.\", \"Disc not bootable\",\n\"Drive was in use.\", \"You should never see this.\". In RAM the table is at $659D."},
        "11386": {"synopsis":"Waits for a key: clears bit 5 of FLAGS, waits until the interrupt sets it again, and takes\nLAST_K.\nExit: A = the key's code.\nChanges: AF, HL.","comment":"FLAGS bit 5: no new key yet"},
        "11391": {"synopsis":"Waits for FLAGS bit 5.","comment":"Wait for the interrupt to take a key"},
        "11395": {"comment":"A = LAST_K"},
        "11398": {"comment":"Taken"},
        "11401": {"synopsis":"Pages ROM 0 and RAM bank 0 in with interrupts off and jumps to $0000. Nothing calls it.","comment":"Interrupts off for good"},
        "11402": {"comment":"Port $1FFD = 0"},
        "11408": {"comment":"Port $7FFD = 0: ROM 0 and RAM bank 0"},
        "11413": {"comment":"Restart the machine"},
        "11416": {"synopsis":"Pages this ROM (ROM 2) and RAM bank 7 in, keeping the copies at $5B5C and $5B67 up to date,\nso that the test can call DOS_JUMPS.\nChanges: nothing.","comment":"Interrupts off while paging"},
        "11417": {"comment":"Keep AF, BC and HL"},
        "11420": {"comment":"Port $7FFD and its copy at $5B5C"},
        "11426": {"comment":"RAM bank 7 at $C000, ROM bit 0 clear"},
        "11432": {"comment":"Page it"},
        "11434": {"comment":"$5B67: ROM bit 1 set, so ROM 2"},
        "11441": {"comment":"Port $1FFD"},
        "11446": {"comment":"Restore HL, BC and AF"},
        "11451": {"synopsis":"Pages ROM 1 and RAM bank 0 back in, keeping the copies at $5B5C and $5B67 up to date.\nChanges: nothing.","comment":"Interrupts off while paging"},
        "11452": {"comment":"Keep AF, BC and HL"},
        "11455": {"comment":"Port $7FFD and its copy at $5B5C"},
        "11461": {"comment":"RAM bank 0 at $C000, ROM bit 0 set"},
        "11467": {"comment":"Page it"},
        "11469": {"comment":"$5B67: ROM bit 1 clear, so ROM 1"},
        "11477": {"comment":"Port $1FFD"},
        "11482": {"comment":"Restore HL, BC and AF"},
        "11487": {"synopsis":"Three bytes after the last routine: $00, $00, $E5."},
        "11490": {"synopsis":"Unused: $00 up to $3DFF."},
        "16383": {"synopsis":"The last byte, $4F."}
      }
    }
  },
