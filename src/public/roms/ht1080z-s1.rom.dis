        {"name":"EDIT_SHOW","value":11900},
        {"name":"EDIT_COUNT","value":11921},
        {"name":"EDIT_COMMAND","value":11929},
        {"name":"EDIT_KEY","value":11931},
        {"name":"EDIT_DISPATCH","value":11952},
        {"name":"EDIT_KEYS","value":11963},
        {"name":"EDIT_LETTERS","value":11983},
        {"name":"EDIT_RIGHT","value":12042},
        {"name":"EDIT_KILL","value":12054},
        {"name":"EDIT_SEARCH","value":12060},
        {"name":"SEARCH_STEP","value":12070},
        {"name":"SEARCH_TEST","value":12087},
        {"name":"SEARCH_DONE","value":12094},
        {"name":"EDIT_LIST","value":12096},
        {"name":"EDIT_DELETE","value":12106},
        {"name":"DELETE_STEP","value":12114},
        {"name":"EDIT_BANG","value":12127},
        {"name":"EDIT_CHANGE","value":12133},
        {"name":"EDIT_TRUNCATE","value":12149},
        {"name":"EDIT_EXTEND","value":12152},
        {"name":"EDIT_INSERT","value":12157},
