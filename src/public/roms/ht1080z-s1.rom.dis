        {"name":"INSERT_CHAR","value":12208},
        {"name":"INSERT_IGNORE","value":12215},
        {"name":"INSERT_OPEN","value":12217},
        {"name":"EDIT_LEFT","value":12242},
        {"name":"EDIT_ENTER","value":12256},
