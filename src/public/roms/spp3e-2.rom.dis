        "10181": {"comment":"Not yet at 0"},
        "10182": {"comment":"At 0: a new command next time"},
        "10187": {"synopsis":"Reads and throws away HL bytes from port $CEEF, counting DE down with them (from $1A41,\n$3597).\nExit: HL = 0, BC = $CEEF.\nChanges: AF, BC, DE, HL.","comment":"Data port"},
        "10190": {"synopsis":"HL bytes left?","comment":"HL bytes left?"},
        "10191": {"comment":"Zero?"},
