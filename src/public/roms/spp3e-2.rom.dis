        "10199": {"synopsis":"Reads and throws away bytes from port $CEEF until DE reaches 0 (from $1A95, $3655).\nChanges: A, DE.","comment":"One thrown away"},
        "10201": {"comment":"Until DE = 0"},
        "10202": {"comment":"DE = 0?"},
