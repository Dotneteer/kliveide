        "10151": {"comment":"Count written"},
        "10153": {"comment":"Command $20"},
        "10155": {"comment":"to port $FFEF"},
        "10158": {"comment":"Command sent"},
        "10160": {"synopsis":"Waits, without a time limit, until bits 7, 3 and 0 of port $FFEF read 0, 1, 0 (also from\n$3124).\nExit: DE = $0100, BC = $CEEF, for HD_DATA_IN.\nChanges: AF, BC, DE.","comment":"256 bytes to come"},
        "10163": {"synopsis":"Polls port $FFEF.","comment":"Status"},
