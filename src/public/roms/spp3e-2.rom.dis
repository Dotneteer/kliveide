      ],
      "lineAnnotations": {
        "0": {"synopsis":"A JR to itself: code that reaches $0000 while this ROM is paged in stays here for good.","comment":"Round and round"},
        "2": {"synopsis":"A fixed entry: on to SHOW_MESSAGE (message B of COLOUR_MESSAGES). Nothing in this ROM jumps\nhere.","comment":"SHOW_MESSAGE: message B, with Z"},
        "5": {"synopsis":"A fixed entry: on to SHOW_INSERT_DISK (the request to put in the disk for drive C). Nothing\nin this ROM jumps here.","comment":"SHOW_INSERT_DISK: message 10, with NZ"},
        "8": {"synopsis":"The text \"PLUS3DOS\", eight plain characters."},
        "16": {"synopsis":"40 bytes up to the frame interrupt that no code in this ROM reads or jumps into. As code,\n$002F-$0037 would be OUT (C),A, LD BC,$7F06, LD A,$C3, EI, RET."},
        "56": {"synopsis":"The frame interrupt while this ROM is paged in: FRAMES counted up (its third byte too when\nthe low word wraps), then the keyboard ($3E72) and the disk motor's time-out\n(MOTOR_TIMEOUT), the registers back and EI.","comment":"AF and HL kept"},
        "58": {"comment":"FRAMES one more"},
        "69": {"comment":"The third byte of FRAMES"},
        "72": {"synopsis":"The keyboard and the motor's time-out, with BC and DE kept."},
        "74": {"comment":"The keyboard"},
        "77": {"comment":"The motor's time-out (MOTOR_TIMEOUT)"},
        "86": {"synopsis":"Five JP instructions at fixed addresses, $0056 to $0062, to $3A24, $3CC9, $3D5F, $3D55 and\n$3D64. Nothing in this ROM jumps into them.","comment":"Fixed entry $0056: to L3A24"},
        "89": {"comment":"Fixed entry $0059: to L3CC9"},
        "92": {"comment":"Fixed entry $005C: to L3D5F"},
        "95": {"comment":"Fixed entry $005F: to L3D55"},
        "98": {"comment":"Fixed entry $0062: to L3D64"},
        "102": {"synopsis":"The NMI: RETN at once."},
        "104": {"synopsis":"Counts the disk motor's time-out down: with bank 7 paged in (the paging byte $5B5C with bits\n0-2 set, to port $7FFD), when the count at $E600 is not 0 and FRAMES is even, the count goes\ndown by one; when it reaches 0, bit 3 of port $1FFD is cleared (its copy at $5B67 too),\nwhich turns the motor off. Then port $7FFD gets $5B5C back. The same code as ROM 3's\nMOTOR_TIMEOUT.\nChanges: AF, BC.","comment":"Bank 7 paged in"},
        "114": {"comment":"The count at $E600 (bank 7)"},
        "117": {"comment":"0: nothing to do"},
        "120": {"comment":"FRAMES' low byte"},
        "123": {"comment":"An odd frame: wait"},
        "130": {"comment":"One less"},
        "134": {"comment":"Not yet 0"},
        "136": {"comment":"Port $1FFD"},
        "139": {"comment":"Its copy, bit 3 (the motor) cleared"},
        "149": {"synopsis":"Port $7FFD gets the paging byte $5B5C back.","comment":"The paging byte back"},
        "160": {"synopsis":"A second jump table: 32 JP instructions, $00A0 to $00FD, three bytes apart, to routines\nfrom $24A3 to $3531 (the code that drives the disk interface on ports $xxEF), among them\nRET_DE_0106 ($00A0), HD_COUNT_UNITS ($00A3) and HD_STARTUP ($00A6). Nothing in this ROM\njumps into it; SETUP_ALL jumps to HD_STARTUP directly.","comment":"RET_DE_0106 ($2811): DE = $0106, carry set"},
        "163": {"synopsis":"JUMPS_00A0 entry $00A3: HD_COUNT_UNITS.","comment":"HD_COUNT_UNITS ($24A3)"},
        "166": {"synopsis":"JUMPS_00A0 entry $00A6: HD_STARTUP.","comment":"HD_STARTUP ($2831)"},
        "169": {"synopsis":"JUMPS_00A0 entry $00A9: to L2816.","comment":"To L2816"},
        "172": {"synopsis":"JUMPS_00A0 entry $00AC: to L2561.","comment":"To L2561"},
        "175": {"synopsis":"JUMPS_00A0 entry $00AF: to L2604.","comment":"To L2604"},
        "178": {"synopsis":"JUMPS_00A0 entry $00B2: to L2A0A.","comment":"To L2A0A"},
        "181": {"synopsis":"JUMPS_00A0 entry $00B5: to L2BD1.","comment":"To L2BD1"},
        "184": {"synopsis":"JUMPS_00A0 entry $00B8: to L2DEB.","comment":"To L2DEB"},
        "187": {"synopsis":"JUMPS_00A0 entry $00BB: to L2D14.","comment":"To L2D14"},
        "190": {"synopsis":"JUMPS_00A0 entry $00BE: to L2F9C.","comment":"To L2F9C"},
        "193": {"synopsis":"JUMPS_00A0 entry $00C1: to L2C18.","comment":"To L2C18"},
        "196": {"synopsis":"JUMPS_00A0 entry $00C4: to L2B72.","comment":"To L2B72"},
        "199": {"synopsis":"JUMPS_00A0 entry $00C7: to L2B9B.","comment":"To L2B9B"},
        "202": {"synopsis":"JUMPS_00A0 entry $00CA: to L2C44.","comment":"To L2C44"},
        "205": {"synopsis":"JUMPS_00A0 entry $00CD: to L2C9D.","comment":"To L2C9D"},
        "208": {"synopsis":"JUMPS_00A0 entry $00D0: to L2CE4.","comment":"To L2CE4"},
        "211": {"synopsis":"JUMPS_00A0 entry $00D3: to L3075.","comment":"To L3075"},
        "214": {"synopsis":"JUMPS_00A0 entry $00D6: to L307D.","comment":"To L307D"},
        "217": {"synopsis":"JUMPS_00A0 entry $00D9: to L318B.","comment":"To L318B"},
        "220": {"synopsis":"JUMPS_00A0 entry $00DC: to L2CE4.","comment":"To L2CE4"},
        "223": {"synopsis":"JUMPS_00A0 entry $00DF: to L3131.","comment":"To L3131"},
        "226": {"synopsis":"JUMPS_00A0 entry $00E2: to L3106.","comment":"To L3106"},
        "229": {"synopsis":"JUMPS_00A0 entry $00E5: to L314E.","comment":"To L314E"},
        "232": {"synopsis":"JUMPS_00A0 entry $00E8: to L30AF.","comment":"To L30AF"},
        "235": {"synopsis":"JUMPS_00A0 entry $00EB: to L30BB.","comment":"To L30BB"},
        "238": {"synopsis":"JUMPS_00A0 entry $00EE: to L31E1.","comment":"To L31E1"},
        "241": {"synopsis":"JUMPS_00A0 entry $00F1: to L3227.","comment":"To L3227"},
        "244": {"synopsis":"JUMPS_00A0 entry $00F4: to L3370.","comment":"To L3370"},
        "247": {"synopsis":"JUMPS_00A0 entry $00F7: to L33CD.","comment":"To L33CD"},
        "250": {"synopsis":"JUMPS_00A0 entry $00FA: to L34AC.","comment":"To L34AC"},
        "253": {"synopsis":"JUMPS_00A0 entry $00FD: to L3531.","comment":"To L3531"},
        "256": {"synopsis":"The jump table: 56 JP instructions, $0100 to $01A5, three bytes apart, for code in the other\nROMs to reach this ROM's routines at fixed addresses; this ROM itself calls $0106, $0109,\n$0112, $012D, $0133, $0139 and $0157 through it. Each JP's comment names its routine.\nDOS_JUMPS entry $0100: SETUP_ALL.","comment":"SETUP_ALL: work area, drives, RAM disk, cache"},
        "259": {"synopsis":"DOS_JUMPS entry $0103: FIXED_NUMBERS.","comment":"FIXED_NUMBERS: A = 0, BC = 0, DE = $0101, HL = $0069"},
        "262": {"synopsis":"DOS_JUMPS entry $0106: OPEN_BY_NAME.","comment":"OPEN_BY_NAME: open or create a file as number B"},
        "265": {"synopsis":"DOS_JUMPS entry $0109: CLOSE_FILE.","comment":"CLOSE_FILE: write back and close file number B"},
        "268": {"synopsis":"DOS_JUMPS entry $010C: CLOSE_NO_WRITE.","comment":"CLOSE_NO_WRITE: close file number B, nothing written"},
        "271": {"synopsis":"DOS_JUMPS entry $010F: HEADER_BYTES.","comment":"HEADER_BYTES: IX = file B's 8 header bytes"},
        "274": {"synopsis":"DOS_JUMPS entry $0112: FILE_READ.","comment":"FILE_READ: DE bytes of file B to HL in bank C"},
        "277": {"synopsis":"DOS_JUMPS entry $0115: FILE_WRITE.","comment":"FILE_WRITE"},
        "280": {"synopsis":"DOS_JUMPS entry $0118: FILE_READ_BYTE.","comment":"FILE_READ_BYTE"},
        "283": {"synopsis":"DOS_JUMPS entry $011B: FILE_WRITE_BYTE.","comment":"FILE_WRITE_BYTE"},
        "286": {"synopsis":"DOS_JUMPS entry $011E: CATALOGUE.","comment":"CATALOGUE"},
        "289": {"synopsis":"DOS_JUMPS entry $0121: DRIVE_FREE.","comment":"DRIVE_FREE: the unused blocks of drive A"},
        "292": {"synopsis":"DOS_JUMPS entry $0124: FILE_DELETE.","comment":"FILE_DELETE"},
        "295": {"synopsis":"DOS_JUMPS entry $0127: FILE_RENAME.","comment":"FILE_RENAME"},
        "298": {"synopsis":"DOS_JUMPS entry $012A: BOOT_DISK.","comment":"BOOT_DISK"},
        "301": {"synopsis":"DOS_JUMPS entry $012D: DRIVE_DEFAULT.","comment":"DRIVE_DEFAULT"},
        "304": {"synopsis":"DOS_JUMPS entry $0130: USER_AREA.","comment":"USER_AREA: read or set the byte at $DF93"},
        "307": {"synopsis":"DOS_JUMPS entry $0133: FILE_POS_GET.","comment":"FILE_POS_GET"},
        "310": {"synopsis":"DOS_JUMPS entry $0136: FILE_POS_SET.","comment":"FILE_POS_SET"},
        "313": {"synopsis":"DOS_JUMPS entry $0139: FILE_LEN_GET.","comment":"FILE_LEN_GET"},
        "316": {"synopsis":"DOS_JUMPS entry $013C: GET_MEM_LAYOUT.","comment":"GET_MEM_LAYOUT: HL = RAM disk blocks, DE = cache blocks"},
        "319": {"synopsis":"DOS_JUMPS entry $013F: SET_MEM_LAYOUT.","comment":"SET_MEM_LAYOUT: RAM disk and cache from HL and DE"},
        "322": {"synopsis":"DOS_JUMPS entry $0142: FLUSH_DRV_FILES.","comment":"FLUSH_DRV_FILES: write back every open file on drive A"},
        "325": {"synopsis":"DOS_JUMPS entry $0145: CHANGE_ACCESS.","comment":"CHANGE_ACCESS: file B's mode becomes C"},
        "328": {"synopsis":"DOS_JUMPS entry $0148: ATTRIB_SET.","comment":"ATTRIB_SET"},
        "331": {"synopsis":"DOS_JUMPS entry $014B: OPEN_DRIVE.","comment":"OPEN_DRIVE: open drive A as file number B"},
        "334": {"synopsis":"DOS_JUMPS entry $014E: SET_ERR_HOOK.","comment":"SET_ERR_HOOK: HL = the error routine, the old one back"},
        "337": {"synopsis":"DOS_JUMPS entry $0151: DRIVE_FIND.","comment":"DRIVE_FIND"},
        "340": {"synopsis":"DOS_JUMPS entry $0154: DRIVE_B_SET.","comment":"DRIVE_B_SET: drive B on unit C"},
        "343": {"synopsis":"DOS_JUMPS entry $0157: FDC_PRESENT.","comment":"FDC_PRESENT"},
        "346": {"synopsis":"DOS_JUMPS entry $015A: DISK_INIT.","comment":"DISK_INIT"},
