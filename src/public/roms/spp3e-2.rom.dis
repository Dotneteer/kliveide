        "10065": {"synopsis":"Divides HL:DE by BC, the quotient bits gathered inverted in DE.\nEntry: HL:DE = the dividend, BC = the divisor; the quotient must fit 16 bits.\nExit: BC = the quotient, DE = the remainder, HL = the quotient inverted.\nChanges: AF.","comment":"16 quotient bits"},
        "10067": {"comment":"First dividend bit out"},
        "10069": {"comment":"(D's top bit to carry)"},
        "10071": {"synopsis":"One quotient bit.","comment":"Into the remainder"},
        "10073": {"comment":"Below 17 bits?"},
        "10075": {"comment":"Subtract regardless"},
        "10076": {"comment":"(17-bit remainder: it goes)"},
        "10078": {"comment":"Carry clear: a 1 bit"},
        "10079": {"comment":"Store the bit"},
        "10081": {"synopsis":"Subtracts the divisor if it goes.","comment":"Does BC go?"},
        "10083": {"comment":"Yes: carry clear"},
        "10085": {"comment":"No: put it back"},
        "10086": {"comment":"Carry set: a 0 bit"},
        "10087": {"synopsis":"The bit into DE, the next dividend bit out.","comment":"Bit in, next dividend bit out"},
        "10089": {"comment":"(shift the rest of DE)"},
        "10091": {"comment":"Next bit"},
