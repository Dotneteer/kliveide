        "10233": {"synopsis":"Writes a record for a drive that lives on a hard disk partition, as HD_DRV_READ but through\nHD_BLOCK_WRITE.","comment":"DE = D x 128 + (E AND $7F)"},
        "10235": {"comment":"(D's bit 0 into carry)"},
