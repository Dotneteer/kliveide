        "9804": {"comment":"64 passes of 4 bytes"},
        "9806": {"comment":"OUTI drops B first: port $CEEF"},
        "9809": {"comment":"A = $CF"},
        "9810": {"synopsis":"4 bytes a pass, 64 passes.","comment":"4 bytes, B put back each time"},
        "9822": {"comment":"Next pass"},
        "9823": {"comment":"64 passes?"},
        "9826": {"comment":"Bank 7 back"},
        "9828": {"comment":"Paged in"},
