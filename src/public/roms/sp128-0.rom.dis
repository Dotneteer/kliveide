        "12148": {"synopsis":"The row above, with the character moved out.","comment":"A = the character taken out"},
        "12149": {"comment":"Up a row"},
        "12150": {"comment":"It goes into the row above at column 31"},
        "12151": {"comment":"H, L = the cursor's column and row"},
        "12152": {"comment":"Z: this was the cursor's row"},
