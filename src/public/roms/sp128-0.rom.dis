        "12275": {"synopsis":"The space before the word: back right past it.","comment":"HL kept"},
        "12276": {"comment":"CURSOR_RIGHT: past the space"},
        "12279": {"synopsis":"HL back."},
        "12280": {"synopsis":"The end of a deleting key: $EEF5 bit 2 cleared and the window's rows 0 to ($EC15) redrawn\n($1605), $EC0D bit 3 set (the line edited), the cursor stored and shown ($29F8).\nExit: A = the cursor's column, flags as on entry.","comment":"A = the cursor's column"},
        "12281": {"comment":"Kept, with the flags"},
        "12283": {"comment":"Rows redrawn one at a time again"},
        "12288": {"comment":"A = ($EC15), the window's last row"},
        "12291": {"comment":"The cursor's row and column kept"},
        "12292": {"comment":"B = row 0, C = the last row"},
        "12295": {"comment":"Z: ROWS_DRAW only draws, the cursor is not moved"},
        "12296": {"comment":"Rows 0 to ($EC15) redrawn"},
        "12300": {"comment":"The line edited"},
        "12306": {"comment":"The cursor stored and shown"},
        "12309": {"comment":"A = the cursor's column, the flags as on entry"},
        "12311": {"synopsis":"Key $B3 (KEY_TABLE_A): deletes at the cursor (LINE_DELETE_CHAR) up to and including the next\nspace, then the spaces after it; stops at the line's end (a 0 at the cursor). Then\nDEL_KEY_END with carry.","comment":"DEL_KEY_START: the cursor off, row redraws held back"},
        "12314": {"synopsis":"A character at the cursor? Deleted; on to the first space.","comment":"A = the character at the cursor (CHAR_AT_ROW_COL)"},
        "12319": {"comment":"The line's end?"},
        "12321": {"comment":"Carry for DEL_KEY_END"},
        "12324": {"comment":"It is deleted (LINE_DELETE_CHAR); A kept for the test"},
        "12331": {"comment":"Not a space: on"},
        "12335": {"synopsis":"Spaces after it deleted.","comment":"A = the character now at the cursor"},
        "12338": {"comment":"Not a space: done"},
        "12343": {"comment":"The space deleted (LINE_DELETE_CHAR)"},
        "12348": {"comment":"On to the next character"},
        "12350": {"synopsis":"Key $B1 (KEY_TABLE_A): deletes everything before the cursor back to the start of its line:\non the line's later rows a place left (CURSOR_LEFT) and deleted at a time\n(LINE_DELETE_CHAR); on its first row the character before the cursor while column B is not 0\nand the character before it is not 0. Then DEL_KEY_END with carry.","comment":"DEL_KEY_START: the cursor off, row redraws held back"},
        "12353": {"synopsis":"The line's first row?","comment":"DE = the cursor's row (ROW_ADDRESS)"},
        "12357": {"comment":"HL = the row's flags byte"},
        "12361": {"comment":"The line's first row?"},
        "12365": {"comment":"One place left (CURSOR_LEFT)"},
        "12368": {"comment":"Could not move: done"},
        "12370": {"comment":"The character there deleted (LINE_DELETE_CHAR)"},
        "12374": {"comment":"Again, from the row test"},
        "12376": {"comment":"Not reached: the jump at $3056 goes to $3041"},
        "12377": {"synopsis":"First row: the characters before the cursor, back to the text's start."},
        "12378": {"comment":"Column 0?"},
        "12382": {"comment":"A = the character before the cursor (CHAR_AT_ROW_COL)"},
        "12387": {"comment":"A character before the cursor?"},
        "12391": {"comment":"One column back, and that character deleted"},
        "12395": {"comment":"Again"},
        "12397": {"synopsis":"HL back; carry; DEL_KEY_END."},
        "12398": {"synopsis":"Carry; DEL_KEY_END."},
        "12399": {"comment":"DEL_KEY_END: the window redrawn, the cursor shown"},
        "12402": {"synopsis":"Key $B0 (KEY_TABLE_A): deletes at the cursor (LINE_DELETE_CHAR) until a 0 is at the cursor:\nthe rest of the line. Then DEL_KEY_END with carry.","comment":"DEL_KEY_START: the cursor off, row redraws held back"},
        "12405": {"synopsis":"A character at the cursor?","comment":"A = the character at the cursor (CHAR_AT_ROW_COL)"},
        "12408": {"comment":"The line's end?"},
        "12410": {"comment":"Carry for DEL_KEY_END"},
        "12413": {"comment":"It is deleted (LINE_DELETE_CHAR)"},
        "12418": {"comment":"Again"},
        "12420": {"synopsis":"The start of a deleting key: $EC0D bit 0 cleared, the cursor loaded and taken off the screen\n($29EC), $EEF5 bit 2 set (rows are not redrawn one at a time while it is: $3604), HL =\n$F6F1."},
        "12423": {"comment":"$EC0D bit 0 cleared"},
        "12425": {"comment":"The cursor loaded, taken off"},
        "12431": {"comment":"No redraws one row at a time"},
        "12437": {"synopsis":"Is the cursor (row C, column B) at the start of its line's text? Z when row C is the line's\nfirst row (flags bit 0) and B is 0 or the character before column B is 0; otherwise NZ, A =\n1.","comment":"DE = row C (ROW_ADDRESS)"},
        "12440": {"comment":"HL = the row's flags byte"},
        "12444": {"comment":"The line's first row?"},
        "12451": {"comment":"Column 0?"},
        "12453": {"comment":"A = the character before column B (CHAR_AT_ROW_COL)"},
        "12460": {"comment":"A character before the cursor?"},
        "12462": {"synopsis":"NZ.","comment":"A = 1 and NZ: not at the start"},
        "12466": {"synopsis":"Z.","comment":"A = 0 and Z: at the start"},
        "12468": {"synopsis":"DE = the address of row C of the editor's window, the rows from $EC16, 35 bytes each: 32\ncolumns of characters (0 is no character), at +$20 the row's flags (bit 0 the line's first\nrow, bit 1 continued on the next row, bit 3 the line's last row), and two bytes at +$21 and\n+$22.\nExit: HL = $0023. Keeps AF, BC.","comment":"HL = the window's first row"},
        "12471": {"synopsis":"DE = HL + 35 * C: row C of the rows from HL ($31C3 for $F6F8, $32B7 for $F9DE).\nExit: HL = $0023. Keeps AF, BC.","comment":"AF kept"},
        "12472": {"comment":"A = the rows to step over"},
        "12473": {"comment":"DE = 35, the size of a row"},
        "12476": {"synopsis":"35 for each row.","comment":"Row 0 reached?"},
        "12479": {"comment":"One row on"},
        "12481": {"comment":"One fewer to go"},
        "12483": {"synopsis":"DE = the row.","comment":"DE = the row, HL = 35"},
        "12486": {"synopsis":"HL = the address of column B of window row C (ROW_ADDRESS). Keeps DE."},
        "12487": {"comment":"DE = row C (ROW_ADDRESS)"},
        "12490": {"comment":"HL = DE + B: the cell at column B"},
        "12496": {"synopsis":"A copy list for $3FBA (a count, then the bytes): 5, then $00, $00, $00, $F8, $F6 for\n$F6F5-$F6F9 (BELOW_RESET)."},
        "12502": {"synopsis":"$F6F5-$F6F7 = 0 (no rows kept below the window) and $F6F8-$F6F9 = $F6F8 (BELOW_INIT_DATA\nthrough $3FBA).","comment":"HL = BELOW_INIT_DATA, the list"},
        "12505": {"comment":"DE = $F6F5, where it goes"},
        "12508": {"comment":"COPY_COUNTED copies it"},
        "12511": {"synopsis":"Takes the next row from those kept below the window: with $F6F5 (their count) not 0, $EC0D\nbit 0 cleared and the 20 rows from $F6F8 + 35 moved down one row, so the first lands at\n$F6F8; with none kept, EXPAND_INIT, $3352 (on $F9D7, updated when it gives carry) and $32D6\nmake them first. $F6F5 = the count less one.\nExit: HL = $F6F8. Keeps BC, DE.","comment":"BC, DE kept"},
        "12513": {"comment":"HL = $F6F5, the count, kept for the end"},
        "12517": {"comment":"Rows kept below?"},
        "12522": {"comment":"None: made"},
        "12525": {"comment":"HL = $F9D7, the line number to start from"},
        "12531": {"comment":"No line after it: $F9D7 kept"},
        "12533": {"comment":"$F9D7 = the line found"},
        "12536": {"synopsis":"BC = the place; $32D6 on $F6F5.","comment":"BC = the line's number, for LINE_TO_ROWS"},
        "12538": {"comment":"HL = $F6F5"},
        "12539": {"comment":"LINE_TO_ROWS: the line's rows from $F6F8; A = the rows"},
        "12542": {"comment":"All but the one taken are kept"},
        "12543": {"comment":"To store the count"},
        "12545": {"synopsis":"Rows kept: shifted down one."},
        "12548": {"comment":"$EC0D bit 0 cleared"},
        "12550": {"comment":"DE = $F6F8, HL = $F6F8 + 35"},
        "12559": {"comment":"20 rows down one"},
        "12564": {"comment":"One fewer"},
        "12565": {"comment":"Carry: a row given"},
        "12566": {"synopsis":"The count stored; HL = $F6F8.","comment":"DE = $F6F5"},
        "12567": {"comment":"The count stored"},
        "12568": {"comment":"HL = the row taken: the first, at $F6F8"},
        "12574": {"synopsis":"Puts the editor row at DE (35 bytes: 32 cells, flags at +$20, line number at +$21, high byte\nfirst) in front of the rows kept below the screen ($F6F5 the count, the rows from $F6F8, 35\nbytes each, row 1 the nearest):\n1. When the row's flags have bits 0 and 4 set, $F9D7 = the number of the line before the\n   row's line (PREV_LINE_NUM; kept when there is none).\n2. When bit 0 is set, the buffer is emptied (count 0) and the row is not kept.\n3. Otherwise, with fewer than 20 rows ($14), the row is copied to $F6F8 and rows 0-19 moved\n   to rows 1-20, so it becomes row 1; the count goes up by one.\nExit: HL = $F6F8; carry when the row was kept or the buffer emptied, no carry when the\nbuffer was full.\nChanges: AF, HL.","comment":"BC, DE kept"},
        "12576": {"comment":"HL = the row's flags"},
        "12580": {"comment":"Bits 0 and 4 both set?"},
        "12586": {"comment":"HL, DE kept"},
        "12588": {"comment":"DE = the row's line number"},
        "12593": {"comment":"Expansion reset"},
        "12597": {"comment":"The line before it"},
        "12602": {"comment":"Kept as $F9D7"},
        "12605": {"synopsis":"No line before: $F9D7 kept."},
        "12607": {"synopsis":"A line's first row (bit 0) empties the buffer.","comment":"The line's first row?"},
        "12609": {"comment":"HL = $F6F5, the count, kept for the end"},
        "12613": {"comment":"Not a first row: the row put in front"},
        "12615": {"comment":"Count 0"},
        "12618": {"comment":"To store the count"},
        "12620": {"synopsis":"The row put in front, when there is room.","comment":"A = the count"},
        "12621": {"comment":"20 rows already?"},
        "12625": {"comment":"The row copied to $F6F8"},
        "12634": {"comment":"Rows 0-19 moved one row on, from the end"},
        "12637": {"comment":"DE = the end of the rows, HL = 35 bytes before it"},
        "12645": {"comment":"20 rows, from the last byte back"},
        "12650": {"comment":"One more"},
        "12652": {"comment":"To store the count"},
        "12654": {"synopsis":"Carries character A, pushed off the end of the screen's last row (HL = that row's flags\nbyte), into the rows below the screen ($F6F5):\n1. B = column 0, C = row 1 (BELOW_ROW_ADDR). When the screen row's bit 3 was set, it is\n   cleared and the row after it is found as in step 3.\n2. The character is put in at the row's first used column ($2E41 moves B over empty cells;\n   $16AC inserts it, pushing the row's cells on). When nothing is pushed off the row's end,\n   the count becomes C and the row's bit 3 is set: done.\n3. The cell pushed off goes on to the next row (C + 1; at row 21, with a character in the\n   previous row's last cell, $EC0D bit 0 is set). The previous row gets bit 1 set and bit 3\n   cleared; when its bit 1 was already set the next row is used as it is (step 2), otherwise\n   row C is made a new last row: cleared, flags 8, indented by $FD6B cells (ROW_INDENT).\nKeeps BC, DE.","comment":"BC, DE and the character kept"},
        "12657": {"comment":"Column 0, row 1"},
        "12661": {"comment":"DE = row 1 below the screen (BELOW_ROW_ADDR)"},
        "12666": {"comment":"The screen row was a line's last?"},
        "12672": {"synopsis":"B moved over the row's empty cells ($2E41).","comment":"B = the row's first column of text (TEXT_FROM_COL)"},
        "12675": {"comment":"A = the character carried"},
        "12676": {"synopsis":"A inserted at column B of row DE ($16AC).","comment":"It goes in at column B (ROW_PUSH_CHAR); A = the one pushed out"},
        "12679": {"comment":"Nothing pushed off?"},
        "12681": {"comment":"The character pushed out kept"},
        "12682": {"comment":"The next row"},
        "12685": {"comment":"Past row 20?"},
        "12688": {"comment":"Within 20: on to the next row"},
        "12690": {"comment":"The last cell of the row before used?"},
        "12695": {"comment":"That cell empty: on to the next row"},
        "12698": {"comment":"$EC0D bit 0 set"},
        "12704": {"synopsis":"The row before marked as continued (bit 1 set, bit 3 cleared); DE = row C.","comment":"Was the row before already continued?"},
        "12710": {"comment":"DE = row C below the screen (BELOW_ROW_ADDR)"},
        "12713": {"comment":"Yes: its next row exists"},
        "12715": {"comment":"BC, DE kept"},
        "12717": {"comment":"A new row: cleared, flags 8 (bit 3)"},
        "12724": {"comment":"Indented"},
        "12727": {"comment":"A = the character pushed out"},
        "12728": {"comment":"It goes into the new row"},
        "12730": {"synopsis":"Nothing more pushed off: the count = C, bit 3 on row C's flags.","comment":"A = the rows used"},
        "12731": {"comment":"The count of rows kept below"},
        "12734": {"comment":"Row C is now the line's last"},
        "12739": {"synopsis":"DE = row C of the rows below the screen: $F6F8 + 35 x C ($30B7).\nExit: HL = $0023. Keeps AF.","comment":"HL = the first row below the screen"},
        "12742": {"comment":"ROW_ADDRESS_HL does the rest"},
        "12745": {"synopsis":"Pulls the rows below the screen one character back, from the last row ($F6F5) up to row 1:\nin each row the character at its first used column is taken out and the one from the row\nbelow put in at column 31 ($16C1). A row left with no text is dropped: the row before (the\nscreen's last row, line $EC15, for row 1) loses bit 1 and takes the dropped row's flags, and\nthe count goes down by one. $EC0D bit 0 is cleared first.\nExit: carry, A = the character taken from row 1 (0 when none); with no rows kept, A = 0 and\nno carry.\nKeeps BC, DE.","comment":"BC, DE kept"},
        "12747": {"comment":"$EC0D bit 0 cleared"},
        "12752": {"comment":"C = the count"},
        "12756": {"comment":"No rows kept below?"},
        "12757": {"comment":"A = 0, the character for the last row"},
        "12761": {"synopsis":"Row C: DE = its address; its first used column found ($2E41).","comment":"DE = row C below the screen (BELOW_ROW_ADDR)"},
        "12764": {"comment":"The incoming character kept"},
        "12765": {"comment":"From column 0"},
        "12767": {"comment":"No text in the row?"},
        "12772": {"comment":"A = the character for column 31"},
        "12773": {"comment":"A in at column 31, the cell at B taken out"},
        "12776": {"comment":"The character taken out kept, for the row above"},
        "12778": {"comment":"Any text left in the row?"},
        "12784": {"comment":"Text left: on to the row above"},
        "12786": {"synopsis":"An empty row: A = its flags, for the row before.","comment":"HL = the row's flags byte, past column 31"},
        "12788": {"comment":"The flags and BC kept"},
        "12790": {"comment":"Row 1?"},
        "12795": {"comment":"The row before: the screen's last row"},
        "12799": {"comment":"DE = the screen's last row (ROW_ADDRESS)"},
        "12804": {"synopsis":"The row before: row C - 1 of the buffer.","comment":"Row C - 1 of the rows below"},
        "12805": {"comment":"DE = that row (BELOW_ROW_ADDR)"},
        "12808": {"synopsis":"The row before: bit 1 cleared, the dropped row's flags added; the count one less.","comment":"BC and the dropped row's flags back"},
        "12810": {"comment":"HL = the row before's flags byte"},
        "12814": {"comment":"Not continued on the next row now"},
        "12816": {"comment":"The dropped row's flags added to it"},
        "12818": {"comment":"One row fewer kept below"},
        "12822": {"synopsis":"The row above, until row 1 is done.","comment":"A = the character taken out, for the row above"},
        "12823": {"comment":"The row above"},
        "12826": {"comment":"Carry: done"},
        "12827": {"synopsis":"Done."},
        "12830": {"synopsis":"ABOVE_INIT's bytes for $3FBA: a count (3), then $00 for $F9DB and $F9DE for $F9DC."},
        "12834": {"synopsis":"Empties the stack of rows above the screen: $F9DB (the count) = 0 and $F9DC (the pointer\npast the top row) = $F9DE, copied from ABOVE_INIT_DATA through $3FBA.","comment":"HL = ABOVE_INIT_DATA, the list"},
        "12837": {"comment":"DE = $F9DB, where it goes"},
        "12840": {"comment":"COPY_COUNTED copies it"},
        "12843": {"synopsis":"Takes the row nearest the screen off the stack of rows above it ($F9DB the count, $F9DC the\npointer past the top row, rows 35 bytes each from $F9DE):\n1. With rows on the stack, the pointer moves back 35 bytes and the count goes down by one:\n   HL = that row.\n2. With none, the line before $FC9A (PREV_LINE_NUM, after EXPAND_INIT) is expanded into rows\n   from $F9E1 (LINE_TO_ROWS) and $FC9A becomes its number. All its rows but the last stay on\n   the stack (count = rows - 1, pointer = the last row's address); HL = the last row.\nExit: carry and HL = the row; no carry when the stack was empty and there is no line before\n$FC9A.\nKeeps BC, DE.","comment":"BC, DE kept"},
        "12845": {"comment":"HL = $F9DB, the count, kept for the end"},
        "12849": {"comment":"Rows on the stack?"},
        "12853": {"comment":"HL kept again"},
        "12854": {"comment":"EXPAND_INIT: the expansion reset"},
        "12857": {"comment":"The line before $FC9A"},
        "12865": {"comment":"Found: it is $FC9A now"},
        "12868": {"synopsis":"BC = the line found (or 0).","comment":"BC = the line's number, for LINE_TO_ROWS"},
        "12870": {"comment":"HL = $F9DB"},
        "12871": {"comment":"HL = $F9DE"},
        "12874": {"comment":"No line before: the pointer = $F9DE, the count kept"},
        "12876": {"comment":"Its rows from $F9E1"},
        "12879": {"comment":"All but the last kept"},
        "12880": {"comment":"HL = the line's last row: the one taken"},
        "12883": {"synopsis":"A row off the stack: the pointer back by 35 bytes.","comment":"HL = the pointer past the top row"},
        "12886": {"comment":"Back 35 bytes: HL = the row taken"},
        "12891": {"comment":"Carry: the count is stored"},
        "12892": {"comment":"One row fewer"},
        "12893": {"synopsis":"With carry: the count = A and the pointer = DE.\nExit: HL = DE.","comment":"DE = the new pointer"},
        "12894": {"comment":"HL = $F9DB"},
        "12895": {"comment":"No carry: the count left as it is"},
        "12897": {"comment":"The count"},
        "12898": {"synopsis":"The pointer = DE.","comment":"The pointer, at $F9DC"},
        "12902": {"comment":"HL = the row"},
        "12906": {"synopsis":"Puts the editor row at DE on the stack of rows above the screen ($F9DB):\n1. When the row's flags have bits 0 and 4 set, $FC9A = the row's line number.\n2. When bit 3 is set (the line's last row), the stack is emptied (count 0, pointer $F9DE)\n   and $FC9A moves to the line after it (NEXT_LINE_NUM, after EXPAND_INIT; 0 when none): the\n   row is not kept.\n3. Otherwise, with fewer than 20 rows ($14), the row is copied to the pointer, which moves\n   on 35 bytes, and the count goes up by one.\nExit: carry when the row was kept or the stack emptied; no carry when it was full.\nKeeps BC, DE.","comment":"BC, DE kept"},
        "12908": {"comment":"HL = the row's flags"},
        "12912": {"comment":"Bits 0 and 4 both set?"},
        "12918": {"comment":"DE, HL kept"},
        "12924": {"comment":"$FC9A = the row's line number"},
        "12930": {"synopsis":"A line's last row (bit 3) empties the stack.","comment":"The line's last row?"},
        "12932": {"comment":"HL = $F9DB, kept for the end"},
        "12936": {"comment":"Not a last row: the row pushed"},
        "12938": {"comment":"HL kept again"},
        "12939": {"comment":"EXPAND_INIT: the expansion reset"},
        "12942": {"comment":"The line after $FC9A, or 0"},
        "12948": {"comment":"$FC9A = it"},
        "12951": {"comment":"HL = $F9DE"},
        "12955": {"comment":"Count 0, pointer $F9DE"},
        "12958": {"comment":"To store them"},
        "12960": {"synopsis":"The row copied on top, when there is room.","comment":"A = the count"},
        "12961": {"comment":"20 rows already?"},
        "12963": {"comment":"Full: the row not kept"},
        "12965": {"comment":"One more"},
        "12966": {"comment":"HL = the pointer: where the row goes"},
        "12972": {"comment":"The row copied on top"},
        "12975": {"comment":"DE = the new pointer"},
        "12976": {"comment":"Carry: the count and the pointer stored"},
        "12979": {"synopsis":"Full: the row is not kept."},
        "12983": {"synopsis":"DE = row C of the stack above the screen: $F9DE + 35 x C ($30B7).\nExit: HL = $0023. Keeps AF.","comment":"HL = the stack's first row"},
        "12986": {"comment":"ROW_ADDRESS_HL does the rest"},
        "12989": {"synopsis":"LINE_TO_ROWS's table for TABLE_DISPATCH: a count (8), then a code and a routine for each:\n$0D ROW_END_LINE, $01 ROW_END_EMPTY, and $12, $13, $14, $15, $10, $11 EXPAND_SKIP_ARG."},
        "13014": {"synopsis":"Writes the text of a program line into editor rows from HL + 3, the expansion being set up\nfor it (NEXT_LINE_START or PREV_LINE_START):\n1. The first row: its flags (+$20) = 1, its line number (+$21, high byte first) = BC; B =\n   column 0, C = 1 row.\n2. Each character from EXPAND_NEXT (none in Calculator mode, $EC0E = 4) is looked up in\n   EXPAND_CODES: the colour codes $10-$15 lose their argument; $0D ends the line\n   (ROW_END_LINE).\n3. Any other character goes in at column B (ROW_PUT_CHAR). In a full row (column 32) ROW_NEW\n   ends it with flags XOR $12 and starts the next, indented by $FD6B cells (ROW_INDENT);\n   with 20 rows written the line is ended there instead, with $0D.\n4. When the text runs out, the line is ended with $0D, or with $01 (ROW_END_EMPTY) when\n   nothing at all was written.\nExit: HL = the first row, A = C = the number of rows, carry, DE = the last row.\nObserved: a stored line's row has flags $19 (bit 4 marks a row from the program); an empty\nrow has $09.","comment":"DE = the first row"},
        "13019": {"comment":"The first row kept, for the exit"},
        "13020": {"comment":"Flags 1; the line number"},
        "13030": {"comment":"Row 1, column 0"},
        "13034": {"synopsis":"The next character, unless in Calculator mode.","comment":"BC, DE kept"},
        "13036": {"comment":"Calculator mode?"},
        "13041": {"comment":"No: A = the line's next character (EXPAND_NEXT)"},
        "13046": {"comment":"Got one?"},
        "13048": {"comment":"None: $0D, or $01 for an empty first row"},
        "13055": {"comment":"Still column 0?"},
        "13061": {"comment":"No: $0D"},
        "13063": {"synopsis":"The character looked up in EXPAND_CODES.","comment":"HL = EXPAND_CODES"},
        "13066": {"comment":"Its routine run, if A is a code (TABLE_DISPATCH)"},
        "13069": {"comment":"Line ended?"},
        "13071": {"comment":"Argument skipped?"},
        "13073": {"comment":"The character kept"},
        "13074": {"comment":"Room in the row?"},
        "13077": {"comment":"Yes: it goes in"},
        "13079": {"comment":"A new row, flags XOR $12"},
        "13081": {"comment":"ROW_NEW: this row ended, the next started"},
        "13084": {"comment":"Got a row: indented"},
        "13086": {"comment":"No room: the line ends"},
        "13091": {"synopsis":"The new row indented.","comment":"ROW_INDENT: the line's later rows start indented"},
        "13094": {"synopsis":"The character in at column B.","comment":"A = the character"},
        "13095": {"comment":"ROW_PUT_CHAR: in at column B, B + 1"},
        "13098": {"comment":"The next character"},
        "13100": {"synopsis":"HL = the first row, A = the rows.","comment":"HL = the first row"},
        "13101": {"comment":"A = the rows written"},
        "13103": {"comment":"Carry"},
        "13105": {"synopsis":"Ends row DE (ROW_CLEAR_REST) with its flags XOR A and starts the next: C + 1, DE + 35, its\nflags 0.\nExit: carry; no carry (and nothing changed after the flags) when C was 20 or more.\nChanges: AF, DE, HL, C."},
        "13106": {"comment":"ROW_CLEAR_REST: the row's rest cleared, HL = its flags"},
        "13109": {"comment":"The flags XOR A"},
        "13112": {"comment":"20 rows already?"},
        "13115": {"comment":"Yes: no carry, no new row"},
        "13116": {"comment":"One row more"},
        "13117": {"comment":"DE = the next row"},
        "13122": {"comment":"Its flags 0"},
        "13128": {"comment":"Carry: a new row"},
        "13130": {"synopsis":"PREV_LINE_START for the line before line HL.\nExit: carry and HL = its number, the expansion set up; no carry and HL = 0 when there is\nnone.","comment":"PREV_LINE_START"},
        "13133": {"comment":"Found: carry, HL = its number"},
        "13134": {"comment":"None: HL = 0"},
        "13138": {"synopsis":"NEXT_LINE_START for the line after line HL (the first line for HL = 0).\nExit: carry and HL = its number, the expansion set up; no carry and HL = 0 when there is\nnone.","comment":"NEXT_LINE_START"},
        "13141": {"comment":"Found: carry, HL = its number"},
        "13142": {"comment":"None: HL = 0"},
        "13146": {"synopsis":"EXPAND_CODES' routine for the colour codes $10-$15: the argument after the code read\n(EXPAND_NEXT) and dropped.\nExit: no carry, so LINE_TO_ROWS goes on; with nothing left, EXPAND_INIT and carry, which\nends it.","comment":"The argument (EXPAND_NEXT)"},
        "13149": {"comment":"Got it?"},
        "13151": {"synopsis":"Resets the expansion of a line ($FC9F, the place in the program, and $FCA1, the place in a\ntext, both 0) and copies the 188 bytes from KEYWORD_TEXT ($3374-$342F) to $FCAE in bank 7,\nwhere EXPAND_NEXT and the tokeniser at $3F7E call them: KEYWORD_TEXT at $FCAE,\nWORD_TO_BUFFER at $FCFD, KEYWORD_FIND at $FD2E, WORD_FIND at $FD3B.\nChanges: BC, DE, HL.","comment":"No place in the program"},
        "13157": {"comment":"No text pending"},
        "13160": {"comment":"The routines to $FCAE"},
        "13172": {"synopsis":"Run at $FCAE: puts the text of keyword $A5 + A in the buffer at $FCA3 (WORD_TO_BUFFER).\nInterrupts off, ROM 1 and bank 7 paged in (paging byte $17); the search starts from the\nentry of ROM 1's KEYWORD_TABLE for $A5, $B5, $C5, $D5, $E5 or $F5 ($0096, $00CF, $0100,\n$013E, $018B, $01D4) below A, then passes over the rest of A's strings (each ends with bit 7\nset).","comment":"ROM 1 and bank 7"},
        "13178": {"comment":"Paging byte $17"},
        "13180": {"comment":"Keyword $F5 or above?"},
        "13184": {"comment":"$E5-$F4?"},
        "13188": {"comment":"$D5-$E4?"},
        "13192": {"comment":"$C5-$D4?"},
        "13196": {"comment":"$B5-$C4?"},
        "13200": {"comment":"$A5-$B4: from RND"},
        "13205": {"synopsis":"Keywords $B5-$C4.","comment":"A = the keyword's place after $B5"},
        "13207": {"comment":"HL = ROM 1's entry for keyword $B5"},
        "13212": {"synopsis":"Keywords $C5-$D4.","comment":"A = the keyword's place after $C5"},
        "13214": {"comment":"HL = ROM 1's entry for keyword $C5"},
        "13219": {"synopsis":"Keywords $D5-$E4.","comment":"A = the keyword's place after $D5"},
        "13221": {"comment":"HL = ROM 1's entry for keyword $D5"},
        "13226": {"synopsis":"Keywords $E5-$F4.","comment":"A = the keyword's place after $E5"},
        "13228": {"comment":"HL = ROM 1's entry for keyword $E5"},
        "13233": {"synopsis":"Keywords $F5-$FF.","comment":"A = the keyword's place after $F5"},
        "13235": {"comment":"HL = ROM 1's entry for keyword $F5"},
        "13238": {"synopsis":"B = the strings to pass over.","comment":"B = the strings to pass over"},
        "13239": {"comment":"None to pass over?"},
        "13240": {"synopsis":"Any more to pass over?"},
        "13242": {"synopsis":"Up to the end of this string (bit 7).","comment":"A = the next byte of the string"},
        "13244": {"comment":"Bit 7: the string's last?"},
        "13248": {"comment":"One string fewer"},
        "13249": {"comment":"Any more?"},
        "13251": {"synopsis":"Run at $FCFD (and the end of KEYWORD_TEXT): copies the string at HL (ended by bit 7) to\n$FCA3 for EXPAND_NEXT, $FCA1 = $FCA3. A space goes first unless $FC9E is not 0 ($FC9E is\ncleared); the last character loses bit 7 and $A0 (a space with bit 7) follows it. Then ROM 0\nand bank 7 are paged in (paging byte $07) and interrupts allowed.","comment":"DE = the buffer, and $FCA1 = it"},
        "13258": {"comment":"No space wanted?"},
        "13262": {"comment":"$FC9E = 0, the flags kept for the test"},
        "13267": {"comment":"Not 0: no space"},
        "13269": {"comment":"The leading space"},
        "13273": {"synopsis":"One character, up to the one with bit 7.","comment":"A = B = the next character"},
        "13276": {"comment":"To the buffer"},
        "13278": {"comment":"Bit 7: the last?"},
        "13282": {"comment":"The last without bit 7"},
        "13285": {"comment":"Over the last again"},
        "13288": {"comment":"Then a space that ends the text"},
        "13291": {"comment":"ROM 0 and bank 7"},
        "13298": {"comment":"Interrupts allowed again"},
        "13300": {"synopsis":"Run at $FD2E: looks the word at $FD74 up in ROM 1's KEYWORD_TABLE from $0096 (B = $A5, the\ncode of its first keyword), with ROM 1 and bank 7 paged in and interrupts off; WORD_FIND\ndoes the rest.","comment":"Interrupts off; ROM 1 and bank 7 (paging byte $17)"},
        "13308": {"comment":"HL = ROM 1's KEYWORD_TABLE"},
        "13311": {"comment":"B = $A5, the code of the first keyword"},
        "13313": {"synopsis":"Run at $FD3B (and the end of KEYWORD_FIND): compares the word at $FD74 (its last character\nwith bit 7 set) with each string at HL, B counting up from the code of the first, until B\npasses $FF. Lower-case letters in the word count as capitals. Then ROM 0 and bank 7 are\npaged in and interrupts allowed.\nExit: carry and A = B = the code of the string found; no carry when none matches.","comment":"DE = the word, for each string"},
        "13316": {"synopsis":"The word's next character, a letter as a capital.","comment":"A = the word's next character"},
        "13319": {"comment":"A lower-case letter?"},
        "13321": {"comment":"A again, bit 7 included"},
        "13322": {"comment":"Not a lower-case letter: as it is"},
        "13324": {"comment":"Made a capital"},
        "13326": {"synopsis":"The same as the string's?"},
        "13327": {"comment":"No: the next string"},
        "13329": {"comment":"Both on one character"},
        "13331": {"comment":"The last character?"},
        "13335": {"comment":"Carry: found"},
        "13336": {"comment":"Then A = the code, paging back"},
        "13338": {"synopsis":"No match: the next string's code; past $FF, none found.","comment":"The next string's code"},
        "13339": {"comment":"Past $FF: none found"},
        "13341": {"synopsis":"Past the end of this string.","comment":"Bit 7: the string's last?"},
        "13347": {"comment":"The word compared with the next string"},
        "13349": {"synopsis":"None found: no carry.","comment":"No carry"},
        "13350": {"synopsis":"A = B; ROM 0 and bank 7.","comment":"A = the code found"},
        "13351": {"comment":"ROM 0 and bank 7 (paging byte 7)"},
        "13358": {"comment":"Interrupts allowed again"},
        "13360": {"synopsis":"Sets up the expansion of the first program line numbered above HL (HL = 0: the first line;\n$FC9E = A) for EXPAND_NEXT: LINE_FIND in bank 0, then LINE_START_SET.\nExit: carry, HL = the line's number, DE = the address of its text; no carry when there is\nnone. Bank 7 paged in again.","comment":"EXPAND_CLEAR: nothing pending"},
        "13363": {"comment":"$FC9E = A"},
        "13367": {"comment":"Bank 0, to read the program"},
        "13370": {"comment":"LINE_FIND: the first line numbered HL or above"},
        "13373": {"comment":"Past the end?"},
        "13375": {"comment":"A line numbered above HL?"},
        "13377": {"comment":"HL = 0: this line"},
        "13381": {"comment":"Equal: the next line"},
        "13384": {"comment":"A line there (LINE_IN_PROG)?"},
        "13387": {"comment":"Past the end: none"},
        "13389": {"synopsis":"For the line at HL: its number as four characters at $FCA3 (LINE_NUM_DIGIT; leading zeros as\n0 bytes, the last with bit 7 set), $FCA1 = $FCA3 and $FC9F = the address of its text.\nExit: carry, HL = the number, DE = the text.","comment":"DE = its number"},
        "13392": {"comment":"BANK7_STACK: bank 7 again"},
        "13395": {"comment":"DE, HL, IX kept"},
        "13399": {"comment":"IX = $FCA3, also $FCA1"},
        "13407": {"comment":"HL = the line's number"},
        "13408": {"comment":"No digit yet"},
        "13410": {"comment":"Thousands (DE = -1000)"},
        "13416": {"comment":"Hundreds (DE = -100)"},
        "13422": {"comment":"Tens (DE = -10)"},
        "13428": {"comment":"Units (DE = -1)"},
        "13434": {"comment":"Bit 7 on the last digit"},
        "13448": {"comment":"$FC9F = the line's text"},
        "13454": {"comment":"HL = the number, DE = the text"},
        "13455": {"comment":"Carry: set up"},
        "13457": {"synopsis":"Bank 7 again; the flags as they are.","comment":"BANK7_STACK: bank 7 again"},
        "13461": {"synopsis":"One decimal digit of HL into (IX), DE being minus its place's value (-1000, -100, -10, -1):\na 0 before any other digit (B = 0) is stored as the byte 0; B = 1 once a digit is not 0.\nExit: HL = the remainder, IX + 1.","comment":"A = 0, the count of the place's value"},
        "13462": {"synopsis":"DE added while it fits; A counts.","comment":"The place's value taken off"},
        "13463": {"comment":"One more"},
        "13464": {"comment":"Not below 0 yet?"},
        "13466": {"comment":"The last one put back"},
        "13468": {"comment":"A = the digit's value"},
        "13469": {"comment":"The digit"},
        "13474": {"comment":"A 0?"},
        "13478": {"comment":"Any digit before it?"},
        "13482": {"comment":"A leading 0: the byte 0"},
        "13489": {"synopsis":"B = 1: zeros from now on are digits."},
        "13491": {"synopsis":"The next place."},
        "13494": {"synopsis":"As NEXT_LINE_START, for the last program line numbered below HL. No carry when there is\nnone, and also when no line is numbered HL or above.","comment":"EXPAND_CLEAR: nothing pending"},
        "13497": {"comment":"$FC9E = A"},
        "13501": {"comment":"BANK0_STACK: bank 0, to read the program"},
        "13504": {"comment":"LINE_FIND: DE = the line before the one found"},
        "13507": {"comment":"No line HL or above?"},
        "13509": {"comment":"HL = the line before it"},
        "13510": {"comment":"A line before it?"},
        "13513": {"comment":"Yes: its number and text set up"},
        "13516": {"comment":"None: no carry"},
        "13519": {"synopsis":"HL = the address of the line after the line at HL (its length added to its start + 4), DE =\nthe line at HL.","comment":"This line kept"},
        "13520": {"comment":"DE = the line's length"},
        "13525": {"comment":"Past the length bytes"},
        "13526": {"comment":"HL = the next line"},
        "13527": {"comment":"DE = this line"},
        "13529": {"synopsis":"Is HL on a line? Carry when the byte there has bits 6 and 7 clear (a line number's high\nbyte, not the end of the program).","comment":"Bits 6 and 7 clear?"},
        "13532": {"comment":"Yes: carry, a line"},
        "13534": {"comment":"No: the program's end"},
        "13536": {"synopsis":"Compares the line number at HL (high byte first) with BC.\nExit: carry and Z when equal, carry and NZ when the line's is higher, no carry when it is\nlower. Keeps HL.","comment":"High bytes the same?"},
        "13538": {"comment":"No: carry when the line's is higher"},
        "13539": {"comment":"Low bytes the same?"},
        "13543": {"comment":"No: carry when the line's is higher"},
        "13544": {"comment":"Equal: carry and Z"},
        "13546": {"synopsis":"$FCA1 and $FC9F = 0: nothing to expand. Keeps HL."},
        "13547": {"comment":"Nothing pending, nothing of a line left"},
        "13558": {"synopsis":"Finds the first program line (from PROG) numbered HL or above; the program must be paged in.\nExit: carry, HL = that line, DE = the line before it (0 for none), Z when its number is HL;\nno carry when there is none (DE = the last line).\nChanges: AF, BC (= HL on entry), DE, HL.","comment":"BC = the number sought"},
        "13560": {"comment":"DE = 0: no line before"},
        "13563": {"comment":"HL = PROG, the first line"},
        "13566": {"comment":"No lines at all?"},
        "13570": {"comment":"The first already HL or above?"},
        "13574": {"comment":"Seeking line 0?"},
        "13578": {"synopsis":"The next line, until the end or one numbered HL or above.","comment":"The next line (LINE_NEXT_ADDR), DE = this one"},
        "13581": {"comment":"The program's end?"},
        "13585": {"comment":"Numbered HL or above?"},
        "13588": {"comment":"No: on"},
        "13591": {"synopsis":"The next character of the program line being expanded (set up by NEXT_LINE_START or\nPREV_LINE_START):\n1. While a text is pending at $FCA1 (the line number, a keyword's text), its next character,\n   without bit 7; the one with bit 7 ends the text. $FC9E = $FF after the space ($A0) that\n   ends a keyword, else 0.\n2. Otherwise the next byte of the line at $FC9F (bank 0): the five-byte form of a number\n   after $0E is passed over. A keyword ($A5 up) puts its text at $FCA3 (KEYWORD_TEXT at\n   $FCAE); $A3 and $A4 put \"SPECTRUM\" and \"PLAY\" there (WORD_TO_BUFFER at $FCFD); and the\n   text's first character is taken. Any other byte is returned as it is, with $FC9E = 0;\n   $0D, the line's end, also ends the expansion (EXPAND_CLEAR's two pointers 0).\nExit: carry and A = the character; no carry when nothing is left.\nChanges: AF, BC, DE, HL.","comment":"A text pending?"},
        "13598": {"comment":"A = the text's next character"},
        "13600": {"comment":"The space that ends a keyword?"},
        "13602": {"comment":"B = it"},
        "13607": {"comment":"$FF after the space that ends a keyword"},
        "13609": {"synopsis":"$FC9E = 0, or $FF after a keyword's last space."},
        "13612": {"comment":"A = the character"},
        "13613": {"comment":"The text's last character?"},
        "13617": {"comment":"The last: nothing pending after it"},
        "13620": {"synopsis":"$FCA1 = the next character, or 0 after the last."},
        "13623": {"comment":"Without bit 7"},
        "13625": {"comment":"Carry: a character"},
        "13628": {"synopsis":"Nothing pending: the next byte of the line, if any.","comment":"Anything left in the line?"},
        "13633": {"comment":"Nothing: no carry"},
        "13636": {"comment":"Bank 0"},
        "13639": {"synopsis":"A = the byte; a number's hidden form passed over."},
        "13640": {"comment":"A number's marker?"},
        "13644": {"comment":"Past the marker and the number's 5 bytes"},
        "13650": {"comment":"Then the next byte"},
        "13652": {"synopsis":"Bank 7; $FC9F on.","comment":"BANK7_STACK: bank 7 again"},
        "13655": {"comment":"$FC9F = the next byte"},
        "13659": {"comment":"A 48K keyword?"},
        "13661": {"comment":"No"},
        "13663": {"comment":"A = the keyword's place after $A5"},
        "13665": {"comment":"Its text to $FCA3"},
        "13668": {"comment":"Then its first character"},
        "13671": {"synopsis":"$A3 (SPECTRUM) and $A4 (PLAY): their text from ROM 0.","comment":"$A3 or $A4?"},
        "13673": {"comment":"Below $A3: a character"},
        "13675": {"comment":"$A4: PLAY"},
        "13677": {"comment":"HL = \"SPECTRUM\" in OWN_WORDS"},
        "13682": {"synopsis":"$A4: \"PLAY\".","comment":"HL = \"PLAY\" in OWN_WORDS"},
        "13685": {"synopsis":"The text to $FCA3, then its first character.","comment":"WORD_TO_BUFFER at $FCFD: the text to $FCA3"},
        "13688": {"comment":"Then its first character"},
        "13691": {"synopsis":"Any other character: $FC9E = 0; $0D ends the expansion.","comment":"$FC9E = 0, A kept"},
        "13698": {"comment":"The line's end?"},
        "13700": {"comment":"No: the character"},
        "13702": {"comment":"Yes: nothing pending, the line done"},
        "13711": {"synopsis":"Carry: A is a character."},
        "13713": {"synopsis":"No carry: nothing left."},
        "13716": {"synopsis":"Seven words, each with bit 7 set on its last character, for WORD_FIND (from $3F87, B = $F9\nfor the first): \"SPECTRUM\", \"PLAY\", \"GOTO\", \"GOSUB\", \"DEFFN\", \"OPEN#\", \"CLOSE#\". EXPAND_NEXT\nalso prints the first two as the texts of $A3 and $A4."},
        "13753": {"synopsis":"ROW_SETUP's bytes for $3FBA: a count (2), then 1 for $FD6A and 5 for $FD6B."},
        "13756": {"synopsis":"$FD6A = 1 and $FD6B = 5 (the cells a line's later rows are indented by, ROW_INDENT), copied\nfrom ROW_SETUP_DATA through $3FBA.","comment":"HL = ROW_SETUP_DATA, the list"},
        "13759": {"comment":"DE = $FD6A, where it goes"},
        "13762": {"comment":"COPY_COUNTED copies it"},
        "13765": {"synopsis":"Puts A in column B of row DE; B + 1.\nChanges: HL.","comment":"HL = the cell at column B"},
        "13769": {"comment":"A in it"},
        "13770": {"comment":"The next column"},
        "13772": {"synopsis":"EXPAND_CODES' routine for $0D: the rest of row DE cleared (ROW_CLEAR_REST), its flags' bits\n3 and 4 set, $FD6A bit 0 set.\nExit: carry, which ends LINE_TO_ROWS.","comment":"ROW_CLEAR_REST: the row's rest cleared, HL = its flags"},
        "13775": {"comment":"Bits 3 and 4 set"},
        "13779": {"comment":"$FD6A bit 0 set"},
        "13784": {"comment":"Carry: the line has ended"},
        "13786": {"synopsis":"EXPAND_CODES' routine for $01 (a line with no text): as ROW_END_LINE, setting only bit 3 of\nthe flags.","comment":"ROW_CLEAR_REST: the row's rest cleared, HL = its flags"},
        "13789": {"comment":"Bit 3: the line's last row"},
        "13791": {"comment":"$FD6A bit 0 set"},
        "13796": {"comment":"Carry: the line has ended"},
        "13798": {"synopsis":"Clears row DE's cells from column B to 31 (to 0).\nExit: B = 32, HL = the row's flags byte.","comment":"HL = the cell at column B"},
        "13802": {"comment":"A = 32, the column past the last"},
        "13804": {"synopsis":"Up to column 32.","comment":"Past column 31?"},
        "13806": {"comment":"The cell cleared"},
        "13808": {"comment":"The next"},
        "13812": {"synopsis":"Clears row DE's first $FD6B cells.\nExit: B = $FD6B, the column after them.\nChanges: AF, HL.","comment":"A = the indent, from $FD6B"},
        "13815": {"comment":"From column 0"},
        "13817": {"synopsis":"One cell.","comment":"HL = the cell"},
        "13821": {"comment":"Cleared"},
        "13823": {"comment":"The next"},
        "13824": {"comment":"More?"},
        "13828": {"synopsis":"Prints the row at HL on editor line C ($3B1E with B = C), unless $EEF5 bit 2 is set. Keeps\nBC, DE, HL.","comment":"BC, DE, HL kept"},
        "13832": {"comment":"Output held back?"},
        "13840": {"comment":"B = the line"},
        "13841": {"comment":"PRINT_ROW: the row printed"},
        "13844": {"synopsis":"BC, DE, HL back."},
        "13848": {"synopsis":"Unless $EEF5 bit 2 is set: $3ABF with E = C, which moves editor lines B + 1 to C one line up\nand prints the row at HL on line C. Keeps BC, DE, HL.","comment":"BC, DE, HL kept"},
        "13852": {"comment":"Output held back?"},
        "13860": {"comment":"E = the last line"},
        "13861": {"comment":"SCROLL_UP: the lines moved up, the row printed"},
        "13864": {"synopsis":"BC, DE, HL back."},
        "13868": {"synopsis":"Unless $EEF5 bit 2 is set: $3AC6 with E = C, which moves editor lines B to C - 1 one line\ndown and prints the row at HL on line B. Keeps BC, DE, HL.","comment":"BC, DE, HL kept"},
        "13872": {"comment":"Output held back?"},
        "13880": {"comment":"E = the last line"},
        "13881": {"comment":"SCROLL_DOWN: the lines moved down, the row printed"},
        "13884": {"synopsis":"BC, DE, HL back."},
        "13888": {"synopsis":"Marks the cell at column B, line C: $3A9D (B and C swapped for it) keeps the cell's\nattribute in (IX+7) and gives it (IX+6)'s colours with its FLASH and BRIGHT bits inverted.\nKeeps all registers.","comment":"All registers kept"},
        "13892": {"comment":"B = the line, C = the column"},
        "13895": {"comment":"WIN_CURSOR_ON"},
        "13903": {"synopsis":"Puts back the attribute CELL_CURSOR_ON kept for the cell at column B, line C ($3AB2). Keeps\nall registers.","comment":"All registers kept"},
        "13907": {"comment":"B = the line, C = the column"},
        "13910": {"comment":"WIN_CURSOR_OFF"},
        "13918": {"synopsis":"MODE ($5C41) = 0, REPPER = 2, then KEY_MODE.","comment":"MODE = 0"},
        "13923": {"comment":"REPPER = 2"},
        "13928": {"synopsis":"FLAGS bits 2 and 3 set; $5B66 bit 0 set when $EC0D bit 4 is set, else cleared.","comment":"HL = FLAGS"},
        "13931": {"comment":"Bits 2 and 3 set"},
        "13935": {"comment":"$EC0D bit 4 set?"},
        "13940": {"comment":"HL = $5B66"},
        "13943": {"comment":"Yes: bit 0 set"},
        "13945": {"comment":"No: bit 0 cleared"},
        "13948": {"synopsis":"$5B66 bit 0 set."},
        "13951": {"synopsis":"Waits for a new key (FLAGS bit 5), takes it from LAST_K: codes $20 and up, and $06-$0F after\nROM 1's KI_CAPS_LOCK handling ($36A4) accepts them; $10-$1F are ignored. Exit: A = the key.\nKeeps HL."},
        "13952": {"synopsis":"HL = FLAGS, for the next key."},
        "13955": {"comment":"A new key?","synopsis":"Until FLAGS bit 5 says a key came."},
        "13959": {"comment":"It is taken"},
        "13961": {"comment":"A = LAST_K"},
        "13964": {"comment":"MODE bit 0 cleared"},
        "13969": {"comment":"$20 and up: a key"},
        "13973": {"comment":"$10-$1F: ignored"},
        "13977": {"comment":"Below $06: ignored"},
        "13981": {"comment":"KEY_CONTROL: ROM 1's KI_CAPS_LOCK on it"},
        "13984": {"comment":"Not taken: wait again"},
        "13986": {"synopsis":"HL back; A = the key."},
        "13988": {"synopsis":"ROM 1's KI_CAPS_LOCK ($10DB) on the key in A.","comment":"ROM 1's KI_CAPS_LOCK: CAPS LOCK or a mode key"},
        "13992": {"synopsis":"Draws the menu whose text is at HL (a count, a title ended by $FF, items ended by bit 7):\nthe area under it saved (MENU_AREA_SAVE), MENU_HEADER_TEXT and the title, the stripes\n(DRAW_STRIPES), MENU_GAP_TEXT, then each item at line 8 + n, column 7, after a space and\npadded with spaces, 14 cells in all; a border drawn around it (PLOT_LINE), and the bar on\nthe first item (MENU_BAR).","comment":"The menu's text kept"},
        "13993": {"comment":"MENU_AREA_SAVE: what the menu covers saved"},
        "13996": {"comment":"TV_FLAG bit 0 cleared: printing to the main screen"},
        "14002": {"comment":"E = the count"},
        "14004": {"comment":"The header's place and colours (MENU_HEADER_TEXT)"},
        "14012": {"comment":"The title (PRINT_FF_TEXT)"},
        "14015": {"comment":"DRAW_STRIPES: the title's stripes"},
        "14019": {"comment":"The text at $37FA after the stripes"},
        "14025": {"comment":"HL = the items"},
        "14026": {"comment":"The count kept"},
        "14027": {"comment":"AT line 8, column 7"},
        "14033": {"synopsis":"One item at the print position: a space, then up to 12 characters.","comment":"The line kept; B = 12 characters at most"},
        "14036": {"comment":"A space first"},
        "14039": {"synopsis":"The next character; the one with bit 7 is the last.","comment":"The next character"},
        "14041": {"comment":"Bit 7: the item's last?"},
        "14045": {"comment":"Printed"},
        "14048": {"synopsis":"The last character without bit 7.","comment":"Without bit 7, printed"},
        "14051": {"synopsis":"Spaces to the width.","comment":"A space, B times: the line is 14 cells wide"},
        "14056": {"comment":"The next line"},
        "14058": {"comment":"AT the next line"},
        "14061": {"comment":"Items left?"},
        "14064": {"comment":"The border: down, across, up"},
        "14067": {"comment":"E = the count"},
        "14068": {"comment":"Times 8: the height in pixels"},
        "14074": {"comment":"D = the height - 1"},
        "14076": {"comment":"E = 111, the width"},
        "14078": {"comment":"The left side: y - 1 each, D pixels down"},
        "14085": {"comment":"The bottom: x + 1 each, E pixels across"},
        "14092": {"comment":"The right side: y + 1 each, D + 1 pixels up"},
        "14100": {"comment":"The bar on item 0"},
        "14105": {"synopsis":"Plots A pixels from H, L, stepping by BC each time (ROM 1's PLOT_SUB after its COORDS,\n$22E9).","comment":"AF, HL, DE, BC kept"},
        "14109": {"comment":"B = y (H), C = x (L)"},
        "14111": {"comment":"ROM 1's PLOT_SUB from $22E9: pixel C, B plotted"},
        "14114": {"comment":"Back"},
        "14118": {"comment":"H, L one step on"},
        "14119": {"comment":"More?"},
        "14123": {"synopsis":"AT B, C through RST $10.","comment":"AT"},
        "14126": {"comment":"Line B"},
        "14128": {"comment":"Column C"},
        "14131": {"synopsis":"Prints the characters at HL through RST $10, up to the $FF that ends them.","comment":"The next character"},
        "14133": {"comment":"$FF: the end?"},
        "14136": {"comment":"Printed"},
        "14139": {"synopsis":"Saves TV_FLAG, COORDS onwards (20 bytes) and the screen and attributes where the menu goes\nto $EEF6 on; MENU_AREA_BACK ($373E) puts them back.","comment":"Carry: saving"},
        "14142": {"synopsis":"The other way: back from $EEF6.","comment":"No carry: putting back"},
        "14143": {"synopsis":"The copy, from the menu's area to $EEF6 with carry, the other way without: DE is kept as the\nplace in $EEF6.","comment":"DE = the store at $EEF6, HL = TV_FLAG"},
        "14149": {"comment":"Saving: from TV_FLAG to the store"},
        "14151": {"comment":"Putting back: the other way"},
        "14152": {"synopsis":"TV_FLAG.","comment":"TV_FLAG copied"},
        "14154": {"comment":"DE = the store's place again"},
        "14157": {"synopsis":"HL = COORDS ($5C7D).","comment":"HL = COORDS"},
        "14160": {"comment":"Putting back: swapped"},
        "14163": {"synopsis":"20 bytes from COORDS.","comment":"20 bytes copied"},
        "14168": {"comment":"DE = the store's place again"},
        "14171": {"synopsis":"The screen: 12 lines from line 7, columns 7-20; the direction kept in F'.","comment":"The direction kept in F'"},
        "14172": {"comment":"Line 7, column 7"},
        "14175": {"comment":"POSN_TO_ROM1: line and column in ROM 1's form"},
        "14183": {"comment":"12 lines"},
        "14185": {"synopsis":"One line: its display address (ROM 1's LINE_SCREEN_ADDR) + 7."},
        "14188": {"comment":"ROM 1's LINE_SCREEN_ADDR: HL = the line's display address"},
        "14191": {"comment":"Plus 7: column 7"},
        "14195": {"comment":"DE = the store's place"},
        "14196": {"comment":"MENU_LINE_COPY: the line's 8 pixel rows and attributes"},
        "14201": {"comment":"The next line down"},
        "14202": {"comment":"More?"},
        "14206": {"synopsis":"Eight pixel rows of 14 bytes, then the line's 14 attributes (ROM 1's LINE_ATTR_ADDR),\nbetween HL and DE as F' carry says.","comment":"B = 8 pixel rows, C = 14 bytes in each"},
        "14209": {"synopsis":"One pixel row.","comment":"The row count kept, BC = 14"},
        "14212": {"comment":"The row's start kept"},
        "14213": {"comment":"The direction from F'"},
        "14214": {"comment":"Saving: from the screen"},
        "14216": {"comment":"Putting back: to the screen"},
        "14217": {"synopsis":"14 bytes."},
        "14219": {"comment":"The pair as it was"},
        "14222": {"synopsis":"The next pixel row down.","comment":"The direction back in F'"},
        "14223": {"comment":"HL = the next pixel row (H + 1)"},
        "14225": {"comment":"Rows left?"},
        "14228": {"comment":"BC = 14 and the store's place kept"},
        "14230": {"comment":"ROM 1's LINE_ATTR_ADDR: the line's attributes"},
        "14233": {"comment":"HL = the attributes' address"},
        "14234": {"comment":"DE = the store's place, BC = 14"},
        "14236": {"comment":"The direction from F'"},
        "14237": {"comment":"Saving: from the attributes"},
        "14239": {"comment":"Putting back: to them"},
        "14240": {"synopsis":"14 attributes."},
        "14242": {"comment":"The pair as it was"},
        "14245": {"synopsis":"The direction back in F'."},
        "14247": {"synopsis":"Moves the menu's bar from item A to the one above it, from item 0 to the last ((HL) - 2, HL\nbeing the menu's text, whose first byte is DRAW_MENU's count).\nExit: A = the new item, carry.","comment":"The bar off item A"},
        "14250": {"comment":"The item above"},
        "14251": {"comment":"Above item 0?"},
        "14254": {"comment":"The last item"},
        "14257": {"synopsis":"The bar on item A."},
        "14260": {"comment":"Carry"},
        "14262": {"synopsis":"Moves the menu's bar from item A to the one below it, from the last ((HL) - 2) to item 0.\nExit: A = the new item. Keeps DE."},
        "14263": {"comment":"The bar off item A"},
        "14266": {"comment":"The item below"},
        "14267": {"comment":"D = it"},
        "14268": {"comment":"Past the last item?"},
        "14271": {"comment":"Past it?"},
        "14272": {"comment":"A = the item below"},
        "14273": {"comment":"Not past the last: kept"},
        "14276": {"comment":"Past it: item 0"},
        "14277": {"synopsis":"The bar on item A."},
        "14282": {"synopsis":"Flips the menu's bar on or off at item A: the 14 attribute cells of row $5907 + 32 x A\nbecome $68 when they are $78, otherwise $78. Keeps all registers.","comment":"AF, HL, DE kept"},
        "14285": {"comment":"HL = item 0's bar: line 8, column 7"},
        "14288": {"comment":"DE = 32, an attribute line"},
        "14291": {"comment":"Item 0?"},
        "14294": {"synopsis":"One attribute line per item.","comment":"Down a line"},
        "14295": {"comment":"For each item"},
        "14298": {"synopsis":"$68 (cyan paper) where it is $78 (white paper), else $78."},
        "14305": {"synopsis":"14 cells."},
        "14307": {"synopsis":"One cell.","comment":"The cell"},
        "14309": {"comment":"More?"},
        "14316": {"synopsis":"DRAW_MENU's texts, each ended by $FF: the header's place and colours (AT 7,7; OVER 0;\nINVERSE 0; INK 7; PAPER 0; BRIGHT 1) from $37EC; PAPER 0, a space, PAPER 7, INK 0 from\n$37FA; at $3802 sixteen bytes of a diagonal stripe pattern; at $3812 the stripes' colours\n(INK 2, INK 6, INK 4, INK 5 over the pattern's characters)."},
        "14370": {"synopsis":"Draws the coloured stripes of a menu title: the pattern at $3802 copied to $5B98 and printed\n(the text at $3812) with CHARS pointed at it. Keeps BC, DE, HL.","comment":"Keep BC, DE and HL"},
        "14373": {"comment":"The two diagonal pictures (16 bytes at $3802) to $5B98"},
        "14384": {"comment":"CHARS kept"},
        "14388": {"comment":"CHARS = $5A98: codes $20 and $21 are the pictures at $5B98"},
        "14394": {"comment":"The stripes: colour changes and codes $20/$21 (PRINT_FF_TEXT)"},
        "14400": {"comment":"CHARS back"},
        "14404": {"comment":"HL, DE and BC back"},
        "14408": {"synopsis":"The bottom title bar with \"128 BASIC\" (MAIN_MENU_ITEMS' second item, at $2769): on at\nTITLE_BAR.","comment":"HL = \"128 BASIC\""},
        "14413": {"synopsis":"The bottom title bar with \"Calculator\" ($2772).","comment":"HL = \"Calculator\""},
        "14418": {"synopsis":"The bottom title bar with \"Tape Loader\" ($275E).","comment":"HL = \"Tape Loader\""},
        "14423": {"synopsis":"The bottom title bar with \"Tape Tester\" ($2784).","comment":"HL = \"Tape Tester\""},
        "14426": {"synopsis":"Draws the title bar on line 21 with the text at HL (ended by bit 7): lines 21 to 23 cleared\n(CLEAR_LOW_3), line 21's 32 attributes $40 (BRIGHT 1, PAPER 0, INK 0), MENU_HEADER_TEXT's\ncolours, the text at AT 21,0 (PRINT_BIT7_TEXT), then the stripes at AT 21,26 (DRAW_STRIPES).","comment":"The title kept"},
        "14427": {"comment":"Lines 21 to 23 cleared (CLEAR_LOW_3)"},
        "14430": {"comment":"Line 21's attributes"},
        "14433": {"comment":"32 cells of $40: BRIGHT 1, PAPER 0, INK 0"},
        "14437": {"synopsis":"One attribute."},
        "14439": {"comment":"All 32?"},
        "14441": {"comment":"MENU_HEADER_TEXT: its colours"},
        "14447": {"comment":"AT 21,0"},
        "14453": {"comment":"The title"},
        "14454": {"comment":"Printed up to its bit-7 end (PRINT_BIT7_TEXT)"},
        "14457": {"comment":"AT 21,26 and the stripes"},
        "14462": {"comment":"DRAW_STRIPES, which returns to the caller"},
        "14465": {"synopsis":"Clears lines 21 to 23 (CLEAR_LINES with B = 21, D = 23).","comment":"B = 21, the first line"},
        "14467": {"comment":"D = 23, the last"},
        "14469": {"comment":"Cleared (CLEAR_LINES)"},
        "14472": {"synopsis":"Renumbers the program (the editor's menu item 1), from the number in $5B94 in steps of the\none in $5B96 (start-up sets both to 10), with bank 0 and the machine stack:\n1. The lines counted (COUNT_LINES); none, or start + step x count (one step past the last\n   line's new number; the product's overflow is not tested) 10000 or more: RENUM_FAIL.\n2. Every line's text is searched for LINE, LIST, LLIST, GO TO, GO SUB, RESTORE and RUN\n   followed by a plain number (RENUM_REF); each such number is replaced by the new number of\n   the line it names.\n3. Every line gets its new number, start + step x its place.\n4. Bank 7 and its stack; $5B92 = 0.\nExit: carry when done; no carry (RENUM_FAIL) when there are no lines, the numbers would go\npast 9999, or there is no room for a longer number.\nObserved: one line, step 10: start 9989 renumbered it to 9989; start 9990 was refused (it\nkept 1).","comment":"Bank 0 and the machine stack (BANK0_STACK)"},
        "14475": {"comment":"DE = the number of lines"},
        "14478": {"comment":"No lines at all?"},
        "14483": {"comment":"Start + step x count: one step past the last new number"},
        "14486": {"comment":"HL = step x count (ROM 1's HL_HL_X_DE; its carry not checked)"},
        "14489": {"comment":"DE = step x count"},
        "14490": {"comment":"HL = the start number"},
        "14493": {"comment":"HL = start + step x count: one step past the last new number"},
        "14494": {"comment":"10000 or more?"},
        "14503": {"comment":"From the first line"},
        "14506": {"synopsis":"One line: $5B92 = the address of its length, $5B6B = the next line's (ROM 1's NEXT_ITEM).","comment":"DE = the next line (ROM 1's NEXT_ITEM)"},
        "14509": {"comment":"HL = the address of the line's length"},
        "14511": {"comment":"Kept in $5B92"},
        "14514": {"comment":"HL = the line's first character"},
        "14516": {"comment":"The next line"},
        "14520": {"synopsis":"The line's next character, past a hidden number (ROM 1's SKIP_NUMBER); up to its ENTER each\nis checked by RENUM_REF.","comment":"A = the character"},
        "14521": {"comment":"Past a hidden number (ROM 1's SKIP_NUMBER)"},
        "14524": {"comment":"The line's end?"},
        "14528": {"comment":"A keyword with a line number to change? (RENUM_REF)"},
        "14531": {"comment":"The next character"},
        "14533": {"synopsis":"The line done: on to the next, up to VARS.","comment":"DE = the next line"},
        "14537": {"comment":"Reached VARS?"},
        "14543": {"comment":"HL = the next line"},
        "14546": {"comment":"Second pass: BC = the count, DE = 0, the place"},
        "14549": {"comment":"BC = the count"},
        "14551": {"comment":"DE = 0, the line's place"},
        "14554": {"comment":"HL = PROG, the first line"},
        "14557": {"synopsis":"One line's new number: step x DE + start, written high byte first over the old; then past\nthe line by its length.","comment":"Count, place and line kept"},
        "14560": {"comment":"HL = the step"},
        "14563": {"comment":"HL = step x place (ROM 1's HL_HL_X_DE)"},
        "14566": {"comment":"Plus the start: the new number"},
        "14571": {"comment":"DE = the new number"},
        "14572": {"comment":"HL = the line"},
        "14573": {"comment":"Written over the old, high byte first"},
        "14577": {"comment":"BC = the line's length"},
        "14580": {"comment":"HL past the length, then past the line"},
        "14582": {"comment":"DE = the next place"},
        "14584": {"comment":"BC = the lines left"},
        "14585": {"comment":"The last line?"},
        "14590": {"comment":"Bank 7 and its stack"},
        "14593": {"comment":"$5B92 = 0"},
        "14597": {"comment":"Carry: done"},
        "14599": {"synopsis":"RENUM_REF's keywords, searched with CPIR: LINE, LIST, LLIST, GO TO, GO SUB, RESTORE, RUN\n($CA $F0 $E1 $EC $ED $E5 $F7)."},
        "14606": {"synopsis":"Checks the character A at HL for a line number to change: when it is one of RENUM_TOKENS and\na number follows (spaces, digits, '.', 'E' after a digit) whose hidden form is followed by\n':' or ENTER, the number's text and hidden value are replaced by the new number of the line\nit names (the first line from that number on): RENUM_REF_NUMBER. $5B79 = the place after the\nkeyword, $5B71 = the old text's length.\nExit: HL = the place to go on from; $5B6B and the line's length moved by the change.","comment":"HL = the place after the character"},
        "14607": {"comment":"$5B79: the place after the keyword"},
        "14610": {"comment":"DE = it"},
        "14611": {"comment":"RENUM_TOKENS' 7 codes searched for A"},
        "14617": {"comment":"One of RENUM_TOKENS?"},
        "14619": {"comment":"HL = the place after the character"},
        "14620": {"comment":"Not one: back"},
        "14621": {"comment":"BC counts the number's characters"},
        "14623": {"synopsis":"The next character of the number.","comment":"A = the next character"},
        "14624": {"comment":"A space?"},
        "14628": {"comment":"A digit?"},
        "14633": {"comment":"A '.'?"},
        "14637": {"comment":"The hidden number?"},
        "14641": {"comment":"'e' or 'E'?"},
        "14647": {"comment":"After a digit?"},
        "14651": {"synopsis":"Not a plain number: left as it is; on from $5B79.","comment":"HL = the place after the keyword"},
        "14655": {"synopsis":"Counted; the next."},
        "14656": {"comment":"The next character"},
        "14659": {"synopsis":"The hidden number reached: $5B71 = the text's length; only a number followed (past spaces)\nby ':' or ENTER is changed.","comment":"$5B71 = the text's length"},
        "14663": {"comment":"The marker's place kept"},
        "14664": {"comment":"HL past the hidden number (ROM 1's SKIP_NUMBER)"},
        "14667": {"comment":"Past spaces"},
        "14670": {"comment":"A = the character after it"},
        "14671": {"comment":"HL = the marker"},
        "14672": {"comment":"A ':' after it?"},
        "14676": {"comment":"ENTER after it? Neither: left as it is"},
        "14679": {"synopsis":"The number's value (ROM 1's PUSH_NUMBER, FP_TO_BC) looked up as a line (ROM 1's FIND_LINE).\nNo such line and nothing after the program (the byte there $80): 9999. Otherwise HL is the\nline after the number, whose new number is used (past the last line, with variables there:\nstart + step x count).","comment":"HL = the hidden number's five bytes"},
        "14680": {"comment":"Stacked (ROM 1's PUSH_NUMBER)"},
        "14683": {"comment":"BC = its value (ROM 1's FP_TO_BC)"},
        "14686": {"comment":"HL = the line number"},
        "14688": {"comment":"HL = the first line from it on (ROM 1's FIND_LINE)"},
        "14691": {"comment":"That line?"},
        "14693": {"comment":"No: the byte there, a line's or the variables'"},
        "14694": {"comment":"Past the last line?"},
        "14698": {"comment":"No line from it on and no variables: 9999"},
        "14703": {"synopsis":"The line found: its new number, step x its place (COUNT_LINES_TO) + start.","comment":"$5B77 = the line found"},
        "14706": {"comment":"DE = the lines before it (COUNT_LINES_TO)"},
        "14709": {"comment":"HL = the step"},
        "14712": {"comment":"HL = step x place (ROM 1's HL_HL_X_DE)"},
        "14715": {"comment":"Plus the start: its new number"},
        "14720": {"synopsis":"The new number HL as text at $5B73 (NUMBER_TEXT, leading zeros dropped); $5B71 = its length\nless the old text's.","comment":"The text to $5B73"},
        "14723": {"comment":"The new number kept, for the hidden form"},
        "14724": {"comment":"HL = the first digit kept, B = the digits after it (NUMBER_TEXT)"},
        "14727": {"comment":"DE = the new text's length"},
        "14731": {"comment":"The length and the first digit kept"},
        "14733": {"comment":"HL = the new length"},
        "14736": {"comment":"BC = the old length"},
        "14740": {"comment":"HL = the new length less the old"},
        "14743": {"comment":"$5B71 = the difference"},
        "14746": {"comment":"The same length?"},
        "14748": {"comment":"Shorter?"},
        "14750": {"comment":"Longer: room for the difference after the keyword"},
        "14752": {"comment":"HL = the place after the keyword"},
        "14755": {"comment":"The place and the length kept"},
        "14757": {"comment":"Room for it? (as ROOM_TEST_BC)"},
        "14763": {"comment":"DE = STKEND + the difference"},
        "14764": {"comment":"Plus $82 bytes to spare"},
        "14770": {"comment":"Below the stack?"},
        "14775": {"comment":"DE = the length, HL = the place"},
        "14777": {"comment":"Opened (ROM 1's MAKE_ROOM)"},
        "14782": {"synopsis":"No room: the two words dropped; on to RENUM_FAIL.","comment":"The length and the place dropped"},
        "14784": {"synopsis":"Bank 7 and its stack (BANK7_STACK), no carry, and a return: the swap back to bank 7's stack\nreturns to RENUMBER's caller from any depth, leaving the machine stack as it was.","comment":"Bank 7 and its stack (BANK7_STACK)"},
        "14787": {"comment":"No carry: not done"},
        "14789": {"synopsis":"Shorter: BC = the old length less the new; that many bytes after the keyword removed (ROM\n1's RECLAIM).","comment":"BC less the new length, one by one"},
        "14793": {"comment":"HL = the place after the keyword"},
        "14796": {"comment":"BC bytes removed there (ROM 1's RECLAIM)"},
        "14799": {"synopsis":"The new digits copied after the keyword, then the number marker $0E and the new value's five\nbytes (ROM 1's STACK_BC); the line's length at ($5B92) and the next line's address ($5B6B)\nmoved by the change in $5B71.","comment":"DE = the place after the keyword"},
        "14803": {"comment":"HL = the new text, BC = its length"},
        "14805": {"comment":"The digits copied in"},
        "14807": {"comment":"HL = the byte after them"},
        "14808": {"comment":"The number marker"},
        "14810": {"comment":"BC = the new number"},
        "14811": {"comment":"The five bytes' place kept"},
        "14813": {"comment":"The new value, and its 5 bytes"},
        "14816": {"comment":"DE = their place"},
        "14817": {"comment":"The five bytes copied over the old ones"},
        "14822": {"comment":"The place after them kept"},
        "14824": {"comment":"The line's length"},
        "14828": {"comment":"DE = the length"},
        "14831": {"comment":"Plus the difference"},
        "14835": {"comment":"DE = the new length"},
        "14836": {"comment":"HL = its address"},
        "14837": {"comment":"Stored"},
        "14840": {"comment":"The next line's address"},
        "14843": {"comment":"Moved by the difference"},
        "14851": {"comment":"HL = the place after the number"},
        "14853": {"synopsis":"DE = the number of program lines: COUNT_LINES_TO with $5B77 = VARS.","comment":"HL = VARS"},
        "14856": {"comment":"$5B77 = it, the place to count to"},
        "14859": {"synopsis":"DE = the number of program lines before the address in $5B77, stepping from PROG with ROM\n1's NEXT_ITEM (0 when it is PROG).\nChanges: A, BC, DE, HL.","comment":"HL = PROG"},
        "14862": {"comment":"DE = the place to count to"},
        "14866": {"comment":"The first line?"},
        "14871": {"comment":"HL = PROG"},
        "14874": {"comment":"BC = 0 lines"},
        "14877": {"synopsis":"The next line: is it the one?","comment":"The count kept"},
        "14878": {"comment":"DE = the next line (ROM 1's NEXT_ITEM)"},
        "14881": {"comment":"The place reached?"},
        "14889": {"comment":"HL = the next line"},
        "14890": {"comment":"One more line"},
        "14894": {"synopsis":"Found: DE = the count.","comment":"DE = the count"},
        "14895": {"comment":"Plus the line just stepped over"},
        "14897": {"synopsis":"It is the first: DE = 0.","comment":"None before it"},
        "14901": {"synopsis":"HL moved on, then SKIP_SPACES.","comment":"The next byte"},
        "14902": {"synopsis":"A = the byte at HL, HL moved past spaces.","comment":"A = the byte"},
        "14903": {"comment":"A space?"},
        "14908": {"synopsis":"Writes HL (0-9999) as four digits at DE (NUMBER_DIGIT for the thousands, hundreds and tens),\nthen turns up to three leading '0's into spaces.\nExit: HL = the first digit kept, B = the digits after it; DE past the fourth.\nChanges: A, BC, DE, HL.","comment":"The text's start kept"},
        "14909": {"comment":"-1000"},
        "14912": {"comment":"The thousands (NUMBER_DIGIT)"},
        "14915": {"comment":"-100"},
        "14918": {"comment":"The hundreds"},
        "14921": {"comment":"-10"},
        "14923": {"comment":"The tens"},
        "14926": {"comment":"The units"},
        "14927": {"comment":"As a character"},
        "14929": {"comment":"Written"},
        "14931": {"comment":"B = up to three leading '0's"},
        "14933": {"comment":"HL = the first digit"},
        "14934": {"synopsis":"A leading '0'?","comment":"A = the digit"},
        "14937": {"comment":"Not a '0': HL = the first digit kept"},
        "14938": {"comment":"Made a space"},
        "14941": {"comment":"Up to three"},
        "14944": {"synopsis":"One digit: how many times BC (a negative power of ten) goes into HL, as a character at DE;\nHL keeps the rest.","comment":"A counts"},
        "14945": {"synopsis":"One more.","comment":"The power of ten taken off"},
        "14946": {"comment":"Counted"},
        "14947": {"comment":"Not below zero yet?"},
        "14949": {"comment":"The last one undone"},
        "14951": {"comment":"A = the digit"},
        "14952": {"comment":"As a character"},
        "14954": {"comment":"Written at DE"},
        "14957": {"synopsis":"The editor's window for the main screen, copied to $FD6C (IX) by WINDOW_SET: a count (8),\nthen the bytes 0, 0 (IX + 1, its top line), 20 (IX + 2, its last line counted from the top),\n0, 0, 0, $0F (IX + 6, the cursor's colour), 0."},
        "14966": {"synopsis":"The window for the lower screen: a count (8), then 0, 22 (its top line), 1 (its last line\ncounted from the top: lines 22-23), 0, 0, 0, $0F, 0."},
        "14975": {"synopsis":"IX = $FD6C, the window there from WINDOW_MAIN_DATA (main screen, lines 0-20).","comment":"IX = the window's bytes"},
        "14979": {"comment":"HL = WINDOW_MAIN_DATA"},
        "14984": {"synopsis":"The window at $FD6C from WINDOW_LOW_DATA (lines 22-23).","comment":"HL = WINDOW_LOW_DATA (IX as it was)"},
        "14987": {"synopsis":"The 8 bytes at HL to $FD6C (COPY_COUNTED).","comment":"DE = the window at $FD6C"},
        "14990": {"comment":"The 8 bytes copied (COPY_COUNTED)"},
        "14993": {"synopsis":"Prints A, then D (RST $10 each); carry. Nothing in this ROM calls it.","comment":"A printed"},
        "14994": {"comment":"Then D"},
        "14996": {"comment":"Carry"},
        "14998": {"synopsis":"The cursor's colour, IX + 6 = A's PAPER and INK bits ($3F); carry.","comment":"PAPER and INK only"},
        "15000": {"comment":"The cursor's colour"},
        "15003": {"comment":"Carry"},
        "15005": {"synopsis":"Shows the cursor at line B of the window (IX + 1 added), column C: the attribute there kept\nin IX + 7, then replaced by IX + 6's colour with the old FLASH and BRIGHT bits inverted.\nCarry.\nChanges: A, B, DE, HL.","comment":"B = the screen line: B + the window's top"},
        "15010": {"comment":"HL = the cell's attribute address (ATTR_ADDRESS)"},
        "15013": {"comment":"The old attribute kept in IX + 7"},
        "15017": {"comment":"FLASH, BRIGHT inverted"},
        "15020": {"comment":"Plus the cursor's colour"},
        "15023": {"comment":"Shown"},
        "15024": {"comment":"Carry"},
        "15026": {"synopsis":"Takes the cursor off line B of the window, column C: the attribute kept in IX + 7 put back.","comment":"B = the screen line: B + the window's top"},
        "15031": {"comment":"HL = the cell's attribute address (ATTR_ADDRESS)"},
        "15034": {"comment":"The attribute kept in IX + 7 put back"},
        "15039": {"synopsis":"Scrolls the window's lines B to E up by one (pixels and attributes, each line from the one\nbelow), then prints the 32 characters at HL on line E (PRINT_ROW).","comment":"The text kept"},
        "15040": {"comment":"H = 0: up"},
        "15042": {"comment":"A = the lines to move, E less B"},
        "15046": {"synopsis":"Scrolls the window's lines B to E down by one (B the upper; each line from the one above,\nstarting at E), then prints the 32 characters at HL on line B (PRINT_ROW).","comment":"The text kept"},
        "15047": {"comment":"B = the lower line E, E = the upper B"},
        "15050": {"comment":"A = the lines to move"},
        "15051": {"comment":"H = $FF: down"},
        "15053": {"synopsis":"C = the lines to move; none when B = E.","comment":"C = the count"},
        "15054": {"comment":"Only one line?"},
        "15058": {"comment":"The line to print kept in E"},
        "15059": {"comment":"B in ROM 1's form"},
        "15062": {"synopsis":"One line: its display address (ROM 1's LINE_SCREEN_ADDR), and the source's, one below (up)\nor one above (down).","comment":"Line and count kept"},
        "15063": {"comment":"C = the direction"},
        "15064": {"comment":"DE = the line's display address (ROM 1's LINE_SCREEN_ADDR)"},
        "15068": {"comment":"Up?"},
        "15072": {"comment":"Down: the line above (ROM 1 counts lines upwards)"},
        "15075": {"synopsis":"Up: the line below.","comment":"One line lower"},
        "15076": {"synopsis":"Its 8 pixel rows copied, 32 bytes each.","comment":"The target kept"},
        "15077": {"comment":"HL = the source's display address (ROM 1's LINE_SCREEN_ADDR)"},
        "15080": {"comment":"DE = the target"},
        "15081": {"comment":"A = the direction"},
        "15082": {"comment":"32 bytes a row, 8 rows"},
        "15086": {"synopsis":"One pixel row.","comment":"Count and addresses kept"},
        "15089": {"comment":"BC = 32"},
        "15091": {"comment":"One row copied"},
        "15093": {"comment":"Addresses and count back"},
        "15096": {"comment":"Both one pixel row down"},
        "15098": {"comment":"The next row"},
        "15100": {"comment":"The attribute rows (ROM 1's LINE_ATTR_ADDR for each), 32 bytes"},
        "15102": {"comment":"DE = the source's attributes (ROM 1's LINE_ATTR_ADDR)"},
        "15106": {"comment":"The target's row taken, the source's attributes kept"},
        "15107": {"comment":"DE = the target's attributes (ROM 1's LINE_ATTR_ADDR)"},
        "15111": {"comment":"HL = the source's attributes, the target's kept"},
        "15112": {"comment":"DE = the target's attributes"},
        "15113": {"comment":"32 attributes copied"},
        "15118": {"comment":"A = the direction"},
        "15119": {"comment":"B = the line, C = the count"},
        "15120": {"comment":"Up?"},
        "15123": {"comment":"Down: the line above"},
        "15126": {"synopsis":"Up: the next line is the one below.","comment":"One line lower"},
        "15127": {"synopsis":"The next, while C counts.","comment":"One fewer: more to move?"},
        "15128": {"comment":"H = the direction again"},
        "15131": {"comment":"DE = the lines given"},
        "15132": {"comment":"B = E: the freed line"},
        "15133": {"synopsis":"The freed line printed.","comment":"HL = the text"},
        "15134": {"synopsis":"Prints the 32 characters at HL on line B, from column 0 (PRINT_AT_BC), with the editor's\ncolours (SWAP_COLOURS around it); in the lower screen (TV_FLAG bit 0 set) when $EC0D bit 6\nis set. A 0 prints as a space; codes from $90 are printed with bank 0 paged in. TV_FLAG\nkept. Carry.","comment":"The editor's colours in (SWAP_COLOURS)"},
        "15137": {"comment":"DE = the text"},
        "15138": {"comment":"TV_FLAG kept"},
        "15142": {"comment":"Lower screen?"},
        "15147": {"comment":"Bit 0 off: the main screen"},
        "15151": {"comment":"Bit 0 on: the lower screen"},
        "15153": {"synopsis":"TV_FLAG set; AT B,0.","comment":"TV_FLAG set"},
        "15156": {"comment":"AT B,0 (PRINT_AT_BC)"},
        "15161": {"comment":"HL = the text"},
        "15162": {"comment":"32 characters"},
        "15164": {"synopsis":"One character: 0 is a space.","comment":"A = the character"},
        "15165": {"comment":"A 0?"},
        "15168": {"comment":"A space instead"},
        "15170": {"synopsis":"From $90 up?","comment":"A UDG or a token?"},
        "15174": {"comment":"Printed (ROM 1's RST $10)"},
        "15177": {"synopsis":"The next.","comment":"The next character"},
        "15178": {"comment":"All 32?"},
        "15180": {"comment":"TV_FLAG back"},
        "15184": {"comment":"The program's colours back (SWAP_COLOURS)"},
        "15187": {"comment":"Carry"},
        "15189": {"synopsis":"From $90: printed with bank 0 and the machine stack, then back to bank 7.","comment":"Bank 0 and the machine stack (BANK0_STACK)"},
        "15192": {"comment":"Printed (RST $10), with bank 0's UDGs in place"},
        "15193": {"comment":"Bank 7 and its stack (BANK7_STACK)"},
        "15198": {"synopsis":"Clears the window's lines B to D (IX + 1 added): their pixels to 0 and their attributes to\nthe editor's ATTR_P (SWAP_COLOURS around it), through ROM 1's LINE_SCREEN_ADDR and\nLINE_ATTR_ADDR. Carry.","comment":"The editor's colours in (SWAP_COLOURS)"},
        "15201": {"comment":"C = the number of lines"},
        "15205": {"comment":"B in ROM 1's form (LINE_TO_ROM1)"},
        "15208": {"synopsis":"One line.","comment":"Line and count kept"},
        "15209": {"comment":"HL = its display address (ROM 1's LINE_SCREEN_ADDR)"},
        "15212": {"comment":"8 pixel rows"},
        "15214": {"synopsis":"One of its 8 pixel rows.","comment":"The row's start kept"},
        "15215": {"comment":"32 bytes of 0"},
        "15218": {"synopsis":"One byte.","comment":"Cleared"},
        "15220": {"comment":"All 32?"},
        "15222": {"comment":"HL = the row's start"},
        "15223": {"comment":"The next pixel row"},
        "15224": {"comment":"All 8?"},
        "15227": {"comment":"B = 32"},
        "15230": {"comment":"DE = the line's attributes (ROM 1's LINE_ATTR_ADDR, HL 2K on)"},
        "15233": {"comment":"HL = them"},
        "15234": {"comment":"B = 32"},
        "15235": {"comment":"ATTR_P"},
        "15238": {"synopsis":"One attribute."},
        "15240": {"comment":"All 32?"},
        "15242": {"comment":"B = the line, C = the count"},
        "15243": {"comment":"One line lower (ROM 1 counts lines upwards)"},
        "15244": {"comment":"One fewer: more?"},
        "15247": {"comment":"The program's colours back (SWAP_COLOURS)"},
        "15250": {"comment":"Carry"},
        "15252": {"synopsis":"Line B, column C of the window in ROM 1's print-position form: C = 33 - C, then\nLINE_TO_ROM1.","comment":"C = 33 - C, the column as ROM 1 counts it"},
        "15256": {"synopsis":"B = 24 - B - (IX + 1): line B of the window as ROM 1 counts lines.\nChanges: A, B.","comment":"A = 24 - B"},
        "15259": {"comment":"Less the window's top line"},
        "15262": {"comment":"B = it"},
        "15264": {"synopsis":"HL = $5800 + 32 x B + C, the attribute address of line B, column C. Keeps BC.\nChanges: A, DE, HL.","comment":"BC kept"},
        "15265": {"comment":"DE = B x 256"},
        "15268": {"comment":"Three shifts right: DE = B x 32"},
        "15280": {"comment":"The attribute area"},
        "15283": {"comment":"BC = the column"},
        "15284": {"comment":"Plus the column and 32 x the line"},
        "15286": {"comment":"BC back"},
        "15288": {"synopsis":"Swaps ATTR_P, MASK_P, ATTR_T and MASK_T ($5C8D-$5C90) with the copies at $EC0F-$EC12, and\nP_FLAG with $EC13: the editor's colours in, or the program's back. Keeps AF, DE and HL.\nChanges: DE', HL'.","comment":"AF, HL and DE kept"},
        "15291": {"comment":"HL = ATTR_P and MASK_P"},
        "15294": {"comment":"DE = ATTR_T and MASK_T"},
        "15298": {"comment":"The alternate set for the copies"},
        "15299": {"comment":"HL, DE = the copies at $EC0F"},
        "15306": {"comment":"To the system variables"},
        "15313": {"comment":"The old values"},
        "15314": {"comment":"Kept at $EC0F"},
        "15321": {"comment":"P_FLAG and $EC13"},
        "15324": {"comment":"A = P_FLAG"},
        "15327": {"comment":"D = the copy"},
        "15328": {"comment":"P_FLAG kept"},
        "15329": {"comment":"The copy to P_FLAG"},
        "15333": {"comment":"DE, HL and AF back"},
        "15337": {"synopsis":"The start-up menu's Tape Tester (from $2816): after a pause (TAPE_PAUSE), with interrupts\noff, shows the level at the EAR input (port $FE bit 6) as a mark on line 8: six cells of\nline 7 (from column 1, every sixth) made black, then over and over 2047 samples taken (DE =\n2048, decremented before the first); the share of them that differ from the level first\nseen, 0-32, moves a cell with attribute $68 along line 8 (the rest $48), one frame each.\nENTER, SPACE or 1 (bit 0 of ports $BFFE, $7FFE, $F7FE) ends it through TAPE_PAUSE.","comment":"A pause first (TAPE_PAUSE)"},
        "15340": {"comment":"Interrupts off while sampling"},
        "15341": {"comment":"The first level, kept in F'"},
        "15346": {"comment":"Line 7's marks: attribute 0"},
        "15349": {"comment":"DE = every sixth cell"},
        "15352": {"comment":"B = 6 marks"},
        "15353": {"comment":"A = 0: black"},
        "15354": {"synopsis":"One mark.","comment":"Made black"},
        "15355": {"comment":"The sixth cell on"},
        "15356": {"comment":"All six?"},
        "15358": {"synopsis":"One reading: HL counts the high samples, DE = 2048 (2047 samples)."},
        "15364": {"comment":"ENTER?"},
        "15369": {"comment":"Pressed? Out through TAPE_PAUSE"},
        "15373": {"comment":"SPACE?"},
        "15377": {"comment":"Pressed?"},
        "15381": {"comment":"1?"},
        "15385": {"comment":"Pressed?"},
        "15389": {"synopsis":"One sample.","comment":"One fewer"},
        "15390": {"comment":"All taken?"},
        "15394": {"comment":"EAR high?"},
        "15400": {"comment":"Counted"},
        "15403": {"synopsis":"H = the count / 64 (0-32); L = H when the first level was low, 32 - H when it was high.","comment":"HL x 4: H = the count / 64"},
        "15411": {"comment":"The first level: low?"},
        "15414": {"comment":"Swapped back"},
        "15415": {"comment":"L = 32 - H"},
        "15421": {"synopsis":"The first level low.","comment":"Swapped back"},
        "15422": {"comment":"L = H"},
        "15423": {"synopsis":"After a frame (HALT), line 8's 32 attributes $48, then the one at column L $68.","comment":"H = 0: HL = the column"},
        "15425": {"comment":"DE = line 8, column 31"},
        "15428": {"comment":"32 cells of $48: BRIGHT 1, PAPER 1, INK 0"},
        "15432": {"comment":"One frame"},
        "15434": {"comment":"Interrupts off again"},
        "15435": {"synopsis":"One attribute, from column 31 down.","comment":"Line 8 coloured"},
        "15437": {"comment":"All 32?"},
        "15439": {"comment":"DE = line 8, column 0"},
        "15440": {"comment":"HL = column L (32 is line 9's first cell)"},
        "15441": {"comment":"The mark: $68, BRIGHT 1, PAPER 5, INK 0"},
        "15444": {"comment":"The next reading"},
        "15446": {"synopsis":"Interrupts on, 25 frames waited, FLAGS bit 5 cleared (no new key); carry.","comment":"Interrupts on"},
        "15447": {"comment":"25 frames"},
        "15449": {"synopsis":"One frame.","comment":"One frame"},
        "15452": {"comment":"FLAGS"},
        "15455": {"comment":"Bit 5 off: no new key"},
        "15457": {"comment":"Carry"},
        "15459": {"synopsis":"TOKENIZE in mode 1 ($FD8A = 1), from $2D01: the edit line is walked, not written\n(TOK_WRITE), and TOKENIZE returns as soon as the place reaches X_PTR, or at ENTER.\nExit: carry; BC = the characters read up to there (at X_PTR, the smaller of read and\nwritten).","comment":"Mode 1: the line walked, not written"},
        "15463": {"synopsis":"TOKENIZE in mode 0 ($FD8A = 0), from $2CC1: the line is written into the edit line.","comment":"Mode 0: the line written"},
        "15465": {"synopsis":"Turns the line the editor holds, read character by character ($2D54 through TOK_GET_CHAR),\ninto a BASIC line at E_LINE, keywords typed letter by letter becoming their tokens:\n1. $FD8A = the mode; $FD85 (characters read) and $FD87 (written) = 0; $FD8B = SP, for the\n   returns from deeper down; $34EA; $FD84 = 0; the word buffer $FD74 empty ($FD7D its end).\n2. The edit line emptied (ROM 1's CLEAR_EDIT_WS, bank 0); $FD81 = 0, the state; $FD82 =\n   E_LINE, the place written; $FD7F = 0.\n3. Each character's class (TOK_GET_CHAR): letters gather in the buffer; at the first\n   character that cannot be in a word the buffer is looked up (KEYWORD_LOOKUP) and written\n   as a token or as its letters. A space in a word is kept once ($FD7F marks it), so that GO\n   TO and DEF FN are found; when the two words are not one keyword the first is written as\n   text and the rest looked up again.\n4. The state: 0 between words, 1 in a word, 2 in quotes ('\"' toggles it), 4 after REM: in 2\n   and 4 the characters are written as they are.\n5. Writing goes through TOK_OUT (< >, <= >= and <> joined), TOK_PUT (states) and TOK_SPACING\n   (spaces around keywords dropped).\nExit: mode 0: no carry at the line's ENTER; mode 1 as TOKENIZE_FIND.","comment":"$FD8A = the mode"},
        "15468": {"comment":"$FD85 and $FD87 = 0: none read, none written"},
        "15477": {"comment":"$FD8B = SP"},
        "15481": {"comment":"$FCA1 and $FC9F = 0 (EXPAND_CLEAR)"},
        "15484": {"comment":"$FD84 = 0: no keyword last, no space held"},
        "15489": {"comment":"The word buffer empty"},
        "15495": {"comment":"Bank 0 and the machine stack (BANK0_STACK)"},
        "15498": {"comment":"The edit line emptied (ROM 1)"},
        "15501": {"comment":"Bank 7 and its stack (BANK7_STACK)"},
        "15504": {"comment":"$FD81 = 0: between words"},
        "15509": {"comment":"$FD82: the place to write, at E_LINE"},
        "15515": {"comment":"$FD7F = 0: no space in the word"},
        "15521": {"synopsis":"The next character: $FD85 counted, B = it, C = its class (TOK_GET_CHAR).","comment":"One more read ($FD85)"},
        "15528": {"comment":"B = the character, A = its class (TOK_GET_CHAR)"},
        "15531": {"comment":"C = the class"},
        "15532": {"comment":"Between words?"},
        "15539": {"synopsis":"State 0: a letter starts a word; anything else is written (TOK_CHAR_OUT).","comment":"Can it start a word?"},
        "15544": {"synopsis":"Into the word buffer (TOK_BUF_ADD): state 1.","comment":"Into the word buffer (TOK_BUF_ADD)"},
        "15547": {"comment":"Full?"},
        "15549": {"comment":"State 1: in a word"},
        "15554": {"comment":"The next character"},
        "15556": {"synopsis":"The buffer is full: with a space in it, TOK_SPLIT.","comment":"A space in the word?"},
        "15564": {"synopsis":"The buffer written as text (TOK_FLUSH); state 0.","comment":"The character kept"},
        "15565": {"comment":"The word written as text (TOK_FLUSH)"},
        "15569": {"comment":"State 0"},
        "15574": {"synopsis":"The rest of the word passed as text, up to a character that ends a word (class bit 0), which\nis taken again in state 0.","comment":"Can it end a word?"},
        "15579": {"comment":"No: it is written (TOK_OUT)"},
        "15583": {"comment":"The line's end: done"},
        "15584": {"comment":"One more read"},
        "15591": {"comment":"B = the next, A = its class"},
        "15594": {"comment":"C = the class"},
        "15597": {"synopsis":"B written (TOK_OUT); at ENTER in mode 0, TOKENIZE ends with no carry.","comment":"Written (TOK_OUT)"},
        "15601": {"comment":"The line's end: done"},
        "15602": {"comment":"The next character"},
        "15604": {"synopsis":"State 1 (a word): a letter, '#' or '$' goes into the buffer; other states: written as it is.","comment":"In a word?"},
        "15608": {"comment":"The word ended?"},
        "15613": {"comment":"The character kept"},
        "15614": {"synopsis":"The word ended: looked up (KEYWORD_LOOKUP); a keyword: TOK_KEYWORD.","comment":"A keyword? (KEYWORD_LOOKUP)"},
        "15617": {"comment":"B, C = the character again"},
        "15620": {"comment":"A space in the buffer?"},
        "15627": {"comment":"A space ended it?"},
        "15632": {"comment":"The space into the buffer (TOK_BUF_ADD)"},
        "15635": {"comment":"Full?"},
        "15637": {"comment":"$FD7F = the space's place"},
        "15644": {"comment":"The next character"},
        "15646": {"synopsis":"The buffer is two words and not a keyword: the first written as text, and what follows from\nthe space moved to the buffer's start, then looked up again (at the second time the space\nitself is written and dropped).","comment":"The character kept"},
        "15647": {"comment":"HL = the buffer's start"},
        "15650": {"comment":"DE = the space's place"},
        "15654": {"comment":"The space first?"},
        "15662": {"comment":"Yes: DE one on, so the space itself is written"},
        "15663": {"synopsis":"DE = the last character to write.","comment":"DE = the last character before the space"},
        "15666": {"synopsis":"The next."},
        "15667": {"synopsis":"One character written (TOK_OUT).","comment":"A = the character, bit 7 off"},
        "15670": {"comment":"Both places kept"},
        "15672": {"comment":"Written (TOK_OUT)"},
        "15675": {"comment":"Both places back"},
        "15677": {"comment":"Up to DE?"},
        "15685": {"comment":"The rest moved down"},
        "15689": {"comment":"HL = the buffer's start"},
        "15692": {"comment":"$FD7F = it: the space now first"},
        "15695": {"comment":"BC = the last character's place"},
        "15700": {"comment":"The space was first?"},
        "15708": {"comment":"DE = the character after the space"},
        "15709": {"comment":"$FD7F = 0: no space in the word"},
        "15717": {"comment":"Only the space in the buffer?"},
        "15725": {"comment":"Yes: the character back, the buffer emptied"},
        "15728": {"synopsis":"One byte down, up to the one with bit 7 set; $FD7D = the new end; looked up again.","comment":"One byte down"},
        "15732": {"comment":"The last one (bit 7)?"},
        "15736": {"comment":"$FD7D = the new end"},
        "15739": {"comment":"Looked up again"},
        "15741": {"synopsis":"A keyword: its token written (TOK_OUT); $FD7F = 0; the state 0 unless it is 4 (after REM);\nthe buffer emptied; the character that ended the word taken again at TOK_BETWEEN.","comment":"The character kept"},
        "15742": {"comment":"The token written (TOK_OUT)"},
        "15745": {"comment":"B, C = the character again"},
        "15746": {"comment":"$FD7F = 0: no space in the word"},
        "15752": {"comment":"After REM (state 4)?"},
        "15759": {"synopsis":"State 0."},
        "15764": {"synopsis":"The buffer empty.","comment":"$FD7D = the start: the buffer empty"},
        "15770": {"comment":"The ending character taken again"},
        "15773": {"synopsis":"The next character of the line ($2D54) in B, and its class in A: 6 a letter (bits 1 and 2),\n2 '#' or '$' (bit 1), 3 a space (bits 0 and 1), 1 anything else (bit 0). Bit 2: starts a\nword; bit 1: can be in one; bit 0: ends one.","comment":"A = the next character (LINE_ROWS_CHAR)"},
        "15776": {"comment":"B = it"},
        "15777": {"comment":"Below '?'"},
        "15781": {"comment":"Made lower case"},
        "15783": {"comment":"A letter? (LOWER_TEST)"},
        "15788": {"synopsis":"1: anything else."},
        "15791": {"synopsis":"Below '?': a space, '#' or '$'?","comment":"A space?"},
        "15795": {"comment":"A '#'?"},
        "15799": {"comment":"Below '#': anything else"},
        "15801": {"comment":"A '$'?"},
        "15805": {"synopsis":"2: '#' or '$'."},
        "15808": {"synopsis":"3: a space."},
        "15811": {"synopsis":"6: a letter."},
        "15814": {"synopsis":"Carry when A is a lower-case letter ('a'-'z').","comment":"Past 'z'?"},
        "15817": {"comment":"From 'a' on: carry"},
        "15821": {"synopsis":"Writes the word buffer as text (TOK_SPACING for each character, up to the one with bit 7\nset) and empties it: $FD7D = $FD74, $FD7F = 0.","comment":"The buffer's start"},
        "15824": {"comment":"$FD7D = it: empty"},
        "15827": {"comment":"$FD7F = 0: no space in it"},
        "15834": {"synopsis":"One character.","comment":"A = the character, bit 7 off"},
        "15837": {"comment":"Its place kept"},
        "15838": {"comment":"Written (TOK_SPACING)"},
        "15842": {"comment":"The last one (bit 7)?"},
        "15846": {"comment":"The next"},
        "15849": {"synopsis":"Adds character B to the word buffer ($FD74-$FD7C), the last character marked with bit 7.\nExit: carry; no carry when it is full (its end at $FD7D).","comment":"HL = the buffer's end"},
        "15852": {"comment":"Full (the end at $FD7D)?"},
        "15855": {"comment":"Full?"},
        "15864": {"synopsis":"Not the first: the last one's bit 7 cleared.","comment":"The first character?"},
        "15875": {"synopsis":"Bit 7 off the one before.","comment":"The one before"},
        "15877": {"comment":"Bit 7 off"},
        "15881": {"synopsis":"B stored with bit 7 set; $FD7D moved on.","comment":"B with bit 7: now the last"},
        "15885": {"comment":"$FD7D = the new end"},
        "15889": {"comment":"Carry: added"},
        "15891": {"synopsis":"Full: no carry.","comment":"No carry: full"},
        "15894": {"synopsis":"Writes A, joining a '<' or '>' with the character after it: either is held in $FD89; then <\n> gives <> ($C9), < = gives <= ($C7), > = gives >= ($C8); otherwise the held one is written\nfirst. The rest goes to TOK_PUT.\nExit: carry; no carry at the line's end in mode 0.","comment":"The character kept"},
        "15895": {"comment":"One held in $FD89?"},
        "15901": {"comment":"A = the character"},
        "15902": {"comment":"A '>'?"},
        "15906": {"comment":"A '<'?"},
        "15910": {"synopsis":"On to TOK_PUT.","comment":"Written (TOK_PUT)"},
        "15914": {"synopsis":"'<' or '>' held; carry.","comment":"Held"},
        "15917": {"comment":"Carry"},
        "15919": {"synopsis":"One is held: $FD89 = 0; was it '<'?","comment":"The held one a '<'?"},
        "15921": {"comment":"Nothing held now"},
        "15928": {"comment":"A = the character"},
        "15929": {"comment":"A '>' after it?"},
        "15933": {"comment":"The <> token, $C9"},
        "15937": {"synopsis":"'<' then '='?","comment":"A '=' after it?"},
        "15941": {"comment":"The <= token, $C7"},
        "15945": {"synopsis":"'<' then something else: '<' written first.","comment":"The character kept"},
        "15946": {"comment":"The '<' written (TOK_PUT)"},
        "15951": {"comment":"Then the character"},
        "15954": {"synopsis":"'>' held: then '='?","comment":"A = the character"},
        "15955": {"comment":"A '=' after it?"},
        "15959": {"comment":"The >= token, $C8"},
        "15963": {"synopsis":"'>' then something else: '>' written first.","comment":"The character kept"},
        "15964": {"comment":"The '>' written (TOK_PUT)"},
        "15969": {"comment":"Then the character"},
        "15972": {"synopsis":"Writes A (TOK_SPACING), keeping the state: REM ($EA) makes it 4; '\"' toggles state 2 (bit 1,\nbit 0 cleared). ENTER ends the line: TOK_PUT_ENTER.","comment":"ENTER? Not written: the edit line has one"},
        "15976": {"comment":"REM?"},
        "15978": {"comment":"B = the character"},
        "15981": {"comment":"State 4: after REM"},
        "15988": {"synopsis":"A quote?","comment":"A '\"'?"},
        "15992": {"comment":"The state's bit 0 off, bit 1 toggled"},
        "16002": {"synopsis":"Written; carry.","comment":"A = the character"},
        "16003": {"comment":"Written (TOK_SPACING)"},
        "16006": {"comment":"Carry"},
        "16008": {"synopsis":"ENTER: in mode 0 no carry (the line done); in mode 1 BC = $FD85, SP = $FD8B and a return\nfrom TOKENIZE with carry.","comment":"Mode 0?"},
        "16015": {"comment":"BC = the characters read"},
        "16019": {"comment":"SP as TOKENIZE found it"},
        "16023": {"comment":"Carry, back to TOKENIZE's caller"},
        "16025": {"synopsis":"No carry.","comment":"No carry"},
        "16028": {"synopsis":"Writes A (TOK_WRITE), dropping the spaces around keywords, with the flags in $FD84 (bit 0: a\nkeyword was the last written; bit 1: a space held back): a space after a keyword is dropped;\nof a run of spaces the last is held; a keyword ($A3 and up) drops a held space; any other\ncharacter writes the held one first.","comment":"E = the character"},
        "16029": {"comment":"D = the flags"},
        "16034": {"comment":"A space?"},
        "16038": {"comment":"After a keyword?"},
        "16043": {"comment":"One held already?"},
        "16048": {"comment":"Held: bit 1 set, nothing written"},
        "16055": {"synopsis":"A space held already: this one written.","comment":"This one written (TOK_WRITE)"},
        "16059": {"comment":"A = the flags"},
        "16063": {"synopsis":"After a keyword: dropped.","comment":"Bit 0 off: the space dropped"},
        "16070": {"synopsis":"Not a space: a keyword ($A3 up)?","comment":"A keyword?"},
        "16074": {"comment":"A space held?"},
        "16079": {"comment":"No: bit 0 off"},
        "16085": {"comment":"The character written (TOK_WRITE)"},
        "16090": {"synopsis":"The held space written first, then the character; both flags cleared.","comment":"The character kept"},
        "16091": {"comment":"The held space written (TOK_WRITE)"},
        "16096": {"comment":"DE back"},
        "16097": {"comment":"Both bits off"},
        "16105": {"comment":"Then the character"},
        "16110": {"synopsis":"A keyword: a held space dropped, bit 0 set; written.","comment":"Bit 1 off (the held space dropped), bit 0 on"},
        "16118": {"comment":"The token written (TOK_WRITE)"},
        "16123": {"synopsis":"Writes A at the place in $FD82 and moves it on ($FD87 counted). Mode 0: one byte of room\nopened there (ROOM_TEST_BC, ROM 1's MOVE_POINTERS, the bytes above moved up) and A stored.\nMode 1: nothing written, the place moved past the byte there (and past a hidden number after\n$0E); when the place is X_PTR, BC = the smaller of $FD85 and $FD87, SP = $FD8B and a return\nfrom TOKENIZE with carry.","comment":"One more written ($FD87)"},
        "16130": {"comment":"HL = the place"},
        "16133": {"comment":"B = the character"},
        "16134": {"comment":"Mode 0?"},
        "16139": {"comment":"A = the character"},
        "16142": {"comment":"At X_PTR?"},
        "16154": {"comment":"BC = the characters read"},
        "16158": {"comment":"Fewer written than read?"},
        "16166": {"comment":"Then BC = the characters written"},
        "16170": {"synopsis":"SP back: out of TOKENIZE, carry.","comment":"SP as TOKENIZE found it"},
        "16174": {"comment":"Carry, back to TOKENIZE's caller"},
        "16176": {"synopsis":"Mode 1: carry.","comment":"Carry: mode 1"},
        "16179": {"synopsis":"Mode 0: no carry.","comment":"No carry: mode 0"},
        "16181": {"synopsis":"Bank 0 and the machine stack.","comment":"Bank 0 and the machine stack (BANK0_STACK; carry kept)"},
        "16184": {"comment":"Mode 0?"},
        "16186": {"comment":"A = the byte at the place"},
        "16187": {"comment":"DE = the place"},
        "16188": {"comment":"A hidden number?"},
        "16192": {"comment":"DE past its five bytes"},
        "16199": {"synopsis":"Mode 0: room for one byte at HL, then A stored there.","comment":"The character kept"},
        "16200": {"comment":"One byte"},
        "16203": {"comment":"HL and DE kept"},
        "16205": {"comment":"Room for it? (ROOM_TEST_BC; report 4 if not)"},
        "16208": {"comment":"DE and HL back"},
        "16210": {"comment":"Pointers moved (ROM 1's MOVE_POINTERS)"},
        "16213": {"comment":"The bytes up to STKEND moved up"},
        "16216": {"comment":"DE = the new STKEND, HL = the old"},
        "16219": {"comment":"A = the character"},
        "16220": {"comment":"Stored at the place"},
        "16221": {"synopsis":"$FD82 = the next place; bank 7.","comment":"DE = the next place"},
        "16222": {"comment":"Bank 7 and its stack (BANK7_STACK)"},
        "16225": {"comment":"$FD82 = it"},
        "16230": {"synopsis":"Whether BC bytes fit between STKEND and the stack, with $82 bytes to spare; returns with\ncarry when they do. Otherwise ERR_NR = 3 and on to AFTER_RUN (report 4, \"Out of memory\").","comment":"HL = STKEND + BC"},
        "16234": {"comment":"Past $FFFF?"},
        "16236": {"comment":"DE = it"},
        "16237": {"comment":"Plus $82 to spare"},
        "16241": {"comment":"Past $FFFF?"},
        "16243": {"comment":"Below SP?"},
        "16245": {"comment":"Yes: carry, they fit"},
        "16246": {"synopsis":"No room: ERR_NR = 3 (report 4), to AFTER_RUN.","comment":"ERR_NR = 3: report 4"},
        "16251": {"comment":"To AFTER_RUN"},
        "16254": {"synopsis":"Looks the word in the buffer at $FD74 up as a keyword, letters in either case: first among\nROM 1's keywords (the RAM routine at $FD2E, a copy of $33F4: the list at $0096, codes from\n$A5), then in the list at $3594 (the RAM routine at $FD3B with B = $F9): SPECTRUM, PLAY,\nGOTO, GOSUB, DEFFN, OPEN#, CLOSE# (the spellings as stored there), which give $A3, $A4, $EC\n(GO TO), $ED (GO SUB), $CE (DEF FN), $D3 (OPEN #), $D4 (CLOSE #).\nExit: carry and A = the token when found; no carry otherwise.","comment":"ROM 1's keywords (the RAM routine at $FD2E)"},
        "16257": {"comment":"Found: carry, A = the token"},
        "16258": {"comment":"The 128K's own list, codes from $F9"},
        "16260": {"comment":"DE = the word"},
        "16263": {"comment":"HL = the 128K's list"},
        "16266": {"comment":"Looked up (the RAM routine at $FD3B)"},
        "16269": {"comment":"Not found: no carry"},
        "16270": {"comment":"$FF: CLOSE # ($D4)?"},
        "16274": {"comment":"The CLOSE # token"},
        "16278": {"synopsis":"$FE: OPEN # ($D3)?"},
        "16282": {"comment":"The OPEN # token"},
        "16286": {"synopsis":"$FD: DEF FN ($CE)?"},
        "16290": {"comment":"The DEF FN token"},
        "16294": {"synopsis":"$FC: GO SUB ($ED)?"},
        "16298": {"comment":"The GO SUB token"},
        "16302": {"synopsis":"$FB: GO TO ($EC)?"},
        "16306": {"comment":"The GO TO token"},
        "16310": {"synopsis":"$F9 or $FA: less $56 (SPECTRUM $A3, PLAY $A4).","comment":"$A3 SPECTRUM or $A4 PLAY"},
        "16312": {"synopsis":"Carry: found."},
        "16314": {"synopsis":"Copies the bytes at HL, a count first, to DE.\nExit: HL and DE past them; B = 0.","comment":"B = the count"},
        "16316": {"synopsis":"One byte.","comment":"Copied"},
        "16318": {"comment":"Both on"},
        "16320": {"comment":"All?"},
        "16323": {"synopsis":"Carry and A = its value when A is a digit '0'-'9'; no carry otherwise. Nothing in this ROM\ncalls it.","comment":"Below '0'?"},
        "16327": {"comment":"Past '9'?"},
        "16330": {"comment":"A = its value"},
        "16332": {"comment":"Carry: a digit"},
        "16334": {"synopsis":"Looks key A up in the table at HL (a count, then code and address per key) and runs the\nroutine found. Exit: no carry and NZ when not found; Z when found, carry as the routine\nreturned it.","comment":"BC and DE kept"},
        "16336": {"comment":"B = the count"},
        "16338": {"comment":"This key?","synopsis":"The next entry: its code compared with A."},
        "16339": {"comment":"DE = the entry's address"},
        "16345": {"comment":"Past it"},
        "16346": {"comment":"The next"},
        "16348": {"comment":"Not found: no carry"},
        "16350": {"comment":"DE and BC back"},
        "16353": {"synopsis":"Found: the routine run (TABLE_CALL), Z, its carry kept.","comment":"HL = the routine"},
        "16354": {"comment":"DE and BC back"},
        "16356": {"comment":"Run (TABLE_CALL)"},
        "16359": {"comment":"It returned carry?"},
        "16361": {"comment":"Z and no carry"},
        "16363": {"synopsis":"The routine returned carry: Z and carry.","comment":"Z"},
        "16364": {"comment":"And carry"},
        "16366": {"synopsis":"Jumps to HL."},
        "16367": {"synopsis":"Bytes nothing in this ROM's code reads: 'MB', 'SB', 'AC', 'RG' and 'KM', each after a 0,\nthen $01."}
      }
    }
  },
