        "7962": {"comment":"HL = the destination"},
        "7963": {"comment":"RAMDISK_READ"},
        "7966": {"comment":"On as BANK7_PUT"},
        "7968": {"synopsis":"Back to RAM bank 0 (paging byte 0: ROM 0, normal screen) and to the stack kept in $5B81,\nwhich in turn keeps this one: the pair of BANK7_STACK. The return address goes with the\ncaller; AF and HL kept.","comment":"AF kept"},
        "7972": {"comment":"Paging byte 0"},
        "7975": {"comment":"The return address"},
        "7979": {"comment":"The stacks swapped"},
        "7988": {"comment":"HL back"},
        "7991": {"comment":"The return address back"},
        "7992": {"comment":"AF back"},
        "7994": {"synopsis":"Writes A to port $7FFD and to the paging byte at $5B5C. Keeps BC."},
        "7995": {"comment":"To port $7FFD"},
        "8000": {"comment":"And the paging byte"},
        "8005": {"synopsis":"Swaps the stack with the one kept in $5B81, then pages RAM bank 7 in at $C000 (paging byte\n7): where the editor's own data lives ($EC00 up). The return address goes with the caller;\nAF and HL kept.","comment":"AF kept"},
        "8007": {"comment":"The return address"},
        "8011": {"comment":"The stacks swapped"},
        "8019": {"comment":"HL back"},
        "8022": {"comment":"The return address back"},
        "8023": {"comment":"Bank 7"},
        "8029": {"comment":"AF back"},
        "8031": {"synopsis":"ERASE ! (ERASE_CMD): removes the file named by $5B67 (report h when there is none):\n1. Its length given back to the free bytes (RAMDISK_FREE_ADD).\n2. The data of every later file moved down over it, byte by byte, each side in its own bank\n   (the alternate registers for the destination), with the count in the erased entry's\n   current place.\n3. 20 bytes given back for the entry; every later entry's start and current place lowered by\n   the length (ERASE_FIX_LOOP); the entries below it moved up by 20 and $5B83 up 20.\nObserved: erase !\"aa\" gave back the 79 bytes it had taken, and cat ! then listed only bb.","comment":"RAMDISK_FIND"},
        "8034": {"comment":"Found?"},
        "8036": {"comment":"Report h"},
        "8040": {"synopsis":"Its length back to the free bytes; the bytes to move: from the next file's start to the free\nentry's.","comment":"A:HL = its length"},
        "8049": {"comment":"Back to the free bytes"},
        "8052": {"comment":"IY kept"},
        "8054": {"comment":"IY = the free entry"},
        "8058": {"comment":"IX = the next entry"},
        "8063": {"comment":"A:HL = the free entry's start: the data's end"},
        "8072": {"comment":"IY back"},
        "8074": {"comment":"B:DE = the next file's start"},
        "8083": {"comment":"The bytes to move"},
        "8087": {"comment":"Banks to 16K units"},
        "8099": {"comment":"IX = the erased entry"},
        "8104": {"comment":"The count"},
        "8113": {"comment":"IX = the next entry"},
        "8118": {"comment":"Source: the next file's start"},
        "8127": {"comment":"IX = the erased entry"},
        "8132": {"comment":"Its bank in"},
        "8136": {"comment":"E = its paging byte"},
        "8140": {"comment":"BC = $7FFD"},
        "8143": {"comment":"Bank 7 back for the entries"},
        "8148": {"comment":"The other register set"},
        "8149": {"comment":"Destination: the erased file's start"},
        "8158": {"comment":"Its bank in"},
        "8162": {"comment":"E = its paging byte"},
        "8166": {"comment":"BC = $7FFD"},
        "8169": {"comment":"Back to the first set"},
        "8170": {"synopsis":"The count less one; at its end ERASE_FIX.","comment":"Bank 7: the count"},
        "8175": {"comment":"The count less one: its low byte"},
        "8183": {"comment":"No borrow: a byte to move"},
        "8185": {"comment":"Then the middle byte"},
        "8195": {"comment":"Then the high byte"},
        "8203": {"comment":"Past 0: all moved"},
        "8205": {"synopsis":"A byte from the source bank; at $FFFF the next bank.","comment":"The source's bank"},
        "8207": {"comment":"A = the byte"},
        "8208": {"comment":"Past $FFFF?"},
        "8214": {"comment":"A kept"},
