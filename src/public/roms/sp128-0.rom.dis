        "12101": {"comment":"B = the start of the row's text"},
        "12106": {"synopsis":"$F6F4 bit 0 set on the cursor's row (Z on entry), cleared for a later row.","comment":"HL kept"},
        "12107": {"comment":"$F6F4 bit 0 set (the cursor's row)"},
        "12112": {"comment":"A later row: bit 0 cleared"},
        "12116": {"synopsis":"The row moved left, A in at column 31.","comment":"Moved left from B, A in at 31; A = the one moved out"},
        "12119": {"comment":"The character taken out kept"},
        "12125": {"comment":"The cursor's row?"},
        "12129": {"comment":"From column 0"},
        "12131": {"comment":"Text left on the row?"},
        "12136": {"comment":"None: the row removed"},
        "12139": {"comment":"DE and BC back"},
