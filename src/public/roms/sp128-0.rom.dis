        "7879": {"comment":"HL = $C000"},
        "7882": {"comment":"That bank in"},
        "7887": {"synopsis":"Vector $0106: copies BC bytes from HL to DE in RAM bank 7 (RAMDISK_WRITE with a made-up\nentry at $5B6A whose current place is DE in bank 7), keeping the paging; HL and DE move past\nthem, BC = 0. Keeps AF.","comment":"AF kept"},
        "7888": {"comment":"The paging byte kept"},
        "7892": {"comment":"HL, DE and BC kept"},
        "7895": {"comment":"IX = the made-up entry"},
        "7899": {"comment":"Its current place = DE"},
        "7905": {"comment":"In bank 7 (index 4)"},
        "7909": {"comment":"RAMDISK_WRITE"},
        "7912": {"synopsis":"Bank 0; HL and DE moved on; the paging byte back; BC = 0.","comment":"Bank 0"},
        "7917": {"comment":"BC, DE and HL as given"},
        "7920": {"comment":"HL past the bytes"},
        "7921": {"comment":"DE past them"},
        "7924": {"comment":"A = the paging byte as it was"},
        "7925": {"comment":"Back to it"},
        "7935": {"comment":"BC = 0"},
        "7938": {"comment":"AF back"},
        "7940": {"synopsis":"Vector $0109: copies BC bytes from HL in RAM bank 7 to DE (RAMDISK_READ), as BANK7_PUT does\nthe other way.","comment":"AF kept"},
        "7941": {"comment":"The paging byte kept"},
        "7945": {"comment":"HL, DE and BC kept"},
        "7948": {"comment":"IX = the made-up entry"},
        "7952": {"comment":"Its current place = HL"},
