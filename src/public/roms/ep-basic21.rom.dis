        "1539": {"synopsis":"Ends a name: length into ($0203), ($0214) past it; error 20042 from 32 characters.","comment":"Length"},
        "1542": {"comment":"Past the name"},
        "1546": {"comment":"Shorter than 32?"},
        "1549": {"comment":"Error 20042, identifier too long"},
        "1553": {"synopsis":"Not a name: a quote starts a string literal; anything else goes to SCAN_SYMBOL.","comment":"A quote?"},
