        "1469": {"synopsis":"A number: TEXT_TO_NUMBER puts it in the work item $0595; class $C0, ($0203) = 2 for the\ninteger form, 6 for a float.","comment":"Read it into $0595 (HL = value)"},
        "1472": {"comment":"Value, for a line number"},
