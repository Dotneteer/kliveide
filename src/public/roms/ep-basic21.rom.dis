        "2495": {"comment":"Drop the number"},
        "2498": {"comment":"Print the text"},
        "2506": {"comment":"It ends a word"},
        "2508": {"synopsis":"Prints symbol code A as its one or two characters from the table at $024A (two bytes per\ncode; a zero byte prints nothing).","comment":"Two bytes per code"},
        "2513": {"comment":"The symbol text table"},
        "2521": {"comment":"First character, if any"},
        "2526": {"comment":"Second character, if any"},
        "2532": {"synopsis":"Prints the word at HL (a line number) with PRINT_DECIMAL: padded with spaces when carry,\nwithout\nleading zeros otherwise.\nExit: HL, BC kept, DE = 2."},
