        "2440": {"comment":"Print the character"},
        "2443": {"comment":"Next one"},
        "2446": {"comment":"Each character"},
        "2448": {"comment":"Closing quote"},
        "2451": {"synopsis":"Prints a number token (a line number $A2, or a constant $C2/$C6): pushes its value, formats\nit\nwith NUM_TO_TEXT, drops it and prints the text; it ends a word."},
        "2452": {"comment":"Byte count"},
