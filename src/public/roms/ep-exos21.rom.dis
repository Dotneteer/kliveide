        "4147": {"comment":"E = old segment"},
        "4149": {"comment":"D = video segment"},
        "4150": {"comment":"Caller's page 0"},
        "4153": {"comment":"Page 0 back"},
        "4156": {"comment":"Walk the channel list"},
        "4159": {"synopsis":"Changes every channel-list link that names segment E to segment D."},
        "4160": {"comment":"Link's segment"},
