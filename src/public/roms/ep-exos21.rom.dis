        "3936": {"synopsis":"Pages the destination segment into page 1; on the new block's own pass goes to build it\n(ABUF_BUILD), otherwise copies the next piece."},
        "3937": {"comment":"Destination segment"},
        "3940": {"comment":"Page 1 = destination segment"},
        "3942": {"comment":"New block's own pass: build it"},
        "3948": {"comment":"Room left in the destination segment"},
