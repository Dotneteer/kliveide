        "2984": {"comment":"Pop it into R1"},
        "2988": {"synopsis":"While R1 is below -pi/2, adds pi to it and flips the sign flag."},
        "2989": {"comment":"Push R1 (x)"},
        "2990": {"comment":"Push a constant:"},
        "2991": {"comment":"Constant 7: pi/2"},
        "2992": {"comment":"Negate: -pi/2"},
        "2993": {"comment":"Compare x with -pi/2"},
        "2995": {"comment":"Not below -pi/2: in range"},
        "2999": {"comment":"Flip the sign flag"},
