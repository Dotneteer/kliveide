        "2442": {"comment":"y = 0: error 3006"},
        "2445": {"synopsis":"x MOD y of the top two numbers (call byte $AB; y on top): r = x - y * INT(x/y); an r that\ndoes not compare below y (M) is replaced by 0, which catches r = y from rounding but also\nzeroes every result for a negative y (run: MOD(5,-3) and MOD(-7,-3) print 0, MOD(-5,3)\nprints 1)."},
        "2449": {"comment":"x, y, x, y, y"},
        "2450": {"comment":"R1 = y"},
        "2451": {"comment":"x, y, x/y"},
        "2452": {"comment":"INT(x/y)"},
        "2453": {"comment":"x, y * INT(x/y)"},
        "2454": {"comment":"r = x - y * INT(x/y)"},
        "2455": {"comment":"r, r"},
        "2456": {"comment":"y"},
        "2457": {"comment":"Compare r with y"},
        "2459": {"comment":"r below y: keep it"},
        "2461": {"comment":"r becomes 0"},
