        "7544": {"comment":"Round to L significant digits"},
        "7548": {"comment":"Rounded to zero?"},
        "7549": {"comment":"Is the top number zero?"},
        "7553": {"comment":"Make it a float zero"},
        "7554": {"comment":"Make the top a float zero"},
        "7556": {"synopsis":"Makes the number positive and keeps its sign in C bit 0."},
        "7557": {"comment":"Is the top number negative?"},
        "7562": {"comment":"Negate the top number"},
        "7563": {"comment":"Negate the top number"},
        "7565": {"comment":"Negative: C bit 0"},
        "7569": {"synopsis":"The number is zero: rewritten as a float zero (unless carry is set)."},
        "7571": {"comment":"Make it a float zero"},
        "7572": {"comment":"Make the top a float zero"},
        "7574": {"synopsis":"Restores C after the zero case."},
        "7575": {"synopsis":"B = the number's integer digits (exponent - $3F; zero or negative for a number below 1).\nWith no exponent field, L = the integer digits to place (0 when below 1). Then scans the\nformat backwards from the point."},
        "7576": {"comment":"A = the top number's exponent byte"},
        "7577": {"comment":"A = the top number's exponent byte"},
        "7579": {"comment":"B = integer digits of the number"},
        "7583": {"comment":"DE' scans back from the point"},
        "7586": {"comment":"H = spare positions, L = digits to place"},
        "7589": {"comment":"Exponent form?"},
        "7593": {"comment":"Below 1: no integer digits"},
        "7599": {"synopsis":"Loop over the integer part of the format, from the point back to the item's start: each\ndigit position takes one of the L digits; once they are placed, every position (and every\ncomma) left is a spare one (H). In exponent form every digit position is counted in H.","comment":"One character back"},
        "7601": {"comment":"Still in the item?"},
        "7605": {"comment":"Its format character"},
        "7609": {"comment":"Before the item's start: done"},
        "7611": {"synopsis":"Carry = a digit position (anything but a comma).","comment":"A comma is not a digit position"},
        "7616": {"synopsis":"Counts the position: a spare one when the digits are all placed, else it takes a digit\n(commas between digits are skipped).","comment":"Exponent form?"},
        "7620": {"comment":"Digits all placed?"},
        "7627": {"comment":"Comma inside the number: skip it"},
        "7629": {"comment":"One digit placed here"},
        "7631": {"synopsis":"Exponent form: a digit position counts in H, a comma is skipped."},
        "7633": {"synopsis":"One more spare integer position.","comment":"One more spare position"},
        "7636": {"synopsis":"The $ and the sign each use one spare position.","comment":"Print a $?"},
        "7640": {"comment":"It takes a position"},
        "7641": {"synopsis":"A negative number, or a + or - in the format, needs a position for its sign.","comment":"Negative?"},
        "7645": {"comment":"Or a + or - in the format?"},
        "7650": {"synopsis":"The sign takes a position.","comment":"The sign takes a position"},
        "7651": {"synopsis":"Error 8203 when the sign or $ found no room, or digits are left over.","comment":"No room for the sign or $?"},
        "7655": {"comment":"All digits placed?"},
        "7660": {"synopsis":"Raises error 8203 (USING format item too short).","comment":"Error 8203: USING format item too short"},
        "7663": {"synopsis":"Fixed form: L = the integer digits to print; a number below 1 with a spare position gets one\n0 before the point.","comment":"Exponent form?"},
        "7668": {"comment":"Below 1: no integer digits"},
        "7673": {"synopsis":"L = the integer digits to print."},
        "7674": {"comment":"Any integer digit?"},
        "7677": {"comment":"A spare position left?"},
        "7681": {"comment":"Use it for a 0 before the point"},
        "7686": {"synopsis":"Exponent form: every integer position gets a digit (L = H), and the exponent drops by as\nmany.","comment":"All integer positions get digits"},
        "7688": {"comment":"The exponent to print"},
        "7690": {"synopsis":"With no * or % the fill is a space (fixed form). A fill of * or 0, or exponent form, prints\nthe sign and $ before the fill.","comment":"Exponent form?"},
        "7694": {"comment":"A * or 0 fill?"},
        "7698": {"comment":"No: fill with spaces"},
