        "7048": {"comment":"Symbol $08: \"(\""},
        "7050": {"comment":"\"(\" and the column"},
        "7051": {"comment":"Cart TOKEN_EXPECT: error 20000 unless symbol A"},
        "7052": {"comment":"Cart EVAL_NUMERIC: push the expression's value"},
        "7054": {"comment":"Symbol $09: \")\""},
        "7056": {"comment":"\")\" and the column as a number"},
        "7057": {"comment":"Cart TOKEN_EXPECT: error 20000 unless symbol A"},
