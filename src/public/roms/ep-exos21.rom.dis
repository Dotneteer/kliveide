        "7810": {"comment":"Commas are printed as they are"},
        "7814": {"comment":"A fraction digit?"},
        "7819": {"comment":"Past the number's digits?"},
        "7826": {"comment":"A = the top number's digit B"},
        "7827": {"comment":"A = digit B of the top number"},
