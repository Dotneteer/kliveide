        "2959": {"comment":"Error 1000: Unexpected value given"},
        "2962": {"comment":"Sign flag 0: no flip yet"},
        "2964": {"synopsis":"While R1 is above pi/2, subtracts pi from it and flips the sign flag."},
        "2965": {"comment":"Push R1 (x)"},
        "2966": {"comment":"Push a constant:"},
        "2967": {"comment":"Constant 7: pi/2"},
        "2968": {"comment":"Compare x with pi/2"},
        "2970": {"comment":"Not above pi/2: next check"},
        "2976": {"comment":"Flip the sign flag"},
        "2980": {"comment":"Push R1 (x)"},
        "2981": {"comment":"Push a constant:"},
        "2982": {"comment":"Constant 4: pi"},
