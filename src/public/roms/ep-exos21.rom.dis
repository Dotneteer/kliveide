        "4199": {"comment":"plus its gap"},
        "4205": {"comment":"Space freed"},
        "4206": {"comment":"DE = space freed"},
        "4207": {"comment":"HL = the channel pointer"},
        "4210": {"synopsis":"Per node below the freed block: follows the link to it, moves the gap of the node above into\nthe space to be closed and clears that gap."},
        "4211": {"comment":"Follow its link to the next node"},
        "4214": {"comment":"Keep the next node"},
        "4215": {"comment":"Keep its flags: Z = end of the list"},
        "4216": {"comment":"Segment of the node above"},
        "4218": {"comment":"To pointer-7"},
