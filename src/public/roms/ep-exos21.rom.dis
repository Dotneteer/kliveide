        "2520": {"comment":"Push L"},
        "2523": {"synopsis":"Pops the top number as a 16-bit address: x + 32768 is popped as an integer and 32768 added\nback, so -32768 to 65535 are accepted.\nExit: HL = the address.\nChanges: DE.","comment":"32768: an integer of -32768"},
