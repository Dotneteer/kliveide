        "7529": {"comment":"A = the top number's exponent byte"},
        "7531": {"comment":"Integer digits of the number"},
        "7535": {"comment":"Plus the fraction digits"},
        "7537": {"synopsis":"Rounds the number to L significant digits (FP_ROUND_DIGITS) unless it is zero; a result of\nzero becomes a float zero, so its digits can be read."},
        "7539": {"comment":"Is the top number zero?"},
