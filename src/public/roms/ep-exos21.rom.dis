        "4294": {"synopsis":"Scans EXOS's segment list for the node's segment."},
        "4298": {"comment":"C = source segment"},
        "4306": {"synopsis":"Not run in the profile: one more 16K step before the loop."},
        "4310": {"synopsis":"Steps one place in the segment list for each 16K of the distance.","comment":"Step one list place per 16K"},
        "4315": {"comment":"Destination high byte, back in page 1"},
        "4319": {"comment":"B = destination segment"},
        "4320": {"comment":"Relink the node above: segment"},
        "4323": {"comment":"address low"},
        "4326": {"comment":"address high"},
        "4329": {"comment":"IX = the node, in page 0"},
        "4336": {"comment":"Not run in the profile: leave early"},
        "4339": {"synopsis":"Copies the node's block up with LDDR, the source segment in page 0 and the destination in\npage 1, in pieces that stop at segment boundaries; then calls the node's device with entry\n13 (buffer moved)."},
        "4341": {"comment":"No interrupts while page 0 changes"},
