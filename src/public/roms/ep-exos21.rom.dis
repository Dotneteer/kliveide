        "7750": {"comment":"All passed: print from here"},
        "7752": {"comment":"A comma does not count"},
        "7759": {"synopsis":"Prints the integer part: from the first digit's position up to the point, a comma is printed\nas it is and each other position prints the number's next digit (0 once its 10 digits are\nused)."},
        "7760": {"comment":"Digit index 4 = the leading digit"},
        "7762": {"comment":"IY = the top number"},
