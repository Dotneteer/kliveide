        "3107": {"comment":"12 bytes per dimension"},
        "3110": {"synopsis":"Steps HL 12 bytes on per dimension: once for d = 1, twice for d = 2."},
        "3114": {"synopsis":"Pushes the 6-byte number at HL + 1 (the element count, or the dimension's size) after the\nclosing \")\".","comment":"Past the dimension count"},
        "3116": {"comment":"Expect )"},
        "3117": {"comment":"Push the 6-byte number at HL"},
