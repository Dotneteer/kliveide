        "7703": {"comment":"Any spare positions?"},
        "7704": {"synopsis":"Loop: prints the fill character in each spare position (fixed form only).","comment":"One spare position less"},
        "7707": {"comment":"Exponent form: no fill"},
        "7711": {"comment":"Print the fill character"},
        "7713": {"comment":"Print A (the fill)"},
        "7717": {"synopsis":"Prints the sign and $ after a space fill, then finds the format position of the first\ninteger digit.","comment":"Space fill: the sign follows the spaces"},
        "7723": {"comment":"DE' = the position before the point"},
        "7728": {"comment":"Number below 1, or exactly 1 digit?"},
        "7736": {"synopsis":"A single integer digit is printed from the position before the point.","comment":"One integer digit?"},
        "7740": {"synopsis":"Loop: walks the format back from the point over L digit positions (commas not counted) to\nwhere the first integer digit goes.","comment":"Digits left to pass?"},
        "7741": {"synopsis":"Counts one digit position passed.","comment":"One digit position passed"},
        "7743": {"comment":"First pass: stay on this position"},
        "7745": {"comment":"One character further back"},
