        "6969": {"comment":"The flags"},
        "6970": {"comment":"USING?"},
        "6974": {"synopsis":"PRINT_EXEC's item loop without USING; the carry kept with the flags says the last item was a\nseparator (no new line at the end).","comment":"Keep the flags and the carry"},
        "6975": {"synopsis":"PRINT_EXEC: one item: the statement's end, a string, \",\", \";\", TAB(n) or a number.","comment":"Symbol $10?"},
        "6982": {"comment":"The line's end?"},
        "6986": {"comment":"A string literal?"},
