        "4164": {"comment":"Name the video segment instead"},
        "4165": {"synopsis":"Follows the link to the next node."},
        "4166": {"comment":"Follow the link"},
        "4169": {"comment":"Until the end of the list"},
        "4171": {"comment":"Look again"},
        "4173": {"synopsis":"Sets $BF8A to the first segment from $FC up that sits at its own place among the top four\nentries of EXOS's segment list ($ABCD-$ABD0, where $ABD0 always holds $FF): the lowest\nsegment of the run of video segments at the top.","comment":"Entry before $ABCD"},
        "4176": {"comment":"Start below $FC"},
        "4178": {"synopsis":"Tries the next segment number against its place in the list.","comment":"Next segment number"},
        "4180": {"comment":"At its own place?"},
        "4183": {"comment":"Lowest video segment of the top run"},
        "4187": {"synopsis":"Close or destroy (from the channel calls, $0BD7, after the device's close entry ran through\nDEV_CALL_CHAN: IY = the channel's pointer, IX/B = the link above it): removes the channel's\nblock\nfrom the channel list and closes the hole. Each node below is moved up by the space freed\n(the block's size plus its gap), relinked and its device called with entry 13 (buffer\nmoved); a moved video channel also raises $BF8D. At the end of the list the EXOS boundary\n($BF91) rises by the space freed and each whole segment it passes goes back to the free list\n(RELEASE_SYS_SEG). Clears the channel cache ($BFA5) and returns the device's status.","comment":"Drop the stacked HL"},
        "4188": {"comment":"A = the device's status"},
        "4189": {"comment":"Keep it"},
        "4190": {"comment":"Segment of the channel's RAM"},
        "4191": {"comment":"Page it into page 1"},
