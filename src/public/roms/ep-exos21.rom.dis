        "3032": {"comment":"Push a constant:"},
        "3033": {"comment":"Constant $0F"},
        "3034": {"comment":"Add"},
        "3035": {"comment":"Push R1 (x^2)"},
        "3036": {"comment":"Multiply"},
        "3037": {"comment":"Push a constant:"},
        "3038": {"comment":"Constant $0E"},
        "3039": {"comment":"Add: P(x^2)"},
        "3040": {"comment":"Push R1 (x^2)"},
