        "1068": {"synopsis":"BIN(x): reads the integer digits of x as binary digits and returns their value (BIN(101) =\n5). Error 1000 when a digit is not 0 or 1, or the exponent byte is not $3C-$4B.","comment":"ARG_NUM_PAREN: x"},
        "1072": {"comment":"Z when x is zero"},
        "1074": {"comment":"BIN(0) = 0"},
        "1076": {"comment":"Convert x to float form"},
        "1077": {"comment":"A = the exponent byte"},
        "1079": {"comment":"The value"},
        "1082": {"comment":"C = the last integer digit's position"},
        "1086": {"comment":"Error 1000: too many digits"},
        "1090": {"comment":"From mantissa position 4, the leading digit"},
        "1092": {"synopsis":"Shifts each integer digit into HL as a bit."},
        "1094": {"comment":"A = digit B of the mantissa"},
        "1096": {"comment":"Not 0 or 1?"},
        "1098": {"comment":"Error 1000"},
