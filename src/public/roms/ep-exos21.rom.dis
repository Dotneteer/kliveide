        "7011": {"synopsis":"PRINT_EXEC: \",\" prints a TAB character; \",\" and \";\" are skipped and leave the carry (no new\nline).","comment":"\",\"?"},
        "7018": {"comment":"TAB character"},
        "7020": {"comment":"Print it"},
        "7021": {"comment":"Cart PRINT_CHAR: write A to channel ($0209)"},
        "7023": {"comment":"Entry $1B70: CP $11 / JR NZ,PRINT_ITEM_TAB, is it \";\"?"},
        "7025": {"comment":"Hides the \";\" test for \",\""},
        "7028": {"comment":"Past the separator"},
        "7029": {"comment":"Cart TOKEN_NEXT: read the next token"},
        "7032": {"comment":"Carry: ended with a separator"},
        "7035": {"synopsis":"PRINT_EXEC: TAB(n) moves the cursor to column n with ESC \"=\" (row unchanged); any other item\nis a number.","comment":"Text TAB"},
        "7038": {"comment":"Is the name TAB?"},
        "7041": {"comment":"Compute (flags kept)"},
        "7043": {"comment":"No: a number"},
        "7045": {"comment":"Past TAB"},
