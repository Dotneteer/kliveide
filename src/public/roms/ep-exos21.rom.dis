        "3916": {"synopsis":"Copies the block in pieces that end at a segment boundary on either side, paging the next\nsource segment into page 0 or the next destination segment into page 1 as each is crossed.","comment":"Source past its segment?"},
        "3920": {"comment":"Back to the segment's start"},
        "3922": {"comment":"Next source segment"},
