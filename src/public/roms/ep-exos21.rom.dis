        "1039": {"comment":"Constant 7: pi/2"},
        "1045": {"comment":"Constant 8: pi/3"},
        "1049": {"comment":"B = 0: nothing to add"},
        "1051": {"synopsis":"Adds the 7-byte constant at HL."},
        "1052": {"comment":"FP_PUSH_HL: the constant"},
        "1053": {"comment":"Add"},
