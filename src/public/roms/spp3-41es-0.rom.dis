        "8187": {"comment":"The '<' written (TOK_PUT)"},
        "8190": {"comment":"Then the character"},
        "8191": {"comment":"Then the character"},
        "8193": {"synopsis":"'>' held: then '='?","comment":"A = the character"},
        "8194": {"comment":"A '=' after it?"},
        "8196": {"comment":"No: '>' first"},
        "8198": {"comment":"The >= token, $C8"},
        "8200": {"comment":"Written"},
        "8202": {"synopsis":"'>' then something else: '>' written first.","comment":"The character kept"},
        "8203": {"comment":"The '>' written (TOK_PUT)"},
        "8205": {"comment":"The '>' written (TOK_PUT)"},
        "8208": {"comment":"Then the character"},
        "8209": {"comment":"Then the character"},
        "8211": {"synopsis":"Writes A (TOK_SPACING), keeping the state: REM ($EA) makes it 4; '\"' toggles state 2 (bit 1,\nbit 0 cleared). ENTER ends the line: TOK_PUT_ENTER.","comment":"ENTER? Not written: the edit line has one"},
        "8213": {"comment":"Yes: TOK_PUT_ENTER"},
        "8215": {"comment":"REM?"},
        "8217": {"comment":"B = the character"},
        "8218": {"comment":"No: a quote?"},
        "8220": {"comment":"State 4: after REM"},
        "8225": {"comment":"Written"},
        "8227": {"synopsis":"A quote?","comment":"A '\"'?"},
        "8229": {"comment":"No: written as it is"},
        "8231": {"comment":"The state's bit 0 off, bit 1 toggled"},
        "8241": {"synopsis":"Written; carry.","comment":"A = the character"},
