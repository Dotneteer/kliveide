        "8287": {"comment":"Held: bit 1 set, nothing written"},
        "8294": {"synopsis":"A space held already: this one written.","comment":"This one written (TOK_WRITE)"},
        "8298": {"comment":"A = the flags"},
        "8301": {"comment":"Done"},
        "8302": {"synopsis":"After a keyword: dropped.","comment":"Bit 0 off: the space dropped"},
        "8309": {"synopsis":"Not a space: a keyword ($A3 up)?","comment":"A keyword?"},
        "8311": {"comment":"Yes: TOK_SPACING_KEY"},
        "8313": {"comment":"A space held?"},
        "8316": {"comment":"Yes: TOK_SPACE_FIRST"},
        "8318": {"comment":"No: bit 0 off"},
        "8324": {"comment":"The character written (TOK_WRITE)"},
        "8329": {"synopsis":"The held space written first, then the character; both flags cleared.","comment":"The character kept"},
        "8330": {"comment":"The held space written (TOK_WRITE)"},
        "8335": {"comment":"DE back"},
        "8336": {"comment":"Both bits off"},
        "8344": {"comment":"Then the character"},
        "8349": {"synopsis":"A keyword: a held space dropped, bit 0 set; written.","comment":"Bit 1 off (the held space dropped), bit 0 on"},
        "8357": {"comment":"The token written (TOK_WRITE)"},
        "8362": {"synopsis":"Writes A at the place in $FDAE and moves it on ($FDB3 counted). Mode 0: one byte of room\nopened there (ROOM_TEST_BC, ROM 3's MOVE_POINTERS, the bytes above moved up) and A stored.\nMode 1: nothing written, the place moved past the byte there (and past a hidden number after\n$0E); when the place is X_PTR, BC = the smaller of $FDB1 and $FDB3, SP = $FDB7 and a return\nfrom TOKENIZE with carry.","comment":"One more written ($FDB3)"},
        "8369": {"comment":"HL = the place"},
