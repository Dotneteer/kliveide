        "8426": {"comment":"DE = the place"},
        "8427": {"comment":"A hidden number?"},
        "8429": {"comment":"No: past the byte"},
        "8431": {"comment":"DE past its five bytes"},
        "8436": {"comment":"Then past the byte"},
        "8438": {"synopsis":"Mode 0: room for one byte at HL, then A stored there.","comment":"The character kept"},
        "8439": {"comment":"One byte"},
        "8442": {"comment":"HL and DE kept"},
        "8444": {"comment":"Room for it? (ROOM_TEST_BC; report 4 if not)"},
        "8447": {"comment":"DE and HL back"},
        "8449": {"comment":"Pointers moved (ROM 3's MOVE_POINTERS)"},
