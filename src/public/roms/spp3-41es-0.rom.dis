        "8245": {"comment":"Carry"},
        "8246": {"comment":"Carry: on"},
        "8247": {"synopsis":"ENTER: in mode 0 no carry (the line done); in mode 1 BC = $FDB1, SP = $FDB7 and a return\nfrom TOKENIZE with carry.","comment":"Mode 0?"},
        "8252": {"comment":"Yes: no carry"},
        "8254": {"comment":"BC = the characters read"},
        "8258": {"comment":"SP as TOKENIZE found it"},
