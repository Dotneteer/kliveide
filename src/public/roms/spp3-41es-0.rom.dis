        "7975": {"comment":"$FDA9 = the new end"},
        "7978": {"comment":"Looked up again"},
        "7980": {"synopsis":"A keyword: its token written (TOK_OUT); $FDAB = 0; the state 0 unless it is 4 (after REM);\nthe buffer emptied; the character that ended the word taken again at TOK_BETWEEN.","comment":"The character kept"},
        "7981": {"comment":"The token written (TOK_OUT)"},
        "7984": {"comment":"B, C = the character again"},
        "7985": {"comment":"$FDAB = 0: no space in the word"},
        "7991": {"comment":"After REM (state 4)?"},
        "7996": {"comment":"Yes: the state kept"},
        "7998": {"synopsis":"State 0."},
        "8003": {"synopsis":"The buffer empty.","comment":"$FDA9 = the start: the buffer empty"},
        "8009": {"comment":"The ending character taken again"},
        "8012": {"synopsis":"The next character of the line ($0E3E) in B, and its class in A: 6 a letter (bits 1 and 2),\n2 '#' or '$' (bit 1), 3 a space (bits 0 and 1), 1 anything else (bit 0). Bit 2: starts a\nword; bit 1: can be in one; bit 0: ends one.","comment":"A = the next character ($0E3E)"},
        "8015": {"comment":"B = it"},
        "8016": {"comment":"Below '?'"},
        "8018": {"comment":"Yes: TOK_CLASS_LOW"},
        "8020": {"comment":"Made lower case"},
        "8022": {"comment":"A letter? (LOWER_TEST)"},
        "8025": {"comment":"A letter: 6"},
        "8027": {"synopsis":"1: anything else."},
        "8029": {"comment":"1: anything else"},
        "8030": {"synopsis":"Below '?': a space, '#' or '$'?","comment":"A space?"},
        "8032": {"comment":"A space: 3"},
        "8034": {"comment":"A '#'?"},
        "8036": {"comment":"A '#': 2"},
        "8038": {"comment":"Below '#': anything else"},
        "8040": {"comment":"A '$'?"},
        "8042": {"comment":"Not a $: 1"},
        "8044": {"synopsis":"2: '#' or '$'."},
        "8047": {"synopsis":"3: a space."},
        "8050": {"synopsis":"6: a letter."},
        "8053": {"synopsis":"Carry when A is a lower-case letter ('a'-'z').","comment":"Past 'z'?"},
        "8055": {"comment":"Past 'z': no carry"},
        "8056": {"comment":"From 'a' on: carry"},
        "8060": {"synopsis":"Writes the word buffer as text (TOK_SPACING for each character, up to the one with bit 7\nset) and empties it: $FDA9 = $FDA0, $FDAB = 0.","comment":"The buffer's start"},
        "8063": {"comment":"$FDA9 = it: empty"},
        "8066": {"comment":"$FDAB = 0: no space in it"},
        "8073": {"synopsis":"One character.","comment":"A = the character, bit 7 off"},
        "8076": {"comment":"Its place kept"},
        "8077": {"comment":"Written (TOK_SPACING)"},
        "8081": {"comment":"The last one (bit 7)?"},
        "8084": {"comment":"The last: done"},
        "8085": {"comment":"The next"},
        "8086": {"comment":"The next"},
        "8088": {"synopsis":"Adds character B to the word buffer ($FDA0-$FDA8), the last character marked with bit 7.\nExit: carry; no carry when it is full (its end at $FDA9).","comment":"HL = the buffer's end"},
        "8091": {"comment":"Full (the end at $FDA9)?"},
        "8094": {"comment":"Full?"},
        "8096": {"comment":"No: room for it"},
        "8100": {"comment":"Yes: no carry"},
        "8103": {"synopsis":"Not the first: the last one's bit 7 cleared.","comment":"The first character?"},
        "8108": {"comment":"Not the first: link it"},
        "8112": {"comment":"The first: stored at once"},
        "8114": {"synopsis":"Bit 7 off the one before.","comment":"The one before"},
        "8116": {"comment":"Bit 7 off"},
        "8120": {"synopsis":"B stored with bit 7 set; $FDA9 moved on.","comment":"B with bit 7: now the last"},
        "8124": {"comment":"$FDA9 = the new end"},
        "8128": {"comment":"Carry: added"},
        "8129": {"comment":"Carry: added"},
        "8130": {"synopsis":"Full: no carry.","comment":"No carry: full"},
        "8133": {"synopsis":"Writes A, joining a '<' or '>' with the character after it: either is held in $FDB5; then <\n> gives <> ($C9), < = gives <= ($C7), > = gives >= ($C8); otherwise the held one is written\nfirst. The rest goes to TOK_PUT.\nExit: carry; no carry at the line's end in mode 0.","comment":"The character kept"},
        "8134": {"comment":"One held in $FDB5?"},
        "8138": {"comment":"One held: TOK_OUT_PAIR"},
        "8140": {"comment":"A = the character"},
        "8141": {"comment":"A '>'?"},
        "8143": {"comment":"Held"},
        "8145": {"comment":"A '<'?"},
        "8147": {"comment":"Held"},
        "8149": {"synopsis":"On to TOK_PUT.","comment":"Written (TOK_PUT)"},
        "8153": {"synopsis":"'<' or '>' held; carry.","comment":"Held"},
        "8156": {"comment":"Carry"},
        "8158": {"synopsis":"One is held: $FDB5 = 0; was it '<'?","comment":"The held one a '<'?"},
        "8160": {"comment":"Nothing held now"},
        "8165": {"comment":"A '>' was held: TOK_OUT_GT"},
        "8167": {"comment":"A = the character"},
        "8168": {"comment":"A '>' after it?"},
        "8170": {"comment":"No: TOK_OUT_LT_EQ"},
        "8172": {"comment":"The <> token, $C9"},
        "8174": {"comment":"Written"},
        "8176": {"synopsis":"'<' then '='?","comment":"A '=' after it?"},
        "8178": {"comment":"No: '<' first"},
        "8180": {"comment":"The <= token, $C7"},
        "8182": {"comment":"Written"},
        "8184": {"synopsis":"'<' then something else: '<' written first.","comment":"The character kept"},
