        "8391": {"comment":"No: TOK_FIND_ON"},
        "8393": {"comment":"BC = the characters read"},
        "8397": {"comment":"Fewer written than read?"},
        "8403": {"comment":"No: BC = the characters read"},
        "8405": {"comment":"Then BC = the characters written"},
        "8409": {"synopsis":"SP back: out of TOKENIZE, carry.","comment":"SP as TOKENIZE found it"},
        "8413": {"comment":"Carry, back to TOKENIZE's caller"},
        "8414": {"comment":"Back to TOKENIZE's caller"},
        "8415": {"synopsis":"Mode 1: carry.","comment":"Carry: mode 1"},
        "8418": {"synopsis":"Mode 0: no carry.","comment":"No carry: mode 0"},
        "8420": {"synopsis":"Bank 0 and the machine stack.","comment":"Bank 0 and the machine stack ($05AC; carry kept)"},
        "8423": {"comment":"Mode 0?"},
