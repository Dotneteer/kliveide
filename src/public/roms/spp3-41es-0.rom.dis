        "8263": {"comment":"Back to TOKENIZE's caller"},
        "8264": {"synopsis":"No carry.","comment":"No carry"},
        "8266": {"comment":"Back to the caller"},
        "8267": {"synopsis":"Writes A (TOK_WRITE), dropping the spaces around keywords, with the flags in $FDB0 (bit 0: a\nkeyword was the last written; bit 1: a space held back): a space after a keyword is dropped;\nof a run of spaces the last is held; a keyword ($A3 and up) drops a held space; any other\ncharacter writes the held one first.","comment":"E = the character"},
        "8268": {"comment":"D = the flags"},
