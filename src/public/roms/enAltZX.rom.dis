        "4246": {"comment":"HL = Layer 2's map offset ($5B82)"},
        "4249": {"synopsis":"HL = the map's start + y x the row length.","comment":"HL + row x width"},
        "4251": {"synopsis":"One row length on.","comment":"Add one row length"},
        "4253": {"synopsis":"BC rows counted?","comment":"BC rows done?"},
        "4257": {"comment":"Add the map x"},
        "4260": {"comment":"HL = the map's offset of the first tile"},
        "4261": {"comment":"In the bank at $C000"},
        "4265": {"comment":"IX = the first tile's map byte"},
        "4268": {"comment":"The transparent colour into A'"},
        "4271": {"comment":"Kept in A' for LDIX"},
        "4272": {"comment":"Screen place, size, counts"},
        "4273": {"comment":"BC = the screen's limits"},
        "4274": {"comment":"HL = the size in tiles"},
        "4275": {"synopsis":"One row of tiles: C = the screen step after each pixel row.","comment":"Keep them for the next row"},
        "4280": {"comment":"C = the step to the next pixel row"},
        "4282": {"comment":"C = the screen line length ($FF or $7F)"},
        "4283": {"comment":"Less the tile size"},
