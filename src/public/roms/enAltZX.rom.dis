        "7584": {"comment":"No"},
        "7586": {"comment":"DE = the length, the shortest now"},
        "7588": {"synopsis":"On.","comment":"The next string's bit; Z until past string 8"},
        "7591": {"comment":"More strings"},
        "7593": {"comment":"IY + 38 = the shortest length"},
        "7600": {"synopsis":"After the wait: each string's current length less the time waited; one at 0 ends its note\n(volume 0) and goes on to its next tied length or, with none left, its next note\n(PLAY_NEXT), which is started (PLAY_SOUND) and marked in a word on the stack; then a short\nwait, and the new notes' volumes (PLAY_ADV_VOLUMES).","comment":"BC = 0: no new notes yet"},
        "7604": {"comment":"The list from its start; string 0's bit"},
        "7607": {"synopsis":"The next string.","comment":"Has this string ended?"},
        "7610": {"comment":"Yes: the next"},
        "7613": {"comment":"IX = its block, its AY chip selected"},
        "7616": {"comment":"HL = IY + 18"},
        "7623": {"comment":"+ 2 x the string's number"},
        "7631": {"comment":"DE = the pointer to its length"},
        "7634": {"comment":"HL = it"},
        "7635": {"comment":"Kept"},
        "7636": {"comment":"HL = the length"},
        "7640": {"comment":"DE = the time waited"},
        "7646": {"comment":"The length less it"},
        "7649": {"comment":"DE = what is left"},
        "7650": {"comment":"HL = the pointer"},
        "7651": {"comment":"Over: the note ends"},
        "7653": {"comment":"The rest stored"},
        "7656": {"comment":"The next string"},
        "7658": {"synopsis":"Its length is over: volume 0.","comment":"A = the AY channel"},
        "7661": {"comment":"Always below 3"},
        "7665": {"comment":"Register 8 + the channel"},
        "7668": {"comment":"= 0: the note silent"},
        "7673": {"synopsis":"Another tied length?","comment":"HL = IX + 33, the lengths left"},
        "7680": {"comment":"One less"},
        "7681": {"comment":"Another tied length"},
        "7683": {"comment":"None: the string's next note"},
        "7686": {"comment":"Has it ended?"},
        "7689": {"comment":"Yes: the next string"},
        "7691": {"comment":"Sound the note"},
        "7693": {"synopsis":"The next length in its list.","comment":"HL = IY + 18"},
        "7700": {"comment":"+ 2 x the string's number"},
        "7708": {"comment":"DE = the pointer to its length"},
        "7711": {"comment":"The next length"},
        "7713": {"comment":"Stored"},
        "7716": {"synopsis":"A note: read and sounded, its string's bit added to the word on the stack.","comment":"A = the note's name"},
        "7719": {"comment":"C = the note"},
        "7720": {"comment":"Has the string ended?"},
        "7723": {"comment":"Yes: the next string"},
        "7725": {"comment":"A rest?"},
        "7728": {"comment":"Yes: nothing to sound"},
