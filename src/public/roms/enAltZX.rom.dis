        "4314": {"synopsis":"16-pixel tile: its bank from bits 7-6 of the number, 256 bytes each.","comment":"Bits 7-6: the bank from $5BBC's on"},
        "4319": {"comment":"HL = $8000 + 256 x bits 5-0"},
        "4323": {"comment":"That bank at $8000-$BFFF"},
        "4326": {"comment":"Its 8K pages"},
        "4327": {"comment":"Into $8000-$BFFF"},
        "4334": {"comment":"L = 0"},
        "4336": {"synopsis":"A = the rows of a tile.","comment":"A = the rows in a tile"},
        "4339": {"synopsis":"One pixel row: 8 or 16 bytes by LDIX, skipping the transparent colour.","comment":"Keep the step"},
        "4340": {"comment":"A = the transparent colour"},
