        "7343": {"comment":"Yes: past it"},
        "7345": {"comment":"An ENTER?"},
        "7347": {"comment":"Yes: past it"},
        "7349": {"comment":"Anything else: no carry"},
        "7350": {"synopsis":"Done.","comment":"BC, DE and HL back"},
        "7354": {"synopsis":"Past it.","comment":"Past it"},
        "7355": {"comment":"The place kept"},
        "7361": {"comment":"Again"},
        "7363": {"synopsis":"PLAY's errors: the AY chips silenced and interrupts on first, then the error code through\nNextZXOS ROM 1's ERROR_128_A: $29, report n Out of range.","comment":"The AY silenced"},
        "7366": {"comment":"Interrupts on"},
        "7367": {"comment":"Error code $29, report n (NextZXOS ROM 1's ERROR_128_A)"},
        "7384": {"synopsis":"Error code $27, report l (number too big).","comment":"The AY silenced"},
        "7387": {"comment":"Interrupts on"},
        "7388": {"comment":"Error code $27, report l"},
