        "1567": {"comment":"Placed in the row's text"},
        "1570": {"comment":"A = the remembered column"},
        "1571": {"comment":"No carry"},
        "1572": {"comment":"The cursor stored"},
        "1575": {"synopsis":"Key $08: the cursor one place left (CURSOR_LEFT); the new column becomes the remembered one.\nExit: no move, only shown.","comment":"The cursor off"},
        "1578": {"comment":"One place left"},
        "1581": {"comment":"Moved: stored, the column remembered"},
        "1584": {"comment":"The cursor shown"},
        "1587": {"synopsis":"Key $09: the cursor one place right (CURSOR_RIGHT); the new column becomes the remembered\none.","comment":"The cursor off"},
