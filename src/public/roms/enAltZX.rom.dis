        "2260": {"comment":"Stored"},
        "2262": {"synopsis":"Codes below $20: 1-5 become $20-$24 ($22 becomes $52), 6-$1F become $41-$5A.","comment":"A control code?"},
        "2266": {"comment":"Moved up"},
