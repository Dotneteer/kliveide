      ],
      "lineAnnotations": {
        "0": {"synopsis":"RST $00: on at TO_SWAP_BANK7, which swaps SP with the pointer kept at $5B6A and pages RAM\nbank 7 in at $C000 (SP_SWAP_BANK7). Used in pairs with RST $08 around work on the program in\nbank 0."},
        "1": {"comment":"On at TO_SWAP_BANK7"},
        "3": {"synopsis":"Returns DE = $0208, the version of this ROM; NextZXOS ROM 2 calls it at $1D05 (through its\n$3E18) to check the alternate ROM.\nExit: DE = $0208.","comment":"The version"},
        "8": {"synopsis":"RST $08: on at BANK0_SP_SWAP: RAM bank 0 at $C000 and SP swapped with the pointer kept at\n$5B6A.","comment":"RAM bank 0 and the normal stack"},
        "11": {"synopsis":"RST $00's way on to SP_SWAP_BANK7.","comment":"RAM bank 7 and the alternate stack"},
        "16": {"synopsis":"RST $10: calls the address in the word after the RST in ROM 0 (CALL_ROM0), then returns past\nthe word.","comment":"A routine in ROM 0"},
        "24": {"synopsis":"RST $18: calls the address in the word after the RST in ROM 1 (CALL_ROM1), then returns past\nthe word.","comment":"A routine in ROM 1"},
        "32": {"synopsis":"RST $20: calls the address in the word after the RST in ROM 3 (CALL_ROM3), then returns past\nthe word.","comment":"A routine in ROM 3"},
        "40": {"synopsis":"RST $28: prints A through the current channel: ROM 3's PRINT_A ($0010) through ROM3_CALL_BC.\nNo inline word. Keeps BC.","comment":"The caller's BC kept"},
        "44": {"comment":"On with ROM 3's PRINT_A"},
        "56": {"synopsis":"The maskable interrupt (IM 1): AF and HL kept, H = 0, A = $80, then INT_DIVMMC.","comment":"AF and HL kept for INT_RETURN"},
        "58": {"comment":"H = 0 for the DivMMC's handler"},
        "60": {"comment":"$80: CONMEM, the DivMMC's memory paged in"},
        "62": {"comment":"On past the filler"},
        "70": {"synopsis":"Port $E3 (DivMMC control) = $80: the DivMMC's memory replaces this ROM at $0000-$3FFF, so\nthe bytes after this OUT are never run here; the DivMMC's handler continues at $0048 and\ncomes back through INT_RETURN.","comment":"The DivMMC's memory replaces this ROM from here"},
        "96": {"synopsis":"The end of the interrupt: HL and AF back, interrupts on, return. Reached from the DivMMC's\nhandler.","comment":"Back here from the DivMMC's handler"},
        "98": {"comment":"Interrupts on again"},
        "102": {"synopsis":"The non-maskable interrupt: RETN at once.","comment":"Nothing done"},
        "104": {"synopsis":"RST $10's work: calls the routine at the word after the RST in ROM 0:\n1. BC = the word, the return address moved past it.\n2. ROM 0's $007B (which pages this ROM back in) as the way back, the routine's address on\n   top.\n3. ALT_ROM_OFF: this ROM paged out, the RET goes into ROM 0. Keeps BC (through $5B54).","comment":"The caller's BC kept while the word is read"},
        "108": {"comment":"HL = the address of the word"},
        "109": {"comment":"BC = the word: the routine's address"},
        "113": {"comment":"The return address past the word; HL back"},
        "114": {"comment":"ROM 0's ALT_ROM_ON, the way back into this ROM"},
        "118": {"comment":"The routine's address for the RET"},
        "119": {"comment":"The caller's BC back"},
        "123": {"synopsis":"NextReg $8C = 0: the alternate ROM off, so the standard ROM appears at $0000; the RET goes\nto the address on the stack there.","comment":"The alternate ROM off: RET into the standard ROM"},
        "128": {"synopsis":"RST $18's work: calls the routine at the word after the RST in ROM 1: BC = the word, the\nreturn address moved past it; ROM 0's $007B as the way back and ROM 0's $3E8A (which selects\nROM 1 and calls BC) as the first stop; then ALT_ROM_OFF. Keeps BC.","comment":"The caller's BC kept while the word is read"},
        "132": {"comment":"HL = the address of the word"},
        "133": {"comment":"BC = the word: the routine's address"},
        "137": {"comment":"The return address past the word; HL back"},
        "138": {"comment":"ROM 0's ALT_ROM_ON, the way back into this ROM"},
        "142": {"comment":"ROM 0's $3E8A selects ROM 1 and goes to BC"},
        "146": {"comment":"Alternate ROM off; RET to $3E8A"},
        "148": {"synopsis":"RST $28's second half: BC = ROM 3's PRINT_A ($0010), then as CALL_ROM3 at ROM3_CALL_BC.","comment":"BC = ROM 3's PRINT_A"},
        "151": {"comment":"The call as CALL_ROM3's"},
        "153": {"synopsis":"RST $20's work: calls the routine at the word after the RST in ROM 3 (ROM3_CALL_BC with BC =\nthe word, the return address moved past it).","comment":"The caller's BC kept while the word is read"},
        "157": {"comment":"HL = the address of the word"},
        "158": {"comment":"BC = the word: the routine's address"},
        "162": {"comment":"The return address past the word; HL back"},
        "163": {"synopsis":"Calls the routine at BC in ROM 3: the stack gets ROM 0's $007B (back into this ROM), $5B4D\n(ROM 0 selected again), the routine and $5B48 (ROM 3 selected); the caller's BC back from\n$5B54; then ALT_ROM_OFF.","comment":"ROM 0's ALT_ROM_ON, the last way back"},
        "167": {"comment":"$5B4D: ROM 0 selected again on return"},
        "171": {"comment":"The routine's address"},
        "172": {"comment":"$5B48: ROM 3 selected first"},
        "176": {"comment":"The caller's BC back"},
        "180": {"comment":"Alternate ROM off; RET to $5B48"},
        "182": {"synopsis":"RST $08's work: RAM bank 0 at $C000 with ROM 0 selected (NextReg $8E = $08), then the SP\nswap: SP exchanged with the pointer kept at $5B6A, the return address moved to the new\nstack.\nChanges: AF' only.","comment":"RAM bank 0 at $C000, ROM 0 selected"},
        "186": {"comment":"AF kept in AF'"},
        "187": {"comment":"AF = the return address"},
        "188": {"comment":"HL kept"},
        "191": {"comment":"HL = the other stack's pointer"},
        "194": {"comment":"This stack's pointer kept in its place"},
        "198": {"comment":"Onto the other stack"},
        "199": {"comment":"HL back"},
        "202": {"comment":"The return address onto the new stack"},
        "203": {"comment":"AF back"},
        "204": {"comment":"Back to the caller"},
        "205": {"synopsis":"RST $00's work: SP exchanged with the pointer kept at $5B6A, the return address moved to the\nnew stack, then RAM bank 7 at $C000 with ROM 0 selected (NextReg $8E = $78).\nChanges: AF' only.","comment":"AF kept in AF'"},
        "206": {"comment":"AF = the return address"},
        "207": {"comment":"HL kept"},
        "210": {"comment":"HL = the other stack's pointer"},
        "213": {"comment":"This stack's pointer kept in its place"},
        "217": {"comment":"Onto the other stack"},
        "218": {"comment":"HL back"},
        "221": {"comment":"The return address onto the new stack"},
        "222": {"comment":"AF back"},
        "223": {"comment":"RAM bank 7 at $C000, ROM 0 selected"},
        "228": {"synopsis":"Looks A up in the table at HL (entries of a byte and a routine address, ended by $FF) and\njumps to the routine of the entry whose byte is A, with RET_Z_SET as its way back.\nEntry: A = the value, HL = the table.\nExit: found, the routine's flags with Z set (H = 0), HL past the entry; not found, carry\nclear and NZ, BC, DE and HL kept.","comment":"RET_Z_SET, where the routine returns"},
        "234": {"synopsis":"One entry: B = its byte, DE = its address.","comment":"B = the entry's byte"},
        "235": {"comment":"The $FF end?"},
        "238": {"comment":"B back"},
        "239": {"comment":"DE = the entry's routine"},
        "243": {"comment":"HL = the next entry"},
        "244": {"comment":"A's entry?"},
        "247": {"comment":"The next entry"},
        "249": {"synopsis":"The $FF end: carry clear, NZ, the pushed RET_Z_SET dropped.","comment":"No carry"},
        "250": {"comment":"NZ ($FF)"},
        "253": {"comment":"RET_Z_SET dropped"},
        "255": {"synopsis":"Found: the routine's address goes on the stack, DE back."},
        "256": {"comment":"HL = the routine, DE = past the entry"},
        "257": {"comment":"The routine for the RET; HL = the caller's DE"},
        "258": {"comment":"DE back; HL past the entry"},
        "259": {"comment":"Into the routine"},
        "260": {"synopsis":"Calls the routine at HL, then returns with Z set and H = 0. No caller in this page.","comment":"The routine at HL"},
        "263": {"synopsis":"H = 0 and Z set: where TABLE_DISPATCH's routines return.","comment":"H = 0"},
        "265": {"comment":"Z set"},
        "267": {"synopsis":"Jumps to HL: a CALL here calls the routine at HL.","comment":"A CALL here calls HL"},
        "268": {"synopsis":"Rebuilds the editing rows (window rows 0 to ($D73C), bank 7 from $C000) from the program and\ndraws them, the cursor going to E_PPC's line when it is among them:\n1. $D741 bit 1 set (E_PPC looked for), bit 0 cleared; in a mode other than 0 ($D5B8) E_PPC =\n   0.\n2. ROWS_REBUILD_GO: with E_PPC 0, $D5B5 = 0.\n3. The rows above the window emptied ($0DC3) and refilled with as many rows as before\n   ($CE73), from the line before ($D74E) on ($13F9); the rows below emptied (BELOW_RESET).\n4. Each window row taken from the program (ROW_FROM_BELOW); on E_PPC's first row the cursor\n   is placed ($D5B5) places on.\n5. E_PPC not found: $D74E = E_PPC, the rows above emptied, again; E_PPC 0: the line $1401\n   gives becomes E_PPC, again.\n6. The rows drawn (RB_DRAW).","comment":"No E_PPC row found yet"},
        "273": {"comment":"E_PPC looked for"},
        "275": {"comment":"Mode ($D5B8) not 0?"},
        "281": {"comment":"Then E_PPC = 0"},
        "287": {"synopsis":"Again from here (RB_AGAIN), with E_PPC changed.","comment":"HL = E_PPC"},
        "290": {"comment":"E_PPC 0?"},
        "294": {"comment":"Then no places to move the cursor on"},
        "297": {"synopsis":"The count of rows above the window kept; $D74C = the line before $D74E ($13F9); both buffers\nemptied.","comment":"A = the count of rows above the window"},
        "300": {"comment":"Kept"},
        "301": {"comment":"HL = the line at the window's top"},
        "304": {"comment":"The line before it"},
        "307": {"comment":"Kept at $D74C"},
        "310": {"comment":"The rows above emptied"},
        "313": {"comment":"The rows below emptied"},
        "316": {"comment":"The count back"},
        "317": {"synopsis":"One row from the program put above the window, until the count is used up.","comment":"None left?"},
        "320": {"comment":"The count kept"},
        "321": {"comment":"The next row from the program"},
        "324": {"comment":"DE = the row"},
        "325": {"comment":"Put above the window"},
        "328": {"comment":"One less"},
        "332": {"synopsis":"Rows 0 to ($D73C): B = the row, C = ($D73C), DE = the row's place; the two kept on the\nstack.","comment":"Row 0"},
        "334": {"comment":"DE = its place"},
        "337": {"comment":"B = 0, the first row"},
        "338": {"comment":"C = the last row"},
        "342": {"comment":"Both kept"},
        "344": {"synopsis":"One row: the next from the program (ROW_FROM_BELOW); while E_PPC is looked for, is this\nE_PPC's first row?","comment":"HL = the next row from the program"},
        "347": {"comment":"E_PPC looked for?"},
        "356": {"comment":"DE = the width"},
        "360": {"comment":"HL = the row's flags byte"},
        "361": {"comment":"A line's first row?"},
        "365": {"comment":"DE = its line number"},
        "369": {"comment":"Carry cleared"},
        "370": {"comment":"HL = E_PPC"},
        "373": {"comment":"The same line?"},
        "377": {"comment":"Found: the cursor goes on this row"},
        "382": {"synopsis":"Not E_PPC's first row."},
        "384": {"synopsis":"The row copied into the editing rows (($D73F) bytes); DE = the next row's place."},
        "386": {"comment":"BC = the row size"},
        "390": {"comment":"The row into the window"},
        "394": {"comment":"DE = the next row's place, kept"},
        "395": {"comment":"The row numbers kept"},
        "396": {"comment":"DE = the row copied"},
        "397": {"comment":"The cursor on this row?"},
        "404": {"comment":"Column 0"},
        "406": {"synopsis":"The cursor ($D5B5) places on: while places are left and the row has text at or after column\nB (TEXT_FROM_COL).","comment":"HL = the places still to go"},
        "409": {"comment":"None?"},
        "413": {"comment":"Kept"},
        "414": {"comment":"Text at or after column B?"},
        "418": {"comment":"The carry kept"},
        "419": {"comment":"HL = the width"},
        "422": {"comment":"DE = the row's flags byte"},
        "424": {"comment":"The carry back"},
        "425": {"comment":"Text: one place on"},
        "427": {"comment":"A = the flags"},
        "428": {"comment":"The row continues?"},
        "434": {"comment":"No places left"},
        "440": {"comment":"The search ends"},
        "443": {"synopsis":"No text left on a row that continues: the cursor stored here for now; the search goes on in\nthe next row."},
        "445": {"comment":"The cursor here for now"},
        "448": {"synopsis":"One place on: the count less one, B + 1."},
        "450": {"comment":"One place less"},
        "451": {"comment":"One column on"},
        "452": {"comment":"The count stored"},
        "455": {"comment":"Again"},
        "457": {"synopsis":"No places left: B placed in the row's text (TEXT_FROM_COL, else TEXT_BACK_FROM); the search\nends ($D741 = 0).","comment":"Column B in the row's text?"},
        "460": {"comment":"Otherwise back to just after it"},
        "463": {"comment":"The search ended"},
        "468": {"synopsis":"The cursor stored at this row, column B, remembered column B (CURSOR_STORE).","comment":"A = the column"},
        "469": {"comment":"B = the row's number"},
        "471": {"comment":"C = the row"},
        "472": {"comment":"B = the column"},
        "473": {"comment":"The cursor stored, column remembered"},
        "476": {"synopsis":"The next row, up to ($D73C).","comment":"The row numbers back"},
        "477": {"comment":"DE = the next row's place"},
        "478": {"comment":"A = the last row"},
        "479": {"comment":"The next row"},
        "480": {"comment":"Past the last?"},
        "484": {"comment":"A = the flags"},
        "487": {"comment":"E_PPC looked for?"},
        "491": {"comment":"And not found?"},
        "495": {"comment":"HL = E_PPC"},
        "498": {"comment":"Zero?"},
        "502": {"comment":"Not shown: the window starts at E_PPC"},
        "505": {"comment":"The rows above emptied"},
        "508": {"comment":"Again"},
        "510": {"synopsis":"E_PPC 0: $D74E = 0 and E_PPC = the line $1401 gives.","comment":"The window from line 0"},
        "513": {"comment":"HL = the program's first line"},
        "516": {"comment":"E_PPC = that line"},
        "519": {"synopsis":"Again (ROWS_REBUILD_GO)."},
        "521": {"comment":"Again with it"},
        "524": {"synopsis":"Rows 0 to ($D73C) drawn (ROWS_DRAW, with Z).","comment":"The first and last rows back"},
        "526": {"comment":"Z: no cursor move"},
        "527": {"synopsis":"Draws editing rows B to C on the screen, each through $1169. With NZ on entry the cursor is\nthen moved on ($D5B5) places (ROWS_DRAW_MOVE).\nEntry: B, C = the first and last row; Z or NZ.","comment":"The Z flag kept"},
        "528": {"comment":"A = the last row"},
        "529": {"comment":"C = the first"},
        "530": {"comment":"DE = its place"},
        "533": {"comment":"HL = the row"},
        "534": {"synopsis":"One row drawn ($1169); the next, up to A.","comment":"The last row kept"},
        "535": {"comment":"Row C drawn"},
        "539": {"comment":"DE = the row size"},
        "543": {"comment":"HL = the next row"},
        "544": {"comment":"The next row number"},
        "545": {"comment":"Past the last?"},
        "548": {"comment":"The Z flag back"},
        "549": {"comment":"Z: done"},
        "550": {"comment":"The cursor's place"},
        "553": {"synopsis":"One place on (CURSOR_RIGHT), ($D5B5) times, then the cursor stored.","comment":"One place right"},
        "556": {"comment":"The count less one"},
        "565": {"comment":"Until it is 0"},
        "567": {"comment":"The cursor stored"},
        "570": {"synopsis":"Scrolls the editing rows up by one: row 0 goes to the rows above the window ($0E0F; when\nthere is no room there, nothing is done), then ROWS_UP_FROM from row 0 with the next row\nfrom below (ROW_FROM_BELOW).\nExit: carry when done.","comment":"Row 0"},
        "573": {"comment":"C = 0"},
        "574": {"comment":"DE = row 0"},
        "577": {"comment":"Row 0 above the window"},
        "581": {"comment":"No room: no carry"},
        "582": {"comment":"HL = the next row from below"},
        "585": {"synopsis":"Rows B+1 to ($D73C) moved up by one into rows B to ($D73C) - 1, the screen scrolled the same\nway ($101C), and the row at HL copied into the last row.\nEntry: B = the row, DE = its address, HL = the new row.\nExit: carry. Keeps BC."},
        "586": {"comment":"The new row kept"},
        "587": {"comment":"HL = the row after row B"},
        "591": {"comment":"A = the last row"},
        "594": {"comment":"C = the last row"},
        "595": {"comment":"Row B the last?"},
        "599": {"synopsis":"One row up."},
        "600": {"comment":"BC = the row size"},
        "604": {"comment":"One row up"},
        "607": {"comment":"A = the last row"},
        "608": {"comment":"The next row"},
        "609": {"comment":"Up to the last"},
        "613": {"synopsis":"The screen scrolled up ($101C); the new row into the last row.","comment":"HL = the new row"},
        "614": {"comment":"The screen scrolled up"},
        "617": {"comment":"BC = the row size"},
        "621": {"comment":"The new row into the last row"},
        "623": {"comment":"Done"},
        "626": {"synopsis":"Scrolls the editing rows down by one: the last row above the window comes back ($0DCC; when\nthere is none, nothing is done), then ROWS_DOWN_FROM from row 0.\nExit: carry when done.","comment":"Row 0"},
        "628": {"comment":"HL = the last row above the window"},
        "631": {"comment":"None: no carry"},
        "632": {"synopsis":"Row ($D73C) goes to the rows below the window (BELOW_PUSH; when there is no room there,\nnothing is done), rows B to ($D73C) - 1 move down by one, the screen scrolled the same way\n($1030), and the row at HL copied into row B.\nEntry: B = the row, HL = the new row.\nExit: carry when done. Keeps BC."},
        "633": {"comment":"The new row kept"},
        "634": {"comment":"A = the last row"},
        "637": {"comment":"C = the last row"},
        "638": {"comment":"DE = its place"},
        "641": {"comment":"The last row below the window"},
        "644": {"comment":"No room there?"},
        "646": {"comment":"DE = the row's place less one"},
        "647": {"comment":"HL = the row size"},
        "650": {"comment":"HL = the last row's end"},
        "651": {"comment":"DE = the last row's end"},
        "653": {"comment":"Row B the last?"},
        "657": {"synopsis":"One row down (copied from its end)."},
        "658": {"comment":"BC = the row size"},
        "662": {"comment":"One row down"},
        "665": {"comment":"A = row B"},
        "666": {"comment":"The row above"},
        "667": {"comment":"Down to row B"},
        "670": {"synopsis":"DE = row B's place; the screen scrolled down ($1030); the new row into row B.","comment":"HL = the end of row B's place"},
        "671": {"comment":"DE = row B"},
        "673": {"comment":"HL = the new row"},
        "674": {"comment":"The screen scrolled down"},
        "677": {"comment":"BC = the row size"},
        "681": {"comment":"The new row into row B"},
        "683": {"comment":"Done"},
        "686": {"synopsis":"No room below: no carry."},
        "689": {"synopsis":"Puts character A in column B of the row at DE, moving columns B to the last ($D73D - 1) one\nto the right.\nExit: A = E = the character pushed off the end; Z when it was 0. Keeps DE."},
        "690": {"comment":"HL = column B's address"},
        "694": {"comment":"D = the character carried in"},
        "695": {"comment":"A = the column"},
        "696": {"synopsis":"One column: its character swapped with the one carried, up to the last column.","comment":"E = the character there"},
        "697": {"comment":"The carried one in its place"},
        "698": {"comment":"Carry E on"},
        "699": {"comment":"The next column"},
        "702": {"comment":"L = the width"},
        "705": {"comment":"Past the last column?"},
        "709": {"comment":"A = the character pushed off"},
        "710": {"comment":"Zero?"},
        "713": {"synopsis":"Takes the character in column B out of the row at DE, moving columns B+1 to the last one to\nthe left; character A comes in at the last column.\nExit: A = E = the character taken out, Z when it was 0; HL = the row's flags byte. Keeps DE."},
        "714": {"comment":"HL = the width"},
        "717": {"comment":"HL = the flags byte"},
        "718": {"comment":"Kept"},
        "719": {"comment":"D = the character carried in"},
        "720": {"comment":"A = the width"},
        "723": {"comment":"A = the last column"},
        "724": {"comment":"From the last column"},
        "726": {"synopsis":"One column: its character swapped with the one carried; column B ends it.","comment":"E = the character there"},
        "727": {"comment":"The carried one in its place"},
        "728": {"comment":"Carry E on"},
        "729": {"comment":"Column B?"},
        "732": {"comment":"The column to the left"},
        "733": {"synopsis":"One column to the left.","comment":"The address too"},
        "736": {"synopsis":"Column B's character in A; Z when it was 0.","comment":"A = column B's character"},
        "737": {"comment":"Zero?"},
        "738": {"comment":"HL = the flags byte"},
        "741": {"synopsis":"Returns to the editor from NextZXOS ROM 0's menu (its $0E8D, through CALL_ALT_ROM):\n1. With $D5EC 0, FLAGS bit 5 set.\n2. When $D5EC equals the mode at $D5B8, the columns applied (ROM 0's COLUMNS_APPLY) and the\n   editor resumed as it was (EDITOR_RESUME).\n3. Otherwise $D5B8 = $D5EC and the editor started afresh in that mode (EDITOR_START).","comment":"A = the mode the rows were set for"},
        "744": {"comment":"Zero?"},
        "747": {"comment":"Then FLAGS bit 5 set"},
        "751": {"synopsis":"Same mode as before?","comment":"HL = the mode now"},
        "754": {"comment":"The same?"},
        "757": {"comment":"The columns applied (COLUMNS_APPLY)"},
        "760": {"comment":"The editor as it was"},
        "762": {"synopsis":"Another mode: stored; A made even for EDITOR_START.","comment":"The new mode"},
        "763": {"comment":"A even"},
        "764": {"synopsis":"Starts the editor in mode 2A (0 NextBASIC, 4 the Calculator, 8 a third mode): NextZXOS ROM\n0's menu actions i0-i2 (MENU_FUNCS, through MENU_ACTION's CALL_ALT_ROM path) come here with\nA = 2i, and its BROWSER_RESUME ($2C29) with A = 0.\n1. E_PPC = 0; $D5B8 = $D5EC = the mode; $D74E = E_PPC.\n2. Bank 7's $C000-$D5AD zeroed; $D5B7 = $80; TV_FLAG bit 0 cleared.\n3. The columns applied (ROM 0's COLUMNS_APPLY) and the window set (WINDOW_SETUP).\n4. Mode 0: the upper screen (SCREEN_TO_UPPER); mode 4: the cursor at 0, 0 first; mode 8:\n   SCREEN_TO_UPPER, $12E4 and SCREEN_TO_LOWER.\n5. $0FD3, then EDITOR_RESUME.\nEntry: A = 2 x the mode number.","comment":"A = the mode: 0, 4 or 8"},
        "765": {"comment":"E_PPC = 0"},
        "771": {"synopsis":"EDITOR_START with E_PPC kept: from $132F with A = ($D5EC).","comment":"The mode stored"},
        "774": {"comment":"And as the rows' mode"},
        "777": {"comment":"HL = E_PPC"},
        "780": {"comment":"$D74E = it"},
        "783": {"comment":"Bank 7 from $C000"},
        "786": {"comment":"To $D5AD"},
        "789": {"comment":"The count less one"},
        "792": {"comment":"The first byte 0"},
        "794": {"comment":"Zeroed"},
        "796": {"comment":"$D5B7 = $80"},
        "801": {"comment":"TV_FLAG bit 0 cleared: the upper screen"},
        "805": {"comment":"The mode kept"},
        "806": {"comment":"The columns applied (COLUMNS_APPLY)"},
        "809": {"comment":"The window set up"},
        "812": {"comment":"The mode back"},
        "813": {"comment":"Mode 0?"},
        "816": {"comment":"Mode 4?"},
        "820": {"comment":"Mode 8: the upper screen set up"},
        "823": {"comment":"$12E4 (ROM 0's $1277 on the window's rows)"},
        "826": {"comment":"Then the lower screen"},
        "829": {"comment":"On"},
        "831": {"synopsis":"Mode 4: the cursor at row 0, column 0 (CURSOR_STORE).","comment":"Row 0, column 0, remembered column 0"},
        "834": {"comment":"The cursor stored"},
        "837": {"synopsis":"Mode 0: the upper screen.","comment":"The upper screen"},
        "840": {"synopsis":"$0FD3 for all modes.","comment":"$D7D7 = 1, $D7D8 = 5 ($0FD3)"},
        "843": {"comment":"A = 0"},
        "844": {"synopsis":"Resumes the editor:\n1. $D5B7 bit 3 (the line changed) cleared.\n2. Editing in the upper screen ($D5B7 bit 6 clear): the title bar (ROM 0's EDIT_TITLE_BAR),\n   the columns applied, the key mode reset (ROM 0's KEY_MODE_RESET).\n3. IX = $D7D9, DF_SZ = 2, both row buffers emptied, $D5B5 = 0.\n4. Mode 4: the cursor shown, then MAIN_KEY_LOOP.\n5. Otherwise E_PPC = the number of the first line at or after it (ROM 3's FIND_LINE and\n   LINE_NO, in bank 0), the rows rebuilt (ROWS_REBUILD), the cursor shown and moved to a new\n   row after the line (KEY_ENTER); then MAIN_KEY_LOOP.","comment":"HL = $D5B7"},
        "847": {"comment":"The line not changed"},
        "849": {"comment":"Editing in the lower screen?"},
        "853": {"comment":"The title bar (EDIT_TITLE_BAR)"},
        "856": {"comment":"The columns applied (COLUMNS_APPLY)"},
        "859": {"comment":"The key mode reset (KEY_MODE_RESET)"},
        "862": {"synopsis":"IX, DF_SZ and the buffers; the way on by the mode.","comment":"IX = the window's block"},
        "866": {"comment":"DF_SZ = 2"},
        "870": {"comment":"No rows below the window"},
        "873": {"comment":"No rows above it"},
        "876": {"comment":"No places to move the cursor on"},
        "882": {"comment":"A = the mode"},
        "885": {"comment":"The Calculator?"},
        "887": {"comment":"Then the cursor shown"},
        "890": {"comment":"On to the key loop"},
        "892": {"comment":"HL = E_PPC"},
        "895": {"comment":"Bank 0 with the program"},
        "896": {"comment":"The first line at or after E_PPC (FIND_LINE)"},
        "899": {"comment":"DE = its number (LINE_NO)"},
        "902": {"comment":"Bank 7 again"},
        "903": {"comment":"E_PPC = it"},
        "907": {"comment":"The rows rebuilt and drawn"},
        "910": {"comment":"The cursor shown"},
        "913": {"comment":"The cursor to a new row after the line"},
        "916": {"synopsis":"Waits for a key with a click (ROM 0's WAIT_KEY_CLICK) and handles it (KEY_DISPATCH);\nforever, the stack reset to $5BFF each time.","comment":"The stack reset"},
        "919": {"comment":"A = the key (WAIT_KEY_CLICK)"},
        "922": {"comment":"Handled"},
        "925": {"comment":"Forever"},
        "927": {"synopsis":"Handles key A: looked up in the key table at $13B3 (TABLE_DISPATCH); a routine that returns\nno carry gets a click (KEY_REFUSED). A code not in the table is a character (KEY_INSERT), or\na click when $D5B7 bit 0 is set (the rows are full). Keeps AF for table keys.\nEntry: A = the key code.","comment":"HL = the key table"},
        "930": {"comment":"The key kept"},
        "931": {"comment":"In the table?"},
        "934": {"comment":"Not in the table"},
        "936": {"comment":"Refused: a click"},
        "939": {"comment":"The key back"},
        "941": {"synopsis":"Not in the table: a character.","comment":"The key back"},
        "942": {"comment":"The rows full ($D5B7 bit 0)?"},
        "947": {"comment":"Then a click"},
        "950": {"comment":"Otherwise put in"},
        "953": {"synopsis":"ROM 0's CLICK.","comment":"A click (CLICK)"},
        "957": {"synopsis":"Sets the editor's window up: IX = $F700 for 32 columns ($D73D), $FB00 otherwise; code $0E\nprinted in that window (ROM 0's WIN_PRINT_A); then IX = $D7D9.\nExit: IX = $D7D9.","comment":"A = the width"},
        "960": {"comment":"32 columns?"},
        "962": {"comment":"IX = the 32-column window"},
        "968": {"comment":"IX = the other window"},
        "972": {"synopsis":"Code $0E to the window at IX.","comment":"Code $0E to it (WIN_PRINT_A)"},
        "977": {"comment":"IX = the editor's window block"},
        "982": {"synopsis":"Handles character A as a key in the editor, from NextZXOS ROM 1's $0A45 and $0A90 (through\nits CALL_ALT_ROM0; $0D, and characters of the Calculator's result): in bank 7 on the\nalternate stack, $D5B7 bit 3 cleared, the cursor shown, stream 2 selected (ROM 3's\nSTREAM_SELECT), the key handled (KEY_DISPATCH), bit 3 cleared again, the cursor taken off.\nEntry: A = the code. Keeps DE and HL."},
        "984": {"comment":"Bank 7 and the alternate stack"},
        "985": {"comment":"The line not changed"},
        "990": {"comment":"The code kept"},
        "991": {"comment":"The cursor shown"},
        "994": {"comment":"Stream 2 (STREAM_SELECT)"},
        "999": {"comment":"The code back"},
        "1000": {"comment":"Handled as a key"},
        "1003": {"comment":"The line not changed"},
        "1008": {"comment":"The cursor off"},
        "1011": {"comment":"Bank 0 and the normal stack"},
        "1015": {"synopsis":"Key $07 (EDIT): the cursor off; menu ($D5B8) / 4 + 2 run (ROM 0's RUN_MENU: 2 in mode 0, 3\nin mode 4, 4 in mode 8); the columns applied again; carry; IX = $D7D9; the cursor shown.","comment":"The cursor off"},
        "1018": {"comment":"A = the mode"},
        "1021": {"comment":"The mode / 4"},
        "1023": {"comment":"Menu 2, 3 or 4"},
        "1025": {"comment":"Run (RUN_MENU)"},
        "1028": {"comment":"The columns applied (COLUMNS_APPLY)"},
        "1031": {"comment":"Carry"},
        "1032": {"comment":"IX = the editor's window block"},
        "1036": {"comment":"The cursor shown"},
        "1039": {"synopsis":"Key $19: in mode 0 only, the cursor off, editing moved between the upper and the lower\nscreen ($1332), the cursor shown. In other modes NC (refused).","comment":"A = the mode"},
        "1042": {"comment":"Not 0: refused"},
        "1044": {"comment":"The cursor off"},
        "1047": {"comment":"To the other screen"},
        "1050": {"comment":"The cursor shown"},
        "1053": {"synopsis":"Editing in the lower screen: $D5B7 bit 6 set, two editing rows (EDIT_IN_LOWER), $107D, the\ncursor's limits for the lower screen (CURSOR_SET_LOWER), lines 21-23 cleared (ROM 0's\nCLEAR_BOTTOM3).","comment":"HL = $D5B7"},
        "1056": {"comment":"Editing in the lower screen"},
        "1058": {"comment":"Two rows"},
        "1061": {"comment":"The lower window's block into $D7D9"},
        "1064": {"comment":"The cursor's limits for it"},
        "1067": {"comment":"Lines 21-23 cleared (CLEAR_BOTTOM3)"},
        "1071": {"synopsis":"Editing in the upper screen: $D5B7 bit 6 cleared, 21 editing rows (EDIT_IN_MAIN), $1074, the\ncursor's limits for the main screen (CURSOR_SET_UPPER), the title bar (ROM 0's\nEDIT_TITLE_BAR).","comment":"HL = $D5B7"},
        "1074": {"comment":"Editing in the upper screen"},
        "1076": {"comment":"21 rows"},
        "1079": {"comment":"The upper window's block into $D7D9"},
        "1082": {"comment":"The cursor's limits for it"},
        "1085": {"comment":"The title bar (EDIT_TITLE_BAR)"},
        "1089": {"synopsis":"CURSOR_SET_UPPER's block for COPY_COUNTED: a count (6), then $D745-$D74A = 0, 0, 0, 4, $10,\n$14 (row, column and remembered column of the cursor, then three row limits)."},
        "1096": {"synopsis":"CURSOR_SET_LOWER's block: a count (6), then $D745-$D74A = 0, 0, 0, 0, 1, 1."},
        "1103": {"synopsis":"$D745-$D74A from CURS_LOWER_INIT.","comment":"HL = the block for the lower screen"},
        "1106": {"comment":"To CURSOR_SET_BLOCK"},
        "1108": {"synopsis":"$D745-$D74A from CURS_UPPER_INIT. Also called by NextZXOS ROM 0's RUN_COMMAND ($0975) before\nEDIT_LINE_ENTER.","comment":"HL = the block for the upper screen"},
        "1111": {"synopsis":"DE = $D745, then COPY_COUNTED.","comment":"DE = the cursor's row"},
        "1114": {"synopsis":"Copies the bytes at HL, a count first, to DE (also used from $0DC9, $0FD9 and $1083).\nExit: HL and DE past them; BC = 0.","comment":"C = the count"},
        "1117": {"comment":"HL = the bytes"},
        "1118": {"comment":"Copied"},
        "1121": {"synopsis":"A character key (not in the key table): codes below $20 only update the cursor's kind\n($1086: ROM 0's CURSOR_KIND into IX+6), the cursor off and on again. Others are put in at\nthe cursor (LINE_INSERT_CHAR); $D5B7 bit 3 set (the line changed); the cursor one place on\n(CURSOR_RIGHT, with $D5B7 bit 7 cleared so that a full row continues on a new one) and\nstored (CURSOR_PUT); when it does not move, only shown.","comment":"The code kept"},
        "1122": {"comment":"The cursor off"},
        "1125": {"comment":"The code back"},
        "1126": {"comment":"A control code?"},
        "1130": {"comment":"Put in at the cursor"},
        "1133": {"comment":"HL = $D5B7"},
        "1136": {"comment":"Rows may be added"},
        "1138": {"comment":"The line changed"},
        "1140": {"comment":"A = the column"},
        "1142": {"comment":"One place on"},
        "1146": {"comment":"No rows added any more"},
        "1148": {"comment":"Not moved?"},
        "1150": {"comment":"A = the column"},
        "1151": {"comment":"The cursor stored there"},
        "1154": {"synopsis":"A control code: the cursor's kind updated ($1086).","comment":"The cursor's kind updated"},
        "1157": {"synopsis":"The cursor shown.","comment":"The cursor shown"},
        "1160": {"synopsis":"Key $18: the cursor off; KEY_DELETE_GO.","comment":"The cursor off"},
        "1163": {"synopsis":"$D5B7 bit 3 set, the character under the cursor taken out (LINE_DELETE_CHAR), the line's\nrows redrawn (ROWS_REDRAW_LINE), the cursor stored (CURSOR_PUT).","comment":"HL = $D5B7"},
        "1166": {"comment":"The line changed"},
        "1168": {"comment":"The character at the cursor taken out"},
        "1171": {"comment":"The line's rows redrawn"},
        "1174": {"synopsis":"Carry; the cursor stored at column B.","comment":"Carry"},
        "1175": {"comment":"A = the column"},
        "1176": {"comment":"The cursor stored"},
        "1179": {"synopsis":"Key $0C (DELETE): $D5B7 bit 0 cleared and the cursor off; at the start of the line's text\nnothing more (the cursor stored); otherwise one place back (CURSOR_LEFT; at the start of the\nrows, the cursor shown) and the character there deleted (KEY_DELETE_GO).","comment":"HL = $D5B7"},
        "1182": {"comment":"The rows not full any more"},
        "1184": {"comment":"The cursor off"},
        "1187": {"comment":"DE = its row"},
        "1190": {"comment":"HL = the width"},
        "1193": {"comment":"HL = the row's flags byte"},
        "1194": {"comment":"A line's first row?"},
        "1198": {"comment":"The cursor kept"},
        "1199": {"comment":"To the start of the line's text"},
        "1202": {"comment":"A = that column"},
        "1203": {"comment":"The cursor back"},
        "1204": {"comment":"No text: nothing deleted"},
        "1206": {"comment":"Already at the start?"},
        "1209": {"synopsis":"One place left; no move: the cursor shown.","comment":"One place left"},
        "1212": {"comment":"Carry when it did not move"},
        "1213": {"comment":"Then the cursor shown"},
        "1216": {"comment":"Then deleted"},
        "1218": {"synopsis":"Key $0D (ENTER), and EDITOR_RESUME's last step: the cursor off. A row that is empty and is a\nwhole line by itself (flags bits 0 and 3) is left alone (KEY_ENTER_NONE). A changed line\n($D5B7 bit 3) is entered (EDIT_LINE_ENTER); when that fails the cursor is only shown. Then\nthe cursor to the line's end (TO_LINE_END), one place on, a blank row there (NEW_BLANK_ROW),\ncolumn 0 (CURSOR_PUT).","comment":"The cursor off"},
        "1221": {"comment":"The remembered column kept"},
        "1222": {"comment":"DE = its row"},
        "1225": {"comment":"The cursor kept"},
        "1226": {"comment":"From column 0"},
        "1228": {"comment":"Any text in the row?"},
        "1231": {"comment":"The cursor back"},
        "1234": {"comment":"HL = the width"},
        "1237": {"comment":"HL = the row's flags byte"},
        "1238": {"comment":"A = the flags"},
        "1239": {"comment":"Bits 0 and 3 both set?"},
        "1242": {"comment":"Then an empty one-row line"},
        "1244": {"synopsis":"Changed ($D5B7 bit 3)? Then the line entered.","comment":"A = $D5B7"},
        "1247": {"comment":"The line changed?"},
        "1251": {"comment":"Entered"},
        "1254": {"comment":"Not entered"},
        "1256": {"synopsis":"The cursor to the line's end, one place on, a blank row there, column 0.","comment":"To the line's end"},
        "1259": {"comment":"One place on"},
        "1262": {"comment":"A blank row there"},
        "1265": {"comment":"Column 0"},
        "1267": {"comment":"The remembered column back"},
        "1268": {"comment":"Carry"},
        "1269": {"comment":"The cursor stored"},
        "1271": {"synopsis":"An empty one-row line: only the cursor shown, carry.","comment":"The remembered column back"},
        "1272": {"comment":"Carry"},
        "1273": {"comment":"The cursor shown"},
        "1275": {"synopsis":"Not entered: the cursor shown.","comment":"The remembered column back"},
        "1276": {"comment":"The cursor shown"},
        "1278": {"synopsis":"Key $1A, mode 0 only: E_PPC = the program's first line (ROM 3's FIND_LINE from 0 and\nLINE_NO, in bank 0), the cursor's kind updated ($1086), the rows rebuilt (ROWS_REBUILD), the\ncursor shown. In other modes NC (refused).","comment":"Line 0"},
        "1281": {"synopsis":"DE = the line number looked for; mode 0 only.","comment":"A = the mode"},
        "1284": {"comment":"Not 0: refused"},
        "1286": {"comment":"The cursor off"},
        "1289": {"comment":"Bank 0 with the program"},
        "1290": {"comment":"HL = the line number"},
        "1291": {"comment":"Kept"},
        "1292": {"comment":"HL = the first line at or after it (FIND_LINE)"},
        "1295": {"comment":"A = the number's high byte"},
        "1296": {"comment":"Zero?"},
        "1299": {"comment":"Otherwise HL = the line before it"},
        "1300": {"synopsis":"DE = the line's number; E_PPC = it.","comment":"DE = its number (LINE_NO)"},
        "1303": {"comment":"Bank 7 again"},
        "1304": {"comment":"E_PPC = it"},
        "1308": {"comment":"The cursor's kind updated"},
        "1311": {"comment":"The rows rebuilt and drawn"},
        "1314": {"comment":"Carry"},
        "1315": {"comment":"The cursor shown"},
        "1317": {"synopsis":"Key $01: as KEY_PROG_START with 10000: E_PPC = the line before the first one numbered 10000\nor more (FIND_LINE's DE).","comment":"Line 10000"},
        "1320": {"comment":"On"},
        "1322": {"synopsis":"Key $04: the cursor off, back to the start of the previous word (WORD_LEFT); stored with the\ncolumn remembered (CURSOR_PUT), or only shown when it did not move.","comment":"The cursor off"},
        "1325": {"comment":"To the start of the previous word"},
        "1328": {"comment":"Not moved: only shown"},
        "1330": {"comment":"A = the column"},
        "1331": {"comment":"The cursor stored"},
        "1333": {"synopsis":"Key $05: the cursor off, on to the start of the next word (WORD_RIGHT); stored (CURSOR_PUT),\nor only shown.","comment":"The cursor off"},
        "1336": {"comment":"To the start of the next word"},
        "1339": {"comment":"Not moved: only shown"},
        "1341": {"comment":"A = the column"},
        "1342": {"comment":"The cursor stored"},
        "1344": {"synopsis":"Takes the cursor off the screen: its place (CURSOR_GET), then $1053.\nExit: C = the row, B = the column, A = the remembered column, HL = $D748.","comment":"C, B, A = the cursor's place"},
        "1347": {"comment":"Taken off the screen"},
        "1350": {"synopsis":"Moves the cursor to row C, column B, remembered column A: E_PPC = $D74E, the cursor's kind\nupdated ($1086: ROM 0's CURSOR_KIND into IX+6), CURSOR_STORE, then CURSOR_ON.","comment":"HL = the line at the window's top"},
        "1353": {"comment":"E_PPC = it"},
        "1356": {"comment":"The cursor's kind updated"},
        "1359": {"comment":"The place stored"},
        "1362": {"synopsis":"Shows the cursor at its place (CURSOR_GET, then $1044).\nExit: as CURSOR_GET.","comment":"C, B, A = the cursor's place"},
        "1365": {"comment":"Shown on the screen"},
        "1368": {"synopsis":"C = the cursor's row ($D745), B = its column ($D746), A = the remembered column ($D747), the\none up and down moves keep to.\nExit: HL = $D748.","comment":"HL = the cursor's row"},
        "1371": {"comment":"C = the row"},
        "1373": {"comment":"B = the column"},
        "1375": {"comment":"A = the remembered column"},
        "1378": {"synopsis":"The other way: $D745 = C, $D746 = B, $D747 = A.\nExit: HL = $D747.","comment":"HL = the cursor's row"},
        "1381": {"comment":"The row"},
        "1383": {"comment":"The column"},
        "1385": {"comment":"The remembered column"},
        "1387": {"synopsis":"A = the character at column B of window row C (ROW_ADDRESS); 0 is no character.\nExit: DE = the row. Keeps BC, HL."},
        "1388": {"comment":"DE = row C"},
        "1391": {"comment":"HL = column B's address"},
        "1395": {"comment":"A = the character"},
        "1398": {"synopsis":"Key $1E: the cursor down ten rows. Each step is ROW_DOWN with the cursor stored and its\ncolumn placed as near the remembered one as the row's text allows (COL_PLACE_R); a row\nwithout text ends it a row back up (TEN_DOWN_BACK). Then CURSOR_PUT. A step that cannot move\nleaves the cursor only shown.","comment":"The cursor off"},
        "1401": {"comment":"E = the remembered column"},
        "1402": {"comment":"Ten rows"},
        "1404": {"synopsis":"One row down."},
        "1405": {"comment":"One row down"},
        "1409": {"comment":"Not moved: only shown"},
        "1411": {"comment":"A = the remembered column"},
        "1412": {"comment":"The cursor stored"},
        "1415": {"comment":"B = the remembered column"},
        "1416": {"comment":"Placed in the row's text"},
        "1419": {"comment":"No text?"},
        "1421": {"comment":"Ten rows yet?"},
        "1424": {"comment":"A = the remembered column"},
        "1425": {"comment":"The cursor stored"},
        "1427": {"synopsis":"A row without text: back up one row, the column placed (COL_PLACE_R); no carry."},
        "1428": {"comment":"One row back up"},
        "1432": {"comment":"B = the remembered column"},
        "1433": {"comment":"Placed in the row's text"},
        "1436": {"comment":"A = the remembered column"},
        "1437": {"comment":"No carry"},
        "1438": {"comment":"The cursor stored"},
        "1440": {"synopsis":"Key $1F: the cursor up ten rows, as ED_KEY_TEN_DOWN the other way (ROW_UP, COL_PLACE_L).","comment":"The cursor off"},
        "1443": {"comment":"E = the remembered column"},
        "1444": {"comment":"Ten rows"},
        "1446": {"synopsis":"One row up."},
        "1447": {"comment":"One row up"},
        "1451": {"comment":"Not moved: only shown"},
        "1453": {"comment":"A = the remembered column"},
        "1454": {"comment":"The cursor stored"},
        "1457": {"comment":"B = the remembered column"},
        "1458": {"comment":"Placed in the row's text"},
        "1461": {"comment":"No text?"},
        "1463": {"comment":"Ten rows yet?"},
        "1466": {"comment":"A = the remembered column"},
        "1467": {"comment":"The cursor stored"},
        "1469": {"synopsis":"A row without text: back down one row, to the start of its text (TEXT_AT_OR_RIGHT from\ncolumn 0)."},
        "1470": {"comment":"One row back down"},
        "1473": {"comment":"From column 0"},
        "1475": {"comment":"To the start of the text"},
        "1479": {"comment":"The cursor stored"},
        "1482": {"synopsis":"Key $00: the cursor to the end of its line's text (TO_LINE_END); that column becomes the\nremembered one (CURSOR_PUT); without a move, only shown.","comment":"The cursor off"},
        "1485": {"comment":"To the end of the line's text"},
        "1488": {"comment":"Not moved: only shown"},
        "1491": {"comment":"A = the column, now remembered"},
        "1492": {"comment":"The cursor stored"},
        "1495": {"synopsis":"Key $1D: the cursor to the start of its line's text (TO_LINE_START); that column becomes the\nremembered one.","comment":"The cursor off"},
        "1498": {"comment":"To the start of the line's text"},
        "1501": {"comment":"Not moved: only shown"},
        "1504": {"comment":"A = the column, now remembered"},
        "1505": {"comment":"The cursor stored"},
        "1508": {"synopsis":"Key $0B: the cursor up one row (ROW_UP), as near the remembered column as the row's text\nallows (COL_PLACE_L); on a row without text, back down a row to the start of its text\n(COL_PLACE_R from column 0). Then CURSOR_PUT; no move: only shown.","comment":"The cursor off"},
        "1511": {"comment":"E = the remembered column"},
        "1512": {"comment":"Kept"},
