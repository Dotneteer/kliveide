        "7539": {"comment":"Less 100"},
        "7545": {"comment":"BC = the rounds"},
        "7547": {"comment":"HL back"},
        "7548": {"synopsis":"One round.","comment":"One round less"},
        "7551": {"comment":"More?"},
        "7553": {"comment":"One unit less"},
        "7556": {"comment":"More units?"},
        "7559": {"synopsis":"The shortest current length among the strings that have not ended, into IY + 38.","comment":"DE = the shortest so far: $FFFF"},
        "7562": {"comment":"The list of length pointers; string 0's bit"},
        "7565": {"synopsis":"The next string.","comment":"Has this string ended?"},
        "7568": {"comment":"Yes: the next"},
        "7570": {"comment":"DE kept"},
