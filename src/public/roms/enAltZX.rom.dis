        "8352": {"comment":"Printed"},
        "8355": {"comment":"Next"},
        "8357": {"comment":"On"},
        "8359": {"synopsis":"The long name from $D827 (NextZXOS ROM 1's PRINT_MSG).","comment":"HL = the long name"},
        "8362": {"comment":"Printed (NextZXOS ROM 1's PRINT_MSG)"},
        "8377": {"synopsis":"TAB 25, then the attributes as text (ROM 0's MAKE_ATTR_TEXT); with EXP: they, the date and\ntime, and the size in bytes (or nothing for a directory).","comment":"RAM bank 0"},
        "8380": {"comment":"TAB 25 and a space ($245C)"},
        "8386": {"comment":"RAM bank 7"},
        "8389": {"comment":"HL = the entry"},
        "8390": {"comment":"+ 7: its attribute letters"},
        "8394": {"comment":"The attributes as text at $5B9D; B bit 0: a directory (ROM 0)"},
        "8399": {"comment":"HL = the size's address, kept"},
        "8400": {"comment":"RAM bank 0"},
        "8403": {"comment":"EXP given ($5B66 bit 6)?"},
        "8408": {"comment":"No: the size only"},
        "8410": {"comment":"The attributes kept"},
        "8411": {"comment":"8 characters"},
        "8414": {"comment":"The attributes at DE printed (ROM 3's PRINT_STRING)"},
        "8417": {"comment":"DE = the time"},
        "8421": {"comment":"BC = the date"},
        "8425": {"comment":"Printed (NextZXOS ROM 1's PRINT_DATE_TIME)"},
        "8440": {"comment":"A space"},
        "8445": {"comment":"A = the attributes"},
        "8446": {"comment":"A directory?"},
        "8447": {"comment":"Yes: no size"},
        "8449": {"comment":"The size in bytes (ROM 0's PRINT_FILE_SIZE)"},
        "8454": {"comment":"On"},
