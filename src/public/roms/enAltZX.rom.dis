        "2292": {"synopsis":"ROWS_READ_CHAR's table for TABLE_DISPATCH: for each state its number and routine: 2\nROWS_SCREEN_CHAR, 4 ROWS_BELOW_CHAR, 1 ROWS_ABOVE_CHAR; $FF ends it."},
        "2302": {"synopsis":"State 1: the next character from row C of the rows kept above the window ($0E5E). Past their\nlast row ($CE73), state 2 from row 0.\nExit: A = the character, L = the state.","comment":"DE = row C above the window"},
