        "7258": {"comment":"The next chip, $FE then $FF"},
        "7259": {"comment":"Until past $FF"},
        "7262": {"synopsis":"Silences every AY chip (mixer $FF, volumes A-C 0, through AY_WRITE_ALL); IY back to $5C3A.\nNo MIDI is sent.","comment":"Register 7: every channel off"},
        "7266": {"comment":"On all three chips"},
        "7269": {"comment":"Registers 8-10: volume 0"},
        "7284": {"comment":"IY back to $5C3A"},
