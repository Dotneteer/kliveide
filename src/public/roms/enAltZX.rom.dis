        "3281": {"comment":"HL = the line before it"},
        "3284": {"comment":"None?"},
        "3286": {"comment":"Then the line last taken"},
        "3289": {"synopsis":"No line before: $D74C kept."},
        "3291": {"synopsis":"A line's first row (bit 0) empties the buffer.","comment":"The line's first row?"},
        "3293": {"comment":"HL = the count of rows below"},
        "3296": {"comment":"Kept"},
