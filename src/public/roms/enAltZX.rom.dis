        "7408": {"comment":"Interrupts on"},
        "7409": {"comment":"Error code $26, report k"},
        "7426": {"synopsis":"Error code $1F, report d (too many brackets).","comment":"The AY silenced"},
        "7429": {"comment":"Interrupts on"},
        "7430": {"comment":"Error code $1F, report d"},
        "7447": {"synopsis":"Error code $28, report m (note out of range).","comment":"The AY silenced"},
        "7450": {"comment":"Interrupts on"},
        "7451": {"comment":"Error code $28, report m"},
        "7468": {"synopsis":"Error code $2A, report o (too many tied notes).","comment":"The AY silenced"},
        "7471": {"comment":"Interrupts on"},
        "7472": {"comment":"Error code $2A, report o"},
        "7489": {"synopsis":"Starts every string's note that has not ended: its name read (PLAY_NOTE_NAME); not a rest:\nsounded (PLAY_SOUND) and its volume set.","comment":"The list from its start; string 0's bit"},
        "7492": {"synopsis":"The next string.","comment":"Has this string ended?"},
        "7495": {"comment":"Yes: the next"},
        "7497": {"comment":"IX = its block, its AY chip selected"},
        "7500": {"comment":"A = its note"},
        "7503": {"comment":"A rest?"},
        "7505": {"comment":"Yes: nothing to sound"},
        "7507": {"comment":"Its tone set"},
        "7510": {"comment":"A = the AY channel"},
        "7513": {"comment":"Always below 3"},
        "7517": {"comment":"Register 8 + the channel"},
        "7520": {"comment":"= the volume"},
        "7526": {"synopsis":"The next string's bit.","comment":"The next string's bit; Z until past string 8"},
        "7529": {"comment":"More strings"},
        "7532": {"synopsis":"Waits DE units, each the tempo's delay (IY + 40) less 100 rounds.","comment":"HL kept"},
