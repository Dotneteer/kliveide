        "8471": {"comment":"HL = the size in K"},
        "8475": {"comment":"RAM bank 0"},
        "8478": {"comment":"Spaces for leading zeros"},
        "8480": {"comment":"Printed (NextZXOS ROM 1's NUM_OUT_5)"},
        "8495": {"comment":"\"K\""},
        "8500": {"synopsis":"ENTER; the next entry.","comment":"ENTER"},
        "8505": {"comment":"RAM bank 7"},
