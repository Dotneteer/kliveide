        "1541": {"synopsis":"Key $0A: the cursor down one row (ROW_DOWN), as near the remembered column as the row's text\nallows (COL_PLACE_L); on a row without text, back up a row, the column placed (COL_PLACE_R).\nThen CURSOR_PUT; no move: only shown.","comment":"The cursor off"},
        "1544": {"comment":"E = the remembered column"},
        "1545": {"comment":"Kept"},
        "1546": {"comment":"One row down"},
        "1550": {"comment":"Not moved: only shown"},
        "1553": {"comment":"B = the remembered column"},
