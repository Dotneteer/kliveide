        "3946": {"comment":"Before any other digit?"},
        "3948": {"comment":"A digit seen before: '0' kept"},
        "3950": {"comment":"Then a 0 byte"},
        "3953": {"comment":"Leading zero stored as 0"},
        "3955": {"synopsis":"B = 1: zeros from now on are digits."},
        "3957": {"synopsis":"The next place."},
        "3960": {"synopsis":"As NEXT_LINE_START, for the program line before line HL (bank 0 while it looks; no\nEXPAND_INIT here). From PREV_LINE_NUM.\nExit: carry and HL = its number, the expansion set up; no carry when line HL is not found,\nis the first line, or the line before it is numbered 0."},
        "3961": {"comment":"Line HL found? DE = the line before"},
        "3964": {"comment":"Not found: no carry"},
        "3966": {"comment":"HL = the line before"},
        "3967": {"comment":"Numbered 0?"},
        "3971": {"comment":"Line 0: no carry"},
        "3973": {"comment":"None before (HL = 0)?"},
        "3976": {"comment":"There is one: set it up"},
        "3979": {"comment":"No carry"},
        "3980": {"comment":"No carry"},
        "3982": {"synopsis":"HL = the address of the line after the line at HL (its length added to its start + 4), DE =\nthe line at HL.\nChanges: AF."},
        "3983": {"comment":"Past the number"},
        "3985": {"comment":"DE = the line's length"},
        "3988": {"comment":"HL = its text"},
        "3989": {"comment":"Past its text"},
        "3990": {"comment":"DE = the line"},
        "3992": {"synopsis":"Is HL on a line? Carry when the byte there has bits 6 and 7 clear (a line number's high\nbyte, not the end of the program).\nChanges: AF."},
        "3993": {"comment":"Bits 6 and 7 of the number's high byte"},
        "3995": {"comment":"Clear: carry"},
        "3997": {"comment":"Set: no carry"},
        "3999": {"synopsis":"Compares the line number at HL (high byte first) with BC.\nExit: carry and Z when they are equal; no carry and NZ when not. Keeps HL."},
        "4000": {"comment":"The high bytes"},
        "4001": {"comment":"Different: no carry"},
