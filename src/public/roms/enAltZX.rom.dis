        "4503": {"comment":"ROM 1's TAKE_WORD: x"},
        "4518": {"comment":"DE = y"},
        "4519": {"synopsis":"H, L = the tile screen's rows and columns, halved for LoRes.","comment":"Keep the map place"},
        "4521": {"comment":"HL = the tile screen's columns and rows"},
        "4524": {"comment":"Layer 2?"},
