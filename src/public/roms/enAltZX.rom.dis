        "4345": {"comment":"No: 8"},
        "4347": {"comment":"Copy, skipping the transparent colour"},
        "4363": {"synopsis":"The last 8 bytes (all of an 8-pixel row).","comment":"8 bytes"},
        "4379": {"comment":"A = rows left"},
        "4380": {"comment":"DE = the next pixel row"},
        "4381": {"comment":"DE = the next screen line"},
        "4384": {"comment":"More rows?"},
        "4385": {"comment":"More lines?"},
        "4387": {"comment":"HL = the tile's screen place"},
        "4388": {"comment":"Next tile across: size on"},
        "4389": {"comment":"Plus the tile size: the next tile across"},
        "4393": {"comment":"C = the step again"},
        "4394": {"comment":"DE = the next tile's screen address"},
