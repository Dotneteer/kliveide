        "1988": {"comment":"Yes: the line entered"},
        "1990": {"synopsis":"As LEAVE_LAST_ROW, upwards: when the line was edited ($D5B7 bit 3) and row C is its first\nrow (flags bit 0), the line is entered.","comment":"A = $D5B7"},
        "1993": {"comment":"The line changed?"},
