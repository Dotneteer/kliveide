        "4772": {"comment":"A = the bank"},
        "4773": {"comment":"Yes"},
        "4775": {"comment":"Layer 2: $5B7E = the map width"},
        "4779": {"comment":"$5B76 = the map's bank"},
        "4782": {"comment":"$5B82 = the map's offset"},
        "4785": {"comment":"$5C7F bit 7: Layer 2's tiles 16 x 16"},
        "4789": {"comment":"16?"},
        "4793": {"comment":"No: 8 x 8"},
        "4799": {"synopsis":"LoRes's map: width $5B7C, bank $5B74, offset $5B80; $5C7F bit 6 for 16 x 16 tiles.","comment":"LoRes: $5B7C = the map width"},
        "4803": {"comment":"$5B74 = the map's bank"},
