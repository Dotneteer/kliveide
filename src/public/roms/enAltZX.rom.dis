        "1646": {"comment":"The cursor back"},
        "1647": {"comment":"Scrolled: done"},
        "1648": {"comment":"Row 0?"},
        "1650": {"comment":"Then no move"},
        "1651": {"synopsis":"C one row up; carry.","comment":"Up one"},
        "1652": {"comment":"Carry"},
        "1653": {"synopsis":"Done."},
        "1654": {"synopsis":"Moves the cursor's row C down one: a row C with no text is removed instead\n(REMOVE_EMPTY_ROW), the rows below moving up. Otherwise LEAVE_LAST_ROW; with C above the\nbottom limit ($D749), C + 1. Otherwise the rows scroll up (ROWS_SCROLL_UP) and C stays; when\nthat cannot be done, C + 1 unless C is the window's last row ($D74A).\nExit: carry when moved.","comment":"The cursor kept"},
        "1655": {"comment":"DE = row C"},
        "1658": {"comment":"From column 0"},
        "1660": {"comment":"Any text?"},
        "1663": {"comment":"The cursor back"},
        "1664": {"comment":"Text: on"},
        "1666": {"comment":"No text: the row removed instead"},
        "1669": {"synopsis":"Leaving the last row of an edited line enters it first; then C below $D749, or the rows\nscrolled up.","comment":"Leaving the line's last row: entered"},
        "1672": {"comment":"A report: no move"},
        "1674": {"comment":"HL = the limits"},
