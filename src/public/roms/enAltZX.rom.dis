        "4420": {"synopsis":"LoRes: the next tile row down, half the tile size of lines.","comment":"LoRes: half the size lines down"},
        "4421": {"comment":"D + that: the next row of tiles"},
        "4423": {"comment":"Past the top half's end?"},
