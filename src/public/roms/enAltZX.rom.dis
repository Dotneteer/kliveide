        "7307": {"comment":"The place kept"},
        "7313": {"comment":"DE and HL back"},
        "7316": {"synopsis":"The string's place moved past spaces and ENTERs.\nExit: carry at the string's end; A = the character. Keeps BC, DE, HL.","comment":"HL, DE and BC kept"},
