{
  "name": "klive-ide",
  "productName": "Klive IDE",
  "version": "0.64.0",
  "description": "Sinclair Retro computer emulator and IDE for Mac, Windows and Linux",
  "author": {
    "name": "Istvan Novak",
    "email": "dotneteer@hotmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Dotneteer/kliveide.git"
  },
  "keywords": [
    "ZX Spectrum",
    "ZX Spectrum Next",
    "Cambridge Z88",
    "Z80",
    "Z80N",
    "Emulator"
  ],
  "bugs": "https://github.com/Dotneteer/kliveide/issues",
  "homepage": "https://github.com/Dotneteer/kliveide",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev --config build/electron.vite.config.ts",
    "build": "npm run build:app && electron-builder",
    "build:app": "npm run build:check && electron-vite build --config build/electron.vite.config.ts",
    "build:check": "node scripts/kbasic-runtime-index.cjs --check && node scripts/check-types.cjs",
    "kbasic:runtime": "node scripts/kbasic-runtime-index.cjs",
    "kbasic:help": "node scripts/kbasic-help-data.cjs",
    "build:sp48-wasm": "node scripts/build-sp48-wasm.cjs",
    "check:sp48-wasm-size": "node scripts/check-sp48-wasm-size.cjs",
    "build:timex-wasm": "node scripts/build-timex-wasm.cjs",
    "build:sp128-wasm": "node scripts/build-sp128-wasm.cjs",
    "check:sp128-wasm-size": "node scripts/check-sp128-wasm-size.cjs",
    "build:spp3e-wasm": "node scripts/build-spp3e-wasm.cjs",
    "check:spp3e-wasm-size": "node scripts/check-spp3e-wasm-size.cjs",
    "build:zxnext-wasm": "node scripts/build-zxnext-wasm.cjs",
    "check:zxnext-wasm-size": "node scripts/check-zxnext-wasm-size.cjs",
    "build:z88-wasm": "node scripts/build-z88-wasm.cjs",
    "check:z88-wasm-size": "node scripts/check-z88-wasm-size.cjs",
    "build:zx8081-wasm": "node scripts/build-zx8081-wasm.cjs",
    "check:zx8081-wasm-size": "node scripts/check-zx8081-wasm-size.cjs",
    "build:all-wasm": "npm run build:sp48-wasm && npm run build:timex-wasm && npm run build:sp128-wasm && npm run build:spp3e-wasm && npm run build:zxnext-wasm && npm run build:z88-wasm && npm run build:zx8081-wasm",
    "check:wasm-cpu-contract": "node scripts/check-wasm-cpu-contract.cjs",
    "benchmark:spectrum-wasm": "node scripts/benchmark-spectrum-wasm.cjs",
    "benchmark:zxnext-wasm": "node scripts/benchmark-zxnext-wasm.cjs",
    "benchmark:z88-wasm": "node scripts/benchmark-z88-wasm.cjs",
    "benchmark:zx8081-wasm": "node scripts/benchmark-zx8081-wasm.cjs",
    "benchmark:debug-overhead": "node scripts/benchmark-debug-overhead.cjs",
    "benchmark:debug-host-loop": "node scripts/benchmark-debug-host-loop.cjs",
    "test:visual": "node test/harness/zxnext/cli/run.cjs",
    "visual:serve": "node test/harness/zxnext/cli/serve.cjs",
    "test:zxnext-wasm-acceptance": "npm test -- --project e2e-cores test/wasm/zxNext/wasm-next-factory-setup.test.ts test/wasm/zxNext/wasm-next-rollout.test.ts test/wasm/zxNext/wasm-next-public-adapter.test.ts test/wasm/zxNext/wasm-next-debug-step.test.ts test/wasm/zxNext/wasm-next-start-menu.test.ts test/wasm/zxNext/wasm-next-frame-runner.test.ts test/wasm/zxNext/wasm-next-performance-boundary.test.ts",
    "test:zxnext-wasm-matrix": "npm test -- --project e2e-cores test/wasm/zxNext",
    "lint:renderer": "eslint src/renderer --ext .ts,.tsx",
    "build:win": "npm run build:all-wasm && npm run build:app && npm run package:win",
    "package:win": "electron-builder build --win --x64 --publish never",
    "build:mac": "npm run build:all-wasm && npm run build:app && npm run package:mac",
    "package:mac": "electron-builder build --mac --x64 --publish never",
    "build:mac:arm64": "npm run build:all-wasm && npm run build:app && npm run package:mac:arm64",
    "package:mac:arm64": "electron-builder build --mac --arm64 --publish never",
    "build:linux": "npm run build:all-wasm && npm run build:app && npm run package:linux",
    "package:linux": "electron-builder build --linux --x64 --publish never",
    "build:linux:arm64": "npm run build:all-wasm && npm run build:app && npm run package:linux:arm64",
    "package:linux:arm64": "electron-builder build --linux --arm64 --publish never",
    "test:unit": "vitest run --config build/vitest.config.ts --project=node --project=jsdom",
    "test:e2e": "node scripts/run-tests.cjs --e2e",
    "test:all": "node scripts/run-tests.cjs --all",
    "test:perf": "vitest run --config build/vitest.config.ts --project perf",
    "style:baseline": "UPDATE_STYLE_BASELINE=1 vitest run --config build/vitest.config.ts --project=node test/theming/type-scale-contract.test.ts",
    "test": "node scripts/run-tests.cjs",
    "doc:install": "cd docs && npm ci",
    "doc:assets": "node scripts/build-doc-assets.cjs",
    "doc:dev": "npm run doc:assets && cd docs && npm run dev",
    "doc:build": "npm run doc:assets && cd docs && npm run build",
    "doc:check": "npm run doc:check:routes && npm run doc:check:links && npm run doc:check:highlighting",
    "doc:check:routes": "node scripts/check-docs-routes.cjs",
    "doc:check:links": "node scripts/check-docs-links.cjs",
    "doc:check:highlighting": "node scripts/check-docs-highlighting.cjs",
    "doc:serve": "node scripts/serve-docs.cjs",
    "doc:shots": "node scripts/doc-shots/run.cjs",
    "bootstrap:ci": "npm ci",
    "check:lockfile": "rm -rf node_modules && npm ci",
    "fix:lockfile": "rm -rf node_modules && npm install && git diff --stat package-lock.json"
  },
  "engines": {
    "node": "^14.18.0 || >=16.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint-community/regexpp": "^4.10.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inconsolata": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@fontsource/iosevka": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash": "^4.17.25",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.0.8",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "execa": "^10.0.1",
    "expect": "^30.5.2",
    "jsdom": "^30.1.1",
    "lodash": "^4.18.1",
    "monaco-editor": "^0.55.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.105.1",
    "sharp": "^0.35.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "vite": "^6.4.3",
    "vite-electron-plugin": "^0.8.3",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777"
    }
  },
  "overrides": {
    "postcss": "^8.5.26",
    "dompurify": "^3.4.16",
    "sharp": "^0.35.3",
    "tsconfck": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@radix-ui/react-select": "^2.3.7",
    "classnames": "^2.5.1",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "overlayscrollbars-react": "^0.5.6",
    "react-popper": "^2.3.0",
    "react-switch": "^7.1.0",
    "usehooks-ts": "^3.1.1",
    "virtua": "^0.52.10",
    "vite-plugin-copy": "^0.1.6"
  },
  "build": {
    "appId": "dotneteer.kliveide",
    "productName": "Klive IDE",
    "artifactName": "KliveIdeSetup-${version}-${arch}.${ext}",
    "directories": {
      "output": "artifacts/"
    },
    "mac": {
      "target": "pkg",
      "icon": "public/images/klive-logo.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KliveIde-Portable-${version}-${arch}.${ext}",
      "asar": false,
      "icon": "public/images/512x512.png"
    },
    "nsis": {
      "artifactName": "KliveIdeSetup-${version}-${arch}.${ext}",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/images/512x512.png"
    },
    "dmg": {
      "backgroundColor": "#00b4cc",
      "window": {
        "width": 512,
        "height": 380
      }
    },
    "files": [
      "**/*",
      "!.prettierrc",
      "!.prettierrc.yaml",
      "!.vscode",
      "!_input",
      "!CHANGELOG.md",
      "!pages",
      "!public",
      "!release",
      "!src",
      "!test",
      "!docs",
      "!docs/**/*",
      "!tsconfig.tsbuildinfo"
    ],
    "extraResources": [
      {
        "from": "src/public/roms",
        "to": "roms",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/public/keymappings",
        "to": "keymappings",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/public/project-templates",
        "to": "project-templates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/public/images",
        "to": "images",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/emu/machines/zxSpectrum48/wasm/dist",
        "to": "wasm/zxSpectrum48",
        "filter": [
          "**/*.wasm"
        ]
      },
      {
        "from": "src/emu/machines/timex/wasm/dist",
        "to": "wasm/timex",
        "filter": [
          "**/*.wasm"
        ]
      },
      {
        "from": "src/emu/machines/zxSpectrum128/wasm/dist",
        "to": "wasm/zxSpectrum128",
        "filter": [
          "**/*.wasm"
        ]
      },
      {
        "from": "src/emu/machines/zxSpectrumP3e/wasm/dist",
        "to": "wasm/zxSpectrumP3e",
        "filter": [
          "**/*.wasm"
        ]
      },
      {
        "from": "src/emu/machines/zxNext/wasm/dist",
        "to": "wasm/zxNext",
        "filter": [
          "**/*.wasm"
        ]
      },
      {
        "from": "src/emu/machines/z88/wasm/dist",
        "to": "wasm/z88",
        "filter": [
          "**/*.wasm"
        ]
      },
      {
        "from": "src/emu/machines/zx8081/wasm/dist",
        "to": "wasm/zx8081",
        "filter": [
          "**/*.wasm"
        ]
      },
      {
        "from": "build/cli",
        "to": "cli",
        "filter": [
          "klive",
          "klive.cmd"
        ]
      }
    ]
  }
}
