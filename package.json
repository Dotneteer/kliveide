{
  "name": "klive-ide",
  "productName": "Klive IDE",
  "version": "0.58.2",
  "description": "Sinclair Retro computer emulator and IDE for Mac, Windows and Linux",
  "author": {
    "name": "Istvan Novak",
    "email": "dotneteer@hotmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Dotneteer/kliveide.git"
  },
  "keywords": [
    "ZX Spectrum",
    "ZX Spectrum Next",
    "Cambridge Z88",
    "Z80",
    "Z80N",
    "Emulator"
  ],
  "bugs": "https://github.com/Dotneteer/kliveide/issues",
  "homepage": "https://github.com/Dotneteer/kliveide",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --config build/electron.vite.config.ts",
    "build": "tsc && electron-vite build --config build/electron.vite.config.ts && electron-builder",
    "build:check": "tsc",
    "build:sp48-wasm": "node scripts/build-sp48-wasm.cjs",
    "check:sp48-wasm-size": "node scripts/check-sp48-wasm-size.cjs",
    "build:sp128-wasm": "node scripts/build-sp128-wasm.cjs",
    "check:sp128-wasm-size": "node scripts/check-sp128-wasm-size.cjs",
    "build:spp3e-wasm": "node scripts/build-spp3e-wasm.cjs",
    "check:spp3e-wasm-size": "node scripts/check-spp3e-wasm-size.cjs",
    "build:zxnext-wasm": "node scripts/build-zxnext-wasm.cjs",
    "check:zxnext-wasm-size": "node scripts/check-zxnext-wasm-size.cjs",
    "build:all-wasm": "npm run build:sp48-wasm && npm run build:sp128-wasm && npm run build:spp3e-wasm && npm run build:zxnext-wasm",
    "check:wasm-cpu-contract": "node scripts/check-wasm-cpu-contract.cjs",
    "benchmark:spectrum-wasm": "node scripts/benchmark-spectrum-wasm.cjs",
    "benchmark:zxnext-wasm": "node scripts/benchmark-zxnext-wasm.cjs",
    "diff:zxnext-machine": "node scripts/run-zxnext-frame-diff.cjs",
    "test:zxnext-wasm-acceptance": "npm test -- --project jsdom test/zxnext/ZxNextMachineFactory.test.ts test/wasm/zxNext/wasm-next-rollout.test.ts test/wasm/zxNext/wasm-next-public-adapter.test.ts test/wasm/zxNext/wasm-next-debug-step.test.ts test/wasm/zxNext/wasm-next-start-menu.test.ts test/wasm/zxNext/wasm-next-frame-runner.test.ts test/wasm/zxNext/wasm-next-performance-boundary.test.ts",
    "test:zxnext-wasm-matrix": "npm test -- --project jsdom test/wasm/zxNext",
    "lint:renderer": "eslint src/renderer --ext .ts,.tsx",
    "e2e:app": "node scripts/run-e2e-app.cjs",
    "build:e2e": "npm run build:all-wasm && electron-vite build --config build/electron.vite.config.ts",
    "build:win": "npm run build:all-wasm && npm run build && electron-builder build --win --x64",
    "build:mac": "npm run build:all-wasm && npm run build && electron-builder build --mac --x64",
    "build:mac:arm64": "npm run build:all-wasm && npm run build && electron-builder build --mac --arm64",
    "build:linux": "npm run build:all-wasm && npm run build && electron-builder build --linux --x64",
    "build:linux:arm64": "npm run build:all-wasm && npm run build && electron-builder build --linux --arm64",
    "test:unit": "vitest run --config build/vitest.config.ts",
    "test:e2e": "npm run build:e2e && playwright test --config playwright.config.ts",
    "test": "npm run test:unit",
    "doc:install": "cd docs && npm ci",
    "doc:assets": "node scripts/build-doc-assets.cjs",
    "doc:dev": "npm run doc:assets && cd docs && npm run dev",
    "doc:build": "npm run doc:assets && cd docs && npm run build",
    "doc:check": "npm run doc:check:routes && npm run doc:check:links && npm run doc:check:highlighting",
    "doc:check:routes": "node scripts/check-docs-routes.cjs",
    "doc:check:links": "node scripts/check-docs-links.cjs",
    "doc:check:highlighting": "node scripts/check-docs-highlighting.cjs",
    "doc:serve": "node scripts/serve-docs.cjs",
    "bootstrap:ci": "npm ci",
    "check:lockfile": "rm -rf node_modules && npm ci",
    "fix:lockfile": "rm -rf node_modules && npm install && git diff --stat package-lock.json"
  },
  "engines": {
    "node": "^14.18.0 || >=16.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint-community/regexpp": "^4.10.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/lodash": "^4.17.25",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.0.8",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "execa": "^10.0.1",
    "expect": "^30.5.0",
    "jsdom": "^30.0.1",
    "lodash": "^4.18.1",
    "monaco-editor": "^0.55.1",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtualized-auto-sizer": "^2.0.3",
    "sass": "^1.103.1",
    "sharp": "^0.35.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-electron-plugin": "^0.8.3",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777"
    }
  },
  "overrides": {
    "postcss": "^8.5.26",
    "dompurify": "^3.4.14",
    "sharp": "^0.35.3",
    "tsconfck": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@radix-ui/react-select": "^2.3.7",
    "classnames": "^2.5.1",
    "electron-updater": "^6.8.9",
    "overlayscrollbars-react": "^0.5.6",
    "react-popper": "^2.3.0",
    "react-switch": "^7.1.0",
    "usehooks-ts": "^3.1.1",
    "virtua": "^0.50.6",
    "vite-plugin-copy": "^0.1.6"
  },
  "build": {
    "appId": "dotneteer.kliveide",
    "productName": "Klive IDE",
    "artifactName": "KliveIdeSetup-${version}-${arch}.${ext}",
    "directories": {
      "output": "artifacts/"
    },
    "mac": {
      "target": "pkg",
      "icon": "public/images/klive-logo.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "asar": false,
      "icon": "public/images/512x512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/images/512x512.png"
    },
    "dmg": {
      "backgroundColor": "#00b4cc",
      "window": {
        "width": 512,
        "height": 380
      }
    },
    "files": [
      "**/*",
      "!.prettierrc",
      "!.prettierrc.yaml",
      "!.vscode",
      "!_input",
      "!CHANGELOG.md",
      "!pages",
      "!public",
      "!release",
      "!src",
      "!test",
      "!docs",
      "!docs/**/*",
      "!tsconfig.tsbuildinfo"
    ],
    "extraResources": [
      {
        "from": "src/public/roms",
        "to": "roms",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/public/keymappings",
        "to": "keymappings",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/public/project-templates",
        "to": "project-templates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/public/images",
        "to": "images",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/emu/machines/zxSpectrum48/wasm/dist",
        "to": "wasm/zxSpectrum48",
        "filter": [
          "**/*.wasm"
        ]
      },
      {
        "from": "src/emu/machines/zxSpectrum128/wasm/dist",
        "to": "wasm/zxSpectrum128",
        "filter": [
          "**/*.wasm"
        ]
      },
      {
        "from": "src/emu/machines/zxSpectrumP3e/wasm/dist",
        "to": "wasm/zxSpectrumP3e",
        "filter": [
          "**/*.wasm"
        ]
      },
      {
        "from": "src/emu/machines/zxNext/wasm/dist",
        "to": "wasm/zxNext",
        "filter": [
          "**/*.wasm"
        ]
      }
    ]
  }
}
