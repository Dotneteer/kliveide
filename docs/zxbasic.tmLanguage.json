{
  "$comment": "Generated by scripts/build-doc-zxbasic-grammar.cjs from the IDE's ZX BASIC word lists. Do not edit.",
  "name": "ZX BASIC",
  "scopeName": "source.zxbasic",
  "patterns": [
    {
      "include": "#asm"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#label"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "asm": {
      "begin": "(?i)(?<![\\w$])(asm)(?![\\w$])",
      "end": "(?i)(?<![\\w$])(end\\s+asm)(?![\\w$])",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.zxbasic"
        }
      },
      "endCaptures": {
        "1": {
          "name": "keyword.control.zxbasic"
        }
      },
      "patterns": [
        {
          "include": "source.z80klive"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.block.zxbasic",
          "begin": "/'",
          "end": "'/"
        },
        {
          "name": "comment.line.quote.zxbasic",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.zxbasic",
          "match": "(?i)(?<![\\w$])REM(?![\\w$]).*$"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.zxbasic",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.zxbasic",
          "match": "\\\\(?:#[0-9]{3}|[ipbf][0-9]|[A-U*`\\\\]|[ .':]{2})"
        }
      ]
    },
    "directive": {
      "name": "keyword.control.directive.zxbasic",
      "match": "(?i)#(?:include|require|warning|define|ifndef|pragma|endif|error|ifdef|undef|else|init|line|if)\\b"
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.zxbasic",
          "match": "(?i)(?:\\$[0-9a-f]+|\\b0x[0-9a-f]+\\b|\\b[0-9][0-9a-f]*h\\b)"
        },
        {
          "name": "constant.numeric.binary.zxbasic",
          "match": "(?i)(?:%[01]+\\b|\\b[01]+b\\b)"
        },
        {
          "name": "constant.numeric.decimal.zxbasic",
          "match": "(?i)(?:\\b[0-9]+\\.?[0-9]*|\\.[0-9]+)(?:e[+-]?[0-9]+)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "storage.type.zxbasic",
          "match": "(?i)(?<![\\w$])(?:UINTEGER|INTEGER|STRING|FIXED|FLOAT|UBYTE|ULONG|BYTE|LONG)(?![\\w$])"
        },
        {
          "name": "keyword.operator.word.zxbasic",
          "match": "(?i)(?<![\\w$])(?:FARPTR|BAND|BNOT|BXOR|AND|BOR|MOD|NOT|SHL|SHR|XOR|OR)(?![\\w$])"
        },
        {
          "name": "support.function.zxbasic",
          "match": "(?i)(?<![\\w$])(?:DZX0SMARTRCSBACK|DZX0STANDARDBACK|GETKEYSCANCODE|DZX0TURBOBACK|DZX0AGILERCS|DZX0MEGABACK|DZX0SMARTRCS|DZX0STANDARD|MEGALZDEPACK|SETCODEBANK|DZX0TURBO|FARCOPYTO|MULTIKEYS|PAINTDATA|PRINTAT42|PRINTAT64|CLEARBOX|DZX0MEGA|FARPEEKW|FARPOKEW|PUTCHARS|FARCOPY|FARPEEK|FARPOKE|GETBANK|HMIRROR|INPUT42|PRINT42|PRINT64|PUTTILE|SCREEN\\$|SETBANK|CSRLIN|FARSTR|GETKEY|INKEY\\$|LBOUND|SIZEOF|UBOUND|HEX16|INKEY|INPUT|PAINT|POINT|RIGHT|ATTR|CAST|CHR\\$|CODE|FCOS|FSIN|FTAN|HEX8|LEFT|PEEK|STR\\$|ABS|ACS|ASC|ASN|ATN|CHR|COS|EXP|HEX|INT|LEN|MID|POS|RND|SGN|SIN|SQR|STR|TAN|USR|VAL|IN|LN|PI)(?![\\w$])"
        },
        {
          "name": "keyword.control.zxbasic",
          "match": "(?i)(?<![\\w$])(?:RANDOMIZE|CODEBANK|CONTINUE|FASTCALL|FUNCTION|DECLARE|INVERSE|RESTORE|STDCALL|BORDER|BRIGHT|CIRCLE|ELSEIF|ITALIC|RETURN|VERIFY|BYREF|BYVAL|CONST|ENDIF|ERROR|FLASH|GOSUB|PAPER|PAUSE|PRINT|UNTIL|WHILE|BEEP|BOLD|DATA|DRAW|ELSE|EXIT|GOTO|LOAD|LOOP|NEXT|OVER|PLOT|POKE|READ|SAVE|STEP|STOP|THEN|WEND|ASM|BIN|CLS|DIM|END|FOR|INK|LET|OUT|REM|SUB|TAB|AS|AT|DO|GO|IF|ON|TO)(?![\\w$])"
        }
      ]
    },
    "label": {
      "patterns": [
        {
          "name": "entity.name.label.zxbasic",
          "match": "^\\s*[A-Za-z_][A-Za-z0-9_]*:(?!=)"
        },
        {
          "name": "constant.numeric.line.zxbasic",
          "match": "^\\s*[0-9]+(?=\\s)"
        }
      ]
    },
    "operator": {
      "name": "keyword.operator.zxbasic",
      "match": "<>|<=|>=|<<|>>|[-+*/^=<>&|~!@]"
    }
  }
}
