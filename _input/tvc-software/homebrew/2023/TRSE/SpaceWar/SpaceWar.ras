program SpaceWar;
/*==================================================================
This tutorial presents the TVC unit by a game demo.

The TVC unit uses the VIDEOTON TV-Computer system ROM routines 
and some helper functions coded in Assembly.
TVC unit procedure and function names mostly use Turbo Pascal names.

Author:  Bery (Zsolt Bertók)
Version: March 5, 2023.
==================================================================*/
@use "tvc"
@use "compression"

@export "resources/images/SpaceWar.flf" "resources/images/SpaceWar.bin" 256 // create compressed title image from SpaceWar.flf picture

var	
	TitleSreenImage : incbin("resources/images/SpaceWar.bin") compressed; // compressed title image
	// Consts
	const SCREEN_WIDTH  : byte = 64; // Screen with:        64 bytes
	const SCREEN_HEIGHT : byte = 240;// Screen height:     240 lines
	const CHAR_WIDTH		: byte = 2;	 // One character width:   2 bytes
	const CHAR_HEIGHT   : byte = 10; // One character height: 10 lines
	// Player
	const PLAYER_WIDTH	: byte = 4;  // 4 bytes = 2 characters
	const PLAYER_HEIGHT	: byte = 20; // 20 lines
	const PLAYER_YPOS   : byte = 220;
	const P_EXPLOSION_Y : byte = 23;
	// Characters
	const XWING_TOP_CHAR: byte = 154;
	const XWING_BOT_CHAR: byte = 156;	
	const TIE_TOP_CHAR	: byte = 158;
	const TIE_BOT_CHAR	: byte = 160;
	const EXP1_TOP_CHAR	: byte = 162;
	const Exp1_BOT_CHAR	: byte = 164;	
	const EXP2_TOP_CHAR	: byte = 166;
	const Exp2_BOT_CHAR	: byte = 168;	
	const EXP3_TOP_CHAR	: byte = 170;
	const Exp3_BOT_CHAR	: byte = 172;	
	const EXP_DURATION  : byte = 4;
	const EXP_SOUND     : integer = 1000;
	// Moves
	const MOVE_NONE			: byte = 0;
	const MOVE_LEFT			: byte = 1;
	const MOVE_RIGHT		: byte = 2;
	const MOVE_UP				: byte = 3;
	const MOVE_DOWN			:	byte = 4;
	// Laser
	const LASER_NO 			: byte = 10;
	const LASER_DELAY		: byte = 15;
	const LASER_LENGTH	: byte = 5;
	const RED_LASER_BYTE: byte = 136; // Palette #3 color to first pixel
	const GREEN_LASER_BYTE: byte = 8; // Palette #2 color to first pixel
	// Enemy
	const ENEMY_NO 			: byte = 7;
	const ENEMY_MOVES		: byte = 20;
	const ENEMY_WIDTH		: byte = 4;  // 4 bytes - 2 characters
	const ENEMY_HEIGHT	: byte = 20; // 20 lines
	const ATTACK_DELAY  : integer = 500;
	// Enemy state
	const DESTROYED			: byte = 0;
	const EXPLOSION			: byte = 1;
	const SIDE_MOVE		  : byte = 2;
	const ATTACK		  	: byte = 3;
	const FLY_BACK      : byte = 4;
	// The color indices of the palette
	const COLOR_BLACK   : byte = 0;
	const COLOR_WHITE   : byte = 1;
	const COLOR_GREEN   : byte = 2;
	const COLOR_RED     : byte = 3;
	// Variables
	i, nr, b					  : byte;
