                                   ORG                 6639                          ; A program kezdőcíme
; BASIC Header
                                   DB                  $0F,$0A,$0,$DD                ; "10 PRINT" - basic token
                                   DB                  ' USR'                        ; " USR"
                                   DB                  $96                           ; "("
                                   DB                  '6659'                        ; "6659"
                                   DB                  $95,$FF                       ; ")"
                                   DB                  0,0,0,0,0                     ; 5 db 0, hogy 6659-nél kezdődjön a kód
                                   
;******************************************************************
; 3 channel MUSIC player for VIDEOTON TVC
; (c) 2023 by Szalontai Béla (Fast and Force)
; v1.0 (2023.12.01)
;******************************************************************
                                   JP                  MAIN                          
                                   
;******************************************************************
; INTERRUPT HANDLER 
; Worst Case Execution time: 183 cycle (channel dividers must be different, otherwise 340)
; Interrupt Frequency: ~13950 Hz
; CPU load by IRQ: 82%
;
; EXX D = channel 1 act val
; EXX B = channel 2 act val
; EXX C = channel 3 act val
;
; EXX E = channel 1 act div
; EXX H = channel 2 act div
; EXX L = channel 3 act div
;******************************************************************                                         
               IT_HANDLER          EX                  AF,AF'
               
                                   EXX                                               ; 4+4
                                   OUT                 (7),A                         ; 11  	ack interrupt
; CHANNEL 1                     
                                   DB                  $18                           ; 12 	JR MIH1 (disable channel)
               CH1_ENABLED         DB                  $0F                           ;		or JR MIH00 <= $0F / $00 (enable channel)
                                   DEC                 E                             ; 4	Handle Channel 1    
                                   JR                  NZ,MIH1                       ; 12
                                   DB                  $1E                           ; 7	LD E,n
               CH1_DIVIDER         DB                  $01                           
                                   LD                  A,D                           ; 4	D = channel 1 act val
                                   OR                  A                             ; 4
                                   JR                  NZ,MIH0_1                     ; 12
                                   DB                  $16                           ; 7	ld D,n                           
               CH1_VOLUME          DB                  $00                           
                                   JR                  MIH1                          ; 12
               MIH0_1              LD                  D,0                           ; 7
               
; CHANNEL 2 
               MIH1                DB                  $18                           ; 12 	JR MIH1 (disable channel)
               CH2_ENABLED         DB                  $0F                           ;		or JR MIH00 <= $0F / $00 (enable channel)
                                   DEC                 H                             ; 4	Handle Channel 2
                                   JR                  NZ,MIH2                       ; 12
                                   DB                  $26                           ; 7	LD H,n
               CH2_DIVIDER         DB                  $02                           
                                   LD                  A,B                           ; 4	B = channel 2 act val
                                   OR                  A                             ; 4
                                   JR                  NZ,MIH1_1                     ; 12
                                   DB                  $06                           ; 7 	LD B,n
               CH2_VOLUME          DB                  $00                           
                                   JR                  MIH2                          ; 12
               MIH1_1              LD                  B,0                           ; 7
               
; CHANNEL 3               
               MIH2                DB                  $18                           ; 12 	JR MIH1 (disable channel)
               CH3_ENABLED         DB                  $0F                           ;		or JR MIH00 <= $0F / $00 (enable channel)
                                   DEC                 L                             ; 4	Handle Channel 3
                                   JR                  NZ,MIXER                      ; 12
                                   DB                  $2E                           ; 7	LD L,n                           
               CH3_DIVIDER         DB                  $03                           
                                   LD                  A,C                           ; 4
                                   OR                  A                             ; 4
                                   JR                  NZ,MIH2_1                     ; 12
                                   DB                  $0E                           ; 7	LD C,n
               CH3_VOLUME          DB                  $00                           
                                   JR                  MIXER                         ; 12
               MIH2_1              LD                  C,0                           ; 7
               
               MIXER               LD                  A,D                           ; 4
                                   ADD                 A,B                           ; 4
                                   ADD                 A,C                           ; 4                        
                                   AND                 60                            ; 7		mask
                                   OR                  1                             ; 7		must have in 4 color graphics mode
                                   OUT                 (6),A                         ; 11		write to sound port
                                   
                                   EXX                                               ; 4 + 4
                                   EX                  AF,AF'
                                   
                                   
                                   
                                   
                                   
                                   
                                   
                                   EI                                                ; 4
                                   RET                                               ; 10
                                   
;******************************************************************
; INIT MUSIC MIXER INTERRUPT HANDLER
;******************************************************************
									
               START_MUSIC_MIXER   DI                                                ; IT disabled
                                   LD                  A,10                          ; disable CRTC CURSOR IT
                                   OUT                 (112),A                       
                                   LD                  A,35                          
                                   OUT                 (113),A                       
                                   LD                  A,$F2                         ; Sound IT counter divider LO
                                   OUT                 (4),A                         ; (4096 - 14 = 4084 = $0FF2)
                                   LD                  A,32+$0F                      ; Sound IT enabled, sound is OFF + divider HI
                                   OUT                 (5),A                         ; IT frequency = Fsys / 16 / 14 = ~13950 Hz
                                   LD                  A,195                         ; @038h -> JP 1A06 -> Address of IT_HANDLER
                                   LD                  (56),A                        
                                   LD                  A,$06                         ; can be relocated!
                                   LD                  (57),A                        
                                   LD                  A,$1A                         
                                   LD                  (58),A                        ; set the new IT handler
                                   IN                  A,(91)                        ; reset counter divider
                                   EI                                                ; enable interrupt
                                   RET                                               
                                   
;******************************************************************
; RESTORE INTERRUPT HANDLER
;******************************************************************
               STOP_MUSIC_MIXER    DI                                                
                                   LD                  A,10                          ; restore the original interrupt
                                   OUT                 (112),A                       
                                   LD                  A,3                           
                                   OUT                 (113),A                       ; CURSOR IT enabled
                                   LD                  A,0                           
                                   OUT                 (4),A                         
                                   LD                  A,0                           
                                   OUT                 (5),A                         ; Sound IT disabled, Sound is OFF
                                   LD                  A,245                         
                                   LD                  (56),A                        
                                   LD                  A,62                          
                                   LD                  (57),A                        
                                   LD                  A,112                         
                                   LD                  (58),A                        ; restore old it handler
                                   EI                                                
                                   RET                                               
                                   
;******************************************************************
; Handling volume decay + vibrato
;******************************************************************                                
               SOUND_PLAYER        LD                  HL,CH1_VOLUME                 
                                   LD                  DE,AD1                        
                                   LD                  A,(HL)                        ; check if the channel 1 is finished 
                                   OR                  A                             
                                   JR                  NZ,PV1                        
                                   LD                  A,$0F                         
                                   LD                  (CH1_ENABLED),A               ; disable CH 1
                                   JR                  SP_CH2_1                      
               PV1                 LD                  A,(DE)                        
                                   DB                  $D6                           ; SUB pedal_value                             
               PEDAL_VALUE1        DB                  $04                           
                                   LD                  (DE),A                        
                                   JR                  NZ,SP_CH2_1                   
                                   DEC                 (HL)                          ; duration for ch11 is over lets decrement volume
                                   LD                  A,(CH1_FREQ_MOD)              
                                   XOR                 1                             
                                   LD                  (CH1_FREQ_MOD),A              
                                   JR                  NZ,SP_CH2_0                   
                                   LD                  A,(CH1_DIVIDER)               ; modulation
               VIBRATO_1_INC       DB                  $00                           ; NOP / INC A -> $00 / $3C
                                   LD                  (CH1_DIVIDER),A               
                                   JR                  SP_CH2_1                      
               SP_CH2_0            LD                  A,(CH1_DIVIDER)               ; modulation
               VIBRATO_1_DEC       DB                  $00                           ; NOP / DEC A -> $00 / $3D                             
                                   LD                  (CH1_DIVIDER),A               
               SP_CH2_1            INC                 DE                            
                                   LD                  HL,CH2_VOLUME                 
                                   LD                  A,(HL)                        ; check if the channel 2 is finished 
                                   OR                  A                             
                                   JR                  NZ,PV2                        
                                   LD                  A,$0F                         
                                   LD                  (CH2_ENABLED),A               ; disable CH 2
                                   JR                  SP_CH3_1                      
               PV2                 LD                  A,(DE)                        
                                   DB                  $D6                           ; SUB pedal_value                             
               PEDAL_VALUE2        DB                  $04                           
                                   LD                  (DE),A                        
                                   JR                  NZ,SP_CH3_1                   
                                   DEC                 (HL)                          ; duration for ch2 is over lets decrement volume
                                   LD                  A,(CH2_FREQ_MOD)              
                                   XOR                 1                             
                                   LD                  (CH2_FREQ_MOD),A              
                                   JR                  NZ,SP_CH3_0                   
                                   LD                  A,(CH2_DIVIDER)               ; modulation
               VIBRATO_2_INC       DB                  $00                           ; NOP / INC A -> $00 / $3C                             
                                   LD                  (CH2_DIVIDER),A               
                                   JR                  SP_CH3_1                      
               SP_CH3_0            LD                  A,(CH2_DIVIDER)               ; modulation
               VIBRATO_2_DEC       DB                  $00                           ; NOP / DEC A -> $00 / $3D                             
                                   LD                  (CH2_DIVIDER),A               
               SP_CH3_1            INC                 DE                            
                                   LD                  HL,CH3_VOLUME                 
                                   LD                  A,(HL)                        ; check if the channel 3 is finished 
                                   OR                  A                             
                                   JR                  NZ,PV3                        
                                   LD                  A,$0F                         
                                   LD                  (CH3_ENABLED),A               ; disable CH 3
                                   JR                  SP_END_1                      
               PV3                 LD                  A,(DE)                        
                                   DB                  $D6                           ; SUB pedal_value                             
               PEDAL_VALUE3        DB                  $04                           
                                   LD                  (DE),A                        
                                   JR                  NZ,SP_END_1                   
                                   DEC                 (HL)                          ; duration for ch3 is over lets decrement volume
                                   LD                  A,(CH3_FREQ_MOD)              
                                   XOR                 1                             
                                   LD                  (CH3_FREQ_MOD),A              
                                   JR                  NZ,SP_END_0                   
                                   LD                  A,(CH3_DIVIDER)               ; modulation
               VIBRATO_3_INC       DB                  $00                           ; NOP / INC A -> $00 / $3C                             
                                   LD                  (CH3_DIVIDER),A               
                                   JR                  SP_END_1                      
               SP_END_0            LD                  A,(CH3_DIVIDER)               ; modulation
               VIBRATO_3_DEC       DB                  $00                           ; NOP / DEC A -> $00 / $3D                             
                                   LD                  (CH3_DIVIDER),A               
               SP_END_1            RET                                               
               
;******************************************************************
; MAIN PROGRAM
;******************************************************************
               WAIT_FOR_KEY_PRESS  EI                                                
                                   RST                 $30                           ; waiting for keypress
                                   DB                  $93                           
                                   INC                 C                             
                                   JR                  NZ,WAIT_FOR_KEY_PRESS         
                                   RST                 $30                           ; read character then drop
                                   DB                  $91                           
                                   DI                                                
                                   RET                                               
                                   
               MAIN                DI                                                
                                   EXX                                               
                                   PUSH                HL                            
                                   PUSH                BC                            
                                   PUSH                DE                            
                                   EXX                                               
                                   CALL                GRAPHICS_CONFIG               
                                   CALL                INTRO_PICTURE                 
                                   CALL                WAIT_FOR_KEY_PRESS            
                                   
                                   CALL                CLRSCR                        
                                   CALL                HELP_PICTURE                  
                                   CALL                WAIT_FOR_KEY_PRESS            
                                   
                                   CALL                CLRSCR                        
                                   CALL                MAIN_PICTURE                  
                                   CALL                START_MUSIC_MIXER             ; starts SOUND GENERATOR INTERRUPT
                                   EI                                                
                                   
                                   LD                  A,8                           
                                   LD                  (PEDAL_VALUE1),A              
                                   LD                  (PEDAL_VALUE2),A              
                                   LD                  (PEDAL_VALUE3),A              
                                   
;--------------------------------------------------------------------------------------------------------------------------------------
               RUNLOOP             LD                  A,7                           ; check the ESC button
                                   OUT                 (3),A                         ; select 7th row of keyboard matrix
                                   IN                  A,(88)                        ; read keyboard matrix row
                                   BIT                 3,A                           ; check ESC key is pressed                           
                                   JR                  NZ,KEY_SPACE                  
                                   JP                  VEGE                          
                                   
                                   
               KEY_SPACE           BIT                 5,A                           ; check SPACE key is pressed
                                   JR                  NZ,KEY_CTRL                   
                                   ; handle repeat delay for space key
                                   DI                                                
                                   PUSH                AF                            
                                   LD                  A,(PEDAL_KEY_DELAY)           
                                   DEC                 A                             
                                   LD                  (PEDAL_KEY_DELAY),A           
                                   OR                  A                             
                                   JR                  NZ,KEY_SPACE_END              
                                   LD                  A,120                         
                                   LD                  (PEDAL_KEY_DELAY),A           
                                   CALL                ZENGETO_XOR                   
                                   LD                  A,(PEDAL_VALUE1)              ; toggle pedal
                                   CP                  8                             
                                   JR                  NZ,KEY_SPACE2                 
                                   LD                  A,4                           
               KEY_SPACE1          LD                  (PEDAL_VALUE1),A              
                                   LD                  (PEDAL_VALUE2),A              
                                   LD                  (PEDAL_VALUE3),A              
                                   XOR                 A                             ; end of all sound
                                   LD                  (CH1_VOLUME),A                
                                   LD                  (CH2_VOLUME),A                
                                   LD                  (CH3_VOLUME),A                
                                   EXX                                               
                                   LD                  D,A                           ; CH1_ACT_VAL
                                   LD                  B,A                           ; CH2_ACT_VAL                           
                                   LD                  C,A                           ; CH3_ACT_VAL                           
                                   EXX                                               
                                   INC                 A                             
                                   LD                  (CH1_DIVIDER),A               
                                   INC                 A                             
                                   LD                  (CH2_DIVIDER),A               
                                   INC                 A                             
                                   LD                  (CH3_DIVIDER),A               
                                   JR                  KEY_SPACE_END                 
               KEY_SPACE2          LD                  A,8                           
                                   JR                  KEY_SPACE1                    
               KEY_SPACE_END       POP                 AF                            
                                   EI                                                
                                   JR                  KEY_NEXT0                     
                                   
               KEY_CTRL            BIT                 4,A                           ; check CTRL key is pressed
                                   JR                  NZ,KEY_NEXT0                  
               					   ; on/off vibrato with CTRL key
                                   DI                                                
                                   PUSH                AF                            
                                   LD                  A,(VIBRATO_KEY_DELAY)         
                                   DEC                 A                             
                                   LD                  (VIBRATO_KEY_DELAY),A         
                                   OR                  A                             
                                   JR                  NZ,KEY_CTRL_END               
                                   LD                  A,120                         
                                   LD                  (VIBRATO_KEY_DELAY),A         
                                   CALL                VIBRATO_XOR                   
                                   LD                  A,(VIBRATO_1_INC)             
                                   CP                  $3C                           
                                   JR                  NZ,KEY_CTRL_1                 
                                   LD                  A,$00                         
                                   LD                  (VIBRATO_1_INC),A             
                                   LD                  (VIBRATO_2_INC),A             
                                   LD                  (VIBRATO_3_INC),A             
                                   LD                  (VIBRATO_1_DEC),A             
                                   LD                  (VIBRATO_2_DEC),A             
                                   LD                  (VIBRATO_3_DEC),A             
                                   JR                  KEY_CTRL_END                  
               KEY_CTRL_1          LD                  A,$3C                         
                                   LD                  (VIBRATO_1_INC),A             
                                   LD                  (VIBRATO_2_INC),A             
                                   LD                  (VIBRATO_3_INC),A             
                                   LD                  A,$3D                         
                                   LD                  (VIBRATO_1_DEC),A             
                                   LD                  (VIBRATO_2_DEC),A             
                                   LD                  (VIBRATO_3_DEC),A             
               KEY_CTRL_END        XOR                 A                             ; end of all sound
                                   LD                  (CH1_VOLUME),A                
                                   LD                  (CH2_VOLUME),A                
                                   LD                  (CH3_VOLUME),A                
                                   EXX                                               
                                   LD                  D,A                           ; CH1_ACT_VAL
                                   LD                  B,A                           ; CH2_ACT_VAL                           
                                   LD                  C,A                           ; CH3_ACT_VAL                           
                                   EXX                                               
                                   INC                 A                             
                                   LD                  (CH1_DIVIDER),A               
                                   INC                 A                             
                                   LD                  (CH2_DIVIDER),A               
                                   INC                 A                             
                                   LD                  (CH3_DIVIDER),A               
                                   POP                 AF                            
                                   EI                                                
                                   
               KEY_NEXT0           BIT                 1,A                           ; check 7th row of key matrix since it is already loaded to A register
                                   JR                  NZ,KEY_NEXT1                  
                                   LD                  B,$3C                         ; key: "," - sound: C2
                                   CALL                KEY_HANDLER                   
               KEY_NEXT1           BIT                 2,A                           
                                   JR                  NZ,KEY_NEXT2                  
                                   LD                  B,$35                         ; key: "." - sound: D2       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT2           BIT                 6,A                           
                                   JR                  NZ,KEY_NEXT3                  
                                   LD                  B,$2F                         ; key: "-" - sound: E2       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT3           BIT                 7,A                           
                                   JR                  NZ,KEY_NEXT10                 
                                   LD                  B,$3F                         ; key: "M" - sound: B1       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT10          LD                  A,5                           ; check 5th row of key matrix        
                                   OUT                 (3),A                         
                                   IN                  A,(88)                        
                                   BIT                 2,A                           
                                   JR                  NZ,KEY_NEXT11                 
                                   LD                  B,$38                         ; key: "L" - sound: C#2       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT11          BIT                 6,A                           
                                   JR                  NZ,KEY_NEXT12                 
                                   LD                  B,$32                         ; key: "É" - sound: D#2      
                                   CALL                KEY_HANDLER                   
               KEY_NEXT12          BIT                 7,A                           
                                   JR                  NZ,KEY_NEXT13                 
                                   LD                  B,$43                         ; key: "J" - sound: A#1      
                                   CALL                KEY_HANDLER                   
               KEY_NEXT13          LD                  A,4                           ; check 4th row of key matrix        
                                   OUT                 (3),A                         
                                   IN                  A,(88)                        
                                   BIT                 0,A                           
                                   JR                  NZ,KEY_NEXT14                 
                                   LD                  B,$54                         ; key: "G" - sound: F#1       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT14          BIT                 1,A                           
                                   JR                  NZ,KEY_NEXT15                 
                                   LD                  B,$64                         ; key: "D" - sound: D#1       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT15          BIT                 2,A                           
                                   JR                  NZ,KEY_NEXT16                 
                                   LD                  B,$71                         ; key: "S" - sound: C#1       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT16          BIT                 4,A                           
                                   JR                  NZ,KEY_NEXT17                 
                                   LD                  B,$4B                         ; key: "H" - sound: G#1       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT17          LD                  A,3                           ; check 3rd row of key matrix        
                                   OUT                 (3),A                         
                                   IN                  A,(88)                        
                                   BIT                 1,A                           
                                   JR                  NZ,KEY_NEXT18                 
                                   LD                  B,$16                         ; key: "I" - sound: F3       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT18          BIT                 2,A                           
                                   JR                  NZ,KEY_NEXT19                 
                                   LD                  B,$14                         ; key: "O" - sound: G3       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT19          BIT                 3,A                           
                                   JR                  NZ,KEY_NEXT20                 
                                   LD                  B,$10                         ; key: "Ő" - sound: B3       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT20          BIT                 5,A                           
                                   JR                  NZ,KEY_NEXT21                 
                                   LD                  B,$0F                         ; key: "Ú" - sound: C4       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT21          BIT                 6,A                           
                                   JR                  NZ,KEY_NEXT22                 
                                   LD                  B,$12                         ; key: "P" - sound: A3       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT22          BIT                 7,A                           
                                   JR                  NZ,KEY_NEXT23                 
                                   LD                  B,$18                         ; key: "U" - sound: E3       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT23          LD                  A,2                           ; check 2nd row of key matrix
                                   OUT                 (3),A                         
                                   IN                  A,(88)                        
                                   BIT                 0,A                           
                                   JR                  NZ,KEY_NEXT24                 
                                   LD                  B,$1E                         ; key: "T" - sound: C3       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT24          BIT                 1,A                           
                                   JR                  NZ,KEY_NEXT25                 
                                   LD                  B,$24                         ; key: "E" - sound: A2       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT25          BIT                 2,A                           
                                   JR                  NZ,KEY_NEXT26                 
                                   LD                  B,$28                         ; key: "W" - sound: G2       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT26          BIT                 4,A                           
                                   JR                  NZ,KEY_NEXT27                 
                                   LD                  B,$1B                         ; key: "Z" - sound: D3       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT27          BIT                 6,A                           
                                   JR                  NZ,KEY_NEXT28                 
                                   LD                  B,$2D                         ; key: "Q" - sound: F2       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT28          BIT                 7,A                           
                                   JR                  NZ,KEY_NEXT29                 
                                   LD                  B,$20                         ; key: "R" - sound: B2       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT29          LD                  A,1                           ; check 1st row of key matrix
                                   OUT                 (3),A                         
                                   IN                  A,(88)                        
                                   BIT                 2,A                           
                                   JR                  NZ,KEY_NEXT30                 
                                   LD                  B,$15                         ; key: "9" - sound: F#3       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT30          BIT                 3,A                           
                                   JR                  NZ,KEY_NEXT31                 
                                   LD                  B,$11                         ; key: "Ü" - sound: A#3       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT31          BIT                 6,A                           
                                   JR                  NZ,KEY_NEXT32                 
                                   LD                  B,$13                         ; key: "Ö" - sound: G#3       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT32          BIT                 7,A                           
                                   JR                  NZ,KEY_NEXT33                 
                                   LD                  B,$19                         ; key: "7" - sound: D#3       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT33          LD                  A,0                           ; check 0. row of key matrix
                                   OUT                 (3),A                         
                                   IN                  A,(88)                        
                                   BIT                 1,A                           
                                   JR                  NZ,KEY_NEXT34                 
                                   LD                  B,$26                         ; key: "3" - sound: G#2       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT34          BIT                 2,A                           
                                   JR                  NZ,KEY_NEXT35                 
                                   LD                  B,$2A                         ; key: "2" - sound: F#2       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT35          BIT                 4,A                           
                                   JR                  NZ,KEY_NEXT36                 
                                   LD                  B,$1C                         ; key: "6" - sound: C#3       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT36          BIT                 7,A                           
                                   JR                  NZ,KEY_NEXT4                  
                                   LD                  B,$22                         ; key: "5" - sound: A#2
                                   CALL                KEY_HANDLER                   
               KEY_NEXT4           LD                  A,6                           ; check 6th row of key matrix        
                                   OUT                 (3),A                         
                                   IN                  A,(88)                        
                                   BIT                 0,A                           
                                   JR                  NZ,KEY_NEXT5                  
                                   LD                  B,$50                         ; key: "B" - sound: G1       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT5           BIT                 1,A                           
                                   JR                  NZ,KEY_NEXT6                  
                                   LD                  B,$5F                         ; key: "C" - sound: E1       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT6           BIT                 2,A                           
                                   JR                  NZ,KEY_NEXT7                  
                                   LD                  B,$6A                         ; key: "X" - sound: D1       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT7           BIT                 4,A                           
                                   JR                  NZ,KEY_NEXT8                  
                                   LD                  B,$47                         ; key: "N" - sound: A1       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT8           BIT                 6,A                           
                                   JR                  NZ,KEY_NEXT9                  
                                   LD                  B,$77                         ; key: "Y" - sound: C1       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT9           BIT                 7,A                           
                                   JR                  NZ,KEY_NEXT_END               
                                   LD                  B,$59                         ; key: "V" - sound: F1       
                                   CALL                KEY_HANDLER                   
               KEY_NEXT_END        CALL                SOUND_PLAYER                  ; let the sounds play
                                   JP                  RUNLOOP                       
                                   
                                   
               KEY_HANDLER         PUSH                AF                            
               
               					   ; check whether the current sound is already playing on one of the channels
                                   LD                  A,(CH3_DIVIDER)               ; check ch3                           
                                   CP                  B                             
                                   JR                  Z,KEY_PLAY_CH3                
                                   LD                  A,(CH2_DIVIDER)               ; check ch2
                                   CP                  B                             
                                   JR                  Z,KEY_PLAY_CH2                
                                   LD                  A,(CH1_DIVIDER)               ; check ch1
                                   CP                  B                             
                                   JR                  NZ,KH_NEXT                    
                                   
               KEY_PLAY_CH1        HALT                                              
                                   LD                  A,B                           
                                   LD                  (CH1_DIVIDER),A               
                                   LD                  A,VOL_MIX_CONST               ; ch1 is selected                                                
                                   LD                  (CH1_VOLUME),A                
                                   XOR                 A                             
                                   LD                  (CH1_ENABLED),A               
                                   LD                  (AD1),A                       
                                   JR                  KH_END                        
                                   
               KEY_PLAY_CH2        HALT                                              
                                   LD                  A,B                           
                                   LD                  (CH2_DIVIDER),A               
                                   LD                  A,VOL_MIX_CONST               ; ch2 is selected
                                   LD                  (CH2_VOLUME),A                
                                   XOR                 A                             
                                   LD                  (CH2_ENABLED),A               
                                   LD                  (AD2),A                       
                                   JR                  KH_END                        
                                   
               KEY_PLAY_CH3        HALT                                              
                                   LD                  A,B                           
                                   LD                  (CH3_DIVIDER),A               
                                   LD                  A,VOL_MIX_CONST               ; ch3 is selected
                                   LD                  (CH3_VOLUME),A                
                                   XOR                 A                             
                                   LD                  (CH3_ENABLED),A               
                                   LD                  (AD3),A                       
                                   JR                  KH_END                        
                                   
                          		   ; the sound is not played yet, check which channel is free
               KH_NEXT             LD                  A,(CH1_VOLUME)                ; check if channel 1 is free
                                   OR                  A                             
                                   JR                  Z,KEY_PLAY_CH1                
                                   LD                  A,(CH2_VOLUME)                ; check if channel 2 is free                
                                   OR                  A                             
                                   JR                  Z,KEY_PLAY_CH2                
                                   LD                  A,(CH3_VOLUME)                ; check if channel 3 is free                
                                   OR                  A                             
                                   JR                  Z,KEY_PLAY_CH3                
                                   ; no free channel, check which channel could be used
                                   LD                  A,(CH1_VOLUME)                ; check if the sound is released on ch1
                                   CP                  RELEASE_VOL_CONST             
                                   JR                  C,KEY_PLAY_CH1                ; ch3 can be used
                                   LD                  A,(CH2_VOLUME)                ; check if the sound is released on ch2
                                   CP                  RELEASE_VOL_CONST             
                                   JR                  C,KEY_PLAY_CH2                ; ch2 can be used
                                   LD                  A,(CH3_VOLUME)                ; check if the sound is released on ch3
                                   CP                  RELEASE_VOL_CONST             
                                   JR                  C,KEY_PLAY_CH3                ; ch1 can be used                          
                                   
               KH_END              POP                 AF                            
                                   RET                                               
                                   
                                   
               VEGE                CALL                STOP_MUSIC_MIXER              ; stops SOUND GENERATOR INTERRUPT
                                   LD                  C,1                           ; C = Graphics 4
                                   RST                 $30                           ; $30 system call                              
                                   DB                  $4                            ; set VMODE
                                   XOR                 A                             ; set border color                      
                                   LD                  (2895),A                      
                                   EXX                                               
                                   POP                 DE                            
                                   POP                 BC                            
                                   POP                 HL                            
                                   EXX                                               
                                   
                                   RET                                               
                                   
               VOL_MIX_CONST       EQU                 20                            
               RELEASE_VOL_CONST   EQU                 19                            
               
               PEDAL_KEY_DELAY     DB                  120                           
               
               VIBRATO_KEY_DELAY   DB                  120                           
               
               AD1                 DB                  0                             ; actual duration 1
               AD2                 DB                  0                             ; actual duration 2
               AD3                 DB                  0                             ; actual duration 3
               
               CH1_FREQ_MOD        DB                  1                             ; channel 1 frequency modulation = 1 ON = 0 OFF
               CH2_FREQ_MOD        DB                  1                             ; channel 2 frequency modulation = 1 ON = 0 OFF
               CH3_FREQ_MOD        DB                  1                             ; channel 3 frequency modulation = 1 ON = 0 OFF               
               
;******************************************************************
; Graphics routines
;******************************************************************                                 
               GRAPHICS_CONFIG     LD                  C,1                           ; C = Graphics 4
                                   RST                 $30                           ; $30 system call                              
                                   DB                  $4                            ; set VMODE
                                   LD                  A,12                          ; SET VID MEM START ADDRESS to 0
                                   OUT                 (112),A                       
                                   LD                  A,$00                         
                                   OUT                 (113),A                       
                                   LD                  A,13                          
                                   OUT                 (112),A                       
                                   LD                  A,$00                         
                                   OUT                 (113),A                       
                                   LD                  A,0                           ; set palette BLACK, WHITE, DARK BLUE, RED                           
                                   OUT                 ($60),A                       
                                   LD                  A,85                          
                                   OUT                 ($61),A                       
                                   LD                  A,1                           
                                   OUT                 ($62),A                       
                                   LD                  A,68                          
                                   OUT                 ($63),A                       
                                   LD                  A,170                         ; set border to white
                                   OUT                 (0),A                         
                                   LD                  (2895),A                      
                                   RET                                               
                                   
               INTRO_PICTURE       LD                  A,$50                         ; paging: U0, U1, VID, SYS 
                                   OUT                 ($2),A                        
                                   LD                  HL,INTRO_PICTURE_DATA         
                                   LD                  DE,32768                      ; video ram on page 3
                                   CALL                ZX7_DECOMPRESS                
                                   RET                                               
                                   
               MAIN_PICTURE        LD                  A,$50                         ; paging: U0, U1, VID, SYS 
                                   OUT                 ($2),A                        
                                   LD                  HL,MAIN_PICTURE_DATA          
                                   LD                  DE,32768                      ; video ram on page 3
                                   CALL                ZX7_DECOMPRESS                
                                   RET                                               
                                   
               HELP_PICTURE        LD                  A,$50                         ; paging: U0, U1, VID, SYS 
                                   OUT                 ($2),A                        
                                   LD                  HL,HELP_PICTURE_DATA          
                                   LD                  DE,32768                      ; video ram on page 3
                                   CALL                ZX7_DECOMPRESS                
                                   RET                                               
                                   
               CLRSCR              LD                  A,$50                         ; tricky clear screen (atomization)
                                   OUT                 ($2),A                        
                                   LD                  HL,$7F00                      
                                   LD                  B,$06                         
               CLRSCR0             LD                  (SAVE_BC),BC                  
                                   LD                  (SAVE_HL),HL                  
                                   LD                  B,$3C                         
               CLRSCR1             LD                  C,B                           
                                   LD                  B,$41                         
               CLRSCR2             LD                  (HL),$F0                      
                                   INC                 HL                            
                                   INC                 HL                            
                                   INC                 HL                            
                                   DJNZ                CLRSCR2                       
                                   LD                  DE,$00C0                      
                                   ADD                 HL,DE                         
                                   LD                  B,C                           
                                   DJNZ                CLRSCR1                       
                                   LD                  HL,(SAVE_HL)                  
                                   LD                  DE,$0041                      
                                   ADD                 HL,DE                         
                                   LD                  BC,(SAVE_BC)                  
                                   DJNZ                CLRSCR0                       
                                   RET                                               
                                   
               ZENGETO_XOR         LD                  HL,46303                      ; start address @ video ram                
                                   LD                  DE,64-31                      ; columns x 64                
                                   LD                  C,12                          ; rows                
               ZX0                 LD                  B,31                          ; columns                
               ZX1                 LD                  A,(HL)                        
                                   XOR                 $FF                           
                                   LD                  (HL),A                        
                                   INC                 HL                            
                                   DJNZ                ZX1                           
                                   ADD                 HL,DE                         
                                   DEC                 C                             
                                   LD                  A,C                           
                                   OR                  A                             
                                   JR                  NZ,ZX0                        
                                   RET                                               
                                   
               VIBRATO_XOR         LD                  HL,46274                      
                                   LD                  DE,64-28                      
                                   LD                  C,12                          
               ZX00                LD                  B,28                          
               ZX01                LD                  A,(HL)                        
                                   XOR                 $FF                           
                                   LD                  (HL),A                        
                                   INC                 HL                            
                                   DJNZ                ZX01                          
                                   ADD                 HL,DE                         
                                   DEC                 C                             
                                   LD                  A,C                           
                                   OR                  A                             
                                   JR                  NZ,ZX00                       
                                   RET                                               
                                   
               SAVE_BC             DW                  0                             
               SAVE_HL             DW                  0                             
               
 ;******************************************************************
 ; ZX7_DECOMPRESS
 ; ZX7 tömörítés kitömörítő rutinja
 ; paraméter: HL -> ZX7 tömörített adat; DE -> kitömörített adat címe

               ZX7_DECOMPRESS      NOP                                               
               DZX7STANDARD        LD                  A,$80                         
               COPYBYTELOOPEV      LDI                                               ; copy literal byte
               MAINLOOPEV          ADD                 A,A                           ; check next bit
                                   JR                  Z,LOADBITS1                   ; no more bits left?
                                   JR                  C,LENSIZESTARTOD              ; next bit indicates either literal or sequence
                                   
               COPYBYTELOOPOD      LDI                                               ; copy literal byte
               MAINLOOPOD          ADD                 A,A                           ; check next bit
                                   JR                  NC,COPYBYTELOOPEV             ; next bit indicates either literal or sequence
                              ; determine number of bits used for length (Elias gamma coding)
               LENSIZESTARTEV      PUSH                DE                            
                                   LD                  BC,1                          
                                   LD                  D,B                           
               LENSIZELOOPEV       INC                 D                             
                                   ADD                 A,A                           ; check next bit
                                   JR                  Z,LOADBITS2EV                 ; no more bits left?
                                   JR                  NC,LENSIZELOOPEV              
                                   JP                  LENVALUESTARTEV               
                              ; determine number of bits used for length (Elias gamma coding)
               LENSIZESTARTOD      PUSH                DE                            
                                   LD                  BC,1                          
                                   LD                  D,B                           
               LENSIZELOOPOD       INC                 D                             
                                   ADD                 A,A                           ; check next bit
                                   JR                  Z,LOADBITS2OD                 ; no more bits left?
                                   JR                  NC,LENSIZELOOPOD              
                                   JP                  LENVALUESTARTOD               
                              ; determine length
               LENVALUELOOPEV      ADD                 A,A                           ; check next bit
                                   JR                  Z,LOADBITS3EV                 ; no more bits left?
                                   RL                  C                             
                                   RL                  B                             
                                   JR                  C,EXITEV                      ; check end marker
               LENVALUESTARTEV     DEC                 D                             
                                   JR                  NZ,LENVALUELOOPEV             
                                   INC                 BC                            ; adjust length
                              ; determine offset
               OFFSETSTARTOD       LD                  E,(HL)                        ; load offset flag (1 bit) + offset value (7 bits)
                                   INC                 HL                            
                                   SLL                 E                             ; opcode for undocumented instruction "SLL E" aka "SLS E"
                                   JR                  NC,OFFSETENDOD                ; if offset flag is set,load 4 extra bits
                                   ADD                 A,A                           ; check next bit
                                   RL                  D                             ; insert first bit into D
                                   ADD                 A,A                           ; check next bit
                                   JR                  Z,LOADBITS4                   ; no more bits left?
                                   RL                  D                             ; insert second bit into D
                                   ADD                 A,A                           ; check next bit
                                   RL                  D                             ; insert third bit into D
                                   ADD                 A,A                           ; check next bit
                                   JR                  Z,LOADBITS5                   ; no more bits left?
                                   CCF                                               
                                   JR                  C,OFFSETENDOD                 
               OFFSETINCOD         INC                 D                             ; equivalent to adding 128 to DE
               OFFSETENDOD         RR                  E                             ; insert inverted fourth bit into E
                              ; copy previous sequence
                                   EX                  (SP),HL                       ; store source,restore destination
                                   PUSH                HL                            ; store destination
                                   SBC                 HL,DE                         ; HL = destination - offset - 1
                                   POP                 DE                            ; DE = destination
                                   LDIR                                              
                                   POP                 HL                            ; restore source address (compressed data)
                                   JP                  MAINLOOPOD                    
                                   
               LOADBITS1           LD                  A,(HL)                        ; load another group of 8 bits
                                   INC                 HL                            
                                   RLA                                               
                                   JR                  C,LENSIZESTARTOD              ; next bit indicates either literal or sequence
                                   JP                  COPYBYTELOOPOD                
                                   
               LOADBITS2EV         LD                  A,(HL)                        ; load another group of 8 bits
                                   INC                 HL                            
                                   RLA                                               
                                   JR                  NC,LENSIZELOOPEV              
                                   JP                  LENVALUESTARTEV               
                                   
               LOADBITS2OD         LD                  A,(HL)                        ; load another group of 8 bits
                                   INC                 HL                            
                                   RLA                                               
                                   JR                  NC,LENSIZELOOPOD              
                                   JP                  LENVALUESTARTOD               
                                   
               LOADBITS3EV         LD                  A,(HL)                        ; load another group of 8 bits
                                   INC                 HL                            
                                   RLA                                               
                                   RL                  C                             
                                   RL                  B                             
                                   JP                  NC,LENVALUESTARTEV            ; check end marker
               EXITEV              POP                 DE                            
                                   RET                                               
                                   
               LOADBITS4           LD                  A,(HL)                        ; load another group of 8 bits
                                   INC                 HL                            
                                   RLA                                               
                                   RL                  D                             ; insert second bit into D
                                   ADD                 A,A                           ; check next bit
                                   RL                  D                             ; insert third bit into D
                                   ADD                 A,A                           ; check next bit
                                   CCF                                               
                                   JR                  C,OFFSETENDOD                 
                                   JP                  OFFSETINCOD                   
                                   
               LOADBITS5           LD                  A,(HL)                        ; load another group of 8 bits
                                   INC                 HL                            
                                   RLA                                               
                                   CCF                                               
                                   JR                  C,OFFSETENDOD                 
                                   JP                  OFFSETINCOD                   
                              ; determine length
               LENVALUELOOPOD      ADD                 A,A                           ; check next bit
                                   JR                  Z,LOADBITS3OD                 ; no more bits left?
                                   RL                  C                             
                                   RL                  B                             
                                   JR                  C,EXITOD                      ; check end marker
               LENVALUESTARTOD     DEC                 D                             
                                   JR                  NZ,LENVALUELOOPOD             
                                   INC                 BC                            ; adjust length                              
                              ; determine offset
               OFFSETSTARTEV       LD                  E,(HL)                        ; load offset flag (1 bit) + offset value (7 bits)
                                   INC                 HL                            
                                   SLL                 E                             ; opcode for undocumented instruction "SLL E" aka "SLS E"
                                   JR                  NC,OFFSETENDEV                ; if offset flag is set,load 4 extra bits
                                   ADD                 A,A                           ; check next bit
                                   JR                  Z,LOADBITS6                   ; no more bits left?
                                   RL                  D                             ; insert first bit into D
                                   ADD                 A,A                           ; check next bit
                                   RL                  D                             ; insert second bit into D
                                   ADD                 A,A                           ; check next bit
                                   JR                  Z,LOADBITS7                   ; no more bits left?
                                   RL                  D                             ; insert third bit into D
                                   ADD                 A,A                           ; check next bit
                                   CCF                                               
                                   JR                  C,OFFSETENDEV                 
               OFFSETINCEV         INC                 D                             ; equivalent to adding 128 to DE
               OFFSETENDEV         RR                  E                             ; insert inverted fourth bit into E
                              ; copy previous sequence
                                   EX                  (SP),HL                       ; store source,restore destination
                                   PUSH                HL                            ; store destination
                                   SBC                 HL,DE                         ; HL = destination - offset - 1
                                   POP                 DE                            ; DE = destination
                                   LDIR                                              
                                   POP                 HL                            ; restore source address (compressed data)
                                   JP                  MAINLOOPEV                    
                                   
               LOADBITS3OD         LD                  A,(HL)                        ; load another group of 8 bits
                                   INC                 HL                            
                                   RLA                                               
                                   RL                  C                             
                                   RL                  B                             
                                   JP                  NC,LENVALUESTARTOD            ; check end marker
               EXITOD              POP                 DE                            
                                   RET                                               
                                   
               LOADBITS6           LD                  A,(HL)                        ; load another group of 8 bits
                                   INC                 HL                            
                                   RLA                                               
                                   RL                  D                             ; insert first bit into D
                                   ADD                 A,A                           ; check next bit
                                   RL                  D                             ; insert second bit into D
                                   ADD                 A,A                           ; check next bit
                                   RL                  D                             ; insert third bit into D
                                   ADD                 A,A                           ; check next bit
                                   CCF                                               
                                   JR                  C,OFFSETENDEV                 
                                   JP                  OFFSETINCEV                   
                                   
               LOADBITS7           LD                  A,(HL)                        ; load another group of 8 bits
                                   INC                 HL                            
                                   RLA                                               
                                   RL                  D                             ; insert third bit into D
                                   ADD                 A,A                           ; check next bit
                                   CCF                                               
                                   JR                  C,OFFSETENDEV                 
                                   JP                  OFFSETINCEV                   
                                   RET                                               
                                   
