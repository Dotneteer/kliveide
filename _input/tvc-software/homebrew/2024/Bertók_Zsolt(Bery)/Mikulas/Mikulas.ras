// zene lejátszó eljárás
procedure PlayMusic(); 
begin
	MusicPlayChannel1 := not MusicPlayChannel1; // ez mutatja, hogy az 1. vagy a 2. szólamot kell-e lejátszani éppen
	Dec(MusicDuration); // hang megszólalási hosszának csökkentése
	if (MusicDuration = 0) then // Ha nulla, akkor jön a következő hang lejátszása
	begin
		// a következő hang lejátszása
		MusicPitch := MusicChannel1[MusicPos]; // a zene következő hangja
		MusicDuration := MUSIC_DURATION; // az aktuális hang lejátszási hosszának beállítása
		GE::Sound(MusicPitch); // a hang megszólaltatása
		inc (MusicPos); // MusicPOs a következő hangra mutat
		if (MusicChannel1[MusicPos] = 9999) then // a zene vége
			MusicPos := 0; // kezdjük elölről
	end
	else // ha még nem nulla a MusicDuration, azaz tovább szól az aktuális hang
	begin		
		if MusicPlayChannel1 then
		begin
			MusicPitch := MusicChannel1[MusicPos]; 		// az 1. csatorna aktuális hangja
			if (MusicPitch <> GE::SILENT_SOUND) then 	// ha nem szünet van éppen az 1. csatornán
				GE::Sound(MusicPitch)										// az 1. csatorna aktuális hangjának megszólaltatása
			else
			  GE::Sound(MusicChannel2[MusicPos])			// ha a 1. csatornán éppen nincs hang, akkor az 2. csatorna hangjának megszólaltatása
		end
		else
		begin
			MusicPitch := MusicChannel2[MusicPos]; 		// a 2. csatorna aktuális hangja
			if (MusicPitch <> GE::SILENT_SOUND) then 	// ha nem szünet van éppen a 2. csatornán
				GE::Sound(MusicPitch)										// az 2. csatorna aktuális hangjának megszólaltatása
			else
			  GE::Sound(MusicChannel1[MusicPos])			// ha a 2. csatornán éppen nincs hang, akkor az 1. csatorna hangjának megszólaltatása
		end;
	end;
end; /* PlayMusic */
																							
  
begin	
	GE::Init(GE::DIRECT_TO_SCREEN);
	GE::SetMemory(GE::MEM_VID_ON);	
	GE::SetRasterInterruptPos(239);	 				// raszter-megszakítás pozíciójának beállítása    
	GE::SetGraphics(GE::GRAPHICS4);
	GE::InitCharSet(#CharSet, 206, 2, 10); 	// A karakterkészlet inicializállása.
	GE::SetGraphMode(GE::GRAPHICS16);		
	GE::ZX7Decompress(#SantaZX7, GE::SCREEN_ADDR+14*GE::SCREEN_WIDTH);
	GE::SetPalette(1, GE::PALETTE_WHITE);
	LetterPtr := #ScrollText;
  // Zene inicializálása
  MusicPos := 0;
  MusicDuration := 1;
  MusicPlayChannel1 := False;
  GE::SoundOff();
  GE::Volume(GE::MAX_VOLUME); // hangerő beállítása    
  
  
  while (not GE::KeyPressed) do
   GE::GetKeyboard();
  
  
  // Főciklus
  while (true) do
  begin
	  GE::WaitForSync();
	  GE::SetGraphMode(GE::GRAPHICS4);
	  GE::SetRasterInterruptPos(12);	// raszter-megszakítás pozíciójának beállítása
	  // Szöveg terület Scrollozása
	  GE::MemCopy(GE::SCREEN_ADDR+1, GE::SCREEN_ADDR, 10*GE::SCREEN_WIDTH);	    	  
	  // Kép rész és zene
	  GE::WaitForSync();
	  GE::SetGraphMode(GE::GRAPHICS16);		
	  GE::SetRasterInterruptPos(239);	// raszter-megszakítás pozíciójának beállítása    	  
	  PlayMusic();	  
	  Inc(FrameCount);
	  // Új betű kiíírás	  
	  if FrameCount = 2 then // minden páratlan ciklusban, addigra 1 betűnyit scrollodott a szöveg
	  begin
		  FrameCount := 0;
		  Letter[0] := LetterPtr[0];
		  GE::WriteText(62, 0, #Letter);
		  Inc (LetterPtr);
	    Inc (TextIndex);	    
	    if (TextIndex >= TEXT_LENGTH) then
	    begin
	    	LetterPtr := #ScrollText;
	    	TextIndex := 0;
	    end;
	  end
	  else
	  begin
		  if (FrameCount = 1) then
		    GE::FillRect(63, 0, 1, 10, 0); // az elscrollozott fél betű letörlése
	  end;
  end;
end.