program TestLine;
/*==============================================================================
   TVC LINE & GRAPHICS BENCHMARK & TEST PROGRAM
   Graphics 4 (256x240, 4 szín) Teljesítmény- és Alakzatteszt
   
   Minden algoritmusváltozatot külön tesztel és méri a futásidőt
   a TVC hardveres 50 Hz-es rendszertimerével ($0B1D: 20 ms / tick).
==============================================================================*/

@use "TVCGraph4"

var
	// Időmérő és teszt változók
	t_start, t_end, t_diff : integer;
	i, j, k                : integer;
	test_num               : byte;
	col                    : byte;
	score_y                : integer;

	// Eredmény tárolók (tick-ekben: 1 tick = 20 ms)
	res_hline              : integer;
	res_vline              : integer;
	res_line               : integer;
	res_rect               : integer;
	res_fillrect           : integer;
	res_circle             : integer;
	res_fillcircle         : integer;
	res_triangle           : integer;
	res_filltriangle       : integer;
	res_cls                : integer;

	// Jól olvasható, teljesen arányos 4x8-as karakterkészlet (112 bájt)
	font_data : array[112] of byte = (
		// 0:
		$06, $09, $09, $09, $09, $09, $09, $06,
		// 1:
		$02, $06, $02, $02, $02, $02, $02, $07,
		// 2:
		$06, $09, $01, $01, $02, $04, $08, $0F,
		// 3:
		$0E, $01, $01, $06, $06, $01, $01, $0E,
		// 4:
		$09, $09, $09, $0F, $01, $01, $01, $01,
		// 5:
		$0F, $08, $08, $0E, $01, $01, $09, $06,
		// 6:
		$06, $08, $08, $0E, $09, $09, $09, $06,
		// 7:
		$0F, $01, $01, $02, $02, $04, $04, $04,
		// 8:
		$06, $09, $09, $06, $09, $09, $09, $06,
		// 9:
		$06, $09, $09, $07, $01, $01, $01, $06,
		// 10: ':' (Kettőspont)
		$00, $06, $06, $00, $00, $06, $06, $00,
		// 11: 'T' (Tick)
		$0F, $06, $02, $02, $02, $02, $02, $02,
		// 12: 'M' (Milli)
		$09, $0F, $0F, $09, $09, $09, $09, $09,
		// 13: 'S' (Sec)
		$07, $08, $08, $06, $01, $01, $01, $0E
	);


/*==============================================================================
	SEGÉDFÜGGVÉNYEK: IDŐMÉRÉS ÉS KIÍRÁS
==============================================================================*/

// 16-bites hardveres timer lekérése a $0B1D címről
function GetTimer() : integer;
begin
	Asm("
		ld   HL,($0B1D)
	");
end;

// 4x8-as karakter kirajzolása (px, py) pozícióra
procedure DrawChar(px, py : integer; char_idx, color : byte);
var
	row, b : byte;
	c_offset : integer;
begin
	if (char_idx > 13) then return;
	c_offset := char_idx * 8;
	fori row := 0 to 7 do
	begin
		b := font_data[c_offset + row];
		if ((b & $08) <> 0) then TVCGraph4::PlotDirect(px + 0, py + row, color);
		if ((b & $04) <> 0) then TVCGraph4::PlotDirect(px + 1, py + row, color);
		if ((b & $02) <> 0) then TVCGraph4::PlotDirect(px + 2, py + row, color);
		if ((b & $01) <> 0) then TVCGraph4::PlotDirect(px + 3, py + row, color);
	end;
end;

// Egész szám (0-99999) kiírása
procedure DrawNumber(px, py : integer; num : integer; color : byte);
var
	d5, d4, d3, d2, d1 : byte;
	started : boolean;
	cur_x : integer;
begin
	d5 := num / 10000;
	num := num - d5 * 10000;
	d4 := num / 1000;
	num := num - d4 * 1000;
	d3 := num / 100;
	num := num - d3 * 100;
	d2 := num / 10;
	d1 := num - d2 * 10;

	cur_x := px;
	started := false;

	if (d5 > 0) then begin DrawChar(cur_x, py, d5, color); cur_x := cur_x + 5; started := true; end;
	if (d4 > 0 or started) then begin DrawChar(cur_x, py, d4, color); cur_x := cur_x + 5; started := true; end;
	if (d3 > 0 or started) then begin DrawChar(cur_x, py, d3, color); cur_x := cur_x + 5; started := true; end;
	if (d2 > 0 or started) then begin DrawChar(cur_x, py, d2, color); cur_x := cur_x + 5; started := true; end;
	DrawChar(cur_x, py, d1, color);
end;

// Eredménysor megjelenítése egy teszthez
procedure DisplayResultBar(y_pos : integer; test_id : byte; ticks : integer);
var
	bar_w : integer;
begin
	// 1. Sorszám kiírása (pl. 1: .. 10:) jól látható ZÖLD színnel (Color 1)
	if (test_id = 10) then
	begin
		DrawChar(8, y_pos, 1, 1);
		DrawChar(13, y_pos, 0, 1);
		DrawChar(18, y_pos, 10, 1); // ':'
	end
	else
	begin
		DrawChar(12, y_pos, test_id, 1);
		DrawChar(17, y_pos, 10, 1); // ':'
	end;

	// 2. Eredmény tick-ekben (pl. "75 T") ZÖLD színnel (Color 1)
	DrawNumber(26, y_pos, ticks, 1);
	DrawChar(50, y_pos, 11, 1); // 'T'

	// 3. Eredmény milliszekundumban (pl. "1500 MS") ZÖLD színnel (Color 1)
	DrawNumber(58, y_pos, ticks * 20, 1);
	DrawChar(88, y_pos, 12, 1); // 'M'
	DrawChar(93, y_pos, 13, 1); // 'S'

	// 4. Vizuális teljesítmény-sáv (PIROS színnel - Color 2)
	bar_w := ticks / 4;
	if (bar_w > 135) then bar_w := 135;
	if (bar_w < 2) then bar_w := 2;
	TVCGraph4::FillRectDirect(106, y_pos + 1, 106 + bar_w, y_pos + 6, 2);
end;


/*==============================================================================
	FŐPROGRAM: TELJESÍTMÉNY-MÉRÉSEK
==============================================================================*/
begin
	// TVC Graphics 4 grafikus mód (256x240, 4 szín) inicializálása
	TVCGraph4::InitGraphics();

	// --------------------------------------------------------------------------
	// 1. TESZT: Fast Horizontal Lines (HLineDirect - 1000 vonal)
	// --------------------------------------------------------------------------
	TVCGraph4::Cls(0);
	TVCGraph4::VRAMOn();

	t_start := GetTimer();
	for i := 0 to 999 do
	begin
		TVCGraph4::HLineDirect(10, mod(i, 230) + 5, 245, mod(i, 3) + 1);
	end;
	t_end := GetTimer();
	if (t_end >= t_start) then res_hline := t_end - t_start else res_hline := (65535 - t_start) + t_end;

	// --------------------------------------------------------------------------
	// 2. TESZT: Fast Vertical Lines (VLineDirect - 1000 vonal)
	// --------------------------------------------------------------------------
	TVCGraph4::ClsDirect(0);

	t_start := GetTimer();
	for i := 0 to 999 do
	begin
		TVCGraph4::VLineDirect(mod(i, 240) + 8, 10, 230, mod(i, 3) + 1);
	end;
	t_end := GetTimer();
	if (t_end >= t_start) then res_vline := t_end - t_start else res_vline := (65535 - t_start) + t_end;

	// --------------------------------------------------------------------------
	// 3. TESZT: Fast Bresenham Radial Lines (LineDirect - 1000 átlós vonal)
	// --------------------------------------------------------------------------
	TVCGraph4::ClsDirect(0);

	t_start := GetTimer();
	for i := 0 to 999 do
	begin
		TVCGraph4::LineDirect(128, 120, mod(i * 7, 240) + 8, mod(i * 11, 220) + 10, mod(i, 3) + 1);
	end;
	t_end := GetTimer();
	if (t_end >= t_start) then res_line := t_end - t_start else res_line := (65535 - t_start) + t_end;

	// --------------------------------------------------------------------------
	// 4. TESZT: Fast Rectangles (RectDirect - 500 téglalap keret)
	// --------------------------------------------------------------------------
	TVCGraph4::ClsDirect(0);

	t_start := GetTimer();
	for i := 0 to 499 do
	begin
		TVCGraph4::RectDirect(mod(i * 3, 100) + 10, mod(i * 5, 100) + 10, mod(i * 3, 100) + 140, mod(i * 5, 100) + 120, mod(i, 3) + 1);
	end;
	t_end := GetTimer();
	if (t_end >= t_start) then res_rect := t_end - t_start else res_rect := (65535 - t_start) + t_end;

	// --------------------------------------------------------------------------
	// 5. TESZT: Fast Filled Rectangles (FillRectDirect - 200 kitöltött téglalap)
	// --------------------------------------------------------------------------
	TVCGraph4::ClsDirect(0);

	t_start := GetTimer();
	for i := 0 to 199 do
	begin
		TVCGraph4::FillRectDirect(mod(i * 7, 150) + 10, mod(i * 9, 140) + 10, mod(i * 7, 150) + 60, mod(i * 9, 140) + 50, mod(i, 3) + 1);
	end;
	t_end := GetTimer();
	if (t_end >= t_start) then res_fillrect := t_end - t_start else res_fillrect := (65535 - t_start) + t_end;

	// --------------------------------------------------------------------------
	// 6. TESZT: Fast Circles (CircleDirect - 300 kör)
	// --------------------------------------------------------------------------
	TVCGraph4::ClsDirect(0);

	t_start := GetTimer();
	for i := 0 to 299 do
	begin
		TVCGraph4::CircleDirectFast(128, 120, mod(i, 110) + 5, mod(i, 3) + 1);
	end;
	t_end := GetTimer();
	if (t_end >= t_start) then res_circle := t_end - t_start else res_circle := (65535 - t_start) + t_end;

	// --------------------------------------------------------------------------
	// 7. TESZT: Fast Filled Circles (FillCircleDirect - 100 kitöltött kör)
	// --------------------------------------------------------------------------
	TVCGraph4::ClsDirect(0);

	t_start := GetTimer();
	for i := 0 to 99 do
	begin
		TVCGraph4::FillCircleDirect(mod(i * 13, 160) + 48, mod(i * 17, 140) + 50, mod(i, 40) + 10, mod(i, 3) + 1);
	end;
	t_end := GetTimer();
	if (t_end >= t_start) then res_fillcircle := t_end - t_start else res_fillcircle := (65535 - t_start) + t_end;

	// --------------------------------------------------------------------------
	// 8. TESZT: Fast Triangles (TriangleDirect - 300 háromszög)
	// --------------------------------------------------------------------------
	TVCGraph4::ClsDirect(0);

	t_start := GetTimer();
	for i := 0 to 299 do
	begin
		TVCGraph4::TriangleDirect(mod(i * 3, 220) + 10, mod(i * 5, 200) + 10, mod(i * 7, 220) + 10, mod(i * 9, 200) + 10, 128, 120, mod(i, 3) + 1);
	end;
	t_end := GetTimer();
	if (t_end >= t_start) then res_triangle := t_end - t_start else res_triangle := (65535 - t_start) + t_end;

	// --------------------------------------------------------------------------
	// 9. TESZT: Fast Filled Triangles (FillTriangleDirect - 100 kitöltött háromszög)
	// --------------------------------------------------------------------------
	TVCGraph4::ClsDirect(0);

	t_start := GetTimer();
	for i := 0 to 99 do
	begin
		TVCGraph4::FillTriangleDirect(mod(i * 11, 200) + 20, mod(i * 13, 180) + 20, mod(i * 7, 200) + 30, mod(i * 17, 180) + 30, mod(i * 5, 200) + 40, mod(i * 3, 180) + 40, mod(i, 3) + 1);
	end;
	t_end := GetTimer();
	if (t_end >= t_start) then res_filltriangle := t_end - t_start else res_filltriangle := (65535 - t_start) + t_end;

	// --------------------------------------------------------------------------
	// 10. TESZT: Screen Clear (ClsDirect - 100 teljes 15.36 KB-os képernyőtörlés)
	// --------------------------------------------------------------------------
	t_start := GetTimer();
	for i := 0 to 99 do
	begin
		TVCGraph4::ClsDirect(mod(i, 4));
	end;
	t_end := GetTimer();
	if (t_end >= t_start) then res_cls := t_end - t_start else res_cls := (65535 - t_start) + t_end;


	// ==========================================================================
	// EREDMÉNYEK MEGJELENÍTÉSE (SCOREBOARD)
	// ==========================================================================
	TVCGraph4::ClsDirect(0);

	// Díszkeret (Zöld keret)
	TVCGraph4::RectDirect(5, 5, 250, 234, 1);
	TVCGraph4::RectDirect(7, 7, 248, 232, 1);
	TVCGraph4::HLineDirect(8, 24, 247, 1);

	// Fejléc felirat: "BENCHMARK"
	// B:
	TVCGraph4::VLineDirect(12, 11, 19, 1); TVCGraph4::HLineDirect(12, 11, 16, 1); TVCGraph4::HLineDirect(12, 15, 16, 1); TVCGraph4::HLineDirect(12, 19, 16, 1); TVCGraph4::VLineDirect(16, 11, 19, 1);
	// E:
	TVCGraph4::VLineDirect(20, 11, 19, 1); TVCGraph4::HLineDirect(20, 11, 24, 1); TVCGraph4::HLineDirect(20, 15, 23, 1); TVCGraph4::HLineDirect(20, 19, 24, 1);
	// N:
	TVCGraph4::VLineDirect(28, 11, 19, 1); TVCGraph4::LineDirect(28, 11, 32, 19, 1); TVCGraph4::VLineDirect(32, 11, 19, 1);
	// C:
	TVCGraph4::VLineDirect(36, 11, 19, 1); TVCGraph4::HLineDirect(36, 11, 40, 1); TVCGraph4::HLineDirect(36, 19, 40, 1);
	// H:
	TVCGraph4::VLineDirect(44, 11, 19, 1); TVCGraph4::HLineDirect(44, 15, 48, 1); TVCGraph4::VLineDirect(48, 11, 19, 1);
	// M:
	TVCGraph4::VLineDirect(52, 11, 19, 1); TVCGraph4::LineDirect(52, 11, 55, 15, 1); TVCGraph4::LineDirect(55, 15, 58, 11, 1); TVCGraph4::VLineDirect(58, 11, 19, 1);
	// A:
	TVCGraph4::VLineDirect(62, 11, 19, 1); TVCGraph4::HLineDirect(62, 11, 66, 1); TVCGraph4::HLineDirect(62, 15, 66, 1); TVCGraph4::VLineDirect(66, 11, 19, 1);
	// R:
	TVCGraph4::VLineDirect(70, 11, 19, 1); TVCGraph4::HLineDirect(70, 11, 74, 1); TVCGraph4::HLineDirect(70, 15, 74, 1); TVCGraph4::VLineDirect(74, 11, 15, 1); TVCGraph4::LineDirect(72, 15, 74, 19, 1);
	// K:
	TVCGraph4::VLineDirect(78, 11, 19, 1); TVCGraph4::LineDirect(82, 11, 79, 15, 1); TVCGraph4::LineDirect(79, 15, 82, 19, 1);

	// Oszlop elválasztó vonal
	TVCGraph4::HLineDirect(8, 30, 247, 1);

	// Eredmények kiírása soronként (4x7-es tiszta, jól olvasható számokkal)
	DisplayResultBar(34,  1, res_hline);        // 1: Fast HLine (1000x)
	DisplayResultBar(49,  2, res_vline);        // 2: Fast VLine (1000x)
	DisplayResultBar(64,  3, res_line);         // 3: Bresenham Line (1000x)
	DisplayResultBar(79,  4, res_rect);         // 4: Rectangles (500x)
	DisplayResultBar(94,  5, res_fillrect);     // 5: FillRect (200x)
	DisplayResultBar(109, 6, res_circle);       // 6: Circles (300x)
	DisplayResultBar(124, 7, res_fillcircle);   // 7: FillCircle (100x)
	DisplayResultBar(139, 8, res_triangle);     // 8: Triangles (300x)
	DisplayResultBar(154, 9, res_filltriangle); // 9: FillTriangle (100x)
	DisplayResultBar(169, 10, res_cls);         // 10: Screen Cls (100x)

	// Alsó dekoráció és minták
	TVCGraph4::HLineDirect(8, 186, 247, 1);

	// 1. Körvonal (Zöld)
	TVCGraph4::CircleDirect(28, 210, 14, 1);

	// 2. Kitöltött kör (Piros)
	TVCGraph4::FillCircleDirect(66, 210, 12, 2);

	// 3. Háromszög körvonal (Zöld)
	TVCGraph4::TriangleDirect(92, 224, 107, 196, 122, 224, 1);

	// 4. Kitöltött háromszög (Piros)
	TVCGraph4::FillTriangleDirect(132, 224, 147, 196, 162, 224, 2);

	// 5. Téglalap körvonal (Zöld)
	TVCGraph4::RectDirect(172, 198, 202, 222, 1);

	// 6. Kitöltött téglalap (Piros)
	TVCGraph4::FillRectDirect(212, 198, 242, 222, 2);

	TVCGraph4::VRAMOff();

	// Végtelen ciklus
	while (1) do
	begin
	end;
end.

