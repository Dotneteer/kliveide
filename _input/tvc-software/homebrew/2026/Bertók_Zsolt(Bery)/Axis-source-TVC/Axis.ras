	LevelMap						: array[LEVEL_SIZE] of byte at 6344; // az aktuális pálya térképe, 15*13=195 byte (6344: BASIC változó és munkaterület)
	tileNr              : byte; 
	LevelNr             : byte = 0;// akuális pálya sorszáma
	LevelPtr            : pointer; // a LevelMaps tömbben az aktuális pályára mutató pointer	
	LevelDone           : boolean; // szint teljesítve
	GameOver						: boolean; // játék vége
	WonGame             : boolean; // megnyert játék
	FirstRun            : boolean = True; // mutatja, hogy először fut a játék címkép utáni része, és ha igen, akkor a kerettörténet kiírásra kerül
	// Kulcskártya bitmapek
	RedKeyBitmap   			: incbin("axis/RedKey.bin"); 				// piros kulcs grafika
	WhiteKeyBitmap   		: incbin("axis/WhiteKey.bin");			// fehér kulcs grafika
	// Játékos változói
	PlayerUpAnim  	  	: incbin("axis/PlayerUp.bin");    	// Player sprite felfelé lépés animáció (4 byte x 14 pixel - 3 fázis)
	PlayerRightAnim  	  : incbin("axis/PlayerRight.bin"); 	// Player sprite jobbra lépés animáció (4 byte x 14 pixel - 3 fázis)
	PlayerDownAnim  	  : incbin("axis/PlayerDown.bin");  	// Player sprite lefelé lépés animáció (4 byte x 14 pixel - 3 fázis)
	PlayerLeftAnim  	  : incbin("axis/PlayerLeft.bin");		// Player sprite balra lépés animáció (4 byte x 14 pixel - 3 fázis)
	PlayerDeadBitmap    : incbin("axis/PlayerDead.bin");		// halott Player sprite 16x14 pixel (4 byte x 14 pixel)
  PlayerLivesBitmap	  : incbin("axis/PlayerLives.bin");		// játékos életeket kijelző image 2 byte x 11 pixel (8x11 pixel)
  PlayerLiveImage     : GE::Image;  // játékost ábrázoló image, ami mutatja, hogy mennyi élete van még a játékosnak
  PLAYER_LIVES        : byte = 5;   // életek száma a játék elejént
  PlayerLives         : byte;       // a játékos életeinek száma
	const PLAYER_STEP_DELAY : byte = 5; // játékos járásának lassítási értéke, amitől visszaszámol
	PlayerSprite    		: GE::Sprite; // a játékos sprite
	PlayerMapPos        : pointer;    // a játékos aktuális pozíciója a LevelMap-en
	PlayerTileXStep			: byte;       // a játékos vízszintes pozíciója egy csempén belül
	PlayerTileYStep			: byte;	      // a játékos függőleges pozíciója egy csempén belül
	PlayerNextTile      : byte;       // a játékos előtti csempe sorszáma
	PlayerDyingTimer    : byte;       // játékos haldoklásának visszaszámláló időzítője
	// Kulcskártya változók
	KeyCardSprites      : array[KEYCARD_COUNT] of GE::Sprite; // Kulcskártya sprite-ok
	KeyCardSprPtr				: pointer of GE::Sprite; // az éppen felvett kulcskártya sprite-ra mutató pointer
	const KEY_CARD_GROUP: byte = 2; // a kulcskártyák csoportazonosítója
	PlayerHasTheKeyCard	: array[KEYCARD_COUNT] of boolean;  // a játékosnál van-e az adott sorszámú/színű kulcskártya 
	KeyCardInventoryXPos: byte;     // a képernyő tetején történő kulcskártya kijelzés X pozíciója
	// Ajtó változók	
	DoorMapPos          : pointer;    // az éppen nyíló vagy záródó ajtó pozíciója a LevelMap-en
