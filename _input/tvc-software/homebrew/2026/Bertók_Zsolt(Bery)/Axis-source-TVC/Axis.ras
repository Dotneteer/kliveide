program Axis;
/*
 Axis - VIDEOTON TV-Computer (TVC) játék
 Készült: TRSE fejlesztőeszközzel és a Game Engine unittal
 Készítette: Bery (Bertók Zsolt)
 Kiadás: 2024. december 26. - a 2024-es TVC játékfejlesztő versenyre
 Verzió: 2025. február 15. - egy szimpla, befejezetlen zene került a címkép alá
*/

@use "GE" // Game Engine unit by BerySoft

var
	// Konstansok
	// A pálya méretei
	const LEVEL_WIDTH  		: byte = 15;   	// a pálya egy sora ennyi csempéből áll
	const LEVEL_HEIGHT 		: byte = 13;   	// a pálya ennyi sor csempéből áll
	const LEVEL_SIZE      : byte = LEVEL_WIDTH*LEVEL_HEIGHT;
	const LAST_LEVEL      : byte = 10;    // az utolsó pálya sorszáma
	// Csempe paraméterek
	const TILE_WIDTH   		: byte = 4;    	// egy csempe bitmap szélessége byte-okban
	const TILE_HEIGHT  		: byte = 16;   	// egy csempe bitmap magassága pixelekben
	const TILE_SIZE    		: byte = TILE_WIDTH*TILE_HEIGHT; // egy csempe bitmap mérete byte-okban
	const TILE_COUNT   		: byte = 33;   	// ennyi darab, pályát alkotó csempénk van
	// Kulcskártya
	const RED_KEY   			: byte = 0;			// a piros kulcskártya sorszáma
	const WHITE_KEY   	  : byte = 1;			// a szürke kulcskártya sorszáma
	const KEYCARD_COUNT   : byte = 2;     // ennyi féle kulcskértya van
	const KEYCARD_WIDTH   : byte = 2;			// a kulcskártya sprite szélessége byte-okban
	const KEYCARD_HEIGHT  : byte = 9;		  // a kulcskártya sprite magassága pixelekben
	// Csempe (Tile) típusok
	const TILE_FLOOR    	: byte = 0;			// a padló csempe, ami a járható része a pályának, azaz nem fal
	const TILE_RED_KEY   	: byte = 1;			// a piros kulcskártya pozícióját jelző csempe
	const TILE_WHITE_KEY  :	byte = 2;			// a fehér kulcskártya pozícióját jelző csempe
	// const TILE_GRAY_KEY   : byte = 3;			// a szürke kulcskártya pozícióját jelző csempe
	const TILE_OPENED_RED_DOOR	: byte = 4;	// a piros kulcskártya pozícióját jelző csempe
	const TILE_OPENED_WHITE_DOOR:	byte = 5;	// a fehér kulcskártya pozícióját jelző csempe
	// const TILE_OPENED_GRAY_DOOR : byte = 6;	// a fekete kulcskártya pozícióját jelző csempe	
	const TILE_ALIEN    	: byte = 7;			// az Alienek kezdőpozícióit jelző csempe	
	const TILE_EXIT       : byte = 8;			// a kijárat csempe	
	const TILE_FIRST_WALL	: byte = 9;    	// az első fal csempe
	const TILE_ENTRY 			: byte = 9;     // a bejárat csempe	
	// Ajtó csempék
	const TILE_RED_DOOR_V 	: byte = 30;    // a függőleges piros ajtót jelző csempe
	const TILE_WHITE_DOOR_V : byte = 33;    // a függőleges szürke ajtót jelző csempe
	const TILE_RED_DOOR_H 	: byte = 36;    // a vízszintes piros ajtót jelző csempe
	const TILE_WHITE_DOOR_H : byte = 39;    // a vízszintes szürke ajtót jelző csempe
	// Játékos
	const PLAYER_WIDTH    : byte = 4;			// a játékos sprite szélessége byte-okban
	const PLAYER_HEIGHT   : byte = 14;		// a játékos sprite magassága pixelekben
	const PLAYER_ANIMCOUNT: byte = 3;	    // a játékos lépés animáció fázisainak száma
	// Ajtó 
	const DOOR_OPENING    : byte = 1;			// az ajtó nyílik
	const DOOR_CLOSING    : byte = 2;			// az ajtó záródik
	const DOOR_ANIMCOUNT	: byte = 5;			// ajtó nyitás-zárás animációs fázisainak száma
	const DOOR_ANIM_DELAY : byte = 6;     // ajtó nyitás-zárás animáció ennyi frame-enként történjen (lassítás)
	// Aliens
	const ALIEN_WIDTH     : byte = 4;			// az alien sprite szélessége byte-okban
	const ALIEN_HEIGHT    : byte = 16;		// az alien sprite magassága pixelekben
	// Irányok
	const NONE            : byte = 0;
	const UP           		: byte = 1;
	const RIGHT        		: byte = 2;
	const DOWN         		: byte = 3;
	const LEFT         		: byte = 4;
	// Állapotok
